    {π₂ π'₂ ρ₂ ρ'₂ : var₂ .nat → Prog S rec var₂ .nat} (hm : ⟨.nat, m₁, m₂⟩ ∈ Γ)
    (hV : ⟨.list .nat, V₁, V₂⟩ ∈ Γ) (hc : ⟨.array (.list .nat), csA₁, csA₂⟩ ∈ Γ)
