    · exact hρ _ (fun z hz => by simp [hz]) _ _ (by simp [hu])
  · intro i₁ i₂
    exact wf_cellPtProg (by simp [hc]) (by simp [hc']) (hπ.mono fun z hz => by simp [hz])
      (by simp [hu]) List.mem_cons_self

theorem wf_jpermProg {m₁ : var₁ .nat} {m₂ : var₂ .nat} {V₁ V'₁ : var₁ (.list .nat)}
    {V₂ V'₂ : var₂ (.list .nat)} {csA₁ fA₁ cs'A₁ fA'₁ : var₁ (.array (.list .nat))}
