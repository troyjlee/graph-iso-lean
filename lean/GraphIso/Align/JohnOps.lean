theorem wf_profProg {s₁ s'₁ k₁ k'₁ : var₁ .nat} {s₂ s'₂ k₂ k'₂ : var₂ .nat}
    {cs₁ cs'₁ : var₁ (.list (.list .nat))} {cs₂ cs'₂ : var₂ (.list (.list .nat))}
    {R₁ R'₁ : var₁ (.list .nat)} {R₂ R'₂ : var₂ (.list .nat)}
    (hs : ⟨.nat, s₁, s₂⟩ ∈ Γ) (hs' : ⟨.nat, s'₁, s'₂⟩ ∈ Γ) (hk : ⟨.nat, k₁, k₂⟩ ∈ Γ)
