theorem wf_cellSwapProg {m₁ k₁ i₁ j₁ : var₁ .nat} {m₂ k₂ i₂ j₂ : var₂ .nat}
    {V₁ : var₁ (.list .nat)} {V₂ : var₂ (.list .nat)} {csA₁ fA₁ : var₁ (.array (.list .nat))}
    {csA₂ fA₂ : var₂ (.array (.list .nat))} (hm : ⟨.nat, m₁, m₂⟩ ∈ Γ)
    (hV : ⟨.list .nat, V₁, V₂⟩ ∈ Γ) (hc : ⟨.array (.list .nat), csA₁, csA₂⟩ ∈ Γ)
    (hk : ⟨.nat, k₁, k₂⟩ ∈ Γ) (hf : ⟨.array (.list .nat), fA₁, fA₂⟩ ∈ Γ)
    (hi : ⟨.nat, i₁, i₂⟩ ∈ Γ) (hj : ⟨.nat, j₁, j₂⟩ ∈ Γ) :
