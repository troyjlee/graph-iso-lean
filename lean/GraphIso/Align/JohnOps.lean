  · unfold listEqProg
    exact .bind (Coherent.wf_lexCmpProg Coherent.wfCmp_cmpNat (by simp) (by simp)) fun _ _ =>
      .bind (.prim _ .nil) fun _ _ => .prim _ (.cons (by simp) (.cons List.mem_cons_self .nil))
  · prog_wf

end Wf3

section Wf4

open Cost Programs

variable {S : Signature} {rec : Ty × Ty} {var₁ var₂ : Ty → Type} {r : Bool}
  {Γ : WfCtx var₁ var₂}

theorem wf_isoBranchProg {m₁ k₁ k'₁ : var₁ .nat} {m₂ k₂ k'₂ : var₂ .nat}
    {V₁ V'₁ R₁ R'₁ : var₁ (.list .nat)} {V₂ V'₂ R₂ R'₂ : var₂ (.list .nat)}
    {csA₁ fA₁ cs'A₁ fA'₁ : var₁ (.array (.list .nat))}
    {csA₂ fA₂ cs'A₂ fA'₂ : var₂ (.array (.list .nat))} (hm : ⟨.nat, m₁, m₂⟩ ∈ Γ)
    (hV : ⟨.list .nat, V₁, V₂⟩ ∈ Γ) (hc : ⟨.array (.list .nat), csA₁, csA₂⟩ ∈ Γ)
    (hk : ⟨.nat, k₁, k₂⟩ ∈ Γ) (hf : ⟨.array (.list .nat), fA₁, fA₂⟩ ∈ Γ)
    (hV' : ⟨.list .nat, V'₁, V'₂⟩ ∈ Γ) (hc' : ⟨.array (.list .nat), cs'A₁, cs'A₂⟩ ∈ Γ)
    (hk' : ⟨.nat, k'₁, k'₂⟩ ∈ Γ) (hf' : ⟨.array (.list .nat), fA'₁, fA'₂⟩ ∈ Γ)
    (hR : ⟨.list .nat, R₁, R₂⟩ ∈ Γ) (hR' : ⟨.list .nat, R'₁, R'₂⟩ ∈ Γ) :
    Prog.Wf (S := S) (rec := rec) r Γ
      (isoBranchProg m₁ V₁ csA₁ k₁ fA₁ V'₁ cs'A₁ k'₁ fA'₁ R₁ R'₁)
      (isoBranchProg m₂ V₂ csA₂ k₂ fA₂ V'₂ cs'A₂ k'₂ fA'₂ R₂ R'₂) := by
  unfold isoBranchProg
  refine .bind (wf_ordProg hc hk) fun O₁ O₂ =>
    .bind (wf_ordProg (by simp [hc']) (by simp [hk'])) fun O'₁ O'₂ =>
    .bind (.prim _ (.cons (by simp) .nil)) fun _ _ =>
    .bind (.prim _ (.cons (by simp) .nil)) fun _ _ =>
    .bind (.prim _ (.cons (by simp [hR]) .nil)) fun _ _ =>
    .bind (.prim _ (.cons (by simp [hR']) .nil)) fun _ _ => .bind ?_ fun _ _ => ?_
  · refine wf_jpermProg (by simp [hm]) (by simp [hV]) (by simp [hc]) (by simp [hk]) (by simp [hf])
      (by simp [hV']) (by simp [hc']) (by simp [hk']) (by simp [hf'])
      (fun Γ' hΓ i₁ i₂ hi => wf_joMatchProg (hΓ (by simp)) (hΓ (by simp)) hi)
      (fun Γ' hΓ i₁ i₂ hi => wf_joMatchProg (hΓ (by simp)) (hΓ (by simp)) hi)
      (fun Γ' hΓ i₁ i₂ hi => wf_joMatchProg (hΓ (by simp [hR])) (hΓ (by simp)) hi)
      (fun Γ' hΓ i₁ i₂ hi => wf_joMatchProg (hΓ (by simp [hR'])) (hΓ (by simp)) hi)
  · prog_wf

theorem wf_johnIsoProg {m₁ : var₁ .nat} {m₂ : var₂ .nat} {d₁ d'₁ : var₁ jTy} {d₂ d'₂ : var₂ jTy}
    (hm : ⟨.nat, m₁, m₂⟩ ∈ Γ) (hd : ⟨jTy, d₁, d₂⟩ ∈ Γ) (hd' : ⟨jTy, d'₁, d'₂⟩ ∈ Γ) :
    Prog.Wf (S := S) (rec := rec) r Γ (johnIsoProg m₁ d₁ d'₁) (johnIsoProg m₂ d₂ d'₂) := by
  unfold johnIsoProg
  refine .bind (.prim _ (.cons hd .nil)) fun _ _ => .bind (.prim _ (.cons (by simp [hd]) .nil))
    fun _ _ => .bind (.prim _ (.cons List.mem_cons_self .nil)) fun _ _ =>
    .bind (.prim _ (.cons (by simp) .nil)) fun _ _ =>
    .bind (.prim _ (.cons List.mem_cons_self .nil)) fun _ _ =>
    .bind (.prim _ (.cons (by simp) .nil)) fun _ _ =>
    .bind (.prim _ (.cons (by simp) .nil)) fun _ _ =>
    .bind (.prim _ (.cons (by simp) .nil)) fun _ _ =>
    .bind (.prim _ (.cons (by simp [hd']) .nil)) fun _ _ =>
    .bind (.prim _ (.cons (by simp [hd']) .nil)) fun _ _ =>
    .bind (.prim _ (.cons List.mem_cons_self .nil)) fun _ _ =>
    .bind (.prim _ (.cons (by simp) .nil)) fun _ _ =>
    .bind (.prim _ (.cons List.mem_cons_self .nil)) fun _ _ =>
    .bind (.prim _ (.cons (by simp) .nil)) fun _ _ =>
    .bind (.prim _ (.cons (by simp) .nil)) fun _ _ =>
    .bind (.prim _ (.cons (by simp) .nil)) fun _ _ =>
    .bind (wf_jrestProg (by simp [hm]) (by simp) (by simp) (by simp)) fun _ _ =>
    .bind (wf_jrestProg (by simp [hm]) (by simp) (by simp) (by simp)) fun _ _ =>
    .bind (wf_profProg (by simp) (by simp) (by simp) (by simp) (by simp) (by simp) (by simp)
      List.mem_cons_self) fun _ _ =>
    .ite List.mem_cons_self (wf_isoBranchProg (by simp [hm]) (by simp) (by simp) (by simp)
      (by simp) (by simp) (by simp) (by simp) (by simp) (by simp) (by simp)) (.prim _ .nil)

end Wf4

/-! ### The invariant from a Johnson embedding -/

/-- The shape conditions of the data: the invariant without the Johnson structure of `f`. -/
structure JShape (m : ℕ) (d : JData) : Prop where
  v0_nodup : d.1.Nodup
  v0_lt : ∀ v ∈ d.1, v < m
  cell_nodup : ∀ c ∈ d.2.1, c.Nodup
  cell_ne : ∀ c ∈ d.2.1, c ≠ []
  cell_lt : ∀ c ∈ d.2.1, ∀ a ∈ c, a < m
  cell_disj : d.2.1.Pairwise fun c c' => ∀ a ∈ c, a ∉ c'
  cell_v0 : ∀ c ∈ d.2.1, ∀ a ∈ c, a ∉ d.1
  trim : ∀ v, v ∉ d.1 → jfl d v = []
  f_nodup : ∀ v ∈ d.1, (jfl d v).Nodup
  f_lt : ∀ v ∈ d.1, ∀ j ∈ jfl d v, j < d.2.1.length

section Bridge

variable {m : ℕ} {d : JData}

theorem JShape.distinct (h : JShape m d) : CellsDistinct m d.2.1 := by
  intro i hi j hj he
  by_contra hij
  obtain ⟨a, ha⟩ := List.exists_mem_of_ne_nil _ (h.cell_ne _ (getD_mem_cell hi))
  have hlt := h.cell_lt _ (getD_mem_cell hi) a ha
  have : (⟨a, hlt⟩ : Fin m) ∈ setOf m (d.2.1.getD j []) := by
    rw [← he, mem_setOf]; exact ha
  exact jo_cells_disj h.cell_disj hi hj hij ha (mem_setOf.1 this)

theorem card_famIdx (h : JShape m d) {l : List ℕ} (hl : l.Nodup)
    (hlt : ∀ j ∈ l, j < d.2.1.length) : (famIdx m d.2.1 l).card = l.length := by
  rw [famIdx, List.toFinset_card_of_nodup, List.length_map]
  exact hl.map_on fun a ha b hb e => h.distinct a (hlt a ha) b (hlt b hb) e

theorem famIdx_eq_iff (h : JShape m d) {l l' : List ℕ} (hl : ∀ j ∈ l, j < d.2.1.length)
    (hl' : ∀ j ∈ l', j < d.2.1.length) :
    famIdx m d.2.1 l = famIdx m d.2.1 l' ↔ ∀ j, j ∈ l ↔ j ∈ l' := by
  refine ⟨fun he => ?_, famIdx_congr⟩
  have key : ∀ {l l' : List ℕ}, (∀ j ∈ l, j < d.2.1.length) → (∀ j ∈ l', j < d.2.1.length) →
      famIdx m d.2.1 l = famIdx m d.2.1 l' → ∀ j ∈ l, j ∈ l' := by
    intro l l' hl hl' he j hj
    have : cellAt m d.2.1 j ∈ famIdx m d.2.1 l' := by
      rw [← he]; exact mem_famIdx.2 ⟨j, hj, rfl⟩
    obtain ⟨j', hj', hjj⟩ := mem_famIdx.1 this
    rwa [h.distinct j' (hl' j' hj') j (hl j hj) hjj] at hj'
  exact fun j => ⟨key hl hl' he j, key hl' hl he.symm j⟩

theorem famIdx_subset_famOf {l : List ℕ} (hlt : ∀ j ∈ l, j < d.2.1.length) :
    famIdx m d.2.1 l ⊆ famOf m d.2.1 := by
  intro A hA
  obtain ⟨j, hj, rfl⟩ := mem_famIdx.1 hA
  rw [famOf_eq_image]
  exact Finset.mem_image.2 ⟨j, Finset.mem_range.2 (hlt j hj), rfl⟩

/-- **A trimmed Johnson embedding with the shape conditions satisfies the invariant.** -/
theorem jvalid_of_isJohnson (h : JShape m d) {V : Finset (Fin m)} {t : ℕ}
    (hJ : IsJohnson V t (jdec m d)) : JValid m d where
  v0_nodup := h.v0_nodup
  v0_lt := h.v0_lt
  cell_nodup := h.cell_nodup
  cell_ne := h.cell_ne
  cell_lt := h.cell_lt
  cell_disj := h.cell_disj
  cell_v0 := h.cell_v0
  trim := h.trim
  f_nodup := h.f_nodup
  f_lt := h.f_lt
  f_len v hv := by
    have hm := Finset.mem_powersetCard.1 (hJ.maps_to ⟨v, h.v0_lt v hv⟩
      (by rw [jdec_V0, mem_setOf]; exact hv))
    rw [jdec_f, card_famIdx h (h.f_nodup v hv) (h.f_lt v hv)] at hm
    exact hm.2
  f_inj v hv w hw hvw := by
    have := hJ.inj ⟨v, h.v0_lt v hv⟩ (by rw [jdec_V0, mem_setOf]; exact hv)
      ⟨w, h.v0_lt w hw⟩ (by rw [jdec_V0, mem_setOf]; exact hw)
      (by rw [jdec_f, jdec_f]; exact famIdx_congr hvw)
    exact congrArg Fin.val this
  f_surj T hT hTk hTs := by
    have hmem : famIdx m d.2.1 T ∈ (jdec m d).Λ.powersetCard (jdec m d).s := by
      rw [Finset.mem_powersetCard, jdec_Λ, jdec_s]
      exact ⟨famIdx_subset_famOf hTk, by rw [card_famIdx h hT hTk, hTs]⟩
    obtain ⟨v, hv, hfv⟩ := hJ.surj _ hmem
    rw [jdec_V0, mem_setOf] at hv
    refine ⟨v.val, hv, ?_⟩
    rw [jdec_f] at hfv
    exact (famIdx_eq_iff h (h.f_lt _ hv) hTk).1 hfv

end Bridge

