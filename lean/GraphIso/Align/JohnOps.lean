    (hV' : ⟨.list .nat, V'₁, V'₂⟩ ∈ Γ) (hc' : ⟨.array (.list .nat), cs'A₁, cs'A₂⟩ ∈ Γ)
    (hk' : ⟨.nat, k'₁, k'₂⟩ ∈ Γ) (hf' : ⟨.array (.list .nat), fA'₁, fA'₂⟩ ∈ Γ)
    (hπ : WfFun r Γ π₁ π₂) (hπ' : WfFun r Γ π'₁ π'₂) (hρ : WfFun r Γ ρ₁ ρ₂)
    (hρ' : WfFun r Γ ρ'₁ ρ'₂) :
    Prog.Wf r Γ (jpermProg m₁ V₁ csA₁ k₁ fA₁ V'₁ cs'A₁ k'₁ fA'₁ π₁ π'₁ ρ₁ ρ'₁)
      (jpermProg m₂ V₂ csA₂ k₂ fA₂ V'₂ cs'A₂ k'₂ fA'₂ π₂ π'₂ ρ₂ ρ'₂) := by
  unfold jpermProg
  refine wf_ofFunProg hm (fun Γ' hΓ u₁ u₂ hu => ?_) (fun Γ' hΓ u₁ u₂ hu => ?_)
  · exact wf_jmapProg (hΓ hV) (hΓ hc) (hΓ hk) (hΓ hf) (hΓ hV') (hΓ hc') (hΓ hk') (hΓ hf')
      (hπ.mono hΓ) (hρ.mono hΓ) hu
  · exact wf_jmapProg (hΓ hV') (hΓ hc') (hΓ hk') (hΓ hf') (hΓ hV) (hΓ hc) (hΓ hk) (hΓ hf)
      (hπ'.mono hΓ) (hρ'.mono hΓ) hu

theorem wf_swapsProg {m₁ : var₁ .nat} {m₂ : var₂ .nat} {ps₁ : var₁ (.list (.prod .nat .nat))}
