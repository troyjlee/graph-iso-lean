module

public import GraphIso.Align.Interface
public import GraphIso.Graph.Perms
public import GraphIso.SoJTree.LeafProg
public import GraphIso.Coherent.ListProg
public import Mathlib.Data.List.Sort

/-!
# Trimmed Johnson embeddings: stabilizers and isomorphisms

Stage 14f, items 2–4 (`PLAN-14.md` §10), for trimmed Johnson embeddings `J = (V0, Λ, s, f)` on
`Fin m`: `f` maps `V0` bijectively onto the `s`-sets of cells and is empty off `V0`
(`JEmb` equality compares `f` as a total function, so Align uses the trimmed embedding).

* **Data** (`JData`, `jdec`): points `V0`, cells `cs`, `s`, and for every point the indices of
  its cells. `JValid` is the representation invariant: duplicate-free points and cells in
  range, nonempty pairwise disjoint cells disjoint from `V0`, `f` trimmed, and on `V0` a
  bijection onto the `s`-sets of cell indices. `jvalid_of_isJohnson`: the shape conditions
  (`JShape`) together with `IsJohnson V t (jdec m d)` give the invariant.
* **The stabilizer, abstractly** (`jo_closure_eq`): for disjoint cells and `f` injective into
  sets of cells, the stabilizer is generated by transpositions inside a cell, transpositions
  outside `V0 ∪ ⋃Λ`, and, for every moved cell, a stabilizing element moving it the same way
  and fixing the other cells (induction on the moved cells, then on the support).
* **The general map** (`jmap`, `jperm`): a size-preserving matching `π` of the cells and a
  bijection `ρ` of the rest give the permutation sending the `p`-th point of cell `i` to the
  `p`-th point of cell `π i`, a point of `V0` to the point whose cells are the images of its
  own, and the rest by `ρ` (`jmap_invPair`, `jperm_cellAt`, `jperm_smul`).
* **The generators** (`johnGensD`, `johnGensD_closure`): transpositions inside cells and of the
  rest, and swaps of two cells of equal size (the general map with `π` a transposition).
* **The isomorphism search** (`johnIsoD`): compare `s`, the number of cells, their sorted sizes
  and the size of the rest (`profileD`); if they agree, match the cells in size order and the
  rest in list order. `johnIsoD_none`: an isomorphism forces the profiles to agree.
* `johnOps`, `johnOps_spec`: the `StructOps` instance and its specification.
* **Programs** (no backend calls): `johnGensProg` and `johnIsoProg` compute `johnGensD` and
  `johnIsoD` (`RunsWithin.johnGensProg`, `RunsWithin.johnIsoProg`) at the explicit polynomial
  costs `johnGensCost B` and `johnIsoCost B` for data bounded by `B ≥ m` (`JBound`; the invariant
  gives `JBound (m + |cs|)`, `jbound_of_valid`), with well-formedness lemmas. The sort keys are
  lists `[size, i]` ordered lexicographically, since the cost language has no multiplication.
-/

@[expose] public section

namespace GraphIso.Align

open Equiv Finset Pointwise GraphIso GraphIso.SplitJohnson GraphIso.SoJProg GraphIso.SoJTree

/-! ### The stabilizer of a Johnson embedding, abstractly -/

section Abstract

variable {Γ : Type*} [Fintype Γ] [DecidableEq Γ]

omit [Fintype Γ] in
/-- The stabilizer conditions of a Johnson embedding. -/
theorem jo_smul_eq_iff (σ : Perm Γ) (J : JEmb Γ) :
    σ • J = J ↔ σ • J.V0 = J.V0 ∧ σ • J.Λ = J.Λ ∧ ∀ v, J.f (σ v) = σ • J.f v := by
  obtain ⟨V0, Λ, s, f⟩ := J
  show JEmb.mk _ _ _ _ = _ ↔ _
  simp only [JEmb.mk.injEq, true_and]
  constructor
  · rintro ⟨h1, h2, h3⟩
    refine ⟨h1, h2, fun v => ?_⟩
    have := congrFun h3 (σ • v)
    simp only [inv_smul_smul] at this
    exact this.symm
  · rintro ⟨h1, h2, h3⟩
    refine ⟨h1, h2, funext fun v => ?_⟩
    have := h3 (σ⁻¹ • v)
    rw [show σ (σ⁻¹ • v) = v from smul_inv_smul σ v] at this
    exact this.symm

/-- The hypotheses on a Johnson embedding used for its stabilizer: disjoint cells, `f` maps
`V₀` into sets of cells, injectively. -/
structure JHyp (J : JEmb Γ) : Prop where
  disj : ∀ A ∈ J.Λ, ∀ B ∈ J.Λ, A ≠ B → Disjoint A B
  sub : ∀ v ∈ J.V0, J.f v ⊆ J.Λ
  inj : ∀ v ∈ J.V0, ∀ w ∈ J.V0, J.f v = J.f w → v = w

omit [Fintype Γ] in
theorem jo_smul_fixed {σ : Perm Γ} {T : Finset (Finset Γ)} (h : ∀ A ∈ T, σ • A = A) :
    σ • T = T := by
  ext X
  rw [mem_smul_finset]
  constructor
  · rintro ⟨Y, hY, rfl⟩
    rwa [h Y hY]
  · intro hX
    exact ⟨X, hX, h X hX⟩

omit [Fintype Γ] in
theorem jo_swap_smul_of_not_mem {a b : Γ} {A : Finset Γ} (ha : a ∉ A) (hb : b ∉ A) :
    swap a b • A = A := by
  ext x
  rw [mem_smul_finset]
  constructor
  · rintro ⟨y, hy, rfl⟩
    rw [Perm.smul_def, swap_apply_of_ne_of_ne (fun h : y = a => ha (h ▸ hy))
      (fun h : y = b => hb (h ▸ hy))]
    exact hy
  · intro hx
    refine ⟨x, hx, ?_⟩
    rw [Perm.smul_def, swap_apply_of_ne_of_ne (fun h : x = a => ha (h ▸ hx))
      (fun h : x = b => hb (h ▸ hx))]

omit [Fintype Γ] in
theorem jo_swap_smul_of_mem {a b : Γ} {A : Finset Γ} (ha : a ∈ A) (hb : b ∈ A) :
    swap a b • A = A := by
  apply Finset.eq_of_subset_of_card_le
  · intro x hx
    obtain ⟨y, hy, rfl⟩ := mem_smul_finset.1 hx
    rw [Perm.smul_def]
    rcases eq_or_ne y a with rfl | hya
    · rw [swap_apply_left]; exact hb
    rcases eq_or_ne y b with rfl | hyb
    · rw [swap_apply_right]; exact ha
    rw [swap_apply_of_ne_of_ne hya hyb]; exact hy
  · rw [card_smul_finset]

omit [Fintype Γ] in
/-- A stabilizing permutation fixing every cell fixes `V₀` pointwise. -/
theorem jo_fix_V0 {J : JEmb Γ} (hJ : JHyp J) {σ : Perm Γ} (hσ : σ • J = J)
    (hc : ∀ A ∈ J.Λ, σ • A = A) : ∀ v ∈ J.V0, σ v = v := by
  obtain ⟨hV, -, hf⟩ := (jo_smul_eq_iff σ J).1 hσ
  intro v hv
  have hσv : σ v ∈ J.V0 := by
    rw [← hV]
    exact smul_mem_smul_finset hv
  refine hJ.inj _ hσv v hv ?_
  rw [hf v]
  exact jo_smul_fixed fun A hA => hc A (hJ.sub v hv hA)

/-- The base case: a stabilizing permutation fixing every cell is a product of swaps of the
generating set. -/
theorem jo_base {J : JEmb Γ} (hJ : JHyp J) {S : Set (Perm Γ)}
    (hS : ∀ g ∈ S, g • J = J)
    (hcell : ∀ A ∈ J.Λ, ∀ a ∈ A, ∀ b ∈ A, a ≠ b → swap a b ∈ S)
    (hrest : ∀ a b : Γ, a ∉ J.V0 → (∀ A ∈ J.Λ, a ∉ A) → b ∉ J.V0 → (∀ A ∈ J.Λ, b ∉ A) →
      a ≠ b → swap a b ∈ S) :
    ∀ (n : ℕ) (σ : Perm Γ), σ.support.card = n → σ • J = J → (∀ A ∈ J.Λ, σ • A = A) →
      σ ∈ Subgroup.closure S := by
  intro n
  induction n using Nat.strong_induction_on with
  | _ n ih =>
  intro σ hn hσ hc
  by_cases h1 : σ = 1
  · rw [h1]; exact Subgroup.one_mem _
  obtain ⟨a, ha⟩ : ∃ a, σ a ≠ a := by
    by_contra hne
    push Not at hne
    exact h1 (Equiv.ext hne)
  have hV := jo_fix_V0 hJ hσ hc
  have haV : a ∉ J.V0 := fun h => ha (hV a h)
  -- the swap lies in the generating set and fixes every cell and `V₀`
  have hsw : swap a (σ a) ∈ S ∧ ∀ A ∈ J.Λ, swap a (σ a) • A = A := by
    by_cases hA : ∃ A ∈ J.Λ, a ∈ A
    · obtain ⟨A, hA, haA⟩ := hA
      have hσa : σ a ∈ A := by
        rw [← hc A hA]
        exact smul_mem_smul_finset haA
      refine ⟨hcell A hA a haA (σ a) hσa ha.symm, fun C hC => ?_⟩
      by_cases hCA : C = A
      · subst hCA; exact jo_swap_smul_of_mem haA hσa
      · have hd := hJ.disj C hC A hA hCA
        exact jo_swap_smul_of_not_mem (fun h => disjoint_left.1 hd h haA)
          (fun h => disjoint_left.1 hd h hσa)
    · push Not at hA
      have hσaV : σ a ∉ J.V0 := fun h => ha (σ.injective (hV _ h))
      have hσaC : ∀ B ∈ J.Λ, σ a ∉ B := fun B hB h => by
        have : a ∈ σ⁻¹ • B := by
          rw [mem_smul_finset]
          exact ⟨σ a, h, by simp [Perm.smul_def]⟩
        have hinv : σ⁻¹ • B = B := by rw [inv_smul_eq_iff, hc B hB]
        exact hA B hB (hinv ▸ this)
      exact ⟨hrest a (σ a) haV hA hσaV hσaC (Ne.symm ha), fun C hC =>
        jo_swap_smul_of_not_mem (hA C hC) (hσaC C hC)⟩
  have hτJ : (swap a (σ a) * σ) • J = J := by rw [mul_smul, hσ, hS _ hsw.1]
  have hτc : ∀ A ∈ J.Λ, (swap a (σ a) * σ) • A = A := fun A hA => by
    rw [mul_smul, hc A hA, hsw.2 A hA]
  have hτ := ih _ (hn ▸ Equiv.Perm.card_support_swap_mul ha) _ rfl hτJ hτc
  have : σ = swap a (σ a) * (swap a (σ a) * σ) := by
    rw [← mul_assoc, swap_mul_self, one_mul]
  rw [this]
  exact Subgroup.mul_mem _ (Subgroup.subset_closure hsw.1) hτ

/-- **The stabilizer of a Johnson embedding is generated by** swaps inside cells, swaps outside
`V₀ ∪ ⋃Λ`, and, for each moved cell, a stabilizing element moving it the same way and fixing the
other cells. -/
theorem jo_closure_eq {J : JEmb Γ} (hJ : JHyp J) {S : Set (Perm Γ)}
    (hS : ∀ g ∈ S, g • J = J)
    (hcell : ∀ A ∈ J.Λ, ∀ a ∈ A, ∀ b ∈ A, a ≠ b → swap a b ∈ S)
    (hrest : ∀ a b : Γ, a ∉ J.V0 → (∀ A ∈ J.Λ, a ∉ A) → b ∉ J.V0 → (∀ A ∈ J.Λ, b ∉ A) →
      a ≠ b → swap a b ∈ S)
    (hmove : ∀ σ : Perm Γ, σ • J = J → ∀ A ∈ J.Λ, σ • A ≠ A →
      ∃ g ∈ S, g • A = σ • A ∧ ∀ C ∈ J.Λ, C ≠ A → C ≠ σ • A → g • C = C) :
    Subgroup.closure S = MulAction.stabilizer (Perm Γ) J := by
  apply le_antisymm
  · rw [Subgroup.closure_le]
    intro g hg
    exact MulAction.mem_stabilizer_iff.2 (hS g hg)
  · intro σ hσ
    rw [MulAction.mem_stabilizer_iff] at hσ
    -- induction on the number of moved cells
    suffices key : ∀ (n : ℕ) (σ : Perm Γ), (J.Λ.filter fun A => σ • A ≠ A).card ≤ n →
        σ • J = J → σ ∈ Subgroup.closure S from key _ σ le_rfl hσ
    intro n
    induction n with
    | zero =>
      intro σ hn hσ
      refine jo_base hJ hS hcell hrest _ σ rfl hσ fun A hA => ?_
      by_contra h
      have : A ∈ J.Λ.filter fun A => σ • A ≠ A := mem_filter.2 ⟨hA, h⟩
      have h0 : (J.Λ.filter fun A => σ • A ≠ A).card = 0 := by omega
      rw [card_eq_zero] at h0
      rw [h0] at this
      exact absurd this (Finset.notMem_empty _)
    | succ n ih =>
      intro σ hn hσ
      rcases Nat.lt_or_ge (J.Λ.filter fun A => σ • A ≠ A).card (n + 1) with hlt | hge
      · exact ih σ (by omega) hσ
      have hn' : (J.Λ.filter fun A => σ • A ≠ A).card = n + 1 := by omega
      obtain ⟨A, hA⟩ : (J.Λ.filter fun A => σ • A ≠ A).Nonempty := by
        rw [← card_pos, hn']; exact Nat.succ_pos n
      obtain ⟨hAΛ, hAm⟩ := mem_filter.1 hA
      obtain ⟨g, hgS, hgA, hgC⟩ := hmove σ hσ A hAΛ hAm
      have hgJ := hS g hgS
      have hτJ : (g⁻¹ * σ) • J = J := by
        rw [mul_smul, hσ, inv_smul_eq_iff, hgJ]
      -- the moved cells of `g⁻¹ σ` are among those of `σ`, without `A`
      have hsub : (J.Λ.filter fun C => (g⁻¹ * σ) • C ≠ C) ⊆
          (J.Λ.filter fun C => σ • C ≠ C).erase A := by
        intro C hC
        obtain ⟨hCΛ, hCm⟩ := mem_filter.1 hC
        refine mem_erase.2 ⟨fun hCA => hCm ?_, mem_filter.2 ⟨hCΛ, fun hσC => hCm ?_⟩⟩
        · subst hCA
          rw [mul_smul, ← hgA, inv_smul_smul]
        · have hCA : C ≠ A := fun h => hAm (h ▸ hσC)
          have hCσA : C ≠ σ • A := fun h => by
            apply hCA
            have h2 : σ • C = σ • A := by rw [hσC, h]
            exact smul_left_cancel σ h2
          rw [mul_smul, hσC, inv_smul_eq_iff, hgC C hCΛ hCA hCσA]
      have hle : (J.Λ.filter fun C => (g⁻¹ * σ) • C ≠ C).card ≤ n := by
        have := card_le_card hsub
        rw [card_erase_of_mem hA, hn'] at this
        simpa using this
      have hτ := ih _ hle hτJ
      have : σ = g * (g⁻¹ * σ) := by rw [mul_inv_cancel_left]
      rw [this]
      exact Subgroup.mul_mem _ (Subgroup.subset_closure hgS) hτ

end Abstract

/-! ### Data -/

/-- Data of a trimmed Johnson embedding: points `V0`, cells `cs`, the parameter `s`, and for
every point the indices of its cells (empty off `V0`). -/
abbrev JData := List ℕ × (List (List ℕ) × (ℕ × Array (List ℕ)))

/-- The cell indices of the point `v`. -/
def jfl (d : JData) (v : ℕ) : List ℕ := d.2.2.2.getD v []

/-- The decoding of the data. -/
def jdec (m : ℕ) (d : JData) : JEmb (Fin m) := jembOf m d.1 d.2.1 d.2.2.1 d.2.2.2

/-- The representation invariant of a trimmed Johnson embedding: duplicate-free points and
cells in range, nonempty pairwise disjoint cells disjoint from `V0`, `f` trimmed off `V0`, and
on `V0` a bijection onto the `s`-sets of cell indices. -/
structure JValid (m : ℕ) (d : JData) : Prop where
  v0_nodup : d.1.Nodup
  v0_lt : ∀ v ∈ d.1, v < m
  cell_nodup : ∀ c ∈ d.2.1, c.Nodup
  cell_ne : ∀ c ∈ d.2.1, c ≠ []
  cell_lt : ∀ c ∈ d.2.1, ∀ a ∈ c, a < m
  cell_disj : d.2.1.Pairwise fun c c' => ∀ a ∈ c, a ∉ c'
  cell_v0 : ∀ c ∈ d.2.1, ∀ a ∈ c, a ∉ d.1
  trim : ∀ v, v ∉ d.1 → jfl d v = []
  f_nodup : ∀ v ∈ d.1, (jfl d v).Nodup
  f_lt : ∀ v ∈ d.1, ∀ j ∈ jfl d v, j < d.2.1.length
  f_len : ∀ v ∈ d.1, (jfl d v).length = d.2.2.1
  f_inj : ∀ v ∈ d.1, ∀ w ∈ d.1, (∀ j, j ∈ jfl d v ↔ j ∈ jfl d w) → v = w
  f_surj : ∀ T : List ℕ, T.Nodup → (∀ j ∈ T, j < d.2.1.length) → T.length = d.2.2.1 →
    ∃ v ∈ d.1, ∀ j, j ∈ jfl d v ↔ j ∈ T

/-- The index of the cell containing `u`, if any. -/
def jcell (cs : List (List ℕ)) (u : ℕ) : Option ℕ :=
  (List.range cs.length).find? fun i => decide (u ∈ cs.getD i [])

/-- The points `< m` outside `V0` and the cells. -/
def jrest (m : ℕ) (d : JData) : List ℕ :=
  (List.range m).filter fun u => decide (u ∉ d.1) && (jcell d.2.1 u).isNone

/-- The point of `V0'` whose cells are the images under `π` of those of `u`. -/
def preV (d d' : JData) (π : ℕ → ℕ) (u : ℕ) : ℕ :=
  (d'.1.find? fun w => setEqD d'.2.1.length (jfl d' w) ((jfl d u).map π)).getD u

/-- **The map of points carried by a matching `π` of the cells and a map `ρ` of the rest.** The
`p`-th point of the `i`-th cell goes to the `p`-th point of the `π i`-th cell, a point of `V0`
to the point of `V0'` whose cells are the images of its own, and the rest by `ρ`. -/
def jmap (d d' : JData) (π ρ : ℕ → ℕ) (u : ℕ) : ℕ :=
  match jcell d.2.1 u with
  | some i => (d'.2.1.getD (π i) []).getD ((d.2.1.getD i []).idxOf u) 0
  | none => if u ∈ d.1 then preV d d' π u else ρ u

section DataLemmas

variable {m : ℕ} {d d' : JData}

theorem jdec_V0 : (jdec m d).V0 = setOf m d.1 := rfl
theorem jdec_Λ : (jdec m d).Λ = famOf m d.2.1 := rfl
theorem jdec_s : (jdec m d).s = d.2.2.1 := rfl
theorem jdec_f (x : Fin m) : (jdec m d).f x = famIdx m d.2.1 (jfl d x.val) := rfl

theorem jo_cells_disj {cs : List (List ℕ)} (hp : cs.Pairwise fun c c' => ∀ a ∈ c, a ∉ c')
    {i j : ℕ} (hi : i < cs.length) (hj : j < cs.length) (hij : i ≠ j) {u : ℕ}
    (hu : u ∈ cs.getD i []) : u ∉ cs.getD j [] := by
  rw [List.getD_eq_getElem _ _ hi] at hu
  rw [List.getD_eq_getElem _ _ hj]
  rcases Nat.lt_or_gt_of_ne hij with h | h
  · exact List.pairwise_iff_getElem.1 hp i j hi hj h u hu
  · intro hu'
    exact List.pairwise_iff_getElem.1 hp j i hj hi h u hu' hu

theorem jcell_some {cs : List (List ℕ)} {u i : ℕ} (h : jcell cs u = some i) :
    i < cs.length ∧ u ∈ cs.getD i [] := by
  have hm := List.mem_of_find?_eq_some h
  have hp := List.find?_some h
  simp only [decide_eq_true_eq] at hp
  exact ⟨List.mem_range.1 hm, hp⟩

theorem jcell_none {cs : List (List ℕ)} {u : ℕ} :
    jcell cs u = none ↔ ∀ i < cs.length, u ∉ cs.getD i [] := by
  rw [jcell, List.find?_eq_none]
  simp

theorem jcell_eq_some {cs : List (List ℕ)} (hp : cs.Pairwise fun c c' => ∀ a ∈ c, a ∉ c')
    {u i : ℕ} (hi : i < cs.length) (hu : u ∈ cs.getD i []) : jcell cs u = some i := by
  cases h : jcell cs u with
  | none => exact absurd hu (jcell_none.1 h i hi)
  | some j =>
    obtain ⟨hj, huj⟩ := jcell_some h
    by_contra hne
    have hij : i ≠ j := fun e => hne (by rw [e])
    exact jo_cells_disj hp hi hj hij hu huj

theorem getD_mem_cell {cs : List (List ℕ)} {i : ℕ} (hi : i < cs.length) :
    cs.getD i [] ∈ cs := by
  rw [List.getD_eq_getElem _ _ hi]; exact List.getElem_mem hi

theorem jo_setEqD_iff {n : ℕ} {l l' : List ℕ} (hl : ∀ j ∈ l, j < n) (hl' : ∀ j ∈ l', j < n) :
    setEqD n l l' = true ↔ ∀ j, j ∈ l ↔ j ∈ l' := by
  simp only [setEqD, List.all_eq_true, List.mem_range, decide_eq_true_eq]
  constructor
  · intro h j
    by_cases hj : j < n
    · exact h j hj
    · exact ⟨fun h' => absurd (hl j h') hj, fun h' => absurd (hl' j h') hj⟩
  · intro h j _
    exact h j

theorem mem_jrest {u : ℕ} : u ∈ jrest m d ↔ u < m ∧ u ∉ d.1 ∧ jcell d.2.1 u = none := by
  simp only [jrest, List.mem_filter, List.mem_range, Bool.and_eq_true, decide_eq_true_eq,
    Option.isNone_iff_eq_none]

theorem jrest_nodup : (jrest m d).Nodup := List.Nodup.filter _ List.nodup_range

/-- Under the invariant, `preV` finds the point of `V0'` with the given cells. -/
theorem preV_spec (hv' : JValid m d') {π : ℕ → ℕ} {u : ℕ}
    (hT : ((jfl d u).map π).Nodup) (hTk : ∀ j ∈ (jfl d u).map π, j < d'.2.1.length)
    (hTs : ((jfl d u).map π).length = d'.2.2.1) :
    preV d d' π u ∈ d'.1 ∧ ∀ j, j ∈ jfl d' (preV d d' π u) ↔ j ∈ (jfl d u).map π := by
  obtain ⟨w, hw, hwT⟩ := hv'.f_surj _ hT hTk hTs
  have hex : (d'.1.find? fun w => setEqD d'.2.1.length (jfl d' w) ((jfl d u).map π)).isSome :=
    by
    rw [List.find?_isSome]
    exact ⟨w, hw, (jo_setEqD_iff (hv'.f_lt w hw) hTk).2 hwT⟩
  obtain ⟨w', hw'⟩ := Option.isSome_iff_exists.1 hex
  have hmem := List.mem_of_find?_eq_some hw'
  have hp := List.find?_some hw'
  have hval : preV d d' π u = w' := by rw [preV, hw']; rfl
  rw [hval]
  exact ⟨hmem, (jo_setEqD_iff (hv'.f_lt w' hmem) hTk).1 hp⟩

end DataLemmas

/-! ### The general map -/

/-- The hypotheses under which `jmap d d' π ρ` and `jmap d' d π' ρ'` are inverse permutations
carrying the embedding of `d` to that of `d'`. -/
structure JMapHyp (m : ℕ) (d d' : JData) (π π' ρ ρ' : ℕ → ℕ) : Prop where
  v : JValid m d
  v' : JValid m d'
  s : d.2.2.1 = d'.2.2.1
  k : d.2.1.length = d'.2.1.length
  π_lt : ∀ i < d.2.1.length, π i < d.2.1.length
  π'_lt : ∀ i < d.2.1.length, π' i < d.2.1.length
  π'π : ∀ i < d.2.1.length, π' (π i) = i
  ππ' : ∀ i < d.2.1.length, π (π' i) = i
  size : ∀ i < d.2.1.length, (d'.2.1.getD (π i) []).length = (d.2.1.getD i []).length
  ρ_mem : ∀ u ∈ jrest m d, ρ u ∈ jrest m d'
  ρ'_mem : ∀ u ∈ jrest m d', ρ' u ∈ jrest m d
  ρ'ρ : ∀ u ∈ jrest m d, ρ' (ρ u) = u
  ρρ' : ∀ u ∈ jrest m d', ρ (ρ' u) = u

section JMap

variable {m : ℕ} {d d' : JData} {π π' ρ ρ' : ℕ → ℕ}

theorem JMapHyp.symm (h : JMapHyp m d d' π π' ρ ρ') : JMapHyp m d' d π' π ρ' ρ where
  v := h.v'
  v' := h.v
  s := h.s.symm
  k := h.k.symm
  π_lt i hi := by have := h.π'_lt i (h.k ▸ hi); rwa [h.k] at this
  π'_lt i hi := by have := h.π_lt i (h.k ▸ hi); rwa [h.k] at this
  π'π i hi := h.ππ' i (h.k ▸ hi)
  ππ' i hi := h.π'π i (h.k ▸ hi)
  size i hi := by
    have hi' : i < d.2.1.length := h.k ▸ hi
    have := h.size (π' i) (h.π'_lt i hi')
    rw [h.ππ' i hi'] at this
    exact this.symm
  ρ_mem := h.ρ'_mem
  ρ'_mem := h.ρ_mem
  ρ'ρ := h.ρρ'
  ρρ' := h.ρ'ρ

/-- The images of the cells of a point of `V0`. -/
theorem jmap_T (h : JMapHyp m d d' π π' ρ ρ') {u : ℕ} (hu : u ∈ d.1) :
    ((jfl d u).map π).Nodup ∧ (∀ j ∈ (jfl d u).map π, j < d'.2.1.length) ∧
      ((jfl d u).map π).length = d'.2.2.1 := by
  refine ⟨?_, fun j hj => ?_, by rw [List.length_map, h.v.f_len u hu, h.s]⟩
  · refine (h.v.f_nodup u hu).map_on fun a ha b hb e => ?_
    rw [← h.π'π a (h.v.f_lt u hu a ha), e, h.π'π b (h.v.f_lt u hu b hb)]
  · obtain ⟨a, ha, rfl⟩ := List.mem_map.1 hj
    rw [← h.k]
    exact h.π_lt a (h.v.f_lt u hu a ha)

/-- A point of `V0` goes to a point of `V0'` whose cells are the images of its own. -/
theorem jmap_V0 (h : JMapHyp m d d' π π' ρ ρ') {u : ℕ} (hu : u ∈ d.1) :
    jmap d d' π ρ u ∈ d'.1 ∧
      ∀ j, j ∈ jfl d' (jmap d d' π ρ u) ↔ j ∈ (jfl d u).map π := by
  have hnone : jcell d.2.1 u = none := jcell_none.2 fun i hi hui =>
    h.v.cell_v0 _ (getD_mem_cell hi) u hui hu
  have hval : jmap d d' π ρ u = preV d d' π u := by rw [jmap, hnone]; simp [hu]
  obtain ⟨hT, hTk, hTs⟩ := jmap_T h hu
  rw [hval]
  exact preV_spec h.v' hT hTk hTs

/-- A point of a cell goes to the same position of the matched cell. -/
theorem jmap_cell (h : JMapHyp m d d' π π' ρ ρ') {i u : ℕ} (hi : i < d.2.1.length)
    (hu : u ∈ d.2.1.getD i []) :
    jmap d d' π ρ u ∈ d'.2.1.getD (π i) [] ∧
      (d'.2.1.getD (π i) []).idxOf (jmap d d' π ρ u) = (d.2.1.getD i []).idxOf u := by
  have hc : jcell d.2.1 u = some i := jcell_eq_some h.v.cell_disj hi hu
  have hval : jmap d d' π ρ u = (d'.2.1.getD (π i) []).getD ((d.2.1.getD i []).idxOf u) 0 := by
    rw [jmap, hc]
  have hp : (d.2.1.getD i []).idxOf u < (d'.2.1.getD (π i) []).length := by
    rw [h.size i hi]; exact List.idxOf_lt_length_of_mem hu
  have hπi : π i < d'.2.1.length := h.k ▸ h.π_lt i hi
  rw [hval, List.getD_eq_getElem _ _ hp]
  exact ⟨List.getElem_mem hp,
    (h.v'.cell_nodup _ (getD_mem_cell hπi)).idxOf_getElem _ hp⟩

/-- A point of the rest goes by `ρ`. -/
theorem jmap_rest (d' : JData) (π ρ : ℕ → ℕ) {u : ℕ} (hu : u ∈ jrest m d) :
    jmap d d' π ρ u = ρ u := by
  obtain ⟨-, huV, hc⟩ := mem_jrest.1 hu
  rw [jmap, hc]; simp [huV]

theorem jmap_lt (h : JMapHyp m d d' π π' ρ ρ') {u : ℕ} (hu : u < m) :
    jmap d d' π ρ u < m := by
  cases hc : jcell d.2.1 u with
  | some i =>
    obtain ⟨hi, hui⟩ := jcell_some hc
    have hπi : π i < d'.2.1.length := h.k ▸ h.π_lt i hi
    exact h.v'.cell_lt _ (getD_mem_cell hπi) _ (jmap_cell h hi hui).1
  | none =>
    by_cases hV : u ∈ d.1
    · exact h.v'.v0_lt _ (jmap_V0 h hV).1
    · have hr : u ∈ jrest m d := mem_jrest.2 ⟨hu, hV, hc⟩
      rw [jmap_rest d' π ρ hr]
      exact (mem_jrest.1 (h.ρ_mem u hr)).1

theorem jmap_left (h : JMapHyp m d d' π π' ρ ρ') {u : ℕ} (hu : u < m) :
    jmap d' d π' ρ' (jmap d d' π ρ u) = u := by
  cases hc : jcell d.2.1 u with
  | some i =>
    obtain ⟨hi, hui⟩ := jcell_some hc
    have hπi : π i < d'.2.1.length := h.k ▸ h.π_lt i hi
    obtain ⟨hw, hwi⟩ := jmap_cell h hi hui
    obtain ⟨hw', hw'i⟩ := jmap_cell h.symm hπi hw
    have hc' : jcell d.2.1 (jmap d' d π' ρ' (jmap d d' π ρ u)) = some i := by
      rw [h.π'π i hi] at hw'
      exact jcell_eq_some h.v.cell_disj hi hw'
    rw [h.π'π i hi, hwi] at hw'i
    rw [h.π'π i hi] at hw'
    have hnd := h.v.cell_nodup _ (getD_mem_cell hi)
    have h1 := List.getElem_idxOf (List.idxOf_lt_length_of_mem hw')
    have h2 := List.getElem_idxOf (List.idxOf_lt_length_of_mem hui)
    simp only [hw'i] at h1
    exact h1.symm.trans h2
  | none =>
    by_cases hV : u ∈ d.1
    · obtain ⟨hw, hwT⟩ := jmap_V0 h hV
      obtain ⟨hv, hvT⟩ := jmap_V0 h.symm hw
      refine h.v.f_inj _ hv u hV fun j => ?_
      rw [hvT j]
      constructor
      · intro hj
        obtain ⟨a, ha, rfl⟩ := List.mem_map.1 hj
        obtain ⟨b, hb, rfl⟩ := List.mem_map.1 ((hwT a).1 ha)
        rw [h.π'π b (h.v.f_lt u hV b hb)]
        exact hb
      · intro hj
        refine List.mem_map.2 ⟨π j, (hwT _).2 (List.mem_map.2 ⟨j, hj, rfl⟩), ?_⟩
        exact h.π'π j (h.v.f_lt u hV j hj)
    · have hr : u ∈ jrest m d := mem_jrest.2 ⟨hu, hV, hc⟩
      rw [jmap_rest d' π ρ hr, jmap_rest d π' ρ' (h.ρ_mem u hr), h.ρ'ρ u hr]

/-- **The general map and its reverse are inverse permutations.** -/
theorem jmap_invPair (h : JMapHyp m d d' π π' ρ ρ') :
    Graph.InvPair m (jmap d d' π ρ) (jmap d' d π' ρ') :=
  ⟨fun _ hu => jmap_lt h hu, fun _ hu => jmap_lt h.symm hu, fun _ hu => jmap_left h hu,
    fun _ hu => jmap_left h.symm hu⟩

end JMap

section JMapDecode

variable {m : ℕ} {d d' : JData} {π π' ρ ρ' : ℕ → ℕ}

/-- The permutation of the general map. -/
def jperm (m : ℕ) (d d' : JData) (π π' ρ ρ' : ℕ → ℕ) : PermData :=
  Graph.PermData.ofFun m (jmap d d' π ρ) (jmap d' d π' ρ')

theorem jperm_valid (h : JMapHyp m d d' π π' ρ ρ') : (jperm m d d' π π' ρ ρ').Valid m :=
  Graph.valid_ofFun (jmap_invPair h)

theorem jperm_apply (h : JMapHyp m d d' π π' ρ ρ') (x : Fin m) :
    (PermData.denote m (jperm m d d' π π' ρ ρ') x).val = jmap d d' π ρ x.val := by
  have := Graph.act_denote_ofFun (jmap_invPair h) x.2
  rwa [Sims.act_of_lt _ x.2] at this

/-- A point outside `V0` goes outside `V0'`. -/
theorem jmap_not_V0 (h : JMapHyp m d d' π π' ρ ρ') {u : ℕ} (hu : u < m) (hV : u ∉ d.1) :
    jmap d d' π ρ u ∉ d'.1 := by
  cases hc : jcell d.2.1 u with
  | some i =>
    obtain ⟨hi, hui⟩ := jcell_some hc
    have hπi : π i < d'.2.1.length := h.k ▸ h.π_lt i hi
    exact h.v'.cell_v0 _ (getD_mem_cell hπi) _ (jmap_cell h hi hui).1
  | none =>
    have hr : u ∈ jrest m d := mem_jrest.2 ⟨hu, hV, hc⟩
    rw [jmap_rest d' π ρ hr]
    exact (mem_jrest.1 (h.ρ_mem u hr)).2.1

theorem jperm_cellAt (h : JMapHyp m d d' π π' ρ ρ') {i : ℕ} (hi : i < d.2.1.length) :
    PermData.denote m (jperm m d d' π π' ρ ρ') • cellAt m d.2.1 i = cellAt m d'.2.1 (π i) := by
  set σ := PermData.denote m (jperm m d d' π π' ρ ρ')
  have hπi : π i < d'.2.1.length := h.k ▸ h.π_lt i hi
  apply Finset.eq_of_subset_of_card_le
  · intro y hy
    obtain ⟨x, hx, rfl⟩ := mem_smul_finset.1 hy
    rw [cellAt, mem_setOf] at hx ⊢
    rw [Perm.smul_def, jperm_apply h]
    exact (jmap_cell h hi hx).1
  · rw [card_smul_finset, cellAt, cellAt,
      card_setOf (h.v.cell_nodup _ (getD_mem_cell hi)) (h.v.cell_lt _ (getD_mem_cell hi)),
      card_setOf (h.v'.cell_nodup _ (getD_mem_cell hπi)) (h.v'.cell_lt _ (getD_mem_cell hπi)),
      h.size i hi]

theorem jperm_V0 (h : JMapHyp m d d' π π' ρ ρ') :
    PermData.denote m (jperm m d d' π π' ρ ρ') • setOf m d.1 = setOf m d'.1 := by
  set σ := PermData.denote m (jperm m d d' π π' ρ ρ')
  ext y
  rw [mem_smul_finset, mem_setOf]
  constructor
  · rintro ⟨x, hx, rfl⟩
    rw [mem_setOf] at hx
    rw [Perm.smul_def, jperm_apply h]
    exact (jmap_V0 h hx).1
  · intro hy
    have hlt := h.v'.v0_lt _ hy
    refine ⟨⟨jmap d' d π' ρ' y.val, jmap_lt h.symm y.2⟩, ?_, ?_⟩
    · rw [mem_setOf]; exact (jmap_V0 h.symm hy).1
    · apply Fin.ext
      rw [Perm.smul_def, jperm_apply h]
      exact jmap_left h.symm y.2

theorem jperm_famOf (h : JMapHyp m d d' π π' ρ ρ') :
    PermData.denote m (jperm m d d' π π' ρ ρ') • famOf m d.2.1 = famOf m d'.2.1 := by
  ext Y
  rw [mem_smul_finset, famOf_eq_image, famOf_eq_image, Finset.mem_image]
  constructor
  · rintro ⟨X, hX, rfl⟩
    obtain ⟨i, hi, rfl⟩ := Finset.mem_image.1 hX
    rw [Finset.mem_range] at hi
    exact ⟨π i, Finset.mem_range.2 (h.k ▸ h.π_lt i hi), (jperm_cellAt h hi).symm⟩
  · rintro ⟨i', hi', rfl⟩
    rw [Finset.mem_range] at hi'
    have hi'' : i' < d.2.1.length := h.k ▸ hi'
    refine ⟨cellAt m d.2.1 (π' i'), Finset.mem_image.2 ⟨π' i',
      Finset.mem_range.2 (h.π'_lt i' hi''), rfl⟩, ?_⟩
    rw [jperm_cellAt h (h.π'_lt i' hi''), h.ππ' i' hi'']

theorem jperm_famIdx (h : JMapHyp m d d' π π' ρ ρ') {l : List ℕ}
    (hl : ∀ j ∈ l, j < d.2.1.length) :
    PermData.denote m (jperm m d d' π π' ρ ρ') • famIdx m d.2.1 l = famIdx m d'.2.1 (l.map π) := by
  ext Y
  rw [mem_smul_finset, mem_famIdx]
  constructor
  · rintro ⟨X, hX, rfl⟩
    obtain ⟨j, hj, rfl⟩ := mem_famIdx.1 hX
    exact ⟨π j, List.mem_map.2 ⟨j, hj, rfl⟩, (jperm_cellAt h (hl j hj)).symm⟩
  · rintro ⟨j', hj', rfl⟩
    obtain ⟨j, hj, rfl⟩ := List.mem_map.1 hj'
    exact ⟨cellAt m d.2.1 j, mem_famIdx.2 ⟨j, hj, rfl⟩, jperm_cellAt h (hl j hj)⟩

theorem famIdx_congr {m : ℕ} {cs : List (List ℕ)} {l l' : List ℕ} (h : ∀ j, j ∈ l ↔ j ∈ l') :
    famIdx m cs l = famIdx m cs l' := by
  ext Y
  rw [mem_famIdx, mem_famIdx]
  simp only [h]

theorem jperm_f (h : JMapHyp m d d' π π' ρ ρ') (x : Fin m) :
    (jdec m d').f (PermData.denote m (jperm m d d' π π' ρ ρ') x) =
      PermData.denote m (jperm m d d' π π' ρ ρ') • (jdec m d).f x := by
  rw [jdec_f, jdec_f, jperm_apply h]
  by_cases hV : x.val ∈ d.1
  · rw [famIdx_congr (jmap_V0 h hV).2, jperm_famIdx h (h.v.f_lt _ hV)]
  · rw [h.v.trim _ hV, h.v'.trim _ (jmap_not_V0 h x.2 hV)]
    simp [famIdx]

/-- **The general map carries the embedding of `d` to that of `d'`.** -/
theorem jperm_smul (h : JMapHyp m d d' π π' ρ ρ') :
    PermData.denote m (jperm m d d' π π' ρ ρ') • jdec m d = jdec m d' := by
  set σ := PermData.denote m (jperm m d d' π π' ρ ρ')
  show JEmb.mk (σ • (jdec m d).V0) (σ • (jdec m d).Λ) (jdec m d).s
    (fun v => σ • (jdec m d).f (σ⁻¹ • v)) = jdec m d'
  rw [jdec_V0, jdec_Λ, jdec_s, jperm_V0 h, jperm_famOf h, h.s]
  show JEmb.mk _ _ _ _ = JEmb.mk _ _ _ _
  congr 1
  funext y
  have := jperm_f h (σ⁻¹ • y)
  rw [show σ (σ⁻¹ • y) = y from smul_inv_smul σ y] at this
  exact this.symm

end JMapDecode


/-! ### The generators of the stabilizer -/

/-- The transposition of `a` and `b` as a map of numbers. -/
def jswap (a b u : ℕ) : ℕ := if u = a then b else if u = b then a else u

/-- A transposition as permutation data. -/
def swapPD (m a b : ℕ) : PermData := Graph.PermData.ofFun m (jswap a b) (jswap a b)

/-- The ordered pairs of distinct entries of a list. -/
def pairsD (l : List ℕ) : List (ℕ × ℕ) :=
  l.flatMap fun a => (l.filter fun b => b != a).map fun b => (a, b)

/-- The swap of the cells `i` and `j` with the permutation it induces on `V0`. -/
def cellSwapPD (m : ℕ) (d : JData) (i j : ℕ) : PermData :=
  jperm m d d (jswap i j) (jswap i j) id id

/-- **The generators of the stabilizer of a trimmed Johnson embedding**: transpositions inside
cells, transpositions of the rest, and swaps of equal cells. -/
def johnGensD (m : ℕ) (d : JData) : List PermData :=
  (d.2.1.flatMap fun c => (pairsD c).map fun p => swapPD m p.1 p.2) ++
  ((pairsD (jrest m d)).map fun p => swapPD m p.1 p.2) ++
  ((List.range d.2.1.length).flatMap fun i =>
    ((List.range d.2.1.length).filter fun j => i != j &&
        (d.2.1.getD i []).length == (d.2.1.getD j []).length).map fun j => cellSwapPD m d i j)

section Gens

variable {m : ℕ} {d : JData}

theorem jswap_invol (a b u : ℕ) : jswap a b (jswap a b u) = u := by
  unfold jswap; split_ifs <;> omega

theorem jswap_lt {a b n u : ℕ} (ha : a < n) (hb : b < n) (hu : u < n) : jswap a b u < n := by
  unfold jswap; split_ifs <;> omega

theorem swap_invPair {a b : ℕ} (ha : a < m) (hb : b < m) :
    Graph.InvPair m (jswap a b) (jswap a b) :=
  ⟨fun _ hu => jswap_lt ha hb hu, fun _ hu => jswap_lt ha hb hu,
    fun u _ => jswap_invol a b u, fun u _ => jswap_invol a b u⟩

theorem swapPD_valid {a b : ℕ} (ha : a < m) (hb : b < m) : (swapPD m a b).Valid m :=
  Graph.valid_ofFun (swap_invPair ha hb)

theorem denote_swapPD {a b : ℕ} (ha : a < m) (hb : b < m) :
    PermData.denote m (swapPD m a b) = swap ⟨a, ha⟩ ⟨b, hb⟩ := by
  refine Graph.denote_ofFun_eq (swap_invPair ha hb) fun i hi => ?_
  rw [Sims.act_of_lt _ hi, swap_apply_def, jswap]
  split_ifs <;> simp_all [Fin.ext_iff]

theorem mem_pairsD {l : List ℕ} {a b : ℕ} : (a, b) ∈ pairsD l ↔ a ∈ l ∧ b ∈ l ∧ b ≠ a := by
  simp only [pairsD, List.mem_flatMap, List.mem_map, List.mem_filter, bne_iff_ne, ne_eq,
    Prod.mk.injEq]
  constructor
  · rintro ⟨a', ha', b', ⟨hb', hne⟩, rfl, rfl⟩
    exact ⟨ha', hb', hne⟩
  · rintro ⟨ha, hb, hne⟩
    exact ⟨a, ha, b, ⟨hb, hne⟩, rfl, rfl⟩

/-- The cells are distinct sets. -/
theorem jcells_distinct (hv : JValid m d) : CellsDistinct m d.2.1 := by
  intro i hi j hj he
  by_contra hij
  obtain ⟨a, ha⟩ := List.exists_mem_of_ne_nil _ (hv.cell_ne _ (getD_mem_cell hi))
  have hlt := hv.cell_lt _ (getD_mem_cell hi) a ha
  have : (⟨a, hlt⟩ : Fin m) ∈ setOf m (d.2.1.getD j []) := by
    rw [← he, mem_setOf]; exact ha
  exact jo_cells_disj hv.cell_disj hi hj hij ha (mem_setOf.1 this)

theorem famIdx_inj (hv : JValid m d) {l l' : List ℕ} (hl : ∀ j ∈ l, j < d.2.1.length)
    (hl' : ∀ j ∈ l', j < d.2.1.length) (h : famIdx m d.2.1 l = famIdx m d.2.1 l') :
    ∀ j, j ∈ l ↔ j ∈ l' := by
  have key : ∀ {l l' : List ℕ}, (∀ j ∈ l, j < d.2.1.length) → (∀ j ∈ l', j < d.2.1.length) →
      famIdx m d.2.1 l = famIdx m d.2.1 l' → ∀ j ∈ l, j ∈ l' := by
    intro l l' hl hl' h j hj
    have : cellAt m d.2.1 j ∈ famIdx m d.2.1 l' := by
      rw [← h]; exact mem_famIdx.2 ⟨j, hj, rfl⟩
    obtain ⟨j', hj', he⟩ := mem_famIdx.1 this
    rwa [jcells_distinct hv j' (hl' j' hj') j (hl j hj) he] at hj'
  exact fun j => ⟨key hl hl' h j, key hl' hl h.symm j⟩

/-- **The invariant gives the stabilizer hypotheses.** -/
theorem jhyp_of_valid (hv : JValid m d) : JHyp (jdec m d) where
  disj A hA B hB hAB := by
    rw [jdec_Λ, famOf_eq_image, Finset.mem_image] at hA hB
    obtain ⟨i, hi, rfl⟩ := hA
    obtain ⟨j, hj, rfl⟩ := hB
    rw [Finset.mem_range] at hi hj
    have hij : i ≠ j := fun e => hAB (by rw [e])
    rw [Finset.disjoint_left]
    intro x hx hx'
    rw [cellAt, mem_setOf] at hx hx'
    exact jo_cells_disj hv.cell_disj hi hj hij hx hx'
  sub v hv0 := by
    intro A hA
    rw [jdec_f] at hA
    obtain ⟨j, hj, rfl⟩ := mem_famIdx.1 hA
    rw [jdec_V0, mem_setOf] at hv0
    rw [jdec_Λ, famOf_eq_image]
    exact Finset.mem_image.2 ⟨j, Finset.mem_range.2 (hv.f_lt _ hv0 j hj), rfl⟩
  inj v hv0 w hw0 h := by
    rw [jdec_V0, mem_setOf] at hv0 hw0
    rw [jdec_f, jdec_f] at h
    exact Fin.ext (hv.f_inj _ hv0 _ hw0
      (famIdx_inj hv (hv.f_lt _ hv0) (hv.f_lt _ hw0) h))

/-- The hypotheses of the general map for a swap of two cells of equal size. -/
theorem cellSwap_hyp (hv : JValid m d) {i j : ℕ} (hi : i < d.2.1.length)
    (hj : j < d.2.1.length) (hs : (d.2.1.getD i []).length = (d.2.1.getD j []).length) :
    JMapHyp m d d (jswap i j) (jswap i j) id id where
  v := hv
  v' := hv
  s := rfl
  k := rfl
  π_lt _ hl := jswap_lt hi hj hl
  π'_lt _ hl := jswap_lt hi hj hl
  π'π l _ := jswap_invol i j l
  ππ' l _ := jswap_invol i j l
  size l _ := by
    unfold jswap
    split_ifs with h1 h2
    · subst h1; exact hs.symm
    · subst h2; exact hs
    · rfl
  ρ_mem _ hu := hu
  ρ'_mem _ hu := hu
  ρ'ρ _ _ := rfl
  ρρ' _ _ := rfl

/-- A transposition of two points outside `V0` fixing every cell stabilizes the embedding. -/
theorem swap_stab (hv : JValid m d) {a b : Fin m} (ha : a.val ∉ d.1) (hb : b.val ∉ d.1)
    (hc : ∀ A ∈ (jdec m d).Λ, swap a b • A = A) : swap a b • jdec m d = jdec m d := by
  have hJ := jhyp_of_valid hv
  rw [jo_smul_eq_iff]
  refine ⟨jo_swap_smul_of_not_mem (by rw [jdec_V0, mem_setOf]; exact ha)
      (by rw [jdec_V0, mem_setOf]; exact hb), jo_smul_fixed hc, fun v => ?_⟩
  by_cases hvV : v.val ∈ d.1
  · have hva : v ≠ a := fun e => ha (e ▸ hvV)
    have hvb : v ≠ b := fun e => hb (e ▸ hvV)
    rw [swap_apply_of_ne_of_ne hva hvb]
    exact (jo_smul_fixed fun A hA =>
      hc A (hJ.sub v (by rw [jdec_V0, mem_setOf]; exact hvV) hA)).symm
  · have hσv : (swap a b v).val ∉ d.1 := by
      rw [swap_apply_def]
      split_ifs
      · exact hb
      · exact ha
      · exact hvV
    rw [jdec_f, jdec_f, hv.trim _ hvV, hv.trim _ hσv]
    simp [famIdx]

theorem mem_johnGensD {g : PermData} : g ∈ johnGensD m d ↔
    (∃ c ∈ d.2.1, ∃ a b, (a, b) ∈ pairsD c ∧ g = swapPD m a b) ∨
    (∃ a b, (a, b) ∈ pairsD (jrest m d) ∧ g = swapPD m a b) ∨
    (∃ i < d.2.1.length, ∃ j < d.2.1.length, i ≠ j ∧
      (d.2.1.getD i []).length = (d.2.1.getD j []).length ∧ g = cellSwapPD m d i j) := by
  simp only [johnGensD, List.mem_append, List.mem_flatMap, List.mem_map, List.mem_filter,
    List.mem_range, Bool.and_eq_true, bne_iff_ne, ne_eq, beq_iff_eq, Prod.exists]
  constructor
  · rintro ((⟨c, hc, a, b, hp, rfl⟩ | ⟨a, b, hp, rfl⟩) | ⟨i, hi, j, ⟨hj, hij, hs⟩, rfl⟩)
    · exact Or.inl ⟨c, hc, a, b, hp, rfl⟩
    · exact Or.inr (Or.inl ⟨a, b, hp, rfl⟩)
    · exact Or.inr (Or.inr ⟨i, hi, j, hj, hij, hs, rfl⟩)
  · rintro (⟨c, hc, a, b, hp, rfl⟩ | ⟨a, b, hp, rfl⟩ | ⟨i, hi, j, hj, hij, hs, rfl⟩)
    · exact Or.inl (Or.inl ⟨c, hc, a, b, hp, rfl⟩)
    · exact Or.inl (Or.inr ⟨a, b, hp, rfl⟩)
    · exact Or.inr ⟨i, hi, j, ⟨hj, hij, hs⟩, rfl⟩

theorem johnGensD_valid (hv : JValid m d) : ∀ g ∈ johnGensD m d, g.Valid m := by
  intro g hg
  rcases mem_johnGensD.1 hg with ⟨c, hc, a, b, hp, rfl⟩ | ⟨a, b, hp, rfl⟩ |
      ⟨i, hi, j, hj, -, hs, rfl⟩
  · obtain ⟨ha, hb, -⟩ := mem_pairsD.1 hp
    exact swapPD_valid (hv.cell_lt c hc a ha) (hv.cell_lt c hc b hb)
  · obtain ⟨ha, hb, -⟩ := mem_pairsD.1 hp
    exact swapPD_valid (mem_jrest.1 ha).1 (mem_jrest.1 hb).1
  · exact jperm_valid (cellSwap_hyp hv hi hj hs)

/-- Every generator stabilizes the embedding. -/
theorem johnGensD_stab (hv : JValid m d) :
    ∀ g ∈ johnGensD m d, PermData.denote m g • jdec m d = jdec m d := by
  have hJ := jhyp_of_valid hv
  intro g hg
  rcases mem_johnGensD.1 hg with ⟨c, hc, a, b, hp, rfl⟩ | ⟨a, b, hp, rfl⟩ |
      ⟨i, hi, j, hj, -, hs, rfl⟩
  · obtain ⟨ha, hb, -⟩ := mem_pairsD.1 hp
    have hal := hv.cell_lt c hc a ha
    have hbl := hv.cell_lt c hc b hb
    rw [denote_swapPD hal hbl]
    obtain ⟨i, hi, rfl⟩ := List.getElem_of_mem hc
    refine swap_stab hv (hv.cell_v0 _ hc a ha) (hv.cell_v0 _ hc b hb) fun A hA => ?_
    rw [jdec_Λ, famOf_eq_image, Finset.mem_image] at hA
    obtain ⟨l, hl, rfl⟩ := hA
    rw [Finset.mem_range] at hl
    by_cases hli : l = i
    · subst hli
      apply jo_swap_smul_of_mem <;> rw [cellAt, mem_setOf, List.getD_eq_getElem _ _ hl]
      · exact ha
      · exact hb
    · have hd : ∀ x ∈ d.2.1[i], x ∉ d.2.1.getD l [] := fun x hx => by
        have := jo_cells_disj hv.cell_disj hi hl (Ne.symm hli)
          (show x ∈ d.2.1.getD i [] by rw [List.getD_eq_getElem _ _ hi]; exact hx)
        exact this
      apply jo_swap_smul_of_not_mem <;> rw [cellAt, mem_setOf]
      · exact hd a ha
      · exact hd b hb
  · obtain ⟨ha, hb, -⟩ := mem_pairsD.1 hp
    obtain ⟨hal, haV, hac⟩ := mem_jrest.1 ha
    obtain ⟨hbl, hbV, hbc⟩ := mem_jrest.1 hb
    rw [denote_swapPD hal hbl]
    refine swap_stab hv haV hbV fun A hA => ?_
    rw [jdec_Λ, famOf_eq_image, Finset.mem_image] at hA
    obtain ⟨l, hl, rfl⟩ := hA
    rw [Finset.mem_range] at hl
    apply jo_swap_smul_of_not_mem <;> rw [cellAt, mem_setOf]
    · exact jcell_none.1 hac l hl
    · exact jcell_none.1 hbc l hl
  · exact jperm_smul (cellSwap_hyp hv hi hj hs)

/-- **The generators generate the stabilizer.** -/
theorem johnGensD_closure (hv : JValid m d) :
    Subgroup.closure {σ | ∃ g ∈ johnGensD m d, PermData.denote m g = σ} =
      MulAction.stabilizer (Perm (Fin m)) (jdec m d) := by
  have hJ := jhyp_of_valid hv
  refine jo_closure_eq hJ ?_ ?_ ?_ ?_
  · rintro σ ⟨g, hg, rfl⟩
    exact johnGensD_stab hv g hg
  · intro A hA a ha b hb hab
    rw [jdec_Λ, famOf_eq_image, Finset.mem_image] at hA
    obtain ⟨i, hi, rfl⟩ := hA
    rw [Finset.mem_range] at hi
    rw [cellAt, mem_setOf] at ha hb
    refine ⟨swapPD m a.val b.val, mem_johnGensD.2 (Or.inl ⟨_, getD_mem_cell hi, a.val, b.val,
      mem_pairsD.2 ⟨ha, hb, fun e => hab (Fin.ext e.symm)⟩, rfl⟩), denote_swapPD a.2 b.2⟩
  · intro a b haV hac hbV hbc hab
    have hr : ∀ x : Fin m, x ∉ (jdec m d).V0 → (∀ A ∈ (jdec m d).Λ, x ∉ A) →
        x.val ∈ jrest m d := fun x hxV hxc => by
      rw [jdec_V0, mem_setOf] at hxV
      refine mem_jrest.2 ⟨x.2, hxV, jcell_none.2 fun i hi hxi => hxc (cellAt m d.2.1 i) ?_ ?_⟩
      · rw [jdec_Λ, famOf_eq_image]
        exact Finset.mem_image.2 ⟨i, Finset.mem_range.2 hi, rfl⟩
      · rw [cellAt, mem_setOf]; exact hxi
    refine ⟨swapPD m a.val b.val, mem_johnGensD.2 (Or.inr (Or.inl ⟨a.val, b.val,
      mem_pairsD.2 ⟨hr a haV hac, hr b hbV hbc, fun e => hab (Fin.ext e.symm)⟩, rfl⟩)),
      denote_swapPD a.2 b.2⟩
  · intro σ hσ A hA hσA
    have hΛ := ((jo_smul_eq_iff σ _).1 hσ).2.1
    have hσAΛ : σ • A ∈ (jdec m d).Λ := by
      rw [← hΛ]; exact smul_mem_smul_finset hA
    rw [jdec_Λ, famOf_eq_image, Finset.mem_image] at hA hσAΛ
    obtain ⟨i, hi, rfl⟩ := hA
    obtain ⟨j, hj, hjA⟩ := hσAΛ
    rw [Finset.mem_range] at hi hj
    have hij : i ≠ j := fun e => hσA (by rw [← hjA, e])
    have hs : (d.2.1.getD i []).length = (d.2.1.getD j []).length := by
      have := card_smul_finset σ (cellAt m d.2.1 i)
      rw [← hjA, cellAt, cellAt,
        card_setOf (hv.cell_nodup _ (getD_mem_cell hj)) (hv.cell_lt _ (getD_mem_cell hj)),
        card_setOf (hv.cell_nodup _ (getD_mem_cell hi)) (hv.cell_lt _ (getD_mem_cell hi))]
        at this
      exact this.symm
    have hh := cellSwap_hyp hv hi hj hs
    refine ⟨_, ⟨cellSwapPD m d i j, mem_johnGensD.2 (Or.inr (Or.inr ⟨i, hi, j, hj, hij, hs,
      rfl⟩)), rfl⟩, ?_, ?_⟩
    · rw [← hjA]
      show PermData.denote m (jperm m d d _ _ id id) • cellAt m d.2.1 i = _
      rw [jperm_cellAt hh hi]
      simp [jswap]
    · intro C hC hCA hCσ
      rw [jdec_Λ, famOf_eq_image, Finset.mem_image] at hC
      obtain ⟨l, hl, rfl⟩ := hC
      rw [Finset.mem_range] at hl
      have hli : l ≠ i := fun e => hCA (by rw [e])
      have hlj : l ≠ j := fun e => hCσ (by rw [e, hjA])
      show PermData.denote m (jperm m d d _ _ id id) • cellAt m d.2.1 l = _
      rw [jperm_cellAt hh hl]
      simp [jswap, hli, hlj]

end Gens

/-! ### The isomorphism search -/

/-- The sorted sizes of the cells. -/
def sizesD (d : JData) : List ℕ := (d.2.1.map List.length).insertionSort (· ≤ ·)

/-- The keys `[size, i]` of the cells, ordered lexicographically. -/
def keysD (d : JData) : List (List ℕ) :=
  (List.range d.2.1.length).map fun i => [(d.2.1.getD i []).length, i]

/-- The cell indices ordered by size, then index. -/
def ordD (d : JData) : List ℕ :=
  ((keysD d).insertionSort (· ≤ ·)).map fun l => l.getD 1 0

/-- The matching of the cells: the `r`-th cell of `d` in size order goes to the `r`-th of `d'`. -/
def piD (d d' : JData) (i : ℕ) : ℕ := (ordD d').getD ((ordD d).idxOf i) 0

/-- The matching of the rest, in list order. -/
def rmapD (m : ℕ) (d d' : JData) (u : ℕ) : ℕ := (jrest m d').getD ((jrest m d).idxOf u) 0

/-- The invariants compared by the search: `s`, the number of cells, their sorted sizes and the
size of the rest. -/
def profileD (m : ℕ) (d d' : JData) : Bool :=
  d.2.2.1 == d'.2.2.1 && d.2.1.length == d'.2.1.length && sizesD d == sizesD d' &&
    (jrest m d).length == (jrest m d').length

/-- **The isomorphism search.** -/
def johnIsoD (m : ℕ) (d d' : JData) : Option PermData :=
  if profileD m d d' then
    some (jperm m d d' (piD d d') (piD d' d) (rmapD m d d') (rmapD m d' d))
  else none

section Iso

variable {m : ℕ} {d d' : JData}

theorem getD_zero_mono {l l' : List ℕ} (h : l ≤ l') : l.getD 0 0 ≤ l'.getD 0 0 := by
  rcases l with _ | ⟨a, t⟩
  · exact Nat.zero_le _
  rcases l' with _ | ⟨a', t'⟩
  · exact absurd h (not_le.2 (List.Lex.nil))
  show a ≤ a'
  by_contra hlt
  push Not at hlt
  exact absurd h (not_le.2 (List.Lex.rel hlt))

theorem ordD_perm (d : JData) : (ordD d).Perm (List.range d.2.1.length) := by
  have h1 := (List.perm_insertionSort (· ≤ ·) (keysD d)).map fun l => l.getD 1 0
  have h2 : (keysD d).map (fun l => l.getD 1 0) = List.range d.2.1.length := by
    rw [keysD, List.map_map]
    conv_rhs => rw [← List.map_id (List.range d.2.1.length)]
    exact List.map_congr_left fun i _ => rfl
  rw [ordD]
  exact h2 ▸ h1

theorem length_ordD (d : JData) : (ordD d).length = d.2.1.length := by
  rw [(ordD_perm d).length_eq, List.length_range]

theorem mem_ordD {d : JData} {i : ℕ} : i ∈ ordD d ↔ i < d.2.1.length := by
  rw [(ordD_perm d).mem_iff, List.mem_range]

theorem ordD_nodup (d : JData) : (ordD d).Nodup :=
  (ordD_perm d).nodup_iff.2 List.nodup_range

theorem range_map_getD {α : Type} (cs : List (List ℕ)) (f : List ℕ → α) :
    (List.range cs.length).map (fun i => f (cs.getD i [])) = cs.map f := by
  apply List.ext_getElem (by simp)
  intro n h1 h2
  simp only [List.getElem_map, List.getElem_range]
  rw [List.getD_eq_getElem _ _ (by simpa using h2)]

/-- The sizes of the cells in the order `ordD` are the sorted sizes. -/
theorem ordD_sizes (d : JData) :
    (ordD d).map (fun i => (d.2.1.getD i []).length) = sizesD d := by
  set SK := (keysD d).insertionSort (· ≤ ·)
  have hmem : ∀ x ∈ SK, ∃ i < d.2.1.length, x = [(d.2.1.getD i []).length, i] := by
    intro x hx
    obtain ⟨i, hi, rfl⟩ := List.mem_map.1 ((List.perm_insertionSort _ _).mem_iff.1 hx)
    exact ⟨i, List.mem_range.1 hi, rfl⟩
  have h1 : (ordD d).map (fun i => (d.2.1.getD i []).length) = SK.map (fun l => l.getD 0 0) := by
    rw [ordD, List.map_map]
    refine List.map_congr_left fun x hx => ?_
    obtain ⟨i, -, rfl⟩ := hmem x hx
    rfl
  rw [h1, sizesD]
  refine List.Perm.eq_of_pairwise (le := (· ≤ ·)) (fun a b _ _ h h' => Nat.le_antisymm h h')
    ((List.pairwise_insertionSort _ _).map _ fun a b h => getD_zero_mono h)
    (List.pairwise_insertionSort _ _) ?_
  refine (((List.perm_insertionSort _ _).map _).trans ?_).trans
    (List.perm_insertionSort _ _).symm
  rw [keysD, List.map_map]
  have : (List.range d.2.1.length).map (fun i => (d.2.1.getD i []).length) =
      d.2.1.map List.length := range_map_getD d.2.1 List.length
  rw [← this]
  exact List.Perm.refl _

end Iso

section IsoSpec

variable {m : ℕ} {d d' : JData}

theorem piD_lt (hk : d.2.1.length = d'.2.1.length) {i : ℕ} (hi : i < d.2.1.length) :
    piD d d' i < d'.2.1.length := by
  have hr : (ordD d).idxOf i < (ordD d').length := by
    rw [length_ordD, ← hk, ← length_ordD d]
    exact List.idxOf_lt_length_of_mem (mem_ordD.2 hi)
  rw [piD, List.getD_eq_getElem _ _ hr]
  exact mem_ordD.1 (List.getElem_mem hr)

theorem piD_inv (hk : d.2.1.length = d'.2.1.length) {i : ℕ} (hi : i < d.2.1.length) :
    piD d' d (piD d d' i) = i := by
  have hr : (ordD d).idxOf i < (ordD d').length := by
    rw [length_ordD, ← hk, ← length_ordD d]
    exact List.idxOf_lt_length_of_mem (mem_ordD.2 hi)
  have hr' : (ordD d).idxOf i < (ordD d).length :=
    List.idxOf_lt_length_of_mem (mem_ordD.2 hi)
  have hp : piD d d' i = (ordD d')[(ordD d).idxOf i] := by
    rw [piD, List.getD_eq_getElem _ _ hr]
  rw [piD, hp, (ordD_nodup d').idxOf_getElem _ hr, List.getD_eq_getElem _ _ hr']
  exact List.getElem_idxOf hr'

theorem piD_size (hk : d.2.1.length = d'.2.1.length) (hs : sizesD d = sizesD d') {i : ℕ}
    (hi : i < d.2.1.length) :
    (d'.2.1.getD (piD d d' i) []).length = (d.2.1.getD i []).length := by
  have hr' : (ordD d).idxOf i < (ordD d).length :=
    List.idxOf_lt_length_of_mem (mem_ordD.2 hi)
  have hr : (ordD d).idxOf i < (ordD d').length := by
    rw [length_ordD, ← hk, ← length_ordD d]; exact hr'
  have h := List.getElem_of_eq ((ordD_sizes d).trans (hs.trans (ordD_sizes d').symm))
    (i := (ordD d).idxOf i) (by simpa using hr')
  simp only [List.getElem_map] at h
  rw [piD, List.getD_eq_getElem _ _ hr, ← h, List.getElem_idxOf hr']

theorem rmapD_mem (hR : (jrest m d).length = (jrest m d').length) {u : ℕ}
    (hu : u ∈ jrest m d) : rmapD m d d' u ∈ jrest m d' := by
  have hr : (jrest m d).idxOf u < (jrest m d').length := by
    rw [← hR]; exact List.idxOf_lt_length_of_mem hu
  rw [rmapD, List.getD_eq_getElem _ _ hr]
  exact List.getElem_mem hr

theorem rmapD_inv (hR : (jrest m d).length = (jrest m d').length) {u : ℕ}
    (hu : u ∈ jrest m d) : rmapD m d' d (rmapD m d d' u) = u := by
  have hr' : (jrest m d).idxOf u < (jrest m d).length := List.idxOf_lt_length_of_mem hu
  have hr : (jrest m d).idxOf u < (jrest m d').length := by rw [← hR]; exact hr'
  have hp : rmapD m d d' u = (jrest m d')[(jrest m d).idxOf u] := by
    rw [rmapD, List.getD_eq_getElem _ _ hr]
  rw [rmapD, hp, jrest_nodup.idxOf_getElem _ hr, List.getD_eq_getElem _ _ hr']
  exact List.getElem_idxOf hr'

theorem profileD_iff : profileD m d d' = true ↔ d.2.2.1 = d'.2.2.1 ∧
    d.2.1.length = d'.2.1.length ∧ sizesD d = sizesD d' ∧
      (jrest m d).length = (jrest m d').length := by
  simp [profileD, and_assoc]

/-- A matching profile gives the hypotheses of the general map. -/
theorem iso_hyp (hv : JValid m d) (hv' : JValid m d') (hp : profileD m d d' = true) :
    JMapHyp m d d' (piD d d') (piD d' d) (rmapD m d d') (rmapD m d' d) := by
  obtain ⟨hs, hk, hsz, hR⟩ := profileD_iff.1 hp
  exact
  { v := hv
    v' := hv'
    s := hs
    k := hk
    π_lt := fun i hi => hk ▸ piD_lt hk hi
    π'_lt := fun i hi => piD_lt hk.symm (hk ▸ hi)
    π'π := fun i hi => piD_inv hk hi
    ππ' := fun i hi => piD_inv hk.symm (hk ▸ hi)
    size := fun i hi => piD_size hk hsz hi
    ρ_mem := fun u hu => rmapD_mem hR hu
    ρ'_mem := fun u hu => rmapD_mem hR.symm hu
    ρ'ρ := fun u hu => rmapD_inv hR hu
    ρρ' := fun u hu => rmapD_inv hR.symm hu }

theorem johnIsoD_some (hv : JValid m d) (hv' : JValid m d') {σ : PermData}
    (h : johnIsoD m d d' = some σ) :
    σ.Valid m ∧ PermData.denote m σ • jdec m d = jdec m d' := by
  unfold johnIsoD at h
  split_ifs at h with hp
  cases h
  exact ⟨jperm_valid (iso_hyp hv hv' hp), jperm_smul (iso_hyp hv hv' hp)⟩

/-- The multiset of the cell sizes, from the family. -/
theorem famOf_val_card (hv : JValid m d) :
    (famOf m d.2.1).val.map Finset.card = ↑(d.2.1.map List.length) := by
  have hnd : (d.2.1.map (setOf m)).Nodup := by
    rw [List.nodup_iff_injective_get]
    intro a b hab
    simp only [List.get_eq_getElem, List.getElem_map] at hab
    have := jcells_distinct hv a (by simpa using a.2) b (by simpa using b.2)
    rw [List.getD_eq_getElem _ _ (by simpa using a.2),
      List.getD_eq_getElem _ _ (by simpa using b.2)] at this
    exact Fin.ext (by simpa using this hab)
  rw [famOf, List.toFinset_val, List.dedup_eq_self.2 hnd, Multiset.map_coe, List.map_map]
  congr 1
  refine List.map_congr_left fun c hc => ?_
  exact card_setOf (hv.cell_nodup c hc) (hv.cell_lt c hc)

/-- The rest as a set of points. -/
theorem jrest_card :
    (jrest m d).length = (Finset.univ.filter fun x : Fin m =>
      x ∉ (jdec m d).V0 ∧ ∀ A ∈ (jdec m d).Λ, x ∉ A).card := by
  rw [← List.toFinset_card_of_nodup jrest_nodup]
  have : (jrest m d).toFinset = (Finset.univ.filter fun x : Fin m =>
      x ∉ (jdec m d).V0 ∧ ∀ A ∈ (jdec m d).Λ, x ∉ A).map Fin.valEmbedding := by
    ext u
    rw [List.mem_toFinset, mem_jrest, Finset.mem_map]
    constructor
    · rintro ⟨hu, hV, hc⟩
      refine ⟨⟨u, hu⟩, Finset.mem_filter.2 ⟨Finset.mem_univ _, ?_, ?_⟩, rfl⟩
      · rw [jdec_V0, mem_setOf]; exact hV
      · intro A hA hxA
        rw [jdec_Λ, famOf_eq_image, Finset.mem_image] at hA
        obtain ⟨i, hi, rfl⟩ := hA
        rw [cellAt, mem_setOf] at hxA
        exact jcell_none.1 hc i (Finset.mem_range.1 hi) hxA
    · rintro ⟨x, hx, rfl⟩
      obtain ⟨-, hV, hc⟩ := Finset.mem_filter.1 hx
      refine ⟨x.2, by rw [jdec_V0, mem_setOf] at hV; exact hV, jcell_none.2 fun i hi hxi => ?_⟩
      refine hc (cellAt m d.2.1 i) ?_ (by rw [cellAt, mem_setOf]; exact hxi)
      rw [jdec_Λ, famOf_eq_image]
      exact Finset.mem_image.2 ⟨i, Finset.mem_range.2 hi, rfl⟩
  rw [this, Finset.card_map]

/-- **An isomorphism has the same profile.** -/
theorem profileD_of_smul (hv : JValid m d) (hv' : JValid m d') {σ : Perm (Fin m)}
    (h : σ • jdec m d = jdec m d') : profileD m d d' = true := by
  have hV : σ • (jdec m d).V0 = (jdec m d').V0 := by rw [← h]; rfl
  have hΛ : σ • (jdec m d).Λ = (jdec m d').Λ := by rw [← h]; rfl
  have hs : (jdec m d).s = (jdec m d').s := by rw [← h]; rfl
  rw [profileD_iff]
  have hcard : (famOf m d.2.1).card = (famOf m d'.2.1).card := by
    rw [← jdec_Λ, ← jdec_Λ, ← hΛ, card_smul_finset]
  have hval : (famOf m d.2.1).val.map Finset.card = (famOf m d'.2.1).val.map Finset.card := by
    rw [← jdec_Λ, ← jdec_Λ, ← hΛ, Finset.smul_finset_def,
      Finset.image_val_of_injOn (fun a _ b _ e => smul_left_cancel σ e), Multiset.map_map]
    congr 1
    funext A
    exact (card_smul_finset σ A).symm
  refine ⟨hs, ?_, ?_, ?_⟩
  · rwa [card_famOf (jcells_distinct hv), card_famOf (jcells_distinct hv')] at hcard
  · rw [famOf_val_card hv, famOf_val_card hv', Multiset.coe_eq_coe] at hval
    rw [sizesD, sizesD]
    exact List.Perm.eq_of_pairwise (le := (· ≤ ·)) (fun a b _ _ h h' => Nat.le_antisymm h h')
      (List.pairwise_insertionSort _ _) (List.pairwise_insertionSort _ _)
      ((List.perm_insertionSort _ _).trans (hval.trans (List.perm_insertionSort _ _).symm))
  · rw [jrest_card, jrest_card, ← card_smul_finset σ]
    congr 1
    ext y
    rw [mem_smul_finset, Finset.mem_filter]
    constructor
    · rintro ⟨x, hx, rfl⟩
      obtain ⟨-, hxV, hxc⟩ := Finset.mem_filter.1 hx
      refine ⟨Finset.mem_univ _, fun hy => hxV ?_, fun A' hA' hy => ?_⟩
      · rw [← hV] at hy
        exact (smul_mem_smul_finset_iff σ).1 hy
      · rw [← hΛ] at hA'
        obtain ⟨A, hA, rfl⟩ := mem_smul_finset.1 hA'
        exact hxc A hA ((smul_mem_smul_finset_iff σ).1 hy)
    · rintro ⟨-, hyV, hyc⟩
      refine ⟨σ⁻¹ • y, Finset.mem_filter.2 ⟨Finset.mem_univ _, fun hx => hyV ?_,
        fun A hA hx => ?_⟩, smul_inv_smul σ y⟩
      · rw [← hV]
        have := smul_mem_smul_finset (a := σ) hx
        rwa [smul_inv_smul] at this
      · refine hyc (σ • A) (by rw [← hΛ]; exact smul_mem_smul_finset hA) ?_
        have := smul_mem_smul_finset (a := σ) hx
        rwa [smul_inv_smul] at this

theorem johnIsoD_none (hv : JValid m d) (hv' : JValid m d') (h : johnIsoD m d d' = none) :
    ∀ σ : Perm (Fin m), σ • jdec m d ≠ jdec m d' := by
  intro σ hσ
  unfold johnIsoD at h
  rw [profileD_of_smul hv hv' hσ] at h
  simp at h

end IsoSpec

/-! ### The operations -/

/-- **The operations on trimmed Johnson embeddings.** -/
def johnOps (m : ℕ) : StructOps m JData (JEmb (Fin m)) := ⟨jdec m, johnGensD m, johnIsoD m⟩

/-- **The operations meet Align's specification.** -/
theorem johnOps_spec (m : ℕ) : (johnOps m).Spec (JValid m) where
  gens_valid _ hv := johnGensD_valid hv
  gens_closure _ hv := johnGensD_closure hv
  iso_some _ _ hv hv' _ h := johnIsoD_some hv hv' h
  iso_none _ _ hv hv' h := johnIsoD_none hv hv' h

/-! ### Programs: basic pieces -/

section ProgBasic

open Cost Programs

variable {S : Signature} {rec : Ty × Ty} {var : Ty → Type}

/-- The type of the data of a trimmed Johnson embedding. -/
abbrev jTy : Ty :=
  .prod (.list .nat) (.prod (.list (.list .nat)) (.prod .nat (.array (.list .nat))))

/-- `jswap a b u`. -/
def jswapProg (a b u : var .nat) : Prog S rec var .nat :=
  .bind (.op2 .natEq u a) fun e₁ => .ite e₁ (.ret b)
    (.bind (.op2 .natEq u b) fun e₂ => .ite e₂ (.ret a) (.ret u))

/-- `xs.flatMap f`: map, then concatenate. -/
def joFlatMap {a' b' : Ty} (xs : var (.list a')) (f : var a' → Prog S rec var (.list b')) :
    Prog S rec var (.list b') :=
  .bind (mapList xs f) fun rows => .bind (.op1 .reverse rows) fun rr =>
  .bind (.op0 .nil) fun nil => .foldList rr nil fun acc row => .op2 .append row acc

/-- Permutation data listing two maps on `0, …, m - 1` (`PermData.ofFun`). -/
def ofFunProg (m : var .nat) (f g : var .nat → Prog S rec var .nat) : Prog S rec var Ty.perm :=
  .bind (.op1 .range m) fun xs =>
  .bind (mapList xs f) fun fl => .bind (.op1 .arrayOfList fl) fun fa =>
  .bind (mapList xs g) fun gl => .bind (.op1 .arrayOfList gl) fun ga =>
  .op2 .pair fa ga

/-- A transposition (`swapPD`). -/
def swapPDProg (m a b : var .nat) : Prog S rec var Ty.perm :=
  ofFunProg m (fun u => jswapProg a b u) (fun u => jswapProg a b u)

/-- The test `b ≠ a`. -/
def neProg (a b : var .nat) : Prog S rec var .bool :=
  .bind (.op2 .natEq b a) fun e => .op1 .not e

/-- The pairs `(a, b)` for `b` in `fl`. -/
def pairWithProg (a : var .nat) (fl : var (.list .nat)) :
    Prog S rec var (.list (.prod .nat .nat)) :=
  mapList fl fun b => .op2 .pair a b

/-- The pairs with first entry `a` (`pairsD`'s row). -/
def pairsRowProg (l : var (.list .nat)) (a : var .nat) :
    Prog S rec var (.list (.prod .nat .nat)) :=
  .bind (Toolkit.filterList l fun b => neProg a b) fun fl => pairWithProg a fl

/-- The ordered pairs of distinct entries (`pairsD`). -/
def pairsProg (l : var (.list .nat)) : Prog S rec var (.list (.prod .nat .nat)) :=
  joFlatMap l fun a => pairsRowProg l a

end ProgBasic

section ProgBasicSpecs

open Cost Programs

variable {S : Signature} {a b : Ty} {X : Ctx S} {body : a.denote → Prog S (a, b) Ty.denote b}

theorem RunsWithin.jswapProg (x y u : ℕ) :
    RunsWithin X body (Align.jswapProg x y u) (jswap x y u) 7 := by
  unfold Align.jswapProg
  by_cases h₁ : u = x
  · refine ((RunsWithin.bind_le (RunsWithin.prim _ _)
      (Sims.RunsWithin.ite_pos (show (u == x) = true by simp [h₁]) (RunsWithin.ret _))
      le_rfl).of_eq (by simp [jswap, h₁])).mono (by simp [Prim.cost])
  · by_cases h₂ : u = y
    · refine ((RunsWithin.bind_le (RunsWithin.prim _ _)
        (Sims.RunsWithin.ite_neg (show (u == x) = false by simp [h₁])
          (RunsWithin.bind_le (RunsWithin.prim _ _)
            (Sims.RunsWithin.ite_pos (show (u == y) = true by simp [h₂]) (RunsWithin.ret _))
            le_rfl)) le_rfl).of_eq (by subst h₂; simp [jswap, h₁])).mono ?_
      simp [Prim.cost]
    · refine ((RunsWithin.bind_le (RunsWithin.prim _ _)
        (Sims.RunsWithin.ite_neg (show (u == x) = false by simp [h₁])
          (RunsWithin.bind_le (RunsWithin.prim _ _)
            (Sims.RunsWithin.ite_neg (show (u == y) = false by simp [h₂]) (RunsWithin.ret _))
            le_rfl)) le_rfl).of_eq (by simp [jswap, h₁, h₂])).mono ?_
      simp [Prim.cost]

theorem jo_foldl_append_rev {α : Type*} : ∀ (rows : List (List α)),
    rows.reverse.foldl (fun acc row => row ++ acc) [] = rows.flatten := by
  intro rows
  induction rows with
  | nil => rfl
  | cons r rs ih =>
    rw [List.reverse_cons, List.foldl_append, ih]
    simp

theorem RunsWithin.joFlatMap {a' b' : Ty} {xs : List a'.denote}
    {f : a'.denote → Prog S (a, b) Ty.denote (.list b')} {F : a'.denote → List b'.denote}
    {c L : ℕ} (hf : ∀ x ∈ xs, RunsWithin X body (f x) (F x) c)
    (hL : ∀ x ∈ xs, (F x).length ≤ L) :
    RunsWithin X body (Align.joFlatMap xs f) (xs.flatMap F) (xs.length * (c + L + 6) + 4) := by
  have hfold := RunsWithin.foldList_inv (X := X) (body := body) (a' := .list b')
    (b' := .list b') (I := fun _ => True) (c := L + 1)
    (f := fun acc row => Prog.op2 .append row acc) (F := fun acc row => row ++ acc)
    (xs.map F).reverse [] (fun acc _ row hrow => by
      refine ⟨RunsWithin.prim_le rfl ?_, trivial⟩
      obtain ⟨x, hx, rfl⟩ := List.mem_map.1 (List.mem_reverse.1 hrow)
      simpa [Prim.cost] using hL x hx) trivial
  rw [jo_foldl_append_rev, List.length_reverse, List.length_map] at hfold
  apply RunsWithin.mono
  case h =>
    run_step (RunsWithin.mapList_le hf)
    run_step (RunsWithin.prim _ _)
    run_step (RunsWithin.prim _ _)
    exact hfold.1.of_eq (by simp [List.flatMap])
  case hc =>
    simp only [Prim.cost, Args.head, List.length_map, Nat.mul_add, Nat.mul_one]
    omega

theorem RunsWithin.ofFunProg (m : ℕ) {f g : ℕ → Prog S (a, b) Ty.denote .nat}
    {F G : ℕ → ℕ} {cf cg : ℕ} (hf : ∀ x < m, RunsWithin X body (f x) (F x) cf)
    (hg : ∀ x < m, RunsWithin X body (g x) (G x) cg) :
    RunsWithin X body (Align.ofFunProg m f g) (Graph.PermData.ofFun m F G)
      (m * (cf + cg + 9) + 10) := by
  apply RunsWithin.mono
  case h =>
    run_step (RunsWithin.prim _ _)
    run_step (RunsWithin.mapList_le fun x hx => hf x (List.mem_range.1 hx))
    run_step (RunsWithin.prim _ _)
    run_step (RunsWithin.mapList_le fun x hx => hg x (List.mem_range.1 hx))
    run_step (RunsWithin.prim _ _)
    exact (RunsWithin.prim _ _).of_eq rfl
  case hc =>
    simp only [Prim.cost, Prim.eval, Args.head, List.length_range, List.length_map]
    ring_nf
    omega

theorem RunsWithin.swapPDProg (m x y : ℕ) :
    RunsWithin X body (Align.swapPDProg m x y) (swapPD m x y) (m * 23 + 10) :=
  RunsWithin.ofFunProg m (fun u _ => RunsWithin.jswapProg x y u)
    (fun u _ => RunsWithin.jswapProg x y u)

theorem RunsWithin.neProg (x y : ℕ) :
    RunsWithin X body (Align.neProg x y) (y != x) 2 :=
  RunsWithin.bind_le (RunsWithin.prim _ _) ((RunsWithin.prim _ _).of_eq rfl)
    (by simp [Prim.cost])

theorem RunsWithin.pairsRowProg (l : List ℕ) (x : ℕ) :
    RunsWithin X body (Align.pairsRowProg l x)
      ((l.filter fun y => y != x).map fun y => (x, y)) (l.length * 10 + 7) := by
  apply RunsWithin.mono
  case h =>
    run_step (Toolkit.RunsWithin.filterList fun y _ => RunsWithin.neProg x y)
    exact RunsWithin.mapList_le (c := 1) fun y _ =>
      RunsWithin.prim_le rfl (by simp [Prim.cost])
  case hc =>
    have := List.length_filter_le (fun y => y != x) l
    nlinarith

theorem RunsWithin.pairsProg (l : List ℕ) :
    RunsWithin X body (Align.pairsProg l) (pairsD l)
      (l.length * (l.length * 11 + 13) + 4) := by
  refine (RunsWithin.joFlatMap (L := l.length) (fun x _ => RunsWithin.pairsRowProg l x)
    fun x _ => ?_).mono ?_
  · simp only [List.length_map]; exact List.length_filter_le _ _
  · nlinarith

end ProgBasicSpecs

/-! ### Programs: the general map -/

section ProgMap

open Cost Programs

variable {S : Signature} {rec : Ty × Ty} {var : Ty → Type}

/-- `jcell` on the array of the cells. -/
def jcellProg (csA : var (.array (.list .nat))) (k u : var .nat) :
    Prog S rec var (.option .nat) :=
  .bind (.op1 .range k) fun ks =>
  SoJProg.findProg ks fun i => .bind (.op2 .arrayGet csA i) fun c => SoJProg.memProg u c

/-- The test of `jrest`. -/
def restTestProg (V0 : var (.list .nat)) (csA : var (.array (.list .nat))) (k u : var .nat) :
    Prog S rec var .bool :=
  .bind (SoJProg.memProg u V0) fun inV => .bind (.op1 .not inV) fun nv =>
  .bind (jcellProg csA k u) fun oc =>
  .caseOption oc (.ret nv) fun _ => .op0 (.boolLit false)

/-- `jrest`. -/
def jrestProg (m : var .nat) (V0 : var (.list .nat)) (csA : var (.array (.list .nat)))
    (k : var .nat) : Prog S rec var (.list .nat) :=
  .bind (.op1 .range m) fun us => Toolkit.filterList us fun u => restTestProg V0 csA k u

/-- The test of `preV`. -/
def preTestProg (fA' : var (.array (.list .nat))) (k' : var .nat) (T : var (.list .nat))
    (w : var .nat) : Prog S rec var .bool :=
  .bind (.op2 .arrayGet fA' w) fun lw => SoJTree.setEqProg k' lw T

/-- `preV`. -/
def preVProg (fA : var (.array (.list .nat))) (V0' : var (.list .nat))
    (fA' : var (.array (.list .nat))) (k' : var .nat) (πP : var .nat → Prog S rec var .nat)
    (u : var .nat) : Prog S rec var .nat :=
  .bind (.op2 .arrayGet fA u) fun lu => .bind (mapList lu πP) fun T =>
  .bind (SoJProg.findProg V0' fun w => preTestProg fA' k' T w) fun r =>
  .caseOption r (.ret u) fun w => .ret w

/-- The image of a point of the cell `i`. -/
def cellPtProg (csA cs'A : var (.array (.list .nat))) (πP : var .nat → Prog S rec var .nat)
    (u i : var .nat) : Prog S rec var .nat :=
  .bind (πP i) fun pi => .bind (.op2 .arrayGet cs'A pi) fun c' =>
  .bind (.op2 .arrayGet csA i) fun c =>
  .bind (Coherent.idxOfProg (fun x y => Coherent.cmpNatProg x y) u c) fun p =>
  .bind (.op1 .arrayOfList c') fun ca => .op2 .arrayGet ca p

/-- **`jmap`.** -/
def jmapProg (V0 : var (.list .nat)) (csA : var (.array (.list .nat))) (k : var .nat)
    (fA : var (.array (.list .nat))) (V0' : var (.list .nat)) (cs'A : var (.array (.list .nat)))
    (k' : var .nat) (fA' : var (.array (.list .nat))) (πP ρP : var .nat → Prog S rec var .nat)
    (u : var .nat) : Prog S rec var .nat :=
  .bind (jcellProg csA k u) fun oc =>
  .caseOption oc
    (.bind (SoJProg.memProg u V0) fun inV =>
      .ite inV (preVProg fA V0' fA' k' πP u) (ρP u))
    fun i => cellPtProg csA cs'A πP u i

/-- **`jperm`.** -/
def jpermProg (m : var .nat) (V0 : var (.list .nat)) (csA : var (.array (.list .nat)))
    (k : var .nat) (fA : var (.array (.list .nat))) (V0' : var (.list .nat))
    (cs'A : var (.array (.list .nat))) (k' : var .nat) (fA' : var (.array (.list .nat)))
    (πP π'P ρP ρ'P : var .nat → Prog S rec var .nat) : Prog S rec var Ty.perm :=
  ofFunProg m (fun u => jmapProg V0 csA k fA V0' cs'A k' fA' πP ρP u)
    (fun u => jmapProg V0' cs'A k' fA' V0 csA k fA π'P ρ'P u)

end ProgMap

/-- Bounds on the sizes of the data. -/
structure JBound (B : ℕ) (d : JData) : Prop where
  v0 : d.1.length ≤ B
  k : d.2.1.length ≤ B
  cell : ∀ c ∈ d.2.1, c.length ≤ B
  fl : ∀ u, (jfl d u).length ≤ B

theorem JBound.getD_cell {B : ℕ} {d : JData} (h : JBound B d) (i : ℕ) :
    (d.2.1.getD i []).length ≤ B := by
  by_cases hi : i < d.2.1.length
  · exact h.cell _ (getD_mem_cell hi)
  · rw [List.getD_eq_default _ _ (by omega)]; exact Nat.zero_le _

theorem jo_length_le_of_nodup {l : List ℕ} {n : ℕ} (hl : l.Nodup) (hlt : ∀ x ∈ l, x < n) :
    l.length ≤ n := by
  rw [← List.toFinset_card_of_nodup hl]
  calc l.toFinset.card ≤ (Finset.range n).card := Finset.card_le_card fun x hx =>
        Finset.mem_range.2 (hlt x (List.mem_toFinset.1 hx))
    _ = n := Finset.card_range n

/-- The invariant bounds the data by `m + k`. -/
theorem jbound_of_valid {m : ℕ} {d : JData} (hv : JValid m d) : JBound (m + d.2.1.length) d where
  v0 := (jo_length_le_of_nodup hv.v0_nodup hv.v0_lt).trans (Nat.le_add_right _ _)
  k := Nat.le_add_left _ _
  cell c hc := (jo_length_le_of_nodup (hv.cell_nodup c hc) (hv.cell_lt c hc)).trans
    (Nat.le_add_right _ _)
  fl u := by
    by_cases hu : u ∈ d.1
    · exact (jo_length_le_of_nodup (hv.f_nodup u hu) (hv.f_lt u hu)).trans
        (Nat.le_add_left _ _)
    · rw [hv.trim u hu]; exact Nat.zero_le _

section ProgMapSpecs

open Cost Programs

variable {S : Signature} {a b : Ty} {X : Ctx S} {body : a.denote → Prog S (a, b) Ty.denote b}

theorem jo_toArray_getD {α : Type} (l : List α) (d : α) (i : ℕ) :
    l.toArray.getD i d = l.getD i d := by
  rw [Array.getD_eq_getD_getElem?, List.getElem?_toArray, List.getD_eq_getElem?_getD]

theorem RunsWithin.jcellProg (cs : List (List ℕ)) (u : ℕ) {B : ℕ}
    (hB : ∀ i, (cs.getD i []).length ≤ B) :
    RunsWithin X body (Align.jcellProg cs.toArray cs.length u) (jcell cs u)
      (cs.length * (3 * B + 8) + 3) := by
  unfold Align.jcellProg
  apply RunsWithin.mono
  case h =>
    run_step (RunsWithin.prim _ _)
    refine (SoJProg.RunsWithin.findProg (c := 3 * B + 3) (P := fun i => decide (u ∈ cs.getD i []))
      _ fun i _ => ?_).of_eq ?_
    · refine RunsWithin.bind_le (RunsWithin.prim _ _)
        ((SoJProg.RunsWithin.memProg u (cs.toArray.getD i [])).of_eq ?_) ?_
      · simp
      · simp only [Prim.cost]
        rw [jo_toArray_getD]
        have := hB i
        omega
    · rfl
  case hc =>
    simp only [Prim.cost, Prim.eval, Args.head, List.length_range]
    nlinarith

theorem RunsWithin.restTestProg (V0 : List ℕ) (cs : List (List ℕ)) (u : ℕ) {B : ℕ}
    (hB : ∀ i, (cs.getD i []).length ≤ B) :
    RunsWithin X body (Align.restTestProg V0 cs.toArray cs.length u)
      (decide (u ∉ V0) && (jcell cs u).isNone)
      (3 * V0.length + cs.length * (3 * B + 8) + 8) := by
  unfold Align.restTestProg
  cases hc : jcell cs u with
  | none =>
    apply RunsWithin.mono
    case h =>
      run_step (SoJProg.RunsWithin.memProg u V0)
      run_step (RunsWithin.prim _ _)
      run_step (RunsWithin.jcellProg cs u hB)
      rw [hc]
      exact (RunsWithin.caseOption_none (RunsWithin.ret _)).of_eq (by simp [Prim.eval])
    case hc =>
      simp only [Prim.cost]
      omega
  | some i =>
    apply RunsWithin.mono
    case h =>
      run_step (SoJProg.RunsWithin.memProg u V0)
      run_step (RunsWithin.prim _ _)
      run_step (RunsWithin.jcellProg cs u hB)
      rw [hc]
      exact (RunsWithin.caseOption_some (RunsWithin.prim _ _)).of_eq (by simp [Prim.eval])
    case hc =>
      simp only [Prim.cost]
      omega

theorem RunsWithin.jrestProg (m : ℕ) (d : JData) {B : ℕ} (hB : JBound B d) :
    RunsWithin X body (Align.jrestProg m d.1 d.2.1.toArray d.2.1.length) (jrest m d)
      (m * (3 * B + B * (3 * B + 8) + 13) + 4) := by
  unfold Align.jrestProg
  apply RunsWithin.mono
  case h =>
    run_step (RunsWithin.prim _ _)
    exact Toolkit.RunsWithin.filterList fun u _ =>
      RunsWithin.restTestProg d.1 d.2.1 u hB.getD_cell
  case hc =>
    simp only [Prim.cost, Prim.eval, Args.head, List.length_range]
    have h1 := hB.v0
    have h2 := hB.k
    have h3 : 3 * d.1.length + d.2.1.length * (3 * B + 8) + 8 + 4 + 1 ≤
        3 * B + B * (3 * B + 8) + 13 := by nlinarith
    nlinarith [Nat.mul_le_mul_left m h3]

end ProgMapSpecs

section ProgMapSpecs2

open Cost Programs

variable {S : Signature} {a b : Ty} {X : Ctx S} {body : a.denote → Prog S (a, b) Ty.denote b}

/-- The cost of `preVProg`. -/
def preVCost (B cπ : ℕ) : ℕ := B * (cπ + 3) + B * (B * (6 * B + 10) + 7) + 8

theorem RunsWithin.preVProg (d d' : JData) {π : ℕ → ℕ} {πP : ℕ → Prog S (a, b) Ty.denote .nat}
    {cπ : ℕ} (hπ : ∀ i, RunsWithin X body (πP i) (π i) cπ) {B : ℕ} (hB : JBound B d)
    (hB' : JBound B d') (u : ℕ) :
    RunsWithin X body (Align.preVProg d.2.2.2 d'.1 d'.2.2.2 d'.2.1.length πP u)
      (preV d d' π u) (preVCost B cπ) := by
  unfold Align.preVProg
  have hlu : (jfl d u).length ≤ B := hB.fl u
  have hT : ((jfl d u).map π).length ≤ B := by rw [List.length_map]; exact hlu
  have hfind := SoJProg.RunsWithin.findProg (X := X) (body := body) (t := .nat) d'.1
    (P := fun w => setEqD d'.2.1.length (jfl d' w) ((jfl d u).map π))
    (c := 1 + setEqCost d'.2.1.length B)
    (p := fun w => Align.preTestProg d'.2.2.2 d'.2.1.length ((jfl d u).map π) w)
    fun w _ => RunsWithin.bind_le (RunsWithin.prim _ _)
      (SoJTree.RunsWithin.setEqProg _ (hB'.fl w) hT) (by simp [Prim.cost])
  have hcost : d'.1.length * (1 + setEqCost d'.2.1.length B + 4) + 1 ≤
      B * (B * (6 * B + 10) + 7) + 1 := by
    have h1 := hB'.v0
    have h2 : setEqCost d'.2.1.length B ≤ B * (6 * B + 10) + 2 := by
      unfold setEqCost; exact Nat.add_le_add_right (Nat.mul_le_mul_right _ hB'.k) _
    nlinarith
  cases hr : d'.1.find? fun w => setEqD d'.2.1.length (jfl d' w) ((jfl d u).map π) with
  | none =>
    have hv : preV d d' π u = u := by rw [preV, hr]; rfl
    rw [hv]
    apply RunsWithin.mono
    case h =>
      run_step (RunsWithin.prim _ _)
      run_step (RunsWithin.mapList_le (c := cπ) fun i _ => hπ i)
      run_step hfind
      rw [hr]
      exact RunsWithin.caseOption_none (RunsWithin.ret _)
    case hc =>
      have hlu' : (d.2.2.2.getD u []).length ≤ B := hlu
      have h3 := Nat.mul_le_mul_right (cπ + 3) hlu'
      simp only [Prim.cost, Prim.eval, Ty.default, preVCost]
      omega
  | some w =>
    have hv : preV d d' π u = w := by rw [preV, hr]; rfl
    rw [hv]
    apply RunsWithin.mono
    case h =>
      run_step (RunsWithin.prim _ _)
      run_step (RunsWithin.mapList_le (c := cπ) fun i _ => hπ i)
      run_step hfind
      rw [hr]
      exact RunsWithin.caseOption_some (RunsWithin.ret _)
    case hc =>
      have hlu' : (d.2.2.2.getD u []).length ≤ B := hlu
      have h3 := Nat.mul_le_mul_right (cπ + 3) hlu'
      simp only [Prim.cost, Prim.eval, Ty.default, preVCost]
      omega

theorem RunsWithin.cellPtProg (d d' : JData) {π : ℕ → ℕ} {πP : ℕ → Prog S (a, b) Ty.denote .nat}
    {cπ : ℕ} (hπ : ∀ i, RunsWithin X body (πP i) (π i) cπ) {B : ℕ} (hB : JBound B d)
    (hB' : JBound B d') (u i : ℕ) :
    RunsWithin X body (Align.cellPtProg d.2.1.toArray d'.2.1.toArray πP u i)
      ((d'.2.1.getD (π i) []).getD ((d.2.1.getD i []).idxOf u) 0) (cπ + 16 * B + 12) := by
  unfold Align.cellPtProg
  have hidx := Coherent.RunsWithin.idxOfProg (X := X) (body := body) (t := .nat)
    (cmp := fun x y => Coherent.cmpNatProg x y) (e := Coherent.ord3) (fun _ _ => rfl)
    (a' := u) (ce := 5) (fun x => Coherent.RunsWithin.cmpNatProg u x)
    (d.2.1.toArray.getD i [])
  apply RunsWithin.mono
  case h =>
    run_step (hπ i)
    run_step (RunsWithin.prim _ _)
    run_step (RunsWithin.prim _ _)
    run_step hidx
    run_step (RunsWithin.prim _ _)
    refine (RunsWithin.prim _ _).of_eq ?_
    simp only [Prim.eval, Ty.default, jo_toArray_getD]
  case hc =>
    simp only [Prim.cost, Prim.eval, Args.head, Ty.default, jo_toArray_getD]
    have h1 := hB.getD_cell i
    have h2 := hB'.getD_cell (π i)
    have : (d.2.1.getD i []).length * (5 + 10) ≤ B * 15 := Nat.mul_le_mul_right _ h1
    omega

/-- The cost of `jmapProg`. -/
def jmapCost (B cπ cρ : ℕ) : ℕ := B * (3 * B + 8) + 3 * B + preVCost B cπ + cπ + cρ + 16 * B + 20

theorem RunsWithin.jmapProg (d d' : JData) {π ρ : ℕ → ℕ}
    {πP ρP : ℕ → Prog S (a, b) Ty.denote .nat} {cπ cρ : ℕ}
    (hπ : ∀ i, RunsWithin X body (πP i) (π i) cπ) (hρ : ∀ u, RunsWithin X body (ρP u) (ρ u) cρ)
    {B : ℕ} (hB : JBound B d) (hB' : JBound B d') (u : ℕ) :
    RunsWithin X body (Align.jmapProg d.1 d.2.1.toArray d.2.1.length d.2.2.2 d'.1
      d'.2.1.toArray d'.2.1.length d'.2.2.2 πP ρP u) (jmap d d' π ρ u) (jmapCost B cπ cρ) := by
  unfold Align.jmapProg
  have hc0 : d.2.1.length * (3 * B + 8) + 3 ≤ B * (3 * B + 8) + 3 :=
    Nat.add_le_add_right (Nat.mul_le_mul_right _ hB.k) _
  have hv0 := hB.v0
  cases hc : jcell d.2.1 u with
  | none =>
    by_cases hV : u ∈ d.1
    · have hv : jmap d d' π ρ u = preV d d' π u := by rw [jmap, hc]; simp [hV]
      rw [hv]
      apply RunsWithin.mono
      case h =>
        run_step (RunsWithin.jcellProg d.2.1 u hB.getD_cell)
        rw [hc]
        apply RunsWithin.caseOption_none
        run_step (SoJProg.RunsWithin.memProg u d.1)
        exact Sims.RunsWithin.ite_pos (decide_eq_true hV)
          (RunsWithin.preVProg d d' hπ hB hB' u)
      case hc =>
        simp only [jmapCost]
        omega
    · have hv : jmap d d' π ρ u = ρ u := by rw [jmap, hc]; simp [hV]
      rw [hv]
      apply RunsWithin.mono
      case h =>
        run_step (RunsWithin.jcellProg d.2.1 u hB.getD_cell)
        rw [hc]
        apply RunsWithin.caseOption_none
        run_step (SoJProg.RunsWithin.memProg u d.1)
        exact Sims.RunsWithin.ite_neg (decide_eq_false hV) (hρ u)
      case hc =>
        simp only [jmapCost]
        omega
  | some i =>
    have hv : jmap d d' π ρ u =
        (d'.2.1.getD (π i) []).getD ((d.2.1.getD i []).idxOf u) 0 := by rw [jmap, hc]
    rw [hv]
    apply RunsWithin.mono
    case h =>
      run_step (RunsWithin.jcellProg d.2.1 u hB.getD_cell)
      rw [hc]
      exact RunsWithin.caseOption_some (RunsWithin.cellPtProg d d' hπ hB hB' u i)
    case hc =>
      simp only [jmapCost]
      omega

theorem RunsWithin.jpermProg (m : ℕ) (d d' : JData) {π π' ρ ρ' : ℕ → ℕ}
    {πP π'P ρP ρ'P : ℕ → Prog S (a, b) Ty.denote .nat} {cπ cρ : ℕ}
    (hπ : ∀ i, RunsWithin X body (πP i) (π i) cπ) (hπ' : ∀ i, RunsWithin X body (π'P i) (π' i) cπ)
    (hρ : ∀ u, RunsWithin X body (ρP u) (ρ u) cρ) (hρ' : ∀ u, RunsWithin X body (ρ'P u) (ρ' u) cρ)
    {B : ℕ} (hB : JBound B d) (hB' : JBound B d') :
    RunsWithin X body (Align.jpermProg m d.1 d.2.1.toArray d.2.1.length d.2.2.2 d'.1
      d'.2.1.toArray d'.2.1.length d'.2.2.2 πP π'P ρP ρ'P) (jperm m d d' π π' ρ ρ')
      (m * (2 * jmapCost B cπ cρ + 9) + 10) := by
  refine (RunsWithin.ofFunProg m (fun u _ => RunsWithin.jmapProg d d' hπ hρ hB hB' u)
    (fun u _ => RunsWithin.jmapProg d' d hπ' hρ' hB' hB u)).mono ?_
  rw [show jmapCost B cπ cρ + jmapCost B cπ cρ + 9 = 2 * jmapCost B cπ cρ + 9 by ring]

end ProgMapSpecs2

/-! ### Programs: the generators -/

section ProgGens

open Cost Programs

variable {S : Signature} {rec : Ty × Ty} {var : Ty → Type}

/-- The transpositions of a list of pairs. -/
def swapsProg (m : var .nat) (ps : var (.list (.prod .nat .nat))) :
    Prog S rec var (.list Ty.perm) :=
  mapList ps fun p => .bind (.op1 .fst p) fun x => .bind (.op1 .snd p) fun y => swapPDProg m x y

/-- The transpositions inside one cell. -/
def cellGensRowProg (m : var .nat) (c : var (.list .nat)) : Prog S rec var (.list Ty.perm) :=
  .bind (pairsProg c) fun ps => swapsProg m ps

/-- The swap of two cells (`cellSwapPD`). -/
def cellSwapProg (m : var .nat) (V0 : var (.list .nat)) (csA : var (.array (.list .nat)))
    (k : var .nat) (fA : var (.array (.list .nat))) (i j : var .nat) : Prog S rec var Ty.perm :=
  jpermProg m V0 csA k fA V0 csA k fA (fun l => jswapProg i j l) (fun l => jswapProg i j l)
    (fun u => .ret u) (fun u => .ret u)

/-- The test of the cell swaps: `i ≠ j` and equal sizes. -/
def swapTestProg (csA : var (.array (.list .nat))) (i j : var .nat) : Prog S rec var .bool :=
  .bind (neProg j i) fun ne =>
  .bind (.op2 .arrayGet csA i) fun ci => .bind (.op1 .length ci) fun li =>
  .bind (.op2 .arrayGet csA j) fun cj => .bind (.op1 .length cj) fun lj =>
  .bind (.op2 .natEq li lj) fun eq => .op2 .and ne eq

/-- The cell swaps of the cell `i`. -/
def swapRowProg (m : var .nat) (V0 : var (.list .nat)) (csA : var (.array (.list .nat)))
    (k : var .nat) (fA : var (.array (.list .nat))) (i : var .nat) :
    Prog S rec var (.list Ty.perm) :=
  .bind (.op1 .range k) fun ks =>
  .bind (Toolkit.filterList ks fun j => swapTestProg csA i j) fun js =>
  mapList js fun j => cellSwapProg m V0 csA k fA i j

/-- **The generators of the stabilizer** (`johnGensD`). -/
def johnGensProg (m : var .nat) (d : var jTy) : Prog S rec var (.list Ty.perm) :=
  .bind (.op1 .fst d) fun V0 => .bind (.op1 .snd d) fun r => .bind (.op1 .fst r) fun cs =>
  .bind (.op1 .snd r) fun r₂ => .bind (.op1 .snd r₂) fun fA =>
  .bind (.op1 .arrayOfList cs) fun csA => .bind (.op1 .length cs) fun k =>
  .bind (joFlatMap cs fun c => cellGensRowProg m c) fun gA =>
  .bind (jrestProg m V0 csA k) fun R => .bind (pairsProg R) fun ps =>
  .bind (swapsProg m ps) fun gB =>
  .bind (.op1 .range k) fun ks =>
  .bind (joFlatMap ks fun i => swapRowProg m V0 csA k fA i) fun gC =>
  .bind (.op2 .append gA gB) fun gAB => .op2 .append gAB gC

end ProgGens

section ProgGensSpecs

open Cost Programs

variable {S : Signature} {a b : Ty} {X : Ctx S} {body : a.denote → Prog S (a, b) Ty.denote b}

theorem length_pairsD_le (l : List ℕ) : (pairsD l).length ≤ l.length * l.length := by
  rw [pairsD, List.length_flatMap]
  calc (l.map fun a => ((l.filter fun b => b != a).map fun b => (a, b)).length).sum
      ≤ (l.map fun _ => l.length).sum := by
        apply List.sum_le_sum
        intro x _
        rw [List.length_map]
        exact List.length_filter_le _ _
    _ = l.length * l.length := by simp

theorem RunsWithin.swapsProg (m : ℕ) (ps : List (ℕ × ℕ)) :
    RunsWithin X body (Align.swapsProg m ps) (ps.map fun p => swapPD m p.1 p.2)
      (ps.length * (m * 23 + 15) + 2) :=
  RunsWithin.mapList_le fun p _ =>
    (RunsWithin.bind_le (RunsWithin.prim _ _) (RunsWithin.bind_le (RunsWithin.prim _ _)
      (RunsWithin.swapPDProg m p.1 p.2) le_rfl) le_rfl).mono (by simp [Prim.cost]; omega)

/-- The cost of the transpositions inside a cell of at most `B` points. -/
def rowACost (B : ℕ) : ℕ := B * (B * 11 + 13) + 4 + B * B * (B * 23 + 15) + 2

theorem RunsWithin.cellGensRowProg {m B : ℕ} (hm : m ≤ B) (c : List ℕ) (hc : c.length ≤ B) :
    RunsWithin X body (Align.cellGensRowProg m c) ((pairsD c).map fun p => swapPD m p.1 p.2)
      (rowACost B) := by
  refine RunsWithin.bind_le (RunsWithin.pairsProg c) (RunsWithin.swapsProg m _) ?_
  have h1 := length_pairsD_le c
  have h2 : (pairsD c).length ≤ B * B := h1.trans (Nat.mul_le_mul hc hc)
  have h3 : c.length * (c.length * 11 + 13) ≤ B * (B * 11 + 13) :=
    Nat.mul_le_mul hc (by omega)
  have h4 : (pairsD c).length * (m * 23 + 15) ≤ B * B * (B * 23 + 15) :=
    Nat.mul_le_mul h2 (by omega)
  unfold rowACost
  omega

/-- The cost of one cell swap. -/
def cellSwapCost (B : ℕ) : ℕ := B * (2 * jmapCost B 7 0 + 9) + 10

theorem RunsWithin.cellSwapProg {m B : ℕ} (hm : m ≤ B) (d : JData) (hB : JBound B d) (i j : ℕ) :
    RunsWithin X body (Align.cellSwapProg m d.1 d.2.1.toArray d.2.1.length d.2.2.2 i j)
      (cellSwapPD m d i j) (cellSwapCost B) := by
  have h := RunsWithin.jpermProg (X := X) (body := body) (cπ := 7) (cρ := 0) m d d
    (π := jswap i j) (π' := jswap i j) (ρ := id) (ρ' := id)
    (πP := fun l => Align.jswapProg i j l) (π'P := fun l => Align.jswapProg i j l)
    (ρP := fun u => Prog.ret u) (ρ'P := fun u => Prog.ret u)
    (fun l => RunsWithin.jswapProg i j l) (fun l => RunsWithin.jswapProg i j l)
    (fun u => (RunsWithin.ret (t := .nat) u).of_eq rfl)
    (fun u => (RunsWithin.ret (t := .nat) u).of_eq rfl) hB hB
  refine h.mono ?_
  unfold cellSwapCost
  generalize jmapCost B 7 0 = J
  exact Nat.add_le_add_right (Nat.mul_le_mul_right _ hm) _

theorem RunsWithin.swapTestProg (cs : List (List ℕ)) (i j : ℕ) {B : ℕ}
    (hB : ∀ l, (cs.getD l []).length ≤ B) :
    RunsWithin X body (Align.swapTestProg cs.toArray i j)
      (i != j && (cs.getD i []).length == (cs.getD j []).length) (2 * B + 10) := by
  unfold Align.swapTestProg
  apply RunsWithin.mono
  case h =>
    run_step (RunsWithin.neProg j i)
    run_step (RunsWithin.prim _ _)
    run_step (RunsWithin.prim _ _)
    run_step (RunsWithin.prim _ _)
    run_step (RunsWithin.prim _ _)
    run_step (RunsWithin.prim _ _)
    refine (RunsWithin.prim _ _).of_eq ?_
    simp [Prim.eval, Ty.default]
  case hc =>
    simp only [Prim.cost, Prim.eval, Args.head, Ty.default, jo_toArray_getD]
    have := hB i
    have := hB j
    omega

/-- The cost of the cell swaps of one cell. -/
def rowCCost (B : ℕ) : ℕ := B + 1 + (B * (2 * B + 14) + 3) + (B * (cellSwapCost B + 3) + 2)

theorem RunsWithin.swapRowProg {m B : ℕ} (hm : m ≤ B) (d : JData) (hB : JBound B d) (i : ℕ) :
    RunsWithin X body (Align.swapRowProg m d.1 d.2.1.toArray d.2.1.length d.2.2.2 i)
      (((List.range d.2.1.length).filter fun j => i != j &&
        (d.2.1.getD i []).length == (d.2.1.getD j []).length).map fun j => cellSwapPD m d i j)
      (rowCCost B) := by
  unfold Align.swapRowProg
  have hk := hB.k
  apply RunsWithin.mono
  case h =>
    run_step (RunsWithin.prim _ _)
    run_step (Toolkit.RunsWithin.filterList fun j _ => RunsWithin.swapTestProg d.2.1 i j
      hB.getD_cell)
    exact (RunsWithin.mapList_le fun j _ => RunsWithin.cellSwapProg hm d hB i j).mono
      (Nat.add_le_add_right (Nat.mul_le_mul_right _ ((List.length_filter_le _ _).trans
        (show _ ≤ B by simp [Prim.eval]; exact hk))) _)
  case hc =>
    simp only [Prim.cost, Prim.eval, Args.head, List.length_range, rowCCost]
    have h2 : d.2.1.length * (2 * B + 10 + 4) ≤ B * (2 * B + 14) := Nat.mul_le_mul hk (by omega)
    omega

/-- **The cost of the generators**, for data bounded by `B ≥ m`. -/
def johnGensCost (B : ℕ) : ℕ :=
  B * (rowACost B + B * B + 6) + 4 + (B * (3 * B + B * (3 * B + 8) + 13) + 4) +
    (B * (B * 11 + 13) + 4) + (B * B * (B * 23 + 15) + 2) + 3 * (B + 1) +
    (B * (rowCCost B + B + 6) + 4) + (B * (B * B) + 1) + (B * (B * B) + B * B + 1) + 20

theorem RunsWithin.johnGensProg {m B : ℕ} (hm : m ≤ B) (d : JData) (hB : JBound B d) :
    RunsWithin X body (Align.johnGensProg m d) (johnGensD m d) (johnGensCost B) := by
  unfold Align.johnGensProg
  have hk := hB.k
  have hR : (jrest m d).length ≤ m := by
    have := List.length_filter_le (fun u => decide (u ∉ d.1) && (jcell d.2.1 u).isNone)
      (List.range m)
    rwa [List.length_range] at this
  have hA := RunsWithin.joFlatMap (X := X) (body := body) (a' := .list .nat) (b' := Ty.perm)
    (xs := d.2.1) (L := B * B)
    (f := fun c => Align.cellGensRowProg m c)
    (fun c hc => RunsWithin.cellGensRowProg hm c (hB.cell c hc))
    (fun c hc => by
      rw [List.length_map]
      exact (length_pairsD_le c).trans (Nat.mul_le_mul (hB.cell c hc) (hB.cell c hc)))
  have hC := RunsWithin.joFlatMap (X := X) (body := body) (a' := .nat) (b' := Ty.perm)
    (xs := List.range d.2.1.length)
    (L := B) (f := fun i => Align.swapRowProg m d.1 d.2.1.toArray d.2.1.length d.2.2.2 i)
    (fun i _ => RunsWithin.swapRowProg hm d hB i)
    (fun i _ => by
      rw [List.length_map]
      exact (List.length_filter_le _ _).trans (by rw [List.length_range]; exact hk))
  have hlenA : (d.2.1.flatMap fun c => (pairsD c).map fun p => swapPD m p.1 p.2).length ≤
      B * (B * B) := by
    rw [List.length_flatMap]
    calc (d.2.1.map fun c => ((pairsD c).map fun p => swapPD m p.1 p.2).length).sum
        ≤ (d.2.1.map fun _ => B * B).sum := by
          apply List.sum_le_sum
          intro c hc
          rw [List.length_map]
          exact (length_pairsD_le c).trans (Nat.mul_le_mul (hB.cell c hc) (hB.cell c hc))
      _ = d.2.1.length * (B * B) := by simp
      _ ≤ B * (B * B) := Nat.mul_le_mul_right _ hk
  have hlenB : ((pairsD (jrest m d)).map fun p => swapPD m p.1 p.2).length ≤ B * B := by
    rw [List.length_map]
    exact (length_pairsD_le _).trans (Nat.mul_le_mul (hR.trans hm) (hR.trans hm))
  apply RunsWithin.mono
  case h =>
    run_step (RunsWithin.prim _ _)
    run_step (RunsWithin.prim _ _)
    run_step (RunsWithin.prim _ _)
    run_step (RunsWithin.prim _ _)
    run_step (RunsWithin.prim _ _)
    run_step (RunsWithin.prim _ _)
    run_step (RunsWithin.prim _ _)
    run_step hA
    run_step (RunsWithin.jrestProg m d hB)
    run_step (RunsWithin.pairsProg _)
    run_step (RunsWithin.swapsProg m _)
    run_step (RunsWithin.prim _ _)
    run_step hC
    run_step (RunsWithin.prim_le rfl (show _ ≤ B * (B * B) + 1 by
      simp only [Prim.cost, Args.head]; exact Nat.add_le_add_right hlenA 1))
    exact RunsWithin.prim_le rfl (show _ ≤ B * (B * B) + B * B + 1 by
      simp only [Prim.cost, Args.head, Prim.eval, List.length_append]
      exact Nat.add_le_add_right (Nat.add_le_add hlenA hlenB) 1)
  case hc =>
    simp only [Prim.cost, Prim.eval, Args.head, List.length_range, johnGensCost]
    have e1 : m * (3 * B + B * (3 * B + 8) + 13) ≤ B * (3 * B + B * (3 * B + 8) + 13) :=
      Nat.mul_le_mul_right _ hm
    have e2 : (jrest m d).length * ((jrest m d).length * 11 + 13) ≤ B * (B * 11 + 13) :=
      Nat.mul_le_mul (hR.trans hm) (by have := hR.trans hm; omega)
    have e3 : (pairsD (jrest m d)).length * (m * 23 + 15) ≤ B * B * (B * 23 + 15) :=
      Nat.mul_le_mul ((length_pairsD_le _).trans (Nat.mul_le_mul (hR.trans hm) (hR.trans hm)))
        (by omega)
    have e4 : d.2.1.length * (rowACost B + B * B + 6) ≤ B * (rowACost B + B * B + 6) :=
      Nat.mul_le_mul_right _ hk
    have e5 : d.2.1.length * (rowCCost B + B + 6) ≤ B * (rowCCost B + B + 6) :=
      Nat.mul_le_mul_right _ hk
    simp only [List.length_map] at hlenB ⊢
    omega

end ProgGensSpecs

/-! ### Programs: the isomorphism search -/

section ProgIso

open Cost Programs

variable {S : Signature} {rec : Ty × Ty} {var : Ty → Type}

/-- The sorted sizes of the cells (`sizesD`). -/
def sizesProg (cs : var (.list (.list .nat))) : Prog S rec var (.list .nat) :=
  .bind (mapList cs fun c => .op1 .length c) fun ls =>
  Coherent.sortProg (fun x y => Coherent.cmpNatProg x y) ls

/-- The key `[size, i]` of the cell `i`. -/
def joKeyProg (csA : var (.array (.list .nat))) (i : var .nat) : Prog S rec var (.list .nat) :=
  .bind (.op2 .arrayGet csA i) fun c => .bind (.op1 .length c) fun l =>
  .bind (.op0 .nil) fun nl => .bind (.op2 .cons i nl) fun t => .op2 .cons l t

/-- The second entry of a list, `0` by default. -/
def second (l : var (.list .nat)) : Prog S rec var .nat :=
  .caseList l (.op0 (.natLit 0)) fun _ t => .caseList t (.op0 (.natLit 0)) fun y _ => .ret y

/-- The cell indices ordered by size (`ordD`). -/
def ordProg (csA : var (.array (.list .nat))) (k : var .nat) : Prog S rec var (.list .nat) :=
  .bind (.op1 .range k) fun ks => .bind (mapList ks fun i => joKeyProg csA i) fun keys =>
  .bind (Coherent.sortProg (fun x y => Coherent.cmpNProg x y) keys) fun sk =>
  mapList sk fun l => second l

/-- The `r`-th entry of a list after the position of `x` in another (`piD`, `rmapD`). -/
def joMatchProg (O : var (.list .nat)) (O'A : var (.array .nat)) (x : var .nat) :
    Prog S rec var .nat :=
  .bind (Coherent.idxOfProg (fun x y => Coherent.cmpNatProg x y) x O) fun r =>
  .op2 .arrayGet O'A r

/-- Equality of two lists of numbers. -/
def listEqProg (l l' : var (.list .nat)) : Prog S rec var .bool :=
  .bind (Coherent.cmpNProg l l') fun c => .bind (.op0 (.natLit 1)) fun one => .op2 .natEq c one

/-- The profile test (`profileD`). -/
def profProg (sv sv' k k' : var .nat) (cs cs' : var (.list (.list .nat)))
    (R R' : var (.list .nat)) : Prog S rec var .bool :=
  .bind (sizesProg cs) fun sz => .bind (sizesProg cs') fun sz' =>
  .bind (.op2 .natEq sv sv') fun b₁ => .bind (.op2 .natEq k k') fun b₂ =>
  .bind (listEqProg sz sz') fun b₃ =>
  .bind (.op1 .length R) fun lR => .bind (.op1 .length R') fun lR' =>
  .bind (.op2 .natEq lR lR') fun b₄ =>
  .bind (.op2 .and b₁ b₂) fun c₁ => .bind (.op2 .and c₁ b₃) fun c₂ => .op2 .and c₂ b₄

/-- The isomorphism once the profiles agree. -/
def isoBranchProg (m : var .nat) (V0 : var (.list .nat)) (csA : var (.array (.list .nat)))
    (k : var .nat) (fA : var (.array (.list .nat))) (V0' : var (.list .nat))
    (cs'A : var (.array (.list .nat))) (k' : var .nat) (fA' : var (.array (.list .nat)))
    (R R' : var (.list .nat)) : Prog S rec var (.option Ty.perm) :=
  .bind (ordProg csA k) fun O => .bind (ordProg cs'A k') fun O' =>
  .bind (.op1 .arrayOfList O) fun OA => .bind (.op1 .arrayOfList O') fun O'A =>
  .bind (.op1 .arrayOfList R) fun RA => .bind (.op1 .arrayOfList R') fun R'A =>
  .bind (jpermProg m V0 csA k fA V0' cs'A k' fA' (fun i => joMatchProg O O'A i)
    (fun i => joMatchProg O' OA i) (fun u => joMatchProg R R'A u) (fun u => joMatchProg R' RA u))
    fun g => .op1 .some g

/-- **The isomorphism search** (`johnIsoD`). -/
def johnIsoProg (m : var .nat) (d d' : var jTy) : Prog S rec var (.option Ty.perm) :=
  .bind (.op1 .fst d) fun V0 => .bind (.op1 .snd d) fun r => .bind (.op1 .fst r) fun cs =>
  .bind (.op1 .snd r) fun r₂ => .bind (.op1 .fst r₂) fun sv => .bind (.op1 .snd r₂) fun fA =>
  .bind (.op1 .arrayOfList cs) fun csA => .bind (.op1 .length cs) fun k =>
  .bind (.op1 .fst d') fun V0' => .bind (.op1 .snd d') fun r' => .bind (.op1 .fst r') fun cs' =>
  .bind (.op1 .snd r') fun r₂' => .bind (.op1 .fst r₂') fun sv' =>
  .bind (.op1 .snd r₂') fun fA' =>
  .bind (.op1 .arrayOfList cs') fun cs'A => .bind (.op1 .length cs') fun k' =>
  .bind (jrestProg m V0 csA k) fun R => .bind (jrestProg m V0' cs'A k') fun R' =>
  .bind (profProg sv sv' k k' cs cs' R R') fun ok =>
  .ite ok (isoBranchProg m V0 csA k fA V0' cs'A k' fA' R R') (.op0 .none)

end ProgIso

section ProgIsoSpecs

open Cost Programs

variable {S : Signature} {a b : Ty} {X : Ctx S} {body : a.denote → Prog S (a, b) Ty.denote b}

/-- The cost of `sizesProg` for `k` cells of at most `B` points. -/
def sizesCost (k B : ℕ) : ℕ := k * (B + 4) + 2 + (k * (k * 17 + 10) + k + 2)

theorem RunsWithin.sizesProg (cs : List (List ℕ)) {B : ℕ} (hB : ∀ c ∈ cs, c.length ≤ B) :
    RunsWithin X body (Align.sizesProg cs) ((cs.map List.length).insertionSort (· ≤ ·))
      (sizesCost cs.length B) := by
  unfold Align.sizesProg
  refine RunsWithin.bind_le (RunsWithin.mapList_le (c := B + 1) fun c hc =>
    RunsWithin.prim_le rfl (by simp [Prim.cost]; exact hB c hc))
    ((Coherent.RunsWithin.sortProg (t := .nat) (e := Coherent.ord3) (fun _ _ => rfl) (ce := 5)
      fun x _ y => Coherent.RunsWithin.cmpNatProg x y)) ?_
  simp only [List.length_map, sizesCost]
  ring_nf
  omega

theorem RunsWithin.joKeyProg (cs : List (List ℕ)) (i : ℕ) :
    RunsWithin X body (Align.joKeyProg cs.toArray i) [(cs.getD i []).length, i]
      ((cs.getD i []).length + 6) := by
  unfold Align.joKeyProg
  apply RunsWithin.mono
  case h =>
    run_step (RunsWithin.prim _ _)
    run_step (RunsWithin.prim _ _)
    run_step (RunsWithin.prim _ _)
    run_step (RunsWithin.prim _ _)
    refine (RunsWithin.prim _ _).of_eq ?_
    simp [Prim.eval, Ty.default]
  case hc =>
    simp only [Prim.cost, Prim.eval, Args.head, Ty.default, jo_toArray_getD]
    omega

theorem RunsWithin.second (l : List ℕ) :
    RunsWithin X body (Align.second l) (l.getD 1 0) 3 := by
  unfold Align.second
  rcases l with _ | ⟨x, _ | ⟨y, t⟩⟩
  · exact (RunsWithin.caseList_nil (RunsWithin.prim _ _)).mono (by simp [Prim.cost])
  · exact (RunsWithin.caseList_cons (RunsWithin.caseList_nil (RunsWithin.prim _ _))).mono
      (by simp [Prim.cost])
  · exact (RunsWithin.caseList_cons (RunsWithin.caseList_cons (RunsWithin.ret _))).mono
      (by omega)

/-- The cost of `ordProg` for `k` cells of at most `B` points. -/
def ordCost (k B : ℕ) : ℕ := k + 1 + (k * (B + 9) + 2) + (k * (k * 48 + 10) + k + 2) + (k * 6 + 2)

theorem RunsWithin.ordProg (d : JData) {B : ℕ} (hB : JBound B d) :
    RunsWithin X body (Align.ordProg d.2.1.toArray d.2.1.length) (ordD d)
      (ordCost d.2.1.length B) := by
  unfold Align.ordProg
  apply RunsWithin.mono
  case h =>
    run_step (RunsWithin.prim _ _)
    run_step (RunsWithin.mapList_le (c := B + 6) fun i _ =>
      (RunsWithin.joKeyProg d.2.1 i).mono (by have := hB.getD_cell i; omega))
    run_step (Coherent.RunsWithin.sortProg (t := .list .nat) (e := Coherent.ord3)
      (fun _ _ => rfl) (ce := 36) fun x hx y => (Coherent.RunsWithin.cmpNProg x y).mono (by
        obtain ⟨i, _, rfl⟩ := List.mem_map.1 hx
        simp))
    exact (RunsWithin.mapList_le fun l _ => RunsWithin.second l).of_eq rfl
  case hc =>
    simp only [Prim.cost, Prim.eval, Args.head, List.length_range, List.length_map,
      List.length_insertionSort, ordCost]
    ring_nf
    omega

theorem RunsWithin.joMatchProg (O O' : List ℕ) (x : ℕ) :
    RunsWithin X body (Align.joMatchProg O O'.toArray x) (O'.getD (O.idxOf x) 0)
      (O.length * 15 + 7) := by
  unfold Align.joMatchProg
  refine RunsWithin.bind_le (Coherent.RunsWithin.idxOfProg (t := .nat) (e := Coherent.ord3)
    (fun _ _ => rfl) (ce := 5) (fun y => Coherent.RunsWithin.cmpNatProg x y) O)
    ((RunsWithin.prim _ _).of_eq ?_) ?_
  · simp [Prim.eval, Ty.default]
  · simp only [Prim.cost]; omega

theorem RunsWithin.listEqProg (l l' : List ℕ) :
    RunsWithin X body (Align.listEqProg l l') (l == l') (14 * l.length + 10) := by
  unfold Align.listEqProg
  refine RunsWithin.bind_le (Coherent.RunsWithin.cmpNProg l l')
    (RunsWithin.bind_le (RunsWithin.prim _ _) ((RunsWithin.prim _ _).of_eq ?_) le_rfl) ?_
  · simp only [Prim.eval]
    rw [Bool.eq_iff_iff, beq_iff_eq, beq_iff_eq, Coherent.ord3_eq_one]
  · simp [Prim.cost]

end ProgIsoSpecs

section ProgIsoMain

open Cost Programs

variable {S : Signature} {a b : Ty} {X : Ctx S} {body : a.denote → Prog S (a, b) Ty.denote b}

theorem sizesCost_mono {k B : ℕ} (h : k ≤ B) : sizesCost k B ≤ sizesCost B B := by
  unfold sizesCost; gcongr

theorem ordCost_mono {k B : ℕ} (h : k ≤ B) : ordCost k B ≤ ordCost B B := by
  unfold ordCost; gcongr

theorem length_sizesD (d : JData) : (sizesD d).length = d.2.1.length := by
  rw [sizesD, List.length_insertionSort, List.length_map]

/-- The cost of the profile test. -/
def profCost (B : ℕ) : ℕ := 2 * sizesCost B B + (14 * B + 10) + 2 * (B + 1) + 10

theorem jrest_length_le (m : ℕ) (d : JData) : (jrest m d).length ≤ m := by
  unfold jrest; exact (List.length_filter_le _ _).trans (by rw [List.length_range])

theorem RunsWithin.profProg {m B : ℕ} (hm : m ≤ B) (d d' : JData) (hB : JBound B d)
    (hB' : JBound B d') :
    RunsWithin X body (Align.profProg d.2.2.1 d'.2.2.1 d.2.1.length d'.2.1.length d.2.1 d'.2.1
      (jrest m d) (jrest m d')) (profileD m d d') (profCost B) := by
  unfold Align.profProg
  have hsz := sizesCost_mono (B := B) hB.k
  have hsz' := sizesCost_mono (B := B) hB'.k
  have hR := jrest_length_le m d
  have hR' := jrest_length_le m d'
  have hk := hB.k
  apply RunsWithin.mono
  case h =>
    run_step (RunsWithin.sizesProg d.2.1 hB.cell)
    run_step (RunsWithin.sizesProg d'.2.1 hB'.cell)
    run_step (RunsWithin.prim _ _)
    run_step (RunsWithin.prim _ _)
    run_step (RunsWithin.listEqProg _ _)
    run_step (RunsWithin.prim _ _)
    run_step (RunsWithin.prim _ _)
    run_step (RunsWithin.prim _ _)
    run_step (RunsWithin.prim _ _)
    run_step (RunsWithin.prim _ _)
    exact (RunsWithin.prim _ _).of_eq rfl
  case hc =>
    simp only [Prim.cost, Args.head, profCost]
    rw [List.length_insertionSort, List.length_map]
    omega

/-- The cost of the isomorphism branch. -/
def branchCost (B : ℕ) : ℕ :=
  2 * ordCost B B + 4 * (B + 1) + (B * (2 * jmapCost B (B * 15 + 7) (B * 15 + 7) + 9) + 10) + 1

theorem RunsWithin.isoBranchProg {m B : ℕ} (hm : m ≤ B) (d d' : JData) (hB : JBound B d)
    (hB' : JBound B d') :
    RunsWithin X body (Align.isoBranchProg m d.1 d.2.1.toArray d.2.1.length d.2.2.2 d'.1
      d'.2.1.toArray d'.2.1.length d'.2.2.2 (jrest m d) (jrest m d'))
      (some (jperm m d d' (piD d d') (piD d' d) (rmapD m d d') (rmapD m d' d)))
      (branchCost B) := by
  unfold Align.isoBranchProg
  have hk := hB.k
  have hk' := hB'.k
  have hR := jrest_length_le m d
  have hR' := jrest_length_le m d'
  have hord := ordCost_mono (B := B) hk
  have hord' := ordCost_mono (B := B) hk'
  have hπ : ∀ i, RunsWithin X body (Align.joMatchProg (ordD d) (ordD d').toArray i) (piD d d' i)
      (B * 15 + 7) := fun i =>
    (RunsWithin.joMatchProg (ordD d) (ordD d') i).mono (by rw [length_ordD]; omega)
  have hπ' : ∀ i, RunsWithin X body (Align.joMatchProg (ordD d') (ordD d).toArray i)
      (piD d' d i) (B * 15 + 7) := fun i =>
    (RunsWithin.joMatchProg (ordD d') (ordD d) i).mono (by rw [length_ordD]; omega)
  have hρ : ∀ u, RunsWithin X body (Align.joMatchProg (jrest m d) (jrest m d').toArray u)
      (rmapD m d d' u) (B * 15 + 7) := fun u =>
    (RunsWithin.joMatchProg (jrest m d) (jrest m d') u).mono (by omega)
  have hρ' : ∀ u, RunsWithin X body (Align.joMatchProg (jrest m d') (jrest m d).toArray u)
      (rmapD m d' d u) (B * 15 + 7) := fun u =>
    (RunsWithin.joMatchProg (jrest m d') (jrest m d) u).mono (by omega)
  have hperm := (RunsWithin.jpermProg (X := X) (body := body) m d d' hπ hπ' hρ hρ' hB hB').mono
    (Nat.add_le_add_right (Nat.mul_le_mul_right
      (2 * jmapCost B (B * 15 + 7) (B * 15 + 7) + 9) hm) 10)
  apply RunsWithin.mono
  case h =>
    run_step (RunsWithin.ordProg d hB)
    run_step (RunsWithin.ordProg d' hB')
    run_step (RunsWithin.prim _ _)
    run_step (RunsWithin.prim _ _)
    run_step (RunsWithin.prim _ _)
    run_step (RunsWithin.prim _ _)
    run_step hperm
    exact RunsWithin.prim _ _
  case hc =>
    simp only [Prim.cost, Args.head, length_ordD, branchCost]
    omega

/-- **The cost of the isomorphism search**, for data bounded by `B ≥ m`. -/
def johnIsoCost (B : ℕ) : ℕ :=
  4 * (B + 1) + 2 * (B * (3 * B + B * (3 * B + 8) + 13) + 4) + profCost B + branchCost B + 30

theorem jic_le (B E P Q : ℕ) :
    1 + (1 + (1 + (1 + (1 + (1 + (B + 1 + (B + 1 + (1 + (1 + (1 + (1 + (1 + (1 + (B + 1 +
      (B + 1 + (E + (E + (P + (1 + Q))))))))))))))))))) ≤ 4 * (B + 1) + 2 * E + P + Q + 30 := by
  omega

theorem jic_le2 (B E P Q : ℕ) :
    1 + (1 + (1 + (1 + (1 + (1 + (B + 1 + (B + 1 + (1 + (1 + (1 + (1 + (1 + (1 + (B + 1 +
      (B + 1 + (E + (E + (P + (1 + 1))))))))))))))))))) ≤
      4 * (B + 1) + 2 * E + P + Q + 30 := by
  omega

theorem RunsWithin.johnIsoProg {m B : ℕ} (hm : m ≤ B) (d d' : JData) (hB : JBound B d)
    (hB' : JBound B d') :
    RunsWithin X body (Align.johnIsoProg m d d') (johnIsoD m d d') (johnIsoCost B) := by
  unfold Align.johnIsoProg
  have hk := hB.k
  have hk' := hB'.k
  have hjr := (RunsWithin.jrestProg (X := X) (body := body) m d hB).mono
    (Nat.add_le_add_right (Nat.mul_le_mul_right (3 * B + B * (3 * B + 8) + 13) hm) 4)
  have hjr' := (RunsWithin.jrestProg (X := X) (body := body) m d' hB').mono
    (Nat.add_le_add_right (Nat.mul_le_mul_right (3 * B + B * (3 * B + 8) + 13) hm) 4)
  by_cases hp : profileD m d d' = true
  · have hv : johnIsoD m d d' =
        some (jperm m d d' (piD d d') (piD d' d) (rmapD m d d') (rmapD m d' d)) := by
      simp [johnIsoD, hp]
    rw [hv]
    apply RunsWithin.mono
    case h =>
      run_step (RunsWithin.prim_le (c := 1) rfl (by simp [Prim.cost]))
      run_step (RunsWithin.prim_le (c := 1) rfl (by simp [Prim.cost]))
      run_step (RunsWithin.prim_le (c := 1) rfl (by simp [Prim.cost]))
      run_step (RunsWithin.prim_le (c := 1) rfl (by simp [Prim.cost]))
      run_step (RunsWithin.prim_le (c := 1) rfl (by simp [Prim.cost]))
      run_step (RunsWithin.prim_le (c := 1) rfl (by simp [Prim.cost]))
      run_step (RunsWithin.prim_le (c := B + 1) rfl (by simp [Prim.cost, Prim.eval]; omega))
      run_step (RunsWithin.prim_le (c := B + 1) rfl (by simp [Prim.cost, Prim.eval]; omega))
      run_step (RunsWithin.prim_le (c := 1) rfl (by simp [Prim.cost]))
      run_step (RunsWithin.prim_le (c := 1) rfl (by simp [Prim.cost]))
      run_step (RunsWithin.prim_le (c := 1) rfl (by simp [Prim.cost]))
      run_step (RunsWithin.prim_le (c := 1) rfl (by simp [Prim.cost]))
      run_step (RunsWithin.prim_le (c := 1) rfl (by simp [Prim.cost]))
      run_step (RunsWithin.prim_le (c := 1) rfl (by simp [Prim.cost]))
      run_step (RunsWithin.prim_le (c := B + 1) rfl (by simp [Prim.cost, Prim.eval]; omega))
      run_step (RunsWithin.prim_le (c := B + 1) rfl (by simp [Prim.cost, Prim.eval]; omega))
      run_step hjr
      run_step hjr'
      run_step (RunsWithin.profProg hm d d' hB hB')
      run_with Sims.RunsWithin.ite_pos hp _
      exact RunsWithin.isoBranchProg hm d d' hB hB'
    case hc =>
      exact jic_le B _ (profCost B) (branchCost B)
  · have hv : johnIsoD m d d' = none := by simp [johnIsoD, hp]
    rw [hv]
    apply RunsWithin.mono
    case h =>
      run_step (RunsWithin.prim_le (c := 1) rfl (by simp [Prim.cost]))
      run_step (RunsWithin.prim_le (c := 1) rfl (by simp [Prim.cost]))
      run_step (RunsWithin.prim_le (c := 1) rfl (by simp [Prim.cost]))
      run_step (RunsWithin.prim_le (c := 1) rfl (by simp [Prim.cost]))
      run_step (RunsWithin.prim_le (c := 1) rfl (by simp [Prim.cost]))
      run_step (RunsWithin.prim_le (c := 1) rfl (by simp [Prim.cost]))
      run_step (RunsWithin.prim_le (c := B + 1) rfl (by simp [Prim.cost, Prim.eval]; omega))
      run_step (RunsWithin.prim_le (c := B + 1) rfl (by simp [Prim.cost, Prim.eval]; omega))
      run_step (RunsWithin.prim_le (c := 1) rfl (by simp [Prim.cost]))
      run_step (RunsWithin.prim_le (c := 1) rfl (by simp [Prim.cost]))
      run_step (RunsWithin.prim_le (c := 1) rfl (by simp [Prim.cost]))
      run_step (RunsWithin.prim_le (c := 1) rfl (by simp [Prim.cost]))
      run_step (RunsWithin.prim_le (c := 1) rfl (by simp [Prim.cost]))
      run_step (RunsWithin.prim_le (c := 1) rfl (by simp [Prim.cost]))
      run_step (RunsWithin.prim_le (c := B + 1) rfl (by simp [Prim.cost, Prim.eval]; omega))
      run_step (RunsWithin.prim_le (c := B + 1) rfl (by simp [Prim.cost, Prim.eval]; omega))
      run_step hjr
      run_step hjr'
      run_step (RunsWithin.profProg hm d d' hB hB')
      run_with Sims.RunsWithin.ite_neg (Bool.eq_false_iff.2 hp) _
      exact RunsWithin.prim_le (c := 1) rfl (by simp [Prim.cost])
    case hc =>
      exact jic_le2 B _ (profCost B) (branchCost B)

end ProgIsoMain

/-! ### Well-formedness -/

section Wf

open Cost Programs

variable {S : Signature} {rec : Ty × Ty} {var₁ var₂ : Ty → Type} {r : Bool}
  {Γ : WfCtx var₁ var₂}

theorem wf_jswapProg {x₁ y₁ u₁ : var₁ .nat} {x₂ y₂ u₂ : var₂ .nat} (hx : ⟨.nat, x₁, x₂⟩ ∈ Γ)
    (hy : ⟨.nat, y₁, y₂⟩ ∈ Γ) (hu : ⟨.nat, u₁, u₂⟩ ∈ Γ) :
    Prog.Wf (S := S) (rec := rec) r Γ (jswapProg x₁ y₁ u₁) (jswapProg x₂ y₂ u₂) := by
  unfold jswapProg
  prog_wf

theorem wf_joFlatMap {a' b' : Ty} {xs₁ : var₁ (.list a')} {xs₂ : var₂ (.list a')}
    {f₁ : var₁ a' → Prog S rec var₁ (.list b')} {f₂ : var₂ a' → Prog S rec var₂ (.list b')}
    (hxs : ⟨.list a', xs₁, xs₂⟩ ∈ Γ) (hf : WfFun r Γ f₁ f₂) :
    Prog.Wf r Γ (joFlatMap xs₁ f₁) (joFlatMap xs₂ f₂) := by
  unfold joFlatMap
  refine .bind (wf_mapList hxs hf) fun _ _ => ?_
  prog_wf

theorem wf_ofFunProg {m₁ : var₁ .nat} {m₂ : var₂ .nat} {f₁ g₁ : var₁ .nat → Prog S rec var₁ .nat}
    {f₂ g₂ : var₂ .nat → Prog S rec var₂ .nat} (hm : ⟨.nat, m₁, m₂⟩ ∈ Γ) (hf : WfFun r Γ f₁ f₂)
    (hg : WfFun r Γ g₁ g₂) :
    Prog.Wf r Γ (ofFunProg m₁ f₁ g₁) (ofFunProg m₂ f₂ g₂) := by
  unfold ofFunProg
  refine .bind (.prim _ (.cons hm .nil)) fun _ _ =>
    .bind (wf_mapList (by simp) (hf.mono fun z hz => by simp [hz])) fun _ _ =>
    .bind (.prim _ (.cons (by simp) .nil)) fun _ _ =>
    .bind (wf_mapList (by simp) (hg.mono fun z hz => by simp [hz])) fun _ _ => ?_
  prog_wf

theorem wf_swapPDProg {m₁ x₁ y₁ : var₁ .nat} {m₂ x₂ y₂ : var₂ .nat} (hm : ⟨.nat, m₁, m₂⟩ ∈ Γ)
    (hx : ⟨.nat, x₁, x₂⟩ ∈ Γ) (hy : ⟨.nat, y₁, y₂⟩ ∈ Γ) :
    Prog.Wf (S := S) (rec := rec) r Γ (swapPDProg m₁ x₁ y₁) (swapPDProg m₂ x₂ y₂) := by
  unfold swapPDProg
  exact wf_ofFunProg hm (fun Γ' hΓ u₁ u₂ hu => wf_jswapProg (hΓ hx) (hΓ hy) hu)
    (fun Γ' hΓ u₁ u₂ hu => wf_jswapProg (hΓ hx) (hΓ hy) hu)

theorem wf_pairsProg {l₁ : var₁ (.list .nat)} {l₂ : var₂ (.list .nat)}
    (hl : ⟨.list .nat, l₁, l₂⟩ ∈ Γ) :
    Prog.Wf (S := S) (rec := rec) r Γ (pairsProg l₁) (pairsProg l₂) := by
  unfold pairsProg
  refine wf_joFlatMap hl fun Γ' hΓ a₁ a₂ ha => ?_
  unfold pairsRowProg pairWithProg
  refine .bind (Toolkit.wf_filterList (hΓ hl) fun Γ'' hΓ' b₁ b₂ hb => ?_) fun _ _ =>
    wf_mapList List.mem_cons_self fun Γ'' hΓ' b₁ b₂ hb => ?_
  · unfold neProg
    exact .bind (.prim _ (.cons hb (.cons (hΓ' ha) .nil))) fun _ _ =>
      .prim _ (.cons List.mem_cons_self .nil)
  · exact .prim _ (.cons (hΓ' (List.mem_cons_of_mem _ ha)) (.cons hb .nil))

theorem wf_jcellProg {csA₁ : var₁ (.array (.list .nat))} {csA₂ : var₂ (.array (.list .nat))}
    {k₁ u₁ : var₁ .nat} {k₂ u₂ : var₂ .nat} (hc : ⟨.array (.list .nat), csA₁, csA₂⟩ ∈ Γ)
    (hk : ⟨.nat, k₁, k₂⟩ ∈ Γ) (hu : ⟨.nat, u₁, u₂⟩ ∈ Γ) :
    Prog.Wf (S := S) (rec := rec) r Γ (jcellProg csA₁ k₁ u₁) (jcellProg csA₂ k₂ u₂) := by
  unfold jcellProg
  refine .bind (.prim _ (.cons hk .nil)) fun _ _ => SoJProg.wf_findProg (by simp) ?_
  intro Γ' hΓ i₁ i₂ hi
  refine .bind (.prim _ (.cons (hΓ (List.mem_cons_of_mem _ hc)) (.cons hi .nil))) fun _ _ => ?_
  exact SoJProg.wf_memProg (List.mem_cons_of_mem _ (hΓ (List.mem_cons_of_mem _ hu)))
    List.mem_cons_self

theorem wf_jrestProg {m₁ k₁ : var₁ .nat} {m₂ k₂ : var₂ .nat} {V₁ : var₁ (.list .nat)}
    {V₂ : var₂ (.list .nat)} {csA₁ : var₁ (.array (.list .nat))}
    {csA₂ : var₂ (.array (.list .nat))} (hm : ⟨.nat, m₁, m₂⟩ ∈ Γ)
    (hV : ⟨.list .nat, V₁, V₂⟩ ∈ Γ) (hc : ⟨.array (.list .nat), csA₁, csA₂⟩ ∈ Γ)
    (hk : ⟨.nat, k₁, k₂⟩ ∈ Γ) :
    Prog.Wf (S := S) (rec := rec) r Γ (jrestProg m₁ V₁ csA₁ k₁) (jrestProg m₂ V₂ csA₂ k₂) := by
  unfold jrestProg
  refine .bind (.prim _ (.cons hm .nil)) fun _ _ => Toolkit.wf_filterList (by simp) ?_
  intro Γ' hΓ u₁ u₂ hu
  have hc' := hΓ (List.mem_cons_of_mem _ hc)
  have hk' := hΓ (List.mem_cons_of_mem _ hk)
  have hV' := hΓ (List.mem_cons_of_mem _ hV)
  unfold restTestProg
  refine .bind (SoJProg.wf_memProg hu hV') fun _ _ =>
    .bind (.prim _ (.cons List.mem_cons_self .nil)) fun _ _ =>
    .bind (wf_jcellProg (by simp [hc']) (by simp [hk']) (by simp [hu])) fun _ _ => ?_
  prog_wf

theorem wf_preVProg {fA₁ fA'₁ : var₁ (.array (.list .nat))} {fA₂ fA'₂ : var₂ (.array (.list .nat))}
    {V₁ : var₁ (.list .nat)} {V₂ : var₂ (.list .nat)} {k₁ u₁ : var₁ .nat} {k₂ u₂ : var₂ .nat}
    {π₁ : var₁ .nat → Prog S rec var₁ .nat} {π₂ : var₂ .nat → Prog S rec var₂ .nat}
    (hfA : ⟨.array (.list .nat), fA₁, fA₂⟩ ∈ Γ) (hV : ⟨.list .nat, V₁, V₂⟩ ∈ Γ)
    (hfA' : ⟨.array (.list .nat), fA'₁, fA'₂⟩ ∈ Γ) (hk : ⟨.nat, k₁, k₂⟩ ∈ Γ)
    (hπ : WfFun r Γ π₁ π₂) (hu : ⟨.nat, u₁, u₂⟩ ∈ Γ) :
    Prog.Wf r Γ (preVProg fA₁ V₁ fA'₁ k₁ π₁ u₁) (preVProg fA₂ V₂ fA'₂ k₂ π₂ u₂) := by
  unfold preVProg
  refine .bind (.prim _ (.cons hfA (.cons hu .nil))) fun _ _ =>
    .bind (wf_mapList (by simp) (hπ.mono fun z hz => by simp [hz])) fun _ _ =>
    .bind (SoJProg.wf_findProg (by simp [hV]) fun Γ' hΓ w₁ w₂ hw => ?_) fun _ _ => ?_
  · unfold preTestProg
    have hfA'' : ⟨.array (.list .nat), fA'₁, fA'₂⟩ ∈ Γ' := hΓ (by simp [hfA'])
    have hk' : ⟨.nat, k₁, k₂⟩ ∈ Γ' := hΓ (by simp [hk])
    have hT : ⟨.list .nat, _, _⟩ ∈ Γ' := hΓ List.mem_cons_self
    refine .bind (.prim _ (.cons hfA'' (.cons hw .nil))) fun _ _ => ?_
    exact SoJTree.wf_setEqProg (by simp [hk']) List.mem_cons_self (by simp [hT])
  · prog_wf

end Wf

