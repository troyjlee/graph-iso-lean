module

public import GraphIso.Align.PartOps

/-!
# Sets as structures for Align

Stage 14f (`PLAN-14.md` §10, items 2–4). A set `Φ ⊆ Fin m` is a list decoded by stage 14c's
`setOf m`. It is handled as the colored partition with colour `1` on `Φ` and `0` off it and the
two blocks `Φ` and its complement (`setPart`): a permutation carries `Φ` onto `Φ'` exactly when
it carries the one partition onto the other (`so_smul_iff`). So the stabilizer of `Φ`
(`Sym(Φ) × Sym(Γ ∖ Φ)`) is generated by the partition's generators, the transpositions of the
least point of `Φ` (of its complement) with its other points, and the isomorphism search is the
partition's.

* `setPart_valid`: the partition is a colored partition of `Fin m`, for every list.
* `setOps m`, `setOps_spec`: the `StructOps` of sets.
-/

@[expose] public section

namespace GraphIso.Align

open Equiv Finset GraphIso GraphIso.SplitJohnson GraphIso.SoJProg Pointwise

/-- The points below `m` not in `l`. -/
def complL (m : ℕ) (l : List ℕ) : List ℕ := (List.range m).filter fun u => decide (u ∉ l)

/-- **A set as a colored partition**: colour `1` on the set, `0` off it, and two blocks. -/
def setPart (m : ℕ) (l : List ℕ) : Array ℕ × Array (List ℕ) :=
  (((List.range m).map fun u => if u ∈ l then 1 else 0).toArray,
    ((List.range m).map fun u => if u ∈ l then l else complL m l).toArray)

/-- **Sets as structures for Align.** -/
def setOps (m : ℕ) : StructOps m (List ℕ) (Finset (Fin m)) where
  dec := setOf m
  gens l := partGensD m (setPart m l)
  iso l l' := isoPartD m (setPart m l) (setPart m l')

section Spec

variable {m : ℕ}

theorem so_col (l : List ℕ) (u : Fin m) :
    (decPart m (setPart m l)).col u = if u ∈ setOf m l then 1 else 0 := by
  show get _ u.val = _
  simp [setPart, get, mem_setOf]

theorem so_blk (l : List ℕ) (u : Fin m) :
    (decPart m (setPart m l)).blk u = if u ∈ setOf m l then setOf m l else (setOf m l)ᶜ := by
  show setOf m (Array.getD _ u.val []) = _
  have hu : u.val < m := u.2
  simp only [setPart, Array.getD_eq_getD_getElem?, List.getElem?_toArray, List.getElem?_map,
    List.getElem?_range hu, Option.map_some, Option.getD_some, mem_setOf]
  split_ifs with h
  · rfl
  · ext v
    simp [mem_setOf, complL]

/-- **The partition of a set is a colored partition.** -/
theorem setPart_valid (l : List ℕ) : IsColPart univ m (decPart m (setPart m l)) where
  mem_blk v _ := by
    rw [so_blk]
    split_ifs with h
    · exact h
    · exact Finset.mem_compl.2 h
  blk_sub _ _ := Finset.subset_univ _
  blk_eq v _ w hw := by
    rw [so_blk] at hw ⊢
    rw [so_blk]
    by_cases hv : v ∈ setOf m l <;> by_cases hw' : w ∈ setOf m l <;> simp_all
  col_eq v _ w hw := by
    rw [so_blk] at hw
    rw [so_col, so_col]
    by_cases hv : v ∈ setOf m l <;> by_cases hw' : w ∈ setOf m l <;> simp_all
  card_eq v _ w _ hc := by
    rw [so_col, so_col] at hc
    rw [so_blk, so_blk]
    split_ifs at hc ⊢ <;> simp_all
  admissible v _ h1 w _ hc := by
    rw [so_col, so_col] at hc
    have hw : w ∈ (decPart m (setPart m l)).blk v := by
      rw [so_blk]
      split_ifs at hc ⊢ with h₁ h₂ <;> simp_all
    have hv : v ∈ (decPart m (setPart m l)).blk v := by
      rw [so_blk]
      split_ifs with h
      · exact h
      · exact Finset.mem_compl.2 h
    obtain ⟨a, ha⟩ := Finset.card_eq_one.1 h1
    rw [ha] at hw hv
    rw [Finset.mem_singleton.1 hw, Finset.mem_singleton.1 hv]
  card_le _ _ := by
    calc _ ≤ (univ : Finset (Fin m)).card := Finset.card_le_univ _
      _ = m := Finset.card_fin m

theorem so_smul_eq_iff_mem (σ : Perm (Fin m)) (A B : Finset (Fin m)) :
    σ • A = B ↔ ∀ u, (σ u ∈ B ↔ u ∈ A) := by
  constructor
  · rintro rfl u
    rw [← Perm.smul_def]
    exact Finset.smul_mem_smul_finset_iff σ
  · intro h
    ext z
    rw [← Finset.inv_smul_mem_iff, Perm.smul_def, ← h, po_apply_inv]

theorem so_smul_compl (σ : Perm (Fin m)) (A : Finset (Fin m)) : σ • Aᶜ = (σ • A)ᶜ := by
  rw [so_smul_eq_iff_mem]
  intro u
  rw [Finset.mem_compl, Finset.mem_compl, ← Perm.smul_def, Finset.smul_mem_smul_finset_iff]

/-- **A permutation carries one set onto another exactly when it carries their partitions.** -/
theorem so_smul_iff (σ : Perm (Fin m)) (l l' : List ℕ) :
    σ • setOf m l = setOf m l' ↔ σ • decPart m (setPart m l) = decPart m (setPart m l') := by
  rw [po_smul_eq_iff, so_smul_eq_iff_mem]
  constructor
  · intro h u
    rw [so_col, so_col, so_blk, so_blk]
    by_cases hu : u ∈ setOf m l
    · have hσu := (h u).2 hu
      simp only [hu, hσu, ite_true, true_and]
      exact ((so_smul_eq_iff_mem σ _ _).2 h).symm
    · have hσu : σ u ∉ setOf m l' := fun h' => hu ((h u).1 h')
      simp only [hu, hσu, ite_false, true_and]
      rw [so_smul_compl, (so_smul_eq_iff_mem σ _ _).2 h]
  · intro h u
    have := (h u).1
    rw [so_col, so_col] at this
    by_cases hu : u ∈ setOf m l <;> by_cases hσu : σ u ∈ setOf m l' <;> simp_all

theorem so_stab_eq (l : List ℕ) :
    MulAction.stabilizer (Perm (Fin m)) (setOf m l) =
      MulAction.stabilizer (Perm (Fin m)) (decPart m (setPart m l)) := by
  ext σ
  rw [MulAction.mem_stabilizer_iff, MulAction.mem_stabilizer_iff, so_smul_iff]

end Spec

/-! ### Programs -/

section Programs

open Cost Programs

variable {S : Signature} {rec : Ty × Ty} {var : Ty → Type}

/-- The colour of `u`: `1` on the set. -/
def setColProg (l : var (.list .nat)) (u : var .nat) : Prog S rec var .nat :=
  .bind (SoJProg.memProg u l) fun b => .ite b (.op0 (.natLit 1)) (.op0 (.natLit 0))

/-- `u` is not in the set. -/
def notMemProg (l : var (.list .nat)) (u : var .nat) : Prog S rec var .bool :=
  .bind (SoJProg.memProg u l) fun b => .op1 .not b

/-- The block of `u`: the set or its complement. -/
def setBlkProg (l cm : var (.list .nat)) (u : var .nat) : Prog S rec var (.list .nat) :=
  .bind (SoJProg.memProg u l) fun b => .ite b (.ret l) (.ret cm)

/-- **A set as a colored partition** (`setPart`). -/
def setPartProg (m : var .nat) (l : var (.list .nat)) :
    Prog S rec var (.prod (.array .nat) (.array (.list .nat))) :=
  .bind (.op1 .range m) fun rm => .bind (mapList rm fun u => setColProg l u) fun cl =>
  .bind (.op1 .arrayOfList cl) fun col =>
  .bind (Toolkit.filterList rm fun u => notMemProg l u) fun cm =>
  .bind (mapList rm fun u => setBlkProg l cm u) fun bl => .bind (.op1 .arrayOfList bl) fun blk =>
  .op2 .pair col blk

/-- **The stabilizer generators of a set.** -/
def setGensProg (m : var .nat) (l : var (.list .nat)) : Prog S rec var (.list Ty.perm) :=
  .bind (setPartProg m l) fun x => partGensProg m x

/-- **An isomorphism of sets.** -/
def setIsoProg (m : var .nat) (l l' : var (.list .nat)) : Prog S rec var (.option Ty.perm) :=
  .bind (setPartProg m l) fun x => .bind (setPartProg m l') fun y => partIsoProg m x y

end Programs

section ProgSpecs

open Cost Programs

variable {S : Signature} {a b : Ty} {X : Ctx S} {body : a.denote → Prog S (a, b) Ty.denote b}

/-- The cost of `setPartProg` for a list of at most `k` entries. -/
def setPartCost (m k : ℕ) : ℕ := m * (9 * k + 21) + 3 * m + 11

/-- The cost of `setGensProg`. -/
def setGensCost (m k : ℕ) : ℕ := setPartCost m k + partGensCost m (k + m)

/-- The cost of `setIsoProg`. -/
def setIsoCost (m k k' : ℕ) : ℕ :=
  setPartCost m k + setPartCost m k' + partIsoCost m (k + m) (k' + m)

theorem RunsWithin.setColProg (l : List ℕ) (u : ℕ) :
    RunsWithin X body (Align.setColProg l u) (if u ∈ l then 1 else 0) (3 * l.length + 3) := by
  by_cases h : u ∈ l
  · apply RunsWithin.mono
    case h =>
      run_step (SoJProg.RunsWithin.memProg u l)
      exact (Sims.RunsWithin.ite_pos (by simpa using h) (RunsWithin.prim _ _)).of_eq
        (by simp [h, Prim.eval])
    case hc => simp [Prim.cost]
  · apply RunsWithin.mono
    case h =>
      run_step (SoJProg.RunsWithin.memProg u l)
      exact (Sims.RunsWithin.ite_neg (by simpa using h) (RunsWithin.prim _ _)).of_eq
        (by simp [h, Prim.eval])
    case hc => simp [Prim.cost]

theorem RunsWithin.notMemProg (l : List ℕ) (u : ℕ) :
    RunsWithin X body (Align.notMemProg l u) (decide (u ∉ l)) (3 * l.length + 2) := by
  apply RunsWithin.mono
  case h =>
    run_step (SoJProg.RunsWithin.memProg u l)
    exact (RunsWithin.prim _ _).of_eq (by simp [Prim.eval])
  case hc => simp [Prim.cost]

theorem RunsWithin.setBlkProg (l cm : List ℕ) (u : ℕ) :
    RunsWithin X body (Align.setBlkProg l cm u) (if u ∈ l then l else cm) (3 * l.length + 2) := by
  by_cases h : u ∈ l
  · apply RunsWithin.mono
    case h =>
      run_step (SoJProg.RunsWithin.memProg u l)
      exact (Sims.RunsWithin.ite_pos (by simpa using h) (RunsWithin.ret _)).of_eq (by simp [h])
    case hc => omega
  · apply RunsWithin.mono
    case h =>
      run_step (SoJProg.RunsWithin.memProg u l)
      exact (Sims.RunsWithin.ite_neg (by simpa using h) (RunsWithin.ret _)).of_eq (by simp [h])
    case hc => omega

theorem RunsWithin.setPartProg (m : ℕ) (l : List ℕ) {k : ℕ} (hk : l.length ≤ k) :
    RunsWithin X body (Align.setPartProg m l) (setPart m l) (setPartCost m k) := by
  apply RunsWithin.mono
  case h =>
    run_step (RunsWithin.prim _ _)
    run_step (RunsWithin.mapList_le fun u _ => RunsWithin.setColProg l u)
    run_step (RunsWithin.prim _ _)
    run_step (Toolkit.RunsWithin.filterList fun u _ => RunsWithin.notMemProg l u)
    run_step (RunsWithin.mapList_le fun u _ => RunsWithin.setBlkProg l _ u)
    run_step (RunsWithin.prim _ _)
    exact (RunsWithin.prim _ _).of_eq (by simp [Prim.eval, setPart, complL])
  case hc =>
    simp only [Prim.cost, Prim.eval, Args.head, List.length_range, List.length_map, setPartCost]
    nlinarith

/-- **The set generators' cost is polynomial**: at most `300 (m + 1)⁴ (k + 1)`. -/
theorem setGensCost_le (m k : ℕ) : setGensCost m k ≤ 300 * (m + 1) ^ 4 * (k + 1) := by
  have h := partGensCost_le m (k + m)
  simp only [setGensCost, setPartCost]
  nlinarith [Nat.zero_le (m * k), Nat.zero_le (m * m * m * k), Nat.zero_le (m * m * k),
    Nat.zero_le (m * m * m * m), Nat.zero_le (m * m * m), Nat.zero_le (m * m)]

/-- **The set isomorphism search's cost is polynomial**: at most `700 (m + 1)⁵ (k + k' + 1)`. -/
theorem setIsoCost_le (m k k' : ℕ) : setIsoCost m k k' ≤ 700 * (m + 1) ^ 5 * (k + k' + 1) := by
  have h := partIsoCost_le m (k + m) (k' + m)
  simp only [setIsoCost, setPartCost]
  nlinarith [Nat.zero_le (m * k), Nat.zero_le (m * k'), Nat.zero_le (m ^ 4 * k),
    Nat.zero_le (m ^ 4 * k'), Nat.zero_le (m ^ 5), Nat.zero_le (m ^ 4), Nat.zero_le (m ^ 3),
    Nat.zero_le (m ^ 2), Nat.zero_le (m ^ 3 * k), Nat.zero_le (m ^ 3 * k'),
    Nat.zero_le (m ^ 2 * k), Nat.zero_le (m ^ 2 * k'), Nat.zero_le (m ^ 5 * k),
    Nat.zero_le (m ^ 5 * k')]

theorem so_blk_len (m : ℕ) (l : List ℕ) (v : ℕ) :
    ((setPart m l).2.getD v []).length ≤ l.length + m := by
  simp only [setPart, Array.getD_eq_getD_getElem?, List.getElem?_toArray, List.getElem?_map]
  rcases h : (List.range m)[v]? with _ | u
  · simp
  · simp only [Option.map_some, Option.getD_some]
    split_ifs
    · omega
    · have : (complL m l).length ≤ m := (List.length_filter_le _ _).trans (by simp)
      omega

theorem RunsWithin.setGensProg (m : ℕ) (l : List ℕ) {k : ℕ} (hk : l.length ≤ k) :
    RunsWithin X body (Align.setGensProg m l) ((setOps m).gens l) (setGensCost m k) := by
  apply RunsWithin.mono
  case h =>
    run_step (RunsWithin.setPartProg m l hk)
    exact RunsWithin.partGensProg (L := k + m) m _ fun v => (so_blk_len m l v).trans (by omega)
  case hc => simp only [setGensCost]; omega

theorem RunsWithin.setIsoProg (m : ℕ) (l l' : List ℕ) {k k' : ℕ} (hk : l.length ≤ k)
    (hk' : l'.length ≤ k') :
    RunsWithin X body (Align.setIsoProg m l l') ((setOps m).iso l l') (setIsoCost m k k') := by
  apply RunsWithin.mono
  case h =>
    run_step (RunsWithin.setPartProg m l hk)
    run_step (RunsWithin.setPartProg m l' hk')
    exact RunsWithin.partIsoProg (Lx := k + m) (Ly := k' + m) m _ _
      (fun v => (so_blk_len m l v).trans (by omega)) fun v => (so_blk_len m l' v).trans (by omega)
  case hc => simp only [setIsoCost]; omega

end ProgSpecs

section Wf

open Cost Programs

variable {S : Signature} {rec : Ty × Ty} {var₁ var₂ : Ty → Type} {r : Bool}
  {Γ : WfCtx var₁ var₂} {m₁ : var₁ .nat} {m₂ : var₂ .nat} {l₁ l₁' : var₁ (.list .nat)}
  {l₂ l₂' : var₂ (.list .nat)}

theorem wf_setPartProg (hm : ⟨.nat, m₁, m₂⟩ ∈ Γ) (hl : ⟨.list .nat, l₁, l₂⟩ ∈ Γ) :
    Prog.Wf (S := S) (rec := rec) r Γ (setPartProg m₁ l₁) (setPartProg m₂ l₂) := by
  unfold setPartProg setColProg notMemProg setBlkProg Toolkit.filterList SoJProg.memProg
    mapList anyList
  prog_wf

theorem wf_setGensProg (hm : ⟨.nat, m₁, m₂⟩ ∈ Γ) (hl : ⟨.list .nat, l₁, l₂⟩ ∈ Γ) :
    Prog.Wf (S := S) (rec := rec) r Γ (setGensProg m₁ l₁) (setGensProg m₂ l₂) :=
  .bind (wf_setPartProg hm hl) fun _ _ => wf_partGensProg (.tail _ hm) (.head _)

theorem wf_setIsoProg (hm : ⟨.nat, m₁, m₂⟩ ∈ Γ) (hl : ⟨.list .nat, l₁, l₂⟩ ∈ Γ)
    (hl' : ⟨.list .nat, l₁', l₂'⟩ ∈ Γ) :
    Prog.Wf (S := S) (rec := rec) r Γ (setIsoProg m₁ l₁ l₁') (setIsoProg m₂ l₂ l₂') :=
  .bind (wf_setPartProg hm hl) fun _ _ => .bind (wf_setPartProg (.tail _ hm) (.tail _ hl'))
    fun _ _ => wf_partIsoProg (.tail _ (.tail _ hm)) (.tail _ (.head _)) (.head _)

end Wf

/-- **Sets satisfy what Align needs** (for every list; the invariant is not used). -/
theorem setOps_spec (m : ℕ) : (setOps m).Spec (fun l => l.Nodup ∧ ∀ i ∈ l, i < m) where
  gens_valid := fun l _ _ hg => partGens_valid (setPart_valid l) hg
  gens_closure := fun l _ => by
    show genGroup m (partGensD m (setPart m l)) = _
    rw [partGens_closure (setPart_valid l)]
    exact (so_stab_eq l).symm
  iso_some := fun l l' _ _ σ h => by
    obtain ⟨hv, he⟩ := (partOps_spec m).iso_some _ _ ⟨m, setPart_valid l⟩
      ⟨m, setPart_valid l'⟩ σ h
    exact ⟨hv, (so_smul_iff _ l l').2 he⟩
  iso_none := fun l l' _ _ h σ hσ =>
    (partOps_spec m).iso_none _ _ ⟨m, setPart_valid l⟩ ⟨m, setPart_valid l'⟩ h σ
      ((so_smul_iff σ l l').1 hσ)

end GraphIso.Align
