module

public import GraphIso.Align.Interface
public import GraphIso.Toolkit.Reduce
public import GraphIso.Recursion.Align
public import GraphIso.Reductions.SubgroupProg

/-!
# Align, for any kind of structure

Stage 14f, items 4–5 (`PLAN-14.md` §10). A group `G = ⟨gs⟩` of degree `N` keeps the base
positions `[n, N)` invariant; `ψ = baseHom` is its action on the base `Fin (N - n)` and
`P = ψ(G)` contains `Alt`. A kind of structure on the base is given by a `StructOps` with its
`Spec` and by programs computing its stabilizer generators and its isomorphism search.

* **The base action on data** (`baseD`, `denote_baseD`): the restriction of a permutation to
  the base, and `pGroupProg`, which generates `P` at degree `N - n` (`denote_baseGens`).
  Membership in `P` is the backend's `mem`.
* **`Stab(X) ∩ P`** (`stabInPL`, `closure_stabInPL`): the generators flagged outside `P`; if
  there is one, `ρ`, the Schreier generators of index at most `2` (`s, ρ s ρ⁻¹` for `s ∈ P`,
  `s ρ⁻¹, ρ s` otherwise). As `Alt ≤ P`, two elements outside `P` multiply into `P`.
* **Isomorphisms inside `P`** (`isoInPL`, `isoInPL_spec`): an isomorphism `σ` outside `P` is
  corrected by a stabilizer generator outside `P`; if there is none, no element of `P` is an
  isomorphism.
* **Preimages** (`preProg`, `closure_lifts_ker`): `ψ⁻¹(L)` is generated by lifts of
  generators of `L` and by `ker ψ`.
* **Combination** (`al_ansOK_combine`): answers whose cosets together hold exactly the
  solutions combine as in `branchProg`, without a cover.
* **`alignProg`** (`RunsWithin.alignProg`): for every candidate structure `Y` for `y`, an
  isomorphism `π ∈ P` from `X` to `Y`, its lift `τ ∈ G`, and the sub-solver on the coset
  `τ • G₁` with `G₁ = ψ⁻¹(Stab(X) ∩ P)`; the answers are combined as in `branchProg`. If every
  isomorphism of `x` with `y` carries `X` to one of the candidates (`iso_reach`,
  `iso_transporter`), the answer is correct for `G`.
-/

@[expose] public section

namespace GraphIso.Align

open Equiv Cost GraphIso.Programs GraphIso.Toolkit Pointwise

/-! ### The base action on data -/

section BaseData

theorem al_get_range_map (k : ℕ) (f : ℕ → ℕ) {j : ℕ} (hj : j < k) :
    get ((List.range k).map f).toArray j = f j := by
  rw [get_toArray, List.getD_eq_getElem _ _ (by simpa using hj)]
  simp

/-- The base action of a permutation of degree `N` on `[n, N)`, as data of degree `N - n`. -/
def baseD (n N : ℕ) (g : PermData) : PermData :=
  (((List.range (N - n)).map fun j => get g.1 (n + j) - n).toArray,
    ((List.range (N - n)).map fun j => get g.2 (n + j) - n).toArray)

variable {n N : ℕ} {G : Subgroup (Perm (Fin N))}

theorem al_base_fwd (hG : IsInvariant G (baseSet n N)) {g : PermData} (hg : g.Valid N)
    (hgG : PermData.denote N g ∈ G) {j : ℕ} (hj : j < N - n) :
    n ≤ get g.1 (n + j) ∧ get g.1 (n + j) < N := by
  have hmem := hG _ hgG ⟨n + j, by omega⟩ (show n ≤ n + j by omega)
  have hv := PermData.val_denote_apply hg ⟨n + j, by omega⟩
  simp only at hv
  refine ⟨?_, hg.fwd_lt _ (by omega)⟩
  have : n ≤ (PermData.denote N g ⟨n + j, by omega⟩).val := hmem
  omega

theorem al_base_inv (hG : IsInvariant G (baseSet n N)) {g : PermData} (hg : g.Valid N)
    (hgG : PermData.denote N g ∈ G) {j : ℕ} (hj : j < N - n) :
    n ≤ get g.2 (n + j) ∧ get g.2 (n + j) < N := by
  have hmem := hG _ (G.inv_mem hgG) ⟨n + j, by omega⟩ (show n ≤ n + j by omega)
  have hv := PermData.val_denote_inv_apply hg ⟨n + j, by omega⟩
  simp only at hv
  refine ⟨?_, hg.inv_lt _ (by omega)⟩
  have : n ≤ ((PermData.denote N g)⁻¹ ⟨n + j, by omega⟩).val := hmem
  omega

theorem baseD_valid (hG : IsInvariant G (baseSet n N)) {g : PermData} (hg : g.Valid N)
    (hgG : PermData.denote N g ∈ G) : (baseD n N g).Valid (N - n) := by
  refine ⟨by simp [baseD], by simp [baseD], fun i hi => ?_, fun i hi => ?_, fun i hi => ?_,
    fun i hi => ?_⟩
  · rw [baseD, al_get_range_map _ _ hi]
    have := al_base_fwd hG hg hgG hi
    omega
  · rw [baseD, al_get_range_map _ _ hi]
    have := al_base_inv hG hg hgG hi
    omega
  · have h1 := al_base_fwd hG hg hgG hi
    simp only [baseD]
    rw [al_get_range_map _ _ hi, al_get_range_map _ _ (by omega),
      show n + (get g.1 (n + i) - n) = get g.1 (n + i) by omega, hg.inv_fwd _ (by omega)]
    omega
  · have h1 := al_base_inv hG hg hgG hi
    simp only [baseD]
    rw [al_get_range_map _ _ hi, al_get_range_map _ _ (by omega),
      show n + (get g.2 (n + i) - n) = get g.2 (n + i) by omega, hg.fwd_inv _ (by omega)]
    omega

/-- **The base action on data** is `baseHom`. -/
theorem denote_baseD (hG : IsInvariant G (baseSet n N)) {g : PermData} (hg : g.Valid N)
    (hgG : PermData.denote N g ∈ G) :
    PermData.denote (N - n) (baseD n N g) = baseHom G n hG ⟨_, hgG⟩ := by
  ext j
  rw [PermData.val_denote_apply (baseD_valid hG hg hgG), baseD, al_get_range_map _ _ j.2]
  show _ = (PermData.denote N g (basePos j)).val - n
  rw [PermData.val_denote_apply hg]
  rfl

/-- The base actions of the generators generate `P = ψ(G)`. -/
theorem denote_baseGens {gs : GensData}
    (hG : IsInvariant (GensData.denote N gs) (baseSet n N)) (hgs : GensData.AllValid N gs) :
    GensData.denote (N - n) (gs.map (baseD n N)) = (baseHom _ n hG).range := by
  have htop : Subgroup.closure (((↑) : GensData.denote N gs → Perm (Fin N)) ⁻¹'
      GensData.denoteSet N gs) = ⊤ := Subgroup.closure_closure_coe_preimage
  rw [MonoidHom.range_eq_map, ← htop, MonoidHom.map_closure]
  unfold GensData.denote
  congr 1
  ext π
  simp only [GensData.denoteSet, List.mem_map, Set.mem_ofPred_eq, Set.mem_image,
    Set.mem_preimage]
  constructor
  · rintro ⟨_, ⟨g, hg, rfl⟩, rfl⟩
    exact ⟨⟨PermData.denote N g, GensData.mem_denote_of_mem hg⟩, ⟨g, hg, rfl⟩,
      (denote_baseD hG (hgs g hg) _).symm⟩
  · rintro ⟨⟨_, hmem⟩, ⟨g, hg, rfl⟩, rfl⟩
    exact ⟨_, ⟨g, hg, rfl⟩, denote_baseD hG (hgs g hg) _⟩

theorem allValid_baseGens {gs : GensData}
    (hG : IsInvariant (GensData.denote N gs) (baseSet n N)) (hgs : GensData.AllValid N gs) :
    GensData.AllValid (N - n) (gs.map (baseD n N)) := by
  intro g' hg'
  obtain ⟨g, hg, rfl⟩ := List.mem_map.1 hg'
  exact baseD_valid hG (hgs g hg) (GensData.mem_denote_of_mem hg)

end BaseData

/-! ### Index at most two -/

section IndexTwo

variable {M : Type*} [Group M]

/-- Two elements outside `P` multiply into `P` (`P` has index at most `2`). -/
def OutMulIn (P : Subgroup M) : Prop := ∀ x y : M, x ∉ P → y ∉ P → x * y ∈ P

variable {P : Subgroup M}

theorem al_in_mul_out {x y : M} (hx : x ∈ P) (hy : y ∉ P) : x * y ∉ P := fun h =>
  hy (by simpa using P.mul_mem (P.inv_mem hx) h)

theorem al_out_mul_in {x y : M} (hx : x ∉ P) (hy : y ∈ P) : x * y ∉ P := fun h =>
  hx (by simpa using P.mul_mem h (P.inv_mem hy))

theorem al_inv_out {x : M} (hx : x ∉ P) : x⁻¹ ∉ P := fun h => hx (by simpa using P.inv_mem h)

/-- The Schreier generators of `⟨S⟩ ∩ P` for the transversal `{1, ρ}`. -/
def schreierSet (P : Subgroup M) (S : Set M) (ρ : M) : Set M :=
  {t | ∃ s ∈ S, (s ∈ P ∧ (t = s ∨ t = ρ * s * ρ⁻¹)) ∨ (s ∉ P ∧ (t = s * ρ⁻¹ ∨ t = ρ * s))}

/-- **Schreier's lemma for index two.** -/
theorem closure_schreierSet (hP : OutMulIn P) {S : Set M} {ρ : M}
    (hρS : ρ ∈ Subgroup.closure S) (hρ : ρ ∉ P) :
    Subgroup.closure (schreierSet P S ρ) = Subgroup.closure S ⊓ P := by
  set C := Subgroup.closure (schreierSet P S ρ)
  have hρi : ρ⁻¹ ∉ P := al_inv_out hρ
  have mem : ∀ s ∈ S, ∀ t, ((s ∈ P ∧ (t = s ∨ t = ρ * s * ρ⁻¹)) ∨
      (s ∉ P ∧ (t = s * ρ⁻¹ ∨ t = ρ * s))) → t ∈ C :=
    fun s hs t ht => Subgroup.subset_closure ⟨s, hs, ht⟩
  apply le_antisymm
  · rw [Subgroup.closure_le]
    rintro t ⟨s, hs, (⟨hsP, rfl | rfl⟩ | ⟨hsP, rfl | rfl⟩)⟩
    · exact ⟨Subgroup.subset_closure hs, hsP⟩
    · refine ⟨Subgroup.mul_mem _ (Subgroup.mul_mem _ hρS (Subgroup.subset_closure hs))
        (Subgroup.inv_mem _ hρS), hP _ _ (al_out_mul_in hρ hsP) hρi⟩
    · exact ⟨Subgroup.mul_mem _ (Subgroup.subset_closure hs) (Subgroup.inv_mem _ hρS),
        hP _ _ hsP hρi⟩
    · exact ⟨Subgroup.mul_mem _ hρS (Subgroup.subset_closure hs), hP _ _ hρ hsP⟩
  · rintro h ⟨hS, hhP⟩
    -- the strengthened invariant, by induction on the closure
    have key : ∀ h ∈ Subgroup.closure S,
        (h ∈ P → h ∈ C ∧ ρ * h * ρ⁻¹ ∈ C) ∧ (h ∉ P → h * ρ⁻¹ ∈ C ∧ ρ * h ∈ C) := by
      intro h hh
      induction hh using Subgroup.closure_induction with
      | mem s hs =>
        refine ⟨fun hsP => ⟨mem s hs _ (Or.inl ⟨hsP, Or.inl rfl⟩),
          mem s hs _ (Or.inl ⟨hsP, Or.inr rfl⟩)⟩, fun hsP => ⟨mem s hs _ (Or.inr ⟨hsP, Or.inl rfl⟩),
          mem s hs _ (Or.inr ⟨hsP, Or.inr rfl⟩)⟩⟩
      | one =>
        refine ⟨fun _ => ⟨C.one_mem, by simp [C.one_mem]⟩, fun h1 => absurd P.one_mem h1⟩
      | mul x y _ _ ihx ihy =>
        by_cases hx : x ∈ P <;> by_cases hy : y ∈ P
        · have hxy : x * y ∈ P := P.mul_mem hx hy
          refine ⟨fun _ => ⟨C.mul_mem (ihx.1 hx).1 (ihy.1 hy).1, ?_⟩, fun h => absurd hxy h⟩
          have e : ρ * (x * y) * ρ⁻¹ = (ρ * x * ρ⁻¹) * (ρ * y * ρ⁻¹) := by group
          rw [e]
          exact C.mul_mem (ihx.1 hx).2 (ihy.1 hy).2
        · have hxy : x * y ∉ P := al_in_mul_out hx hy
          refine ⟨fun h => absurd h hxy, fun _ => ⟨?_, ?_⟩⟩
          · rw [mul_assoc]
            exact C.mul_mem (ihx.1 hx).1 (ihy.2 hy).1
          · have e : ρ * (x * y) = (ρ * x * ρ⁻¹) * (ρ * y) := by group
            rw [e]
            exact C.mul_mem (ihx.1 hx).2 (ihy.2 hy).2
        · have hxy : x * y ∉ P := al_out_mul_in hx hy
          refine ⟨fun h => absurd h hxy, fun _ => ⟨?_, ?_⟩⟩
          · have e : x * y * ρ⁻¹ = (x * ρ⁻¹) * (ρ * y * ρ⁻¹) := by group
            rw [e]
            exact C.mul_mem (ihx.2 hx).1 (ihy.1 hy).2
          · rw [← mul_assoc]
            exact C.mul_mem (ihx.2 hx).2 (ihy.1 hy).1
        · have hxy : x * y ∈ P := hP x y hx hy
          refine ⟨fun _ => ⟨?_, ?_⟩, fun h => absurd hxy h⟩
          · have e : x * y = (x * ρ⁻¹) * (ρ * y) := by group
            rw [e]
            exact C.mul_mem (ihx.2 hx).1 (ihy.2 hy).2
          · have e : ρ * (x * y) * ρ⁻¹ = (ρ * x) * (y * ρ⁻¹) := by group
            rw [e]
            exact C.mul_mem (ihx.2 hx).2 (ihy.2 hy).1
      | inv x _ ihx =>
        by_cases hx : x ∈ P
        · refine ⟨fun _ => ⟨C.inv_mem (ihx.1 hx).1, ?_⟩, fun h => absurd (P.inv_mem hx) h⟩
          have e : ρ * x⁻¹ * ρ⁻¹ = (ρ * x * ρ⁻¹)⁻¹ := by group
          rw [e]
          exact C.inv_mem (ihx.1 hx).2
        · have hxi : x⁻¹ ∉ P := al_inv_out hx
          refine ⟨fun h => absurd h hxi, fun _ => ⟨?_, ?_⟩⟩
          · have e : x⁻¹ * ρ⁻¹ = (ρ * x)⁻¹ := by group
            rw [e]
            exact C.inv_mem (ihx.2 hx).2
          · have e : ρ * x⁻¹ = (x * ρ⁻¹)⁻¹ := by group
            rw [e]
            exact C.inv_mem (ihx.2 hx).1
    exact ((key h hS).1 hhP).1

theorem inf_eq_of_le {S : Set M} (h : S ⊆ P) : Subgroup.closure S ⊓ P = Subgroup.closure S :=
  inf_eq_left.2 ((Subgroup.closure_le P).2 h)

end IndexTwo

/-- A subgroup of `Sym(Fin m)` containing `Alt` has index at most two. -/
theorem outMulIn_of_alt_le {m : ℕ} {P : Subgroup (Perm (Fin m))}
    (h : alternatingGroup (Fin m) ≤ P) : OutMulIn P := by
  intro x y hx hy
  have hsx : Perm.sign x = -1 := by
    rcases Int.units_eq_one_or (Perm.sign x) with e | e
    · exact absurd (h (Equiv.Perm.mem_alternatingGroup.2 e)) hx
    · exact e
  have hsy : Perm.sign y = -1 := by
    rcases Int.units_eq_one_or (Perm.sign y) with e | e
    · exact absurd (h (Equiv.Perm.mem_alternatingGroup.2 e)) hy
    · exact e
  apply h
  rw [Equiv.Perm.mem_alternatingGroup, Perm.sign_mul, hsx, hsy]
  rfl

/-! ### `Stab(X) ∩ P` and isomorphisms inside `P`, on data -/

section InP

/-- The first generator flagged outside `P`. -/
def outOf (gfs : List (PermData × Bool)) : Option PermData :=
  (gfs.find? fun p => !p.2).map Prod.fst

/-- The Schreier generators of one flagged generator, for the generator `ρ` outside `P`. -/
def schreierPair (ρ : PermData) (p : PermData × Bool) : List PermData :=
  if p.2 then [p.1, (ρ.mul p.1).mul ρ.inv] else [p.1.mul ρ.inv, ρ.mul p.1]

/-- **Generators of `Stab(X) ∩ P`**, from flagged generators of `Stab(X)`. -/
def stabInPL (gfs : List (PermData × Bool)) : List PermData :=
  match outOf gfs with
  | none => gfs.map Prod.fst
  | some ρ => gfs.flatMap (schreierPair ρ)

/-- **An isomorphism inside `P`**, from an isomorphism `σ` flagged `bσ`. -/
def isoInPL (gfs : List (PermData × Bool)) (σ : PermData) (bσ : Bool) : Option PermData :=
  if bσ then some σ else (outOf gfs).map fun ρ => σ.mul ρ

variable {m : ℕ} {P : Subgroup (Perm (Fin m))}

/-- The flags record membership in `P`. -/
def FlagsOK (m : ℕ) (P : Subgroup (Perm (Fin m))) (gfs : List (PermData × Bool)) : Prop :=
  ∀ p ∈ gfs, p.1.Valid m ∧ (p.2 = true ↔ PermData.denote m p.1 ∈ P)

/-- The denoted set of a list of permutations. -/
def denSet (m : ℕ) (l : List PermData) : Set (Perm (Fin m)) :=
  {σ | ∃ g ∈ l, PermData.denote m g = σ}

theorem outOf_none {gfs : List (PermData × Bool)} (h : outOf gfs = none) :
    ∀ p ∈ gfs, p.2 = true := by
  intro p hp
  unfold outOf at h
  rw [Option.map_eq_none_iff, List.find?_eq_none] at h
  simpa using h p hp

theorem outOf_some {gfs : List (PermData × Bool)} {ρ : PermData} (h : outOf gfs = some ρ) :
    ∃ p ∈ gfs, p.1 = ρ ∧ p.2 = false := by
  unfold outOf at h
  obtain ⟨p, hp, rfl⟩ := Option.map_eq_some_iff.1 h
  exact ⟨p, List.mem_of_find?_eq_some hp, rfl, by simpa using List.find?_some hp⟩

theorem stabInPL_valid {gfs : List (PermData × Bool)} (hf : FlagsOK m P gfs) :
    ∀ g ∈ stabInPL gfs, g.Valid m := by
  intro g hg
  unfold stabInPL at hg
  rcases ho : outOf gfs with _ | ρ
  · rw [ho] at hg
    obtain ⟨p, hp, rfl⟩ := List.mem_map.1 hg
    exact (hf p hp).1
  · rw [ho] at hg
    obtain ⟨q, hq, hρq, -⟩ := outOf_some ho
    have hρ : ρ.Valid m := hρq ▸ (hf q hq).1
    obtain ⟨p, hp, hg⟩ := List.mem_flatMap.1 hg
    have hpv := (hf p hp).1
    unfold schreierPair at hg
    split_ifs at hg <;> simp only [List.mem_cons, List.not_mem_nil, or_false] at hg <;>
      rcases hg with rfl | rfl
    · exact hpv
    · exact (hρ.mul hpv).mul hρ.inv
    · exact hpv.mul hρ.inv
    · exact hρ.mul hpv

/-- **`stabInPL` generates `⟨gens⟩ ∩ P`.** -/
theorem closure_stabInPL (hP : OutMulIn P) {gfs : List (PermData × Bool)}
    (hf : FlagsOK m P gfs) :
    Subgroup.closure (denSet m (stabInPL gfs)) =
      Subgroup.closure (denSet m (gfs.map Prod.fst)) ⊓ P := by
  unfold stabInPL
  rcases ho : outOf gfs with _ | ρ
  · refine (inf_eq_of_le ?_).symm
    rintro _ ⟨g, hg, rfl⟩
    obtain ⟨p, hp, rfl⟩ := List.mem_map.1 hg
    exact ((hf p hp).2).1 (outOf_none ho p hp)
  · obtain ⟨q, hq, hρq, hq2⟩ := outOf_some ho
    have hρ : ρ.Valid m := hρq ▸ (hf q hq).1
    have hρP : PermData.denote m ρ ∉ P := by
      rw [← hρq]
      intro h
      have := ((hf q hq).2).2 h
      rw [hq2] at this
      exact Bool.false_ne_true this
    have hρS : PermData.denote m ρ ∈ Subgroup.closure (denSet m (gfs.map Prod.fst)) :=
      Subgroup.subset_closure ⟨ρ, List.mem_map.2 ⟨q, hq, hρq⟩, rfl⟩
    rw [← closure_schreierSet hP hρS hρP]
    congr 1
    ext t
    constructor
    · rintro ⟨g, hg, rfl⟩
      obtain ⟨⟨g₀, b⟩, hp, hg⟩ := List.mem_flatMap.1 hg
      have hpv := (hf _ hp).1
      have hs : PermData.denote m g₀ ∈ denSet m (gfs.map Prod.fst) :=
        ⟨g₀, List.mem_map.2 ⟨_, hp, rfl⟩, rfl⟩
      cases b with
      | true =>
        have hpP := ((hf _ hp).2).1 rfl
        simp only [schreierPair, ite_true, List.mem_cons, List.not_mem_nil, or_false] at hg
        rcases hg with rfl | rfl
        · exact ⟨_, hs, Or.inl ⟨hpP, Or.inl rfl⟩⟩
        · refine ⟨_, hs, Or.inl ⟨hpP, Or.inr ?_⟩⟩
          rw [PermData.denote_mul (hρ.mul hpv) hρ.inv, PermData.denote_mul hρ hpv,
            PermData.denote_inv hρ]
      | false =>
        have hpP : PermData.denote m g₀ ∉ P := fun h => Bool.false_ne_true (((hf _ hp).2).2 h)
        simp only [schreierPair, Bool.false_eq_true, ite_false, List.mem_cons, List.not_mem_nil,
          or_false] at hg
        rcases hg with rfl | rfl
        · refine ⟨_, hs, Or.inr ⟨hpP, Or.inl ?_⟩⟩
          rw [PermData.denote_mul hpv hρ.inv, PermData.denote_inv hρ]
        · refine ⟨_, hs, Or.inr ⟨hpP, Or.inr ?_⟩⟩
          rw [PermData.denote_mul hρ hpv]
    · rintro ⟨s, ⟨g, hg, rfl⟩, ht⟩
      obtain ⟨⟨g₀, b⟩, hp, rfl⟩ := List.mem_map.1 hg
      have hpv := (hf _ hp).1
      have hflag : b = true ↔ PermData.denote m g₀ ∈ P := (hf _ hp).2
      rcases ht with ⟨hpP, rfl | rfl⟩ | ⟨hpP, rfl | rfl⟩
      · have hb : b = true := hflag.2 hpP
        subst hb
        exact ⟨g₀, List.mem_flatMap.2 ⟨_, hp, by simp [schreierPair]⟩, rfl⟩
      · have hb : b = true := hflag.2 hpP
        subst hb
        refine ⟨(ρ.mul g₀).mul ρ.inv, List.mem_flatMap.2 ⟨_, hp, by simp [schreierPair]⟩, ?_⟩
        rw [PermData.denote_mul (hρ.mul hpv) hρ.inv, PermData.denote_mul hρ hpv,
          PermData.denote_inv hρ]
      · have hb : b = false := by
          cases b
          · rfl
          · exact absurd (hflag.1 rfl) hpP
        subst hb
        refine ⟨g₀.mul ρ.inv, List.mem_flatMap.2 ⟨_, hp, by simp [schreierPair]⟩, ?_⟩
        rw [PermData.denote_mul hpv hρ.inv, PermData.denote_inv hρ]
      · have hb : b = false := by
          cases b
          · rfl
          · exact absurd (hflag.1 rfl) hpP
        subst hb
        refine ⟨ρ.mul g₀, List.mem_flatMap.2 ⟨_, hp, by simp [schreierPair]⟩, ?_⟩
        rw [PermData.denote_mul hρ hpv]

/-- **Isomorphisms inside `P`.** -/
theorem isoInPL_spec {O : Type*} [MulAction (Perm (Fin m)) O] (hP : OutMulIn P)
    {gfs : List (PermData × Bool)} (hf : FlagsOK m P gfs) {x y : O}
    (hstab : Subgroup.closure (denSet m (gfs.map Prod.fst)) =
      MulAction.stabilizer (Perm (Fin m)) x)
    {σ : PermData} (hσ : σ.Valid m) (hσxy : PermData.denote m σ • x = y) {b : Bool}
    (hb : b = true ↔ PermData.denote m σ ∈ P) :
    (∀ π, isoInPL gfs σ b = some π →
      π.Valid m ∧ PermData.denote m π ∈ P ∧ PermData.denote m π • x = y) ∧
    (isoInPL gfs σ b = none → ∀ π ∈ P, π • x ≠ y) := by
  cases b with
  | true =>
    refine ⟨fun π h => ?_, fun h => by simp [isoInPL] at h⟩
    simp only [isoInPL, ite_true, Option.some.injEq] at h
    subst h
    exact ⟨hσ, hb.1 rfl, hσxy⟩
  | false =>
    have hσP : PermData.denote m σ ∉ P := fun h => Bool.false_ne_true (hb.2 h)
    simp only [isoInPL, Bool.false_eq_true, ite_false]
    rcases ho : outOf gfs with _ | ρ
    · refine ⟨fun π h => by simp at h, fun _ π hπ hπxy => ?_⟩
      -- every generator lies in `P`, so the stabilizer does
      have hle : MulAction.stabilizer (Perm (Fin m)) x ≤ P := by
        rw [← hstab, Subgroup.closure_le]
        rintro _ ⟨g, hg, rfl⟩
        obtain ⟨p, hp, rfl⟩ := List.mem_map.1 hg
        exact ((hf p hp).2).1 (outOf_none ho p hp)
      have hst : (PermData.denote m σ)⁻¹ * π ∈ MulAction.stabilizer (Perm (Fin m)) x := by
        rw [MulAction.mem_stabilizer_iff, mul_smul, hπxy, ← hσxy, inv_smul_smul]
      have := P.mul_mem hπ (P.inv_mem (hle hst))
      rw [mul_inv_rev, inv_inv, mul_inv_cancel_left] at this
      exact hσP this
    · obtain ⟨q, hq, hρq, hq2⟩ := outOf_some ho
      have hρ : ρ.Valid m := hρq ▸ (hf q hq).1
      have hρP : PermData.denote m ρ ∉ P := by
        rw [← hρq]
        intro h
        have := ((hf q hq).2).2 h
        rw [hq2] at this
        exact Bool.false_ne_true this
      have hρst : PermData.denote m ρ ∈ MulAction.stabilizer (Perm (Fin m)) x := by
        rw [← hstab]
        exact Subgroup.subset_closure ⟨ρ, List.mem_map.2 ⟨q, hq, hρq⟩, rfl⟩
      refine ⟨fun π h => ?_, fun h => by simp at h⟩
      simp only [Option.map_some, Option.some.injEq] at h
      subst h
      refine ⟨hσ.mul hρ, ?_, ?_⟩
      · rw [PermData.denote_mul hσ hρ]
        exact hP _ _ hσP hρP
      · rw [PermData.denote_mul hσ hρ, mul_smul, MulAction.mem_stabilizer_iff.1 hρst, hσxy]

end InP

/-! ### Preimages -/

section Preimage

variable {Ω Γ : Type*} {G : Subgroup (Perm Ω)} (ψ : G →* Perm Γ)

/-- **Preimages are generated by lifts and the kernel.** If every generator `l` of `L` has a
lift `f l ∈ G`, then `ψ⁻¹(L)` is generated by the lifts and the kernel. -/
theorem closure_lifts_ker {Ls : Set (Perm Γ)} {A : Set (Perm Ω)}
    (hA : ∀ a ∈ A, ∃ h : a ∈ G, ψ ⟨a, h⟩ ∈ Ls) (hL : ∀ l ∈ Ls, ∃ a ∈ A, ∃ h : a ∈ G,
      ψ ⟨a, h⟩ = l) (K : Set (Perm Ω))
    (hK : Subgroup.closure K = ψ.ker.map G.subtype) :
    Subgroup.closure (A ∪ K) = ((Subgroup.closure Ls).comap ψ).map G.subtype := by
  apply le_antisymm
  · rw [Subgroup.closure_le]
    rintro a (ha | ha)
    · obtain ⟨h, hl⟩ := hA a ha
      exact ⟨⟨a, h⟩, Subgroup.subset_closure hl, rfl⟩
    · have : a ∈ ψ.ker.map G.subtype := hK ▸ Subgroup.subset_closure ha
      obtain ⟨g, hg, rfl⟩ := this
      refine ⟨g, ?_, rfl⟩
      show ψ g ∈ Subgroup.closure Ls
      rw [MonoidHom.mem_ker.1 hg]
      exact Subgroup.one_mem _
  · rintro _ ⟨g, hg, rfl⟩
    replace hg : ψ g ∈ Subgroup.closure Ls := hg
    -- the lifts generate a subgroup of `G` whose image contains `L`
    set C := (Subgroup.closure A).comap G.subtype
    have hAG : Subgroup.closure A ≤ G := by
      rw [Subgroup.closure_le]
      intro a ha
      exact (hA a ha).1
    have himg : Subgroup.closure Ls ≤ C.map ψ := by
      rw [Subgroup.closure_le]
      intro l hl
      obtain ⟨a, ha, h, rfl⟩ := hL l hl
      exact ⟨⟨a, h⟩, Subgroup.subset_closure ha, rfl⟩
    obtain ⟨c, hc, hcg⟩ := himg hg
    have hker : c⁻¹ * g ∈ ψ.ker := by
      rw [MonoidHom.mem_ker, map_mul, map_inv, hcg, inv_mul_cancel]
    have h1 : (c : Perm Ω) ∈ Subgroup.closure (A ∪ K) :=
      Subgroup.closure_mono Set.subset_union_left hc
    have h2 : ((c⁻¹ * g : G) : Perm Ω) ∈ Subgroup.closure (A ∪ K) := by
      refine Subgroup.closure_mono Set.subset_union_right ?_
      rw [hK]
      exact ⟨_, hker, rfl⟩
    have := Subgroup.mul_mem _ h1 h2
    simpa using this

end Preimage

/-! ### Combining answers whose cosets contain every solution -/

section Combine

/-- **Combination without a cover**: if the solutions are exactly the union of the answers,
the combined answer is correct. -/
theorem al_isCorrect_combine {Ω α : Type*} {W : Set Ω} {σ : Perm Ω} {G : Subgroup (Perm Ω)}
    {x y : Ω → α} (hW : IsInvariant G W) {as : List (Answer Ω)}
    (hcover : iso W σ G x y = ⋃ a ∈ as, Answer.denote a) :
    Answer.IsCorrect (GraphIso.combineBranches as) W σ G x y := by
  rw [denote_eq_iUnion_successes] at hcover
  unfold GraphIso.combineBranches Answer.IsCorrect
  rcases hs : successes as with _ | ⟨⟨τ₀, H₀⟩, ss⟩
  · rw [hs] at hcover
    simpa using hcover.symm
  · rw [hs] at hcover
    simp only [Answer.denote_some]
    set L := (τ₀, H₀) :: ss with hL
    have hS : iso W σ G x y = ⋃ i : Fin L.length, (L.get i).1 • ((L.get i).2 : Set (Perm Ω)) := by
      rw [hcover]
      ext g
      simp only [Set.mem_iUnion]
      constructor
      · rintro ⟨p, hp, hg⟩
        obtain ⟨i, rfl⟩ := List.get_of_mem hp
        exact ⟨i, hg⟩
      · rintro ⟨i, hg⟩
        exact ⟨_, List.get_mem _ _, hg⟩
    have h0 : (L.get ⟨0, by simp [hL]⟩).1 = τ₀ := rfl
    rw [iso_eq_smul_closure_of_iso_eq_iUnion hW hS ⟨0, by simp [hL]⟩, h0]
    congr 2
    unfold branchSubgroup
    congr 1
    ext g
    simp only [Set.mem_union, Set.mem_iUnion, Set.mem_range, Set.mem_ofPred_eq, SetLike.mem_coe,
      exists_prop]
    constructor
    · rintro (⟨p, hp, hg⟩ | ⟨p, hp, rfl⟩)
      · obtain ⟨i, rfl⟩ := List.get_of_mem hp
        exact Or.inl ⟨i, hg⟩
      · obtain ⟨i, rfl⟩ := List.get_of_mem hp
        exact Or.inr ⟨i, rfl⟩
    · rintro (⟨i, hg⟩ | ⟨i, rfl⟩)
      · exact Or.inl ⟨_, List.get_mem _ _, hg⟩
      · exact Or.inr ⟨_, List.get_mem _ _, rfl⟩

variable {D : Ty}

/-- **Represented combination without a cover.** -/
theorem al_ansOK_combine {DV : ℕ → GensData → D.denote → Prop} {O : Oracle (groupSig D)}
    (hO : MeetsContractOn DV (· = .generate) O) {n : ℕ} {W : Set (Fin n)} {σ : Perm (Fin n)}
    {G : Subgroup (Perm (Fin n))} {x y : Fin n → ℕ} (hW : IsInvariant G W)
    {as : List (AnswerData D)}
    (hval : ∀ c ∈ branchSuccesses as, c.1.Valid n ∧ GensData.AllValid n c.2.gens)
    (hS : iso W σ G x y = ⋃ a ∈ as.map (AnswerData.denote n), Answer.denote a) :
    AnsOK DV n W σ G x y (GraphIso.combineModel O n as) := by
  have hcomb := al_isCorrect_combine hW hS
  unfold Answer.IsCorrect GraphIso.combineBranches at hcomb
  rw [successes_map_denote] at hcomb
  unfold GraphIso.combineModel
  rcases hss : branchSuccesses as with _ | ⟨c₀, rest⟩
  · rw [hss] at hcomb
    exact hcomb.symm
  · rw [hss] at hcomb hval
    simp only [List.map_cons, Answer.denote_some] at hcomb
    have hv : ∀ p ∈ (c₀.1, c₀.2.gens) :: rest.map (fun c => (c.1, c.2.gens)),
        p.1.Valid n ∧ GensData.AllValid n p.2 := by
      intro p hp
      rcases List.mem_cons.1 hp with rfl | hp
      · exact hval c₀ List.mem_cons_self
      · obtain ⟨c, hc, rfl⟩ := List.mem_map.1 hp
        exact hval c (List.mem_cons_of_mem _ hc)
    have hgv : GensData.AllValid n (combineGens c₀.1 (c₀ :: rest)) :=
      allValid_branchGens (hval c₀ List.mem_cons_self).1.inv fun p hp => by
        simpa using hv p (by simpa using hp)
    have hpost := hO .generate (n, combineGens c₀.1 (c₀ :: rest)) rfl hgv
    dsimp only
    rcases hH : O.run GroupOp.generate (n, combineGens c₀.1 (c₀ :: rest)) with ⟨n', hs, e⟩
    rw [hH] at hpost
    obtain ⟨rfl, hGv, hden⟩ := hpost
    refine ⟨(hval c₀ List.mem_cons_self).1, rfl, hGv, ?_⟩
    change PermData.denote n' c₀.1 • (GensData.denote n' hs : Set (Perm (Fin n'))) = _
    rw [hden, ← hcomb, combineGens, List.map_cons,
      denote_branchGens (hval c₀ List.mem_cons_self).1 hv]
    simp [Function.comp_def]

end Combine

/-! ### Programs -/

section Programs

variable {D : Ty} {S : Signature} {rec : Ty × Ty} {var : Ty → Type}

/-- One entry of the base action: `a[n + j] - n`. -/
def alBaseEntry (n : var .nat) (a : var (.array .nat)) (j : var .nat) : Prog S rec var .nat :=
  .bind (.op2 .add n j) fun p => .bind (.op2 .arrayGet a p) fun v => .op2 .sub v n

/-- The base action of a permutation (`baseD`). -/
def baseDProg (n N : var .nat) (g : var Ty.perm) : Prog S rec var Ty.perm :=
  .bind (.op2 .sub N n) fun m => .bind (.op1 .range m) fun js =>
  .bind (.op1 .fst g) fun gf => .bind (.op1 .snd g) fun gb =>
  .bind (mapList js fun j => alBaseEntry n gf j) fun fl =>
  .bind (mapList js fun j => alBaseEntry n gb j) fun bl =>
  .bind (.op1 .arrayOfList fl) fun fa => .bind (.op1 .arrayOfList bl) fun ba => .op2 .pair fa ba

/-- `P = ψ(G)` as a group of degree `N - n`. -/
def pGroupProg (n : var .nat) (G : var (Ty.group D)) : Prog (groupSig D) rec var (Ty.group D) :=
  .bind (.op1 .fst G) fun N => .bind (.op2 .sub N n) fun m =>
  .bind (.op1 .snd G) fun gd => .bind (.op1 .fst gd) fun gs =>
  .bind (mapList gs fun g => baseDProg n N g) fun bgs =>
  .bind (.op2 .pair m bgs) fun a => Prog.call (S := groupSig D) GroupOp.generate a

/-- A permutation with its membership in `P`. -/
def flagProg (P : var (Ty.group D)) (g : var Ty.perm) :
    Prog (groupSig D) rec var (.prod Ty.perm .bool) :=
  .bind (.op2 .pair P g) fun a => .bind (Prog.call (S := groupSig D) GroupOp.mem a) fun b =>
  .op2 .pair g b

/-- Every generator with its membership in `P`. -/
def flagsProg (P : var (Ty.group D)) (gs : var Ty.gens) :
    Prog (groupSig D) rec var (.list (.prod Ty.perm .bool)) :=
  mapList gs fun g => flagProg P g

/-- One step of the search for a generator outside `P`. -/
def outStep (acc : var (.option Ty.perm)) (p : var (.prod Ty.perm .bool)) :
    Prog S rec var (.option Ty.perm) :=
  .caseOption acc
    (.bind (.op1 .snd p) fun b => .ite b (.op0 .none) (.bind (.op1 .fst p) fun g => .op1 .some g))
    fun r => .op1 .some r

/-- The first generator flagged outside `P` (`outOf`). -/
def outOfProg (gfs : var (.list (.prod Ty.perm .bool))) : Prog S rec var (.option Ty.perm) :=
  .bind (.op0 .none) fun init => .foldList gfs init fun acc p => outStep acc p

/-- The Schreier generators of one flagged generator (`schreierPair`). -/
def schreierPairProg (ρ : var Ty.perm) (p : var (.prod Ty.perm .bool)) :
    Prog S rec var Ty.gens :=
  .bind (.op1 .fst p) fun g => .bind (.op1 .snd p) fun b => .bind (permInv ρ) fun ρi =>
  .bind (.op0 .nil) fun nil =>
  .ite b
    (.bind (permMul ρ g) fun ρg => .bind (permMul ρg ρi) fun c =>
      .bind (.op2 .cons c nil) fun l => .op2 .cons g l)
    (.bind (permMul g ρi) fun gρ => .bind (permMul ρ g) fun ρg =>
      .bind (.op2 .cons ρg nil) fun l => .op2 .cons gρ l)

/-- Concatenate a list of lists. -/
def flattenProg {a' : Ty} (rows : var (.list (.list a'))) : Prog S rec var (.list a') :=
  .bind (.op1 .reverse rows) fun rr => .bind (.op0 .nil) fun nil =>
  .foldList rr nil fun acc row => .op2 .append row acc

/-- **Generators of `Stab(X) ∩ P`** (`stabInPL`). -/
def stabInPProg (gfs : var (.list (.prod Ty.perm .bool))) : Prog S rec var Ty.gens :=
  .bind (outOfProg gfs) fun oρ =>
  .caseOption oρ (mapList gfs fun p => .op1 .fst p) fun ρ =>
    .bind (mapList gfs fun p => schreierPairProg ρ p) fun rows => flattenProg rows

/-- **An isomorphism inside `P`** (`isoInPL`). -/
def isoInPProg (gfs : var (.list (.prod Ty.perm .bool))) (σ : var Ty.perm) (b : var .bool) :
    Prog S rec var (.option Ty.perm) :=
  .ite b (.op1 .some σ)
    (.bind (outOfProg gfs) fun oρ =>
      .caseOption oρ (.op0 .none) fun ρ => .bind (permMul σ ρ) fun c => .op1 .some c)

/-- **The preimage** `ψ⁻¹(⟨Ls⟩)`: lifts of `Ls` and the kernel, generated. -/
def preProg (n : var .nat) (G : var (Ty.group D)) (Ls : var Ty.gens) :
    Prog (groupSig D) rec var (Ty.group D) :=
  .bind (.op1 .fst G) fun N =>
  .bind (baseWinProg n N) fun bw =>
  .bind (.op2 .pair G bw) fun a₁ =>
  .bind (Prog.call (S := groupSig D) GroupOp.kernel a₁) fun K =>
  .bind (mapList Ls fun π => liftProg n G π) fun lifts =>
  .bind (.op1 .snd K) fun kd => .bind (.op1 .fst kd) fun kgs =>
  .bind (.op2 .append lifts kgs) fun all =>
  .bind (.op2 .pair N all) fun a₂ =>
  Prog.call (S := groupSig D) GroupOp.generate a₂

variable {τ : Ty}

/-- One candidate `Y` for `y`: an isomorphism `π ∈ P` from `X` to `Y`, its lift `t ∈ G`, and
the sub-solver on the coset `t • G₁`. -/
def alignCall (sub : var (Ty.inst D) → Prog (groupSig D) rec var (Ty.answer D))
    (isoP : var τ → var τ → Prog (groupSig D) rec var (.option Ty.perm))
    (n : var .nat) (xy : var Ty.strs) (w : var Ty.win) (G P G₁ : var (Ty.group D))
    (gfs : var (.list (.prod Ty.perm .bool))) (X Y : var τ) :
    Prog (groupSig D) rec var (Ty.answer D) :=
  .bind (isoP X Y) fun oσ =>
  .caseOption oσ (.op0 .none) fun σ =>
  .bind (.op2 .pair P σ) fun a => .bind (Prog.call (S := groupSig D) GroupOp.mem a) fun bσ =>
  .bind (isoInPProg gfs σ bσ) fun oπ =>
  .caseOption oπ (.op0 .none) fun π =>
  .bind (liftProg n G π) fun t =>
  .bind (.op2 .pair t G₁) fun c => .bind (.op2 .pair w c) fun wc =>
  .bind (.op2 .pair xy wc) fun I => sub I

/-- **Align**: `X` the structure for `x`, `Ys` the candidate structures for `y`. -/
def alignProg (sub : var (Ty.inst D) → Prog (groupSig D) rec var (Ty.answer D))
    (gensP : var τ → Prog (groupSig D) rec var Ty.gens)
    (isoP : var τ → var τ → Prog (groupSig D) rec var (.option Ty.perm))
    (n : var .nat) (xy : var Ty.strs) (w : var Ty.win) (G : var (Ty.group D)) (X : var τ)
    (Ys : var (.list τ)) : Prog (groupSig D) rec var (Ty.answer D) :=
  .bind (.op1 .fst G) fun N =>
  .bind (pGroupProg n G) fun P =>
  .bind (gensP X) fun gX =>
  .bind (flagsProg P gX) fun gfs =>
  .bind (stabInPProg gfs) fun Ls =>
  .bind (preProg n G Ls) fun G₁ =>
  .bind (mapList Ys fun Y => alignCall sub isoP n xy w G P G₁ gfs X Y) fun as =>
  combineProg N as

end Programs

/-! ### Specifications of the local programs -/

section LocalSpecs

variable {S : Signature} {a b : Ty} {X : Ctx S} {body : a.denote → Prog S (a, b) Ty.denote b}

theorem RunsWithin.alBaseEntry (n : ℕ) (arr : Array ℕ) (j : ℕ) :
    RunsWithin X body (Align.alBaseEntry n arr j) (get arr (n + j) - n) 3 := by
  apply RunsWithin.mono
  case h =>
    run_step (RunsWithin.prim _ _)
    run_step (RunsWithin.prim _ _)
    exact RunsWithin.prim _ _
  case hc => simp [Prim.cost]

/-- The cost of `baseDProg` for a base of `m` points. -/
def baseDCost (m : ℕ) : ℕ := 16 * m + 12

theorem RunsWithin.baseDProg (n N : ℕ) (g : PermData) :
    RunsWithin X body (Align.baseDProg n N g) (baseD n N g) (baseDCost (N - n)) := by
  have hf := RunsWithin.mapList_le (X := X) (body := body) (a' := .nat) (b' := .nat)
    (xs := List.range (N - n)) (c := 3) (F := fun j => get g.1 (n + j) - n)
    (f := fun j => Align.alBaseEntry n g.1 j) fun j _ => RunsWithin.alBaseEntry n g.1 j
  have hb := RunsWithin.mapList_le (X := X) (body := body) (a' := .nat) (b' := .nat)
    (xs := List.range (N - n)) (c := 3) (F := fun j => get g.2 (n + j) - n)
    (f := fun j => Align.alBaseEntry n g.2 j) fun j _ => RunsWithin.alBaseEntry n g.2 j
  apply RunsWithin.mono
  case h =>
    run_step (RunsWithin.prim _ _)
    run_step (RunsWithin.prim _ _)
    run_step (RunsWithin.prim _ _)
    run_step (RunsWithin.prim _ _)
    run_step hf
    run_step hb
    run_step (RunsWithin.prim _ _)
    run_step (RunsWithin.prim _ _)
    exact RunsWithin.prim_le rfl le_rfl
  case hc =>
    simp only [Prim.cost, Prim.eval, Args.head_cons, List.length_range, List.length_map,
      baseDCost]
    omega

/-- One step of the search, on data. -/
def outStepD (acc : Option PermData) (p : PermData × Bool) : Option PermData :=
  match acc with
  | none => if p.2 then none else some p.1
  | some r => some r

theorem al_foldl_outStepD_some (r : PermData) :
    ∀ l : List (PermData × Bool), l.foldl outStepD (some r) = some r
  | [] => rfl
  | _ :: l => al_foldl_outStepD_some r l

theorem al_foldl_outStepD : ∀ l : List (PermData × Bool), l.foldl outStepD none = outOf l
  | [] => rfl
  | p :: l => by
    rcases p with ⟨g, _ | _⟩
    · simp only [List.foldl_cons, outStepD, Bool.false_eq_true, ite_false]
      rw [al_foldl_outStepD_some]
      simp [outOf]
    · simp only [List.foldl_cons, outStepD, ite_true]
      rw [al_foldl_outStepD l]
      simp [outOf]

theorem RunsWithin.outStep (acc : Option PermData) (p : PermData × Bool) :
    RunsWithin X body (Align.outStep acc p) (outStepD acc p) 5 := by
  rcases acc with _ | r
  · refine RunsWithin.mono (RunsWithin.caseOption_none (k := 4) ?_) (by omega)
    refine RunsWithin.bind_le (c₂ := 3) (RunsWithin.prim _ _) ?_ (by simp [Prim.cost])
    rcases p with ⟨g, _ | _⟩
    · refine (RunsWithin.ite_false (k := 2) ?_).mono (by omega)
      refine RunsWithin.bind_le (c₂ := 1) (RunsWithin.prim _ _) ?_ (by simp [Prim.cost])
      exact RunsWithin.prim_le rfl (by simp [Prim.cost])
    · exact (RunsWithin.ite_true (k := 1) (RunsWithin.prim_le rfl (by simp [Prim.cost]))).mono
        (by omega)
  · exact (RunsWithin.caseOption_some (k := 1) (RunsWithin.prim_le rfl
      (by simp [Prim.cost]))).mono (by omega)

theorem RunsWithin.outOfProg (gfs : List (PermData × Bool)) :
    RunsWithin X body (Align.outOfProg gfs) (outOf gfs) (6 * gfs.length + 1) := by
  have hfold := RunsWithin.foldList_of (X := X) (body := body) (a' := .prod Ty.perm .bool)
    (b' := .option Ty.perm) (cf := fun _ => 5) (f := fun acc p => Align.outStep acc p)
    (F := outStepD) gfs none fun acc p _ => RunsWithin.outStep acc p
  rw [al_foldl_outStepD, sum_map_const] at hfold
  refine RunsWithin.bind_le (RunsWithin.prim _ _) hfold ?_
  simp only [Prim.cost]
  omega

variable {m : ℕ}

theorem RunsWithin.schreierPairProg {ρ : PermData} (hρ : ρ.Valid m) {p : PermData × Bool}
    (hp : p.1.Valid m) :
    RunsWithin X body (Align.schreierPairProg ρ p) (schreierPair ρ p) (24 * m + 36) := by
  rcases p with ⟨g, bb⟩
  simp only at hp
  unfold Align.schreierPairProg
  refine RunsWithin.bind_le (c₂ := 24 * m + 35) (RunsWithin.prim _ _) ?_
    (by simp [Prim.cost]; omega)
  refine RunsWithin.bind_le (c₂ := 24 * m + 34) (RunsWithin.prim _ _) ?_
    (by simp [Prim.cost]; omega)
  refine RunsWithin.bind_le (c₂ := 24 * m + 31) (RunsWithin.permInv ρ) ?_ (by omega)
  refine RunsWithin.bind_le (c₂ := 24 * m + 30) (RunsWithin.prim _ _) ?_
    (by simp [Prim.cost]; omega)
  cases bb with
  | true =>
    refine (RunsWithin.ite_true (k := 24 * m + 29) ?_).mono (by omega)
    refine RunsWithin.bind_le (c₂ := 12 * m + 16) (RunsWithin.permMul hρ hp) ?_ (by omega)
    refine RunsWithin.bind_le (c₂ := 3) (RunsWithin.permMul (hρ.mul hp) hρ.inv) ?_ (by omega)
    refine RunsWithin.bind_le (c₂ := 1) (RunsWithin.prim _ _) ?_ (by simp [Prim.cost])
    exact RunsWithin.prim_le (by simp [schreierPair, Prim.eval]) (by simp [Prim.cost])
  | false =>
    refine (RunsWithin.ite_false (k := 24 * m + 29) ?_).mono (by omega)
    refine RunsWithin.bind_le (c₂ := 12 * m + 16) (RunsWithin.permMul hp hρ.inv) ?_ (by omega)
    refine RunsWithin.bind_le (c₂ := 3) (RunsWithin.permMul hρ hp) ?_ (by omega)
    refine RunsWithin.bind_le (c₂ := 1) (RunsWithin.prim _ _) ?_ (by simp [Prim.cost])
    exact RunsWithin.prim_le (by simp [schreierPair, Prim.eval]) (by simp [Prim.cost])

theorem al_foldl_append_rev {α : Type*} : ∀ (rows : List (List α)),
    rows.reverse.foldl (fun acc row => row ++ acc) [] = rows.flatten := by
  intro rows
  induction rows with
  | nil => rfl
  | cons r rs ih =>
    rw [List.reverse_cons, List.foldl_append, ih]
    simp

theorem RunsWithin.flattenProg {a' : Ty} (rows : List (List a'.denote)) {L : ℕ}
    (hL : ∀ r ∈ rows, r.length ≤ L) :
    RunsWithin X body (Align.flattenProg rows) rows.flatten (rows.length * (L + 3) + 2) := by
  have hfold := RunsWithin.foldList_inv (X := X) (body := body) (a' := .list a')
    (b' := .list a') (I := fun _ => True) (c := L + 1)
    (f := fun acc row => Prog.op2 .append row acc) (F := fun acc row => row ++ acc)
    rows.reverse [] (fun acc _ row hrow => by
      refine ⟨RunsWithin.prim_le rfl ?_, trivial⟩
      simpa [Prim.cost] using hL row (List.mem_reverse.1 hrow)) trivial
  rw [al_foldl_append_rev, List.length_reverse] at hfold
  apply RunsWithin.mono
  case h =>
    run_step (RunsWithin.prim _ _)
    run_step (RunsWithin.prim _ _)
    exact hfold.1
  case hc =>
    simp only [Prim.cost, Args.head]
    nlinarith

/-- The cost of `stabInPProg` for `k` flagged generators of degree `m`. -/
def stabInPCost (m k : ℕ) : ℕ := k * (24 * m + 50) + 6

theorem RunsWithin.stabInPProg {gfs : List (PermData × Bool)}
    (hv : ∀ p ∈ gfs, p.1.Valid m) :
    RunsWithin X body (Align.stabInPProg gfs) (stabInPL gfs) (stabInPCost m gfs.length) := by
  unfold Align.stabInPProg stabInPL
  rcases ho : outOf gfs with _ | ρ
  · have hmap := RunsWithin.mapList_le (X := X) (body := body) (a' := .prod Ty.perm .bool)
      (b' := Ty.perm) (xs := gfs) (c := 1) (F := Prod.fst)
      (f := fun p => Prog.op1 Prim.fst p) fun p _ => RunsWithin.prim_le rfl le_rfl
    have hout := RunsWithin.outOfProg (X := X) (body := body) gfs
    rw [ho] at hout
    refine RunsWithin.bind_le hout (RunsWithin.caseOption_none hmap) ?_
    simp only [stabInPCost]
    nlinarith
  · obtain ⟨q, hq, hρq, -⟩ := outOf_some ho
    have hρ : ρ.Valid m := hρq ▸ hv q hq
    have hmap := RunsWithin.mapList_le (X := X) (body := body) (a' := .prod Ty.perm .bool)
      (b' := Ty.gens) (xs := gfs) (c := 24 * m + 36) (F := schreierPair ρ)
      (f := fun p => Align.schreierPairProg ρ p) fun p hp =>
        RunsWithin.schreierPairProg hρ (hv p hp)
    have hfl := RunsWithin.flattenProg (X := X) (body := body) (a' := Ty.perm)
      (rows := gfs.map (schreierPair ρ)) (L := 2) fun r hr => by
        obtain ⟨p, -, rfl⟩ := List.mem_map.1 hr
        unfold schreierPair
        split_ifs <;> simp
    have hout := RunsWithin.outOfProg (X := X) (body := body) gfs
    rw [ho] at hout
    refine RunsWithin.bind_le hout (RunsWithin.caseOption_some
      (RunsWithin.bind_le hmap (hfl.of_eq (by simp [List.flatMap])) (le_refl _))) ?_
    simp only [stabInPCost, List.length_map]
    nlinarith

/-- The cost of `isoInPProg`. -/
def isoInPCost (m k : ℕ) : ℕ := 6 * k + 12 * m + 18

theorem RunsWithin.isoInPProg {gfs : List (PermData × Bool)} (hv : ∀ p ∈ gfs, p.1.Valid m)
    {σ : PermData} (hσ : σ.Valid m) (bσ : Bool) :
    RunsWithin X body (Align.isoInPProg gfs σ bσ) (isoInPL gfs σ bσ)
      (isoInPCost m gfs.length) := by
  unfold Align.isoInPProg isoInPL
  cases bσ with
  | true =>
    exact RunsWithin.mono (RunsWithin.ite_true (k := 1) (RunsWithin.prim_le rfl
      (by simp [Prim.cost]))) (by simp only [isoInPCost]; omega)
  | false =>
    refine RunsWithin.mono (RunsWithin.ite_false (k := 6 * gfs.length + 12 * m + 17) ?_)
      (by simp only [isoInPCost]; omega)
    have hout := RunsWithin.outOfProg (X := X) (body := body) gfs
    rcases ho : outOf gfs with _ | ρ
    · rw [ho] at hout
      refine RunsWithin.bind_le hout (RunsWithin.caseOption_none (RunsWithin.prim _ _)) ?_
      simp [Prim.cost]
      omega
    · rw [ho] at hout
      obtain ⟨q, hq, hρq, -⟩ := outOf_some ho
      have hρ : ρ.Valid m := hρq ▸ hv q hq
      refine RunsWithin.bind_le hout (RunsWithin.caseOption_some
        (RunsWithin.bind_le (RunsWithin.permMul hσ hρ) (RunsWithin.prim_le rfl le_rfl)
          (le_refl _))) ?_
      simp [Prim.cost]
      omega

end LocalSpecs

/-! ### Specifications of the backend programs -/

section BackendSpecs

variable {D : Ty} {a b : Ty} {X : Ctx (groupSig D)}
  {body : a.denote → Prog (groupSig D) (a, b) Ty.denote b} {DV : ℕ → GensData → D.denote → Prop}

/-- `P = ψ(G)` as computed by the backend. -/
def pModel (O : Oracle (groupSig D)) (n : ℕ) (G : GroupData D.denote) : GroupData D.denote :=
  O.run GroupOp.generate (G.1 - n, G.2.1.map (baseD n G.1))

/-- **`P` as a group of degree `N - n`.** -/
theorem RunsWithin.pGroupProg (hO : MeetsContractOn DV (· = .generate) X.O)
    (hPre : ∀ x, GroupPre DV .generate x → X.Pre .generate x)
    {n N : ℕ} {gs : GensData} {d : D.denote} (hgs : GensData.AllValid N gs)
    (hG : IsInvariant (GensData.denote N gs) (baseSet n N)) {BgP : ℕ}
    (hB : X.B.call GroupOp.generate (N - n, gs.map (baseD n N))
      (X.O.run GroupOp.generate (N - n, gs.map (baseD n N))) ≤ BgP) :
    RunsWithin X body (Align.pGroupProg n (N, gs, d)) (pModel X.O n (N, gs, d))
        (gs.length * (baseDCost (N - n) + 3) + BgP + 8) ∧
      (pModel X.O n (N, gs, d)).1 = N - n ∧
      GroupValid DV (N - n) (pModel X.O n (N, gs, d)).2.1 (pModel X.O n (N, gs, d)).2.2 ∧
      GensData.denote (N - n) (pModel X.O n (N, gs, d)).2.1 = (baseHom _ n hG).range := by
  have hv := allValid_baseGens hG hgs
  have hpost := hO .generate (N - n, gs.map (baseD n N)) rfl hv
  have hmap := RunsWithin.mapList_le (X := X) (body := body) (a' := Ty.perm) (b' := Ty.perm)
    (xs := gs) (c := baseDCost (N - n)) (F := baseD n N) (f := fun g => Align.baseDProg n N g)
    fun g _ => RunsWithin.baseDProg n N g
  refine ⟨?_, ?_⟩
  · apply RunsWithin.mono
    case h =>
      run_step (RunsWithin.prim _ _)
      run_step (RunsWithin.prim _ _)
      run_step (RunsWithin.prim _ _)
      run_step (RunsWithin.prim _ _)
      run_step hmap
      run_step (RunsWithin.prim _ _)
      exact RunsWithin.call (hPre _ hv)
    case hc =>
      simp only [Prim.cost, Prim.eval]
      omega
  · unfold pModel
    dsimp only
    rcases hH : X.O.run GroupOp.generate (N - n, gs.map (baseD n N)) with ⟨m', ps, e⟩
    rw [hH] at hpost
    obtain ⟨rfl, hGv, hden⟩ := hpost
    exact ⟨rfl, hGv, hden.trans (denote_baseGens hG hgs)⟩

/-- The flagged generators, as computed by the backend. -/
def flagsModel (O : Oracle (groupSig D)) (P : GroupData D.denote) (gs : GensData) :
    List (PermData × Bool) :=
  gs.map fun g => (g, O.run GroupOp.mem (P, g))

theorem RunsWithin.flagsProg (hPre : ∀ x, GroupPre DV .mem x → X.Pre .mem x)
    {m : ℕ} {ps : GensData} {e : D.denote} (hP : GroupValid DV m ps e) {gs : GensData}
    (hgs : GensData.AllValid m gs) {Bmem : ℕ}
    (hB : ∀ g : PermData, g.Valid m → X.B.call GroupOp.mem ((m, ps, e), g)
      (X.O.run GroupOp.mem ((m, ps, e), g)) ≤ Bmem) :
    RunsWithin X body (Align.flagsProg (m, ps, e) gs) (flagsModel X.O (m, ps, e) gs)
      (gs.length * (Bmem + 5) + 2) := by
  refine RunsWithin.mapList_le fun g hg => ?_
  have hpre : GroupPre DV .mem ((m, ps, e), g) := ⟨hP, hgs g hg⟩
  apply RunsWithin.mono
  case h =>
    run_step (RunsWithin.prim _ _)
    run_step (RunsWithin.call (hPre _ hpre))
    exact RunsWithin.prim_le rfl le_rfl
  case hc =>
    have hp : Prim.eval (Prim.pair (a := Ty.group D) (b := Ty.perm))
        (Args.cons (m, ps, e) (Args.cons g Args.nil)) = ((m, ps, e), g) := rfl
    simp only [Prim.cost]
    rw [hp]
    have := hB g (hgs g hg)
    omega

/-- The flags record membership in `P`. -/
theorem flagsOK_flagsModel {O : Oracle (groupSig D)} (hO : MeetsContractOn DV (· = .mem) O)
    {m : ℕ} {ps : GensData} {e : D.denote} (hP : GroupValid DV m ps e) {gs : GensData}
    (hgs : GensData.AllValid m gs) :
    FlagsOK m (GensData.denote m ps) (flagsModel O (m, ps, e) gs) := by
  intro p hp
  obtain ⟨g, hg, rfl⟩ := List.mem_map.1 hp
  exact ⟨hgs g hg, hO .mem ((m, ps, e), g) rfl ⟨hP, hgs g hg⟩⟩

/-- The operations of the preimage. -/
def preOps (op : GroupOp) : Prop := op = .kernel ∨ op = .lift ∨ op = .generate

/-- The preimage, as computed by the backend. -/
def preModel (O : Oracle (groupSig D)) (n : ℕ) (G : GroupData D.denote) (Ls : GensData) :
    GroupData D.denote :=
  O.run GroupOp.generate (G.1, Ls.map (liftModel O n G) ++ (kerModel O n G).2.1)

/-- The cost of `preProg` with `k` generators of `L`. -/
def preCost (n N k Bk Bl Bg : ℕ) : ℕ :=
  baseWinCost n N + Bk + Bg + k * (baseWinCost n N + Bl + 7) + 8

/-- **The preimage of `⟨Ls⟩` under `ψ`.** -/
theorem RunsWithin.preProg (hO : MeetsContractOn DV preOps X.O)
    (hPre : ∀ op x, preOps op → GroupPre DV op x → X.Pre op x)
    {n N : ℕ} {gs : GensData} {d : D.denote} (hGv : GroupValid DV N gs d)
    (hG : IsInvariant (GensData.denote N gs) (baseSet n N)) {Ls : GensData}
    (hLs : ∀ π ∈ Ls, π.Valid (N - n) ∧
      PermData.denote (N - n) π ∈ (baseHom (GensData.denote N gs) n hG).range)
    {Bk Bl Bg : ℕ}
    (hBk : X.B.call GroupOp.kernel ((N, gs, d), baseWin n N) (kerModel X.O n (N, gs, d)) ≤ Bk)
    (hBl : ∀ π ∈ Ls, X.B.call GroupOp.lift ((N, gs, d), (baseWin n N, π))
      (liftModel X.O n (N, gs, d) π) ≤ Bl)
    (hBg : X.B.call GroupOp.generate (N, Ls.map (liftModel X.O n (N, gs, d)) ++
      (kerModel X.O n (N, gs, d)).2.1) (preModel X.O n (N, gs, d) Ls) ≤ Bg) :
    RunsWithin X body (Align.preProg n (N, gs, d) Ls) (preModel X.O n (N, gs, d) Ls)
        (preCost n N Ls.length Bk Bl Bg) ∧
      (preModel X.O n (N, gs, d) Ls).1 = N ∧
      GroupValid DV N (preModel X.O n (N, gs, d) Ls).2.1 (preModel X.O n (N, gs, d) Ls).2.2 ∧
      GensData.denote N (preModel X.O n (N, gs, d) Ls).2.1 =
        ((Subgroup.closure (denSet (N - n) Ls)).comap
          (baseHom (GensData.denote N gs) n hG)).map (GensData.denote N gs).subtype := by
  have hbw := baseWin_valid n N
  have hbwd := baseWin_denote n N
  -- the kernel
  have hkpre : GroupPre DV .kernel ((N, gs, d), baseWin n N) :=
    ⟨hGv, hbw, by rw [hbwd]; exact hG⟩
  have hkpost := hO .kernel _ (Or.inl rfl) hkpre
  have hKm : kerModel X.O n (N, gs, d) = X.O.run GroupOp.kernel ((N, gs, d), baseWin n N) := rfl
  rcases hK : X.O.run GroupOp.kernel ((N, gs, d), baseWin n N) with ⟨N', ks, e⟩
  rw [hK] at hkpost hKm
  obtain ⟨hN', hKv, hKden⟩ := hkpost
  change N' = N at hN'
  subst N'
  change GensData.denote N ks = pointwiseStab _ (WinData.denote N (baseWin n N)) at hKden
  rw [hbwd, pointwiseStab_base_eq hG] at hKden
  -- the lifts
  have hliftO : MeetsContractOn DV liftOps X.O := fun op x h hx => hO op x (Or.inr (Or.inl h)) hx
  have hliftP : ∀ op x, liftOps op → GroupPre DV op x → X.Pre op x :=
    fun op x h hx => hPre op x (Or.inr (Or.inl h)) hx
  have hlift : ∀ π ∈ Ls, RunsWithin X body (Toolkit.liftProg n (N, gs, d) π)
      (liftModel X.O n (N, gs, d) π) (baseWinCost n N + Bl + 3) ∧
      PermData.Valid N (liftModel X.O n (N, gs, d) π) ∧
      ∃ h : PermData.denote N (liftModel X.O n (N, gs, d) π) ∈ GensData.denote N gs,
        baseHom (GensData.denote N gs) n hG ⟨_, h⟩ = PermData.denote (N - n) π :=
    fun π hπ => RunsWithin.liftProg hliftO hliftP hGv hG (hLs π hπ).1 (hLs π hπ).2
      (hBl π hπ)
  have hmap := RunsWithin.mapList_le (X := X) (body := body) (a' := Ty.perm) (b' := Ty.perm)
    (xs := Ls) (c := baseWinCost n N + Bl + 3) (F := liftModel X.O n (N, gs, d))
    (f := fun π => Toolkit.liftProg n (N, gs, d) π) fun π hπ => (hlift π hπ).1
  -- the generators
  set all := Ls.map (liftModel X.O n (N, gs, d)) ++ ks with hall
  have hallv : GensData.AllValid N all := by
    intro g hg
    rcases List.mem_append.1 hg with hg | hg
    · obtain ⟨π, hπ, rfl⟩ := List.mem_map.1 hg
      exact (hlift π hπ).2.1
    · exact hKv.1 g hg
  have hgpost := hO .generate (N, all) (Or.inr (Or.inr rfl)) hallv
  have hPm : preModel X.O n (N, gs, d) Ls = X.O.run GroupOp.generate (N, all) := by
    rw [preModel, hKm]
  refine ⟨?_, ?_⟩
  · rw [hPm]
    rw [hKm] at hBk
    rw [hKm, ← hall, hPm] at hBg
    apply RunsWithin.mono
    case h =>
      run_step (RunsWithin.prim _ _)
      run_step (RunsWithin.baseWinProg n N)
      run_step (RunsWithin.prim _ _)
      run_step (RunsWithin.call (hPre _ _ (Or.inl rfl) hkpre))
      simp only [Prim.eval]
      rw [hK]
      run_step hmap
      run_step (RunsWithin.prim _ _)
      run_step (RunsWithin.prim _ _)
      run_step (RunsWithin.prim _ _)
      run_step (RunsWithin.prim _ _)
      exact RunsWithin.call (hPre _ _ (Or.inr (Or.inr rfl)) hallv)
    case hc =>
      simp only [Prim.cost, Prim.eval, Args.head, List.length_map, preCost]
      rw [hK]
      nlinarith
  · rw [hPm]
    rcases hH : X.O.run GroupOp.generate (N, all) with ⟨N'', hs, e'⟩
    rw [hH] at hgpost
    obtain ⟨hN'', hGv', hden⟩ := hgpost
    change N'' = N at hN''
    subst N''
    refine ⟨rfl, hGv', ?_⟩
    change GensData.denote N hs = _
    rw [hden, GensData.denote, hall, GensData.denoteSet_append]
    refine closure_lifts_ker _ ?_ ?_ _ ?_
    · rintro _ ⟨g, hg, rfl⟩
      obtain ⟨π, hπ, rfl⟩ := List.mem_map.1 hg
      obtain ⟨h, hψ⟩ := (hlift π hπ).2.2
      exact ⟨h, hψ ▸ ⟨π, hπ, rfl⟩⟩
    · rintro _ ⟨π, hπ, rfl⟩
      obtain ⟨h, hψ⟩ := (hlift π hπ).2.2
      exact ⟨_, ⟨_, List.mem_map.2 ⟨π, hπ, rfl⟩, rfl⟩, h, hψ⟩
    · exact hKden

end BackendSpecs

/-! ### Align -/

section AlignSem

variable {N m : ℕ} {O : Type} [MulAction (Perm (Fin m)) O]

/-- The isomorphisms of `x` with `y` in `G` that carry `X` to `Y`. -/
def isoTo (W : Set (Fin N)) (G : Subgroup (Perm (Fin N))) (ψ : G →* Perm (Fin m))
    (xs ys : Fin N → ℕ) (dX dY : O) : Set (Perm (Fin N)) :=
  {g | g ∈ iso W 1 G xs ys ∧ ∃ h : g ∈ G, ψ ⟨g, h⟩ • dX = dY}

/-- **One alignment**: if `t ∈ G` carries `X` to `Y`, the coset `t • ψ⁻¹(Stab(X))` holds exactly
the isomorphisms carrying `X` to `Y`. -/
theorem iso_eq_isoTo {W : Set (Fin N)} {G : Subgroup (Perm (Fin N))} {ψ : G →* Perm (Fin m)}
    {xs ys : Fin N → ℕ} {dX dY : O} {t : Perm (Fin N)} (ht : t ∈ G)
    (htX : ψ ⟨t, ht⟩ • dX = dY) :
    iso W t (((MulAction.stabilizer (Perm (Fin m)) dX).comap ψ).map G.subtype) xs ys =
      isoTo W G ψ xs ys dX dY := by
  ext g
  rw [mem_iso]
  constructor
  · rintro ⟨⟨k, hk, hkg⟩, hm⟩
    have hkg' : (k : Perm (Fin N)) = t⁻¹ * g := hkg
    have hgG : g ∈ G := by
      have e : g = t * (k : Perm (Fin N)) := by rw [hkg']; group
      rw [e]
      exact G.mul_mem ht k.2
    refine ⟨mem_iso_one.2 ⟨hgG, hm⟩, hgG, ?_⟩
    have hgk : (⟨g, hgG⟩ : G) = ⟨t, ht⟩ * k := by
      ext1
      simp [hkg']
    rw [hgk, map_mul, mul_smul, MulAction.mem_stabilizer_iff.1 (Subgroup.mem_comap.1 hk), htX]
  · rintro ⟨hiso, hgG, hY⟩
    obtain ⟨-, hm⟩ := mem_iso_one.1 hiso
    refine ⟨⟨⟨t, ht⟩⁻¹ * ⟨g, hgG⟩, ?_, rfl⟩, hm⟩
    show ψ (⟨t, ht⟩⁻¹ * ⟨g, hgG⟩) • dX = dX
    rw [map_mul, map_inv, mul_smul, hY, ← htX, inv_smul_smul]

theorem isoTo_eq_empty {W : Set (Fin N)} {G : Subgroup (Perm (Fin N))} {ψ : G →* Perm (Fin m)}
    {xs ys : Fin N → ℕ} {dX dY : O} (h : ∀ π ∈ ψ.range, π • dX ≠ dY) :
    isoTo W G ψ xs ys dX dY = ∅ := by
  ext g
  simp only [Set.mem_empty_iff_false, iff_false]
  rintro ⟨-, hg, hY⟩
  exact h _ ⟨_, rfl⟩ hY

/-- **The candidates cover the isomorphisms.** -/
theorem iso_eq_iUnion_isoTo {W : Set (Fin N)} {G : Subgroup (Perm (Fin N))}
    {ψ : G →* Perm (Fin m)} {xs ys : Fin N → ℕ} {dX : O} {ι : Type*} (Ys : List ι) (dec : ι → O)
    (halign : ∀ g ∈ iso W 1 G xs ys, ∃ Y ∈ Ys, ∃ h : g ∈ G, ψ ⟨g, h⟩ • dX = dec Y) :
    iso W 1 G xs ys = ⋃ Y ∈ Ys, isoTo W G ψ xs ys dX (dec Y) := by
  ext g
  simp only [Set.mem_iUnion, exists_prop]
  constructor
  · intro hg
    obtain ⟨Y, hY, h, hX⟩ := halign g hg
    exact ⟨Y, hY, hg, h, hX⟩
  · rintro ⟨Y, -, hg, -⟩
    exact hg

theorem al_iUnion_forall₂ {ι κ β : Type*} {Q : ι → κ → Prop} {Ys : List ι} {as : List κ}
    (h : List.Forall₂ Q Ys as) (F : κ → Set β) (T : ι → Set β) (hQ : ∀ Y a, Q Y a → F a = T Y) :
    (⋃ a ∈ as, F a) = ⋃ Y ∈ Ys, T Y := by
  induction h with
  | nil => simp
  | @cons Y a Ys as hYa _ ih =>
    simp only [List.mem_cons, Set.iUnion_iUnion_eq_or_left]
    rw [ih, hQ Y a hYa]

end AlignSem

section AlignSpecs

variable {D : Ty} {a b : Ty} {X : Ctx (groupSig D)}
  {body : a.denote → Prog (groupSig D) (a, b) Ty.denote b} {DV : ℕ → GensData → D.denote → Prop}

/-- The operations Align calls. -/
def alignOps (op : GroupOp) : Prop :=
  op = .generate ∨ op = .mem ∨ op = .kernel ∨ op = .lift

/-- The cost of one candidate. -/
def alignCallCost (n N k cI Bmem Bl Cb : ℕ) : ℕ :=
  cI + Bmem + isoInPCost (N - n) k + baseWinCost n N + Bl + Cb + 12

/-- **One candidate.** The answer denotes exactly the isomorphisms carrying `X` to `Y`. -/
theorem RunsWithin.alignCall {τ : Ty} {O : Type} {n N : ℕ} [MulAction (Perm (Fin (N - n))) O]
    (hO : MeetsContractOn DV alignOps X.O)
    (hPre : ∀ op x, alignOps op → GroupPre DV op x → X.Pre op x)
    {gs : GensData} {d : D.denote} (hGv : GroupValid DV N gs d)
    (hG : IsInvariant (GensData.denote N gs) (baseSet n N))
    (halt : alternatingGroup (Fin (N - n)) ≤ (baseHom _ n hG).range)
    {S : StructOps (N - n) τ.denote O} {Valid : τ.denote → Prop} (hS : S.Spec Valid)
    {isoP : τ.denote → τ.denote → Prog (groupSig D) (a, b) Ty.denote (.option Ty.perm)}
    {cI : ℕ} (hisoP : ∀ x y, Valid x → Valid y → RunsWithin X body (isoP x y) (S.iso x y) cI)
    {X₀ Y : τ.denote} (hX : Valid X₀) (hY : Valid Y)
    {ps : GensData} {e : D.denote} (hPv : GroupValid DV (N - n) ps e)
    (hPden : GensData.denote (N - n) ps = (baseHom _ n hG).range) {Bmem : ℕ}
    (hBmem : ∀ g : PermData, g.Valid (N - n) → X.B.call GroupOp.mem ((N - n, ps, e), g)
      (X.O.run GroupOp.mem ((N - n, ps, e), g)) ≤ Bmem)
    {gfs : List (PermData × Bool)} (hf : FlagsOK (N - n) (GensData.denote (N - n) ps) gfs)
    (hgfs : gfs.map Prod.fst = S.gens X₀)
    {g1s : GensData} {e1 : D.denote} (hG1v : GroupValid DV N g1s e1)
    (hG1 : GensData.denote N g1s = ((MulAction.stabilizer (Perm (Fin (N - n))) (S.dec X₀)).comap
      (baseHom _ n hG)).map (GensData.denote N gs).subtype)
    {xy : StrData × StrData} {w : WinData} (hw : w.Valid N)
    (hWG : IsInvariant (GensData.denote N gs) (w.denote N))
    {sub : InstData D → Prog (groupSig D) (a, b) Ty.denote (Ty.answer D)} {Cb s : ℕ}
    (hsub : SubSolves X body DV sub
      (fun I => I.1 = xy ∧ I.2.1 = w ∧ I.2.2.2 = (N, g1s, e1) ∧ I.Valid DV) (fun _ => Cb) s)
    {Bl : ℕ} (hBl : ∀ π : PermData, X.B.call GroupOp.lift ((N, gs, d), (baseWin n N, π))
      (liftModel X.O n (N, gs, d) π) ≤ Bl) :
    ∃ ans : AnswerData D,
      RunsWithin X body
        (Align.alignCall sub isoP n xy w (N, gs, d) (N - n, ps, e) (N, g1s, e1) gfs X₀ Y) ans
        (alignCallCost n N gfs.length cI Bmem Bl Cb) ∧
      Answer.denote (ans.denote N) = isoTo (w.denote N) (GensData.denote N gs)
        (baseHom _ n hG) (xy.1.denote N) (xy.2.denote N) (S.dec X₀) (S.dec Y) ∧
      ∀ c : CosetData D, ans = some c →
        c.1.Valid N ∧ GensData.AllValid N c.2.gens ∧ c.2.gens.length ≤ s := by
  have hP2 : OutMulIn (GensData.denote (N - n) ps) := by
    rw [hPden]
    exact outMulIn_of_alt_le halt
  have hstab : Subgroup.closure (denSet (N - n) (gfs.map Prod.fst)) =
      MulAction.stabilizer _ (S.dec X₀) := by
    rw [hgfs]
    exact hS.gens_closure X₀ hX
  have hgv : ∀ p ∈ gfs, p.1.Valid (N - n) := fun p hp => (hf p hp).1
  have hiso := hisoP X₀ Y hX hY
  unfold Align.alignCall
  rcases hσ : S.iso X₀ Y with _ | σ
  · -- no isomorphism at all
    rw [hσ] at hiso
    refine ⟨none, ?_, ?_, fun c h => by cases h⟩
    · refine RunsWithin.bind_le hiso (RunsWithin.caseOption_none (RunsWithin.prim _ _)) ?_
      simp only [Prim.cost, alignCallCost]
      omega
    · have hnone := hS.iso_none X₀ Y hX hY hσ
      rw [isoTo_eq_empty fun π _ => hnone π]
      rfl
  · rw [hσ] at hiso
    obtain ⟨hσv, hσxy⟩ := hS.iso_some X₀ Y hX hY σ hσ
    have hmpre : GroupPre DV .mem ((N - n, ps, e), σ) := ⟨hPv, hσv⟩
    have hmpost : X.O.run GroupOp.mem ((N - n, ps, e), σ) = true ↔
        PermData.denote (N - n) σ ∈ GensData.denote (N - n) ps :=
      hO .mem _ (Or.inr (Or.inl rfl)) hmpre
    have hspec := isoInPL_spec hP2 hf hstab hσv hσxy hmpost
    have hisoIn := RunsWithin.isoInPProg (X := X) (body := body) hgv hσv
      (X.O.run GroupOp.mem ((N - n, ps, e), σ))
    have hmB := hBmem σ hσv
    rcases hπ : isoInPL gfs σ (X.O.run GroupOp.mem ((N - n, ps, e), σ)) with _ | π
    · -- no isomorphism inside `P`
      rw [hπ] at hisoIn
      refine ⟨none, ?_, ?_, fun c h => by cases h⟩
      · apply RunsWithin.mono
        case h =>
          run_step hiso
          run_with RunsWithin.caseOption_some _
          run_step (RunsWithin.prim _ _)
          run_step (RunsWithin.call (hPre _ _ (Or.inr (Or.inl rfl)) hmpre))
          run_step hisoIn
          run_with RunsWithin.caseOption_none _
          exact RunsWithin.prim _ _
        case hc =>
          simp only [Prim.cost, Prim.eval, alignCallCost]
          omega
      · have hnone := hspec.2 hπ
        rw [isoTo_eq_empty fun π' hπ' => hnone π' (hPden ▸ hπ')]
        rfl
    · obtain ⟨hπv, hπP, hπxy⟩ := hspec.1 π hπ
      rw [hπ] at hisoIn
      have hπR : PermData.denote (N - n) π ∈ (baseHom (GensData.denote N gs) n hG).range :=
        hPden ▸ hπP
      have hliftO : MeetsContractOn DV liftOps X.O :=
        fun op x h hx => hO op x (Or.inr (Or.inr (Or.inr h))) hx
      have hliftP : ∀ op x, liftOps op → GroupPre DV op x → X.Pre op x :=
        fun op x h hx => hPre op x (Or.inr (Or.inr (Or.inr h))) hx
      obtain ⟨hlrun, htv, htG, hψt⟩ :=
        RunsWithin.liftProg (body := body) hliftO hliftP hGv hG hπv hπR (hBl π)
      set t := liftModel X.O n (N, gs, d) π with ht
      have hG1le : GensData.denote N g1s ≤ GensData.denote N gs := by
        rw [hG1]
        exact Subgroup.map_subtype_le _
      have hIv : InstData.Valid (D := D) (xy, w, t, N, g1s, e1) DV :=
        ⟨hw, htv, hG1v, hWG.mono hG1le⟩
      obtain ⟨ans, hrun, hok, hgens⟩ := hsub (xy, w, t, N, g1s, e1) ⟨rfl, rfl, rfl, hIv⟩
      have hok' : AnsOK DV N (w.denote N) (PermData.denote N t) (GensData.denote N g1s)
          (xy.1.denote N) (xy.2.denote N) ans := hok
      refine ⟨ans, ?_, ?_, fun c hc => ?_⟩
      · apply RunsWithin.mono
        case h =>
          run_step hiso
          run_with RunsWithin.caseOption_some _
          run_step (RunsWithin.prim _ _)
          run_step (RunsWithin.call (hPre _ _ (Or.inr (Or.inl rfl)) hmpre))
          run_step hisoIn
          run_with RunsWithin.caseOption_some _
          run_step hlrun
          run_step (RunsWithin.prim _ _)
          run_step (RunsWithin.prim _ _)
          run_step (RunsWithin.prim _ _)
          exact hrun
        case hc =>
          simp only [Prim.cost, Prim.eval, alignCallCost]
          omega
      · have hc := hok'.isCorrect
        unfold Answer.IsCorrect at hc
        rw [hc, hG1]
        exact iso_eq_isoTo htG (by rw [hψt]; exact hπxy)
      · subst hc
        exact ⟨hok'.1, hok'.2.2.1.1, hgens _ rfl⟩

theorem length_stabInPL (gfs : List (PermData × Bool)) :
    (stabInPL gfs).length ≤ 2 * gfs.length := by
  unfold stabInPL
  rcases outOf gfs with _ | ρ
  · simp only [List.length_map]
    omega
  · rw [List.length_flatMap]
    have : ∀ p ∈ gfs, (schreierPair ρ p).length = 2 := fun p _ => by
      unfold schreierPair
      split_ifs <;> rfl
    rw [List.map_congr_left this, sum_map_const]
    omega

theorem al_comap_inf_range {M Γ' : Type*} [Group M] [Group Γ'] (ψ : M →* Γ') (A : Subgroup Γ') :
    (A ⊓ ψ.range).comap ψ = A.comap ψ := by
  ext k
  simp only [Subgroup.mem_comap, Subgroup.mem_inf, MonoidHom.mem_range]
  exact ⟨fun h => h.1, fun h => ⟨h, k, rfl⟩⟩

/-- The cost of Align: `g` generators of `G`, `k` stabilizer generators, `r` candidates. -/
def alignCost (n N g k r cG cI BgP Bmem Bk Bl Bg1 Bgen Cb s : ℕ) : ℕ :=
  1 + (g * (baseDCost (N - n) + 3) + BgP + 8) + cG + (k * (Bmem + 5) + 2) +
    stabInPCost (N - n) k + preCost n N (2 * k) Bk Bl Bg1 +
    (r * (alignCallCost n N k cI Bmem Bl Cb + 3) + 2) + (r * (12 * N + s + 26) + Bgen + 16)

theorem preCost_mono {n N k k' Bk Bl Bg : ℕ} (h : k ≤ k') :
    preCost n N k Bk Bl Bg ≤ preCost n N k' Bk Bl Bg := by
  unfold preCost
  have := Nat.mul_le_mul_right (baseWinCost n N + Bl + 7) h
  omega

/-- **Align.** If every isomorphism of `x` with `y` in `G` carries `X` to one of the
candidates `Ys`, the answer is correct for `G`. -/
theorem RunsWithin.alignProg {τ : Ty} {O : Type} {n N : ℕ} [MulAction (Perm (Fin (N - n))) O]
    (hO : MeetsContractOn DV alignOps X.O)
    (hPre : ∀ op x, alignOps op → GroupPre DV op x → X.Pre op x)
    {gs : GensData} {d : D.denote} (hGv : GroupValid DV N gs d)
    (hG : IsInvariant (GensData.denote N gs) (baseSet n N))
    (halt : alternatingGroup (Fin (N - n)) ≤ (baseHom _ n hG).range)
    {S : StructOps (N - n) τ.denote O} {Valid : τ.denote → Prop} (hS : S.Spec Valid)
    {gensP : τ.denote → Prog (groupSig D) (a, b) Ty.denote Ty.gens} {cG : ℕ}
    (hgensP : ∀ x, Valid x → RunsWithin X body (gensP x) (S.gens x) cG)
    {isoP : τ.denote → τ.denote → Prog (groupSig D) (a, b) Ty.denote (.option Ty.perm)}
    {cI : ℕ} (hisoP : ∀ x y, Valid x → Valid y → RunsWithin X body (isoP x y) (S.iso x y) cI)
    {X₀ : τ.denote} {Ys : List τ.denote} (hX : Valid X₀) (hYs : ∀ Y ∈ Ys, Valid Y)
    {xy : StrData × StrData} {w : WinData} (hw : w.Valid N)
    (hWG : IsInvariant (GensData.denote N gs) (w.denote N))
    (halign : ∀ g ∈ iso (w.denote N) 1 (GensData.denote N gs) (xy.1.denote N) (xy.2.denote N),
      ∃ Y ∈ Ys, ∃ h : g ∈ GensData.denote N gs, baseHom _ n hG ⟨g, h⟩ • S.dec X₀ = S.dec Y)
    {Cb s BgP Bmem Bk Bl Bg1 Bgen : ℕ}
    (hBgP : X.B.call GroupOp.generate (N - n, gs.map (baseD n N))
      (X.O.run GroupOp.generate (N - n, gs.map (baseD n N))) ≤ BgP)
    (hBmem : ∀ g : PermData, g.Valid (N - n) → X.B.call GroupOp.mem (pModel X.O n (N, gs, d), g)
      (X.O.run GroupOp.mem (pModel X.O n (N, gs, d), g)) ≤ Bmem)
    (hBk : X.B.call GroupOp.kernel ((N, gs, d), baseWin n N) (kerModel X.O n (N, gs, d)) ≤ Bk)
    (hBl : ∀ π : PermData, X.B.call GroupOp.lift ((N, gs, d), (baseWin n N, π))
      (liftModel X.O n (N, gs, d) π) ≤ Bl)
    (hBg1 : X.B.call GroupOp.generate
      (N, (stabInPL (flagsModel X.O (pModel X.O n (N, gs, d)) (S.gens X₀))).map
        (liftModel X.O n (N, gs, d)) ++ (kerModel X.O n (N, gs, d)).2.1)
      (preModel X.O n (N, gs, d) (stabInPL (flagsModel X.O (pModel X.O n (N, gs, d))
        (S.gens X₀)))) ≤ Bg1)
    (hBgen : ∀ gs' : GensData, GensData.AllValid N gs' → gs'.length ≤ Ys.length * (s + 1) →
      GensData.denote N gs' ≤ GensData.denote N gs →
      X.B.call GroupOp.generate (N, gs') (X.O.run GroupOp.generate (N, gs')) ≤ Bgen)
    {sub : InstData D → Prog (groupSig D) (a, b) Ty.denote (Ty.answer D)}
    (hsub : SubSolves X body DV sub (fun I => I.1 = xy ∧ I.2.1 = w ∧
      I.2.2.2 = preModel X.O n (N, gs, d)
        (stabInPL (flagsModel X.O (pModel X.O n (N, gs, d)) (S.gens X₀))) ∧ I.Valid DV)
      (fun _ => Cb) s) :
    ∃ ans : AnswerData D,
      RunsWithin X body (Align.alignProg sub gensP isoP n xy w (N, gs, d) X₀ Ys) ans
        (alignCost n N gs.length (S.gens X₀).length Ys.length cG cI BgP Bmem Bk Bl Bg1 Bgen Cb
          s) ∧
      AnsOK DV N (w.denote N) 1 (GensData.denote N gs) (xy.1.denote N) (xy.2.denote N) ans ∧
      ∀ sGen, (∀ gs', GensData.AllValid N gs' → GensData.denote N gs' ≤ GensData.denote N gs →
          (X.O.run GroupOp.generate (N, gs')).2.1.length ≤ sGen) →
        ∀ c : CosetData D, ans = some c → c.2.gens.length ≤ sGen := by
  -- `P`
  have hgenO : MeetsContractOn DV (· = .generate) X.O := fun op x h hx => hO op x (Or.inl h) hx
  have hgenP : ∀ x, GroupPre DV .generate x → X.Pre .generate x :=
    fun x hx => hPre _ x (Or.inl rfl) hx
  have hmemO : MeetsContractOn DV (· = .mem) X.O :=
    fun op x h hx => hO op x (Or.inr (Or.inl h)) hx
  have hmemP : ∀ x, GroupPre DV .mem x → X.Pre .mem x :=
    fun x hx => hPre _ x (Or.inr (Or.inl rfl)) hx
  have hpreO : MeetsContractOn DV preOps X.O := fun op x h hx => hO op x (by
    rcases h with h | h | h
    · exact Or.inr (Or.inr (Or.inl h))
    · exact Or.inr (Or.inr (Or.inr h))
    · exact Or.inl h) hx
  have hpreP : ∀ op x, preOps op → GroupPre DV op x → X.Pre op x := fun op x h hx => hPre op x
    (by
      rcases h with h | h | h
      · exact Or.inr (Or.inr (Or.inl h))
      · exact Or.inr (Or.inr (Or.inr h))
      · exact Or.inl h) hx
  obtain ⟨hPrun, hPdeg, hPv, hPden⟩ :=
    RunsWithin.pGroupProg (body := body) hgenO hgenP hGv.1 hG hBgP (d := d)
  rcases hPm : pModel X.O n (N, gs, d) with ⟨m', ps, e⟩
  rw [hPm] at hPdeg hPv hPden hPrun hBmem hBg1 hsub
  change m' = N - n at hPdeg
  subst hPdeg
  -- the stabilizer generators and their flags
  have hgXv : GensData.AllValid (N - n) (S.gens X₀) := hS.gens_valid X₀ hX
  have hgX := hgensP X₀ hX
  have hflags := RunsWithin.flagsProg (X := X) (body := body) hmemP hPv hgXv hBmem
  set gfs := flagsModel X.O (N - n, ps, e) (S.gens X₀) with hgfs_def
  have hf : FlagsOK (N - n) (GensData.denote (N - n) ps) gfs := flagsOK_flagsModel hmemO hPv hgXv
  have hgfs : gfs.map Prod.fst = S.gens X₀ := by
    simp [hgfs_def, flagsModel, Function.comp_def]
  have hgfsl : gfs.length = (S.gens X₀).length := by simp [hgfs_def, flagsModel]
  have hgv : ∀ p ∈ gfs, p.1.Valid (N - n) := fun p hp => (hf p hp).1
  have hP2 : OutMulIn (GensData.denote (N - n) ps) := by
    rw [hPden]
    exact outMulIn_of_alt_le halt
  -- `Stab(X) ∩ P`
  set Ls := stabInPL gfs with hLs_def
  have hstabIn := RunsWithin.stabInPProg (X := X) (body := body) hgv
  have hLcl : Subgroup.closure (denSet (N - n) Ls) =
      MulAction.stabilizer (Perm (Fin (N - n))) (S.dec X₀) ⊓ (baseHom _ n hG).range := by
    have hcl := hS.gens_closure X₀ hX
    change Subgroup.closure (denSet (N - n) (S.gens X₀)) = _ at hcl
    rw [hLs_def, closure_stabInPL hP2 hf, hgfs, hcl, hPden]
  have hLs : ∀ π ∈ Ls, π.Valid (N - n) ∧
      PermData.denote (N - n) π ∈ (baseHom (GensData.denote N gs) n hG).range := by
    intro π hπ
    refine ⟨stabInPL_valid hf π hπ, ?_⟩
    have : PermData.denote (N - n) π ∈ Subgroup.closure (denSet (N - n) Ls) :=
      Subgroup.subset_closure ⟨π, hπ, rfl⟩
    rw [hLcl] at this
    exact this.2
  -- `G₁`
  obtain ⟨hG1run, hG1deg, hG1v, hG1den⟩ :=
    RunsWithin.preProg (body := body) hpreO hpreP hGv hG hLs hBk (fun π _ => hBl π) hBg1
  rcases hG1m : preModel X.O n (N, gs, d) Ls with ⟨N₁, g1s, e1⟩
  rw [hG1m] at hG1deg hG1v hG1den hG1run hsub
  change N₁ = N at hG1deg
  subst hG1deg
  change GensData.denote N₁ g1s = _ at hG1den
  have hG1 : GensData.denote N₁ g1s = ((MulAction.stabilizer (Perm (Fin (N₁ - n)))
      (S.dec X₀)).comap (baseHom _ n hG)).map (GensData.denote N₁ gs).subtype := by
    rw [hG1den, hLcl, al_comap_inf_range]
  -- the candidates
  have hcall : ∀ Y ∈ Ys, ∃ ans : AnswerData D,
      RunsWithin X body
        (Align.alignCall sub isoP n xy w (N₁, gs, d) (N₁ - n, ps, e) (N₁, g1s, e1) gfs X₀ Y)
        ans (alignCallCost n N₁ gfs.length cI Bmem Bl Cb) ∧
      (Answer.denote (ans.denote N₁) = isoTo (w.denote N₁) (GensData.denote N₁ gs)
          (baseHom _ n hG) (xy.1.denote N₁) (xy.2.denote N₁) (S.dec X₀) (S.dec Y) ∧
        ∀ c : CosetData D, ans = some c →
          c.1.Valid N₁ ∧ GensData.AllValid N₁ c.2.gens ∧ c.2.gens.length ≤ s) := by
    intro Y hY
    obtain ⟨ans, h1, h2, h3⟩ := RunsWithin.alignCall (body := body) hO hPre hGv hG halt hS hisoP
      hX (hYs Y hY) hPv hPden hBmem hf hgfs hG1v hG1 hw hWG hsub hBl
    exact ⟨ans, h1, h2, h3⟩
  obtain ⟨as, has_run, has⟩ := RunsWithin.mapList_exists (X := X) (body := body)
    (a' := τ) (b' := Ty.answer D) hcall
  have hlen : as.length = Ys.length := has.length_eq.symm
  have hmem : ∀ c ∈ branchSuccesses as, (c.1.Valid N₁ ∧ GensData.AllValid N₁ c.2.gens) ∧
      c.2.gens.length ≤ s := by
    intro c hc
    obtain ⟨Y, -, -, hok⟩ := exists_of_forall₂_mem has (mem_branchSuccesses.1 hc)
    obtain ⟨h1, h2, h3⟩ := hok c rfl
    exact ⟨⟨h1, h2⟩, h3⟩
  have hS_iso : iso (w.denote N₁) 1 (GensData.denote N₁ gs) (xy.1.denote N₁) (xy.2.denote N₁) =
      ⋃ a ∈ as.map (AnswerData.denote N₁), Answer.denote a := by
    rw [iso_eq_iUnion_isoTo Ys S.dec halign]
    have := al_iUnion_forall₂ has (fun a => Answer.denote (AnswerData.denote N₁ a))
      (fun Y => isoTo (w.denote N₁) (GensData.denote N₁ gs) (baseHom _ n hG)
        (xy.1.denote N₁) (xy.2.denote N₁) (S.dec X₀) (S.dec Y)) fun Y a h => h.1
    rw [← this]
    ext g
    simp only [Set.mem_iUnion, List.mem_map, exists_prop]
    constructor
    · rintro ⟨a, ha, hg⟩
      exact ⟨_, ⟨a, ha, rfl⟩, hg⟩
    · rintro ⟨_, ⟨a, ha, rfl⟩, hg⟩
      exact ⟨a, ha, hg⟩
  have hok := al_ansOK_combine hgenO hWG (fun c hc => (hmem c hc).1) hS_iso
  -- the combined generators
  have hcg : ∀ c₀ rest, branchSuccesses as = c₀ :: rest →
      GensData.AllValid N₁ (combineGens c₀.1 (c₀ :: rest)) ∧
      (combineGens c₀.1 (c₀ :: rest)).length ≤ Ys.length * (s + 1) ∧
      GensData.denote N₁ (combineGens c₀.1 (c₀ :: rest)) ≤ GensData.denote N₁ gs := by
    intro c₀ rest hss
    have hv₀ := (hmem c₀ (by rw [hss]; exact List.mem_cons_self)).1
    have hgv' : GensData.AllValid N₁ (combineGens c₀.1 (c₀ :: rest)) := by
      rw [combineGens]
      refine allValid_branchGens hv₀.1.inv fun p hp => ?_
      obtain ⟨c, hc, rfl⟩ := List.mem_map.1 hp
      exact (hmem c (by rw [hss]; exact hc)).1
    refine ⟨hgv', ?_, ?_⟩
    · rw [length_combineGens]
      have hsum : ((c₀ :: rest).map fun c => c.2.gens.length).sum ≤ (c₀ :: rest).length * s :=
        sum_map_le _ _ _ fun c hc => (hmem c (by rw [hss]; exact hc)).2
      have hk : (c₀ :: rest).length ≤ Ys.length := by
        rw [← hss, ← hlen]; exact List.length_filterMap_le _ _
      simp only [List.length_cons, Nat.add_sub_cancel] at hsum hk ⊢
      nlinarith
    · have hpost := hgenO .generate (N₁, combineGens c₀.1 (c₀ :: rest)) rfl hgv'
      have hok' := hok
      unfold combineModel at hok'
      rw [hss] at hok'
      dsimp only at hok'
      rcases hH : X.O.run GroupOp.generate (N₁, combineGens c₀.1 (c₀ :: rest)) with ⟨n', hs', e'⟩
      rw [hH] at hpost hok'
      obtain ⟨-, -, hden⟩ := hpost
      have haut := AnsOK.eq_aut hWG hok'
      change GensData.denote N₁ hs' = _ at haut
      change GensData.denote N₁ hs' = GensData.denote N₁ (combineGens c₀.1 (c₀ :: rest)) at hden
      rw [← hden, haut]
      exact aut_le _ _
  have hcomb := RunsWithin.combineProg (X := X) (body := body) (Bgen := Bgen) hgenP
    (fun c hc => (hmem c hc).1) (fun c hc => (hmem c hc).2) fun c₀ rest hss =>
      hBgen _ (hcg c₀ rest hss).1 (hcg c₀ rest hss).2.1 (hcg c₀ rest hss).2.2
  have hcl := combineCost_le (n := N₁) (Bgen := Bgen) (as := as) (fun c hc => (hmem c hc).2)
  have hLlen : Ls.length ≤ 2 * (S.gens X₀).length := by
    rw [← hgfsl]
    exact length_stabInPL gfs
  refine ⟨combineModel X.O N₁ as, ?_, hok, ?_⟩
  · apply RunsWithin.mono
    case h =>
      run_step (RunsWithin.prim _ _)
      run_step hPrun
      run_step hgX
      run_step hflags
      run_step hstabIn
      run_step hG1run
      run_step has_run
      exact hcomb
    case hc =>
      have h1 := preCost_mono (n := n) (N := N₁) (Bk := Bk) (Bl := Bl) (Bg := Bg1) hLlen
      rw [hlen] at hcl
      simp only [Prim.cost, alignCost, hgfsl]
      omega
  · intro sGen hgen c hc
    unfold combineModel at hc
    split at hc
    · cases hc
    · rename_i c₀ rest hss
      cases hc
      exact hgen _ (hcg c₀ rest hss).1 (hcg c₀ rest hss).2.2

end AlignSpecs

/-! ### Well-formedness -/

section Wf

variable {D : Ty} {S : Signature} {rec : Ty × Ty} {var₁ var₂ : Ty → Type} {r : Bool}
  {Γ : WfCtx var₁ var₂}

/-- Well-formed two-argument program families, in every larger context. -/
def WfFun2 {a' b' t : Ty} (r : Bool) (Γ : WfCtx var₁ var₂)
    (f₁ : var₁ a' → var₁ b' → Prog S rec var₁ t) (f₂ : var₂ a' → var₂ b' → Prog S rec var₂ t) :
    Prop :=
  ∀ Γ' : WfCtx var₁ var₂, Γ ⊆ Γ' → ∀ x₁ x₂ y₁ y₂, ⟨a', x₁, x₂⟩ ∈ Γ' → ⟨b', y₁, y₂⟩ ∈ Γ' →
    Prog.Wf r Γ' (f₁ x₁ y₁) (f₂ x₂ y₂)

theorem wf_alBaseEntry {n₁ j₁ : var₁ .nat} {n₂ j₂ : var₂ .nat} {a₁ : var₁ (.array .nat)}
    {a₂ : var₂ (.array .nat)} (hn : ⟨.nat, n₁, n₂⟩ ∈ Γ) (ha : ⟨.array .nat, a₁, a₂⟩ ∈ Γ)
    (hj : ⟨.nat, j₁, j₂⟩ ∈ Γ) :
    Prog.Wf (S := S) (rec := rec) r Γ (alBaseEntry n₁ a₁ j₁) (alBaseEntry n₂ a₂ j₂) := by
  unfold alBaseEntry
  prog_wf

theorem wf_baseDProg {n₁ N₁ : var₁ .nat} {n₂ N₂ : var₂ .nat} {g₁ : var₁ Ty.perm}
    {g₂ : var₂ Ty.perm} (hn : ⟨.nat, n₁, n₂⟩ ∈ Γ) (hN : ⟨.nat, N₁, N₂⟩ ∈ Γ)
    (hg : ⟨Ty.perm, g₁, g₂⟩ ∈ Γ) :
    Prog.Wf (S := S) (rec := rec) r Γ (baseDProg n₁ N₁ g₁) (baseDProg n₂ N₂ g₂) := by
  unfold baseDProg
  refine .bind (.prim _ (.cons hN (.cons hn .nil))) fun m₁ m₂ => ?_
  refine .bind (.prim _ (.cons (by simp) .nil)) fun js₁ js₂ => ?_
  refine .bind (.prim _ (.cons (by simp [hg]) .nil)) fun f₁ f₂ => ?_
  refine .bind (.prim _ (.cons (by simp [hg]) .nil)) fun b₁ b₂ => ?_
  refine .bind (wf_mapList (by simp) fun Γ' hΓ' j₁ j₂ hj =>
    wf_alBaseEntry (hΓ' (by simp [hn])) (hΓ' (by simp)) hj) fun fl₁ fl₂ => ?_
  refine .bind (wf_mapList (by simp) fun Γ' hΓ' j₁ j₂ hj =>
    wf_alBaseEntry (hΓ' (by simp [hn])) (hΓ' (by simp)) hj) fun bl₁ bl₂ => ?_
  prog_wf

theorem wf_pGroupProg {n₁ : var₁ .nat} {n₂ : var₂ .nat} {G₁ : var₁ (Ty.group D)}
    {G₂ : var₂ (Ty.group D)} (hn : ⟨.nat, n₁, n₂⟩ ∈ Γ) (hG : ⟨Ty.group D, G₁, G₂⟩ ∈ Γ) :
    Prog.Wf (rec := rec) r Γ (pGroupProg n₁ G₁) (pGroupProg n₂ G₂) := by
  unfold pGroupProg
  refine .bind (.prim _ (.cons hG .nil)) fun N₁ N₂ => ?_
  refine .bind (.prim _ (.cons (by simp) (.cons (by simp [hn]) .nil))) fun m₁ m₂ => ?_
  refine .bind (.prim _ (.cons (by simp [hG]) .nil)) fun d₁ d₂ => ?_
  refine .bind (.prim _ (.cons (by simp) .nil)) fun gs₁ gs₂ => ?_
  refine .bind (wf_mapList (by simp) fun Γ' hΓ' g₁ g₂ hg =>
    wf_baseDProg (hΓ' (by simp [hn])) (hΓ' (by simp)) hg) fun b₁ b₂ => ?_
  prog_wf

theorem wf_flagsProg {P₁ : var₁ (Ty.group D)} {P₂ : var₂ (Ty.group D)} {gs₁ : var₁ Ty.gens}
    {gs₂ : var₂ Ty.gens} (hP : ⟨Ty.group D, P₁, P₂⟩ ∈ Γ) (hgs : ⟨Ty.gens, gs₁, gs₂⟩ ∈ Γ) :
    Prog.Wf (rec := rec) r Γ (flagsProg P₁ gs₁) (flagsProg P₂ gs₂) := by
  unfold flagsProg
  refine wf_mapList hgs fun Γ' hΓ' g₁ g₂ hg => ?_
  unfold flagProg
  prog_wf
  exact hΓ' (by simp [hP])

theorem wf_outOfProg {g₁ : var₁ (.list (.prod Ty.perm .bool))}
    {g₂ : var₂ (.list (.prod Ty.perm .bool))} (hg : ⟨.list (.prod Ty.perm .bool), g₁, g₂⟩ ∈ Γ) :
    Prog.Wf (S := S) (rec := rec) r Γ (outOfProg g₁) (outOfProg g₂) := by
  unfold outOfProg outStep
  prog_wf

theorem wf_schreierPairProg {ρ₁ : var₁ Ty.perm} {ρ₂ : var₂ Ty.perm}
    {p₁ : var₁ (.prod Ty.perm .bool)} {p₂ : var₂ (.prod Ty.perm .bool)}
    (hρ : ⟨Ty.perm, ρ₁, ρ₂⟩ ∈ Γ) (hp : ⟨.prod Ty.perm .bool, p₁, p₂⟩ ∈ Γ) :
    Prog.Wf (S := S) (rec := rec) r Γ (schreierPairProg ρ₁ p₁) (schreierPairProg ρ₂ p₂) := by
  unfold schreierPairProg permInv permMul mapArray mapList
  prog_wf

theorem wf_flattenProg {a' : Ty} {rows₁ : var₁ (.list (.list a'))}
    {rows₂ : var₂ (.list (.list a'))} (hr : ⟨.list (.list a'), rows₁, rows₂⟩ ∈ Γ) :
    Prog.Wf (S := S) (rec := rec) r Γ (flattenProg rows₁) (flattenProg rows₂) := by
  unfold flattenProg
  prog_wf

theorem wf_stabInPProg {g₁ : var₁ (.list (.prod Ty.perm .bool))}
    {g₂ : var₂ (.list (.prod Ty.perm .bool))} (hg : ⟨.list (.prod Ty.perm .bool), g₁, g₂⟩ ∈ Γ) :
    Prog.Wf (S := S) (rec := rec) r Γ (stabInPProg g₁) (stabInPProg g₂) := by
  unfold stabInPProg
  refine .bind (wf_outOfProg hg) fun o₁ o₂ => ?_
  refine .caseOption (by simp) ?_ fun ρ₁ ρ₂ => ?_
  · exact wf_mapList (by simp [hg]) fun Γ' hΓ' p₁ p₂ hp => .prim _ (.cons hp .nil)
  · refine .bind (wf_mapList (by simp [hg]) fun Γ' hΓ' p₁ p₂ hp =>
      wf_schreierPairProg (hΓ' (by simp)) hp) fun rw₁ rw₂ => ?_
    exact wf_flattenProg (by simp)

theorem wf_isoInPProg {g₁ : var₁ (.list (.prod Ty.perm .bool))}
    {g₂ : var₂ (.list (.prod Ty.perm .bool))} {σ₁ : var₁ Ty.perm} {σ₂ : var₂ Ty.perm}
    {b₁ : var₁ .bool} {b₂ : var₂ .bool} (hg : ⟨.list (.prod Ty.perm .bool), g₁, g₂⟩ ∈ Γ)
    (hσ : ⟨Ty.perm, σ₁, σ₂⟩ ∈ Γ) (hb : ⟨.bool, b₁, b₂⟩ ∈ Γ) :
    Prog.Wf (S := S) (rec := rec) r Γ (isoInPProg g₁ σ₁ b₁) (isoInPProg g₂ σ₂ b₂) := by
  unfold isoInPProg
  refine .ite hb (.prim _ (.cons hσ .nil)) ?_
  refine .bind (wf_outOfProg hg) fun o₁ o₂ => ?_
  refine .caseOption (by simp) (.prim _ .nil) fun ρ₁ ρ₂ => ?_
  refine .bind (wf_permMul (by simp [hσ]) (by simp)) fun c₁ c₂ => ?_
  exact .prim _ (.cons (by simp) .nil)

theorem wf_preProg {n₁ : var₁ .nat} {n₂ : var₂ .nat} {G₁ : var₁ (Ty.group D)}
    {G₂ : var₂ (Ty.group D)} {L₁ : var₁ Ty.gens} {L₂ : var₂ Ty.gens}
    (hn : ⟨.nat, n₁, n₂⟩ ∈ Γ) (hG : ⟨Ty.group D, G₁, G₂⟩ ∈ Γ) (hL : ⟨Ty.gens, L₁, L₂⟩ ∈ Γ) :
    Prog.Wf (rec := rec) r Γ (preProg n₁ G₁ L₁) (preProg n₂ G₂ L₂) := by
  unfold preProg
  refine .bind (.prim _ (.cons hG .nil)) fun N₁ N₂ => ?_
  refine .bind (wf_baseWinProg (by simp [hn]) (by simp)) fun bw₁ bw₂ => ?_
  refine .bind (.prim _ (.cons (by simp [hG]) (.cons (by simp) .nil))) fun a₁ a₂ => ?_
  refine .bind (.call _ (.head _)) fun K₁ K₂ => ?_
  refine .bind (wf_mapList (by simp [hL]) fun Γ' hΓ' π₁ π₂ hπ =>
    wf_liftProg (hΓ' (by simp [hn])) (hΓ' (by simp [hG])) hπ) fun l₁ l₂ => ?_
  prog_wf

theorem wf_alignCall {τ : Ty}
    {sub₁ : var₁ (Ty.inst D) → Prog (groupSig D) rec var₁ (Ty.answer D)}
    {sub₂ : var₂ (Ty.inst D) → Prog (groupSig D) rec var₂ (Ty.answer D)}
    {isoP₁ : var₁ τ → var₁ τ → Prog (groupSig D) rec var₁ (.option Ty.perm)}
    {isoP₂ : var₂ τ → var₂ τ → Prog (groupSig D) rec var₂ (.option Ty.perm)}
    (hsub : WfFun r Γ sub₁ sub₂) (hiso : WfFun2 r Γ isoP₁ isoP₂)
    {n₁ : var₁ .nat} {n₂ : var₂ .nat} {xy₁ : var₁ Ty.strs} {xy₂ : var₂ Ty.strs}
    {w₁ : var₁ Ty.win} {w₂ : var₂ Ty.win} {G₁ P₁ H₁ : var₁ (Ty.group D)}
    {G₂ P₂ H₂ : var₂ (Ty.group D)} {g₁ : var₁ (.list (.prod Ty.perm .bool))}
    {g₂ : var₂ (.list (.prod Ty.perm .bool))} {X₁ Y₁ : var₁ τ} {X₂ Y₂ : var₂ τ}
    (hn : ⟨.nat, n₁, n₂⟩ ∈ Γ) (hxy : ⟨Ty.strs, xy₁, xy₂⟩ ∈ Γ) (hw : ⟨Ty.win, w₁, w₂⟩ ∈ Γ)
    (hG : ⟨Ty.group D, G₁, G₂⟩ ∈ Γ) (hP : ⟨Ty.group D, P₁, P₂⟩ ∈ Γ)
    (hH : ⟨Ty.group D, H₁, H₂⟩ ∈ Γ) (hg : ⟨.list (.prod Ty.perm .bool), g₁, g₂⟩ ∈ Γ)
    (hX : ⟨τ, X₁, X₂⟩ ∈ Γ) (hY : ⟨τ, Y₁, Y₂⟩ ∈ Γ) :
    Prog.Wf r Γ (alignCall sub₁ isoP₁ n₁ xy₁ w₁ G₁ P₁ H₁ g₁ X₁ Y₁)
      (alignCall sub₂ isoP₂ n₂ xy₂ w₂ G₂ P₂ H₂ g₂ X₂ Y₂) := by
  unfold alignCall
  refine .bind (hiso Γ (List.Subset.refl _) _ _ _ _ hX hY) fun o₁ o₂ => ?_
  refine .caseOption (by simp) (.prim _ .nil) fun σ₁ σ₂ => ?_
  refine .bind (.prim _ (.cons (by simp [hP]) (.cons (by simp) .nil))) fun a₁ a₂ => ?_
  refine .bind (.call _ (.head _)) fun b₁ b₂ => ?_
  refine .bind (wf_isoInPProg (by simp [hg]) (.tail _ (.tail _ (.head _))) (.head _))
    fun p₁ p₂ => ?_
  refine .caseOption (by simp) (.prim _ .nil) fun π₁ π₂ => ?_
  refine .bind (wf_liftProg (by simp [hn]) (by simp [hG]) (by simp)) fun t₁ t₂ => ?_
  refine .bind (.prim _ (.cons (by simp) (.cons (by simp [hH]) .nil))) fun c₁ c₂ => ?_
  refine .bind (.prim _ (.cons (by simp [hw]) (.cons (by simp) .nil))) fun d₁ d₂ => ?_
  refine .bind (.prim _ (.cons (by simp [hxy]) (.cons (by simp) .nil))) fun I₁ I₂ => ?_
  exact hsub _ (fun z hz => by simp [hz]) _ _ (by simp)

theorem wf_alignProg {τ : Ty}
    {sub₁ : var₁ (Ty.inst D) → Prog (groupSig D) rec var₁ (Ty.answer D)}
    {sub₂ : var₂ (Ty.inst D) → Prog (groupSig D) rec var₂ (Ty.answer D)}
    {gensP₁ : var₁ τ → Prog (groupSig D) rec var₁ Ty.gens}
    {gensP₂ : var₂ τ → Prog (groupSig D) rec var₂ Ty.gens}
    {isoP₁ : var₁ τ → var₁ τ → Prog (groupSig D) rec var₁ (.option Ty.perm)}
    {isoP₂ : var₂ τ → var₂ τ → Prog (groupSig D) rec var₂ (.option Ty.perm)}
    (hsub : WfFun r Γ sub₁ sub₂) (hgens : WfFun r Γ gensP₁ gensP₂)
    (hiso : WfFun2 r Γ isoP₁ isoP₂)
    {n₁ : var₁ .nat} {n₂ : var₂ .nat} {xy₁ : var₁ Ty.strs} {xy₂ : var₂ Ty.strs}
    {w₁ : var₁ Ty.win} {w₂ : var₂ Ty.win} {G₁ : var₁ (Ty.group D)} {G₂ : var₂ (Ty.group D)}
    {X₁ : var₁ τ} {X₂ : var₂ τ} {Ys₁ : var₁ (.list τ)} {Ys₂ : var₂ (.list τ)}
    (hn : ⟨.nat, n₁, n₂⟩ ∈ Γ) (hxy : ⟨Ty.strs, xy₁, xy₂⟩ ∈ Γ) (hw : ⟨Ty.win, w₁, w₂⟩ ∈ Γ)
    (hG : ⟨Ty.group D, G₁, G₂⟩ ∈ Γ) (hX : ⟨τ, X₁, X₂⟩ ∈ Γ) (hYs : ⟨.list τ, Ys₁, Ys₂⟩ ∈ Γ) :
    Prog.Wf r Γ (alignProg sub₁ gensP₁ isoP₁ n₁ xy₁ w₁ G₁ X₁ Ys₁)
      (alignProg sub₂ gensP₂ isoP₂ n₂ xy₂ w₂ G₂ X₂ Ys₂) := by
  unfold alignProg
  refine .bind (.prim _ (.cons hG .nil)) fun N₁ N₂ => ?_
  refine .bind (wf_pGroupProg (by simp [hn]) (by simp [hG])) fun P₁ P₂ => ?_
  refine .bind (hgens _ (fun z hz => by simp [hz]) _ _ (by simp [hX])) fun gX₁ gX₂ => ?_
  refine .bind (wf_flagsProg (by simp) (by simp)) fun f₁ f₂ => ?_
  refine .bind (wf_stabInPProg (by simp)) fun L₁ L₂ => ?_
  refine .bind (wf_preProg (by simp [hn]) (by simp [hG]) (by simp)) fun H₁ H₂ => ?_
  refine .bind (wf_mapList (by simp [hYs]) fun Γ' hΓ' Y₁ Y₂ hY => ?_) fun as₁ as₂ => ?_
  · refine wf_alignCall (hsub.mono (List.Subset.trans (fun z hz => by simp [hz]) hΓ'))
      (fun Γ'' h'' => hiso Γ'' (List.Subset.trans (fun z hz => by simp [hz])
        (List.Subset.trans hΓ' h''))) (hΓ' (by simp [hn])) (hΓ' (by simp [hxy]))
      (hΓ' (by simp [hw])) (hΓ' (by simp [hG])) (hΓ' (by simp)) (hΓ' (by simp))
      (hΓ' (by simp)) (hΓ' (by simp [hX])) hY
  · exact wf_combineProg (by simp) (by simp)

end Wf

end GraphIso.Align
