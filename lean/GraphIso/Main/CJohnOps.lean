section Wf

open Cost Programs

variable {S : Signature} {rec : Ty × Ty} {var₁ var₂ : Ty → Type} {r : Bool}
  {Γ : WfCtx var₁ var₂}

theorem wf_cjColEqProg {qA₁ : var₁ (.array .nat)} {qA₂ : var₂ (.array .nat)}
    {p₁ : var₁ (.prod .nat .nat)} {p₂ : var₂ (.prod .nat .nat)}
    (hq : ⟨.array .nat, qA₁, qA₂⟩ ∈ Γ) (hp : ⟨.prod .nat .nat, p₁, p₂⟩ ∈ Γ) :
    Prog.Wf (S := S) (rec := rec) r Γ (cjColEqProg qA₁ p₁) (cjColEqProg qA₂ p₂) := by
  unfold cjColEqProg
  prog_wf

theorem wf_cjohnGensProg {m₁ : var₁ .nat} {m₂ : var₂ .nat} {e₁ : var₁ cjTy} {e₂ : var₂ cjTy}
    (hm : ⟨.nat, m₁, m₂⟩ ∈ Γ) (he : ⟨cjTy, e₁, e₂⟩ ∈ Γ) :
    Prog.Wf (S := S) (rec := rec) r Γ (cjohnGensProg m₁ e₁) (cjohnGensProg m₂ e₂) := by
  unfold cjohnGensProg
  refine .bind (.prim _ (.cons he .nil)) fun _ _ => .bind (.prim _ (.cons (by simp [he]) .nil))
    fun _ _ => .bind (.prim _ (.cons (by simp) .nil)) fun _ _ =>
    .bind (.prim _ (.cons (by simp) .nil)) fun _ _ =>
    .bind (.prim _ (.cons List.mem_cons_self .nil)) fun _ _ =>
    .bind (.prim _ (.cons (by simp) .nil)) fun _ _ =>
    .bind (.prim _ (.cons List.mem_cons_self .nil)) fun _ _ =>
    .bind (.prim _ (.cons (by simp) .nil)) fun _ _ =>
    .bind (.prim _ (.cons (by simp) .nil)) fun _ _ =>
    .bind (wf_joFlatMap (by simp) fun Γ' hΓ c₁ c₂ hcc => ?_) fun _ _ =>
    .bind (wf_jrestProg (by simp [hm]) (by simp) (by simp) (by simp)) fun _ _ =>
    .bind (wf_pairsProg List.mem_cons_self) fun _ _ =>
    .bind (Toolkit.wf_filterList List.mem_cons_self fun Γ' hΓ p₁ p₂ hp =>
      wf_cjColEqProg (hΓ (by simp)) hp) fun _ _ =>
    .bind (wf_swapsProg (by simp [hm]) List.mem_cons_self) fun _ _ =>
    .bind (.prim _ (.cons (by simp) .nil)) fun _ _ =>
    .bind (wf_joFlatMap List.mem_cons_self fun Γ' hΓ i₁ i₂ hi => ?_) fun _ _ => ?_
  · unfold cellGensRowProg
    exact .bind (wf_pairsProg hcc) fun _ _ =>
      wf_swapsProg (by simp [hΓ (show ⟨.nat, m₁, m₂⟩ ∈ _ by simp [hm])]) List.mem_cons_self
  · exact wf_swapRowProg (hΓ (by simp [hm])) (hΓ (by simp)) (hΓ (by simp)) (hΓ (by simp))
      (hΓ (by simp)) hi
  · prog_wf

theorem wf_crestProg {qA₁ : var₁ (.array .nat)} {qA₂ : var₂ (.array .nat)}
    {R₁ : var₁ (.list .nat)} {R₂ : var₂ (.list .nat)}
    (hq : ⟨.array .nat, qA₁, qA₂⟩ ∈ Γ) (hR : ⟨.list .nat, R₁, R₂⟩ ∈ Γ) :
    Prog.Wf (S := S) (rec := rec) r Γ (crestProg qA₁ R₁) (crestProg qA₂ R₂) := by
  unfold crestProg
  refine .bind (wf_mapList hR fun Γ' hΓ u₁ u₂ hu => ?_) fun _ _ =>
    .bind (Coherent.wf_sortProg Coherent.wfCmp_cmpN List.mem_cons_self) fun _ _ =>
    wf_mapList List.mem_cons_self fun Γ' _ l₁ l₂ hl => ?_
  · have hq' := hΓ hq
    unfold ckeyProg
    prog_wf
  · unfold second
    prog_wf

theorem wf_ccolsProg {qA₁ : var₁ (.array .nat)} {qA₂ : var₂ (.array .nat)}
    {R₁ : var₁ (.list .nat)} {R₂ : var₂ (.list .nat)}
    (hq : ⟨.array .nat, qA₁, qA₂⟩ ∈ Γ) (hR : ⟨.list .nat, R₁, R₂⟩ ∈ Γ) :
    Prog.Wf (S := S) (rec := rec) r Γ (ccolsProg qA₁ R₁) (ccolsProg qA₂ R₂) := by
  unfold ccolsProg
  exact .bind (wf_mapList hR fun Γ' hΓ u₁ u₂ hu => .prim _ (.cons (hΓ hq) (.cons hu .nil)))
    fun _ _ => Coherent.wf_sortProg Coherent.wfCmp_cmpNat List.mem_cons_self

theorem cj_wf_listEqProg {l₁ l'₁ : var₁ (.list .nat)} {l₂ l'₂ : var₂ (.list .nat)}
    (hl : ⟨.list .nat, l₁, l₂⟩ ∈ Γ) (hl' : ⟨.list .nat, l'₁, l'₂⟩ ∈ Γ) :
    Prog.Wf (S := S) (rec := rec) r Γ (listEqProg l₁ l'₁) (listEqProg l₂ l'₂) := by
  unfold listEqProg
  exact .bind (Coherent.wf_lexCmpProg Coherent.wfCmp_cmpNat hl hl') fun _ _ =>
    .bind (.prim _ .nil) fun _ _ => .prim _ (.cons (by simp) (.cons List.mem_cons_self .nil))

theorem wf_cjohnIsoProg {m₁ : var₁ .nat} {m₂ : var₂ .nat} {e₁ e'₁ : var₁ cjTy}
    {e₂ e'₂ : var₂ cjTy} (hm : ⟨.nat, m₁, m₂⟩ ∈ Γ) (he : ⟨cjTy, e₁, e₂⟩ ∈ Γ)
    (he' : ⟨cjTy, e'₁, e'₂⟩ ∈ Γ) :
    Prog.Wf (S := S) (rec := rec) r Γ (cjohnIsoProg m₁ e₁ e'₁) (cjohnIsoProg m₂ e₂ e'₂) := by
  unfold cjohnIsoProg
  refine .bind (.prim _ (.cons he .nil)) fun _ _ => .bind (.prim _ (.cons (by simp [he]) .nil))
    fun _ _ => .bind (.prim _ (.cons (by simp [he']) .nil)) fun _ _ =>
    .bind (.prim _ (.cons (by simp [he']) .nil)) fun _ _ =>
    .bind (.prim _ (.cons (by simp) .nil)) fun _ _ =>
    .bind (.prim _ (.cons (by simp) .nil)) fun _ _ =>
    .bind (.prim _ (.cons List.mem_cons_self .nil)) fun _ _ =>
    .bind (.prim _ (.cons (by simp) .nil)) fun _ _ =>
    .bind (.prim _ (.cons List.mem_cons_self .nil)) fun _ _ =>
    .bind (.prim _ (.cons (by simp) .nil)) fun _ _ =>
    .bind (.prim _ (.cons (by simp) .nil)) fun _ _ =>
    .bind (.prim _ (.cons (by simp) .nil)) fun _ _ =>
    .bind (.prim _ (.cons (by simp) .nil)) fun _ _ =>
    .bind (.prim _ (.cons (by simp) .nil)) fun _ _ =>
    .bind (.prim _ (.cons List.mem_cons_self .nil)) fun _ _ =>
    .bind (.prim _ (.cons (by simp) .nil)) fun _ _ =>
    .bind (.prim _ (.cons List.mem_cons_self .nil)) fun _ _ =>
    .bind (.prim _ (.cons (by simp) .nil)) fun _ _ =>
    .bind (.prim _ (.cons (by simp) .nil)) fun _ _ =>
    .bind (.prim _ (.cons (by simp) .nil)) fun _ _ =>
    .bind (wf_jrestProg (by simp [hm]) (by simp) (by simp) (by simp)) fun _ _ =>
    .bind (wf_jrestProg (by simp [hm]) (by simp) (by simp) (by simp)) fun _ _ =>
    .bind (wf_profProg (by simp) (by simp) (by simp) (by simp) (by simp) (by simp) (by simp)
      List.mem_cons_self) fun _ _ =>
    .bind (wf_ccolsProg (by simp) (by simp)) fun _ _ =>
    .bind (wf_ccolsProg (by simp) (by simp)) fun _ _ =>
    .bind (cj_wf_listEqProg (by simp) List.mem_cons_self) fun _ _ =>
    .bind (.prim _ (.cons (by simp) (.cons List.mem_cons_self .nil))) fun _ _ =>
    .ite List.mem_cons_self (.bind (wf_crestProg (by simp) (by simp)) fun _ _ =>
      .bind (wf_crestProg (by simp) (by simp)) fun _ _ =>
      wf_isoBranchProg (by simp [hm]) (by simp) (by simp) (by simp)
        (by simp) (by simp) (by simp) (by simp) (by simp) (by simp) List.mem_cons_self)
      (.prim _ .nil)

end Wf

/-! ### Concrete checks (kernel `decide`)

Three points, no `V₀` and no cells, colours `0, 0, 1`: the stabilizer is generated by the two
transpositions of the points `0, 1` (one per order), and a recolouring `1, 0, 0` is isomorphic
while `1, 1, 0` is not. -/

example : (cjohnGensD 3 (([], ([], (0, #[]))), #[0, 0, 1])).length = 2 := by decide
example : (cjohnIsoD 3 (([], ([], (0, #[]))), #[0, 0, 1])
    (([], ([], (0, #[]))), #[1, 0, 0])).isSome = true := by decide
example : (cjohnIsoD 3 (([], ([], (0, #[]))), #[0, 0, 1])
    (([], ([], (0, #[]))), #[1, 1, 0])).isSome = false := by decide

