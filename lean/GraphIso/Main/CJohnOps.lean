module

public import GraphIso.Align.JohnOps
public import GraphIso.Case2b.OutOps
import all Mathlib.Data.List.Sort

/-!
# Coloured trimmed Johnson embeddings

Stage 14j-1, item 5 (`PLAN-14.md` §14.1): the trimmed Johnson embeddings of stages 14h and 14i
leave the points outside `V₀ ∪ ⋃Λ` free, so a base orbit outside `V₀` can be large and the
progress lemmas fail. Align therefore uses the pair of the embedding and a colouring of those
remaining points (the canonical coarse partition `Q`).

* **The structure** (`CJ`): a Johnson embedding with a colouring of the points; a permutation
  acts on both. Its stabilizer consists of the stabilizing permutations of the embedding that
  preserve the colours (`cj_smul_eq_iff`).
* **The stabilizer, abstractly** (`cj_closure_eq`): for disjoint cells and `f` injective into
  sets of cells, it is generated by transpositions inside a cell, transpositions of two
  remaining points of one colour, and, for every moved cell, a stabilizing element moving it the
  same way and fixing the other cells (stage 14f's `jo_closure_eq` with colours).
* **Data** (`CJData`, `cjdec`): the data of a trimmed Johnson embedding (stage 14f's `JData`)
  and an array of colours; the decoded colouring is `0` on `V₀ ∪ ⋃Λ` and `q u + 1` at a
  remaining point `u`, so only the colours of the remaining points matter. The invariant
  (`CJValid`) is stage 14f's `JValid` of the embedding.
* **The generators** (`cjohnGensD`, `cjohnGensD_closure`): those of stage 14f with the
  transpositions of the rest restricted to pairs of one colour.
* **The isomorphism search** (`cjohnIsoD`): stage 14f's profile, and the sorted colours of the
  rest (`ccolsD`); the rest is matched in the order of `(colour, point)` (`crestD`), so matched
  points have equal colours (`crmapD_col`). `cjohnIsoD_none`: an isomorphism forces the profiles
  to agree.
* `cjohnOps`, `cjohnOps_spec`: the `StructOps` instance and its specification;
  `length_cjohnGensD_le`: at most `3 m²` generators.
* **Programs** (no backend calls): `cjohnGensProg`, `cjohnIsoProg` with `RunsWithin` specs at
  the explicit polynomial costs `cjohnGensCost B`, `cjohnIsoCost B` for data bounded by `B ≥ m`
  (stage 14f's `JBound`), and well-formedness lemmas.
* Concrete kernel checks (`decide`) of the generators and the search on three points.
-/

@[expose] public section

namespace GraphIso.Main

open Equiv Finset Pointwise GraphIso GraphIso.SplitJohnson GraphIso.SoJProg GraphIso.SoJTree
  GraphIso.Align

/-! ### Coloured Johnson embeddings, abstractly -/

/-- A Johnson embedding with a colouring of the points. -/
structure CJ (Γ : Type*) where
  /-- The Johnson embedding. -/
  J : JEmb Γ
  /-- The colouring. -/
  col : Γ → ℕ

section Abstract

variable {Γ : Type*} [DecidableEq Γ]

instance : MulAction (Perm Γ) (CJ Γ) where
  smul σ c := ⟨σ • c.J, fun x => c.col (σ⁻¹ x)⟩
  one_smul c := by
    obtain ⟨J, col⟩ := c
    show CJ.mk _ _ = _
    simp only [one_smul, inv_one, Perm.coe_one, id_eq]
  mul_smul σ τ c := by
    obtain ⟨J, col⟩ := c
    show CJ.mk _ _ = CJ.mk _ _
    simp only [mul_smul, mul_inv_rev, Perm.coe_mul, Function.comp_apply]
    rfl

theorem cj_smul_J (σ : Perm Γ) (c : CJ Γ) : (σ • c).J = σ • c.J := rfl

theorem cj_smul_col (σ : Perm Γ) (c : CJ Γ) (x : Γ) : (σ • c).col x = c.col (σ⁻¹ x) := rfl

/-- **When a permutation carries one coloured embedding to another.** -/
theorem cj_smul_eq_iff' (σ : Perm Γ) (c c' : CJ Γ) :
    σ • c = c' ↔ σ • c.J = c'.J ∧ ∀ x, c'.col (σ x) = c.col x := by
  obtain ⟨J, col⟩ := c
  obtain ⟨J', col'⟩ := c'
  show CJ.mk _ _ = CJ.mk _ _ ↔ _
  simp only [CJ.mk.injEq]
  constructor
  · rintro ⟨h1, h2⟩
    refine ⟨h1, fun x => ?_⟩
    have := congrFun h2 (σ x)
    simp only [GraphIso.perm_inv_apply_self] at this
    exact this.symm
  · rintro ⟨h1, h2⟩
    refine ⟨h1, funext fun x => ?_⟩
    have := h2 (σ⁻¹ x)
    simp only [GraphIso.perm_apply_inv_self] at this
    exact this.symm

/-- The stabilizer conditions of a coloured embedding. -/
theorem cj_smul_eq_iff (σ : Perm Γ) (c : CJ Γ) :
    σ • c = c ↔ σ • c.J = c.J ∧ ∀ x, c.col (σ x) = c.col x :=
  cj_smul_eq_iff' σ c c

/-- The points outside `V₀ ∪ ⋃Λ`. -/
def RestPt (J : JEmb Γ) (x : Γ) : Prop := x ∉ J.V0 ∧ ∀ A ∈ J.Λ, x ∉ A

/-- A permutation carries the remaining points of an embedding to those of its image. -/
theorem restPt_smul (σ : Perm Γ) (J : JEmb Γ) (x : Γ) :
    RestPt (σ • J) (σ x) ↔ RestPt J x := by
  unfold RestPt
  rw [JEmb.smul_V0, JEmb.smul_Λ]
  have hV : σ x ∈ σ • J.V0 ↔ x ∈ J.V0 := smul_mem_smul_finset_iff σ
  constructor
  · rintro ⟨h1, h2⟩
    refine ⟨fun h => h1 (hV.2 h), fun A hA hxA => h2 (σ • A) (smul_mem_smul_finset hA) ?_⟩
    exact smul_mem_smul_finset hxA
  · rintro ⟨h1, h2⟩
    refine ⟨fun h => h1 (hV.1 h), fun A' hA' hxA' => ?_⟩
    obtain ⟨A, hA, rfl⟩ := mem_smul_finset.1 hA'
    exact h2 A hA ((smul_mem_smul_finset_iff σ).1 hxA')

variable [Fintype Γ]

/-- The base case: a stabilizing permutation fixing every cell is a product of swaps of the
generating set. -/
theorem cj_base {c : CJ Γ} (hJ : JHyp c.J) {S : Set (Perm Γ)}
    (hS : ∀ g ∈ S, g • c = c)
    (hcell : ∀ A ∈ c.J.Λ, ∀ a ∈ A, ∀ b ∈ A, a ≠ b → swap a b ∈ S)
    (hrest : ∀ a b : Γ, a ∉ c.J.V0 → (∀ A ∈ c.J.Λ, a ∉ A) → b ∉ c.J.V0 →
      (∀ A ∈ c.J.Λ, b ∉ A) → c.col a = c.col b → a ≠ b → swap a b ∈ S) :
    ∀ (n : ℕ) (σ : Perm Γ), σ.support.card = n → σ • c = c → (∀ A ∈ c.J.Λ, σ • A = A) →
      σ ∈ Subgroup.closure S := by
  intro n
  induction n using Nat.strong_induction_on with
  | _ n ih =>
  intro σ hn hσ hc
  obtain ⟨hσJ, hσcol⟩ := (cj_smul_eq_iff σ c).1 hσ
  by_cases h1 : σ = 1
  · rw [h1]; exact Subgroup.one_mem _
  obtain ⟨a, ha⟩ : ∃ a, σ a ≠ a := by
    by_contra hne
    push Not at hne
    exact h1 (Equiv.ext hne)
  have hV := jo_fix_V0 hJ hσJ hc
  have haV : a ∉ c.J.V0 := fun h => ha (hV a h)
  -- the swap lies in the generating set and fixes every cell
  have hsw : swap a (σ a) ∈ S ∧ ∀ A ∈ c.J.Λ, swap a (σ a) • A = A := by
    by_cases hA : ∃ A ∈ c.J.Λ, a ∈ A
    · obtain ⟨A, hA, haA⟩ := hA
      have hσa : σ a ∈ A := by
        rw [← hc A hA]
        exact smul_mem_smul_finset haA
      refine ⟨hcell A hA a haA (σ a) hσa ha.symm, fun C hC => ?_⟩
      by_cases hCA : C = A
      · subst hCA; exact jo_swap_smul_of_mem haA hσa
      · have hd := hJ.disj C hC A hA hCA
        exact jo_swap_smul_of_not_mem (fun h => disjoint_left.1 hd h haA)
          (fun h => disjoint_left.1 hd h hσa)
    · push Not at hA
      have hσaV : σ a ∉ c.J.V0 := fun h => ha (σ.injective (hV _ h))
      have hσaC : ∀ B ∈ c.J.Λ, σ a ∉ B := fun B hB h => by
        have : a ∈ σ⁻¹ • B := by
          rw [mem_smul_finset]
          exact ⟨σ a, h, by simp [Perm.smul_def]⟩
        have hinv : σ⁻¹ • B = B := by rw [inv_smul_eq_iff, hc B hB]
        exact hA B hB (hinv ▸ this)
      exact ⟨hrest a (σ a) haV hA hσaV hσaC (hσcol a).symm (Ne.symm ha), fun C hC =>
        jo_swap_smul_of_not_mem (hA C hC) (hσaC C hC)⟩
  have hτc : (swap a (σ a) * σ) • c = c := by rw [mul_smul, hσ, hS _ hsw.1]
  have hτA : ∀ A ∈ c.J.Λ, (swap a (σ a) * σ) • A = A := fun A hA => by
    rw [mul_smul, hc A hA, hsw.2 A hA]
  have hτ := ih _ (hn ▸ Equiv.Perm.card_support_swap_mul ha) _ rfl hτc hτA
  have : σ = swap a (σ a) * (swap a (σ a) * σ) := by
    rw [← mul_assoc, swap_mul_self, one_mul]
  rw [this]
  exact Subgroup.mul_mem _ (Subgroup.subset_closure hsw.1) hτ

/-- **The stabilizer of a coloured Johnson embedding is generated by** swaps inside cells, swaps
of two remaining points of one colour, and, for each moved cell, a stabilizing element moving it
the same way and fixing the other cells. -/
theorem cj_closure_eq {c : CJ Γ} (hJ : JHyp c.J) {S : Set (Perm Γ)}
    (hS : ∀ g ∈ S, g • c = c)
    (hcell : ∀ A ∈ c.J.Λ, ∀ a ∈ A, ∀ b ∈ A, a ≠ b → swap a b ∈ S)
    (hrest : ∀ a b : Γ, a ∉ c.J.V0 → (∀ A ∈ c.J.Λ, a ∉ A) → b ∉ c.J.V0 →
      (∀ A ∈ c.J.Λ, b ∉ A) → c.col a = c.col b → a ≠ b → swap a b ∈ S)
    (hmove : ∀ σ : Perm Γ, σ • c = c → ∀ A ∈ c.J.Λ, σ • A ≠ A →
      ∃ g ∈ S, g • A = σ • A ∧ ∀ C ∈ c.J.Λ, C ≠ A → C ≠ σ • A → g • C = C) :
    Subgroup.closure S = MulAction.stabilizer (Perm Γ) c := by
  apply le_antisymm
  · rw [Subgroup.closure_le]
    intro g hg
    exact MulAction.mem_stabilizer_iff.2 (hS g hg)
  · intro σ hσ
    rw [MulAction.mem_stabilizer_iff] at hσ
    suffices key : ∀ (n : ℕ) (σ : Perm Γ), (c.J.Λ.filter fun A => σ • A ≠ A).card ≤ n →
        σ • c = c → σ ∈ Subgroup.closure S from key _ σ le_rfl hσ
    intro n
    induction n with
    | zero =>
      intro σ hn hσ
      refine cj_base hJ hS hcell hrest _ σ rfl hσ fun A hA => ?_
      by_contra h
      have : A ∈ c.J.Λ.filter fun A => σ • A ≠ A := mem_filter.2 ⟨hA, h⟩
      have h0 : (c.J.Λ.filter fun A => σ • A ≠ A).card = 0 := by omega
      rw [card_eq_zero] at h0
      rw [h0] at this
      exact absurd this (Finset.notMem_empty _)
    | succ n ih =>
      intro σ hn hσ
      rcases Nat.lt_or_ge (c.J.Λ.filter fun A => σ • A ≠ A).card (n + 1) with hlt | hge
      · exact ih σ (by omega) hσ
      have hn' : (c.J.Λ.filter fun A => σ • A ≠ A).card = n + 1 := by omega
      obtain ⟨A, hA⟩ : (c.J.Λ.filter fun A => σ • A ≠ A).Nonempty := by
        rw [← card_pos, hn']; exact Nat.succ_pos n
      obtain ⟨hAΛ, hAm⟩ := mem_filter.1 hA
      obtain ⟨g, hgS, hgA, hgC⟩ := hmove σ hσ A hAΛ hAm
      have hgc := hS g hgS
      have hτc : (g⁻¹ * σ) • c = c := by
        rw [mul_smul, hσ, inv_smul_eq_iff, hgc]
      have hsub : (c.J.Λ.filter fun C => (g⁻¹ * σ) • C ≠ C) ⊆
          (c.J.Λ.filter fun C => σ • C ≠ C).erase A := by
        intro C hC
        obtain ⟨hCΛ, hCm⟩ := mem_filter.1 hC
        refine mem_erase.2 ⟨fun hCA => hCm ?_, mem_filter.2 ⟨hCΛ, fun hσC => hCm ?_⟩⟩
        · subst hCA
          rw [mul_smul, ← hgA, inv_smul_smul]
        · have hCA : C ≠ A := fun h => hAm (h ▸ hσC)
          have hCσA : C ≠ σ • A := fun h => by
            apply hCA
            have h2 : σ • C = σ • A := by rw [hσC, h]
            exact smul_left_cancel σ h2
          rw [mul_smul, hσC, inv_smul_eq_iff, hgC C hCΛ hCA hCσA]
      have hle : (c.J.Λ.filter fun C => (g⁻¹ * σ) • C ≠ C).card ≤ n := by
        have := card_le_card hsub
        rw [card_erase_of_mem hA, hn'] at this
        simpa using this
      have hτ := ih _ hle hτc
      have : σ = g * (g⁻¹ * σ) := by rw [mul_inv_cancel_left]
      rw [this]
      exact Subgroup.mul_mem _ (Subgroup.subset_closure hgS) hτ

end Abstract

/-! ### Data -/

/-- Data of a coloured trimmed Johnson embedding: stage 14f's data and an array of colours. -/
abbrev CJData := JData × Array ℕ

/-- The decoded colouring: `0` on `V₀ ∪ ⋃Λ`, and `q u + 1` at a remaining point `u`. -/
def cjcol (m : ℕ) (e : CJData) (x : Fin m) : ℕ :=
  if x.val ∈ jrest m e.1 then get e.2 x.val + 1 else 0

/-- The decoding of the data. -/
def cjdec (m : ℕ) (e : CJData) : CJ (Fin m) := ⟨jdec m e.1, cjcol m e⟩

/-- The invariant: that of stage 14f on the embedding (any colours). -/
abbrev CJValid (m : ℕ) (e : CJData) : Prop := JValid m e.1

section DataLemmas

variable {m : ℕ}

/-- The remaining points of the data are those of the decoded embedding. -/
theorem cj_mem_jrest_iff {d : JData} (x : Fin m) :
    x.val ∈ jrest m d ↔ RestPt (jdec m d) x := by
  rw [mem_jrest, RestPt, jdec_V0, mem_setOf]
  constructor
  · rintro ⟨-, hV, hc⟩
    refine ⟨hV, fun A hA hxA => ?_⟩
    rw [jdec_Λ, famOf_eq_image, Finset.mem_image] at hA
    obtain ⟨i, hi, rfl⟩ := hA
    rw [cellAt, mem_setOf] at hxA
    exact jcell_none.1 hc i (Finset.mem_range.1 hi) hxA
  · rintro ⟨hV, hc⟩
    refine ⟨x.2, hV, jcell_none.2 fun i hi hxi => ?_⟩
    refine hc (cellAt m d.2.1 i) ?_ (by rw [cellAt, mem_setOf]; exact hxi)
    rw [jdec_Λ, famOf_eq_image]
    exact Finset.mem_image.2 ⟨i, Finset.mem_range.2 hi, rfl⟩

/-- A permutation carrying one embedding to another carries their remaining points. -/
theorem cj_jrest_smul {d d' : JData} {σ : Perm (Fin m)} (h : σ • jdec m d = jdec m d')
    (x : Fin m) : (σ x).val ∈ jrest m d' ↔ x.val ∈ jrest m d := by
  rw [cj_mem_jrest_iff, cj_mem_jrest_iff, ← h, restPt_smul]

/-- A permutation carrying the embeddings and the colours of the remaining points carries the
coloured embeddings. -/
theorem cj_smul_of {e e' : CJData} {σ : Perm (Fin m)} (hJ : σ • jdec m e.1 = jdec m e'.1)
    (hq : ∀ x : Fin m, x.val ∈ jrest m e.1 → get e'.2 (σ x).val = get e.2 x.val) :
    σ • cjdec m e = cjdec m e' := by
  rw [cj_smul_eq_iff']
  refine ⟨hJ, fun x => ?_⟩
  show cjcol m e' (σ x) = cjcol m e x
  unfold cjcol
  by_cases hx : x.val ∈ jrest m e.1
  · have h1 := (cj_jrest_smul hJ x).2 hx
    simp only [h1, hx, ↓reduceIte, hq x hx]
  · have h1 : (σ x).val ∉ jrest m e'.1 := fun h => hx ((cj_jrest_smul hJ x).1 h)
    simp only [h1, hx, ↓reduceIte]

/-- Conversely, the colours of matched remaining points agree. -/
theorem cj_col_of_smul {e e' : CJData} {σ : Perm (Fin m)} (h : σ • cjdec m e = cjdec m e')
    {x : Fin m} (hx : x.val ∈ jrest m e.1) : get e'.2 (σ x).val = get e.2 x.val := by
  obtain ⟨hJ, hc⟩ := (cj_smul_eq_iff' σ _ _).1 h
  have := hc x
  change cjcol m e' (σ x) = cjcol m e x at this
  unfold cjcol at this
  have h1 := (cj_jrest_smul hJ x).2 hx
  simp only [h1, hx, ↓reduceIte] at this
  omega

end DataLemmas

/-! ### The generators of the stabilizer -/

/-- The transpositions of two remaining points of one colour. -/
def cjRestPairs (m : ℕ) (e : CJData) : List (ℕ × ℕ) :=
  (pairsD (jrest m e.1)).filter fun p => get e.2 p.1 == get e.2 p.2

/-- **The generators of the stabilizer of a coloured trimmed Johnson embedding**: transpositions
inside cells, transpositions of two remaining points of one colour, and swaps of equal cells. -/
def cjohnGensD (m : ℕ) (e : CJData) : List PermData :=
  (e.1.2.1.flatMap fun c => (pairsD c).map fun p => swapPD m p.1 p.2) ++
  ((cjRestPairs m e).map fun p => swapPD m p.1 p.2) ++
  ((List.range e.1.2.1.length).flatMap fun i =>
    ((List.range e.1.2.1.length).filter fun j => i != j &&
        (e.1.2.1.getD i []).length == (e.1.2.1.getD j []).length).map fun j =>
      cellSwapPD m e.1 i j)

section Gens

variable {m : ℕ} {e : CJData}

theorem mem_cjRestPairs {a b : ℕ} : (a, b) ∈ cjRestPairs m e ↔
    (a, b) ∈ pairsD (jrest m e.1) ∧ get e.2 a = get e.2 b := by
  simp [cjRestPairs]

theorem mem_cjohnGensD {g : PermData} : g ∈ cjohnGensD m e ↔
    (∃ c ∈ e.1.2.1, ∃ a b, (a, b) ∈ pairsD c ∧ g = swapPD m a b) ∨
    (∃ a b, (a, b) ∈ pairsD (jrest m e.1) ∧ get e.2 a = get e.2 b ∧ g = swapPD m a b) ∨
    (∃ i < e.1.2.1.length, ∃ j < e.1.2.1.length, i ≠ j ∧
      (e.1.2.1.getD i []).length = (e.1.2.1.getD j []).length ∧ g = cellSwapPD m e.1 i j) := by
  simp only [cjohnGensD, List.mem_append, List.mem_flatMap, List.mem_map, List.mem_filter,
    List.mem_range, Bool.and_eq_true, bne_iff_ne, ne_eq, beq_iff_eq, Prod.exists]
  constructor
  · rintro ((⟨c, hc, a, b, hp, rfl⟩ | ⟨a, b, hp, rfl⟩) | ⟨i, hi, j, ⟨hj, hij, hs⟩, rfl⟩)
    · exact Or.inl ⟨c, hc, a, b, hp, rfl⟩
    · obtain ⟨hp, hq⟩ := mem_cjRestPairs.1 hp
      exact Or.inr (Or.inl ⟨a, b, hp, hq, rfl⟩)
    · exact Or.inr (Or.inr ⟨i, hi, j, hj, hij, hs, rfl⟩)
  · rintro (⟨c, hc, a, b, hp, rfl⟩ | ⟨a, b, hp, hq, rfl⟩ | ⟨i, hi, j, hj, hij, hs, rfl⟩)
    · exact Or.inl (Or.inl ⟨c, hc, a, b, hp, rfl⟩)
    · exact Or.inl (Or.inr ⟨a, b, mem_cjRestPairs.2 ⟨hp, hq⟩, rfl⟩)
    · exact Or.inr ⟨i, hi, j, ⟨hj, hij, hs⟩, rfl⟩

/-- The generators are among those of stage 14f. -/
theorem cjohnGensD_sub {g : PermData} (hg : g ∈ cjohnGensD m e) : g ∈ johnGensD m e.1 := by
  rw [mem_johnGensD]
  rcases mem_cjohnGensD.1 hg with ⟨c, hc, a, b, hp, rfl⟩ | ⟨a, b, hp, -, rfl⟩ |
      ⟨i, hi, j, hj, hij, hs, rfl⟩
  · exact Or.inl ⟨c, hc, a, b, hp, rfl⟩
  · exact Or.inr (Or.inl ⟨a, b, hp, rfl⟩)
  · exact Or.inr (Or.inr ⟨i, hi, j, hj, hij, hs, rfl⟩)

theorem cjohnGensD_valid (hv : CJValid m e) : ∀ g ∈ cjohnGensD m e, g.Valid m :=
  fun g hg => johnGensD_valid hv g (cjohnGensD_sub hg)

/-- Every generator stabilizes the coloured embedding. -/
theorem cjohnGensD_stab (hv : CJValid m e) :
    ∀ g ∈ cjohnGensD m e, PermData.denote m g • cjdec m e = cjdec m e := by
  intro g hg
  have hJ := johnGensD_stab hv g (cjohnGensD_sub hg)
  refine cj_smul_of hJ fun x hx => ?_
  obtain ⟨-, hxV, hxc⟩ := mem_jrest.1 hx
  rcases mem_cjohnGensD.1 hg with ⟨c, hc, a, b, hp, rfl⟩ | ⟨a, b, hp, hq, rfl⟩ |
      ⟨i, hi, j, hj, -, hs, rfl⟩
  · obtain ⟨ha, hb, -⟩ := mem_pairsD.1 hp
    have hal := hv.cell_lt c hc a ha
    have hbl := hv.cell_lt c hc b hb
    obtain ⟨l, hl, rfl⟩ := List.getElem_of_mem hc
    have hnot : ∀ y ∈ e.1.2.1[l], x.val ≠ y := fun y hy hxy => by
      refine jcell_none.1 hxc l hl ?_
      rw [List.getD_eq_getElem _ _ hl, hxy]
      exact hy
    rw [denote_swapPD hal hbl, swap_apply_of_ne_of_ne
      (fun h => hnot a ha (by rw [h])) (fun h => hnot b hb (by rw [h]))]
  · obtain ⟨ha, hb, -⟩ := mem_pairsD.1 hp
    have hal := (mem_jrest.1 ha).1
    have hbl := (mem_jrest.1 hb).1
    rw [denote_swapPD hal hbl, swap_apply_def]
    split_ifs with h1 h2
    · rw [h1]; exact hq.symm
    · rw [h2]; exact hq
    · rfl
  · have hh := cellSwap_hyp hv hi hj hs
    show get e.2 (PermData.denote m (jperm m e.1 e.1 _ _ id id) x).val = _
    rw [jperm_apply hh, jmap_rest _ _ _ hx]
    rfl

/-- **The generators generate the stabilizer.** -/
theorem cjohnGensD_closure (hv : CJValid m e) :
    Subgroup.closure {σ | ∃ g ∈ cjohnGensD m e, PermData.denote m g = σ} =
      MulAction.stabilizer (Perm (Fin m)) (cjdec m e) := by
  have hJ : JHyp (cjdec m e).J := jhyp_of_valid hv
  have hr : ∀ x : Fin m, x ∉ (jdec m e.1).V0 → (∀ A ∈ (jdec m e.1).Λ, x ∉ A) →
      x.val ∈ jrest m e.1 := fun x hxV hxc => (cj_mem_jrest_iff x).2 ⟨hxV, hxc⟩
  refine cj_closure_eq hJ ?_ ?_ ?_ ?_
  · rintro σ ⟨g, hg, rfl⟩
    exact cjohnGensD_stab hv g hg
  · intro A hA a ha b hb hab
    change A ∈ (jdec m e.1).Λ at hA
    rw [jdec_Λ, famOf_eq_image, Finset.mem_image] at hA
    obtain ⟨i, hi, rfl⟩ := hA
    rw [Finset.mem_range] at hi
    rw [cellAt, mem_setOf] at ha hb
    refine ⟨swapPD m a.val b.val, mem_cjohnGensD.2 (Or.inl ⟨_, getD_mem_cell hi, a.val, b.val,
      mem_pairsD.2 ⟨ha, hb, fun e => hab (Fin.ext e.symm)⟩, rfl⟩), denote_swapPD a.2 b.2⟩
  · intro a b haV hac hbV hbc hcol hab
    have hra := hr a haV hac
    have hrb := hr b hbV hbc
    have hq : get e.2 a.val = get e.2 b.val := by
      change cjcol m e a = cjcol m e b at hcol
      unfold cjcol at hcol
      simp only [hra, hrb, ↓reduceIte] at hcol
      omega
    refine ⟨swapPD m a.val b.val, mem_cjohnGensD.2 (Or.inr (Or.inl ⟨a.val, b.val,
      mem_pairsD.2 ⟨hra, hrb, fun e => hab (Fin.ext e.symm)⟩, hq, rfl⟩)),
      denote_swapPD a.2 b.2⟩
  · intro σ hσ A hA hσA
    have hσJ : σ • jdec m e.1 = jdec m e.1 := ((cj_smul_eq_iff σ _).1 hσ).1
    have hΛ := ((jo_smul_eq_iff σ _).1 hσJ).2.1
    change A ∈ (jdec m e.1).Λ at hA
    have hσAΛ : σ • A ∈ (jdec m e.1).Λ := by
      rw [← hΛ]; exact smul_mem_smul_finset hA
    rw [jdec_Λ, famOf_eq_image, Finset.mem_image] at hA hσAΛ
    obtain ⟨i, hi, rfl⟩ := hA
    obtain ⟨j, hj, hjA⟩ := hσAΛ
    rw [Finset.mem_range] at hi hj
    have hij : i ≠ j := fun h => hσA (by rw [← hjA, h])
    have hs : (e.1.2.1.getD i []).length = (e.1.2.1.getD j []).length := by
      have := card_smul_finset σ (cellAt m e.1.2.1 i)
      rw [← hjA, cellAt, cellAt,
        card_setOf (hv.cell_nodup _ (getD_mem_cell hj)) (hv.cell_lt _ (getD_mem_cell hj)),
        card_setOf (hv.cell_nodup _ (getD_mem_cell hi)) (hv.cell_lt _ (getD_mem_cell hi))]
        at this
      exact this.symm
    have hh := cellSwap_hyp hv hi hj hs
    refine ⟨_, ⟨cellSwapPD m e.1 i j, mem_cjohnGensD.2 (Or.inr (Or.inr ⟨i, hi, j, hj, hij, hs,
      rfl⟩)), rfl⟩, ?_, ?_⟩
    · rw [← hjA]
      show PermData.denote m (jperm m e.1 e.1 _ _ id id) • cellAt m e.1.2.1 i = _
      rw [jperm_cellAt hh hi]
      simp [jswap]
    · intro C hC hCA hCσ
      change C ∈ (jdec m e.1).Λ at hC
      rw [jdec_Λ, famOf_eq_image, Finset.mem_image] at hC
      obtain ⟨l, hl, rfl⟩ := hC
      rw [Finset.mem_range] at hl
      have hli : l ≠ i := fun h => hCA (by rw [h])
      have hlj : l ≠ j := fun h => hCσ (by rw [h, hjA])
      show PermData.denote m (jperm m e.1 e.1 _ _ id id) • cellAt m e.1.2.1 l = _
      rw [jperm_cellAt hh hl]
      simp [jswap, hli, hlj]

/-- **At most `3 m²` generators.** -/
theorem length_cjohnGensD_le (hv : CJValid m e) : (cjohnGensD m e).length ≤ 3 * (m * m) := by
  refine le_trans ?_ (Case2b.oo_length_johnGensD hv)
  simp only [cjohnGensD, johnGensD, List.length_append, List.length_map]
  have : (cjRestPairs m e).length ≤ (pairsD (jrest m e.1)).length := List.length_filter_le _ _
  omega

end Gens

/-! ### The isomorphism search -/

/-- The keys `[colour, point]` of the remaining points. -/
def ckeysD (m : ℕ) (e : CJData) : List (List ℕ) := (jrest m e.1).map fun u => [get e.2 u, u]

/-- The remaining points ordered by colour, then by point. -/
def crestD (m : ℕ) (e : CJData) : List ℕ :=
  ((ckeysD m e).insertionSort (· ≤ ·)).map fun l => l.getD 1 0

/-- The sorted colours of the remaining points. -/
def ccolsD (m : ℕ) (e : CJData) : List ℕ := ((jrest m e.1).map (get e.2)).insertionSort (· ≤ ·)

/-- The matching of the remaining points: the `r`-th in `(colour, point)` order goes to the
`r`-th of the other. -/
def crmapD (m : ℕ) (e e' : CJData) (u : ℕ) : ℕ := (crestD m e').getD ((crestD m e).idxOf u) 0

/-- The invariants compared by the search: stage 14f's profile and the sorted colours. -/
def cprofileD (m : ℕ) (e e' : CJData) : Bool :=
  profileD m e.1 e'.1 && ccolsD m e == ccolsD m e'

/-- **The isomorphism search.** -/
def cjohnIsoD (m : ℕ) (e e' : CJData) : Option PermData :=
  if cprofileD m e e' then
    some (jperm m e.1 e'.1 (piD e.1 e'.1) (piD e'.1 e.1) (crmapD m e e') (crmapD m e' e))
  else none

section Iso

variable {m : ℕ} {e e' : CJData}

theorem crestD_perm (m : ℕ) (e : CJData) : (crestD m e).Perm (jrest m e.1) := by
  have h1 := (List.perm_insertionSort (· ≤ ·) (ckeysD m e)).map fun l => l.getD 1 0
  have h2 : (ckeysD m e).map (fun l => l.getD 1 0) = jrest m e.1 := by
    rw [ckeysD, List.map_map]
    conv_rhs => rw [← List.map_id (jrest m e.1)]
    exact List.map_congr_left fun u _ => rfl
  rw [crestD]
  exact h2 ▸ h1

theorem mem_crestD {u : ℕ} : u ∈ crestD m e ↔ u ∈ jrest m e.1 := (crestD_perm m e).mem_iff

theorem crestD_nodup (m : ℕ) (e : CJData) : (crestD m e).Nodup :=
  (crestD_perm m e).nodup_iff.2 jrest_nodup

theorem length_crestD (m : ℕ) (e : CJData) : (crestD m e).length = (jrest m e.1).length :=
  (crestD_perm m e).length_eq

theorem length_ccolsD (m : ℕ) (e : CJData) : (ccolsD m e).length = (jrest m e.1).length := by
  rw [ccolsD, List.length_insertionSort, List.length_map]

/-- The colours of the remaining points in the order `crestD` are the sorted colours. -/
theorem crestD_cols (m : ℕ) (e : CJData) : (crestD m e).map (get e.2) = ccolsD m e := by
  set SK := (ckeysD m e).insertionSort (· ≤ ·)
  have hmem : ∀ x ∈ SK, ∃ u ∈ jrest m e.1, x = [get e.2 u, u] := by
    intro x hx
    obtain ⟨u, hu, rfl⟩ := List.mem_map.1 ((List.perm_insertionSort _ _).mem_iff.1 hx)
    exact ⟨u, hu, rfl⟩
  have h1 : (crestD m e).map (get e.2) = SK.map (fun l => l.getD 0 0) := by
    rw [crestD, List.map_map]
    refine List.map_congr_left fun x hx => ?_
    obtain ⟨u, -, rfl⟩ := hmem x hx
    rfl
  rw [h1, ccolsD]
  refine List.Perm.eq_of_pairwise (le := (· ≤ ·)) (fun a b _ _ h h' => Nat.le_antisymm h h')
    ((List.pairwise_insertionSort _ _).map _ fun a b h => getD_zero_mono h)
    (List.pairwise_insertionSort _ _) ?_
  refine (((List.perm_insertionSort _ _).map _).trans ?_).trans
    (List.perm_insertionSort _ _).symm
  rw [ckeysD, List.map_map]
  exact List.Perm.of_eq (List.map_congr_left fun u _ => rfl)

theorem crmapD_mem (hR : (crestD m e).length = (crestD m e').length) {u : ℕ}
    (hu : u ∈ crestD m e) : crmapD m e e' u ∈ crestD m e' := by
  have hr : (crestD m e).idxOf u < (crestD m e').length := by
    rw [← hR]; exact List.idxOf_lt_length_of_mem hu
  rw [crmapD, List.getD_eq_getElem _ _ hr]
  exact List.getElem_mem hr

theorem crmapD_inv (hR : (crestD m e).length = (crestD m e').length) {u : ℕ}
    (hu : u ∈ crestD m e) : crmapD m e' e (crmapD m e e' u) = u := by
  have hr' : (crestD m e).idxOf u < (crestD m e).length := List.idxOf_lt_length_of_mem hu
  have hr : (crestD m e).idxOf u < (crestD m e').length := by rw [← hR]; exact hr'
  have hp : crmapD m e e' u = (crestD m e')[(crestD m e).idxOf u] := by
    rw [crmapD, List.getD_eq_getElem _ _ hr]
  rw [crmapD, hp, (crestD_nodup m e').idxOf_getElem _ hr, List.getD_eq_getElem _ _ hr']
  exact List.getElem_idxOf hr'

/-- **Matched remaining points have equal colours.** -/
theorem crmapD_col (hc : ccolsD m e = ccolsD m e') {u : ℕ} (hu : u ∈ crestD m e) :
    get e'.2 (crmapD m e e' u) = get e.2 u := by
  have hR : (crestD m e).length = (crestD m e').length := by
    rw [length_crestD, length_crestD, ← length_ccolsD, ← length_ccolsD, hc]
  have hr' : (crestD m e).idxOf u < (crestD m e).length := List.idxOf_lt_length_of_mem hu
  have hr : (crestD m e).idxOf u < (crestD m e').length := by rw [← hR]; exact hr'
  have h1 := List.getElem_of_eq ((crestD_cols m e).trans (hc.trans (crestD_cols m e').symm))
    (i := (crestD m e).idxOf u) (by simpa using hr')
  simp only [List.getElem_map] at h1
  rw [crmapD, List.getD_eq_getElem _ _ hr, ← h1, List.getElem_idxOf hr']

theorem cprofileD_iff : cprofileD m e e' = true ↔ profileD m e.1 e'.1 = true ∧
    ccolsD m e = ccolsD m e' := by
  simp [cprofileD]

/-- A matching profile gives the hypotheses of stage 14f's general map. -/
theorem cjiso_hyp (hv : CJValid m e) (hv' : CJValid m e') (hp : cprofileD m e e' = true) :
    JMapHyp m e.1 e'.1 (piD e.1 e'.1) (piD e'.1 e.1) (crmapD m e e') (crmapD m e' e) := by
  obtain ⟨hp₁, hc⟩ := cprofileD_iff.1 hp
  have h := iso_hyp hv hv' hp₁
  have hR : (crestD m e).length = (crestD m e').length := by
    rw [length_crestD, length_crestD, ← length_ccolsD, ← length_ccolsD, hc]
  exact
  { v := hv
    v' := hv'
    s := h.s
    k := h.k
    π_lt := h.π_lt
    π'_lt := h.π'_lt
    π'π := h.π'π
    ππ' := h.ππ'
    size := h.size
    ρ_mem := fun u hu => mem_crestD.1 (crmapD_mem hR (mem_crestD.2 hu))
    ρ'_mem := fun u hu => mem_crestD.1 (crmapD_mem hR.symm (mem_crestD.2 hu))
    ρ'ρ := fun u hu => crmapD_inv hR (mem_crestD.2 hu)
    ρρ' := fun u hu => crmapD_inv hR.symm (mem_crestD.2 hu) }

theorem cjohnIsoD_some (hv : CJValid m e) (hv' : CJValid m e') {σ : PermData}
    (h : cjohnIsoD m e e' = some σ) :
    σ.Valid m ∧ PermData.denote m σ • cjdec m e = cjdec m e' := by
  unfold cjohnIsoD at h
  split_ifs at h with hp
  cases h
  have hh := cjiso_hyp hv hv' hp
  refine ⟨jperm_valid hh, cj_smul_of (jperm_smul hh) fun x hx => ?_⟩
  rw [jperm_apply hh, jmap_rest _ _ _ hx]
  exact crmapD_col (cprofileD_iff.1 hp).2 (mem_crestD.2 hx)

/-- The colours of the remaining points, as a multiset over the points. -/
theorem cj_cols_ms (e : CJData) :
    (((jrest m e.1).map (get e.2) : List ℕ) : Multiset ℕ) =
      (Finset.univ.filter fun x : Fin m => x.val ∈ jrest m e.1).val.map
        fun x => get e.2 x.val := by
  have hset : ((jrest m e.1 : List ℕ) : Multiset ℕ) =
      (Finset.univ.filter fun x : Fin m => x.val ∈ jrest m e.1).val.map Fin.val := by
    refine (Multiset.Nodup.ext (Multiset.coe_nodup.2 jrest_nodup) ?_).2 fun u => ?_
    · exact (Finset.nodup _).map Fin.val_injective
    · rw [Multiset.mem_coe, Multiset.mem_map]
      constructor
      · intro hu
        exact ⟨⟨u, (mem_jrest.1 hu).1⟩,
          Finset.mem_def.1 (Finset.mem_filter.2 ⟨Finset.mem_univ _, hu⟩), rfl⟩
      · rintro ⟨x, hx, rfl⟩
        exact (Finset.mem_filter.1 (Finset.mem_def.2 hx)).2
  rw [← Multiset.map_coe, hset, Multiset.map_map]
  rfl

/-- **An isomorphism has the same profile.** -/
theorem cprofileD_of_smul (hv : CJValid m e) (hv' : CJValid m e') {σ : Perm (Fin m)}
    (h : σ • cjdec m e = cjdec m e') : cprofileD m e e' = true := by
  have hJ : σ • jdec m e.1 = jdec m e'.1 := ((cj_smul_eq_iff' σ _ _).1 h).1
  refine cprofileD_iff.2 ⟨profileD_of_smul hv hv' hJ, ?_⟩
  have hset : (Finset.univ.filter fun x : Fin m => x.val ∈ jrest m e'.1) =
      (Finset.univ.filter fun x : Fin m => x.val ∈ jrest m e.1).map σ.toEmbedding := by
    ext y
    simp only [Finset.mem_filter, Finset.mem_univ, true_and, Finset.mem_map,
      Equiv.toEmbedding_apply]
    constructor
    · intro hy
      refine ⟨σ⁻¹ y, ?_, GraphIso.perm_apply_inv_self σ y⟩
      have := (cj_jrest_smul hJ (σ⁻¹ y)).1
      rw [GraphIso.perm_apply_inv_self] at this
      exact this hy
    · rintro ⟨x, hx, rfl⟩
      exact (cj_jrest_smul hJ x).2 hx
  have hms : (((jrest m e.1).map (get e.2) : List ℕ) : Multiset ℕ) =
      (((jrest m e'.1).map (get e'.2) : List ℕ) : Multiset ℕ) := by
    rw [cj_cols_ms, cj_cols_ms, hset, Finset.map_val, Multiset.map_map]
    refine Multiset.map_congr rfl fun x hx => ?_
    exact (cj_col_of_smul h (Finset.mem_filter.1 (Finset.mem_def.2 hx)).2).symm
  rw [Multiset.coe_eq_coe] at hms
  rw [ccolsD, ccolsD]
  exact List.Perm.eq_of_pairwise (le := (· ≤ ·)) (fun a b _ _ h h' => Nat.le_antisymm h h')
    (List.pairwise_insertionSort _ _) (List.pairwise_insertionSort _ _)
    ((List.perm_insertionSort _ _).trans (hms.trans (List.perm_insertionSort _ _).symm))

theorem cjohnIsoD_none (hv : CJValid m e) (hv' : CJValid m e') (h : cjohnIsoD m e e' = none) :
    ∀ σ : Perm (Fin m), σ • cjdec m e ≠ cjdec m e' := by
  intro σ hσ
  unfold cjohnIsoD at h
  rw [cprofileD_of_smul hv hv' hσ] at h
  simp at h

end Iso

/-! ### The operations -/

/-- **The operations on coloured trimmed Johnson embeddings.** -/
def cjohnOps (m : ℕ) : StructOps m CJData (CJ (Fin m)) := ⟨cjdec m, cjohnGensD m, cjohnIsoD m⟩

/-- **The operations meet Align's specification.** -/
theorem cjohnOps_spec (m : ℕ) : (cjohnOps m).Spec (CJValid m) where
  gens_valid _ hv := cjohnGensD_valid hv
  gens_closure _ hv := cjohnGensD_closure hv
  iso_some _ _ hv hv' _ h := cjohnIsoD_some hv hv' h
  iso_none _ _ hv hv' h := cjohnIsoD_none hv hv' h

/-! ### Programs -/

section Progs

open Cost Programs

variable {S : Signature} {rec : Ty × Ty} {var : Ty → Type}

/-- The type of the data of a coloured trimmed Johnson embedding. -/
abbrev cjTy : Ty := .prod jTy (.array .nat)

/-- The test that the two points of a pair have one colour. -/
def cjColEqProg (qA : var (.array .nat)) (p : var (.prod .nat .nat)) : Prog S rec var .bool :=
  .bind (.op1 .fst p) fun a => .bind (.op1 .snd p) fun b =>
  .bind (.op2 .arrayGet qA a) fun x => .bind (.op2 .arrayGet qA b) fun y => .op2 .natEq x y

/-- **The generators of the stabilizer** (`cjohnGensD`): stage 14f's `johnGensProg` with the
pairs of remaining points filtered by colour. -/
def cjohnGensProg (m : var .nat) (e : var cjTy) : Prog S rec var (.list Ty.perm) :=
  .bind (.op1 .fst e) fun d => .bind (.op1 .snd e) fun qA =>
  .bind (.op1 .fst d) fun V0 => .bind (.op1 .snd d) fun r => .bind (.op1 .fst r) fun cs =>
  .bind (.op1 .snd r) fun r₂ => .bind (.op1 .snd r₂) fun fA =>
  .bind (.op1 .arrayOfList cs) fun csA => .bind (.op1 .length cs) fun k =>
  .bind (joFlatMap cs fun c => cellGensRowProg m c) fun gA =>
  .bind (jrestProg m V0 csA k) fun R => .bind (pairsProg R) fun ps =>
  .bind (Toolkit.filterList ps fun p => cjColEqProg qA p) fun ps' =>
  .bind (swapsProg m ps') fun gB =>
  .bind (.op1 .range k) fun ks =>
  .bind (joFlatMap ks fun i => swapRowProg m V0 csA k fA i) fun gC =>
  .bind (.op2 .append gA gB) fun gAB => .op2 .append gAB gC

/-- The key `[colour, point]` of a remaining point. -/
def ckeyProg (qA : var (.array .nat)) (u : var .nat) : Prog S rec var (.list .nat) :=
  .bind (.op2 .arrayGet qA u) fun c => .bind (.op0 .nil) fun nl =>
  .bind (.op2 .cons u nl) fun t => .op2 .cons c t

/-- The remaining points ordered by colour, then by point (`crestD`). -/
def crestProg (qA : var (.array .nat)) (R : var (.list .nat)) : Prog S rec var (.list .nat) :=
  .bind (mapList R fun u => ckeyProg qA u) fun keys =>
  .bind (Coherent.sortProg (fun x y => Coherent.cmpNProg x y) keys) fun sk =>
  mapList sk fun l => second l

/-- The sorted colours of the remaining points (`ccolsD`). -/
def ccolsProg (qA : var (.array .nat)) (R : var (.list .nat)) : Prog S rec var (.list .nat) :=
  .bind (mapList R fun u => .op2 .arrayGet qA u) fun cl =>
  Coherent.sortProg (fun x y => Coherent.cmpNatProg x y) cl

/-- **The isomorphism search** (`cjohnIsoD`): stage 14f's `johnIsoProg` with the colour test
and the remaining points in `(colour, point)` order. -/
def cjohnIsoProg (m : var .nat) (e e' : var cjTy) : Prog S rec var (.option Ty.perm) :=
  .bind (.op1 .fst e) fun d => .bind (.op1 .snd e) fun qA =>
  .bind (.op1 .fst e') fun d' => .bind (.op1 .snd e') fun qA' =>
  .bind (.op1 .fst d) fun V0 => .bind (.op1 .snd d) fun r => .bind (.op1 .fst r) fun cs =>
  .bind (.op1 .snd r) fun r₂ => .bind (.op1 .fst r₂) fun sv => .bind (.op1 .snd r₂) fun fA =>
  .bind (.op1 .arrayOfList cs) fun csA => .bind (.op1 .length cs) fun k =>
  .bind (.op1 .fst d') fun V0' => .bind (.op1 .snd d') fun r' => .bind (.op1 .fst r') fun cs' =>
  .bind (.op1 .snd r') fun r₂' => .bind (.op1 .fst r₂') fun sv' =>
  .bind (.op1 .snd r₂') fun fA' =>
  .bind (.op1 .arrayOfList cs') fun cs'A => .bind (.op1 .length cs') fun k' =>
  .bind (jrestProg m V0 csA k) fun R => .bind (jrestProg m V0' cs'A k') fun R' =>
  .bind (profProg sv sv' k k' cs cs' R R') fun ok₁ =>
  .bind (ccolsProg qA R) fun C => .bind (ccolsProg qA' R') fun C' =>
  .bind (listEqProg C C') fun ok₂ => .bind (.op2 .and ok₁ ok₂) fun ok =>
  .ite ok (.bind (crestProg qA R) fun CR => .bind (crestProg qA' R') fun CR' =>
      isoBranchProg m V0 csA k fA V0' cs'A k' fA' CR CR') (.op0 .none)

end Progs

section ProgSpecs

open Cost Programs

variable {S : Signature} {a b : Ty} {X : Ctx S} {body : a.denote → Prog S (a, b) Ty.denote b}

theorem RunsWithin.cjColEqProg (q : Array ℕ) (p : ℕ × ℕ) :
    RunsWithin X body (Main.cjColEqProg q p) (get q p.1 == get q p.2) 5 := by
  unfold Main.cjColEqProg
  apply RunsWithin.mono
  case h =>
    run_step (RunsWithin.prim _ _)
    run_step (RunsWithin.prim _ _)
    run_step (RunsWithin.prim _ _)
    run_step (RunsWithin.prim _ _)
    refine (RunsWithin.prim _ _).of_eq ?_
    simp [Prim.eval, Ty.default, get]
  case hc =>
    simp [Prim.cost]

/-- **The cost of the generators**, for data bounded by `B ≥ m`. -/
def cjohnGensCost (B : ℕ) : ℕ := johnGensCost B + B * B * 9 + 5

theorem RunsWithin.cjohnGensProg {m B : ℕ} (hm : m ≤ B) (e : CJData) (hB : JBound B e.1) :
    RunsWithin X body (Main.cjohnGensProg m e) (cjohnGensD m e) (cjohnGensCost B) := by
  unfold Main.cjohnGensProg
  have hk := hB.k
  have hR : (jrest m e.1).length ≤ m := jrest_length_le m e.1
  have hA := RunsWithin.joFlatMap (X := X) (body := body) (a' := .list .nat) (b' := Ty.perm)
    (xs := e.1.2.1) (L := B * B)
    (f := fun c => Align.cellGensRowProg m c)
    (fun c hc => RunsWithin.cellGensRowProg hm c (hB.cell c hc))
    (fun c hc => by
      rw [List.length_map]
      exact (length_pairsD_le c).trans (Nat.mul_le_mul (hB.cell c hc) (hB.cell c hc)))
  have hC := RunsWithin.joFlatMap (X := X) (body := body) (a' := .nat) (b' := Ty.perm)
    (xs := List.range e.1.2.1.length) (L := B)
    (f := fun i => Align.swapRowProg m e.1.1 e.1.2.1.toArray e.1.2.1.length e.1.2.2.2 i)
    (fun i _ => RunsWithin.swapRowProg hm e.1 hB i)
    (fun i _ => by
      rw [List.length_map]
      exact (List.length_filter_le _ _).trans (by rw [List.length_range]; exact hk))
  have hlenA : (e.1.2.1.flatMap fun c => (pairsD c).map fun p => swapPD m p.1 p.2).length ≤
      B * (B * B) := by
    rw [List.length_flatMap]
    calc (e.1.2.1.map fun c => ((pairsD c).map fun p => swapPD m p.1 p.2).length).sum
        ≤ (e.1.2.1.map fun _ => B * B).sum := by
          apply List.sum_le_sum
          intro c hc
          rw [List.length_map]
          exact (length_pairsD_le c).trans (Nat.mul_le_mul (hB.cell c hc) (hB.cell c hc))
      _ = e.1.2.1.length * (B * B) := by simp
      _ ≤ B * (B * B) := Nat.mul_le_mul_right _ hk
  have hP : (pairsD (jrest m e.1)).length ≤ B * B :=
    (length_pairsD_le _).trans (Nat.mul_le_mul (hR.trans hm) (hR.trans hm))
  have hF : (cjRestPairs m e).length ≤ B * B :=
    (List.length_filter_le _ _).trans hP
  have hlenB : ((cjRestPairs m e).map fun p => swapPD m p.1 p.2).length ≤ B * B := by
    rw [List.length_map]; exact hF
  apply RunsWithin.mono
  case h =>
    run_step (RunsWithin.prim _ _)
    run_step (RunsWithin.prim _ _)
    run_step (RunsWithin.prim _ _)
    run_step (RunsWithin.prim _ _)
    run_step (RunsWithin.prim _ _)
    run_step (RunsWithin.prim _ _)
    run_step (RunsWithin.prim _ _)
    run_step (RunsWithin.prim _ _)
    run_step (RunsWithin.prim _ _)
    run_step hA
    run_step (RunsWithin.jrestProg m e.1 hB)
    run_step (RunsWithin.pairsProg _)
    run_step (Toolkit.RunsWithin.filterList (P := fun p : ℕ × ℕ => get e.2 p.1 == get e.2 p.2)
      fun p _ => RunsWithin.cjColEqProg e.2 p)
    run_step (RunsWithin.swapsProg m _)
    run_step (RunsWithin.prim _ _)
    run_step hC
    run_step (RunsWithin.prim_le rfl (show _ ≤ B * (B * B) + 1 by
      simp only [Prim.cost, Args.head]; exact Nat.add_le_add_right hlenA 1))
    exact RunsWithin.prim_le rfl (show _ ≤ B * (B * B) + B * B + 1 by
      simp only [Prim.cost, Args.head, Prim.eval, List.length_append]
      exact Nat.add_le_add_right (Nat.add_le_add hlenA hlenB) 1)
  case hc =>
    simp only [Prim.cost, Prim.eval, Args.head, List.length_range, cjohnGensCost, johnGensCost]
    have e1 : m * (3 * B + B * (3 * B + 8) + 13) ≤ B * (3 * B + B * (3 * B + 8) + 13) :=
      Nat.mul_le_mul_right _ hm
    have e2 : (jrest m e.1).length * ((jrest m e.1).length * 11 + 13) ≤ B * (B * 11 + 13) :=
      Nat.mul_le_mul (hR.trans hm) (by have := hR.trans hm; omega)
    have e3 : (List.filter (fun p : ℕ × ℕ => get e.2 p.1 == get e.2 p.2)
        (pairsD (jrest m e.1))).length * (m * 23 + 15) ≤ B * B * (B * 23 + 15) :=
      Nat.mul_le_mul hF (by omega)
    clear hA hC hlenB hF
    generalize (List.filter (fun p : ℕ × ℕ => get e.2 p.1 == get e.2 p.2)
      (pairsD (jrest m e.1))).length = F at e3 ⊢
    have e4 : e.1.2.1.length * (rowACost B + B * B + 6) ≤ B * (rowACost B + B * B + 6) :=
      Nat.mul_le_mul_right _ hk
    have e5 : e.1.2.1.length * (rowCCost B + B + 6) ≤ B * (rowCCost B + B + 6) :=
      Nat.mul_le_mul_right _ hk
    have e6 : (pairsD (jrest m e.1)).length * (5 + 4) ≤ B * B * 9 := Nat.mul_le_mul hP le_rfl
    generalize rowACost B = RA at *
    generalize rowCCost B = RC at *
    generalize (pairsD (jrest m e.1)).length = P at *
    generalize (jrest m e.1).length = r at *
    generalize e.1.2.1.length = k at *
    generalize (List.flatMap (fun c => List.map (fun p => swapPD m p.1 p.2) (pairsD c))
      e.1.2.1).length = A at *
    clear hB
    linarith

theorem RunsWithin.ckeyProg (q : Array ℕ) (u : ℕ) :
    RunsWithin X body (Main.ckeyProg q u) [get q u, u] 4 := by
  unfold Main.ckeyProg
  apply RunsWithin.mono
  case h =>
    run_step (RunsWithin.prim _ _)
    run_step (RunsWithin.prim _ _)
    run_step (RunsWithin.prim _ _)
    refine (RunsWithin.prim _ _).of_eq ?_
    simp [Prim.eval, Ty.default, get]
  case hc =>
    simp [Prim.cost]

/-- The cost of `crestProg` for at most `B` remaining points. -/
def crestCost (B : ℕ) : ℕ := B * (B * 48 + 24) + 6

theorem RunsWithin.crestProg {m B : ℕ} (hm : m ≤ B) (e : CJData) :
    RunsWithin X body (Main.crestProg e.2 (jrest m e.1)) (crestD m e) (crestCost B) := by
  unfold Main.crestProg
  have hn := (jrest_length_le m e.1).trans hm
  apply RunsWithin.mono
  case h =>
    run_step (RunsWithin.mapList_le fun u _ => RunsWithin.ckeyProg e.2 u)
    run_step (Coherent.RunsWithin.sortProg (t := .list .nat) (e := Coherent.ord3)
      (fun _ _ => rfl) (ce := 36) fun x hx y => (Coherent.RunsWithin.cmpNProg x y).mono (by
        obtain ⟨u, _, rfl⟩ := List.mem_map.1 hx
        simp))
    exact (RunsWithin.mapList_le fun l _ => RunsWithin.second l).of_eq rfl
  case hc =>
    simp only [List.length_map, List.length_insertionSort, crestCost]
    nlinarith [Nat.mul_le_mul hn hn]

/-- The cost of `ccolsProg` for at most `B` remaining points. -/
def ccolsCost (B : ℕ) : ℕ := B * (B * 17 + 15) + 4

theorem RunsWithin.ccolsProg {m B : ℕ} (hm : m ≤ B) (e : CJData) :
    RunsWithin X body (Main.ccolsProg e.2 (jrest m e.1)) (ccolsD m e) (ccolsCost B) := by
  unfold Main.ccolsProg
  have hn := (jrest_length_le m e.1).trans hm
  refine RunsWithin.bind_le (RunsWithin.mapList_le (F := get e.2) (c := 1) fun u _ =>
    RunsWithin.prim_le (by simp [Prim.eval, Ty.default, get]) (by simp [Prim.cost]))
    (Coherent.RunsWithin.sortProg (t := .nat) (e := Coherent.ord3) (fun _ _ => rfl) (ce := 5)
      fun x _ y => Coherent.RunsWithin.cmpNatProg x y) ?_
  simp only [List.length_map, ccolsCost]
  nlinarith [Nat.mul_le_mul hn hn]

theorem crestD_length_le (m : ℕ) (e : CJData) : (crestD m e).length ≤ m := by
  rw [length_crestD]; exact jrest_length_le m e.1

theorem RunsWithin.cjBranchProg {m B : ℕ} (hm : m ≤ B) (e e' : CJData) (hB : JBound B e.1)
    (hB' : JBound B e'.1) :
    RunsWithin X body (Align.isoBranchProg m e.1.1 e.1.2.1.toArray e.1.2.1.length e.1.2.2.2
      e'.1.1 e'.1.2.1.toArray e'.1.2.1.length e'.1.2.2.2 (crestD m e) (crestD m e'))
      (some (jperm m e.1 e'.1 (piD e.1 e'.1) (piD e'.1 e.1) (crmapD m e e') (crmapD m e' e)))
      (branchCost B) := by
  unfold Align.isoBranchProg
  have hk := hB.k
  have hk' := hB'.k
  have hR := crestD_length_le m e
  have hR' := crestD_length_le m e'
  have hord := ordCost_mono (B := B) hk
  have hord' := ordCost_mono (B := B) hk'
  have hπ : ∀ i, RunsWithin X body (Align.joMatchProg (ordD e.1) (ordD e'.1).toArray i)
      (piD e.1 e'.1 i) (B * 15 + 7) := fun i =>
    (RunsWithin.joMatchProg (ordD e.1) (ordD e'.1) i).mono (by rw [length_ordD]; omega)
  have hπ' : ∀ i, RunsWithin X body (Align.joMatchProg (ordD e'.1) (ordD e.1).toArray i)
      (piD e'.1 e.1 i) (B * 15 + 7) := fun i =>
    (RunsWithin.joMatchProg (ordD e'.1) (ordD e.1) i).mono (by rw [length_ordD]; omega)
  have hρ : ∀ u, RunsWithin X body (Align.joMatchProg (crestD m e) (crestD m e').toArray u)
      (crmapD m e e' u) (B * 15 + 7) := fun u =>
    (RunsWithin.joMatchProg (crestD m e) (crestD m e') u).mono (by omega)
  have hρ' : ∀ u, RunsWithin X body (Align.joMatchProg (crestD m e') (crestD m e).toArray u)
      (crmapD m e' e u) (B * 15 + 7) := fun u =>
    (RunsWithin.joMatchProg (crestD m e') (crestD m e) u).mono (by omega)
  have hperm := (RunsWithin.jpermProg (X := X) (body := body) m e.1 e'.1 hπ hπ' hρ hρ' hB
    hB').mono (Nat.add_le_add_right (Nat.mul_le_mul_right
      (2 * jmapCost B (B * 15 + 7) (B * 15 + 7) + 9) hm) 10)
  apply RunsWithin.mono
  case h =>
    run_step (RunsWithin.ordProg e.1 hB)
    run_step (RunsWithin.ordProg e'.1 hB')
    run_step (RunsWithin.prim _ _)
    run_step (RunsWithin.prim _ _)
    run_step (RunsWithin.prim _ _)
    run_step (RunsWithin.prim _ _)
    run_step hperm
    exact RunsWithin.prim _ _
  case hc =>
    simp only [Prim.cost, Args.head, length_ordD, branchCost]
    omega

end ProgSpecs

section ProgIsoMain

open Cost Programs

variable {S : Signature} {a b : Ty} {X : Ctx S} {body : a.denote → Prog S (a, b) Ty.denote b}

/-- **The cost of the isomorphism search**, for data bounded by `B ≥ m`. -/
def cjohnIsoCost (B : ℕ) : ℕ :=
  johnIsoCost B + 2 * ccolsCost B + 2 * crestCost B + 14 * B + 20

theorem RunsWithin.cjohnIsoProg {m B : ℕ} (hm : m ≤ B) (e e' : CJData) (hB : JBound B e.1)
    (hB' : JBound B e'.1) :
    RunsWithin X body (Main.cjohnIsoProg m e e') (cjohnIsoD m e e') (cjohnIsoCost B) := by
  unfold Main.cjohnIsoProg
  have hk := hB.k
  have hk' := hB'.k
  have hjr := (RunsWithin.jrestProg (X := X) (body := body) m e.1 hB).mono
    (Nat.add_le_add_right (Nat.mul_le_mul_right (3 * B + B * (3 * B + 8) + 13) hm) 4)
  have hjr' := (RunsWithin.jrestProg (X := X) (body := body) m e'.1 hB').mono
    (Nat.add_le_add_right (Nat.mul_le_mul_right (3 * B + B * (3 * B + 8) + 13) hm) 4)
  have hleq := (RunsWithin.listEqProg (X := X) (body := body) (ccolsD m e) (ccolsD m e')).mono
    (show _ ≤ 14 * B + 10 by
      have := (jrest_length_le m e.1).trans hm
      rw [length_ccolsD]; omega)
  by_cases hp : cprofileD m e e' = true
  · have hv : cjohnIsoD m e e' =
        some (jperm m e.1 e'.1 (piD e.1 e'.1) (piD e'.1 e.1) (crmapD m e e') (crmapD m e' e)) := by
      simp [cjohnIsoD, hp]
    rw [hv]
    apply RunsWithin.mono
    case h =>
      run_step (RunsWithin.prim_le (c := 1) rfl (by simp [Prim.cost]))
      run_step (RunsWithin.prim_le (c := 1) rfl (by simp [Prim.cost]))
      run_step (RunsWithin.prim_le (c := 1) rfl (by simp [Prim.cost]))
      run_step (RunsWithin.prim_le (c := 1) rfl (by simp [Prim.cost]))
      run_step (RunsWithin.prim_le (c := 1) rfl (by simp [Prim.cost]))
      run_step (RunsWithin.prim_le (c := 1) rfl (by simp [Prim.cost]))
      run_step (RunsWithin.prim_le (c := 1) rfl (by simp [Prim.cost]))
      run_step (RunsWithin.prim_le (c := 1) rfl (by simp [Prim.cost]))
      run_step (RunsWithin.prim_le (c := 1) rfl (by simp [Prim.cost]))
      run_step (RunsWithin.prim_le (c := 1) rfl (by simp [Prim.cost]))
      run_step (RunsWithin.prim_le (c := B + 1) rfl (by simp [Prim.cost, Prim.eval]; omega))
      run_step (RunsWithin.prim_le (c := B + 1) rfl (by simp [Prim.cost, Prim.eval]; omega))
      run_step (RunsWithin.prim_le (c := 1) rfl (by simp [Prim.cost]))
      run_step (RunsWithin.prim_le (c := 1) rfl (by simp [Prim.cost]))
      run_step (RunsWithin.prim_le (c := 1) rfl (by simp [Prim.cost]))
      run_step (RunsWithin.prim_le (c := 1) rfl (by simp [Prim.cost]))
      run_step (RunsWithin.prim_le (c := 1) rfl (by simp [Prim.cost]))
      run_step (RunsWithin.prim_le (c := 1) rfl (by simp [Prim.cost]))
      run_step (RunsWithin.prim_le (c := B + 1) rfl (by simp [Prim.cost, Prim.eval]; omega))
      run_step (RunsWithin.prim_le (c := B + 1) rfl (by simp [Prim.cost, Prim.eval]; omega))
      run_step hjr
      run_step hjr'
      run_step (RunsWithin.profProg hm e.1 e'.1 hB hB')
      run_step (RunsWithin.ccolsProg hm e)
      run_step (RunsWithin.ccolsProg hm e')
      run_step hleq
      run_step (RunsWithin.prim_le (c := 1) rfl (by simp [Prim.cost]))
      run_with Sims.RunsWithin.ite_pos hp _
      run_step (RunsWithin.crestProg hm e)
      run_step (RunsWithin.crestProg hm e')
      exact RunsWithin.cjBranchProg hm e e' hB hB'
    case hc =>
      simp only [cjohnIsoCost, johnIsoCost]
      linarith
  · have hv : cjohnIsoD m e e' = none := by simp [cjohnIsoD, hp]
    rw [hv]
    apply RunsWithin.mono
    case h =>
      run_step (RunsWithin.prim_le (c := 1) rfl (by simp [Prim.cost]))
      run_step (RunsWithin.prim_le (c := 1) rfl (by simp [Prim.cost]))
