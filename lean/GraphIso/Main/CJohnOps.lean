      run_step (RunsWithin.prim_le (c := B + 1) rfl (by simp [Prim.cost, Prim.eval]; omega))
      run_step (RunsWithin.prim_le (c := B + 1) rfl (by simp [Prim.cost, Prim.eval]; omega))
      run_step hjr
      run_step hjr'
      run_step (RunsWithin.profProg hm e.1 e'.1 hB hB')
      run_step (RunsWithin.ccolsProg hm e)
      run_step (RunsWithin.ccolsProg hm e')
      run_step hleq
      run_step (RunsWithin.prim_le (c := 1) rfl (by simp [Prim.cost]))
