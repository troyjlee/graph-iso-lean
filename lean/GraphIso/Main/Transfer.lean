module

public import GraphIso.Main.Frame
public import GraphIso.Main.Derive
public import GraphIso.Reductions.RestrictionProg

/-!
# Answer transfer and the child instance

Stage 14j-2, items 1 and 2 (`PLAN-14.md` §14.2). A macro-step reduces the group `K` of a parent
instance (degree `N`, string positions `[0, n)`) to a **child group** `G'` of another degree
`N'` (a group re-based onto a new base), isomorphic to `K` by `θ : K ≃* G'` with the same
action on the string positions (the shape of `ChildOK.iso`). The window lies in `[0, n)`.

* **Semantics** (`tr_matches`, `tr_mem_iso`, `tr_iso_eq`, `tr_iso_eq_empty`): `g ∈ K` matches
  `x` to `y` on the window exactly when `θ g` matches the child strings, so the solutions of the
  parent are the `θ`-preimages of the child's, and a child answer `τ' • ⟨H'⟩` gives the parent
  answer `r • ⟨L⟩` for any `r ∈ K` with `θ r = τ'` and `L ⊆ K` with `θ L` generating `H'`.
* **`transferProg n σ K c'`**: restrict `τ'` and the generators of `H'` to `[0, n)` and `lift`
  them into `K` through the window `[0, n)` (the backend's `lift`); the lifts satisfy
  `θ r = τ'` because `G'` is faithful on `[0, n)` (`tr_eq_of_agree`). The group is generated by
  the backend at degree `N`, and the representative is multiplied by the parent's `σ`.
  `RunsWithin.transferProg`: a child `AnsOK` for the strings `x` and `y ∘ σ` on `[0, n)` gives
  the parent `AnsOK` for the coset `σ • K`.
* **The child instance** (`childHInst`, `childInstProg`): the strings `x` and `y ∘ σ` padded to
  degree `N'` (`padD`, `padCompD`; the alignment of the coset, `iso_eq_smul_iso_one`), the
  child window, the identity, the child group, `n₀`, `n` and the labels. `childHInst_valid`:
  it is a valid hinted instance under `ChildRel` (the facts `ChildOK` supplies, without the
  labels: `ChildOK.rel`) and `HintValid` plus transitivity for the labels.
* **`viaChildProg sub xy σ K n₀ n G' w' L'`**: build the child, call `sub`, and transfer back.
  `RunsWithin.viaChildProg`: under `HSubSolves X body DV sub P C s` and `P` of the child, an
  answer correct for the parent coset `(w', σ • K)` within
  `C |w'| (L'.map (N' − n)) + viaChildCost N N' n s Blift Bgen`. The charges of `lift` (on
  permutations of degree `n`) and of `generate` (on at most `s` generators inside `K`) are
  hypotheses.
* **Same degree, no hint** (`noHintHInst`, `sameDegProg`, `RunsWithin.sameDegProg`): a call of
  `sub` on the instance itself with the labels `none` (no transfer).
* Well-formedness: `wf_transferProg`, `wf_childInstProg`, `wf_viaChildProg`, `wf_sameDegProg`.
-/

@[expose] public section

namespace GraphIso.Main

open Equiv Pointwise Cost GraphIso GraphIso.Programs GraphIso.Toolkit

/-! ### Semantics of the transfer -/

section TransferSem

variable {N N' n : ℕ} {K : Subgroup (Perm (Fin N))} {G' : Subgroup (Perm (Fin N'))}

/-- Values below `n` agree. -/
theorem tr_agree {f : Fin N → ℕ} {f' : Fin N' → ℕ}
    (hf : ∀ j (hj : j < N) (hj' : j < N'), j < n → f' ⟨j, hj'⟩ = f ⟨j, hj⟩) {a : Fin N'}
    {b : Fin N} (hab : a.val = b.val) (hb : b.val < n) : f' a = f b := by
  obtain ⟨a, ha⟩ := a
  obtain ⟨b, hb'⟩ := b
  simp only at hab
  subst hab
  exact hf a hb' ha hb

/-- **Agreement on the string positions determines an element** of a group faithful there. -/
theorem tr_eq_of_agree
    (hf : ∀ g ∈ G', (∀ j : Fin N', j.val < n → g j = j) → g = 1) {g h : Perm (Fin N')}
    (hg : g ∈ G') (hh : h ∈ G') (hagree : ∀ j : Fin N', j.val < n → (g j).val = (h j).val) :
    g = h := by
  have h1 : g⁻¹ * h = 1 := by
    apply hf _ (mul_mem (inv_mem hg) hh)
    intro j hj
    have e : h j = g j := Fin.ext (hagree j hj).symm
    rw [Perm.mul_apply, e]
    simp
  rw [← mul_left_cancel_iff (a := g⁻¹), h1, inv_mul_cancel]

variable (θ : ↥K ≃* ↥G')

/-- **Matching transfers**: on a window of string positions, `g` matches `x` to `y` exactly when
`θ g` matches the child strings, which agree with `x` and `y` on `[0, n)`. -/
theorem tr_matches (hn : n ≤ N) (hn' : n ≤ N') (hK : IsInvariant K (strSet n N))
    (hθ : ∀ (g : ↥K) (j : ℕ) (hj : j < N) (hj' : j < N'), j < n →
      ((θ g : Perm (Fin N')) ⟨j, hj'⟩).val = (g.1 ⟨j, hj⟩).val)
    {pts : List ℕ} (hpts : ∀ i ∈ pts, i < n) {x y : Fin N → ℕ} {x' y' : Fin N' → ℕ}
    (hx : ∀ j (hj : j < N) (hj' : j < N'), j < n → x' ⟨j, hj'⟩ = x ⟨j, hj⟩)
    (hy : ∀ j (hj : j < N) (hj' : j < N'), j < n → y' ⟨j, hj'⟩ = y ⟨j, hj⟩) (g : ↥K) :
    Matches (ptsSet N pts) g.1 x y ↔ Matches (ptsSet N' pts) (θ g : Perm (Fin N')) x' y' := by
  have hgn : ∀ u : Fin N, u.val < n → (g.1 u).val < n := fun u hu => hK g.1 g.2 u hu
  constructor
  · intro h u hu
    have hun : u.val < n := hpts _ hu
    have hu0 : (⟨u.val, by omega⟩ : Fin N).val ∈ pts := hu
    have hm := h ⟨u.val, by omega⟩ hu0
    have hval : ((θ g : Perm (Fin N')) u).val = (g.1 ⟨u.val, by omega⟩).val := by
      have := hθ g u.val (by omega) u.2 hun
      simpa using this
    rw [tr_agree hx (b := ⟨u.val, by omega⟩) rfl hun, hm,
      tr_agree hy (b := g.1 ⟨u.val, by omega⟩) hval (hgn _ hun)]
  · intro h u hu
    have hun : u.val < n := hpts _ hu
    have hu' : u.val < N' := by omega
    have hm := h ⟨u.val, hu'⟩ hu
    have hval : ((θ g : Perm (Fin N')) ⟨u.val, hu'⟩).val = (g.1 u).val :=
      hθ g u.val u.2 hu' hun
    rw [← tr_agree hx (a := ⟨u.val, hu'⟩) rfl hun, hm,
      tr_agree hy (b := g.1 u) hval (hgn _ hun)]

variable {θ} (hn : n ≤ N) (hn' : n ≤ N') (hK : IsInvariant K (strSet n N))
  (hθ : ∀ (g : ↥K) (j : ℕ) (hj : j < N) (hj' : j < N'), j < n →
    ((θ g : Perm (Fin N')) ⟨j, hj'⟩).val = (g.1 ⟨j, hj⟩).val)
  {pts : List ℕ} (hpts : ∀ i ∈ pts, i < n) {x y : Fin N → ℕ} {x' y' : Fin N' → ℕ}
  (hx : ∀ j (hj : j < N) (hj' : j < N'), j < n → x' ⟨j, hj'⟩ = x ⟨j, hj⟩)
  (hy : ∀ j (hj : j < N) (hj' : j < N'), j < n → y' ⟨j, hj'⟩ = y ⟨j, hj⟩)
include hn hn' hK hθ hpts hx hy

/-- **The parent's solutions are the `θ`-preimages of the child's.** -/
theorem tr_mem_iso {g : Perm (Fin N)} :
    g ∈ iso (ptsSet N pts) 1 K x y ↔
      ∃ hg : g ∈ K, (θ ⟨g, hg⟩ : Perm (Fin N')) ∈ iso (ptsSet N' pts) 1 G' x' y' := by
  rw [mem_iso_one]
  constructor
  · rintro ⟨hg, hm⟩
    exact ⟨hg, mem_iso_one.2 ⟨(θ ⟨g, hg⟩).2,
      (tr_matches θ hn hn' hK hθ hpts hx hy ⟨g, hg⟩).1 hm⟩⟩
  · rintro ⟨hg, h⟩
    exact ⟨hg, (tr_matches θ hn hn' hK hθ hpts hx hy ⟨g, hg⟩).2 (mem_iso_one.1 h).2⟩

/-- No child solution, no parent solution. -/
theorem tr_iso_eq_empty (h : iso (ptsSet N' pts) 1 G' x' y' = ∅) :
    iso (ptsSet N pts) 1 K x y = ∅ := by
  ext g
  simp only [Set.mem_empty_iff_false, iff_false]
  intro hg
  obtain ⟨hgK, h'⟩ := (tr_mem_iso hn hn' hK hθ hpts hx hy).1 hg
  rw [h] at h'
  exact h'

/-- **Transferring a child answer**: `τ' • H'` becomes `r • ⟨L⟩` for `θ r = τ'` and `θ L`
generating `H'`. -/
theorem tr_iso_eq {τ' : Perm (Fin N')} {H' : Subgroup (Perm (Fin N'))}
    (h : iso (ptsSet N' pts) 1 G' x' y' = τ' • (H' : Set (Perm (Fin N'))))
    {r : Perm (Fin N)} (hr : r ∈ K) (hrτ : (θ ⟨r, hr⟩ : Perm (Fin N')) = τ')
    {L : Set (Perm (Fin N))} (hLK : L ⊆ K)
    (hL : Subgroup.closure
      {π | ∃ l, ∃ hl : l ∈ K, l ∈ L ∧ (θ ⟨l, hl⟩ : Perm (Fin N')) = π} = H') :
    iso (ptsSet N pts) 1 K x y = r • (Subgroup.closure L : Set (Perm (Fin N))) := by
  set φ : ↥K →* Perm (Fin N') := G'.subtype.comp θ.toMonoidHom with hφ
  have hφinj : Function.Injective φ := fun a b hab => θ.injective (Subtype.ext hab)
  set LK : Set ↥K := {g | (g : Perm (Fin N)) ∈ L}
  have himg : φ '' LK =
      {π | ∃ l, ∃ hl : l ∈ K, l ∈ L ∧ (θ ⟨l, hl⟩ : Perm (Fin N')) = π} := by
    ext π
    constructor
    · rintro ⟨g, hg, rfl⟩
      exact ⟨g, g.2, hg, rfl⟩
    · rintro ⟨l, hl, hlL, rfl⟩
      exact ⟨⟨l, hl⟩, hlL, rfl⟩
  have hH' : H' = (Subgroup.closure LK).map φ := by
    rw [MonoidHom.map_closure, himg, hL]
  have hsub : K.subtype '' LK = L := by
    ext g
    constructor
    · rintro ⟨g', hg', rfl⟩
      exact hg'
    · intro hg
      exact ⟨⟨g, hLK hg⟩, hg, rfl⟩
  have hS : (Subgroup.closure LK).map K.subtype = Subgroup.closure L := by
    rw [MonoidHom.map_closure, hsub]
  ext g
  rw [tr_mem_iso hn hn' hK hθ hpts hx hy, h]
  rw [mem_leftCoset_iff r, SetLike.mem_coe, ← hS]
  constructor
  · rintro ⟨hg, hgH⟩
    rw [mem_leftCoset_iff, SetLike.mem_coe] at hgH
    refine ⟨⟨r, hr⟩⁻¹ * ⟨g, hg⟩, ?_, rfl⟩
    rw [SetLike.mem_coe, ← Subgroup.mem_map_iff_mem hφinj, ← hH', map_mul, map_inv]
    have e1 : φ ⟨r, hr⟩ = τ' := hrτ
    have e2 : φ ⟨g, hg⟩ = (θ ⟨g, hg⟩ : Perm (Fin N')) := rfl
    rw [e1, e2]
    exact hgH
  · rintro ⟨g', hg', hgg'⟩
    have hgeq : g = r * (g' : Perm (Fin N)) := by
      rw [Subgroup.coe_subtype] at hgg'
      rw [hgg']
      group
    have hg : g ∈ K := by
      rw [hgeq]
      exact mul_mem hr g'.2
    refine ⟨hg, ?_⟩
    rw [mem_leftCoset_iff, SetLike.mem_coe]
    have he : (⟨r, hr⟩⁻¹ * ⟨g, hg⟩ : ↥K) = g' := Subtype.ext (by simp [hgeq])
    have hmem : φ g' ∈ H' := by
      rw [hH']
      exact Subgroup.mem_map_of_mem φ hg'
    rw [← he, map_mul, map_inv] at hmem
    have e1 : φ ⟨r, hr⟩ = τ' := hrτ
    rw [e1] at hmem
    exact hmem

end TransferSem

/-! ### The string positions as data -/

section StrData

/-- The positions of the string positions `[0, n)` in an array of size `M`. -/
def strPos (M n : ℕ) : Array ℕ := WinData.pos M (WinData.ofPoints M (List.range n))

/-- A permutation restricted to the string positions `[0, n)`. -/
def strRestrict (M n : ℕ) (g : PermData) : PermData :=
  PermData.restrictTo (strPos M n) (List.range n) g

/-- The window `[0, n)` at degree `M`. -/
abbrev strWin (M n : ℕ) : WinData := WinData.ofPoints M (List.range n)

theorem tr_getD_range {n j : ℕ} (hj : j < n) : (List.range n).getD j 0 = j := by
  rw [List.getD_eq_getElem?_getD, List.getElem?_range hj]
  rfl

theorem tr_strWin_valid {M n : ℕ} (hn : n ≤ M) : (strWin M n).Valid M :=
  WinData.valid_ofPoints List.nodup_range fun _ h => by
    have := List.mem_range.1 h
    omega

theorem tr_strWin_denote (M n : ℕ) : (strWin M n).denote M = strSet n M := by
  ext u
  simp [WinData.denote_ofPoints, strSet]

theorem tr_get_strPos {M n u : ℕ} (hn : n ≤ M) (hu : u < n) : get (strPos M n) u = u := by
  have h := WinData.get_pos (tr_strWin_valid hn) (j := u) (by simpa using hu)
  simp only [WinData.ofPoints_fst] at h
  rwa [tr_getD_range hu] at h

theorem tr_get_strRestrict {M n : ℕ} (hn : n ≤ M) {g : PermData}
    (hmaps : ∀ j < n, get g.1 j < n) {j : ℕ} (hj : j < n) :
    get (strRestrict M n g).1 j = get g.1 j := by
  simp only [strRestrict, PermData.restrictTo]
  rw [get_list_toArray _ _ _ (by simpa using hj), tr_getD_range hj,
    tr_get_strPos hn (hmaps j hj)]

theorem tr_maps_of_mem {M n : ℕ} (hn : n ≤ M) {G : Subgroup (Perm (Fin M))}
    (hG : IsInvariant G (strSet n M)) {g : PermData} (hg : g.Valid M)
    (hmem : PermData.denote M g ∈ G) : ∀ j < n, get g.1 j < n := by
  intro j hj
  have := hG _ hmem ⟨j, by omega⟩ (show j < n from hj)
  rwa [strSet, Set.mem_ofPred_eq, PermData.val_denote_apply hg] at this

theorem tr_valid_strRestrict {M n : ℕ} (hn : n ≤ M) {G : Subgroup (Perm (Fin M))}
    (hG : IsInvariant G (strSet n M)) {g : PermData} (hg : g.Valid M)
    (hmem : PermData.denote M g ∈ G) : (strRestrict M n g).Valid n := by
  have hv := PermData.valid_restrictTo (tr_strWin_valid hn) hg
    (PermData.mapsWindow_of_mem (by rw [tr_strWin_denote]; exact hG) (tr_strWin_valid hn) hg
      hmem)
  simpa [strRestrict, strPos] using hv

theorem tr_mapsWindowBy_iff {N n : ℕ} {r π' : PermData} (hπ : π'.Valid n) :
    MapsWindowBy (strWin N n) r π' ↔ ∀ j < n, get r.1 j = get π'.1 j := by
  simp only [MapsWindowBy, WinData.ofPoints_fst, List.length_range]
  constructor
  · intro h j hj
    have := h j hj
    rwa [tr_getD_range hj, tr_getD_range (hπ.fwd_lt j hj)] at this
  · intro h j hj
    rw [tr_getD_range hj, tr_getD_range (hπ.fwd_lt j hj)]
    exact h j hj

end StrData

/-! ### Lifts through the string positions -/

section Lifts

variable {N N' n : ℕ} {K : Subgroup (Perm (Fin N))} {G' : Subgroup (Perm (Fin N'))}
  {θ : ↥K ≃* ↥G'}

/-- **The lift of a restricted element is its `θ`-preimage.** -/
theorem tr_lift_eq (hn : n ≤ N) (hn' : n ≤ N') (hG' : IsInvariant G' (strSet n N'))
    (hf : ∀ g ∈ G', (∀ j : Fin N', j.val < n → g j = j) → g = 1)
    (hθ : ∀ (g : ↥K) (j : ℕ) (hj : j < N) (hj' : j < N'), j < n →
      ((θ g : Perm (Fin N')) ⟨j, hj'⟩).val = (g.1 ⟨j, hj⟩).val)
    {τ' : PermData} (hτ' : τ'.Valid N') (hτG : PermData.denote N' τ' ∈ G') {r : PermData}
    (hr : r.Valid N) (hrK : PermData.denote N r ∈ K)
    (hmw : MapsWindowBy (strWin N n) r (strRestrict N' n τ')) :
    (θ ⟨PermData.denote N r, hrK⟩ : Perm (Fin N')) = PermData.denote N' τ' := by
  have hmaps := tr_maps_of_mem hn' hG' hτ' hτG
  have hv := tr_valid_strRestrict hn' hG' hτ' hτG
  have hagr := (tr_mapsWindowBy_iff hv).1 hmw
  apply tr_eq_of_agree hf (θ _).2 hτG
  intro j hj
  rw [hθ _ j.val (by omega) j.2 hj, PermData.val_denote_apply hr, PermData.val_denote_apply hτ',
    hagr _ hj, tr_get_strRestrict hn' hmaps hj]

/-- **The precondition of `lift`**: the `θ`-preimage of `τ'` restricts to `τ'`. -/
theorem tr_lift_exists (hn' : n ≤ N') (hG' : IsInvariant G' (strSet n N'))
    (hθ : ∀ (g : ↥K) (j : ℕ) (hj : j < N) (hj' : j < N'), j < n →
      ((θ g : Perm (Fin N')) ⟨j, hj'⟩).val = (g.1 ⟨j, hj⟩).val) (hn : n ≤ N)
    {τ' : PermData} (hτ' : τ'.Valid N') (hτG : PermData.denote N' τ' ∈ G') :
    ∃ r, PermData.Valid N r ∧ PermData.denote N r ∈ K ∧
      MapsWindowBy (strWin N n) r (strRestrict N' n τ') := by
  have hmaps := tr_maps_of_mem hn' hG' hτ' hτG
  have hv := tr_valid_strRestrict hn' hG' hτ' hτG
  set g := θ.symm ⟨PermData.denote N' τ', hτG⟩
  refine ⟨PermData.ofPerm g.1, PermData.valid_ofPerm _, by rw [PermData.denote_ofPerm]; exact g.2,
    (tr_mapsWindowBy_iff hv).2 fun j hj => ?_⟩
  have h1 := hθ g j (by omega) (by omega) hj
  rw [show θ g = ⟨PermData.denote N' τ', hτG⟩ from θ.apply_symm_apply _] at h1
  rw [tr_get_strRestrict hn' hmaps hj, ← PermData.val_denote_apply (PermData.valid_ofPerm g.1)
    ⟨j, by omega⟩, PermData.denote_ofPerm, ← h1, PermData.val_denote_apply hτ']

end Lifts

/-! ### Programs -/

section Progs

variable {D : Ty} {S : Signature} {rec : Ty × Ty} {var : Ty → Type}

/-- Lift one child permutation to the parent: restrict it to the string positions (positions
`pos`) and `lift` it into `K` through the window `wn = [0, n)`. -/
def liftStrProg (K : var (Ty.group D)) (wn : var Ty.win) (pos : var (.array .nat))
    (pts : var (.list .nat)) (g : var Ty.perm) : Prog (groupSig D) rec var Ty.perm :=
  .bind (restrictPermProg pos pts g) fun g' => .bind (.op2 .pair wn g') fun wg =>
  .bind (.op2 .pair K wg) fun a => Prog.call (S := groupSig D) GroupOp.lift a

/-- **Transfer** a child coset `(τ', H')` of degree `N'` to the parent group `K`: lift `τ'` and
the generators of `H'` through the string positions `[0, n)`, generate at the parent's degree,
and multiply the representative by `σ`. -/
def transferProg (n : var .nat) (σ : var Ty.perm) (K : var (Ty.group D))
    (c' : var (Ty.coset D)) : Prog (groupSig D) rec var (Ty.answer D) :=
  .bind (.op1 .fst c') fun τ' => .bind (.op1 .snd c') fun H' =>
  .bind (.op1 .fst H') fun N' => .bind (.op1 .snd H') fun hd => .bind (.op1 .fst hd) fun hgs =>
  .bind (.op1 .fst K) fun N =>
  .bind (.op1 .range n) fun pts =>
  .bind (mkWindow N pts) fun wn =>
  .bind (posProg N' pts) fun pos =>
  .bind (liftStrProg K wn pos pts τ') fun τ =>
  .bind (mapList hgs fun h => liftStrProg K wn pos pts h) fun ls =>
  .bind (.op2 .pair N ls) fun arg =>
  .bind (Prog.call (S := groupSig D) GroupOp.generate arg) fun H =>
  .bind (permMul σ τ) fun στ => .bind (.op2 .pair στ H) fun c => .op1 .some c

/-- `x` padded to degree `N'`: `j ↦ x[j]`. -/
def padProg (N' : var .nat) (x : var Ty.str) : Prog S rec var Ty.str :=
  .bind (.op1 .range N') fun js => .bind (mapList js fun j => .op2 .arrayGet x j) fun l =>
  .op1 .arrayOfList l

/-- `y ∘ σ` padded to degree `N'`: `j ↦ y[σ[j]]`. -/
def padCompProg (N' : var .nat) (y : var Ty.str) (σ : var Ty.perm) : Prog S rec var Ty.str :=
  .bind (.op1 .fst σ) fun f => .bind (.op1 .range N') fun js =>
  .bind (mapList js fun j => .bind (.op2 .arrayGet f j) fun v => .op2 .arrayGet y v) fun l =>
  .op1 .arrayOfList l

/-- A hinted instance from an instance, `n₀`, `n` and the labels. -/
def mkHInstProg (I : var (Ty.inst D)) (n₀ n : var .nat)
    (L : var (.option (.array (.list .nat)))) : Prog S rec var (hinstTy D) :=
  .bind (.op2 .pair n L) fun nL => .bind (.op2 .pair n₀ nL) fun r => .op2 .pair I r

/-- **The child instance**: the strings `x` and `y ∘ σ` padded to the child's degree, the
child window, the identity, the child group, `n₀`, `n` and the labels. -/
def childInstProg (xy : var Ty.strs) (σ : var Ty.perm) (n₀ n : var .nat)
    (G' : var (Ty.group D)) (w' : var Ty.win) (L' : var (.option (.array (.list .nat)))) :
    Prog S rec var (hinstTy D) :=
  .bind (.op1 .fst xy) fun x => .bind (.op1 .snd xy) fun y => .bind (.op1 .fst G') fun N' =>
  .bind (padProg N' x) fun x' => .bind (padCompProg N' y σ) fun y' =>
  .bind (permOne N') fun one => .bind (.op2 .pair one G') fun c' =>
  .bind (.op2 .pair w' c') fun wc => .bind (.op2 .pair x' y') fun xy' =>
  .bind (.op2 .pair xy' wc) fun J => mkHInstProg J n₀ n L'

/-- **Solve a coset of `K` through a child group**: build the child instance, call `sub`, and
transfer the answer back. -/
def viaChildProg (sub : var (hinstTy D) → Prog (groupSig D) rec var (Ty.answer D))
    (xy : var Ty.strs) (σ : var Ty.perm) (K : var (Ty.group D)) (n₀ n : var .nat)
    (G' : var (Ty.group D)) (w' : var Ty.win) (L' : var (.option (.array (.list .nat)))) :
    Prog (groupSig D) rec var (Ty.answer D) :=
  .bind (childInstProg xy σ n₀ n G' w' L') fun J =>
  .bind (sub J) fun a =>
  .caseOption a (.op0 .none) fun c' => transferProg n σ K c'

/-- **Same degree, no hint**: call `sub` on the instance itself with the labels `none`. -/
def sameDegProg (sub : var (hinstTy D) → Prog S rec var (Ty.answer D)) (I : var (Ty.inst D))
    (n₀ n : var .nat) : Prog S rec var (Ty.answer D) :=
  .bind (.op0 .none) fun nl => .bind (mkHInstProg I n₀ n nl) fun J => sub J

end Progs

/-! ### Models -/

section Models

variable {D : Ty}

/-- The lift of a child permutation. -/
def liftStrD (Or : Oracle (groupSig D)) (K : GroupData D.denote) (n N' : ℕ) (g : PermData) :
    PermData :=
  Or.run GroupOp.lift (K, (strWin K.1 n, strRestrict N' n g))

/-- The value of `transferProg`. -/
def transferD (Or : Oracle (groupSig D)) (n : ℕ) (σ : PermData) (K : GroupData D.denote)
    (c' : CosetData D) : AnswerData D :=
  some (σ.mul (liftStrD Or K n c'.2.1 c'.1),
    Or.run GroupOp.generate (K.1, c'.2.2.1.map (liftStrD Or K n c'.2.1)))

/-- `x` padded to degree `N'`. -/
def padD (N' : ℕ) (x : StrData) : StrData := ((List.range N').map (get x)).toArray

/-- `y ∘ σ` padded to degree `N'`. -/
def padCompD (N' : ℕ) (y : StrData) (σ : PermData) : StrData :=
  ((List.range N').map fun j => get y (get σ.1 j)).toArray

/-- **The child instance** as a value. -/
def childHInst (x y : StrData) (σ : PermData) (n₀ n : ℕ) (G' : GroupData D.denote)
    (w' : WinData) (L' : Option LabelData) : HInstData D :=
  (((padD G'.1 x, padCompD G'.1 y σ), (w', (PermData.one G'.1, G'))), (n₀, (n, L')))

/-- An instance without a hint. -/
def noHintHInst (I : InstData D) (n₀ n : ℕ) : HInstData D := (I, (n₀, (n, none)))

/-- **The label invariant of a child instance** with labels `L'`, from `LabInvAt` on its base
(stage 14j-6a). -/
theorem childHInst_labInv {x y : StrData} {σd : PermData} {n₀ n : ℕ} {G' : GroupData D.denote}
    {w' : WinData} {L' : LabelData} (hn : n ≤ n₀) (hL : LabInvAt n₀ (G'.1 - n) (labLen L')) :
    LabInv (childHInst x y σd n₀ n G' w' (some L')) :=
  ⟨hn, fun _ h => Option.some.inj h ▸ hL⟩

@[simp] theorem childHInst_winSize (x y : StrData) (σ : PermData) (n₀ n : ℕ)
    (G' : GroupData D.denote) (w' : WinData) (L' : Option LabelData) :
    (childHInst x y σ n₀ n G' w' L').winSize = w'.1.length := rfl

@[simp] theorem childHInst_baseOpt (x y : StrData) (σ : PermData) (n₀ n : ℕ)
    (G' : GroupData D.denote) (w' : WinData) (L' : Option LabelData) :
    (childHInst x y σ n₀ n G' w' L').baseOpt = L'.map fun _ => G'.1 - n := rfl

@[simp] theorem childHInst_n₀ (x y : StrData) (σ : PermData) (n₀ n : ℕ)
    (G' : GroupData D.denote) (w' : WinData) (L' : Option LabelData) :
    (childHInst x y σ n₀ n G' w' L').n₀ = n₀ := rfl

@[simp] theorem childHInst_n (x y : StrData) (σ : PermData) (n₀ n : ℕ)
    (G' : GroupData D.denote) (w' : WinData) (L' : Option LabelData) :
    (childHInst x y σ n₀ n G' w' L').n = n := rfl

@[simp] theorem childHInst_lab (x y : StrData) (σ : PermData) (n₀ n : ℕ)
    (G' : GroupData D.denote) (w' : WinData) (L' : Option LabelData) :
    (childHInst x y σ n₀ n G' w' L').lab = L' := rfl

@[simp] theorem childHInst_degree (x y : StrData) (σ : PermData) (n₀ n : ℕ)
    (G' : GroupData D.denote) (w' : WinData) (L' : Option LabelData) :
    (childHInst x y σ n₀ n G' w' L').inst.degree = G'.1 := rfl

@[simp] theorem noHintHInst_winSize (I : InstData D) (n₀ n : ℕ) :
    (noHintHInst I n₀ n).winSize = I.2.1.1.length := rfl

@[simp] theorem noHintHInst_baseOpt (I : InstData D) (n₀ n : ℕ) :
    (noHintHInst I n₀ n).baseOpt = none := rfl

@[simp] theorem noHintHInst_n₀ (I : InstData D) (n₀ n : ℕ) : (noHintHInst I n₀ n).n₀ = n₀ := rfl

@[simp] theorem noHintHInst_n (I : InstData D) (n₀ n : ℕ) : (noHintHInst I n₀ n).n = n := rfl

@[simp] theorem noHintHInst_inst (I : InstData D) (n₀ n : ℕ) :
    (noHintHInst I n₀ n).inst = I := rfl

theorem get_padD {N' j : ℕ} (hj : j < N') (x : StrData) : get (padD N' x) j = get x j := by
  rw [padD, get_list_toArray _ _ _ (by simpa using hj), tr_getD_range hj]

theorem get_padCompD {N' j : ℕ} (hj : j < N') (y : StrData) (σ : PermData) :
    get (padCompD N' y σ) j = get y (get σ.1 j) := by
  rw [padCompD, get_list_toArray _ _ _ (by simpa using hj), tr_getD_range hj]

end Models

/-! ### Valid children -/

section Valid

variable {D : Ty} {DV : ℕ → GensData → D.denote → Prop}

/-- **A child group related to the parent group `K = ⟨gs⟩` (degree `N`)**: valid group data at
degree `N'`, the base `[n, N')` invariant, a valid invariant window of string positions, the
group faithful on the string positions, and isomorphic to `K` with the same action on them.
`ChildOK` supplies it (`ChildOK.rel`); the labels are separate. -/
structure ChildRel (DV : ℕ → GensData → D.denote → Prop) (n N : ℕ) (gs : GensData) (N' : ℕ)
    (gs' : GensData) (d' : D.denote) (w' : WinData) : Prop where
  valid : GroupValid DV N' gs' d'
  le : n ≤ N'
  base_inv : IsInvariant (GensData.denote N' gs') (baseSet n N')
  win : w'.Valid N'
  win_lt : ∀ i ∈ w'.1, i < n
  inv : IsInvariant (GensData.denote N' gs') (w'.denote N')
  faithful : ∀ g ∈ GensData.denote N' gs', (∀ j : Fin N', j.val < n → g j = j) → g = 1
  iso : ∃ θ : ↥(GensData.denote N gs) ≃* ↥(GensData.denote N' gs'),
    ∀ (g : ↥(GensData.denote N gs)) (j : ℕ) (hj : j < N) (hj' : j < N'), j < n →
      ((θ g : Perm (Fin N')) ⟨j, hj'⟩).val = (g.1 ⟨j, hj⟩).val

/-- `ChildOK` gives the relation. -/
theorem ChildOK.rel {n N : ℕ} {gs : GensData} {N' : ℕ} {gs' : GensData} {d' : D.denote}
    {w' : WinData} {L' : LabelData} (h : ChildOK DV n N gs N' gs' d' w' L') :
    ChildRel DV n N gs N' gs' d' w' :=
  ⟨h.valid, h.hint.le, h.hint.base_inv, h.win, h.hint.win_lt, h.inv, h.faithful, h.iso⟩

/-- `ChildOK` gives the labels' condition of `childHInst_valid`. -/
theorem ChildOK.labels {n N : ℕ} {gs : GensData} {N' : ℕ} {gs' : GensData} {d' : D.denote}
    {w' : WinData} {L' : LabelData} (h : ChildOK DV n N gs N' gs' d' w' L') :
    ∀ L, some L' = some L →
      HintValid n N' gs' w' L ∧ IsTransOn (GensData.denote N' gs') (w'.denote N') := by
  rintro L ⟨⟩
  exact ⟨h.hint, h.trans⟩

/-- **The child instance is a valid hinted instance.** -/
theorem childHInst_valid {n N : ℕ} {gs : GensData} {N' : ℕ} {gs' : GensData} {d' : D.denote}
    {w' : WinData} (hc : ChildRel DV n N gs N' gs' d' w') {L' : Option LabelData}
    (hL : ∀ L, L' = some L →
      HintValid n N' gs' w' L ∧ IsTransOn (GensData.denote N' gs') (w'.denote N'))
    (x y : StrData) (σ : PermData) (n₀ : ℕ) :
    HInstValid DV (childHInst x y σ n₀ n (N', gs', d') w' L') :=
  ⟨⟨hc.win, PermData.valid_one _, hc.valid, hc.inv⟩, hc.le, hc.base_inv, hc.win_lt,
    hc.faithful, hL⟩

/-- **An instance without a hint is valid** when the window lies in the string positions, the
base is invariant and the group is faithful on the string positions. -/
theorem noHintHInst_valid {I : InstData D} (hv : I.Valid DV) {n : ℕ} (hn : n ≤ I.degree)
    (hb : IsInvariant I.G (baseSet n I.degree)) (hw : ∀ i ∈ I.2.1.1, i < n)
    (hf : ∀ g ∈ I.G, (∀ j : Fin I.degree, j.val < n → g j = j) → g = 1) (n₀ : ℕ) :
    HInstValid DV (noHintHInst I n₀ n) :=
  ⟨hv, hn, hb, hw, hf, fun _ h => absurd h (by simp [noHintHInst, HInstData.lab])⟩

end Valid

/-! ### Runs of the pieces -/

section PieceSpecs

variable {D : Ty} {a b : Ty}

section Generic

variable {S : Signature} {X : Ctx S} {body : a.denote → Prog S (a, b) Ty.denote b}

theorem RunsWithin.padProg (N' : ℕ) (x : StrData) :
    RunsWithin X body (Main.padProg N' x) (padD N' x) (6 * N' + 4) := by
  apply RunsWithin.mono
  case h =>
    run_step (RunsWithin.prim _ _)
    run_step (RunsWithin.mapList_le (c := 1) fun j _ => RunsWithin.prim _ _)
    exact RunsWithin.prim_le rfl le_rfl
  case hc =>
    simp only [Prim.cost, Prim.eval, Args.head, List.length_map, List.length_range]
    omega

theorem RunsWithin.padCompProg (N' : ℕ) (y : StrData) (σ : PermData) :
    RunsWithin X body (Main.padCompProg N' y σ) (padCompD N' y σ) (7 * N' + 5) := by
  apply RunsWithin.mono
  case h =>
    run_step (RunsWithin.prim _ _)
    run_step (RunsWithin.prim _ _)
    run_step (RunsWithin.mapList_le (c := 2) fun j _ =>
      RunsWithin.bind_le (RunsWithin.prim _ _) (RunsWithin.prim _ _) (by simp [Prim.cost]))
    exact RunsWithin.prim_le rfl le_rfl
  case hc =>
    simp only [Prim.cost, Prim.eval, Args.head, List.length_map, List.length_range]
    omega

theorem RunsWithin.mkHInstProg (I : InstData D) (n₀ n : ℕ) (L : Option LabelData) :
    RunsWithin X body (Main.mkHInstProg I n₀ n L) ((I, (n₀, (n, L))) : HInstData D) 3 := by
  apply RunsWithin.mono
  case h =>
    run_step (RunsWithin.prim _ _)
    run_step (RunsWithin.prim _ _)
    exact RunsWithin.prim _ _
  case hc => simp [Prim.cost]

theorem RunsWithin.childInstProg (xy : StrData × StrData) (σ : PermData) (n₀ n : ℕ)
    (G' : GroupData D.denote) (w' : WinData) (L' : Option LabelData) :
    RunsWithin X body (Main.childInstProg xy σ n₀ n G' w' L')
      (childHInst xy.1 xy.2 σ n₀ n G' w' L') (15 * G'.1 + 22) := by
  apply RunsWithin.mono
  case h =>
    run_step (RunsWithin.prim _ _)
    run_step (RunsWithin.prim _ _)
    run_step (RunsWithin.prim _ _)
    run_step (RunsWithin.padProg _ _)
    run_step (RunsWithin.padCompProg _ _ _)
    run_step (RunsWithin.permOne _)
    run_step (RunsWithin.prim _ _)
    run_step (RunsWithin.prim _ _)
    run_step (RunsWithin.prim _ _)
    run_step (RunsWithin.prim _ _)
    exact RunsWithin.mkHInstProg _ _ _ _
  case hc =>
    simp only [Prim.cost, Prim.eval]
    omega

end Generic

variable {X : Ctx (groupSig D)} {body : a.denote → Prog (groupSig D) (a, b) Ty.denote b}

theorem RunsWithin.liftStrProg {K : GroupData D.denote} {wn : WinData} {pos : Array ℕ}
    {pts : List ℕ} {g : PermData}
    (hpre : X.Pre GroupOp.lift (K, (wn, PermData.restrictTo pos pts g))) {B : ℕ}
    (hB : X.B.call GroupOp.lift (K, (wn, PermData.restrictTo pos pts g))
      (X.O.run GroupOp.lift (K, (wn, PermData.restrictTo pos pts g))) ≤ B) :
    RunsWithin X body (Main.liftStrProg K wn pos pts g)
      (X.O.run GroupOp.lift (K, (wn, PermData.restrictTo pos pts g)))
      (12 * pts.length + B + 11) := by
  apply RunsWithin.mono
  case h =>
    run_step (RunsWithin.restrictPermProg _ _ _)
    run_step (RunsWithin.prim _ _)
    run_step (RunsWithin.prim _ _)
    exact RunsWithin.call hpre
  case hc =>
    simp only [Prim.cost, Prim.eval]
    omega

end PieceSpecs

/-! ### The transfer -/

section TransferSpec

variable {D : Ty} {a b : Ty} {X : Ctx (groupSig D)}
  {body : a.denote → Prog (groupSig D) (a, b) Ty.denote b} {DV : ℕ → GensData → D.denote → Prop}

/-- The backend operations of the transfer. -/
def transferOps (op : GroupOp) : Prop := op = .lift ∨ op = .generate

/-- The cost of `transferProg`: parent degree `N`, child degree `N'`, `n` string positions, at
most `s` child generators, and the charges `Blift` (one `lift`) and `Bgen` (the `generate`). -/
def transferCost (N N' n s Blift Bgen : ℕ) : ℕ :=
  14 * N + 2 * N' + 27 * n + s * (12 * n + Blift + 14) + Blift + Bgen + 60

/-- **The transfer.** A correct child answer `(τ', H')` for the window `pts` of string positions,
the coset `1 • G'` and strings agreeing with `x` and `y ∘ σ` on `[0, n)`, becomes a correct
answer for the parent coset `σ • K`. -/
theorem RunsWithin.transferProg (hO : MeetsContractOn DV transferOps X.O)
    (hPre : ∀ op x, transferOps op → GroupPre DV op x → X.Pre op x)
    {N n : ℕ} {gs : GensData} {d : D.denote} (hK : GroupValid DV N gs d) (hn : n ≤ N)
    (hKb : IsInvariant (GensData.denote N gs) (baseSet n N))
    {N' : ℕ} {gs' : GensData} (hn' : n ≤ N')
    (hG'b : IsInvariant (GensData.denote N' gs') (baseSet n N'))
    (hG'f : ∀ g ∈ GensData.denote N' gs', (∀ j : Fin N', j.val < n → g j = j) → g = 1)
    {θ : ↥(GensData.denote N gs) ≃* ↥(GensData.denote N' gs')}
    (hθ : ∀ (g : ↥(GensData.denote N gs)) (j : ℕ) (hj : j < N) (hj' : j < N'), j < n →
      ((θ g : Perm (Fin N')) ⟨j, hj'⟩).val = (g.1 ⟨j, hj⟩).val)
    {pts : List ℕ} (hpts : ∀ i ∈ pts, i < n)
    (hinv' : IsInvariant (GensData.denote N' gs') (ptsSet N' pts))
    {σd : PermData} (hσ : σd.Valid N) {x y x' y' : StrData}
    (hx : ∀ j < n, get x' j = get x j) (hy : ∀ j < n, get y' j = get y (get σd.1 j))
    {τ' : PermData} {Hd' : GroupData D.denote}
    (hok : AnsOK DV N' (ptsSet N' pts) 1 (GensData.denote N' gs') (x'.denote N')
      (y'.denote N') (some (τ', Hd')))
    {s Blift Bgen : ℕ} (hs : Hd'.gens.length ≤ s)
    (hBlift : ∀ π' : PermData, π'.Valid n →
      X.B.call GroupOp.lift ((N, gs, d), (strWin N n, π'))
        (X.O.run GroupOp.lift ((N, gs, d), (strWin N n, π'))) ≤ Blift)
    (hBgen : ∀ hs : GensData, GensData.AllValid N hs → hs.length ≤ s →
      GensData.denote N hs ≤ GensData.denote N gs →
      X.B.call GroupOp.generate (N, hs) (X.O.run GroupOp.generate (N, hs)) ≤ Bgen) :
    RunsWithin X body (Main.transferProg n σd (N, gs, d) (τ', Hd'))
        (transferD X.O n σd (N, gs, d) (τ', Hd')) (transferCost N N' n s Blift Bgen) ∧
      AnsOK DV N (ptsSet N pts) (PermData.denote N σd) (GensData.denote N gs) (x.denote N)
        (y.denote N) (transferD X.O n σd (N, gs, d) (τ', Hd')) ∧
      ∀ sGen, (∀ hs, GensData.AllValid N hs → GensData.denote N hs ≤ GensData.denote N gs →
          (X.O.run GroupOp.generate (N, hs)).2.1.length ≤ sGen) →
        ∀ c : CosetData D, transferD X.O n σd (N, gs, d) (τ', Hd') = some c →
          c.2.gens.length ≤ sGen := by
  obtain ⟨N'', hgs, e⟩ := Hd'
  obtain ⟨hτ'v, hdeg, hH'v, hiso'⟩ := hok
  change N'' = N' at hdeg
  subst hdeg
  change hgs.length ≤ s at hs
  change GroupValid DV N'' hgs e at hH'v
  change PermData.denote N'' τ' • (GensData.denote N'' hgs : Set (Perm (Fin N''))) = _ at hiso'
  have hKs := isInvariant_strSet hKb
  have hG's := isInvariant_strSet hG'b
  have hτG : PermData.denote N'' τ' ∈ GensData.denote N'' gs' := by
    have h := self_mem_leftCoset (PermData.denote N'' τ') (GensData.denote N'' hgs)
    rw [hiso', mem_iso_one] at h
    exact h.1
  have hHG : GensData.denote N'' hgs ≤ GensData.denote N'' gs' := by
    intro k hk
    have h : PermData.denote N'' τ' * k ∈ PermData.denote N'' τ' •
        (GensData.denote N'' hgs : Set (Perm (Fin N''))) := Set.smul_mem_smul_set hk
    rw [hiso', mem_iso_one] at h
    have := mul_mem (inv_mem hτG) h.1
    rwa [inv_mul_cancel_left] at this
  have hgen : ∀ h ∈ hgs, h.Valid N'' ∧ PermData.denote N'' h ∈ GensData.denote N'' gs' :=
    fun h hh => ⟨hH'v.1 h hh, hHG (GensData.mem_denote_of_mem hh)⟩
  -- the lifts
  have hpre : ∀ g : PermData, g.Valid N'' → PermData.denote N'' g ∈ GensData.denote N'' gs' →
      GroupPre DV .lift ((N, gs, d), (strWin N n, strRestrict N'' n g)) := fun g hg hgG =>
    ⟨hK, tr_strWin_valid hn, by rw [tr_strWin_denote]; exact hKs,
      by simpa using tr_valid_strRestrict hn' hG's hg hgG,
      tr_lift_exists hn' hG's hθ hn hg hgG⟩
  have hpost : ∀ g : PermData, g.Valid N'' → PermData.denote N'' g ∈ GensData.denote N'' gs' →
      GroupPost DV .lift ((N, gs, d), (strWin N n, strRestrict N'' n g))
        (liftStrD X.O (N, gs, d) n N'' g) :=
    fun g hg hgG => hO .lift _ (Or.inl rfl) (hpre g hg hgG)
  set τ := liftStrD X.O (N, gs, d) n N'' τ' with hτdef
  obtain ⟨hτv, hτK, hτmw⟩ := hpost τ' hτ'v hτG
  set ls := hgs.map (liftStrD X.O (N, gs, d) n N'') with hlsdef
  have hls : ∀ l ∈ ls, l.Valid N ∧ PermData.denote N l ∈ GensData.denote N gs := by
    intro l hl
    obtain ⟨h, hh, rfl⟩ := List.mem_map.1 hl
    obtain ⟨hv, hk, -⟩ := hpost h (hgen h hh).1 (hgen h hh).2
    exact ⟨hv, hk⟩
  have hlsv : GensData.AllValid N ls := fun l hl => (hls l hl).1
  have hlsK : GensData.denote N ls ≤ GensData.denote N gs :=
    GensData.denote_le_iff.2 fun l hl => (hls l hl).2
  have hlslen : ls.length ≤ s := by simpa [hlsdef] using hs
  -- the generated group
  have hgpost := hO .generate (N, ls) (Or.inr rfl) hlsv
  have hBg := hBgen ls hlsv hlslen hlsK
  rcases hH : X.O.run GroupOp.generate (N, ls) with ⟨N₂, hs₂, e₂⟩
  rw [hH] at hgpost hBg
  obtain ⟨hN₂, hHv, hHden⟩ := hgpost
  subst hN₂
  have hT : transferD X.O n σd (N₂, gs, d) (τ', (N'', hgs, e)) =
      some (σd.mul τ, (N₂, hs₂, e₂)) := by
    simp only [transferD]
    rw [← hlsdef, hH]
  refine ⟨?_, ?_, ?_⟩
  · -- the run
    have hmap := RunsWithin.mapList_le (X := X) (body := body) (a' := Ty.perm) (b' := Ty.perm)
      (xs := hgs) (c := 12 * (List.range n).length + Blift + 11)
      (F := liftStrD X.O (N₂, gs, d) n N'')
      (f := fun h => Main.liftStrProg (N₂, gs, d) (strWin N₂ n) (strPos N'' n) (List.range n) h)
      fun h hh => RunsWithin.liftStrProg
        (hPre _ _ (Or.inl rfl) (hpre h (hgen h hh).1 (hgen h hh).2))
        (hBlift _ (tr_valid_strRestrict hn' hG's (hgen h hh).1 (hgen h hh).2))
    rw [hT]
    apply RunsWithin.mono
    case h =>
      run_step (RunsWithin.prim _ _)
      run_step (RunsWithin.prim _ _)
      run_step (RunsWithin.prim _ _)
      run_step (RunsWithin.prim _ _)
      run_step (RunsWithin.prim _ _)
      run_step (RunsWithin.prim _ _)
      run_step (RunsWithin.prim _ _)
      run_step (RunsWithin.mkWindow _ _)
      run_step (RunsWithin.posProg N'' (strWin N'' n))
      run_step (RunsWithin.liftStrProg (hPre _ _ (Or.inl rfl) (hpre τ' hτ'v hτG))
        (hBlift _ (tr_valid_strRestrict hn' hG's hτ'v hτG)))
      run_step hmap
      run_step (RunsWithin.prim _ _)
      run_step (RunsWithin.call (hPre _ _ (Or.inr rfl) hlsv))
      simp only [Prim.eval]
      rw [← hlsdef, hH]
      run_step (RunsWithin.permMul hσ hτv)
      run_step (RunsWithin.prim _ _)
      exact RunsWithin.prim _ _
    case hc =>
      simp only [Prim.cost, Prim.eval, Args.head, List.length_range, transferCost, strWin,
        WinData.ofPoints_fst]
      rw [← hlsdef, hH]
      have hmul : hgs.length * (12 * n + Blift + 11 + 3) ≤ s * (12 * n + Blift + 14) :=
        Nat.mul_le_mul hs le_rfl
      clear * - hmul hBg
      omega
  · -- correctness
    rw [hT]
    have hxs : ∀ (j : ℕ) (hj : j < N₂) (hj' : j < N''), j < n →
        StrData.denote N'' x' ⟨j, hj'⟩ = StrData.denote N₂ x ⟨j, hj⟩ :=
      fun j _ _ hjn => hx j hjn
    have hys : ∀ (j : ℕ) (hj : j < N₂) (hj' : j < N''), j < n →
        StrData.denote N'' y' ⟨j, hj'⟩ =
          (fun u => StrData.denote N₂ y (PermData.denote N₂ σd u)) ⟨j, hj⟩ := by
      intro j hj _ hjn
      show get y' j = get y (PermData.denote N₂ σd ⟨j, hj⟩).val
      rw [PermData.val_denote_apply hσ]
      exact hy j hjn
    have hrτ : (θ ⟨PermData.denote N₂ τ, hτK⟩ : Perm (Fin N'')) = PermData.denote N'' τ' :=
      tr_lift_eq hn hn' hG's hG'f hθ hτ'v hτG hτv hτK hτmw
    have hLK : GensData.denoteSet N₂ ls ⊆ GensData.denote N₂ gs := by
      rintro _ ⟨l, hl, rfl⟩
      exact (hls l hl).2
    have hL : Subgroup.closure {π | ∃ l, ∃ hl : l ∈ GensData.denote N₂ gs,
        l ∈ GensData.denoteSet N₂ ls ∧ (θ ⟨l, hl⟩ : Perm (Fin N'')) = π} =
        GensData.denote N'' hgs := by
      unfold GensData.denote
      congr 1
      ext π
      simp only [GensData.denoteSet, Set.mem_ofPred_eq]
      constructor
      · rintro ⟨_, hl, ⟨l, hlm, rfl⟩, rfl⟩
        obtain ⟨h, hh, rfl⟩ := List.mem_map.1 hlm
        obtain ⟨hv, hk, hmw⟩ := hpost h (hgen h hh).1 (hgen h hh).2
        exact ⟨h, hh, (tr_lift_eq hn hn' hG's hG'f hθ (hgen h hh).1 (hgen h hh).2 hv hk
          hmw).symm⟩
      · rintro ⟨h, hh, rfl⟩
        obtain ⟨hv, hk, hmw⟩ := hpost h (hgen h hh).1 (hgen h hh).2
        exact ⟨_, hk, ⟨_, List.mem_map.2 ⟨h, hh, rfl⟩, rfl⟩,
          tr_lift_eq hn hn' hG's hG'f hθ (hgen h hh).1 (hgen h hh).2 hv hk hmw⟩
    have hmain := tr_iso_eq (θ := θ) (y := fun u => StrData.denote N₂ y (PermData.denote N₂ σd u))
      hn hn' hKs hθ hpts hxs hys hiso'.symm hτK hrτ hLK hL
    refine ⟨hσ.mul hτv, rfl, hHv, ?_⟩
    change PermData.denote N₂ (σd.mul τ) • (GensData.denote N₂ hs₂ : Set (Perm (Fin N₂))) = _
    rw [iso_eq_smul_iso_one, hmain, PermData.denote_mul hσ hτv, hHden, smul_smul]
    rfl
  · intro sGen hgen' c hc
    rw [hT] at hc
    cases hc
    have := hgen' _ hlsv hlsK
    rw [hH] at this
    exact this

end TransferSpec

/-! ### Solving a coset through a child -/

section ViaChild

variable {D : Ty} {a b : Ty} {X : Ctx (groupSig D)}
  {body : a.denote → Prog (groupSig D) (a, b) Ty.denote b} {DV : ℕ → GensData → D.denote → Prop}

/-- The cost of `viaChildProg` beyond the sub-call: building the child (degree `N'`) and the
transfer. -/
def viaChildCost (N N' n s Blift Bgen : ℕ) : ℕ :=
  15 * N' + transferCost N N' n s Blift Bgen + 24

/-- **Solving a coset of `K` through a child group.** For a child related to `K` (`ChildRel`,
from `ChildOK.rel`), with labels that are valid hint data on a window where the child is
transitive (from `ChildOK.labels`), and a sub-solver that solves the child (`P` of
`childHInst`), the result is a correct answer for the parent coset `σ • K` on the child's
window, within the child's cost plus `viaChildCost`. -/
theorem RunsWithin.viaChildProg (hO : MeetsContractOn DV transferOps X.O)
    (hPre : ∀ op x, transferOps op → GroupPre DV op x → X.Pre op x)
    {sub : HInstData D → Prog (groupSig D) (a, b) Ty.denote (Ty.answer D)}
    {P : HInstData D → Prop} {C : ℕ → Option ℕ → ℕ} {s : ℕ}
    (hsub : HSubSolves X body DV sub P C s)
    {N n n₀ : ℕ} {gs : GensData} {d : D.denote} (hK : GroupValid DV N gs d) (hn : n ≤ N)
    (hKb : IsInvariant (GensData.denote N gs) (baseSet n N))
    {σd : PermData} (hσ : σd.Valid N) (xy : StrData × StrData)
    {N' : ℕ} {gs' : GensData} {d' : D.denote} {w' : WinData}
    (hc : ChildRel DV n N gs N' gs' d' w') {L' : Option LabelData}
    (hL : ∀ L, L' = some L →
      HintValid n N' gs' w' L ∧ IsTransOn (GensData.denote N' gs') (w'.denote N'))
    (hP : P (childHInst xy.1 xy.2 σd n₀ n (N', gs', d') w' L'))
    {Blift Bgen : ℕ}
    (hBlift : ∀ π' : PermData, π'.Valid n →
      X.B.call GroupOp.lift ((N, gs, d), (strWin N n, π'))
        (X.O.run GroupOp.lift ((N, gs, d), (strWin N n, π'))) ≤ Blift)
    (hBgen : ∀ hs : GensData, GensData.AllValid N hs → hs.length ≤ s →
      GensData.denote N hs ≤ GensData.denote N gs →
      X.B.call GroupOp.generate (N, hs) (X.O.run GroupOp.generate (N, hs)) ≤ Bgen) :
    ∃ ans : AnswerData D,
      RunsWithin X body (Main.viaChildProg sub xy σd (N, gs, d) n₀ n (N', gs', d') w' L') ans
        (C w'.1.length (L'.map fun _ => N' - n) + viaChildCost N N' n s Blift Bgen) ∧
      AnsOK DV N (ptsSet N w'.1) (PermData.denote N σd) (GensData.denote N gs) (xy.1.denote N)
        (xy.2.denote N) ans ∧
      ∀ sGen, (∀ hs, GensData.AllValid N hs → GensData.denote N hs ≤ GensData.denote N gs →
          (X.O.run GroupOp.generate (N, hs)).2.1.length ≤ sGen) →
        ∀ c : CosetData D, ans = some c → c.2.gens.length ≤ sGen := by
  obtain ⟨θ, hθ⟩ := hc.iso
  have hJv := childHInst_valid hc hL xy.1 xy.2 σd n₀
  obtain ⟨a', ha', hok', hg'⟩ := hsub _ hJv hP
  have hok : AnsOK DV N' (ptsSet N' w'.1) 1 (GensData.denote N' gs')
      (StrData.denote N' (padD N' xy.1)) (StrData.denote N' (padCompD N' xy.2 σd)) a' := by
    have h := hok'
    change AnsOK DV N' (w'.denote N') (PermData.denote N' (PermData.one N'))
      (GensData.denote N' gs') (StrData.denote N' (padD N' xy.1))
      (StrData.denote N' (padCompD N' xy.2 σd)) a' at h
    rwa [PermData.denote_one] at h
  have hx : ∀ j < n, get (padD N' xy.1) j = get xy.1 j := fun j hj =>
    get_padD (by have := hc.le; omega) _
  have hy : ∀ j < n, get (padCompD N' xy.2 σd) j = get xy.2 (get σd.1 j) := fun j hj =>
    get_padCompD (by have := hc.le; omega) _ _
  have hprefix : ∀ (ans : AnswerData D) (c : ℕ),
      RunsWithin X body (.caseOption a' (.op0 .none) fun c' =>
        Main.transferProg n σd (N, gs, d) c') ans c →
      RunsWithin X body (Main.viaChildProg sub xy σd (N, gs, d) n₀ n (N', gs', d') w' L') ans
        (15 * N' + 22 + (C w'.1.length (L'.map fun _ => N' - n) + c)) := by
    intro ans c h
    exact RunsWithin.step (RunsWithin.childInstProg xy σd n₀ n (N', gs', d') w' L')
      (RunsWithin.step ha' h)
  rcases a' with _ | ⟨τ', Hd'⟩
  · refine ⟨none, (hprefix none 2 (RunsWithin.caseOption_none (RunsWithin.prim _ _))).mono ?_,
      ?_, fun _ _ c hc => absurd hc (by simp)⟩
    · simp only [viaChildCost, transferCost]
      omega
    · have hxs : ∀ (j : ℕ) (hj : j < N) (hj' : j < N'), j < n →
          StrData.denote N' (padD N' xy.1) ⟨j, hj'⟩ = StrData.denote N xy.1 ⟨j, hj⟩ :=
        fun j _ _ hjn => hx j hjn
      have hys : ∀ (j : ℕ) (hj : j < N) (hj' : j < N'), j < n →
          StrData.denote N' (padCompD N' xy.2 σd) ⟨j, hj'⟩ =
            (fun u => StrData.denote N xy.2 (PermData.denote N σd u)) ⟨j, hj⟩ := by
        intro j hj _ hjn
        show get _ j = get xy.2 (PermData.denote N σd ⟨j, hj⟩).val
        rw [PermData.val_denote_apply hσ]
        exact hy j hjn
      have he := tr_iso_eq_empty (θ := θ) (x := StrData.denote N xy.1)
        (y := fun u => StrData.denote N xy.2 (PermData.denote N σd u)) hn hc.le
        (isInvariant_strSet hKb) hθ hc.win_lt hxs hys hok
      change iso (ptsSet N w'.1) (PermData.denote N σd) (GensData.denote N gs)
        (StrData.denote N xy.1) (StrData.denote N xy.2) = ∅
      rw [iso_eq_smul_iso_one, he, Set.smul_set_empty]
  · obtain ⟨hrun, hans, hgen⟩ := RunsWithin.transferProg (X := X) (body := body) hO hPre hK hn
      hKb hc.le hc.base_inv hc.faithful hθ hc.win_lt hc.inv hσ hx hy hok (hg' _ rfl) hBlift
      hBgen
    refine ⟨_, (hprefix _ _ (RunsWithin.caseOption_some hrun)).mono ?_, hans, hgen⟩
    simp only [viaChildCost]
    omega

/-- **Same degree, no hint**: a sub-call on the instance itself with the labels `none`. -/
theorem RunsWithin.sameDegProg
    {sub : HInstData D → Prog (groupSig D) (a, b) Ty.denote (Ty.answer D)}
    {P : HInstData D → Prop} {C : ℕ → Option ℕ → ℕ} {s : ℕ}
    (hsub : HSubSolves X body DV sub P C s) {I : InstData D} {n₀ n : ℕ}
    (hv : HInstValid DV (noHintHInst I n₀ n)) (hP : P (noHintHInst I n₀ n)) :
    ∃ ans : AnswerData D,
      RunsWithin X body (Main.sameDegProg sub I n₀ n) ans (C I.2.1.1.length none + 4) ∧
      I.OK DV ans ∧ ∀ c : CosetData D, ans = some c → c.2.gens.length ≤ s := by
  obtain ⟨ans, hrun, hok, hg⟩ := hsub _ hv hP
  refine ⟨ans, ?_, hok, hg⟩
  apply RunsWithin.mono
  case h =>
    run_step (RunsWithin.prim _ _)
    run_step (RunsWithin.mkHInstProg I n₀ n none)
    exact hrun
  case hc =>
    simp only [Prim.cost, noHintHInst_winSize, noHintHInst_baseOpt]
    omega

end ViaChild

/-! ### Well-formedness -/

section Wf

variable {D : Ty} {S : Signature} {rec : Ty × Ty} {var₁ var₂ : Ty → Type} {r : Bool}
  {Γ : WfCtx var₁ var₂}

theorem wf_transferProg {n₁ : var₁ .nat} {n₂ : var₂ .nat} {σ₁ : var₁ Ty.perm}
    {σ₂ : var₂ Ty.perm} {K₁ : var₁ (Ty.group D)} {K₂ : var₂ (Ty.group D)}
    {c₁ : var₁ (Ty.coset D)} {c₂ : var₂ (Ty.coset D)} (hn : ⟨.nat, n₁, n₂⟩ ∈ Γ)
    (hσ : ⟨Ty.perm, σ₁, σ₂⟩ ∈ Γ) (hK : ⟨Ty.group D, K₁, K₂⟩ ∈ Γ)
    (hc : ⟨Ty.coset D, c₁, c₂⟩ ∈ Γ) :
    Prog.Wf (rec := rec) r Γ (transferProg n₁ σ₁ K₁ c₁) (transferProg n₂ σ₂ K₂ c₂) := by
  unfold transferProg liftStrProg restrictPermProg posProg mkWindow permMul mapArray mapList
  prog_wf

theorem wf_mkHInstProg {I₁ : var₁ (Ty.inst D)} {I₂ : var₂ (Ty.inst D)} {n₀₁ n₁ : var₁ .nat}
    {n₀₂ n₂ : var₂ .nat} {L₁ : var₁ (.option (.array (.list .nat)))}
    {L₂ : var₂ (.option (.array (.list .nat)))} (hI : ⟨Ty.inst D, I₁, I₂⟩ ∈ Γ)
    (hn₀ : ⟨.nat, n₀₁, n₀₂⟩ ∈ Γ) (hn : ⟨.nat, n₁, n₂⟩ ∈ Γ)
    (hL : ⟨.option (.array (.list .nat)), L₁, L₂⟩ ∈ Γ) :
    Prog.Wf (S := S) (rec := rec) r Γ (mkHInstProg I₁ n₀₁ n₁ L₁) (mkHInstProg I₂ n₀₂ n₂ L₂) := by
  unfold mkHInstProg
  prog_wf

theorem wf_childInstProg {xy₁ : var₁ Ty.strs} {xy₂ : var₂ Ty.strs} {σ₁ : var₁ Ty.perm}
    {σ₂ : var₂ Ty.perm} {n₀₁ n₁ : var₁ .nat} {n₀₂ n₂ : var₂ .nat} {G₁ : var₁ (Ty.group D)}
    {G₂ : var₂ (Ty.group D)} {w₁ : var₁ Ty.win} {w₂ : var₂ Ty.win}
    {L₁ : var₁ (.option (.array (.list .nat)))} {L₂ : var₂ (.option (.array (.list .nat)))}
    (hxy : ⟨Ty.strs, xy₁, xy₂⟩ ∈ Γ) (hσ : ⟨Ty.perm, σ₁, σ₂⟩ ∈ Γ) (hn₀ : ⟨.nat, n₀₁, n₀₂⟩ ∈ Γ)
    (hn : ⟨.nat, n₁, n₂⟩ ∈ Γ) (hG : ⟨Ty.group D, G₁, G₂⟩ ∈ Γ) (hw : ⟨Ty.win, w₁, w₂⟩ ∈ Γ)
    (hL : ⟨.option (.array (.list .nat)), L₁, L₂⟩ ∈ Γ) :
    Prog.Wf (S := S) (rec := rec) r Γ (childInstProg xy₁ σ₁ n₀₁ n₁ G₁ w₁ L₁)
      (childInstProg xy₂ σ₂ n₀₂ n₂ G₂ w₂ L₂) := by
  unfold childInstProg padProg padCompProg mkHInstProg permOne mapList
  prog_wf

theorem wf_viaChildProg {sub₁ : var₁ (hinstTy D) → Prog (groupSig D) rec var₁ (Ty.answer D)}
    {sub₂ : var₂ (hinstTy D) → Prog (groupSig D) rec var₂ (Ty.answer D)}
    (hsub : WfFun r Γ sub₁ sub₂) {xy₁ : var₁ Ty.strs} {xy₂ : var₂ Ty.strs}
    {σ₁ : var₁ Ty.perm} {σ₂ : var₂ Ty.perm} {K₁ : var₁ (Ty.group D)} {K₂ : var₂ (Ty.group D)}
    {n₀₁ n₁ : var₁ .nat} {n₀₂ n₂ : var₂ .nat} {G₁ : var₁ (Ty.group D)}
    {G₂ : var₂ (Ty.group D)} {w₁ : var₁ Ty.win} {w₂ : var₂ Ty.win}
    {L₁ : var₁ (.option (.array (.list .nat)))} {L₂ : var₂ (.option (.array (.list .nat)))}
    (hxy : ⟨Ty.strs, xy₁, xy₂⟩ ∈ Γ) (hσ : ⟨Ty.perm, σ₁, σ₂⟩ ∈ Γ)
    (hK : ⟨Ty.group D, K₁, K₂⟩ ∈ Γ) (hn₀ : ⟨.nat, n₀₁, n₀₂⟩ ∈ Γ) (hn : ⟨.nat, n₁, n₂⟩ ∈ Γ)
    (hG : ⟨Ty.group D, G₁, G₂⟩ ∈ Γ) (hw : ⟨Ty.win, w₁, w₂⟩ ∈ Γ)
    (hL : ⟨.option (.array (.list .nat)), L₁, L₂⟩ ∈ Γ) :
    Prog.Wf r Γ (viaChildProg sub₁ xy₁ σ₁ K₁ n₀₁ n₁ G₁ w₁ L₁)
      (viaChildProg sub₂ xy₂ σ₂ K₂ n₀₂ n₂ G₂ w₂ L₂) := by
  unfold viaChildProg
  refine .bind (wf_childInstProg hxy hσ hn₀ hn hG hw hL) fun _ _ => ?_
  refine .bind (hsub _ (fun y hy => by simp [hy]) _ _ (List.Mem.head _)) fun _ _ => ?_
  exact .caseOption (List.Mem.head _) (.prim _ .nil) fun _ _ =>
    wf_transferProg (by simp [hn]) (by simp [hσ]) (by simp [hK]) (List.Mem.head _)

theorem wf_sameDegProg {sub₁ : var₁ (hinstTy D) → Prog S rec var₁ (Ty.answer D)}
    {sub₂ : var₂ (hinstTy D) → Prog S rec var₂ (Ty.answer D)} (hsub : WfFun r Γ sub₁ sub₂)
    {I₁ : var₁ (Ty.inst D)} {I₂ : var₂ (Ty.inst D)} {n₀₁ n₁ : var₁ .nat} {n₀₂ n₂ : var₂ .nat}
    (hI : ⟨Ty.inst D, I₁, I₂⟩ ∈ Γ) (hn₀ : ⟨.nat, n₀₁, n₀₂⟩ ∈ Γ) (hn : ⟨.nat, n₁, n₂⟩ ∈ Γ) :
    Prog.Wf r Γ (sameDegProg sub₁ I₁ n₀₁ n₁) (sameDegProg sub₂ I₂ n₀₂ n₂) := by
  unfold sameDegProg
  refine .bind (.prim _ .nil) fun _ _ => ?_
  refine .bind (wf_mkHInstProg (by simp [hI]) (by simp [hn₀]) (by simp [hn])
    (List.Mem.head _)) fun _ _ => ?_
  exact hsub _ (fun y hy => by simp [hy]) _ _ (List.Mem.head _)

end Wf

end GraphIso.Main
