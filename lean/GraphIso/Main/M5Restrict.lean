module

public import GraphIso.Main.Frame
public import GraphIso.Main.Free
public import GraphIso.Main.Reduce
public import GraphIso.Reductions.RestrictionProg
public import Mathlib.GroupTheory.SpecificGroups.Alternating

/-!
# Restriction to the window and the base

Stage 14j-4, item 1 (`PLAN-14.md` §14.4; Babai Obs. 3.1.10). Before M5 runs the certificates
on a hinted instance `I = (x, y, w, σ • G)` of degree `N` (string positions `[0, n)`, base
`[n, N)`, labels `L`), the group is restricted to the invariant set `U = w ∪ [n, N)`, listed as
`w ++ [n, N)`, so that the window becomes all the string positions.

* **Semantics** (`rb_matches`, `rb_mem_iso_one_iff`, `rb_iso_one_eq`, `rb_iso_eq`,
  `rb_iso_eq_empty`): the restriction of milestone 1 (`Reductions/Restriction.lean`) to an
  invariant set `U` containing the window `W`. Matching on `W` is matching of the restriction
  on the reindexed window `rbWinSet e W`; a restricted answer `τ' • H'` lifts to
  `σ τ • (⟨L⟩ ⊔ pointwiseStab G U)`.
* **Faithfulness from a giant** (`rb_alt_two`, `rb_proper_label`, `rb_baseHom_eq_one`): if the
  base action contains `Alt(m)`, `m ≥ 4`, and the labels are a hint on a window on which the
  group is transitive, an element fixing the window acts trivially on the base. Its image fixes
  every label; some label `T` is a proper nonempty set; the alternating group is 2-transitive,
  so a moved point `c ↦ d` would be carried, by an image `q` of the group, to a label
  `q • T ∋ c` not containing `d`, which the element fixes. So the restricted group is faithful
  on the new string positions.
* **Data** (`rbPts`, `rbU`, `rbLabels`, `rbGens`, `rbHInst`): the restricted hinted instance of
  degree `|w| + m`: string positions `[0, |w|)` (the window in list order), base
  `[|w|, |w| + m)` (the old base in order), the strings `x` and `y ∘ σ` restricted (the target
  aligned, the representative `1`), the whole string range as window, the restricted group
  generated by the backend, `n₀`, and the labels re-indexed (`L'[i] = L[w[i]]`).
  `rbHInst_valid`: it is a valid hinted instance when the base action is a giant on at least
  four points (`rb_equivar` for the equivariance of the re-indexed labels, `rb_trans` for
  transitivity, `rb_fixes_win` for faithfulness). `rbHInst_measure`: the same window size and
  base size (`baseOpt = some m`), degree `|w| + m`, and the window contains every string
  position (the assumption `hwS` of `case3Prog_canonical`).
* **The program** `restrictBaseProg cont I L`: build the restricted instance, run the
  continuation `cont` on it, and lift its answer back through `U` with the kernel of the
  restriction (`liftAnswerProg`, `RunsWithin.rbLiftProg`, `AnsOK.rb_lift`, `AnsOK.rb_none`).
  `RunsWithin.restrictBaseProg`: if the continuation returns a correct answer for the
  restricted instance within `C'`, the result is a correct answer for `(w, σ • G, x, y)` within
  `rbCost N |w| m |gs| C' …`; the charges of `generate` (the restricted group, and the lifted
  group on bounded inputs), `lift` and `kernel` are hypotheses.
* Well-formedness: `wf_restrictBaseProg`.
-/

@[expose] public section

namespace GraphIso.Main

open Equiv Pointwise Cost GraphIso GraphIso.Programs GraphIso.Toolkit GraphIso.Recursion

/-! ### Restriction to an invariant set containing the window -/

section RestrictSem

variable {Ω α β : Type*} {G : Subgroup (Perm Ω)} {U W : Set Ω}

/-- The window, reindexed inside the restriction set. -/
def rbWinSet (e : α ≃ U) (W : Set Ω) : Set α := {j | (e j : Ω) ∈ W}

variable (hU : IsInvariant G U) (e : α ≃ U) {x y : Ω → β}

/-- Matching on the window is matching of the restriction on the reindexed window. -/
theorem rb_matches (hWU : W ⊆ U) (g : G) :
    Matches W g x y ↔
      Matches (rbWinSet e W) (restrictHom hU e g) (fun j => x (e j)) (fun j => y (e j)) := by
  simp only [Matches, rbWinSet, Set.mem_ofPred_eq, restrictHom_apply]
  constructor
  · intro h j hj
    exact h _ hj
  · intro h u hu
    have := h (e.symm ⟨u, hWU hu⟩) (by simpa using hu)
    simpa using this

theorem rb_mem_iso_one_iff (hWU : W ⊆ U) {g : Perm Ω} :
    g ∈ iso W 1 G x y ↔ ∃ hg : g ∈ G, restrictHom hU e ⟨g, hg⟩ ∈
      iso (rbWinSet e W) 1 (restrictHom hU e).range (fun j => x (e j)) (fun j => y (e j)) := by
  rw [mem_iso_one]
  constructor
  · rintro ⟨hg, hm⟩
    refine ⟨hg, ?_⟩
    rw [mem_iso_one]
    exact ⟨⟨⟨g, hg⟩, rfl⟩, (rb_matches hU e hWU ⟨g, hg⟩).1 hm⟩
  · rintro ⟨hg, h⟩
    rw [mem_iso_one] at h
    exact ⟨hg, (rb_matches hU e hWU ⟨g, hg⟩).2 h.2⟩

theorem rb_iso_one_eq_empty (hWU : W ⊆ U)
    (h : iso (rbWinSet e W) 1 (restrictHom hU e).range (fun j => x (e j))
      (fun j => y (e j)) = ∅) :
    iso W 1 G x y = ∅ := by
  ext g
  simp only [Set.mem_empty_iff_false, iff_false]
  intro hg
  obtain ⟨hgG, hr⟩ := (rb_mem_iso_one_iff hU e hWU).1 hg
  rw [h] at hr
  exact hr

/-- **Lifting a restricted answer**: the kernel of the restriction to `U` is part of the
answer. -/
theorem rb_iso_one_eq (hWU : W ⊆ U) {τ' : Perm α} {H' : Subgroup (Perm α)}
    (h : iso (rbWinSet e W) 1 (restrictHom hU e).range (fun j => x (e j)) (fun j => y (e j)) =
      τ' • (H' : Set (Perm α)))
    {τ : Perm Ω} (hτ : τ ∈ G) (hττ : restrictHom hU e ⟨τ, hτ⟩ = τ') {L : Set (Perm Ω)}
    (hLG : L ⊆ G)
    (hL : Subgroup.closure {π | ∃ l, ∃ hl : l ∈ G, l ∈ L ∧ restrictHom hU e ⟨l, hl⟩ = π} = H') :
    iso W 1 G x y =
      τ • ((Subgroup.closure L ⊔ pointwiseStab G U : Subgroup (Perm Ω)) : Set (Perm Ω)) := by
  set ρ := restrictHom hU e
  set LG : Set G := {g | (g : Perm Ω) ∈ L}
  have himg : ρ '' LG = {π | ∃ l, ∃ hl : l ∈ G, l ∈ L ∧ ρ ⟨l, hl⟩ = π} := by
    ext π
    constructor
    · rintro ⟨g, hg, rfl⟩
      exact ⟨g, g.2, hg, rfl⟩
    · rintro ⟨l, hl, hlL, rfl⟩
      exact ⟨⟨l, hl⟩, hlL, rfl⟩
  have hH' : H' = (Subgroup.closure LG).map ρ := by
    rw [MonoidHom.map_closure, himg, hL]
  have hsub : G.subtype '' LG = L := by
    ext g
    constructor
    · rintro ⟨g', hg', rfl⟩
      exact hg'
    · intro hg
      exact ⟨⟨g, hLG hg⟩, hg, rfl⟩
  have hS : ((H'.comap ρ).map G.subtype) = Subgroup.closure L ⊔ pointwiseStab G U := by
    rw [hH', Subgroup.comap_map_eq, Subgroup.map_sup, MonoidHom.map_closure, hsub,
      map_ker_restrictHom]
  rw [← hS]
  ext g
  rw [rb_mem_iso_one_iff hU e hWU, h, mem_leftCoset_iff, SetLike.mem_coe]
  constructor
  · rintro ⟨hg, hgH⟩
    rw [mem_leftCoset_iff, SetLike.mem_coe] at hgH
    refine ⟨⟨τ⁻¹ * g, mul_mem (inv_mem hτ) hg⟩, ?_, rfl⟩
    show ρ (⟨τ, hτ⟩⁻¹ * ⟨g, hg⟩) ∈ H'
    rw [map_mul, map_inv, hττ]
    exact hgH
  · rintro ⟨g', hg', hgg'⟩
    have hg : g ∈ G := by
      have : g = τ * g' := by rw [Subgroup.coe_subtype] at hgg'; rw [hgg']; group
      rw [this]
      exact mul_mem hτ g'.2
    refine ⟨hg, ?_⟩
    rw [mem_leftCoset_iff, SetLike.mem_coe]
    have he : (⟨τ, hτ⟩⁻¹ * ⟨g, hg⟩ : G) = g' := Subtype.ext (by simpa using hgg'.symm)
    rw [← hττ, ← map_inv, ← map_mul, he]
    exact hg'

/-- The same with an outer representative `σ`: the target is normalized to `y ∘ σ`. -/
theorem rb_iso_eq (hWU : W ⊆ U) (σ : Perm Ω) {τ' : Perm α} {H' : Subgroup (Perm α)}
    (h : iso (rbWinSet e W) 1 (restrictHom hU e).range (fun j => x (e j))
      (fun j => y (σ (e j))) = τ' • (H' : Set (Perm α)))
    {τ : Perm Ω} (hτ : τ ∈ G) (hττ : restrictHom hU e ⟨τ, hτ⟩ = τ') {L : Set (Perm Ω)}
    (hLG : L ⊆ G)
    (hL : Subgroup.closure {π | ∃ l, ∃ hl : l ∈ G, l ∈ L ∧ restrictHom hU e ⟨l, hl⟩ = π} = H') :
    iso W σ G x y =
      (σ * τ) • ((Subgroup.closure L ⊔ pointwiseStab G U : Subgroup (Perm Ω)) :
        Set (Perm Ω)) := by
  rw [iso_eq_smul_iso_one, rb_iso_one_eq hU e (y := fun u => y (σ u)) hWU h hτ hττ hLG hL,
    smul_smul]

theorem rb_iso_eq_empty (hWU : W ⊆ U) (σ : Perm Ω)
    (h : iso (rbWinSet e W) 1 (restrictHom hU e).range (fun j => x (e j))
      (fun j => y (σ (e j))) = ∅) :
    iso W σ G x y = ∅ := by
  rw [iso_eq_smul_iso_one, rb_iso_one_eq_empty hU e (y := fun u => y (σ u)) hWU h,
    Set.smul_set_empty]

/-- The reindexed window is invariant under the restricted group. -/
theorem rb_winSet_inv (hW : IsInvariant G W) :
    IsInvariant (restrictHom hU e).range (rbWinSet e W) := by
  rintro _ ⟨g, rfl⟩ j hj
  simp only [rbWinSet, Set.mem_ofPred_eq] at hj ⊢
  rw [restrictHom_apply]
  exact hW g g.2 _ hj

end RestrictSem

/-! ### Faithfulness from a giant base action -/

section Giant

/-- **The alternating group is 2-transitive** on at least four points. -/
theorem rb_alt_two {m : ℕ} (hm : 4 ≤ m) {a b c d : Fin m} (hab : a ≠ b) (hcd : c ≠ d) :
    ∃ q ∈ alternatingGroup (Fin m), q a = c ∧ q b = d := by
  set g : Perm (Fin m) := swap (swap a c b) d * swap a c with hg
  have hca : swap a c b ≠ c := by
    intro h
    have : b = a := by
      have := congrArg (swap a c) h
      simpa using this
    exact hab this.symm
  have hga : g a = c := by
    rw [hg, Perm.mul_apply, swap_apply_left]
    exact swap_apply_of_ne_of_ne (Ne.symm hca) hcd
  have hgb : g b = d := by
    rw [hg, Perm.mul_apply, swap_apply_left]
  rcases Int.units_eq_one_or (Perm.sign g) with hs | hs
  · exact ⟨g, (Perm.mem_alternatingGroup).2 hs, hga, hgb⟩
  · -- two further points to correct the parity
    have hcard : 2 ≤ (Finset.univ.erase a |>.erase b).card := by
      rw [Finset.card_erase_of_mem (Finset.mem_erase.2 ⟨Ne.symm hab, Finset.mem_univ _⟩),
        Finset.card_erase_of_mem (Finset.mem_univ _), Finset.card_univ, Fintype.card_fin]
      omega
    obtain ⟨s, hs', t, ht', hst⟩ := Finset.one_lt_card.1 hcard
    simp only [Finset.mem_erase, Finset.mem_univ, and_true] at hs' ht'
    refine ⟨g * swap s t, ?_, ?_, ?_⟩
    · rw [Perm.mem_alternatingGroup, Perm.sign_mul, hs, Perm.sign_swap hst]
      rfl
    · rw [Perm.mul_apply, swap_apply_of_ne_of_ne (Ne.symm hs'.2) (Ne.symm ht'.2), hga]
    · rw [Perm.mul_apply, swap_apply_of_ne_of_ne (Ne.symm hs'.1) (Ne.symm ht'.1), hgb]

variable {N n : ℕ} {G : Subgroup (Perm (Fin N))} {hinv : IsInvariant G (baseSet n N)}
  {W : Finset (Fin N)} {lab : Fin N → Finset (Fin (N - n))}

/-- Some label is a proper nonempty set, when the group is transitive on the window and the
labels are a hint. -/
theorem rb_proper_label (hh : IsHint (baseHom G n hinv) W lab) (hT : Transitive ↥G W) :
    ∃ u₀ ∈ W, ∃ a b : Fin (N - n), a ∈ lab u₀ ∧ b ∉ lab u₀ := by
  obtain ⟨u, hu, v, hv, hne⟩ := hh.nonconst
  obtain ⟨h, rfl⟩ := hT u hu v hv
  have hvl := hh.equivar h u hu
  refine ⟨u, hu, ?_⟩
  by_cases hemp : lab u = ∅
  · exact absurd (by rw [hvl, hemp, Finset.smul_finset_empty]) hne
  obtain ⟨a, ha⟩ := Finset.nonempty_iff_ne_empty.2 hemp
  by_cases huniv : lab u = Finset.univ
  · exact absurd (by rw [hvl, huniv, Finset.smul_finset_univ]) hne
  obtain ⟨b, hb⟩ : ∃ b, b ∉ lab u := by
    by_contra hcon
    push Not at hcon
    exact huniv (Finset.eq_univ_iff_forall.2 hcon)
  exact ⟨a, b, ha, hb⟩

/-- **An element fixing the window acts trivially on the base**, when the base action is a
giant on at least four points and the labels are a hint on a window on which the group is
transitive. The image of such an element fixes every label; transported by the 2-transitive
alternating group, a nontrivial image would move a point of some label out of it. -/
theorem rb_baseHom_eq_one (hh : IsHint (baseHom G n hinv) W lab) (hT : Transitive ↥G W)
    (hWi : Invariant ↥G W)
    (halt : alternatingGroup (Fin (N - n)) ≤ (baseHom G n hinv).range) (hm : 4 ≤ N - n)
    (g : ↥G) (hg : ∀ u ∈ W, (g : Perm (Fin N)) u = u) : baseHom G n hinv g = 1 := by
  set ψ := baseHom G n hinv
  -- `ψ g` fixes every label
  have hfix : ∀ u ∈ W, ψ g • lab u = lab u := by
    intro u hu
    rw [← hh.equivar g u hu]
    congr 1
    exact hg u hu
  obtain ⟨u₀, hu₀, a, b, ha, hb⟩ := rb_proper_label hh hT
  by_contra hne
  obtain ⟨c, hc⟩ : ∃ c, ψ g c ≠ c := by
    by_contra hcon
    push Not at hcon
    exact hne (Perm.ext hcon)
  have hab : a ≠ b := fun h => hb (h ▸ ha)
  obtain ⟨q, hqA, hqa, hqb⟩ := rb_alt_two hm hab (Ne.symm hc)
  obtain ⟨h, hhq⟩ := halt hqA
  have hu₁ : h • u₀ ∈ W := hWi h u₀ hu₀
  have hl₁ : lab (h • u₀) = q • lab u₀ := by rw [hh.equivar h u₀ hu₀, hhq]
  have hcl : c ∈ lab (h • u₀) := by
    rw [hl₁, ← hqa]
    exact Finset.smul_mem_smul_finset ha
  have hdl : ψ g c ∈ lab (h • u₀) := by
    rw [← hfix _ hu₁]
    exact Finset.smul_mem_smul_finset hcl
  rw [hl₁, ← hqb] at hdl
  exact hb ((Finset.smul_mem_smul_finset_iff q).1 hdl)

end Giant

/-! ### The restricted instance as data -/

section Data

variable {D : Ty}

/-- The restriction set: the window points, then the base positions `[n, N)`. -/
def rbPts (n N : ℕ) (w : WinData) : List ℕ := w.1 ++ basePts n N

/-- The restriction set as a window of degree `N`. -/
def rbU (n N : ℕ) (w : WinData) : WinData := WinData.ofPoints N (rbPts n N w)

/-- The labels re-indexed to the new string positions: position `i` gets the labels of
`w[i]`; base indices are unchanged. -/
def rbLabels (w : WinData) (L : LabelData) : LabelData := (w.1.map fun u => L.getD u []).toArray

/-- The re-indexed labels are no longer than the old ones (stage 14j-6a). -/
theorem labLen_rbLabels_le (w : WinData) (L : LabelData) : labLen (rbLabels w L) ≤ labLen L := by
  refine labLen_le_iff.2 fun l hl => ?_
  simp only [rbLabels, List.toList_toArray] at hl
  obtain ⟨u, -, rfl⟩ := List.mem_map.1 hl
  exact length_getD_le_labLen L u

/-- The generators restricted to the restriction set. -/
def rbGens (n N : ℕ) (w : WinData) (gs : GensData) : GensData :=
  GensData.restrictTo (WinData.pos N (rbU n N w)) (rbPts n N w) gs

/-- **The restricted hinted instance**: degree `|w| + m`, string positions `[0, |w|)` (the
window in list order), base `[|w|, |w| + m)`, the strings `x` and `y ∘ σ` restricted, the
whole string range as window, the identity, the restricted group generated by the backend,
`n₀`, and the re-indexed labels. -/
def rbHInst (O : Oracle (groupSig D)) (xy : StrData × StrData) (w : WinData) (σd : PermData)
    (N : ℕ) (gs : GensData) (n₀ n : ℕ) (L : LabelData) : HInstData D :=
  (((StrData.restrictTo (rbPts n N w) xy.1, StrData.restrictComp (rbPts n N w) xy.2 σd),
    (WinData.ofPoints (rbPts n N w).length (List.range w.1.length),
      (PermData.one (rbPts n N w).length,
        O.run GroupOp.generate ((rbPts n N w).length, rbGens n N w gs)))),
    (n₀, (w.1.length, some (rbLabels w L))))

variable {n N : ℕ} {w : WinData}

theorem rb_length : (rbPts n N w).length = w.1.length + (N - n) := by
  simp [rbPts, length_basePts]

theorem rb_getD_lt {j : ℕ} (hj : j < w.1.length) : (rbPts n N w).getD j 0 = w.1.getD j 0 := by
  simp only [rbPts, List.getD_eq_getElem?_getD, List.getElem?_append_left hj]

theorem rb_getD_ge {j : ℕ} (hj : w.1.length ≤ j) (hj' : j < w.1.length + (N - n)) :
    (rbPts n N w).getD j 0 = n + (j - w.1.length) := by
  simp only [rbPts, List.getD_eq_getElem?_getD, List.getElem?_append_right hj, basePts,
    List.getElem?_map, List.getElem?_range (show j - w.1.length < N - n by omega)]
  rfl

theorem rb_nodup (hw : w.Valid N) (hwin : ∀ i ∈ w.1, i < n) : (rbPts n N w).Nodup := by
  refine List.nodup_append.2 ⟨hw.nodup, basePts_nodup n N, fun a ha b hb => ?_⟩
  have := hwin a ha
  have := (mem_basePts.1 hb).1
  omega

theorem rb_lt (hw : w.Valid N) : ∀ i ∈ rbPts n N w, i < N := by
  intro i hi
  rcases List.mem_append.1 hi with hi | hi
  · exact hw.lt i hi
  · exact (mem_basePts.1 hi).2

theorem rb_valid (hw : w.Valid N) (hwin : ∀ i ∈ w.1, i < n) : (rbU n N w).Valid N :=
  WinData.valid_ofPoints (rb_nodup hw hwin) (rb_lt hw)

/-- The restriction set is invariant when the window and the base are. -/
theorem rb_inv {G : Subgroup (Perm (Fin N))} (hW : IsInvariant G (w.denote N))
    (hB : IsInvariant G (baseSet n N)) : IsInvariant G ((rbU n N w).denote N) := by
  intro g hg u hu
  change u.val ∈ rbPts n N w at hu
  change (g u).val ∈ rbPts n N w
  rcases List.mem_append.1 hu with hu | hu
  · exact List.mem_append_left _ (hW g hg u hu)
  · exact List.mem_append_right _ (mem_basePts.2 ⟨hB g hg u (mem_basePts.1 hu).1, (g u).2⟩)

/-- An index of the restriction set is a window index exactly when its point is a string
position. -/
theorem rb_lt_iff (hwin : ∀ i ∈ w.1, i < n) {k : ℕ} (hk : k < w.1.length + (N - n)) :
    k < w.1.length ↔ (rbPts n N w).getD k 0 < n := by
  constructor
  · intro h
    rw [rb_getD_lt h, List.getD_eq_getElem?_getD, List.getElem?_eq_getElem h]
    exact hwin _ (List.getElem_mem h)
  · intro h
    by_contra h'
    rw [rb_getD_ge (by omega) hk] at h
    omega

end Data

/-! ### The restricted action -/

section Action

variable {N n : ℕ} {G : Subgroup (Perm (Fin N))} {w : WinData}
  (hUv : (rbU n N w).Valid N) (hU : IsInvariant G ((rbU n N w).denote N))

theorem rb_e_val (j : Fin (rbU n N w).1.length) :
    ((WinData.reindex hUv j : Fin N) : ℕ) = (rbPts n N w).getD j 0 :=
  WinData.reindex_val hUv j

/-- The restricted action on indices: `pts[ρ g j] = g pts[j]`. -/
theorem rb_apply (g : G) (j : Fin (rbU n N w).1.length) :
    (rbPts n N w).getD (restrictHom hU (WinData.reindex hUv) g j) 0 =
      ((g : Perm (Fin N)) (WinData.reindex hUv j)).val := by
  rw [← rb_e_val hUv, restrictHom_apply]

variable (hwin : ∀ i ∈ w.1, i < n) (hW : IsInvariant G (w.denote N))
include hwin hW

/-- On window indices: the image is a window index, and its point is the image point. -/
theorem rb_win (g : G) (j : Fin (rbU n N w).1.length) (hj : j.val < w.1.length) :
    (restrictHom hU (WinData.reindex hUv) g j).val < w.1.length ∧
      w.1.getD (restrictHom hU (WinData.reindex hUv) g j) 0 =
        ((g : Perm (Fin N)) (WinData.reindex hUv j)).val := by
  have hM : ∀ k : Fin (rbU n N w).1.length, k.val < w.1.length + (N - n) := by
    intro k
    have := k.2
    change k.val < (rbPts n N w).length at this
    rwa [rb_length] at this
  have hej : ((WinData.reindex hUv j : Fin N) : ℕ) ∈ w.1 := by
    rw [rb_e_val, rb_getD_lt hj, List.getD_eq_getElem?_getD, List.getElem?_eq_getElem hj]
    exact List.getElem_mem hj
  have hgw : ((g : Perm (Fin N)) (WinData.reindex hUv j)).val ∈ w.1 := hW g g.2 _ hej
  have happ := rb_apply hUv hU g j
  have hlt : (restrictHom hU (WinData.reindex hUv) g j).val < w.1.length := by
    rw [rb_lt_iff hwin (hM _), happ]
    exact hwin _ hgw
  exact ⟨hlt, by rw [← happ, rb_getD_lt hlt]⟩

omit hW in
/-- On base indices: the image is a base index, and it moves as `g` moves the base. -/
theorem rb_base (hB : IsInvariant G (baseSet n N)) (g : G) (j : Fin (rbU n N w).1.length)
    (hj : w.1.length ≤ j.val) :
    w.1.length ≤ (restrictHom hU (WinData.reindex hUv) g j).val ∧
      n + ((restrictHom hU (WinData.reindex hUv) g j).val - w.1.length) =
        ((g : Perm (Fin N)) (WinData.reindex hUv j)).val := by
  have hM : ∀ k : Fin (rbU n N w).1.length, k.val < w.1.length + (N - n) := by
    intro k
    have := k.2
    change k.val < (rbPts n N w).length at this
    rwa [rb_length] at this
  have hej : n ≤ ((WinData.reindex hUv j : Fin N) : ℕ) := by
    rw [rb_e_val, rb_getD_ge hj (hM j)]
    omega
  have hgb : n ≤ ((g : Perm (Fin N)) (WinData.reindex hUv j)).val := hB g g.2 _ hej
  have happ := rb_apply hUv hU g j
  have hge : w.1.length ≤ (restrictHom hU (WinData.reindex hUv) g j).val := by
    by_contra h
    push Not at h
    have := (rb_lt_iff hwin (hM _)).1 h
    rw [happ] at this
    omega
  exact ⟨hge, by rw [← happ, rb_getD_ge hge (hM _)]⟩

end Action

/-! ### Validity of the restricted instance -/

section Valid

variable {D : Ty} {DV : ℕ → GensData → D.denote → Prop}

theorem rb_labels_getD {w : WinData} {L : LabelData} {i : ℕ} (hi : i < w.1.length) :
    (rbLabels w L).getD i [] = L.getD (w.1.getD i 0) [] := by
  simp only [rbLabels, Array.getD_eq_getD_getElem?, List.getElem?_toArray, List.getElem?_map,
    List.getD_eq_getElem?_getD, List.getElem?_eq_getElem hi, Option.map_some, Option.getD_some]

theorem rb_getD_mem {w : WinData} {i : ℕ} (hi : i < w.1.length) : w.1.getD i 0 ∈ w.1 := by
  rw [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem hi]
  exact List.getElem_mem hi

section Aux

variable {N n : ℕ} {G : Subgroup (Perm (Fin N))} {w : WinData}
  (hUv : (rbU n N w).Valid N) (hU : IsInvariant G ((rbU n N w).denote N))

theorem rb_e_win {j : Fin (rbU n N w).1.length} (hj : j.val < w.1.length) :
    ((WinData.reindex hUv j : Fin N) : ℕ) = w.1.getD j 0 := by
  rw [rb_e_val, rb_getD_lt hj]

theorem rb_e_base {j : Fin (rbU n N w).1.length} (hj : w.1.length ≤ j.val) :
    ((WinData.reindex hUv j : Fin N) : ℕ) = n + (j.val - w.1.length) := by
  have := j.2
  change j.val < (rbPts n N w).length at this
  rw [rb_length] at this
  rw [rb_e_val, rb_getD_ge hj this]

/-- Transitivity on the new window. -/
theorem rb_trans (htr : IsTransOn G (w.denote N)) (u v : Fin (rbU n N w).1.length)
    (hu : u.val < w.1.length) (hv : v.val < w.1.length) :
    ∃ g : G, restrictHom hU (WinData.reindex hUv) g u = v := by
  have heu : (WinData.reindex hUv u : Fin N).val ∈ w.1 := by
    rw [rb_e_win hUv hu]
    exact rb_getD_mem hu
  have hev : (WinData.reindex hUv v : Fin N).val ∈ w.1 := by
    rw [rb_e_win hUv hv]
    exact rb_getD_mem hv
  obtain ⟨g, hg, hgu⟩ := htr _ heu _ hev
  refine ⟨⟨g, hg⟩, ?_⟩
  apply (WinData.reindex hUv).injective
  apply Subtype.ext
  rw [restrictHom_apply]
  exact hgu

variable (hwin : ∀ i ∈ w.1, i < n) (hW : IsInvariant G (w.denote N))
include hwin hW

/-- An element whose restriction fixes the new window fixes the old one. -/
theorem rb_fixes_win (g : G)
    (hfix : ∀ j : Fin (rbU n N w).1.length, j.val < w.1.length →
      restrictHom hU (WinData.reindex hUv) g j = j) :
    ∀ u ∈ winFinset N w, (g : Perm (Fin N)) u = u := by
  intro u hu
  rw [mem_winFinset] at hu
  obtain ⟨j, hj, hju⟩ := List.getElem_of_mem hu
  have hjM : j < (rbU n N w).1.length := by
    change j < (rbPts n N w).length
    rw [rb_length]
    omega
  have hrw := (rb_win hUv hU hwin hW g ⟨j, hjM⟩ hj).2
  rw [hfix ⟨j, hjM⟩ hj] at hrw
  have he : WinData.reindex hUv ⟨j, hjM⟩ = u := by
    apply Fin.ext
    rw [rb_e_win hUv (show (⟨j, hjM⟩ : Fin _).val < w.1.length from hj)]
    change w.1.getD j 0 = u.val
    rw [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem hj]
    exact hju
  rw [he] at hrw
  apply Fin.ext
  rw [← hrw]
  change w.1.getD j 0 = u.val
  rw [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem hj]
  exact hju

end Aux

/-- **Equivariance of the re-indexed labels** for every element of the restricted group. -/
theorem rb_equivar {N n : ℕ} {gs : GensData} {w : WinData} {L : LabelData}
    (hL : HintValid n N gs w L) (hgs : GensData.AllValid N gs) (hw : w.Valid N)
    (hwin : ∀ i ∈ w.1, i < n) (hW : IsInvariant (GensData.denote N gs) (w.denote N))
    (hB : IsInvariant (GensData.denote N gs) (baseSet n N))
    (hUv : (rbU n N w).Valid N) (hU : IsInvariant (GensData.denote N gs) ((rbU n N w).denote N))
    (g : ↥(GensData.denote N gs)) {i : ℕ} (hi : i < w.1.length) :
    ((rbLabels w L).getD (pAt (restrictHom hU (WinData.reindex hUv) g) i) []).toFinset =
      (((rbLabels w L).getD i []).map fun j =>
        pAt (restrictHom hU (WinData.reindex hUv) g) (w.1.length + j) - w.1.length).toFinset := by
  have hiM : i < (rbU n N w).1.length := by
    change i < (rbPts n N w).length
    rw [rb_length]
    omega
  obtain ⟨hlt, hval⟩ := rb_win hUv hU hwin hW g ⟨i, hiM⟩ hi
  rw [pAt_of_lt _ hiM, rb_labels_getD hlt, hval, rb_labels_getD hi]
  have he : (WinData.reindex hUv ⟨i, hiM⟩ : Fin N) = ⟨w.1.getD i 0, hw.lt _ (rb_getD_mem hi)⟩ := by
    apply Fin.ext
    exact rb_e_win hUv (show (⟨i, hiM⟩ : Fin _).val < w.1.length from hi)
  rw [he]
  -- the base index `j` sits at position `|w| + j`
  have hbase : ∀ j' (hj' : n + j' < N), ∀ hjM : w.1.length + j' < (rbU n N w).1.length,
      pAt (restrictHom hU (WinData.reindex hUv) g) (w.1.length + j') - w.1.length =
        ((g : Perm (Fin N)) ⟨n + j', hj'⟩).val - n := by
    intro j' hj' hjM
    obtain ⟨hge, hb⟩ := rb_base hUv hU hwin hB g ⟨w.1.length + j', hjM⟩ (by simp only; omega)
    have he' : (WinData.reindex hUv ⟨w.1.length + j', hjM⟩ : Fin N) = ⟨n + j', hj'⟩ := by
      apply Fin.ext
      rw [rb_e_base hUv (show w.1.length ≤ (⟨w.1.length + j', hjM⟩ : Fin _).val by
        simp only; omega)]
      simp only
      omega
    rw [he'] at hb
    rw [pAt_of_lt _ hjM]
    omega
  have hlenM : ∀ j' < N - n, w.1.length + j' < (rbU n N w).1.length := by
    intro j' hj'
    change _ < (rbPts n N w).length
    rw [rb_length]
    omega
  ext x
  simp only [List.mem_toFinset, List.mem_map]
  rw [mr_lab_mem_iff hL hgs hw hW g.2 (rb_getD_mem hi)]
  constructor
  · rintro ⟨j', hj', hlt', hgj⟩
    have hj'm := hL.lab_lt _ (rb_getD_mem hi) j' hj'
    refine ⟨j', hj', ?_⟩
    rw [hbase j' (by omega) (hlenM j' hj'm)]
    omega
  · rintro ⟨j', hj', hgj⟩
    have hj'm := hL.lab_lt _ (rb_getD_mem hi) j' hj'
    rw [hbase j' (by omega) (hlenM j' hj'm)] at hgj
    have hgb : n ≤ ((g : Perm (Fin N)) ⟨n + j', by omega⟩).val :=
      hB g g.2 _ (show n ≤ n + j' by omega)
    exact ⟨j', hj', by omega, by omega⟩

/-- **The restricted instance is a valid hinted instance**, when the base action is a giant on
at least four points: an element fixing the window then fixes the base (`rb_baseHom_eq_one`),
so the restricted group is faithful on the new string positions. -/
theorem rbHInst_valid {O : Oracle (groupSig D)} (hO : MeetsContractOn DV (· = .generate) O)
    {xy : StrData × StrData} {w : WinData} {σd : PermData} {N : ℕ} {gs : GensData}
    {d : D.denote} {n₀ n : ℕ} {L : LabelData}
    (hI : HInstValid DV (((xy, (w, (σd, (N, gs, d)))), (n₀, (n, some L))) : HInstData D))
    {hB : IsInvariant (GensData.denote N gs) (baseSet n N)}
    (halt : alternatingGroup (Fin (N - n)) ≤ (baseHom (GensData.denote N gs) n hB).range)
    (hm : 4 ≤ N - n) :
    HInstValid DV (rbHInst O xy w σd N gs n₀ n L) := by
  obtain ⟨⟨hw, -, hgv, hW⟩, hle, -, hwin, -, hhint⟩ := hI
  change WinData.Valid N w at hw
  change GroupValid DV N gs d at hgv
  change IsInvariant (GensData.denote N gs) (w.denote N) at hW
  change n ≤ N at hle
  change ∀ i ∈ w.1, i < n at hwin
  obtain ⟨hL, htr⟩ := hhint L rfl
  change HintValid n N gs w L at hL
  change IsTransOn (GensData.denote N gs) (w.denote N) at htr
  have hUv := rb_valid (n := n) hw hwin
  have hU := rb_inv (n := n) hW hB
  have hg'v := GensData.allValid_restrictTo hU hUv hgv.1
  have hg'den := GensData.denote_restrictTo hU hUv hgv.1
  have hpost := hO .generate ((rbPts n N w).length, rbGens n N w gs) rfl hg'v
  rcases hG' : O.run GroupOp.generate ((rbPts n N w).length, rbGens n N w gs) with
    ⟨M', gs', d'⟩
  rw [hG'] at hpost
  obtain ⟨hM', hGv', hden'⟩ := hpost
  subst hM'
  have hden : GensData.denote (rbPts n N w).length gs' =
      (restrictHom hU (WinData.reindex hUv)).range := hden'.trans hg'den
  have hMlen : (rbPts n N w).length = w.1.length + (N - n) := rb_length
  have hwinR : ∀ π ∈ GensData.denote (rbPts n N w).length gs',
      ∀ j : Fin (rbPts n N w).length, j.val < w.1.length → (π j).val < w.1.length := by
    intro π hπ j hj
    rw [hden] at hπ
    obtain ⟨g, rfl⟩ := hπ
    exact (rb_win hUv hU hwin hW g j hj).1
  have hbaseR : IsInvariant (GensData.denote (rbPts n N w).length gs')
      (baseSet w.1.length (rbPts n N w).length) := by
    intro π hπ j hj
    rw [hden] at hπ
    obtain ⟨g, rfl⟩ := hπ
    exact (rb_base hUv hU hwin hB g j hj).1
  have hW'v : (WinData.ofPoints (rbPts n N w).length (List.range w.1.length)).Valid
      (rbPts n N w).length :=
    WinData.valid_ofPoints List.nodup_range fun i hi => by
      have := List.mem_range.1 hi
      omega
  have hT : Transitive ↥(GensData.denote N gs) (winFinset N w) := by
    intro u hu v hv
    rw [mem_winFinset] at hu hv
    obtain ⟨g, hg, hgu⟩ := htr u hu v hv
    exact ⟨⟨g, hg⟩, hgu⟩
  have hWi : Invariant ↥(GensData.denote N gs) (winFinset N w) := by
    intro g u hu
    rw [mem_winFinset] at hu ⊢
    exact hW g g.2 u hu
  have hh := hL.isHint hgv.1 hw hW
  simp only [rbHInst]
  rw [hG']
  refine ⟨⟨hW'v, PermData.valid_one _, hGv', ?_⟩, ?_, hbaseR, ?_, ?_, ?_⟩
  · -- the window is invariant
    intro π hπ j hj
    change j.val ∈ List.range w.1.length at hj
    change (π j).val ∈ List.range w.1.length
    exact List.mem_range.2 (hwinR π hπ j (List.mem_range.1 hj))
  · change w.1.length ≤ (rbPts n N w).length
    omega
  · intro i hi
    exact List.mem_range.1 hi
  · -- faithful on the new string positions
    change ∀ π ∈ GensData.denote (rbPts n N w).length gs',
      (∀ j : Fin (rbPts n N w).length, j.val < w.1.length → π j = j) → π = 1
    intro π hπ hfix
    rw [hden] at hπ
    obtain ⟨g, rfl⟩ := hπ
    have hgw := rb_fixes_win hUv hU hwin hW g hfix
    have h1 := rb_baseHom_eq_one hh hT hWi halt hm g hgw
    have hgb : ∀ x : Fin N, n ≤ x.val → (g : Perm (Fin N)) x = x := by
      intro x hx
      have hb := baseHom_apply (hG := hB) g ⟨x.val - n, by have := x.2; omega⟩
      have hx' : basePos (n := n) (⟨x.val - n, by have := x.2; omega⟩ : Fin (N - n)) = x := by
        apply Fin.ext
        simp only [basePos]
        omega
      rw [h1, Perm.one_apply, hx'] at hb
      exact hb.symm
    apply (restrictHom_eq_one_iff hU (WinData.reindex hUv) g).2
    refine ⟨g.2, fun u hu => ?_⟩
    change u.val ∈ rbPts n N w at hu
    rcases List.mem_append.1 hu with hu | hu
    · exact hgw u (mem_winFinset.2 hu)
    · exact hgb u (mem_basePts.1 hu).1
  · -- the labels
    intro L₀ hL₀
    cases hL₀
    change HintValid w.1.length (rbPts n N w).length gs'
        (WinData.ofPoints (rbPts n N w).length (List.range w.1.length)) (rbLabels w L) ∧
      IsTransOn (GensData.denote (rbPts n N w).length gs')
        ((WinData.ofPoints (rbPts n N w).length (List.range w.1.length)).denote
          (rbPts n N w).length)
    refine ⟨hintValid_of_forall ?_ hGv'.1 hbaseR (fun i hi => List.mem_range.1 hi) ?_ ?_ ?_ ?_,
      ?_⟩
    · omega
    · intro i hi j hj
      have hi' := List.mem_range.1 hi
      rw [rb_labels_getD hi'] at hj
      have := hL.lab_lt _ (rb_getD_mem hi') j hj
      omega
    · intro i hi
      have hi' := List.mem_range.1 hi
      rw [rb_labels_getD hi']
      exact hL.lab_nodup _ (rb_getD_mem hi')
    · intro π hπ i hi
      rw [hden] at hπ
      obtain ⟨g, rfl⟩ := hπ
      exact rb_equivar hL hgv.1 hw hwin hW hB hUv hU g (List.mem_range.1 hi)
    · obtain ⟨a, ha, b, hb, hne⟩ := hL.nonconst
      obtain ⟨ia, hia, rfl⟩ := List.getElem_of_mem ha
      obtain ⟨ib, hib, rfl⟩ := List.getElem_of_mem hb
      refine ⟨ia, List.mem_range.2 hia, ib, List.mem_range.2 hib, ?_⟩
      rw [rb_labels_getD hia, rb_labels_getD hib, List.getD_eq_getElem?_getD,
        List.getElem?_eq_getElem hia, List.getD_eq_getElem?_getD, List.getElem?_eq_getElem hib]
      exact hne
    · intro u hu v hv
      have hu' : u.val < w.1.length := List.mem_range.1 hu
      have hv' : v.val < w.1.length := List.mem_range.1 hv
      obtain ⟨g, hg⟩ := rb_trans hUv hU htr u v hu' hv'
      exact ⟨_, by rw [hden]; exact ⟨g, rfl⟩, hg⟩

end Valid

/-! ### Lifting answers through the restriction -/

section Lift

variable {D : Ty} {DV : ℕ → GensData → D.denote → Prop} {n : ℕ} {U w : WinData}
  {gs : GensData}

/-- No restricted solution, no solution. -/
theorem AnsOK.rb_none (hU : U.Valid n) {σd : PermData}
    (hUi : IsInvariant (GensData.denote n gs) (U.denote n)) (hwU : w.denote n ⊆ U.denote n)
    {x y : StrData}
    (h' : AnsOK DV U.1.length (rbWinSet (WinData.reindex hU) (w.denote n)) 1
      (restrictHom hUi (WinData.reindex hU)).range
      (fun j => StrData.denote n x (WinData.reindex hU j))
      (fun j => StrData.denote n y (PermData.denote n σd (WinData.reindex hU j)))
      (none : AnswerData D)) :
    AnsOK DV n (w.denote n) (PermData.denote n σd) (GensData.denote n gs) (x.denote n)
      (y.denote n) (none : AnswerData D) :=
  rb_iso_eq_empty hUi (WinData.reindex hU) hwU _ h'

/-- **Lifting a restricted answer** through the restriction to `U ⊇ w`. -/
theorem AnsOK.rb_lift (hU : U.Valid n) {σd : PermData} (hσ : σd.Valid n)
    (hUi : IsInvariant (GensData.denote n gs) (U.denote n)) (hwU : w.denote n ⊆ U.denote n)
    {x y : StrData} {τ' : PermData} {Hd' : GroupData D.denote}
    (h' : AnsOK DV U.1.length (rbWinSet (WinData.reindex hU) (w.denote n)) 1
      (restrictHom hUi (WinData.reindex hU)).range
      (fun j => StrData.denote n x (WinData.reindex hU j))
      (fun j => StrData.denote n y (PermData.denote n σd (WinData.reindex hU j)))
      (some (τ', Hd')))
    {τ : PermData} (hτ : τ.Valid n) (hτG : PermData.denote n τ ∈ GensData.denote n gs)
    (hττ : MapsWindowBy U τ τ') {lf : PermData → PermData}
    (hlf : ∀ h ∈ Hd'.gens, (lf h).Valid n ∧ PermData.denote n (lf h) ∈ GensData.denote n gs ∧
      MapsWindowBy U (lf h) h)
    {ks : GensData}
    (hks : GensData.denote n ks = pointwiseStab (GensData.denote n gs) (U.denote n))
    {Hd : GroupData D.denote} (hHd : Hd.degree = n) (hHv : GroupValid DV n Hd.gens Hd.data)
    (hHden : GensData.denote n Hd.gens = GensData.denote n (ks ++ Hd'.gens.map lf)) :
    AnsOK DV n (w.denote n) (PermData.denote n σd) (GensData.denote n gs) (x.denote n)
      (y.denote n) (some (σd.mul τ, Hd)) := by
  obtain ⟨hτ'v, -, hH'v, hiso⟩ := h'
  set e := WinData.reindex hU
  set ρ := restrictHom hUi e
  have hρτ : ρ ⟨PermData.denote n τ, hτG⟩ = PermData.denote U.1.length τ' :=
    (mapsWindowBy_iff hUi hU hτ hτG hτ'v).1 hττ
  have hL : Subgroup.closure {π | ∃ l, ∃ hl : l ∈ GensData.denote n gs,
      l ∈ GensData.denoteSet n (Hd'.gens.map lf) ∧ ρ ⟨l, hl⟩ = π} =
      GensData.denote U.1.length Hd'.gens := by
    unfold GensData.denote
    congr 1
    ext π
    simp only [GensData.denoteSet, List.mem_map, Set.mem_ofPred_eq]
    constructor
    · rintro ⟨_, hl, ⟨_, ⟨h, hh, rfl⟩, rfl⟩, rfl⟩
      exact ⟨h, hh, ((mapsWindowBy_iff hUi hU (hlf h hh).1 hl (hH'v.1 h hh)).1
        (hlf h hh).2.2).symm⟩
    · rintro ⟨h, hh, rfl⟩
      exact ⟨_, (hlf h hh).2.1, ⟨lf h, ⟨h, hh, rfl⟩, rfl⟩,
        (mapsWindowBy_iff hUi hU (hlf h hh).1 (hlf h hh).2.1 (hH'v.1 h hh)).1 (hlf h hh).2.2⟩
  have hLG : GensData.denoteSet n (Hd'.gens.map lf) ⊆ GensData.denote n gs := by
    rintro _ ⟨_, hl, rfl⟩
    obtain ⟨h, hh, rfl⟩ := List.mem_map.1 hl
    exact (hlf h hh).2.1
  have hmain := rb_iso_eq hUi e (x := x.denote n) (y := y.denote n) hwU
    (PermData.denote n σd) hiso.symm hτG hρτ hLG hL
  refine ⟨hσ.mul hτ, hHd, hHv, ?_⟩
  rw [hmain, PermData.denote_mul hσ hτ, hHden, GensData.denote_append, hks, sup_comm]
  rfl

end Lift

/-! ### The lifting program on a window inside the restriction set -/

section LiftProg

variable {D : Ty} {a b : Ty} {X : Ctx (groupSig D)}
  {body : a.denote → Prog (groupSig D) (a, b) Ty.denote b} {DV : ℕ → GensData → D.denote → Prop}

/-- `liftAnswerProg` (stage 1's lifting, through the restriction set `U`) for an answer of the
restricted instance on the reindexed window `w ⊆ U`. -/
theorem RunsWithin.rbLiftProg (hO : MeetsContractOn DV restrictOps X.O)
    (hPre : ∀ op x, restrictOps op → GroupPre DV op x → X.Pre op x)
    {xy : StrData × StrData} {U w : WinData} {σd : PermData} {n : ℕ} {gs : GensData}
    {d : D.denote} (hU : U.Valid n) (hσ : σd.Valid n) (hgv : GroupValid DV n gs d)
    (hUi : IsInvariant (GensData.denote n gs) (U.denote n))
    (hWi : IsInvariant (GensData.denote n gs) (w.denote n)) (hwU : w.denote n ⊆ U.denote n)
    {τ' : PermData} {Hd' : GroupData D.denote}
    (h' : AnsOK DV U.1.length (rbWinSet (WinData.reindex hU) (w.denote n)) 1
      (restrictHom hUi (WinData.reindex hU)).range
      (fun j => StrData.denote n xy.1 (WinData.reindex hU j))
      (fun j => StrData.denote n xy.2 (PermData.denote n σd (WinData.reindex hU j)))
      (some (τ', Hd')))
    {s' sK Blift Bker Bgn : ℕ} (hs' : Hd'.gens.length ≤ s')
    (hBlift : ∀ π' : PermData, X.B.call GroupOp.lift ((n, gs, d), (U, π'))
      (X.O.run GroupOp.lift ((n, gs, d), (U, π'))) ≤ Blift)
    (hBker : X.B.call GroupOp.kernel ((n, gs, d), U) (X.O.run GroupOp.kernel ((n, gs, d), U)) ≤
      Bker)
    (hsK : (X.O.run GroupOp.kernel ((n, gs, d), U)).2.1.length ≤ sK)
    (hBgn : ∀ hs : GensData, GensData.AllValid n hs → hs.length ≤ sK + s' →
      GensData.denote n hs ≤ GensData.denote n gs →
      X.B.call GroupOp.generate (n, hs) (X.O.run GroupOp.generate (n, hs)) ≤ Bgn) :
    ∃ ans : AnswerData D,
      RunsWithin X body (Programs.liftAnswerProg n σd (n, gs, d) U (τ', Hd')) ans
        (liftCost n s' sK Blift Bker Bgn) ∧
      AnsOK DV n (w.denote n) (PermData.denote n σd) (GensData.denote n gs) (xy.1.denote n)
        (xy.2.denote n) ans ∧
      ∀ sGen, (∀ hs, GensData.AllValid n hs → GensData.denote n hs ≤ GensData.denote n gs →
          (X.O.run GroupOp.generate (n, hs)).2.1.length ≤ sGen) →
        ∀ c : CosetData D, ans = some c → c.2.gens.length ≤ sGen := by
  have hτ'v : τ'.Valid U.1.length := h'.1
  have hH'v : GensData.AllValid U.1.length Hd'.gens := h'.2.2.1.1
  have hτ'mem : PermData.denote U.1.length τ' ∈ (restrictHom hUi (WinData.reindex hU)).range := by
    have h := h'.2.2.2
    have hself : PermData.denote U.1.length τ' ∈ PermData.denote U.1.length τ' •
        (GensData.denote U.1.length Hd'.gens : Set (Perm (Fin U.1.length))) :=
      self_mem_leftCoset _ _
    rw [h, mem_iso_one] at hself
    exact hself.1
  have hHmem : ∀ h ∈ Hd'.gens,
      PermData.denote U.1.length h ∈ (restrictHom hUi (WinData.reindex hU)).range := by
    intro h hh
    have haut := AnsOK.eq_aut (rb_winSet_inv hUi (WinData.reindex hU) hWi) h'
    exact aut_le _ _ (haut ▸ GensData.mem_denote_of_mem hh)
  have hpre : ∀ π' : PermData, π'.Valid U.1.length →
      PermData.denote U.1.length π' ∈ (restrictHom hUi (WinData.reindex hU)).range →
      GroupPre DV .lift ((n, gs, d), (U, π')) := fun π' hπ hm =>
    ⟨hgv, hU, hUi, hπ, exists_lift hUi hU hπ hm⟩
  have hliftPost : ∀ π' : PermData, π'.Valid U.1.length →
      PermData.denote U.1.length π' ∈ (restrictHom hUi (WinData.reindex hU)).range →
      GroupPost DV .lift ((n, gs, d), (U, π')) (X.O.run GroupOp.lift ((n, gs, d), (U, π'))) :=
    fun π' hπ hm => hO .lift _ (Or.inr (Or.inl rfl)) (hpre π' hπ hm)
  obtain ⟨hτv, hτG, hττ⟩ := hliftPost τ' hτ'v hτ'mem
  have hlf : ∀ h ∈ Hd'.gens, PermData.Valid n (liftOf X.O (n, gs, d) U h) ∧
      PermData.denote n (liftOf X.O (n, gs, d) U h) ∈ GensData.denote n gs ∧
      MapsWindowBy U (liftOf X.O (n, gs, d) U h) h :=
    fun h hh => hliftPost h (hH'v h hh) (hHmem h hh)
  have hkpre : GroupPre DV .kernel ((n, gs, d), U) := ⟨hgv, hU, hUi⟩
  have hkpost := hO .kernel _ (Or.inr (Or.inr rfl)) hkpre
  rcases hK : X.O.run GroupOp.kernel ((n, gs, d), U) with ⟨n', ks, e'⟩
  rw [hK] at hkpost hBker hsK
  change ks.length ≤ sK at hsK
  obtain ⟨hn', hksv, hksden⟩ := hkpost
  subst n'
  have hhsv : GensData.AllValid n (ks ++ Hd'.gens.map (liftOf X.O (n, gs, d) U)) := by
    refine GensData.AllValid.append hksv.1 fun l hl => ?_
    obtain ⟨h, hh, rfl⟩ := List.mem_map.1 hl
    exact (hlf h hh).1
  have hhsle : GensData.denote n (ks ++ Hd'.gens.map (liftOf X.O (n, gs, d) U)) ≤
      GensData.denote n gs := by
    rw [GensData.denote_append, sup_le_iff]
    refine ⟨?_, GensData.denote_le_iff.2 fun l hl => ?_⟩
    · change GensData.denote n ks ≤ _
      rw [hksden]
      exact pointwiseStab_le _ _
    · obtain ⟨h, hh, rfl⟩ := List.mem_map.1 hl
      exact (hlf h hh).2.1
  have hhslen : (ks ++ Hd'.gens.map (liftOf X.O (n, gs, d) U)).length ≤ sK + s' := by
    simp only [List.length_append, List.length_map]
    omega
  have hgpost := hO .generate (n, ks ++ Hd'.gens.map (liftOf X.O (n, gs, d) U)) (Or.inl rfl)
    hhsv
  have hBg := hBgn _ hhsv hhslen hhsle
  rcases hH : X.O.run GroupOp.generate (n, ks ++ Hd'.gens.map (liftOf X.O (n, gs, d) U)) with
    ⟨n'', hs'', e''⟩
  rw [hH] at hgpost hBg
  obtain ⟨hn'', hHv, hHden⟩ := hgpost
  subst n''
  refine ⟨some (σd.mul (X.O.run GroupOp.lift ((n, gs, d), (U, τ'))), (n, hs'', e'')), ?_, ?_, ?_⟩
  · have hmap := RunsWithin.mapList_le (X := X) (body := body) (a' := Ty.perm) (b' := Ty.perm)
      (xs := Hd'.gens) (c := Blift + 2)
      (F := liftOf X.O (n, gs, d) U)
      (f := fun h => .bind (.op2 .pair U h) fun wh => .bind (.op2 .pair (n, gs, d) wh) fun ah =>
        Prog.call (S := groupSig D) GroupOp.lift ah) fun h hh => by
      apply RunsWithin.mono
      case h =>
        run_step (RunsWithin.prim _ _)
        run_step (RunsWithin.prim _ _)
        exact RunsWithin.call (hPre _ _ (Or.inr (Or.inl rfl)) (hpre h (hH'v h hh) (hHmem h hh)))
      case hc =>
        simp only [Prim.cost, Prim.eval]
        have := hBlift h
        omega
    have hmul : Hd'.gens.length * (Blift + 2 + 3) ≤ s' * (Blift + 5) :=
      Nat.mul_le_mul hs' le_rfl
    apply RunsWithin.mono
    case h =>
      run_step (RunsWithin.prim _ _)
      run_step (RunsWithin.prim _ _)
      run_step (RunsWithin.prim _ _)
      run_step (RunsWithin.prim _ _)
      run_step (RunsWithin.prim _ _)
      run_step (RunsWithin.prim _ _)
      run_step (RunsWithin.call (hPre _ _ (Or.inr (Or.inl rfl)) (hpre τ' hτ'v hτ'mem)))
      run_step hmap
      run_step (RunsWithin.prim _ _)
      run_step (RunsWithin.call (hPre _ _ (Or.inr (Or.inr rfl)) hkpre))
      simp only [Prim.eval]
      rw [hK]
      run_step (RunsWithin.prim _ _)
      run_step (RunsWithin.prim _ _)
      run_step (RunsWithin.prim _ _)
      run_step (RunsWithin.prim _ _)
      run_step (RunsWithin.call (hPre _ _ (Or.inl rfl) hhsv))
      simp only [Prim.eval]
      rw [hH]
      run_step (RunsWithin.permMul hσ hτv)
      run_step (RunsWithin.prim _ _)
      exact RunsWithin.prim _ _
    case hc =>
      simp only [Prim.cost, Prim.eval, Args.head_cons, liftCost]
      rw [hK, hH]
      have := hBlift τ'
      clear * - this hBker hBg hsK hmul
      omega
  · exact AnsOK.rb_lift hU hσ hUi hwU h' hτv hτG hττ hlf hksden rfl hHv hHden
  · intro sGen hgen c hc
    cases hc
    have := hgen _ hhsv hhsle
    rw [hH] at this
    exact this

end LiftProg

/-! ### The program -/

section Programs

variable {D : Ty} {S : Signature} {rec : Ty × Ty} {var : Ty → Type}

/-- The restriction set `w ++ [n, N)`. -/
def rbPtsProg (n N : var .nat) (wl : var (.list .nat)) : Prog S rec var (.list .nat) :=
  .bind (.op2 .sub N n) fun m => .bind (.op1 .range m) fun js =>
  .bind (mapList js fun j => .op2 .add n j) fun bs => .op2 .append wl bs

/-- The re-indexed labels. -/
def rbLabelsProg (L : var (.array (.list .nat))) (wl : var (.list .nat)) :
    Prog S rec var (.array (.list .nat)) :=
  .bind (mapList wl fun u => .op2 .arrayGet L u) fun l => .op1 .arrayOfList l

/-- **Restriction to the window and the base.** For the hinted instance `I` with labels `L`:
the restricted hinted instance (`rbHInst`), the continuation `cont` on it, and its answer
lifted back through the restriction set with the kernel (`liftAnswerProg`). -/
def restrictBaseProg (cont : var (hinstTy D) → Prog (groupSig D) rec var (Ty.answer D))
    (I : var (hinstTy D)) (L : var (.array (.list .nat))) :
    Prog (groupSig D) rec var (Ty.answer D) :=
  .bind (.op1 .fst I) fun J => .bind (.op1 .snd I) fun r₁ => .bind (.op1 .fst r₁) fun n₀ =>
  .bind (.op1 .snd r₁) fun r₂ => .bind (.op1 .fst r₂) fun n =>
  .bind (.op1 .fst J) fun xy => .bind (.op1 .snd J) fun wc =>
  .bind (.op1 .fst wc) fun w => .bind (.op1 .snd wc) fun c =>
  .bind (.op1 .fst c) fun σ => .bind (.op1 .snd c) fun G =>
  .bind (.op1 .fst G) fun N => .bind (.op1 .snd G) fun gd => .bind (.op1 .fst gd) fun gs =>
  .bind (.op1 .fst xy) fun x => .bind (.op1 .snd xy) fun y =>
  .bind (.op1 .fst w) fun wl => .bind (.op1 .length wl) fun k =>
  .bind (rbPtsProg n N wl) fun pts => .bind (.op1 .length pts) fun M =>
  .bind (mkWindow N pts) fun U => .bind (posProg N pts) fun pos =>
  .bind (restrictStrProg pts x) fun x' => .bind (restrictCompProg pts y σ) fun y' =>
  .bind (mapList gs fun g => restrictPermProg pos pts g) fun gs' =>
  .bind (.op2 .pair M gs') fun arg =>
  .bind (Prog.call (S := groupSig D) GroupOp.generate arg) fun G' =>
  .bind (.op1 .range k) fun js => .bind (mkWindow M js) fun w' =>
  .bind (permOne M) fun one =>
  .bind (rbLabelsProg L wl) fun L' => .bind (.op1 .some L') fun sL' =>
  .bind (.op2 .pair one G') fun c' => .bind (.op2 .pair w' c') fun wc' =>
  .bind (.op2 .pair x' y') fun xy' => .bind (.op2 .pair xy' wc') fun J' =>
  .bind (.op2 .pair k sL') fun q₂ => .bind (.op2 .pair n₀ q₂) fun q₁ =>
  .bind (.op2 .pair J' q₁) fun I' =>
  .bind (cont I') fun ans =>
  .caseOption ans (.op0 .none) fun c'' => liftAnswerProg N σ G U c''

end Programs

section Specs

variable {D : Ty} {a b : Ty} {X : Ctx (groupSig D)}
  {body : a.denote → Prog (groupSig D) (a, b) Ty.denote b} {DV : ℕ → GensData → D.denote → Prop}

theorem RunsWithin.rbPtsProg (n N : ℕ) (w : WinData) :
    RunsWithin X body (Main.rbPtsProg n N w.1) (rbPts n N w)
      (w.1.length + 5 * (N - n) + 6) := by
  apply RunsWithin.mono
  case h =>
    run_step (RunsWithin.prim _ _)
    run_step (RunsWithin.prim _ _)
    run_step (RunsWithin.mapList_le (c := 1) (F := fun j => n + j) fun j _ =>
      RunsWithin.prim _ _)
    exact RunsWithin.prim_le rfl le_rfl
  case hc =>
    simp only [Prim.cost, Prim.eval, Args.head, List.length_range]
    omega

theorem RunsWithin.rbLabelsProg (L : LabelData) (wl : List ℕ) :
    RunsWithin X body (Main.rbLabelsProg L wl) ((wl.map fun u => L.getD u []).toArray)
      (5 * wl.length + 3) := by
  apply RunsWithin.mono
  case h =>
    run_step (RunsWithin.mapList_le (c := 1) (F := fun u => L.getD u []) fun u _ =>
      RunsWithin.prim _ _)
    exact RunsWithin.prim_le rfl le_rfl
  case hc =>
    simp only [Prim.cost, Args.head, List.length_map]
    omega

/-- The new window is the reindexed old window. -/
theorem rb_winSet_eq {n N : ℕ} {w : WinData} (hwin : ∀ i ∈ w.1, i < n)
    (hUv : (rbU n N w).Valid N) :
    (WinData.ofPoints (rbU n N w).1.length (List.range w.1.length)).denote
        (rbU n N w).1.length =
      rbWinSet (WinData.reindex hUv) (w.denote N) := by
  ext j
  change j.val ∈ List.range w.1.length ↔ (WinData.reindex hUv j : Fin N).val ∈ w.1
  rw [List.mem_range, rb_e_val]
  have hjM : j.val < w.1.length + (N - n) := by
    have := j.2
    change j.val < (rbPts n N w).length at this
    rwa [rb_length] at this
  constructor
  · intro hj
    rw [rb_getD_lt hj]
    exact rb_getD_mem hj
  · intro hj
    exact (rb_lt_iff hwin hjM).2 (hwin _ hj)

/-- The cost of the restriction step, for degree `N`, a window of `k` points, a base of `m`
points, `s` generators, a continuation of cost `C'` returning at most `s'` generators, a kernel
of at most `sK` generators, and the charges `Bgm` (the restricted group), `Blift`, `Bker` and
`Bgn` (the lifted group). -/
def rbCost (N k m s C' s' sK Bgm Blift Bker Bgn : ℕ) : ℕ :=
  4 * N + 30 * (k + m) + 13 * k + 5 * m + s * (12 * (k + m) + 12) + Bgm + C' +
    liftCost N s' sK Blift Bker Bgn + 100

end Specs

section MainSpec

variable {D : Ty} {a b : Ty} {X : Ctx (groupSig D)}
  {body : a.denote → Prog (groupSig D) (a, b) Ty.denote b} {DV : ℕ → GensData → D.denote → Prop}

/-- The run of `restrictBaseProg` up to the continuation's answer. -/
theorem rb_prefix {cont : HInstData D → Prog (groupSig D) (a, b) Ty.denote (Ty.answer D)}
    {xy : StrData × StrData} {w : WinData} {σd : PermData} {N : ℕ} {gs : GensData}
    {d : D.denote} {n₀ n : ℕ} {L : LabelData} {gs'' : GensData} {d'' : D.denote}
    {Bgm C' : ℕ} {a' : AnswerData D}
    (hpre : X.Pre GroupOp.generate ((rbPts n N w).length,
      gs.map (PermData.restrictTo (WinData.pos N (rbU n N w)) (rbPts n N w))))
    (hG2 : X.O.run GroupOp.generate
      ((rbPts n N w).length, gs.map (PermData.restrictTo (WinData.pos N (rbU n N w))
        (rbPts n N w))) = ((rbPts n N w).length, gs'', d''))
    (hBgm2 : X.B.call GroupOp.generate
      ((rbPts n N w).length, gs.map (PermData.restrictTo (WinData.pos N (rbU n N w))
        (rbPts n N w))) ((rbPts n N w).length, gs'', d'') ≤ Bgm)
    (hMlen : (rbPts n N w).length = w.1.length + (N - n))
    (ha' : RunsWithin X body (cont
      (((StrData.restrictTo (rbPts n N w) xy.1, StrData.restrictComp (rbPts n N w) xy.2 σd),
        (WinData.ofPoints (rbPts n N w).length (List.range w.1.length),
          (PermData.one (rbPts n N w).length, ((rbPts n N w).length, gs'', d'')))),
        (n₀, (w.1.length, some (rbLabels w L))))) a' C')
    {ans : AnswerData D} {c : ℕ}
    (h : RunsWithin X body (.caseOption a' (.op0 .none) fun c'' =>
      Programs.liftAnswerProg N σd (N, gs, d) (rbU n N w) c'') ans c) :
    RunsWithin X body (Main.restrictBaseProg cont
        (((xy, (w, (σd, (N, gs, d)))), (n₀, (n, some L))) : HInstData D) L) ans
      (4 * N + 30 * (w.1.length + (N - n)) + 13 * w.1.length + 5 * (N - n) +
        gs.length * (12 * (w.1.length + (N - n)) + 12) + Bgm + C' + 90 + c) := by
  have hmap := RunsWithin.mapList_le (X := X) (body := body) (a' := Ty.perm) (b' := Ty.perm)
    (xs := gs) (c := 12 * (rbPts n N w).length + 9)
    (F := PermData.restrictTo (WinData.pos N (rbU n N w)) (rbPts n N w))
    (f := fun g => Programs.restrictPermProg (WinData.pos N (rbU n N w)) (rbPts n N w) g)
    fun g _ => RunsWithin.restrictPermProg _ _ _
  apply RunsWithin.mono
  case h =>
    run_step (RunsWithin.prim _ _)
    run_step (RunsWithin.prim _ _)
    run_step (RunsWithin.prim _ _)
    run_step (RunsWithin.prim _ _)
    run_step (RunsWithin.prim _ _)
    run_step (RunsWithin.prim _ _)
    run_step (RunsWithin.prim _ _)
    run_step (RunsWithin.prim _ _)
    run_step (RunsWithin.prim _ _)
    run_step (RunsWithin.prim _ _)
    run_step (RunsWithin.prim _ _)
    run_step (RunsWithin.prim _ _)
    run_step (RunsWithin.prim _ _)
    run_step (RunsWithin.prim _ _)
    run_step (RunsWithin.prim _ _)
    run_step (RunsWithin.prim _ _)
    run_step (RunsWithin.prim _ _)
    run_step (RunsWithin.prim _ _)
    run_step (RunsWithin.rbPtsProg n N w)
    run_step (RunsWithin.prim _ _)
    run_step (RunsWithin.mkWindow N (rbPts n N w))
    run_step (RunsWithin.posProg N (rbU n N w))
    run_step (RunsWithin.restrictStrProg (rbPts n N w) xy.1)
    run_step (RunsWithin.restrictCompProg (rbPts n N w) xy.2 σd)
    run_step hmap
    run_step (RunsWithin.prim _ _)
    run_step (RunsWithin.call hpre)
    simp only [Prim.eval]
    rw [hG2]
    run_step (RunsWithin.prim _ _)
    run_step (RunsWithin.mkWindow _ _)
    run_step (RunsWithin.permOne _)
    run_step (RunsWithin.rbLabelsProg L w.1)
    run_step (RunsWithin.prim _ _)
    run_step (RunsWithin.prim _ _)
    run_step (RunsWithin.prim _ _)
    run_step (RunsWithin.prim _ _)
    run_step (RunsWithin.prim _ _)
    run_step (RunsWithin.prim _ _)
    run_step (RunsWithin.prim _ _)
    run_step (RunsWithin.prim _ _)
    run_step ha'
    exact h
  case hc =>
    simp only [Prim.cost, Prim.eval, Args.head, List.length_range]
    rw [hG2]
    generalize X.B.call GroupOp.generate
      ((rbPts n N w).length, gs.map (PermData.restrictTo (WinData.pos N (rbU n N w))
        (rbPts n N w))) ((rbPts n N w).length, gs'', d'') = B at hBgm2 ⊢
    have hmul : gs.length * (12 * (rbPts n N w).length + 9 + 3) ≤
        gs.length * (12 * (w.1.length + (N - n)) + 12) := by
      rw [hMlen]
    have hUlen : (rbU n N w).1.length = (rbPts n N w).length := rfl
    rw [hUlen]
    clear * - hBgm2 hMlen hmul
    generalize (rbPts n N w).length = M at hMlen hmul ⊢
    subst hMlen
    generalize w.1.length = k at hmul ⊢
    generalize N - n = m at hmul ⊢
    generalize gs.length * (12 * (k + m) + (9 + 3)) = P at hmul ⊢
    generalize gs.length * (12 * (k + m) + 12) = Q at hmul ⊢
    linarith

/-- **Restriction to the window and the base.** If the continuation solves the restricted
hinted instance (`rbHInst`, valid by `rbHInst_valid` for a giant base action), the lifted
answer is correct for the parent coset `σ • G` on the window. The charges of `generate` (the
restricted group, and the lifted group on bounded inputs), `lift` and `kernel` (through the
restriction set) are hypotheses. -/
theorem RunsWithin.restrictBaseProg (hO : MeetsContractOn DV restrictOps X.O)
    (hPre : ∀ op x, restrictOps op → GroupPre DV op x → X.Pre op x)
    {cont : HInstData D → Prog (groupSig D) (a, b) Ty.denote (Ty.answer D)}
    {xy : StrData × StrData} {w : WinData} {σd : PermData} {N : ℕ} {gs : GensData}
    {d : D.denote} {n₀ n : ℕ} {L : LabelData}
    (hI : HInstValid DV (((xy, (w, (σd, (N, gs, d)))), (n₀, (n, some L))) : HInstData D))
    {C' s' sK Bgm Blift Bker Bgn : ℕ}
    (hcont : ∃ ans' : AnswerData D,
      RunsWithin X body (cont (rbHInst X.O xy w σd N gs n₀ n L)) ans' C' ∧
      (rbHInst X.O xy w σd N gs n₀ n L).inst.OK DV ans' ∧
      ∀ c : CosetData D, ans' = some c → c.2.gens.length ≤ s')
    (hBgm : X.B.call GroupOp.generate ((rbPts n N w).length, rbGens n N w gs)
      (X.O.run GroupOp.generate ((rbPts n N w).length, rbGens n N w gs)) ≤ Bgm)
    (hBlift : ∀ π' : PermData, X.B.call GroupOp.lift ((N, gs, d), (rbU n N w, π'))
      (X.O.run GroupOp.lift ((N, gs, d), (rbU n N w, π'))) ≤ Blift)
    (hBker : X.B.call GroupOp.kernel ((N, gs, d), rbU n N w)
      (X.O.run GroupOp.kernel ((N, gs, d), rbU n N w)) ≤ Bker)
    (hsK : (X.O.run GroupOp.kernel ((N, gs, d), rbU n N w)).2.1.length ≤ sK)
    (hBgn : ∀ hs : GensData, GensData.AllValid N hs → hs.length ≤ sK + s' →
      GensData.denote N hs ≤ GensData.denote N gs →
      X.B.call GroupOp.generate (N, hs) (X.O.run GroupOp.generate (N, hs)) ≤ Bgn) :
    ∃ ans : AnswerData D,
      RunsWithin X body (Main.restrictBaseProg cont
          (((xy, (w, (σd, (N, gs, d)))), (n₀, (n, some L))) : HInstData D) L) ans
        (rbCost N w.1.length (N - n) gs.length C' s' sK Bgm Blift Bker Bgn) ∧
      AnsOK DV N (w.denote N) (PermData.denote N σd) (GensData.denote N gs) (xy.1.denote N)
        (xy.2.denote N) ans ∧
      ∀ sGen, (∀ hs, GensData.AllValid N hs → GensData.denote N hs ≤ GensData.denote N gs →
          (X.O.run GroupOp.generate (N, hs)).2.1.length ≤ sGen) →
        ∀ c : CosetData D, ans = some c → c.2.gens.length ≤ sGen := by
  obtain ⟨⟨hw, hσ, hgv, hW⟩, hle, hB, hwin, -, -⟩ := hI
  change WinData.Valid N w at hw
  change PermData.Valid N σd at hσ
  change GroupValid DV N gs d at hgv
  change IsInvariant (GensData.denote N gs) (w.denote N) at hW
  change n ≤ N at hle
  change IsInvariant (GensData.denote N gs) (baseSet n N) at hB
  change ∀ i ∈ w.1, i < n at hwin
  have hUv := rb_valid (n := n) hw hwin
  have hU := rb_inv (n := n) hW hB
  have hwU : w.denote N ⊆ (rbU n N w).denote N := fun u hu => List.mem_append_left _ hu
  have hg'v := GensData.allValid_restrictTo hU hUv hgv.1
  have hg'den := GensData.denote_restrictTo hU hUv hgv.1
  have hgenpost := hO .generate ((rbPts n N w).length, rbGens n N w gs) (Or.inl rfl) hg'v
  rcases hG' : X.O.run GroupOp.generate ((rbPts n N w).length, rbGens n N w gs) with
    ⟨M', gs'', d''⟩
  rw [hG'] at hgenpost hBgm
  obtain ⟨hM', hG'v, hG'den⟩ := hgenpost
  subst hM'
  have hden : GensData.denote (rbU n N w).1.length gs'' =
      (restrictHom hU (WinData.reindex hUv)).range := hG'den.trans hg'den
  have hJ : rbHInst X.O xy w σd N gs n₀ n L =
      (((StrData.restrictTo (rbPts n N w) xy.1, StrData.restrictComp (rbPts n N w) xy.2 σd),
        (WinData.ofPoints (rbPts n N w).length (List.range w.1.length),
          (PermData.one (rbPts n N w).length, ((rbPts n N w).length, gs'', d'')))),
        (n₀, (w.1.length, some (rbLabels w L)))) := by
    simp only [rbHInst]
    rw [hG']
  obtain ⟨a', ha', hok', hg'⟩ := hcont
  rw [hJ] at ha' hok'
  have hok : AnsOK DV (rbU n N w).1.length (rbWinSet (WinData.reindex hUv) (w.denote N)) 1
      (restrictHom hU (WinData.reindex hUv)).range
      (fun j => StrData.denote N xy.1 (WinData.reindex hUv j))
      (fun j => StrData.denote N xy.2 (PermData.denote N σd (WinData.reindex hUv j))) a' := by
    have h := hok'
    change AnsOK DV (rbU n N w).1.length
      (WinData.denote (rbU n N w).1.length
        (WinData.ofPoints (rbU n N w).1.length (List.range w.1.length)))
      (PermData.denote (rbU n N w).1.length (PermData.one (rbU n N w).1.length))
      (GensData.denote (rbU n N w).1.length gs'')
      (StrData.denote (rbU n N w).1.length (StrData.restrictTo (rbU n N w).1 xy.1))
      (StrData.denote (rbU n N w).1.length (StrData.restrictComp (rbU n N w).1 xy.2 σd)) a' at h
    rwa [rb_winSet_eq hwin hUv, PermData.denote_one, hden, StrData.denote_restrictTo hUv,
      StrData.denote_restrictComp hUv hσ] at h
  have hMlen : (rbPts n N w).length = w.1.length + (N - n) := rb_length
  have hG2 : X.O.run GroupOp.generate
      ((rbPts n N w).length, gs.map (PermData.restrictTo (WinData.pos N (rbU n N w))
        (rbPts n N w))) = ((rbPts n N w).length, gs'', d'') := hG'
  have hBgm2 : X.B.call GroupOp.generate
      ((rbPts n N w).length, gs.map (PermData.restrictTo (WinData.pos N (rbU n N w))
        (rbPts n N w))) ((rbPts n N w).length, gs'', d'') ≤ Bgm := hBgm
  have hprefix : ∀ (ans : AnswerData D) (c : ℕ),
      RunsWithin X body (.caseOption a' (.op0 .none) fun c'' =>
        Programs.liftAnswerProg N σd (N, gs, d) (rbU n N w) c'') ans c →
      RunsWithin X body (Main.restrictBaseProg cont
          (((xy, (w, (σd, (N, gs, d)))), (n₀, (n, some L))) : HInstData D) L) ans
        (4 * N + 30 * (w.1.length + (N - n)) + 13 * w.1.length + 5 * (N - n) +
          gs.length * (12 * (w.1.length + (N - n)) + 12) + Bgm + C' + 90 + c) :=
    fun ans c h => rb_prefix (X := X) (body := body) (hPre _ _ (Or.inl rfl) hg'v) hG2 hBgm2
      hMlen ha' h
  rcases a' with _ | ⟨τ', Hd'⟩
  · refine ⟨none, (hprefix none 2 (RunsWithin.caseOption_none (RunsWithin.prim _ _))).mono ?_,
      AnsOK.rb_none hUv hU hwU hok, fun _ _ c hc => absurd hc (by simp)⟩
    simp only [rbCost, liftCost]
    omega
  · obtain ⟨ans, hl, hlok, hlgen⟩ := RunsWithin.rbLiftProg (X := X) (body := body) hO hPre
      (xy := xy) hUv hσ hgv hU hW hwU hok (hg' _ rfl) hBlift hBker hsK hBgn
    refine ⟨ans, (hprefix ans _ (RunsWithin.caseOption_some hl)).mono ?_, hlok, hlgen⟩
    simp only [rbCost]
    omega

/-! ### The measure of the restricted instance -/

@[simp] theorem rbHInst_winSize (O : Oracle (groupSig D)) (xy : StrData × StrData) (w : WinData)
    (σd : PermData) (N : ℕ) (gs : GensData) (n₀ n : ℕ) (L : LabelData) :
    (rbHInst O xy w σd N gs n₀ n L).winSize = w.1.length := by
  simp [rbHInst, HInstData.winSize, HInstData.inst]

@[simp] theorem rbHInst_n₀ (O : Oracle (groupSig D)) (xy : StrData × StrData) (w : WinData)
    (σd : PermData) (N : ℕ) (gs : GensData) (n₀ n : ℕ) (L : LabelData) :
    (rbHInst O xy w σd N gs n₀ n L).n₀ = n₀ := rfl

@[simp] theorem rbHInst_n (O : Oracle (groupSig D)) (xy : StrData × StrData) (w : WinData)
    (σd : PermData) (N : ℕ) (gs : GensData) (n₀ n : ℕ) (L : LabelData) :
    (rbHInst O xy w σd N gs n₀ n L).n = w.1.length := rfl

/-- **The measure is unchanged**: the same window size and the same base size `m = N − n`;
the degree is `|w| + m`, so the window contains every string position. -/
theorem rbHInst_measure {O : Oracle (groupSig D)} (hO : MeetsContractOn DV (· = .generate) O)
    {xy : StrData × StrData} {w : WinData} {σd : PermData} {N : ℕ} {gs : GensData}
    {n₀ n : ℕ} {L : LabelData} (hgs : GensData.AllValid N gs) (hw : w.Valid N)
    (hwin : ∀ i ∈ w.1, i < n) (hW : IsInvariant (GensData.denote N gs) (w.denote N))
    (hB : IsInvariant (GensData.denote N gs) (baseSet n N)) :
    (rbHInst O xy w σd N gs n₀ n L).inst.degree = w.1.length + (N - n) ∧
      (rbHInst O xy w σd N gs n₀ n L).baseOpt = some (N - n) ∧
      ∀ u : ℕ, u < (rbHInst O xy w σd N gs n₀ n L).n →
        u ∈ (rbHInst O xy w σd N gs n₀ n L).inst.2.1.1 := by
  have hUv := rb_valid (n := n) hw hwin
  have hU := rb_inv (n := n) hW hB
  have hg'v := GensData.allValid_restrictTo hU hUv hgs
  have hpost := hO .generate ((rbPts n N w).length, rbGens n N w gs) rfl hg'v
  have hdeg : (rbHInst O xy w σd N gs n₀ n L).inst.degree = w.1.length + (N - n) := by
    change (O.run GroupOp.generate ((rbPts n N w).length, rbGens n N w gs)).1 = _
    rcases hG' : O.run GroupOp.generate ((rbPts n N w).length, rbGens n N w gs) with
      ⟨M', gs'', d''⟩
    rw [hG'] at hpost
    obtain ⟨hM', -, -⟩ := hpost
    rw [hM', rb_length]
  refine ⟨hdeg, ?_, fun u hu => List.mem_range.2 hu⟩
  change some _ = some _
  rw [hdeg]
  congr 1
  change w.1.length + (N - n) - w.1.length = N - n
  omega

end MainSpec

/-! ### Well-formedness -/

section Wf

variable {D : Ty} {rec : Ty × Ty} {var₁ var₂ : Ty → Type} {r : Bool} {Γ : WfCtx var₁ var₂}

theorem wf_restrictBaseProg
    {cont₁ : var₁ (hinstTy D) → Prog (groupSig D) rec var₁ (Ty.answer D)}
    {cont₂ : var₂ (hinstTy D) → Prog (groupSig D) rec var₂ (Ty.answer D)}
    (hcont : WfFun r Γ cont₁ cont₂) {I₁ : var₁ (hinstTy D)} {I₂ : var₂ (hinstTy D)}
    {L₁ : var₁ (.array (.list .nat))} {L₂ : var₂ (.array (.list .nat))}
    (hI : ⟨hinstTy D, I₁, I₂⟩ ∈ Γ) (hL : ⟨.array (.list .nat), L₁, L₂⟩ ∈ Γ) :
    Prog.Wf r Γ (restrictBaseProg cont₁ I₁ L₁) (restrictBaseProg cont₂ I₂ L₂) := by
  unfold restrictBaseProg rbPtsProg rbLabelsProg liftAnswerProg posProg restrictStrProg
    restrictCompProg restrictPermProg mkWindow permOne permMul mapList
  prog_wf
  all_goals first
    | exact Or.inl ⟨rfl, HEq.rfl⟩
    | simp [hI, hL]
    | exact hcont _ (fun y hy => by simp [hy]) _ _ (List.Mem.head _)

end Wf

end GraphIso.Main
