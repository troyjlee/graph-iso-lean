module

public import GraphIso.Luks.Basic
public import GraphIso.Reductions.RestrictionData

/-!
# The closure of a partition and a pair

For a window `pts` mapped into itself by the generators `gs` (`Win`), and labels `cl` that
are valid (`LabelsOK`) and invariant under the generators (`Stable`), `closure gs pts cl u v`
is the finest invariant partition coarser than `cl` that joins `u` and `v` (`closure_spec`):

* its labels are valid and invariant under the generators;
* it is coarser than `cl` and gives `u` and `v` the same label;
* it refines every equivalence relation `F` invariant under the generators (`InvRel`) that
  is refined by `cl` and relates `u` and `v`.

The worklist invariant `CInv`: the labels are valid, pending pairs are window points, `u` and
`v` are related, and whenever `a` and `b` have the same label, their images under each
generator are related, all in the equivalence generated by the labels and the pending pairs
(`rel`). At the end nothing is pending, so that equivalence is given by the labels. Soundness
(`Sound`): every pair of points with the same label, and every pending pair, is related by
`F`.

Termination: each merge removes one leader and queues one pair per generator, so the
potential `cpot = |pending| + (s + 1) · leaders` drops at every step, and `closeFuel` steps
suffice.
-/

@[expose] public section

namespace GraphIso.Luks

open Cost Sims Relation

variable {n : ℕ} {gs : GensData} {pts : List ℕ}

/-! ### Windows and labels -/

/-- The window hypotheses: distinct points below `n`, mapped into the window by every
generator. -/
structure Win (n : ℕ) (gs : GensData) (pts : List ℕ) : Prop where
  nodup : pts.Nodup
  lt : ∀ p ∈ pts, p < n
  maps : ∀ g ∈ gs, ∀ p ∈ pts, get g.1 p ∈ pts

/-- Valid labels: every label of a window point is a window point labelling itself. -/
structure LabelsOK (n : ℕ) (pts : List ℕ) (cl : Array ℕ) : Prop where
  size : cl.size = n
  mem : ∀ p ∈ pts, get cl p ∈ pts
  idem : ∀ p ∈ pts, get cl (get cl p) = get cl p

/-- The generators map classes into classes. -/
def Stable (gs : GensData) (pts : List ℕ) (cl : Array ℕ) : Prop :=
  ∀ g ∈ gs, ∀ a ∈ pts, ∀ b ∈ pts, get cl a = get cl b → get cl (get g.1 a) = get cl (get g.1 b)

/-- `cl'` is coarser than `cl` on the window. -/
def Coarser (pts : List ℕ) (cl cl' : Array ℕ) : Prop :=
  ∀ a ∈ pts, ∀ b ∈ pts, get cl a = get cl b → get cl' a = get cl' b

/-- An equivalence relation invariant under the generators on the window. -/
def InvRel (gs : GensData) (pts : List ℕ) (F : ℕ → ℕ → Prop) : Prop :=
  Equivalence F ∧ ∀ g ∈ gs, ∀ a ∈ pts, ∀ b ∈ pts, F a b → F (get g.1 a) (get g.1 b)

/-- The labels refine `F` on the window. -/
def Refines (pts : List ℕ) (cl : Array ℕ) (F : ℕ → ℕ → Prop) : Prop :=
  ∀ a ∈ pts, ∀ b ∈ pts, get cl a = get cl b → F a b

theorem Coarser.refl (pts : List ℕ) (cl : Array ℕ) : Coarser pts cl cl := fun _ _ _ _ h => h

theorem Coarser.trans {cl₁ cl₂ cl₃ : Array ℕ} (h₁ : Coarser pts cl₁ cl₂)
    (h₂ : Coarser pts cl₂ cl₃) : Coarser pts cl₁ cl₃ :=
  fun a ha b hb h => h₂ a ha b hb (h₁ a ha b hb h)

theorem Refines.of_coarser {cl cl' : Array ℕ} {F : ℕ → ℕ → Prop} (h : Coarser pts cl cl')
    (hF : Refines pts cl' F) : Refines pts cl F :=
  fun a ha b hb hab => hF a ha b hb (h a ha b hb hab)

/-- The labels of a valid partition, as an equivalence relation. -/
theorem labelRel_equiv (cl : Array ℕ) : Equivalence fun a b => get cl a = get cl b :=
  ⟨fun _ => rfl, fun h => h.symm, fun h₁ h₂ => h₁.trans h₂⟩

/-! ### Relabelling -/

theorem get_eq_of_getElem? {a : Array ℕ} {i v : ℕ} (h : a[i]? = some v) : get a i = v := by
  simp [get, h]

theorem size_relabel (cl : Array ℕ) (pts : List ℕ) (cb ca : ℕ) :
    (relabel cl pts cb ca).size = cl.size :=
  size_applyWrites (a := .nat) _ _

theorem get_relabel_of_mem {cl : Array ℕ} {cb ca : ℕ} (hnd : pts.Nodup) {p : ℕ} (hp : p ∈ pts)
    (hlt : p < cl.size) : get (relabel cl pts cb ca) p = newLabel cl cb ca p := by
  apply get_eq_of_getElem?
  refine getElem?_applyWrites_of_mem (a := .nat) cl ?_ (List.mem_map.2 ⟨p, hp, rfl⟩) hlt
  simpa [List.map_map, Function.comp_def] using hnd

theorem get_relabel_of_not_mem (cl : Array ℕ) {cb ca : ℕ} {p : ℕ} (hp : p ∉ pts) :
    get (relabel cl pts cb ca) p = get cl p := by
  have h : p ∉ (pts.map fun p => (p, newLabel cl cb ca p)).map Prod.fst := by
    simpa [List.map_map, Function.comp_def] using hp
  have := getElem?_applyWrites_of_not_mem (a := .nat) cl h
  simp only [get, Array.getD_eq_getD_getElem?, relabel]
  rw [this]

section Merge

variable {cl : Array ℕ} {a b : ℕ} (hW : Win n gs pts) (hcl : LabelsOK n pts cl)
include hW hcl

theorem get_merge {p : ℕ} (hp : p ∈ pts) :
    get (relabel cl pts (get cl b) (get cl a)) p = newLabel cl (get cl b) (get cl a) p :=
  get_relabel_of_mem hW.nodup hp (hcl.size ▸ hW.lt p hp)

theorem labelsOK_merge (ha : a ∈ pts) (hne : get cl a ≠ get cl b) :
    LabelsOK n pts (relabel cl pts (get cl b) (get cl a)) := by
  refine ⟨(size_relabel _ _ _ _).trans hcl.size, fun p hp => ?_, fun p hp => ?_⟩
  · rw [get_merge hW hcl hp]
    unfold newLabel
    split
    · exact hcl.mem a ha
    · exact hcl.mem p hp
  · rw [get_merge hW hcl hp]
    unfold newLabel
    split
    · rw [get_merge hW hcl (hcl.mem a ha)]
      unfold newLabel
      simp only [hcl.idem a ha, hne, ↓reduceIte]
    · rename_i h
      rw [get_merge hW hcl (hcl.mem p hp)]
      unfold newLabel
      simp only [hcl.idem p hp, h, ↓reduceIte]

theorem coarser_merge : Coarser pts cl (relabel cl pts (get cl b) (get cl a)) := by
  intro x hx y hy hxy
  rw [get_merge hW hcl hx, get_merge hW hcl hy]
  unfold newLabel
  rw [hxy]

theorem joins_merge (ha : a ∈ pts) (hb : b ∈ pts) (hne : get cl a ≠ get cl b) :
    get (relabel cl pts (get cl b) (get cl a)) a =
      get (relabel cl pts (get cl b) (get cl a)) b := by
  rw [get_merge hW hcl ha, get_merge hW hcl hb]
  unfold newLabel
  simp [hne]

/-- After a merge, two window points with the same label had the same label before, or one
was in the class of `a` and the other in the class of `b`. -/
theorem eq_or_of_merge {x y : ℕ} (hx : x ∈ pts) (hy : y ∈ pts)
    (h : get (relabel cl pts (get cl b) (get cl a)) x =
      get (relabel cl pts (get cl b) (get cl a)) y) :
    get cl x = get cl y ∨ (get cl x = get cl b ∧ get cl y = get cl a) ∨
      (get cl x = get cl a ∧ get cl y = get cl b) := by
  rw [get_merge hW hcl hx, get_merge hW hcl hy] at h
  unfold newLabel at h
  split at h <;> split at h
  · rename_i h₁ h₂
    exact Or.inl (h₁.trans h₂.symm)
  · rename_i h₁ _
    exact Or.inr (Or.inl ⟨h₁, h.symm⟩)
  · rename_i _ h₂
    exact Or.inr (Or.inr ⟨h, h₂⟩)
  · exact Or.inl h

/-- A merge removes exactly one leader: the label of `b`. -/
theorem leaders_merge (ha : a ∈ pts) (hb : b ∈ pts) (hne : get cl a ≠ get cl b) :
    (leaders (relabel cl pts (get cl b) (get cl a)) pts).length + 1 = (leaders cl pts).length := by
  have hl : leaders (relabel cl pts (get cl b) (get cl a)) pts =
      (leaders cl pts).filter (· != get cl b) := by
    unfold leaders
    rw [List.filter_filter]
    refine List.filter_congr fun p hp => ?_
    rw [get_merge hW hcl hp]
    unfold newLabel
    by_cases h : get cl p = get cl b
    · simp only [h, ↓reduceIte]
      have hpa : get cl a ≠ p := by
        intro e
        apply hne
        rw [← h, ← e, hcl.idem a ha]
      rw [beq_false_of_ne hpa]
      by_cases e : p = get cl b
      · simp [e]
      · have : get cl b ≠ p := fun h' => e h'.symm
        simp [this]
    · simp only [h, ↓reduceIte]
      by_cases e : get cl p = p
      · have : p ≠ get cl b := fun h' => h (e.trans h')
        simp [e, this]
      · simp [e]
  have hmem : get cl b ∈ leaders cl pts := by
    unfold leaders
    rw [List.mem_filter]
    exact ⟨hcl.mem b hb, by simp [hcl.idem b hb]⟩
  have hnd : (leaders cl pts).Nodup := hW.nodup.filter _
  rw [hl, ← hnd.erase_eq_filter, List.length_erase_of_mem hmem]
  have : 0 < (leaders cl pts).length := List.length_pos_of_mem hmem
  omega

end Merge

/-! ### The closure invariant -/

/-- The pairs of window points with the same label, and the pending pairs. -/
def rel (pts : List ℕ) (st : CState) (x y : ℕ) : Prop :=
  (x ∈ pts ∧ y ∈ pts ∧ get st.1 x = get st.1 y) ∨ (x, y) ∈ st.2

/-- The worklist invariant of the closure from `u` and `v`. -/
structure CInv (n : ℕ) (gs : GensData) (pts : List ℕ) (u v : ℕ) (st : CState) : Prop where
  labels : LabelsOK n pts st.1
  pend : ∀ q ∈ st.2, q.1 ∈ pts ∧ q.2 ∈ pts
  joined : EqvGen (rel pts st) u v
  stable : ∀ g ∈ gs, ∀ a ∈ pts, ∀ b ∈ pts, get st.1 a = get st.1 b →
    EqvGen (rel pts st) (get g.1 a) (get g.1 b)

/-- Soundness with respect to `F`: the labels refine `F`, and `F` relates every pending pair. -/
def Sound (pts : List ℕ) (F : ℕ → ℕ → Prop) (st : CState) : Prop :=
  Refines pts st.1 F ∧ ∀ q ∈ st.2, F q.1 q.2

/-- The closure potential. -/
def cpot (s : ℕ) (pts : List ℕ) (st : CState) : ℕ :=
  st.2.length + (s + 1) * (leaders st.1 pts).length

theorem eqvGen_of_le {r p : ℕ → ℕ → Prop} (h : ∀ x y, r x y → EqvGen p x y) {a b : ℕ}
    (hab : EqvGen r a b) : EqvGen p a b := by
  induction hab with
  | rel x y hxy => exact h x y hxy
  | refl x => exact EqvGen.refl x
  | symm x y _ ih => exact EqvGen.symm _ _ ih
  | trans x y z _ _ ih₁ ih₂ => exact EqvGen.trans _ _ _ ih₁ ih₂

/-- With nothing pending, related points are equal or window points with the same label. -/
theorem eqvGen_rel_nil {cl : Array ℕ} {x y : ℕ} (h : EqvGen (rel pts (cl, [])) x y) :
    x = y ∨ (x ∈ pts ∧ y ∈ pts ∧ get cl x = get cl y) := by
  induction h with
  | rel x y hxy =>
    rcases hxy with hxy | hxy
    · exact Or.inr hxy
    · simp at hxy
  | refl x => exact Or.inl rfl
  | symm x y _ ih =>
    rcases ih with rfl | ⟨hx, hy, e⟩
    · exact Or.inl rfl
    · exact Or.inr ⟨hy, hx, e.symm⟩
  | trans x y z _ _ ih₁ ih₂ =>
    rcases ih₁ with rfl | ⟨hx, hy, e₁⟩
    · exact ih₂
    · rcases ih₂ with rfl | ⟨-, hz, e₂⟩
      · exact Or.inr ⟨hx, hy, e₁⟩
      · exact Or.inr ⟨hx, hz, e₁.trans e₂⟩

theorem eq_of_eqvGen_rel_nil {cl : Array ℕ} {x y : ℕ} (h : EqvGen (rel pts (cl, [])) x y) :
    get cl x = get cl y := by
  rcases eqvGen_rel_nil h with rfl | ⟨-, -, e⟩
  · rfl
  · exact e

section Step

variable {u v : ℕ} {st : CState} {a b : ℕ} {rest : List (ℕ × ℕ)} (hW : Win n gs pts)
include hW

omit hW in
/-- A pending pair whose points have the same label is dropped. -/
theorem closeStep_drop (hI : CInv n gs pts u v st) (hp : st.2 = (a, b) :: rest)
    (he : get st.1 a = get st.1 b) :
    CInv n gs pts u v (st.1, rest) ∧ cpot gs.length pts (st.1, rest) < cpot gs.length pts st ∧
      ∀ F, Sound pts F st → Sound pts F (st.1, rest) := by
  obtain ⟨cl, pend⟩ := st
  simp only at hp he
  subst hp
  have hab := hI.pend (a, b) List.mem_cons_self
  have hle : ∀ x y, rel pts (cl, (a, b) :: rest) x y → EqvGen (rel pts (cl, rest)) x y := by
    rintro x y (h | h)
    · exact EqvGen.rel _ _ (Or.inl h)
    · rcases List.mem_cons.1 h with e | h
      · cases e
        exact EqvGen.rel _ _ (Or.inl ⟨hab.1, hab.2, he⟩)
      · exact EqvGen.rel _ _ (Or.inr h)
  refine ⟨⟨hI.labels, fun q hq => hI.pend q (List.mem_cons_of_mem _ hq),
    eqvGen_of_le hle hI.joined, fun g hg x hx y hy hxy => eqvGen_of_le hle
      (hI.stable g hg x hx y hy hxy)⟩, ?_, fun F hF => ⟨hF.1, fun q hq => hF.2 q
        (List.mem_cons_of_mem _ hq)⟩⟩
  simp [cpot]

/-- A pending pair whose points have different labels merges their classes and queues its
images under the generators. -/
theorem closeStep_merge (hI : CInv n gs pts u v st) (hp : st.2 = (a, b) :: rest)
    (hne : get st.1 a ≠ get st.1 b) :
    CInv n gs pts u v (relabel st.1 pts (get st.1 b) (get st.1 a), pairImages gs a b ++ rest) ∧
      cpot gs.length pts (relabel st.1 pts (get st.1 b) (get st.1 a), pairImages gs a b ++ rest) <
        cpot gs.length pts st ∧
      Coarser pts st.1 (relabel st.1 pts (get st.1 b) (get st.1 a)) ∧
      ∀ F, InvRel gs pts F → Sound pts F st →
        Sound pts F (relabel st.1 pts (get st.1 b) (get st.1 a), pairImages gs a b ++ rest) := by
  obtain ⟨cl, pend⟩ := st
  simp only at hp hne
  subst hp
  dsimp only
  have hab : a ∈ pts ∧ b ∈ pts := hI.pend (a, b) List.mem_cons_self
  have hcl : LabelsOK n pts cl := hI.labels
  set cl' := relabel cl pts (get cl b) (get cl a) with hcl'
  have hco := coarser_merge (a := a) (b := b) hW hcl
  have hjoin := joins_merge hW hcl hab.1 hab.2 hne
  -- every old relation is a new one
  have hle : ∀ x y, rel pts (cl, (a, b) :: rest) x y →
      EqvGen (rel pts (cl', pairImages gs a b ++ rest)) x y := by
    rintro x y (⟨hx, hy, h⟩ | h)
    · exact EqvGen.rel _ _ (Or.inl ⟨hx, hy, hco x hx y hy h⟩)
    · rcases List.mem_cons.1 h with e | h
      · cases e
        exact EqvGen.rel _ _ (Or.inl ⟨hab.1, hab.2, hjoin⟩)
      · exact EqvGen.rel _ _ (Or.inr (List.mem_append_right _ h))
  have himg : ∀ g ∈ gs, EqvGen (rel pts (cl', pairImages gs a b ++ rest)) (get g.1 a)
      (get g.1 b) := fun g hg => EqvGen.rel _ _ (Or.inr (List.mem_append_left _
        (List.mem_map.2 ⟨g, hg, rfl⟩)))
  have hold : ∀ g ∈ gs, ∀ x ∈ pts, ∀ y ∈ pts, get cl x = get cl y →
      EqvGen (rel pts (cl', pairImages gs a b ++ rest)) (get g.1 x) (get g.1 y) :=
    fun g hg x hx y hy hxy => eqvGen_of_le hle (hI.stable g hg x hx y hy hxy)
  refine ⟨⟨labelsOK_merge hW hcl hab.1 hne, fun q hq => ?_, eqvGen_of_le hle hI.joined,
    fun g hg x hx y hy hxy => ?_⟩, ?_, hco, fun F hF hS => ⟨fun x hx y hy hxy => ?_,
      fun q hq => ?_⟩⟩
  · -- pending pairs are window points
    rcases List.mem_append.1 hq with hq | hq
    · obtain ⟨g, hg, rfl⟩ := List.mem_map.1 hq
      exact ⟨hW.maps g hg a hab.1, hW.maps g hg b hab.2⟩
    · exact hI.pend q (List.mem_cons_of_mem _ hq)
  · -- stability modulo pending pairs
    rcases eq_or_of_merge hW hcl hx hy hxy with h | ⟨h₁, h₂⟩ | ⟨h₁, h₂⟩
    · exact hold g hg x hx y hy h
    · exact EqvGen.trans _ _ _ (hold g hg x hx b hab.2 h₁) (EqvGen.trans _ _ _
        (EqvGen.symm _ _ (himg g hg)) (hold g hg a hab.1 y hy h₂.symm))
    · exact EqvGen.trans _ _ _ (hold g hg x hx a hab.1 h₁) (EqvGen.trans _ _ _ (himg g hg)
        (hold g hg b hab.2 y hy h₂.symm))
  · -- the potential drops
    have hlead : (leaders cl' pts).length + 1 = (leaders cl pts).length :=
      leaders_merge hW hcl hab.1 hab.2 hne
    simp only [cpot, List.length_append, List.length_cons, pairImages, List.length_map]
    rw [← hlead, Nat.mul_succ]
    omega
  · -- soundness of the labels
    have hFab : F a b := hS.2 (a, b) List.mem_cons_self
    rcases eq_or_of_merge hW hcl hx hy hxy with h | ⟨h₁, h₂⟩ | ⟨h₁, h₂⟩
    · exact hS.1 x hx y hy h
    · exact hF.1.trans (hS.1 x hx b hab.2 h₁) (hF.1.trans (hF.1.symm hFab)
        (hS.1 a hab.1 y hy h₂.symm))
    · exact hF.1.trans (hS.1 x hx a hab.1 h₁) (hF.1.trans hFab (hS.1 b hab.2 y hy h₂.symm))
  · -- soundness of the pending pairs
    rcases List.mem_append.1 hq with hq | hq
    · obtain ⟨g, hg, rfl⟩ := List.mem_map.1 hq
      exact hF.2 g hg a hab.1 b hab.2 (hS.2 (a, b) List.mem_cons_self)
    · exact hS.2 q (List.mem_cons_of_mem _ hq)

end Step

/-! ### The closure -/

section Iter

variable {u v : ℕ} (hW : Win n gs pts)
include hW

theorem iter_closeStep :
    ∀ (m : ℕ) (st : CState), CInv n gs pts u v st → cpot gs.length pts st < m →
      CInv n gs pts u v (iter (closeStep gs pts) m st) ∧ (iter (closeStep gs pts) m st).2 = [] ∧
        Coarser pts st.1 (iter (closeStep gs pts) m st).1 ∧
        ∀ F, InvRel gs pts F → Sound pts F st → Sound pts F (iter (closeStep gs pts) m st)
  | 0, _, _, hm => absurd hm (Nat.not_lt_zero _)
  | m + 1, st, hI, hm => by
    rcases hp : st.2 with _ | ⟨⟨a, b⟩, rest⟩
    · have hstep : closeStep gs pts st = none := by simp [closeStep, hp]
      simp only [iter, hstep]
      exact ⟨hI, hp, Coarser.refl _ _, fun _ _ h => h⟩
    · by_cases he : get st.1 a = get st.1 b
      · have hstep : closeStep gs pts st = some (st.1, rest) := by simp [closeStep, hp, he]
        obtain ⟨hI', hpot, hS⟩ := closeStep_drop hI hp he
        simp only [iter, hstep]
        obtain ⟨h₁, h₂, h₃, h₄⟩ := iter_closeStep m (st.1, rest) hI' (by omega)
        exact ⟨h₁, h₂, h₃, fun F hF hS₀ => h₄ F hF (hS F hS₀)⟩
      · have hstep : closeStep gs pts st = some (relabel st.1 pts (get st.1 b) (get st.1 a),
            pairImages gs a b ++ rest) := by simp [closeStep, hp, he]
        obtain ⟨hI', hpot, hco, hS⟩ := closeStep_merge hW hI hp he
        simp only [iter, hstep]
        obtain ⟨h₁, h₂, h₃, h₄⟩ := iter_closeStep m _ hI' (by omega)
        exact ⟨h₁, h₂, hco.trans h₃, fun F hF hS₀ => h₄ F hF (hS F hF hS₀)⟩

omit hW in
theorem leaders_length_le (cl : Array ℕ) : (leaders cl pts).length ≤ pts.length :=
  List.length_filter_le _ _

/-- The initial closure state satisfies the invariant. -/
theorem cinv_init {cl : Array ℕ} (hcl : LabelsOK n pts cl) (hst : Stable gs pts cl)
    (hu : u ∈ pts) (hv : v ∈ pts) : CInv n gs pts u v (cl, [(u, v)]) := by
  refine ⟨hcl, fun q hq => ?_, EqvGen.rel _ _ (Or.inr List.mem_cons_self),
    fun g hg a ha b hb hab => EqvGen.rel _ _ (Or.inl ⟨hW.maps g hg a ha, hW.maps g hg b hb,
      hst g hg a ha b hb hab⟩)⟩
  rw [List.mem_singleton] at hq
  subst hq
  exact ⟨hu, hv⟩

/-- **The closure** is the finest invariant partition coarser than `cl` that joins `u` and
`v`. -/
theorem closure_spec {cl : Array ℕ} (hcl : LabelsOK n pts cl) (hst : Stable gs pts cl)
    (hu : u ∈ pts) (hv : v ∈ pts) :
    LabelsOK n pts (closure gs pts cl u v) ∧ Stable gs pts (closure gs pts cl u v) ∧
      Coarser pts cl (closure gs pts cl u v) ∧
      get (closure gs pts cl u v) u = get (closure gs pts cl u v) v ∧
      ∀ F, InvRel gs pts F → Refines pts cl F → F u v → Refines pts (closure gs pts cl u v) F := by
  have hI := cinv_init hW hcl hst hu hv
  have hpot : cpot gs.length pts (cl, [(u, v)]) < closeFuel gs.length pts.length := by
    have := Nat.mul_le_mul_left (gs.length + 1) (leaders_length_le (pts := pts) cl)
    simp only [cpot, closeFuel, List.length_singleton]
    omega
  obtain ⟨hI', hnil, hco, hS⟩ := iter_closeStep hW _ _ hI hpot
  set st := iter (closeStep gs pts) (closeFuel gs.length pts.length) (cl, [(u, v)]) with hst'
  have hcl' : closure gs pts cl u v = st.1 := rfl
  obtain ⟨cl', pend⟩ := st
  simp only at hnil hcl'
  subst hnil
  rw [hcl']
  refine ⟨hI'.labels,
    fun g hg a ha b hb hab => eq_of_eqvGen_rel_nil (hI'.stable g hg a ha b hb hab),
    hco, eq_of_eqvGen_rel_nil hI'.joined, fun F hF hR hFuv => ?_⟩
  have hS₀ : Sound pts F (cl, [(u, v)]) := ⟨hR, fun q hq => by
    rw [List.mem_singleton] at hq
    subst hq
    exact hFuv⟩
  exact (hS F hF hS₀).1

end Iter

/-! ### The discrete partition -/

theorem get_discrete {p : ℕ} (hp : p < n) : get (discrete n) p = p := by
  simp [get, discrete, hp]

theorem labelsOK_discrete (hW : Win n gs pts) : LabelsOK n pts (discrete n) := by
  refine ⟨by simp [discrete], fun p hp => ?_, fun p hp => ?_⟩
  · rw [get_discrete (hW.lt p hp)]
    exact hp
  · rw [get_discrete (hW.lt p hp), get_discrete (hW.lt p hp)]

theorem stable_discrete (hW : Win n gs pts) : Stable gs pts (discrete n) := by
  intro g hg a ha b hb hab
  rw [get_discrete (hW.lt a ha), get_discrete (hW.lt b hb)] at hab
  subst hab
  rfl

end GraphIso.Luks
