module

public import GraphIso.Luks.Closure
public import GraphIso.Reductions.Blocks
public import Mathlib.GroupTheory.OrderOfElement

/-!
# The maximal block pass and its block list

`maxLabels n gs pts u` processes the window points in order (`mbStep`). Its invariant `MInv`:
the labels are valid and invariant under the generators, some window point is outside the
class of `u`, and every processed point `v` is in the class of `u` or has a closure with `u`
that is a single class. The last property survives coarsening, because closures are monotone
(`oneClass_closure_mono`). So at the end every window point satisfies it
(`maxLabels_spec`).

The classes as a block list (`blocksOf`), one per leader:

* `isBlockList_blocksOf`: the blocks are nonempty and list every window point once;
* `permutesBlocks_blocksOf`: the group generated by the generators permutes them, since the
  labels are invariant under every element of the group (`stable_denote`);
* `two_le_length_blocksOf`: there are at least two blocks when some point is outside the
  class of `u`;
* `mem_blocksOf_iff`: two window points are in a common block exactly when they have the
  same label.
-/

@[expose] public section

namespace GraphIso.Luks

open Equiv Cost Sims

variable {n : ℕ} {gs : GensData} {pts : List ℕ}

theorem oneClass_iff {cl : Array ℕ} {u : ℕ} :
    oneClass cl pts u = true ↔ ∀ p ∈ pts, get cl p = get cl u := by
  simp [oneClass]

/-- **Closures are monotone**: a closure with a single class stays one for coarser labels. -/
theorem oneClass_closure_mono (hW : Win n gs pts) {cl cl' : Array ℕ} (hcl : LabelsOK n pts cl)
    (hst : Stable gs pts cl) (hcl' : LabelsOK n pts cl') (hst' : Stable gs pts cl')
    (hco : Coarser pts cl cl') {u v : ℕ} (hu : u ∈ pts) (hv : v ∈ pts)
    (h : oneClass (closure gs pts cl u v) pts u = true) :
    oneClass (closure gs pts cl' u v) pts u = true := by
  obtain ⟨-, hst₂, hco₂, hj₂, -⟩ := closure_spec hW hcl' hst' hu hv
  obtain ⟨-, -, -, -, hmin⟩ := closure_spec hW hcl hst hu hv
  have hF : InvRel gs pts fun a b =>
      get (closure gs pts cl' u v) a = get (closure gs pts cl' u v) b :=
    ⟨labelRel_equiv _, hst₂⟩
  have hR := hmin _ hF (fun a ha b hb hab => hco₂ a ha b hb (hco a ha b hb hab)) hj₂
  rw [oneClass_iff] at h ⊢
  exact fun p hp => hR p hp u hu (h p hp)

/-! ### The pass -/

/-- The invariant of the pass, after processing the points of `done`. -/
structure MInv (n : ℕ) (gs : GensData) (pts : List ℕ) (u : ℕ) (done : List ℕ) (cl : Array ℕ) :
    Prop where
  labels : LabelsOK n pts cl
  stable : Stable gs pts cl
  two : ∃ p ∈ pts, get cl p ≠ get cl u
  maximal : ∀ v ∈ done, get cl v = get cl u ∨ oneClass (closure gs pts cl u v) pts u = true

section Pass

variable {u : ℕ} (hW : Win n gs pts) (hu : u ∈ pts)
include hW hu

theorem mbStep_spec {done : List ℕ} {cl : Array ℕ} {v : ℕ} (hv : v ∈ pts)
    (hdone : ∀ v' ∈ done, v' ∈ pts) (hI : MInv n gs pts u done cl) :
    MInv n gs pts u (done ++ [v]) (mbStep gs pts u cl v) := by
  unfold mbStep
  by_cases h₁ : get cl v = get cl u
  · simp only [h₁, ↓reduceIte]
    refine ⟨hI.labels, hI.stable, hI.two, fun v' hv' => ?_⟩
    rcases List.mem_append.1 hv' with hv' | hv'
    · exact hI.maximal v' hv'
    · rw [List.mem_singleton] at hv'
      subst hv'
      exact Or.inl h₁
  · simp only [h₁, ↓reduceIte]
    by_cases h₂ : oneClass (closure gs pts cl u v) pts u = true
    · simp only [h₂, ↓reduceIte]
      refine ⟨hI.labels, hI.stable, hI.two, fun v' hv' => ?_⟩
      rcases List.mem_append.1 hv' with hv' | hv'
      · exact hI.maximal v' hv'
      · rw [List.mem_singleton] at hv'
        subst hv'
        exact Or.inr h₂
    · simp only [h₂, Bool.false_eq_true, ↓reduceIte]
      obtain ⟨hcl', hst', hco, hj, -⟩ := closure_spec hW hI.labels hI.stable hu hv
      refine ⟨hcl', hst', ?_, fun v' hv' => ?_⟩
      · rw [oneClass_iff] at h₂
        push Not at h₂
        exact h₂
      · rcases List.mem_append.1 hv' with hv' | hv'
        · rcases hI.maximal v' hv' with h | h
          · exact Or.inl (hco v' (hdone v' hv') u hu h)
          · exact Or.inr (oneClass_closure_mono hW hI.labels hI.stable hcl' hst' hco hu
              (hdone v' hv') h)
        · rw [List.mem_singleton] at hv'
          subst hv'
          exact Or.inl hj.symm

theorem foldl_mbStep :
    ∀ (l done : List ℕ) (cl : Array ℕ), (∀ v ∈ l, v ∈ pts) → (∀ v ∈ done, v ∈ pts) →
      MInv n gs pts u done cl → MInv n gs pts u (done ++ l) (l.foldl (mbStep gs pts u) cl)
  | [], done, cl, _, _, hI => by simpa using hI
  | v :: l, done, cl, hl, hdone, hI => by
    have h := foldl_mbStep l (done ++ [v]) (mbStep gs pts u cl v)
      (fun v' hv' => hl v' (List.mem_cons_of_mem _ hv'))
      (fun v' hv' => by
        rcases List.mem_append.1 hv' with hv' | hv'
        · exact hdone v' hv'
        · rw [List.mem_singleton] at hv'
          subst hv'
          exact hl _ List.mem_cons_self)
      (mbStep_spec hW hu (hl v List.mem_cons_self) hdone hI)
    simpa using h

/-- **The pass**: at the end, every window point is in the class of `u` or has a closure with
`u` that is a single class. -/
theorem maxLabels_spec (htwo : ∃ p ∈ pts, p ≠ u) :
    MInv n gs pts u pts (maxLabels n gs pts u) := by
  have h₀ : MInv n gs pts u [] (discrete n) := by
    refine ⟨labelsOK_discrete hW, stable_discrete hW, ?_, fun v hv => by simp at hv⟩
    obtain ⟨p, hp, hpu⟩ := htwo
    refine ⟨p, hp, ?_⟩
    rw [get_discrete (hW.lt p hp), get_discrete (hW.lt u hu)]
    exact hpu
  simpa [maxLabels] using
    foldl_mbStep hW hu pts [] (discrete n) (fun _ h => h) (fun _ h => by simp at h) h₀

end Pass

/-! ### The block list of a partition -/

section Blocks

variable {cl : Array ℕ}

theorem mem_leaders {l : ℕ} : l ∈ leaders cl pts ↔ l ∈ pts ∧ get cl l = l := by
  simp [leaders]

theorem mem_class {l p : ℕ} :
    p ∈ pts.filter (fun q => get cl q == l) ↔ p ∈ pts ∧ get cl p = l := by
  simp

theorem mem_blocksOf {b : List ℕ} :
    b ∈ blocksOf cl pts ↔ ∃ l ∈ leaders cl pts, b = pts.filter fun q => get cl q == l := by
  simp only [blocksOf, List.mem_map]
  constructor
  · rintro ⟨l, hl, rfl⟩
    exact ⟨l, hl, rfl⟩
  · rintro ⟨l, hl, rfl⟩
    exact ⟨l, hl, rfl⟩

theorem length_blocksOf : (blocksOf cl pts).length = (leaders cl pts).length := by
  simp [blocksOf]

/-- The class of a window point is a block. -/
theorem class_mem_blocksOf (hcl : LabelsOK n pts cl) {p : ℕ} (hp : p ∈ pts) :
    pts.filter (fun q => get cl q == get cl p) ∈ blocksOf cl pts :=
  mem_blocksOf.2 ⟨get cl p, mem_leaders.2 ⟨hcl.mem p hp, hcl.idem p hp⟩, rfl⟩

/-- Two window points are in a common block exactly when they have the same label. -/
theorem mem_blocksOf_iff (hcl : LabelsOK n pts cl) {p q : ℕ} (hp : p ∈ pts) (hq : q ∈ pts) :
    (∃ b ∈ blocksOf cl pts, p ∈ b ∧ q ∈ b) ↔ get cl p = get cl q := by
  constructor
  · rintro ⟨b, hb, hpb, hqb⟩
    obtain ⟨l, -, rfl⟩ := mem_blocksOf.1 hb
    rw [mem_class] at hpb hqb
    rw [hpb.2, hqb.2]
  · intro h
    exact ⟨_, class_mem_blocksOf hcl hp, mem_class.2 ⟨hp, rfl⟩, mem_class.2 ⟨hq, h.symm⟩⟩

/-- The classes list every window point exactly once. -/
theorem isBlockList_blocksOf (hnd : pts.Nodup) (hcl : LabelsOK n pts cl) (mask : Array Bool) :
    IsBlockList (pts, mask) (blocksOf cl pts) := by
  refine ⟨?_, fun b hb => ?_⟩
  · have hnd' : (blocksOf cl pts).flatten.Nodup := by
      rw [List.nodup_flatten]
      refine ⟨fun b hb => ?_, ?_⟩
      · obtain ⟨l, -, rfl⟩ := mem_blocksOf.1 hb
        exact hnd.filter _
      · unfold blocksOf
        rw [List.pairwise_map]
        refine (hnd.filter _).imp fun {l l'} hne => ?_
        intro p hp hp'
        rw [mem_class] at hp hp'
        exact hne (hp.2.symm.trans hp'.2)
    refine (List.perm_ext_iff_of_nodup hnd' hnd).2 fun p => ?_
    rw [List.mem_flatten]
    constructor
    · rintro ⟨b, hb, hpb⟩
      obtain ⟨l, -, rfl⟩ := mem_blocksOf.1 hb
      exact (mem_class.1 hpb).1
    · intro hp
      exact ⟨_, class_mem_blocksOf hcl hp, mem_class.2 ⟨hp, rfl⟩⟩
  · obtain ⟨l, hl, rfl⟩ := mem_blocksOf.1 hb
    rw [mem_leaders] at hl
    exact List.ne_nil_of_mem (mem_class.2 hl)

theorem two_le_length_of_mem {l : List ℕ} {a b : ℕ} (ha : a ∈ l) (hb : b ∈ l) (hab : a ≠ b) :
    2 ≤ l.length := by
  match l, ha, hb with
  | [x], ha, hb =>
    rw [List.mem_singleton] at ha hb
    exact absurd (ha.trans hb.symm) hab
  | _ :: _ :: _, _, _ => simp

/-- At least two blocks when some window point is outside the class of `u`. -/
theorem two_le_length_blocksOf (hcl : LabelsOK n pts cl) {u : ℕ} (hu : u ∈ pts)
    (h : ∃ p ∈ pts, get cl p ≠ get cl u) : 2 ≤ (blocksOf cl pts).length := by
  obtain ⟨p, hp, hpu⟩ := h
  rw [length_blocksOf]
  exact two_le_length_of_mem (mem_leaders.2 ⟨hcl.mem p hp, hcl.idem p hp⟩)
    (mem_leaders.2 ⟨hcl.mem u hu, hcl.idem u hu⟩) hpu

/-- Labels invariant under the generators are invariant under the generated group. -/
theorem stable_denote (hW : Win n gs pts) (hgs : GensData.AllValid n gs)
    (hst : Stable gs pts cl) {π : Perm (Fin n)} (hπ : π ∈ GensData.denote n gs) (a : Fin n)
    (ha : a.val ∈ pts) :
    (π a).val ∈ pts ∧
      ∀ b : Fin n, b.val ∈ pts → get cl a = get cl b → get cl (π a) = get cl (π b) := by
  let M : Submonoid (Perm (Fin n)) :=
    { carrier := {π | ∀ a : Fin n, a.val ∈ pts → (π a).val ∈ pts ∧
        ∀ b : Fin n, b.val ∈ pts → get cl a = get cl b → get cl (π a) = get cl (π b)}
      one_mem' := fun a ha => ⟨ha, fun b _ h => h⟩
      mul_mem' := by
        intro π₁ π₂ h₁ h₂ a ha
        obtain ⟨ha₂, hs₂⟩ := h₂ a ha
        obtain ⟨ha₁, hs₁⟩ := h₁ _ ha₂
        refine ⟨ha₁, fun b hb hab => ?_⟩
        obtain ⟨hb₂, -⟩ := h₂ b hb
        exact hs₁ _ hb₂ (hs₂ b hb hab) }
  have hgen : GensData.denoteSet n gs ⊆ M := by
    rintro _ ⟨g, hg, rfl⟩ a ha
    have hgv := hgs g hg
    rw [PermData.val_denote_apply hgv]
    refine ⟨hW.maps g hg _ ha, fun b hb hab => ?_⟩
    rw [PermData.val_denote_apply hgv]
    exact hst g hg _ ha _ hb hab
  rw [GensData.denote, ← Subgroup.mem_toSubmonoid, Subgroup.closure_toSubmonoid_of_finite] at hπ
  exact (Submonoid.closure_le.2 hgen) hπ a ha

/-- The group permutes the classes of invariant labels. -/
theorem permutesBlocks_blocksOf (hW : Win n gs pts) (hgs : GensData.AllValid n gs)
    (hcl : LabelsOK n pts cl) (hst : Stable gs pts cl) :
    PermutesBlocks (GensData.denote n gs) (blocksOf cl pts) := by
  intro g hg b hb
  obtain ⟨l, hl, rfl⟩ := mem_blocksOf.1 hb
  rw [mem_leaders] at hl
  have hga := stable_denote hW hgs hst hg ⟨l, hW.lt l hl.1⟩ hl.1
  refine ⟨_, class_mem_blocksOf hcl hga.1, fun x hx => ?_⟩
  rw [mem_class] at hx ⊢
  obtain ⟨hgx, -⟩ := stable_denote hW hgs hst hg x hx.1
  exact ⟨hgx, hga.2 x hx.1 (hl.2.trans hx.2.symm) |>.symm⟩

end Blocks

end GraphIso.Luks
