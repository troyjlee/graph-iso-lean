module

public import GraphIso.Representation.Permutation
public import GraphIso.Semantics.Window

/-!
# Represented generators and windows

* `GensData`: a list of permutation data, denoting the subgroup generated by the interpreted
  permutations (`GensData.denote`, via `Subgroup.closure`).
* `WinData`: a window given as a duplicate-free list of positions together with a Boolean
  membership array of length `n` (`WinData.Valid`), denoting a set of positions of `Fin n`.

The executable checks `GensData.fixesB` and `GensData.invariantB` inspect only the supplied
generators and the listed window points. `fixesB_iff` and `invariantB_iff` prove that they
decide pointwise fixing and invariance for the whole generated subgroup.
-/

@[expose] public section

namespace GraphIso

open Equiv

/-- Total read of a Boolean array with default `false`. -/
def getB (a : Array Bool) (i : ℕ) : Bool := a.getD i false

/-- Represented generators of a permutation group. -/
abbrev GensData := List PermData

namespace GensData

/-- Every generator is valid data for degree `n`. -/
def AllValid (n : ℕ) (gs : GensData) : Prop := ∀ g ∈ gs, PermData.Valid n g

/-- Executable check of `AllValid`. -/
def allValidB (n : ℕ) (gs : GensData) : Bool := gs.all (PermData.validB n)

theorem allValidB_iff {n : ℕ} {gs : GensData} : allValidB n gs = true ↔ AllValid n gs := by
  simp [allValidB, AllValid, PermData.validB_iff]

theorem AllValid.cons {n : ℕ} {g : PermData} {gs : GensData} (hg : PermData.Valid n g)
    (hgs : AllValid n gs) : AllValid n (g :: gs) := by
  intro h hh
  rcases List.mem_cons.1 hh with rfl | hh
  · exact hg
  · exact hgs h hh

theorem AllValid.append {n : ℕ} {gs hs : GensData} (hgs : AllValid n gs) (hhs : AllValid n hs) :
    AllValid n (gs ++ hs) := by
  intro g hg
  rcases List.mem_append.1 hg with hg | hg
  · exact hgs g hg
  · exact hhs g hg

theorem AllValid.of_cons {n : ℕ} {g : PermData} {gs : GensData} (h : AllValid n (g :: gs)) :
    PermData.Valid n g ∧ AllValid n gs :=
  ⟨h g List.mem_cons_self, fun h' hh => h h' (List.mem_cons_of_mem _ hh)⟩

theorem allValid_nil (n : ℕ) : AllValid n [] := fun _ h => (List.not_mem_nil h).elim

/-- The interpreted generators. -/
def denoteSet (n : ℕ) (gs : GensData) : Set (Perm (Fin n)) :=
  {π | ∃ g ∈ gs, PermData.denote n g = π}

/-- The subgroup generated by the interpreted generators. -/
def denote (n : ℕ) (gs : GensData) : Subgroup (Perm (Fin n)) :=
  Subgroup.closure (denoteSet n gs)

theorem denoteSet_nil (n : ℕ) : denoteSet n [] = ∅ := by
  simp [denoteSet]

theorem denoteSet_cons (n : ℕ) (g : PermData) (gs : GensData) :
    denoteSet n (g :: gs) = insert (PermData.denote n g) (denoteSet n gs) := by
  ext π
  simp only [denoteSet, List.mem_cons, Set.mem_insert_iff, Set.mem_ofPred_eq]
  constructor
  · rintro ⟨h, rfl | hh, rfl⟩
    · exact Or.inl rfl
    · exact Or.inr ⟨h, hh, rfl⟩
  · rintro (rfl | ⟨h, hh, rfl⟩)
    · exact ⟨g, Or.inl rfl, rfl⟩
    · exact ⟨h, Or.inr hh, rfl⟩

theorem denoteSet_append (n : ℕ) (gs hs : GensData) :
    denoteSet n (gs ++ hs) = denoteSet n gs ∪ denoteSet n hs := by
  ext π
  simp only [denoteSet, List.mem_append, Set.mem_union, Set.mem_ofPred_eq]
  constructor
  · rintro ⟨g, hg | hg, rfl⟩
    · exact Or.inl ⟨g, hg, rfl⟩
    · exact Or.inr ⟨g, hg, rfl⟩
  · rintro (⟨g, hg, rfl⟩ | ⟨g, hg, rfl⟩)
    · exact ⟨g, Or.inl hg, rfl⟩
    · exact ⟨g, Or.inr hg, rfl⟩

@[simp] theorem denote_nil (n : ℕ) : denote n [] = ⊥ := by
  rw [denote, denoteSet_nil, Subgroup.closure_empty]

theorem denote_append (n : ℕ) (gs hs : GensData) :
    denote n (gs ++ hs) = denote n gs ⊔ denote n hs := by
  rw [denote, denoteSet_append, Subgroup.closure_union]
  rfl

theorem denote_cons (n : ℕ) (g : PermData) (gs : GensData) :
    denote n (g :: gs) = Subgroup.closure {PermData.denote n g} ⊔ denote n gs := by
  rw [denote, denoteSet_cons, Set.insert_eq, Subgroup.closure_union]
  rfl

theorem mem_denote_of_mem {n : ℕ} {g : PermData} {gs : GensData} (hg : g ∈ gs) :
    PermData.denote n g ∈ denote n gs :=
  Subgroup.subset_closure ⟨g, hg, rfl⟩

theorem denote_le_iff {n : ℕ} {gs : GensData} {H : Subgroup (Perm (Fin n))} :
    denote n gs ≤ H ↔ ∀ g ∈ gs, PermData.denote n g ∈ H := by
  rw [denote, Subgroup.closure_le]
  constructor
  · intro h g hg
    exact h ⟨g, hg, rfl⟩
  · rintro h _ ⟨g, hg, rfl⟩
    exact h g hg

theorem denote_eq_closure_of_forall {n : ℕ} {gs : GensData} {S : Set (Perm (Fin n))}
    (h : denoteSet n gs = S) : denote n gs = Subgroup.closure S := by
  rw [denote, h]

end GensData

/-! ### Windows -/

/-- A represented window: a list of positions and a Boolean membership array. -/
abbrev WinData := List ℕ × Array Bool

namespace WinData

/-- Valid window data for degree `n`: the list has no duplicates and lists exactly the
positions whose mask entry is `true`. -/
structure Valid (n : ℕ) (w : WinData) : Prop where
  size_mask : w.2.size = n
  nodup : w.1.Nodup
  lt : ∀ i ∈ w.1, i < n
  mask_iff : ∀ i < n, getB w.2 i = true ↔ i ∈ w.1

/-- Executable validity check. -/
def validB (n : ℕ) (w : WinData) : Bool :=
  w.2.size == n && decide w.1.Nodup && w.1.all (fun i => decide (i < n)) &&
    (List.range n).all fun i => getB w.2 i == decide (i ∈ w.1)

theorem validB_iff {n : ℕ} {w : WinData} : validB n w = true ↔ Valid n w := by
  simp only [validB, Bool.and_eq_true, decide_eq_true_eq, List.all_eq_true,
    List.mem_range, Bool.beq_eq_decide_eq, decide_eq_true_eq]
  constructor
  · rintro ⟨⟨⟨h1, h2⟩, h3⟩, h4⟩
    refine ⟨h1, h2, h3, fun i hi => ?_⟩
    have := h4 i hi
    cases hb : getB w.2 i <;> simp_all
  · intro h
    refine ⟨⟨⟨h.size_mask, h.nodup⟩, h.lt⟩, fun i hi => ?_⟩
    have := h.mask_iff i hi
    cases hb : getB w.2 i <;> simp_all

/-- The interpreted window. -/
def denote (n : ℕ) (w : WinData) : Set (Fin n) := {u | u.val ∈ w.1}

/-- Membership test using the mask: one array read. -/
def mem (w : WinData) (i : ℕ) : Bool := getB w.2 i

theorem mem_denote {n : ℕ} {w : WinData} {u : Fin n} : u ∈ w.denote n ↔ u.val ∈ w.1 :=
  Iff.rfl

theorem mem_eq_true_iff {n : ℕ} {w : WinData} (hw : Valid n w) (u : Fin n) :
    w.mem u = true ↔ u ∈ w.denote n :=
  hw.mask_iff u u.2

theorem mem_eq_true_iff_of_lt {n : ℕ} {w : WinData} (hw : Valid n w) {i : ℕ} (hi : i < n) :
    w.mem i = true ↔ i ∈ w.1 :=
  hw.mask_iff i hi

theorem denote_finite (n : ℕ) (w : WinData) : (w.denote n).Finite := Set.toFinite _

/-- The listed positions, as elements of `Fin n`. -/
theorem forall_mem_denote {n : ℕ} {w : WinData} (hw : Valid n w) {p : Fin n → Prop} :
    (∀ u ∈ w.denote n, p u) ↔ ∀ i (h : i ∈ w.1), p ⟨i, hw.lt i h⟩ := by
  constructor
  · intro hp i hi
    exact hp _ hi
  · intro hp u hu
    exact hp u.val hu

theorem denote_eq_empty_iff {n : ℕ} {w : WinData} (hw : Valid n w) :
    w.denote n = ∅ ↔ w.1 = [] := by
  constructor
  · intro h
    cases hl : w.1 with
    | nil => rfl
    | cons i is =>
      have hi : i ∈ w.1 := by rw [hl]; exact List.mem_cons_self
      have : (⟨i, hw.lt i hi⟩ : Fin n) ∈ w.denote n := hi
      rw [h] at this
      exact this.elim
  · intro h
    ext u
    simp [denote, h]

/-- The number of positions of a valid window is the length of its list. -/
theorem ncard_denote {n : ℕ} {w : WinData} (hw : Valid n w) : (w.denote n).ncard = w.1.length := by
  have : w.denote n = Fin.val ⁻¹' (w.1.toFinset : Set ℕ) := by
    ext u
    simp [denote]
  rw [this, Set.ncard_preimage_of_injective_subset_range Fin.val_injective, Set.ncard_coe_finset,
    List.toFinset_card_of_nodup hw.nodup]
  intro i hi
  exact ⟨⟨i, hw.lt i (List.mem_toFinset.1 hi)⟩, rfl⟩

/-- A valid window of degree `n` has at most `n` points. -/
theorem length_le {n : ℕ} {w : WinData} (hw : Valid n w) : w.1.length ≤ n := by
  have hsub : w.1.toFinset ⊆ Finset.range n := fun i hi =>
    Finset.mem_range.2 (hw.lt i (List.mem_toFinset.1 hi))
  have := Finset.card_le_card hsub
  rwa [List.toFinset_card_of_nodup hw.nodup, Finset.card_range] at this

end WinData

/-! ### Executable checks on generators -/

namespace GensData

/-- Does every generator fix every listed window point? -/
def fixesB (gs : GensData) (w : WinData) : Bool :=
  gs.all fun g => w.1.all fun u => get g.1 u == u

/-- Does every generator map every listed window point into the window? -/
def invariantB (gs : GensData) (w : WinData) : Bool :=
  gs.all fun g => w.1.all fun u => w.mem (get g.1 u)

theorem fixesB_iff {n : ℕ} {gs : GensData} {w : WinData} (hgs : AllValid n gs)
    (hw : w.Valid n) : fixesB gs w = true ↔ FixesPointwise (denote n gs) (w.denote n) := by
  rw [denote, fixesPointwise_closure_iff]
  simp only [fixesB, List.all_eq_true, beq_iff_eq]
  constructor
  · rintro h _ ⟨g, hg, rfl⟩ u hu
    exact Fin.ext ((PermData.val_denote_apply (hgs g hg) u).trans (h g hg u hu))
  · intro h g hg u hu
    have := congrArg Fin.val (h _ ⟨g, hg, rfl⟩ ⟨u, hw.lt u hu⟩ hu)
    rwa [PermData.val_denote_apply (hgs g hg)] at this

theorem invariantB_iff {n : ℕ} {gs : GensData} {w : WinData} (hgs : AllValid n gs)
    (hw : w.Valid n) : invariantB gs w = true ↔ IsInvariant (denote n gs) (w.denote n) := by
  rw [denote, isInvariant_closure_iff (WinData.denote_finite n w)]
  simp only [invariantB, List.all_eq_true]
  constructor
  · rintro h _ ⟨g, hg, rfl⟩ u hu
    have := h g hg u hu
    rw [← PermData.val_denote_apply (hgs g hg) u] at this
    exact (WinData.mem_eq_true_iff hw _).1 this
  · intro h g hg u hu
    have := (WinData.mem_eq_true_iff hw _).2 (h _ ⟨g, hg, rfl⟩ ⟨u, hw.lt u hu⟩ hu)
    rwa [PermData.val_denote_apply (hgs g hg)] at this

end GensData

end GraphIso
