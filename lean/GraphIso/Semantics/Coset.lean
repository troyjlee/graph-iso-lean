module

public import Mathlib.GroupTheory.Coset.Basic
public import Mathlib.Algebra.Group.Subgroup.Lattice
public import Mathlib.Data.Set.Lattice.Indexed
public import Mathlib.Algebra.Group.Pointwise.Set.Lattice
public import Mathlib.Tactic.Group

/-!
# Left cosets, covers, and subgroup reconstruction

The library uses left cosets `a • (H : Set M) = {a * h | h ∈ H}` throughout
(mathlib's `mem_leftCoset_iff : x ∈ a • H ↔ a⁻¹ * x ∈ H`). These lemmas are stated for an
arbitrary group; they are applied to `Equiv.Perm Ω`.

* `IsLeftCover G K r`: the family `r` lies in `G` and its left cosets of `K` cover `G`.
  `IsLeftTransversal` additionally requires distinct cosets; correctness of branching only
  needs the cover, while distinctness is what bounds the number of branches.
* `eq_closure_of_leftCoset_eq_iUnion`: if a coset `a • A` of a subgroup is the union of
  cosets `τ i • H i`, then `A` is generated by the `H i` together with the representative
  differences `(τ i₀)⁻¹ * τ i`. This is the reconstruction used after branching. It needs
  the union to be *exactly* a single coset of a subgroup; generating a subgroup from an
  arbitrary union of cosets can overshoot.
-/

@[expose] public section

namespace GraphIso

open Pointwise

variable {M : Type*} [Group M]

theorem mem_leftCoset_iff' {a x : M} {H : Subgroup M} :
    x ∈ a • (H : Set M) ↔ a⁻¹ * x ∈ H :=
  mem_leftCoset_iff a

theorem mem_leftCoset_of_mem {a h : M} {H : Subgroup M} (hh : h ∈ H) :
    a * h ∈ a • (H : Set M) := by
  rw [mem_leftCoset_iff']
  simpa using hh

theorem self_mem_leftCoset (a : M) (H : Subgroup M) : a ∈ a • (H : Set M) := by
  rw [mem_leftCoset_iff']
  simp

theorem leftCoset_eq_of_mem {a b : M} {H : Subgroup M} (h : b ∈ a • (H : Set M)) :
    b • (H : Set M) = a • (H : Set M) := by
  rw [leftCoset_eq_iff]
  rw [mem_leftCoset_iff'] at h
  simpa using inv_mem h

theorem leftCoset_subset_leftCoset {a b : M} {H K : Subgroup M} (hb : b ∈ a • (K : Set M))
    (hHK : H ≤ K) : b • (H : Set M) ⊆ a • (K : Set M) := by
  intro x hx
  rw [mem_leftCoset_iff'] at hb hx ⊢
  have : a⁻¹ * x = (a⁻¹ * b) * (b⁻¹ * x) := by group
  rw [this]
  exact mul_mem hb (hHK hx)

theorem one_leftCoset (H : Subgroup M) : (1 : M) • (H : Set M) = H := one_smul M _

/-- The representatives `r i` lie in `G`, and their left cosets of `K` cover `G`. -/
structure IsLeftCover {ι : Type*} (G K : Subgroup M) (r : ι → M) : Prop where
  mem : ∀ i, r i ∈ G
  cover : ∀ g ∈ G, ∃ i, (r i)⁻¹ * g ∈ K

/-- A left transversal: a cover by pairwise distinct left cosets. -/
structure IsLeftTransversal {ι : Type*} (G K : Subgroup M) (r : ι → M) : Prop
    extends IsLeftCover G K r where
  distinct : ∀ i j, (r i)⁻¹ * r j ∈ K → i = j

variable {ι : Type*}

theorem IsLeftCover.coe_eq_iUnion {G K : Subgroup M} {r : ι → M} (hr : IsLeftCover G K r)
    (hK : K ≤ G) : (G : Set M) = ⋃ i, r i • (K : Set M) := by
  ext g
  simp only [Set.mem_iUnion, SetLike.mem_coe]
  constructor
  · intro hg
    obtain ⟨i, hi⟩ := hr.cover g hg
    exact ⟨i, (mem_leftCoset_iff' (H := K)).2 hi⟩
  · rintro ⟨i, hi⟩
    rw [mem_leftCoset_iff'] at hi
    have : g = r i * ((r i)⁻¹ * g) := by group
    rw [this]
    exact mul_mem (hr.mem i) (hK hi)

/-- Branching decomposition of an arbitrary left coset `σ • G` along a cover of `G` by left
cosets of `K`. -/
theorem IsLeftCover.leftCoset_eq_iUnion {G K : Subgroup M} {r : ι → M}
    (hr : IsLeftCover G K r) (hK : K ≤ G) (σ : M) :
    σ • (G : Set M) = ⋃ i, (σ * r i) • (K : Set M) := by
  rw [hr.coe_eq_iUnion hK, Set.smul_set_iUnion]
  simp only [mul_smul]

/-- **Subgroup reconstruction.** If the left coset `a • A` of the subgroup `A` is the union of
the cosets `τ i • H i`, then for any chosen index `i₀`, the subgroup `A` is generated by the
subgroups `H i` together with the representative differences `(τ i₀)⁻¹ * τ i`. -/
theorem eq_closure_of_leftCoset_eq_iUnion {A : Subgroup M} {a : M} {τ : ι → M}
    {H : ι → Subgroup M} (hS : a • (A : Set M) = ⋃ i, τ i • (H i : Set M)) (i₀ : ι) :
    A = Subgroup.closure ((⋃ i, (H i : Set M)) ∪ Set.range fun i => (τ i₀)⁻¹ * τ i) := by
  -- every representative and every branch coset lies in the coset `a • A`
  have hτ : ∀ i, τ i ∈ a • (A : Set M) := fun i => by
    rw [hS]
    exact Set.mem_iUnion.2 ⟨i, self_mem_leftCoset _ _⟩
  have hH : ∀ i, ∀ h ∈ H i, τ i * h ∈ a • (A : Set M) := fun i h hh => by
    rw [hS]
    exact Set.mem_iUnion.2 ⟨i, mem_leftCoset_of_mem hh⟩
  apply le_antisymm
  · intro g hg
    have hg' : τ i₀ * g ∈ a • (A : Set M) := by
      rw [← leftCoset_eq_of_mem (hτ i₀)]
      exact mem_leftCoset_of_mem hg
    rw [hS] at hg'
    obtain ⟨i, hi⟩ := Set.mem_iUnion.1 hg'
    rw [mem_leftCoset_iff'] at hi
    have : g = ((τ i₀)⁻¹ * τ i) * ((τ i)⁻¹ * (τ i₀ * g)) := by group
    rw [this]
    refine mul_mem (Subgroup.subset_closure (Or.inr ⟨i, rfl⟩))
      (Subgroup.subset_closure (Or.inl (Set.mem_iUnion.2 ⟨i, hi⟩)))
  · rw [Subgroup.closure_le]
    rintro g (hg | ⟨i, rfl⟩)
    · obtain ⟨i, hi⟩ := Set.mem_iUnion.1 hg
      have h1 := (mem_leftCoset_iff' (H := A)).1 (hτ i)
      have h2 := (mem_leftCoset_iff' (H := A)).1 (hH i g hi)
      have : g = (a⁻¹ * τ i)⁻¹ * (a⁻¹ * (τ i * g)) := by group
      rw [SetLike.mem_coe, this]
      exact mul_mem (inv_mem h1) h2
    · have h0 := (mem_leftCoset_iff' (H := A)).1 (hτ i₀)
      have h1 := (mem_leftCoset_iff' (H := A)).1 (hτ i)
      have : (τ i₀)⁻¹ * τ i = (a⁻¹ * τ i₀)⁻¹ * (a⁻¹ * τ i) := by group
      show (τ i₀)⁻¹ * τ i ∈ A
      rw [this]
      exact mul_mem (inv_mem h0) h1

/-- The coset form of `eq_closure_of_leftCoset_eq_iUnion`: the union is the coset of the
reconstructed subgroup through the chosen representative. -/
theorem leftCoset_eq_smul_closure_of_eq_iUnion {A : Subgroup M} {a : M} {τ : ι → M}
    {H : ι → Subgroup M} (hS : a • (A : Set M) = ⋃ i, τ i • (H i : Set M)) (i₀ : ι) :
    a • (A : Set M) = τ i₀ •
      (Subgroup.closure ((⋃ i, (H i : Set M)) ∪ Set.range fun i => (τ i₀)⁻¹ * τ i) : Set M) := by
  rw [← eq_closure_of_leftCoset_eq_iUnion hS i₀]
  refine (leftCoset_eq_of_mem ?_).symm
  rw [hS]
  exact Set.mem_iUnion.2 ⟨i₀, self_mem_leftCoset _ _⟩

end GraphIso
