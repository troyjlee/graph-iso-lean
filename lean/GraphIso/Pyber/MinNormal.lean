module

public import GraphIso.Pyber.Orbital
public import GraphIso.Pyber.Generators
public import Mathlib.Tactic.Group

/-!
# Minimal normal subgroups of primitive groups (Pyber's Lemma 10, without socles)

Stage 15c. `G` is a finite group acting faithfully and primitively on a finite `Ω`, and `N` is a
minimal normal subgroup of `G` (15a's `IsMinNormal`).

* **Normal subgroups are transitive** (`isPretransitive_of_normal`): a nontrivial normal subgroup
  of a faithful primitive group acts transitively (mathlib's quasiprimitivity).
* **Abelian `N`** (`card_le_of_comm`): a commutative transitive normal subgroup is regular, so
  `|N| = |Ω|`. A point stabilizer `G_x` acts faithfully on `N` by conjugation, so it embeds into
  the maps from a generating list of `N` (of length at most `λ(|N|)`, 15a item 7) to `N`. Hence
  `|G| ≤ |Ω|^(λ(|Ω|) + 1)`. This replaces Pyber's `G / Soc(G) ↪ GL(s, p)`.
* **Nonabelian `N`** (`compA_subset_of_noncomm`): `N` is characteristically simple, so
  `compA N = ∅` (15a item 5), and `G_x` maps onto `G ⧸ N` since `N` is transitive. Hence
  `compA G ⊆ compA G_x`.
* **The dichotomy** (`card_le_or_compA_subset`): for `G` nontrivial, either
  `|G| ≤ |Ω|^(λ(|Ω|) + 1)` or `compA G ⊆ compA G_x`.
-/

@[expose] public section

namespace GraphIso.Pyber

open Subgroup MulAction

variable {G Ω : Type*} [Group G] [MulAction G Ω]

/-- **A nontrivial normal subgroup of a faithful primitive group is transitive.** -/
theorem isPretransitive_of_normal [IsPreprimitive G Ω] (hf : Faithful G Ω) {N : Subgroup G}
    [N.Normal] (hN : N ≠ ⊥) : IsPretransitive N Ω := by
  apply IsQuasiPreprimitive.isPretransitive_of_normal
  intro h
  apply hN
  rw [eq_bot_iff]
  intro n hn
  rw [mem_bot]
  apply hf
  intro a
  have ha : a ∈ fixedPoints N Ω := h ▸ Set.mem_univ a
  exact ha ⟨n, hn⟩

/-- **A commutative transitive subgroup acts regularly:** its point stabilizers are trivial. -/
theorem stabilizer_eq_bot_of_comm (hf : Faithful G Ω) {N : Subgroup G} [IsPretransitive N Ω]
    (hc : ∀ a ∈ N, ∀ b ∈ N, a * b = b * a) (x : Ω) : stabilizer N x = ⊥ := by
  rw [eq_bot_iff]
  intro n hn
  rw [mem_bot]
  apply Subtype.ext
  apply hf
  intro a
  obtain ⟨m, rfl⟩ := exists_smul_eq N x a
  change (n : G) • (m : G) • x = (m : G) • x
  rw [← mul_smul, hc n n.2 m m.2, mul_smul]
  exact congrArg _ hn

/-- A regular action: `|N| = |Ω|`. -/
theorem card_eq_of_comm [Finite G] (hf : Faithful G Ω) {N : Subgroup G} [IsPretransitive N Ω]
    (hc : ∀ a ∈ N, ∀ b ∈ N, a * b = b * a) (x : Ω) : Nat.card N = Nat.card Ω := by
  have h := card_mul_index (stabilizer N x)
  rw [index_stabilizer_of_transitive, stabilizer_eq_bot_of_comm hf hc x, card_bot, one_mul] at h
  exact h.symm

/-- **The conjugation embedding.** If `N` is transitive and generated by the list `l`, an element
of `G_x` is determined by its conjugates of the members of `l`. -/
theorem conj_injective (hf : Faithful G Ω) {N : Subgroup G} [IsPretransitive N Ω] (x : Ω)
    {l : List G} (hl : closure {a | a ∈ l} = N) {g g' : G} (hg : g ∈ stabilizer G x)
    (hg' : g' ∈ stabilizer G x) (h : ∀ a ∈ l, g * a * g⁻¹ = g' * a * g'⁻¹) : g = g' := by
  set k := g'⁻¹ * g
  have hk : ∀ a ∈ N, k * a = a * k := by
    intro a ha
    rw [← hl] at ha
    induction ha using closure_induction with
    | mem a ha =>
      have h1 := h a ha
      simp only [k]
      calc g'⁻¹ * g * a = g'⁻¹ * (g * a * g⁻¹) * g := by group
        _ = g'⁻¹ * (g' * a * g'⁻¹) * g := by rw [h1]
        _ = a * (g'⁻¹ * g) := by group
    | one => rw [mul_one, one_mul]
    | mul a b _ _ iha ihb => rw [← mul_assoc, iha, mul_assoc, ihb, mul_assoc]
    | inv a _ iha =>
      rw [mul_inv_eq_iff_eq_mul, mul_assoc, iha, ← mul_assoc, inv_mul_cancel, one_mul]
  have hkx : k • x = x := by
    change (g'⁻¹ * g) • x = x
    rw [mul_smul, hg, inv_smul_eq_iff, hg']
  have hk1 : k = 1 := hf k fun a => by
    obtain ⟨n, rfl⟩ := exists_smul_eq N x a
    change k • (n : G) • x = (n : G) • x
    rw [← mul_smul, hk n n.2, mul_smul, hkx]
  rw [← mul_inv_cancel_left g' g]
  change g' * k = g'
  rw [hk1, mul_one]

/-- **Abelian minimal normal subgroups:** if a commutative nontrivial normal subgroup `N` of a
faithful primitive finite group is given, then `|G| ≤ |Ω|^(λ(|Ω|) + 1)`. -/
theorem card_le_of_comm [Finite G] [Finite Ω] [IsPreprimitive G Ω] (hf : Faithful G Ω)
    {N : Subgroup G} [N.Normal] (hN : N ≠ ⊥) (hc : ∀ a ∈ N, ∀ b ∈ N, a * b = b * a) (x : Ω) :
    Nat.card G ≤ Nat.card Ω ^ (Nat.log 2 (Nat.card Ω) + 1) := by
  have : Nonempty Ω := ⟨x⟩
  have := isPretransitive_of_normal hf hN
  have hcard := card_eq_of_comm hf hc x
  obtain ⟨l, hl, hlen⟩ := exists_list_closure_eq_top (G := N)
  set l' := l.map N.subtype
  have hl' : closure {a | a ∈ l'} = N := by
    have := congrArg (map N.subtype) hl
    rw [MonoidHom.map_closure, ← MonoidHom.range_eq_map, range_subtype] at this
    rw [← this]
    congr 1
    ext a
    simp [l']
  -- the embedding of `G_x` into the maps from `Fin |l|` to `N`
  set F : stabilizer G x → (Fin l.length → N) := fun g i => MulAut.conjNormal (g : G) (l.get i)
  have hF : Function.Injective F := by
    intro g g' he
    apply Subtype.ext
    apply conj_injective hf x hl' g.2 g'.2
    intro a ha
    obtain ⟨b, hb, rfl⟩ := List.mem_map.mp ha
    obtain ⟨i, rfl⟩ := List.get_of_mem hb
    have := congrArg Subtype.val (congrFun he i)
    simpa [F] using this
  have h1 := Nat.card_le_card_of_injective F hF
  rw [Nat.card_fun, Nat.card_eq_fintype_card (α := Fin l.length), Fintype.card_fin,
    hcard] at h1
  have h2 : Nat.card (stabilizer G x) ≤ Nat.card Ω ^ Nat.log 2 (Nat.card Ω) :=
    h1.trans (Nat.pow_le_pow_right Nat.card_pos (hcard ▸ hlen))
  have h3 := card_mul_index (stabilizer G x)
  rw [index_stabilizer_of_transitive] at h3
  rw [← h3, pow_succ]
  exact Nat.mul_le_mul_right _ h2

/-- **Nonabelian minimal normal subgroups:** `compA G ⊆ compA G_x`. -/
theorem compA_subset_of_noncomm [Finite G] [IsPreprimitive G Ω] (hf : Faithful G Ω)
    {N : Subgroup G} (hN : IsMinNormal N) (hnc : ∃ a b : N, a * b ≠ b * a) (x : Ω) :
    compA G ⊆ compA (stabilizer G x) := by
  have := hN.normal
  have : Nontrivial N := (nontrivial_iff_ne_bot N).mpr hN.ne_bot
  have := isPretransitive_of_normal hf hN.ne_bot
  have hNe : compA N = ∅ := compA_eq_empty_of_charSimple hN.charSimple hnc
  refine (compA_subset_union N).trans ?_
  rw [hNe, Set.empty_union]
  -- `G_x` maps onto `G ⧸ N`
  apply compA_subset_of_surjective ((QuotientGroup.mk' N).comp (stabilizer G x).subtype)
  intro q
  obtain ⟨g, rfl⟩ := QuotientGroup.mk'_surjective N q
  obtain ⟨n, hn⟩ := exists_smul_eq N x (g • x)
  refine ⟨⟨(n : G)⁻¹ * g, ?_⟩, ?_⟩
  · change ((n : G)⁻¹ * g) • x = x
    rw [mul_smul, inv_smul_eq_iff]
    exact hn.symm
  · change (((n : G)⁻¹ * g : G) : G ⧸ N) = (g : G ⧸ N)
    rw [QuotientGroup.eq]
    have h := (inferInstance : N.Normal).conj_mem _ n.2 g⁻¹
    rwa [show ((n : G)⁻¹ * g)⁻¹ * g = g⁻¹ * n * g⁻¹⁻¹ by group]

/-- **The dichotomy of Lemma 10:** for a nontrivial finite group acting faithfully and
primitively on a finite set, `|G| ≤ |Ω|^(λ(|Ω|) + 1)` or `compA G ⊆ compA G_x`. -/
theorem card_le_or_compA_subset [Finite G] [Nontrivial G] [Finite Ω] [IsPreprimitive G Ω]
    (hf : Faithful G Ω) (x : Ω) :
    Nat.card G ≤ Nat.card Ω ^ (Nat.log 2 (Nat.card Ω) + 1) ∨
      compA G ⊆ compA (stabilizer G x) := by
  obtain ⟨N, hN⟩ := exists_isMinNormal (G := G)
  have := hN.normal
  by_cases hc : ∀ a ∈ N, ∀ b ∈ N, a * b = b * a
  · exact Or.inl (card_le_of_comm hf hN.ne_bot hc x)
  · refine Or.inr (compA_subset_of_noncomm hf hN ?_ x)
    push Not at hc
    obtain ⟨a, ha, b, hb, hab⟩ := hc
    exact ⟨⟨a, ha⟩, ⟨b, hb⟩, fun h => hab (congrArg Subtype.val h)⟩

end GraphIso.Pyber
