module

public import GraphIso.Pyber.Bridge
public import Mathlib.Algebra.Group.Pointwise.Set.Card

/-!
# Orbitals, the connectivity lemma, and Jordan's lemma

Stage 15b (`PLAN-15.md` §4, items 3–5). `G` acts on `Ω`, and `Ω × Ω` carries the diagonal
action. For `x ≠ y`, the *orbital* of `(x, y)` is its orbit `O = orbit G (x, y)` in `Ω × Ω`;
the *suborbit* at `x` is `Δ(x) = orbit (stabilizer G x) y`, and `(x, b) ∈ O ↔ b ∈ Δ(x)`
(`mem_orbit_stabilizer_iff`). No new definitions are made: statements use `orbit` directly.

* **Orbitals** (item 3):
  - the *paired suborbit* `{b | (b, x) ∈ O}` has the size of `Δ(x)` for a transitive action of
    a finite group on a finite set (`ncard_paired_eq`);
  - for `G` finite of odd order, no orbital with `x ≠ y` is *self-paired*: `(y, x) ∉ O`
    (`swap_notMem_orbit`); so `2 |Δ(x)| + 1 ≤ |Ω|` for a transitive action on a finite set
    (`two_mul_ncard_suborbit_add_one_le`);
  - an element `g` with `g * g = 1` gives the self-paired orbital of `(x, g • x)`
    (`swap_mem_orbit_of_mul_self`).
* **Connectivity** (item 4, `eq_univ_of_closed`): for a primitive action of a finite group,
  `x ≠ y`, and `F ∋ x` closed along `O`, `F = Ω`. Closure along `O` gives closure along its
  reverse, by following the powers of an element mapping one end of an edge to the other; the
  class of `x` under the equivalence generated by `O` is then a block containing `x` and `y`.
* **Jordan's Lemma 1** (item 5, `prime_dvd_card_range`): for a faithful primitive action of a
  finite group and `x ≠ y`, every prime dividing `|G_x|` divides `|P|`, where `P` is the image
  of `G_x` in `Perm Δ(x)`. An element of prime order `p ∤ |P|` acts trivially on every suborbit
  at a point it fixes, so its fixed points are closed along `O`.
-/

@[expose] public section

namespace GraphIso.Pyber

open Subgroup MulAction
open scoped Pointwise

variable {G Ω : Type*} [Group G] [MulAction G Ω]

/-! ### Orbitals -/

/-- The orbital is invariant: it is an orbit of the diagonal action. -/
theorem smul_mem_orbit_pair {x y a b : Ω} (h : (a, b) ∈ orbit G (x, y)) (g : G) :
    (g • a, g • b) ∈ orbit G (x, y) := by
  obtain ⟨k, hk⟩ := h
  refine ⟨g * k, ?_⟩
  change (g * k) • (x, y) = (g • a, g • b)
  rw [mul_smul, show k • (x, y) = (a, b) from hk]
  rfl

/-- **The suborbit:** `(x, b)` lies in the orbital of `(x, y)` iff `b ∈ Δ(x)`. -/
theorem mem_orbit_stabilizer_iff {x y b : Ω} :
    b ∈ orbit (stabilizer G x) y ↔ (x, b) ∈ orbit G (x, y) := by
  constructor
  · rintro ⟨h, rfl⟩
    exact ⟨h, Prod.ext h.2 rfl⟩
  · rintro ⟨g, hg⟩
    exact ⟨⟨g, (Prod.ext_iff.mp hg).1⟩, (Prod.ext_iff.mp hg).2⟩

/-- `(x, x)` is not in the orbital of `(x, y)` when `x ≠ y`. -/
theorem diag_notMem_orbit {x y a : Ω} (hxy : x ≠ y) : (a, a) ∉ orbit G (x, y) := by
  rintro ⟨g, hg⟩
  have h1 := (Prod.ext_iff.mp hg).1
  have h2 := (Prod.ext_iff.mp hg).2
  exact hxy (smul_left_cancel g (h1.trans h2.symm))

/-- `|Δ(x)| = [G_x : G_x ∩ G_y]`: the stabilizer of `y` in `G_x` is `G_y ∩ G_x`. -/
theorem ncard_orbit_stabilizer (x y : Ω) :
    (orbit (stabilizer G x) y).ncard = (stabilizer G y).relIndex (stabilizer G x) := by
  rw [← index_stabilizer]
  rfl

/-- `[K : H ∩ K] = [H : H ∩ K]` for subgroups of equal finite index. -/
theorem relIndex_comm_of_index_eq {H K : Subgroup G} (h : H.index = K.index)
    (h0 : K.index ≠ 0) : H.relIndex K = K.relIndex H := by
  have h1 := relIndex_mul_index (inf_le_right : H ⊓ K ≤ K)
  have h2 := relIndex_mul_index (inf_le_right : K ⊓ H ≤ H)
  rw [inf_relIndex_right] at h1
  rw [inf_relIndex_right, inf_comm, ← h1, h] at h2
  exact (Nat.eq_of_mul_eq_mul_right (Nat.pos_of_ne_zero h0) h2).symm

/-- **The paired suborbit has the size of the suborbit**, for a transitive action of a finite
group on a finite set. -/
theorem ncard_paired_eq [Finite G] [Finite Ω] [IsPretransitive G Ω] (x y : Ω) :
    {b | (b, x) ∈ orbit G (x, y)}.ncard = (orbit (stabilizer G x) y).ncard := by
  obtain ⟨k, hk⟩ := exists_smul_eq G y x
  have he : {b | (b, x) ∈ orbit G (x, y)} = k • orbit (stabilizer G y) x := by
    ext b
    rw [Set.mem_ofPred_eq, Set.mem_smul_set]
    constructor
    · rintro ⟨g, hg⟩
      have h1 := (Prod.ext_iff.mp hg).1
      have h2 := (Prod.ext_iff.mp hg).2
      refine ⟨(k⁻¹ * g) • x, ⟨⟨k⁻¹ * g, ?_⟩, rfl⟩, ?_⟩
      · change (k⁻¹ * g) • y = y
        rw [mul_smul]
        exact (inv_smul_eq_iff.mpr (h2.trans hk.symm))
      · rw [← mul_smul, mul_inv_cancel_left]
        exact h1
    · rintro ⟨c, ⟨h, rfl⟩, rfl⟩
      refine ⟨k * h, Prod.ext ?_ ?_⟩
      · exact mul_smul k h x
      · change (k * h) • y = x
        rw [mul_smul, show (h : G) • y = y from h.2, hk]
  have : Nonempty Ω := ⟨x⟩
  have hn : ∀ z : Ω, (stabilizer G z).index = Nat.card Ω := fun z =>
    index_stabilizer_of_transitive G z
  rw [he, Set.ncard_smul_set, ncard_orbit_stabilizer, ncard_orbit_stabilizer]
  exact relIndex_comm_of_index_eq (H := stabilizer G x) ((hn x).trans (hn y).symm)
    ((hn y).trans_ne Nat.card_pos.ne')

/-- **Odd order: no self-paired orbitals.** If `|G|` is odd and `x ≠ y`, then `(y, x)` is not
in the orbital of `(x, y)`: an element swapping `x` and `y` would have even order. -/
theorem swap_notMem_orbit [Finite G] (hodd : Odd (Nat.card G)) {x y : Ω} (hxy : x ≠ y) :
    (y, x) ∉ orbit G (x, y) := by
  rintro ⟨g, hg⟩
  have h1 : g • x = y := (Prod.ext_iff.mp hg).1
  have h2 : g • y = x := (Prod.ext_iff.mp hg).2
  have hpow : ∀ m : ℕ, g ^ (2 * m) • x = x := by
    intro m
    induction m with
    | zero => rw [mul_zero, pow_zero, one_smul]
    | succ m ih => rw [mul_add, mul_one, pow_add, mul_smul, sq, mul_smul, h1, h2, ih]
  obtain ⟨m, hm⟩ := hodd.of_dvd_nat (orderOf_dvd_natCard g)
  apply hxy
  calc x = g ^ orderOf g • x := by rw [pow_orderOf_eq_one, one_smul]
    _ = y := by rw [hm, pow_succ', mul_smul, hpow, h1]

/-- **Odd order: small suborbits.** If `G` and `Ω` are finite, `|G|` is odd, the action is
transitive and `x ≠ y`, then `2 |Δ(x)| + 1 ≤ |Ω|`: the suborbit and the paired suborbit are
disjoint, have the same size, and avoid `x`. -/
theorem two_mul_ncard_suborbit_add_one_le [Finite G] [Finite Ω] [IsPretransitive G Ω]
    (hodd : Odd (Nat.card G)) {x y : Ω} (hxy : x ≠ y) :
    2 * (orbit (stabilizer G x) y).ncard + 1 ≤ Nat.card Ω := by
  set D' := {b | (b, x) ∈ orbit G (x, y)}
  have hdisj : Disjoint (orbit (stabilizer G x) y) D' := by
    rw [Set.disjoint_left]
    intro b hb hb'
    rw [mem_orbit_stabilizer_iff] at hb
    have hbx : x ≠ b := by
      rintro rfl
      exact diag_notMem_orbit hxy hb
    have hO : orbit G (x, b) = orbit G (x, y) := orbit_eq_iff.mpr hb
    exact swap_notMem_orbit hodd hbx (hO ▸ hb')
  have hsub : orbit (stabilizer G x) y ∪ D' ⊆ ({x} : Set Ω)ᶜ := by
    rintro b (hb | hb) rfl
    · exact diag_notMem_orbit hxy (mem_orbit_stabilizer_iff.mp hb)
    · exact diag_notMem_orbit hxy hb
  have h1 := Set.ncard_le_ncard hsub
  rw [Set.ncard_union_eq hdisj, ncard_paired_eq] at h1
  have h2 := Set.ncard_add_ncard_compl ({x} : Set Ω)
  rw [Set.ncard_singleton] at h2
  omega

/-- **An involution gives a self-paired orbital:** if `g * g = 1`, then `(g • x, x)` lies in
the orbital of `(x, g • x)`. -/
theorem swap_mem_orbit_of_mul_self {g : G} (hg : g * g = 1) (x : Ω) :
    (g • x, x) ∈ orbit G (x, g • x) :=
  ⟨g, Prod.ext rfl (by rw [Prod.smul_snd, ← mul_smul, hg, one_smul])⟩

/-! ### Connectivity -/

/-- **The connectivity lemma.** For a primitive action of a finite group, `x ≠ y`, and a set
`F ∋ x` closed along the orbital of `(x, y)`: `F` is everything. -/
theorem eq_univ_of_closed [Finite G] [IsPreprimitive G Ω] {x y : Ω} (hxy : x ≠ y) {F : Set Ω}
    (hx : x ∈ F) (hF : ∀ a b, a ∈ F → (a, b) ∈ orbit G (x, y) → b ∈ F) : F = Set.univ := by
  set R : Ω → Ω → Prop := fun a b => (a, b) ∈ orbit G (x, y)
  -- closure along the reverse
  have hrev : ∀ a b, a ∈ F → R b a → b ∈ F := by
    intro a b ha hba
    obtain ⟨k, hk⟩ := exists_smul_eq G b a
    have hstep : ∀ m : ℕ, k ^ m • a ∈ F := by
      intro m
      induction m with
      | zero => rwa [pow_zero, one_smul]
      | succ m ih =>
        have he := smul_mem_orbit_pair hba (k ^ (m + 1))
        rw [pow_succ, mul_smul, hk, mul_smul] at he
        rw [pow_succ, mul_smul]
        exact hF _ _ ih he
    have hpos := (isOfFinOrder_of_finite k).orderOf_pos
    have h := hstep (orderOf k - 1)
    rwa [← hk, ← mul_smul, pow_sub_one_mul hpos.ne', pow_orderOf_eq_one, one_smul] at h
  -- the generated equivalence is invariant and respects `F`
  have hinv : ∀ (g : G) a b, Relation.EqvGen R a b → Relation.EqvGen R (g • a) (g • b) := by
    intro g a b h
    induction h with
    | rel a b h => exact .rel _ _ (smul_mem_orbit_pair h g)
    | refl a => exact .refl _
    | symm a b _ ih => exact .symm _ _ ih
    | trans a b c _ _ ih1 ih2 => exact .trans _ _ _ ih1 ih2
  have hiff : ∀ a b, Relation.EqvGen R a b → (a ∈ F ↔ b ∈ F) := by
    intro a b h
    induction h with
    | rel a b h => exact ⟨fun ha => hF a b ha h, fun hb => hrev b a hb h⟩
    | refl a => exact Iff.rfl
    | symm a b _ ih => exact ih.symm
    | trans a b c _ _ ih1 ih2 => exact ih1.trans ih2
  -- the class of `x` is a block
  set C := {a | Relation.EqvGen R x a}
  have hmem : ∀ (g : G) a, a ∈ g • C ↔ Relation.EqvGen R (g • x) a := by
    intro g a
    rw [Set.mem_smul_set_iff_inv_smul_mem, Set.mem_ofPred_eq]
    constructor
    · intro h
      have := hinv g _ _ h
      rwa [smul_inv_smul] at this
    · intro h
      have := hinv g⁻¹ _ _ h
      rwa [inv_smul_smul] at this
  have hblock : IsBlock G C := by
    intro g₁ g₂ hne
    rw [Set.disjoint_left]
    intro c h1 h2
    apply hne
    ext a
    rw [hmem, hmem]
    rw [hmem] at h1 h2
    exact ⟨fun h => .trans _ _ _ h2 (.trans _ _ _ (.symm _ _ h1) h),
      fun h => .trans _ _ _ h1 (.trans _ _ _ (.symm _ _ h2) h)⟩
  have hxC : x ∈ C := Relation.EqvGen.refl x
  have hyC : y ∈ C := Relation.EqvGen.rel x y (mem_orbit_self (x, y))
  rcases IsPreprimitive.isTrivialBlock_of_isBlock hblock with hs | hu
  · exact absurd (hs hxC hyC) hxy
  · rw [Set.eq_univ_iff_forall]
    intro a
    have ha : a ∈ C := hu ▸ Set.mem_univ a
    exact (hiff x a ha).mp hx

/-! ### Jordan's lemma -/

/-- **Jordan's Lemma 1.** For a faithful primitive action of a finite group and `x ≠ y`, every
prime `p` dividing `|G_x|` divides `|P|`, where `P` is the image of `G_x` in `Perm Δ(x)`. -/
theorem prime_dvd_card_range [Finite G] [IsPreprimitive G Ω] (hf : Faithful G Ω) {x y : Ω}
    (hxy : x ≠ y) {p : ℕ} (hp : p.Prime) (hd : p ∣ Nat.card (stabilizer G x)) :
    p ∣ Nat.card (toPermHom (stabilizer G x) (orbit (stabilizer G x) y)).range := by
  set φ := toPermHom (stabilizer G x) (orbit (stabilizer G x) y)
  by_contra hnd
  -- an element of order `p` in `G_x` fixes `Δ(x)` pointwise
  have htriv : ∀ h : stabilizer G x, orderOf h = p →
      ∀ c ∈ orbit (stabilizer G x) y, (h : G) • c = c := by
    intro h hh c hc
    have h1 : orderOf (φ h) ∣ p := hh ▸ orderOf_map_dvd φ h
    have h2 : orderOf (φ h) ∣ Nat.card φ.range := by
      have := orderOf_dvd_natCard (⟨φ h, MonoidHom.mem_range.mpr ⟨h, rfl⟩⟩ : φ.range)
      rwa [← orderOf_coe] at this
    rcases hp.eq_one_or_self_of_dvd _ h1 with h3 | h3
    · rw [orderOf_eq_one_iff] at h3
      have h4 := congrArg (fun σ : Equiv.Perm (orbit (stabilizer G x) y) => (σ ⟨c, hc⟩ : Ω)) h3
      exact h4
    · exact absurd (h3 ▸ h2) hnd
  have := Fact.mk hp
  obtain ⟨g, hg⟩ := exists_prime_orderOf_dvd_card' p hd
  -- its fixed points are closed along the orbital
  have hclosed : ∀ a b, (g : G) • a = a → (a, b) ∈ orbit G (x, y) → (g : G) • b = b := by
    intro a b ha hab
    obtain ⟨k, rfl⟩ := exists_smul_eq G x a
    have hk : k⁻¹ * g * k ∈ stabilizer G x := by
      rw [mem_stabilizer_iff, mul_smul, mul_smul, ha, inv_smul_smul]
    have hord : orderOf (⟨k⁻¹ * g * k, hk⟩ : stabilizer G x) = p := by
      rw [← orderOf_coe, ← hg, ← orderOf_coe g]
      have := orderOf_injective (MulAut.conj k⁻¹).toMonoidHom (MulAut.conj k⁻¹).injective g
      rwa [MulEquiv.coe_toMonoidHom, MulAut.conj_apply, inv_inv] at this
    have hb : k⁻¹ • b ∈ orbit (stabilizer G x) y := by
      rw [mem_orbit_stabilizer_iff]
      have := smul_mem_orbit_pair hab k⁻¹
      rwa [inv_smul_smul] at this
    have h1 := htriv _ hord _ hb
    change (k⁻¹ * g * k) • k⁻¹ • b = k⁻¹ • b at h1
    rwa [mul_smul, smul_inv_smul, mul_smul, smul_left_cancel_iff] at h1
  have hall := eq_univ_of_closed hxy (F := {a | (g : G) • a = a}) g.2 hclosed
  have h1 : (g : G) = 1 := hf g fun a => by
    have : a ∈ {a | (g : G) • a = a} := hall ▸ Set.mem_univ a
    exact this
  rw [show g = 1 from Subtype.ext h1, orderOf_one] at hg
  exact hp.one_lt.ne hg

end GraphIso.Pyber
