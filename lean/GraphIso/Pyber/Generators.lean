module

public import Mathlib.Algebra.Group.Subgroup.Finite
public import Mathlib.GroupTheory.Index
public import Mathlib.Data.Nat.Log
public import Mathlib.Tactic.Ring
public import Mathlib.Tactic.Linarith
public import Mathlib.Tactic.GCongr

/-!
# Short generating lists

Stage 15a (`PLAN-15.md` §3, item 7). Every finite group `G` is generated by a list of at most
`⌊log₂ |G|⌋` elements (`exists_list_closure_eq_top`): adding an element outside a subgroup at
least doubles it (`exists_list_closure_sup_eq_top`). Stage 15c uses this for an abelian minimal
normal subgroup of a primitive group, in place of Pyber's `P / Soc(P) ↪ GL(s, p)`.
-/

@[expose] public section

namespace GraphIso.Pyber

open Subgroup

variable {G : Type*} [Group G]

/-- **Extending a subgroup to a generating set:** for every subgroup `K` there is a list `l`
with `⟨K, l⟩ = G` and `2^|l| · |K| ≤ |G|`. -/
theorem exists_list_closure_sup_eq_top [Finite G] (K : Subgroup G) :
    ∃ l : List G, closure ((K : Set G) ∪ {x | x ∈ l}) = ⊤ ∧
      2 ^ l.length * Nat.card K ≤ Nat.card G := by
  induction h : Nat.card G - Nat.card K using Nat.strong_induction_on generalizing K with
  | _ m ih =>
  by_cases hK : K = ⊤
  · refine ⟨[], ?_, ?_⟩
    · simp [hK]
    · simp [hK]
  · obtain ⟨g, hg⟩ : ∃ g, g ∉ K := by
      by_contra hall
      push Not at hall
      exact hK (eq_top_iff.mpr fun x _ => hall x)
    set K' := closure ((K : Set G) ∪ {g})
    have hKK' : K < K' := by
      refine lt_of_le_of_ne (fun x hx => subset_closure (Or.inl hx)) fun he => hg ?_
      rw [he]
      exact subset_closure (Or.inr rfl)
    have hlt := card_lt_of_lt hKK'
    have hdvd := card_dvd_of_le hKK'.le
    have hle' : Nat.card K' ≤ Nat.card G := card_le_card_group K'
    obtain ⟨l', hl', hc'⟩ := ih (Nat.card G - Nat.card K') (by omega) K' rfl
    have hgen : closure ((K : Set G) ∪ {x | x ∈ g :: l'}) = ⊤ := by
      rw [eq_top_iff, ← hl', closure_le]
      rintro x (hx | hx)
      · exact closure_mono (fun y hy => by
          rcases hy with hy | rfl
          · exact Or.inl hy
          · exact Or.inr (List.mem_cons_self ..)) hx
      · exact subset_closure (Or.inr (List.mem_cons_of_mem g hx))
    refine ⟨g :: l', hgen, ?_⟩
    · obtain ⟨c, hc⟩ := hdvd
      have hc2 : 2 ≤ c := by
        rcases c with _ | _ | c
        · rw [hc] at hlt; simp at hlt
        · rw [hc] at hlt; simp at hlt
        · omega
      calc 2 ^ (g :: l').length * Nat.card K = 2 ^ l'.length * (2 * Nat.card K) := by
            rw [List.length_cons, pow_succ]; ring
        _ ≤ 2 ^ l'.length * Nat.card K' := by
            rw [hc, mul_comm 2]
            exact Nat.mul_le_mul_left _ (Nat.mul_le_mul_left _ hc2)
        _ ≤ Nat.card G := hc'

/-- **Every finite group is generated by at most `⌊log₂ |G|⌋` elements.** -/
theorem exists_list_closure_eq_top [Finite G] :
    ∃ l : List G, closure {x | x ∈ l} = ⊤ ∧ l.length ≤ Nat.log 2 (Nat.card G) := by
  obtain ⟨l, hl, hc⟩ := exists_list_closure_sup_eq_top (⊥ : Subgroup G)
  refine ⟨l, ?_, ?_⟩
  · rw [← hl, coe_bot, closure_union, closure_singleton_one, bot_sup_eq]
  · rw [card_bot, mul_one] at hc
    exact Nat.le_log_of_pow_le Nat.one_lt_two hc

end GraphIso.Pyber
