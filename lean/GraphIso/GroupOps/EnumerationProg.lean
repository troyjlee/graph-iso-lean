module

public import GraphIso.GroupOps.Enumeration

/-!
# The reference backend as programs

The four operations used by the solver, implemented in the cost language over the empty
signature, with proofs that they compute the functional models of
`GraphIso/GroupOps/Enumeration.lean` within explicit bounds.

For a group of order `N` given by its element list `el` (so `|el| = N`), degree `n`:

* `closureProg` (`generate`, from `L` valid generators): at most `closureCost n N L`, that is
  `N + 1` loop iterations, each scanning the found list (at most `N` elements) for the `2 L`
  candidates `g * f` and `g⁻¹ * f`;
* `stabProg` (`stabilizer`): `7 N + 5`;
* `transProg` (`orbitTransversal`): `N (4 n + 7) + 1`;
* `orbitsProg` (`orbits` on a window of `m` points): `m (N (3 n + 6) + 4 n + 10) + 4`.
-/

@[expose] public section

namespace GraphIso.Enum

open Equiv Cost Programs

variable {S : Signature} {rec : Ty × Ty} {var : Ty → Type}

/-- Is `h` in the list? Scan, comparing forward arrays. -/
def memProg (h : var Ty.perm) (l : var Ty.gens) : Prog S rec var .bool :=
  anyList l fun e => permBeq e h

/-- Record `x` if new. -/
def insertProg (acc : var (.prod Ty.gens Ty.gens)) (x : var Ty.perm) :
    Prog S rec var (.prod Ty.gens Ty.gens) :=
  .bind (.op1 .fst acc) fun found => .bind (.op1 .snd acc) fun stack =>
  .bind (memProg x found) fun isIn =>
  .ite isIn (.ret acc)
    (.bind (.op2 .cons x found) fun f' => .bind (.op2 .cons x stack) fun s' => .op2 .pair f' s')

/-- Process the popped element `f` over all generators. -/
def expandProg (gs : var Ty.gens) (acc : var (.prod Ty.gens Ty.gens)) (f : var Ty.perm) :
    Prog S rec var (.prod Ty.gens Ty.gens) :=
  .foldList gs acc fun acc g =>
    .bind (permMul g f) fun gf => .bind (insertProg acc gf) fun a₁ =>
    .bind (permInv g) fun gi => .bind (permMul gi f) fun gif => insertProg a₁ gif

/-- One loop iteration of the search. -/
def closureBody (gs : var Ty.gens) (st : var (.prod Ty.gens Ty.gens)) :
    Prog S rec var (.option (.prod Ty.gens Ty.gens)) :=
  .bind (.op1 .snd st) fun stack =>
  .caseList stack (.op0 .none) fun f rest =>
    .bind (.op1 .fst st) fun found => .bind (.op2 .pair found rest) fun st₀ =>
    .bind (expandProg gs st₀ f) fun st' => .op1 .some st'

/-- The search: all elements of the group generated by `gs`, in degree `n`. -/
def closureProg (n : var .nat) (gs : var Ty.gens) : Prog S rec var Ty.gens :=
  .bind (permOne n) fun e => .bind (.op0 .nil) fun nil => .bind (.op2 .cons e nil) fun l =>
  .bind (.op2 .pair l l) fun st₀ =>
  .bind (.loop st₀ fun st => closureBody gs st) fun fin => .op1 .fst fin

/-! ### Costs -/

/-- Bound on one insertion with at most `F` found elements. -/
def insCost (n F : ℕ) : ℕ := F * (6 * n + 12) + 8

/-- Bound on processing one element with `L` generators and at most `F` found elements. -/
def expCost (n F L : ℕ) : ℕ := L * (2 * insCost n F + 24 * n + 31)

/-- Bound on one loop iteration. -/
def iterCost (n F L : ℕ) : ℕ := expCost n F L + 8

/-- Bound on the search for a group of order `N` with `L` generators. -/
def closureCost (n N L : ℕ) : ℕ := (N + 1) * iterCost n N L + 2 * n + 10

section Specs

variable {a b : Ty} {X : Ctx S} {body : a.denote → Prog S (a, b) Ty.denote b} {n : ℕ}

theorem RunsWithin.memProg {h : PermData} {l : List PermData} (hl : GensData.AllValid n l) :
    RunsWithin X body (Enum.memProg h l) (memB h l) (l.length * (6 * n + 12) + 1) :=
  (RunsWithin.anyList_le (c := 6 * n + 10) fun e he => RunsWithin.permBeq (hl e he)).mono
    (by simp only [Nat.mul_add]; omega)

theorem RunsWithin.insertProg {acc : List PermData × List PermData} {x : PermData}
    (hv : GensData.AllValid n acc.1) {F : ℕ} (hF : acc.1.length ≤ F) :
    RunsWithin X body (Enum.insertProg acc x) (insertNew acc x) (insCost n F) := by
  apply RunsWithin.mono
  case h =>
    run_step (RunsWithin.prim _ _)
    run_step (RunsWithin.prim _ _)
    run_step (RunsWithin.memProg (h := x) hv)
    unfold insertNew
    simp only [Prim.eval]
    cases memB x acc.1
    · simp only [Bool.false_eq_true, ↓reduceIte]
      refine RunsWithin.ite_false (k := 3) ?_
      refine RunsWithin.bind_le (c₂ := 2) (RunsWithin.prim _ _) ?_ (by simp [Prim.cost])
      refine RunsWithin.bind_le (c₂ := 1) (RunsWithin.prim _ _) ?_ (by simp [Prim.cost])
      exact RunsWithin.prim_le rfl le_rfl
    · simp only [↓reduceIte]
      exact (RunsWithin.ite_true (RunsWithin.ret _)).mono (by omega)
  case hc =>
    simp only [Prim.cost, Prim.eval, insCost]
    have : acc.1.length * (6 * n + 12) ≤ F * (6 * n + 12) := Nat.mul_le_mul_right _ hF
    omega

end Specs

section SearchSpecs

variable {a b : Ty} {X : Ctx S} {body : a.denote → Prog S (a, b) Ty.denote b} {n : ℕ}
  {gs : GensData}

theorem RunsWithin.expandProg (hgs : GensData.AllValid n gs) {f : PermData} (hf : f.Valid n)
    (hfG : PermData.denote n f ∈ GensData.denote n gs) {st : List PermData × List PermData}
    (hst : PartInv n gs st) :
    RunsWithin X body (Enum.expandProg gs st f) (expand gs st f)
      (expCost n (Nat.card (GensData.denote n gs)) gs.length) := by
  set N := Nat.card (GensData.denote n gs)
  have hfold := RunsWithin.foldList_inv (X := X) (body := body) (a' := Ty.perm)
    (b' := .prod Ty.gens Ty.gens) (I := PartInv n gs)
    (f := fun (acc : List PermData × List PermData) (g : PermData) =>
      Prog.bind (permMul g f) fun gf => .bind (Enum.insertProg acc gf) fun a₁ =>
      .bind (permInv g) fun gi => .bind (permMul gi f) fun gif => Enum.insertProg a₁ gif)
    (F := fun acc (g : PermData) => insertNew (insertNew acc (g.mul f)) (g.inv.mul f))
    (c := 2 * insCost n N + 24 * n + 30) gs st (fun acc hacc g hg => by
      have hgv := hgs g hg
      have hgG : PermData.denote n g ∈ GensData.denote n gs := GensData.mem_denote_of_mem hg
      have hmulG : PermData.denote n (PermData.mul g f) ∈ GensData.denote n gs := by
        rw [PermData.denote_mul hgv hf]; exact mul_mem hgG hfG
      have hinvG : PermData.denote n (PermData.mul (PermData.inv g) f) ∈
          GensData.denote n gs := by
        rw [PermData.denote_mul hgv.inv hf, PermData.denote_inv hgv]
        exact mul_mem (inv_mem hgG) hfG
      have hval₀ := PartInv.valid hacc
      have hlen₀ := length_le_card (PartInv.valid hacc) (PartInv.nodup hacc) (PartInv.mem hacc)
      obtain ⟨hI₁, -, -⟩ := hacc.insertNew (hgv.mul hf) hmulG
      obtain ⟨hI₂, -, -⟩ := hI₁.insertNew (hgv.inv.mul hf) hinvG
      refine ⟨?_, hI₂⟩
      have hlen₁ := length_le_card (PartInv.valid hI₁) (PartInv.nodup hI₁) (PartInv.mem hI₁)
      refine RunsWithin.bind_le (c₂ := insCost n N + (3 + ((12 * n + 13) + insCost n N)))
        (RunsWithin.permMul hgv hf) ?_ (by omega)
      refine RunsWithin.bind_le (c₂ := 3 + ((12 * n + 13) + insCost n N))
        (RunsWithin.insertProg hval₀ hlen₀) ?_ le_rfl
      refine RunsWithin.bind_le (c₂ := (12 * n + 13) + insCost n N)
        (RunsWithin.permInv g) ?_ le_rfl
      refine RunsWithin.bind_le (c₂ := insCost n N)
        (RunsWithin.permMul hgv.inv hf) ?_ le_rfl
      exact RunsWithin.insertProg (PartInv.valid hI₁) hlen₁) hst
  refine (hfold.1.mono ?_)
  simp only [expCost]
  exact Nat.mul_le_mul_left _ (by omega)

/-- The search loop, from any state satisfying the invariant, with enough fuel. -/
theorem RunsWithin.closureLoop (hgs : GensData.AllValid n gs) :
    ∀ (k : ℕ) (st : List PermData × List PermData), ClosureInv n gs st →
      Nat.card (GensData.denote n gs) ≤ st.1.length - st.2.length + k →
      RunsWithin X body (.loop st fun st => Enum.closureBody gs st) (closureIter gs k st)
        ((Nat.card (GensData.denote n gs) - (st.1.length - st.2.length) + 1) *
          iterCost n (Nat.card (GensData.denote n gs)) gs.length)
  | k, st, h, hk => by
    set N := Nat.card (GensData.denote n gs) with hN
    rcases hst : st.2 with _ | ⟨f, rest⟩
    · -- the stack is empty: one last iteration returns `none`
      have hfin : closureIter gs k st = st := by
        cases k <;> simp [closureIter, closureStep, hst]
      rw [hfin]
      refine (RunsWithin.loop_none (c := 3) ?_).mono ?_
      · refine RunsWithin.bind_le (c₂ := 2) (RunsWithin.prim _ _) ?_ (by simp [Prim.cost])
        simp only [Prim.eval, hst]
        exact RunsWithin.caseList_nil (RunsWithin.prim _ _)
      · simp only [iterCost]
        nlinarith
    · -- pop `f`, process it, and continue
      have hstep := h.step hgs hst
      have hfmem : f ∈ st.1 := h.stack_sub f (by rw [hst]; exact List.mem_cons_self)
      have hp := h.partInv hst
      have hlen1 := length_le_card h.valid h.nodup h.mem
      have hlen2 := length_le_of_subset_nodup h.stack_nodup h.stack_sub
      rw [hst] at hlen2
      simp only [List.length_cons] at hlen2
      obtain ⟨k', rfl⟩ : ∃ k', k = k' + 1 := ⟨k - 1, by
        have : st.1.length - st.2.length < N := by rw [hst]; simp only [List.length_cons]; omega
        omega⟩
      have hiter : closureIter gs (k' + 1) st = closureIter gs k' (expand gs (st.1, rest) f) := by
        simp [closureIter, closureStep, hst]
      rw [hiter]
      have ih := RunsWithin.closureLoop hgs k' _ hstep.1 (by rw [hstep.2]; omega)
      have hexp := RunsWithin.expandProg (X := X) (body := body) hgs (h.valid f hfmem)
        (h.mem f hfmem) hp
      rw [← hN] at hexp ih
      refine (RunsWithin.loop_some (x' := expand gs (st.1, rest) f)
        (c₁ := 5 + expCost n N gs.length) ?_ ih).mono ?_
      · refine RunsWithin.bind_le (c₂ := 4 + expCost n N gs.length) (RunsWithin.prim _ _) ?_
          (by simp [Prim.cost]; omega)
        simp only [Prim.eval, hst]
        refine (RunsWithin.caseList_cons (k := 3 + expCost n N gs.length) ?_).mono (by omega)
        refine RunsWithin.bind_le (c₂ := 2 + expCost n N gs.length) (RunsWithin.prim _ _) ?_
          (by simp [Prim.cost]; omega)
        refine RunsWithin.bind_le (c₂ := 1 + expCost n N gs.length) (RunsWithin.prim _ _) ?_
          (by simp [Prim.cost]; omega)
        refine RunsWithin.bind_le (c₂ := 1) hexp ?_ (by omega)
        exact RunsWithin.prim _ _
      · rw [hstep.2, hst]
        simp only [List.length_cons]
        have hP : st.1.length - (rest.length + 1) + 1 ≤ N := by omega
        obtain ⟨t, ht⟩ : ∃ t, N - (st.1.length - (rest.length + 1)) = t + 1 :=
          ⟨N - (st.1.length - (rest.length + 1)) - 1, by omega⟩
        have ht' : N - (st.1.length - (rest.length + 1) + 1) = t := by omega
        rw [ht, ht']
        simp only [iterCost]
        nlinarith

/-- **The search program computes `enumerate`.** -/
theorem RunsWithin.closureProg (hgs : GensData.AllValid n gs) :
    RunsWithin X body (Enum.closureProg n gs) (enumerate n gs)
      (closureCost n (Nat.card (GensData.denote n gs)) gs.length) := by
  have hcard : Nat.card (GensData.denote n gs) ≤ n.factorial := by
    have := Subgroup.card_le_of_le (le_top : GensData.denote n gs ≤ ⊤)
    rwa [Subgroup.card_top, Nat.card_perm, Nat.card_eq_fintype_card (α := Fin n),
      Fintype.card_fin] at this
  have hloop := RunsWithin.closureLoop (X := X) (body := body) hgs n.factorial
    ([PermData.one n], [PermData.one n]) closureInv_init (by simpa using hcard)
  simp only [List.length_singleton, Nat.sub_self, Nat.sub_zero] at hloop
  apply RunsWithin.mono
  case h =>
    run_step (RunsWithin.permOne n)
    run_step (RunsWithin.prim _ _)
    run_step (RunsWithin.prim _ _)
    run_step (RunsWithin.prim _ _)
    run_step hloop
    exact RunsWithin.prim _ _
  case hc =>
    simp only [Prim.cost, closureCost]
    omega

end SearchSpecs

/-! ### Stabilizer, transversal and orbit programs -/

/-- The elements fixing `u`, as a group listed by its elements. -/
def stabProg (n : var .nat) (el : var Ty.gens) (u : var .nat) :
    Prog S rec var (Ty.group Ty.gens) :=
  .bind (.op0 .nil) fun nil =>
  .bind (.foldList el nil fun acc e =>
      .bind (permApply e u) fun eu => .bind (.op2 .natEq eu u) fun b =>
      .ite b (.op2 .cons e acc) (.ret acc)) fun rev =>
  .bind (.op1 .reverse rev) fun K => .bind (.op2 .pair K K) fun KK => .op2 .pair n KK

/-- One pair `(e u, e)` for each image of `u`. -/
def transProg (el : var Ty.gens) (u : var .nat) : Prog S rec var (.list (.prod .nat Ty.perm)) :=
  .bind (.op0 .nil) fun nil =>
  .foldList el nil fun acc e =>
    .bind (permApply e u) fun v =>
    .bind (anyList acc fun p => .bind (.op1 .fst p) fun pv => .op2 .natEq pv v) fun b =>
    .ite b (.ret acc) (.bind (.op2 .pair v e) fun pe => .op2 .cons pe acc)

/-- The orbit of `u`, without repetition. -/
def orbitPtsProg (el : var Ty.gens) (u : var .nat) : Prog S rec var (.list .nat) :=
  .bind (.op0 .nil) fun nil =>
  .foldList el nil fun l e =>
    .bind (permApply e u) fun v =>
    .bind (anyList l fun x => .op2 .natEq x v) fun b =>
    .ite b (.ret l) (.op2 .cons v l)

/-- The orbits of the listed points. -/
def orbitsProg (el : var Ty.gens) (pts : var (.list .nat)) : Prog S rec var (.list (.list .nat)) :=
  .bind (.op0 .nil) fun nil₁ => .bind (.op0 .nil) fun nil₂ =>
  .bind (.op2 .pair nil₁ nil₂) fun acc₀ =>
  .bind (.foldList pts acc₀ fun acc u =>
      .bind (.op1 .fst acc) fun cov =>
      .bind (anyList cov fun x => .op2 .natEq x u) fun b =>
      .ite b (.ret acc)
        (.bind (orbitPtsProg el u) fun o => .bind (.op2 .append o cov) fun cov' =>
         .bind (.op1 .snd acc) fun res => .bind (.op2 .cons o res) fun res' =>
         .op2 .pair cov' res')) fun fin =>
  .op1 .snd fin

/-- The elements fixing every listed point, as a group listed by its elements. -/
def kerProg (n : var .nat) (el : var Ty.gens) (pts : var (.list .nat)) :
    Prog S rec var (Ty.group Ty.gens) :=
  .bind (.op0 .nil) fun nil =>
  .bind (.foldList el nil fun acc e =>
      .bind (allList pts fun u => .bind (permApply e u) fun eu => .op2 .natEq eu u) fun b =>
      .ite b (.op2 .cons e acc) (.ret acc)) fun rev =>
  .bind (.op1 .reverse rev) fun K => .bind (.op2 .pair K K) fun KK => .op2 .pair n KK

/-- Does `g` map the `j`-th listed point to the `π' j`-th, for every `j < m`? -/
def mapsProg (wa : var (.array .nat)) (m : var .nat) (g π' : var Ty.perm) :
    Prog S rec var .bool :=
  .bind (.op1 .fst g) fun gf => .bind (.op1 .fst π') fun pf =>
  .bind (.op1 .range m) fun js =>
  allList js fun j =>
    .bind (.op2 .arrayGet wa j) fun u => .bind (.op2 .arrayGet gf u) fun gu =>
    .bind (.op2 .arrayGet pf j) fun k => .bind (.op2 .arrayGet wa k) fun wk => .op2 .natEq gu wk

/-- The first listed element restricting to `π'`, or the identity of degree `n`. -/
def liftProg (n : var .nat) (el : var Ty.gens) (w : var Ty.win) (π' : var Ty.perm) :
    Prog S rec var Ty.perm :=
  .bind (.op1 .fst w) fun pts => .bind (.op1 .arrayOfList pts) fun wa =>
  .bind (.op1 .length pts) fun m => .bind (.op0 .none) fun none₀ =>
  .bind (.foldList el none₀ fun acc e =>
      .caseOption acc
        (.bind (mapsProg wa m e π') fun b => .ite b (.op1 .some e) (.ret acc))
        fun _ => .ret acc) fun found =>
  .caseOption found (permOne n) fun e => .ret e

/-- Greedy coset representatives: keep each element of `el` that is not in the left coset of
a kept one (membership in `K` by scanning its element list `kl`). -/
def repsProg (el kl : var Ty.gens) : Prog S rec var Ty.gens :=
  .bind (.op0 .nil) fun nil =>
  .foldList el nil fun acc g =>
    .bind (anyList acc fun r => .bind (permInv r) fun ri => .bind (permMul ri g) fun d =>
      memProg d kl) fun c =>
    .ite c (.ret acc) (.op2 .cons g acc)

section OpSpecs

variable {a b : Ty} {X : Ctx S} {body : a.denote → Prog S (a, b) Ty.denote b} {n : ℕ}

private theorem foldl_filter_rev (p : PermData → Bool) :
    ∀ (el acc : List PermData),
      el.foldl (fun acc e => if p e then e :: acc else acc) acc = (el.filter p).reverse ++ acc
  | [], acc => rfl
  | e :: el, acc => by
    rw [List.foldl_cons, foldl_filter_rev p el]
    by_cases h : p e <;> simp [h]

theorem RunsWithin.stabProg (el : List PermData) (u : ℕ) :
    RunsWithin X body (Enum.stabProg n el u) (n, stabElems el u, stabElems el u)
      (7 * el.length + 5) := by
  have hfold := RunsWithin.foldList_of (X := X) (body := body) (a' := Ty.perm)
    (b' := Ty.gens) (cf := fun _ => 5)
    (f := fun (acc : List PermData) (e : PermData) =>
      Prog.bind (permApply e u) fun eu => .bind (.op2 .natEq eu u) fun b =>
        .ite b (.op2 .cons e acc) (.ret acc))
    (F := fun acc e => if get e.1 u == u then e :: acc else acc) el [] fun acc e _ => by
      refine RunsWithin.bind_le (c₂ := 3) (RunsWithin.permApply _ _) ?_ le_rfl
      refine RunsWithin.bind_le (c₂ := 2) (RunsWithin.prim _ _) ?_ (by simp [Prim.cost])
      simp only [Prim.eval]
      cases get e.1 u == u
      · exact (RunsWithin.ite_false (RunsWithin.ret _)).mono (by omega)
      · exact (RunsWithin.ite_true (RunsWithin.prim _ _)).mono (by simp [Prim.cost])
  rw [foldl_filter_rev, List.append_nil, sum_map_const] at hfold
  have hst : (el.filter fun e => get e.1 u == u) = stabElems el u := rfl
  have hlen : (stabElems el u).length ≤ el.length := List.length_filter_le _ _
  rw [hst] at hfold
  apply RunsWithin.mono
  case h =>
    run_step (RunsWithin.prim _ _)
    run_step hfold
    run_step (RunsWithin.prim _ _)
    run_step (RunsWithin.prim _ _)
    exact RunsWithin.prim_le (by simp [Prim.eval, stabElems]) le_rfl
  case hc =>
    simp only [Prim.cost, Args.head_cons, List.length_reverse]
    omega

theorem length_le_of_nodup_lt {l : List ℕ} (hnd : l.Nodup) (hlt : ∀ x ∈ l, x < n) :
    l.length ≤ n := by
  have hsub : l.toFinset ⊆ Finset.range n := fun i hi =>
    Finset.mem_range.2 (hlt i (List.mem_toFinset.1 hi))
  have := Finset.card_le_card hsub
  rwa [List.toFinset_card_of_nodup hnd, Finset.card_range] at this

theorem any_fst_eq (acc : List (ℕ × PermData)) (v : ℕ) :
    acc.any (fun p => p.1 == v) = (acc.map Prod.fst).contains v := by
  rw [← List.any_beq', List.any_map]
  rfl

theorem RunsWithin.transProg {el : List PermData} (hel : GensData.AllValid n el) {u : ℕ}
    (hu : u < n) :
    RunsWithin X body (Enum.transProg el u) (transModel el u) (el.length * (4 * n + 7) + 1) := by
  have hfold := RunsWithin.foldList_inv (X := X) (body := body) (a' := Ty.perm)
    (b' := .list (.prod .nat Ty.perm))
    (I := fun acc => (acc.map Prod.fst).Nodup ∧ ∀ p ∈ acc, p.1 < n) (c := 4 * n + 6)
    (f := fun (acc : List (ℕ × PermData)) (e : PermData) =>
      Prog.bind (permApply e u) fun v =>
      .bind (anyList (a' := .prod .nat Ty.perm) acc fun p =>
        .bind (.op1 (Prim.fst (a := .nat) (b := Ty.perm)) p) fun pv => .op2 .natEq pv v) fun b =>
      .ite b (.ret acc) (.bind (.op2 .pair v e) fun pe => .op2 .cons pe acc))
    (F := fun acc e =>
      if (acc.map Prod.fst).contains (get e.1 u) then acc else (get e.1 u, e) :: acc)
    el [] (fun acc hacc e he => by
      have hv : get e.1 u < n := (hel e he).fwd_lt u hu
      have hlen : acc.length ≤ n := by
        simpa using length_le_of_nodup_lt hacc.1 (by simpa using hacc.2)
      refine ⟨?_, ?_⟩
      · refine RunsWithin.bind_le (c₂ := 4 * n + 4) (RunsWithin.permApply _ _) ?_ (by omega)
        have hany := RunsWithin.anyList_le (X := X) (body := body) (a' := .prod .nat Ty.perm)
          (xs := acc) (c := 2) (P := fun p => p.1 == get e.1 u)
          (p := fun p => .bind (.op1 .fst p) fun pv => .op2 .natEq pv (get e.1 u)) fun p _ =>
            RunsWithin.bind_le (c₂ := 1) (RunsWithin.prim _ _) (RunsWithin.prim_le rfl le_rfl)
              (by simp [Prim.cost])
        rw [any_fst_eq] at hany
        refine RunsWithin.bind_le (c₂ := 3) hany ?_ (by nlinarith)
        cases (acc.map Prod.fst).contains (get e.1 u)
        · simp only [Bool.false_eq_true, ↓reduceIte]
          exact (RunsWithin.ite_false (k := 2) (RunsWithin.bind_le (c₂ := 1) (RunsWithin.prim _ _)
            (RunsWithin.prim _ _) (by simp [Prim.cost]))).mono (by omega)
        · simp only [↓reduceIte]
          exact (RunsWithin.ite_true (RunsWithin.ret _)).mono (by omega)
      · by_cases hc : (acc.map Prod.fst).contains (get e.1 u) = true
        · simp only [hc, ↓reduceIte]
          exact hacc
        · simp only [hc, Bool.false_eq_true, ↓reduceIte]
          have hnot : get e.1 u ∉ acc.map Prod.fst := by simpa using hc
          refine ⟨by simpa using List.nodup_cons.2 ⟨hnot, hacc.1⟩, fun p hp => ?_⟩
          rcases List.mem_cons.1 hp with rfl | hp
          · exact hv
          · exact hacc.2 p hp) ⟨List.nodup_nil, fun _ h => absurd h List.not_mem_nil⟩
  refine RunsWithin.bind_le (c₂ := el.length * (4 * n + 6 + 1)) (RunsWithin.prim _ _) hfold.1
    (by simp only [Prim.cost, Nat.add_assoc, Nat.reduceAdd]; omega)

theorem RunsWithin.orbitPtsProg {el : List PermData} (hel : GensData.AllValid n el) {u : ℕ}
    (hu : u < n) :
    RunsWithin X body (Enum.orbitPtsProg el u) (orbitPts el u) (el.length * (3 * n + 6) + 1) := by
  have hfold := RunsWithin.foldList_inv (X := X) (body := body) (a' := Ty.perm) (b' := .list .nat)
    (I := fun l => l.Nodup ∧ ∀ x ∈ l, x < n) (c := 3 * n + 5)
    (f := fun (l : List ℕ) (e : PermData) =>
      Prog.bind (permApply e u) fun v =>
      .bind (anyList (a' := .nat) l fun x => .op2 .natEq x v) fun b =>
        .ite b (.ret l) (.op2 .cons v l))
    (F := fun l e => if l.contains (get e.1 u) then l else get e.1 u :: l)
    el [] (fun l hl e he => by
      have hv : get e.1 u < n := (hel e he).fwd_lt u hu
      have hlen := length_le_of_nodup_lt hl.1 hl.2
      refine ⟨?_, ?_⟩
      · refine RunsWithin.bind_le (c₂ := 3 * n + 3) (RunsWithin.permApply _ _) ?_ (by omega)
        have hany := RunsWithin.anyList_le (X := X) (body := body) (a' := .nat)
          (xs := l) (c := 1) (P := fun x => x == get e.1 u)
          (p := fun x => .op2 .natEq x (get e.1 u)) fun x _ => RunsWithin.prim_le rfl le_rfl
        rw [List.any_beq'] at hany
        refine RunsWithin.bind_le (c₂ := 2) hany ?_ (by nlinarith)
        cases l.contains (get e.1 u)
        · simp only [Bool.false_eq_true, ↓reduceIte]
          exact (RunsWithin.ite_false (RunsWithin.prim _ _)).mono (by simp [Prim.cost])
        · simp only [↓reduceIte]
          exact (RunsWithin.ite_true (RunsWithin.ret _)).mono (by omega)
      · by_cases hc : l.contains (get e.1 u) = true
        · simp only [hc, ↓reduceIte]
          exact hl
        · simp only [hc, Bool.false_eq_true, ↓reduceIte]
          have hnot : get e.1 u ∉ l := by simpa using hc
          refine ⟨List.nodup_cons.2 ⟨hnot, hl.1⟩, fun x hx => ?_⟩
          rcases List.mem_cons.1 hx with rfl | hx
          · exact hv
          · exact hl.2 x hx) ⟨List.nodup_nil, fun _ h => absurd h List.not_mem_nil⟩
  refine RunsWithin.bind_le (c₂ := el.length * (3 * n + 5 + 1)) (RunsWithin.prim _ _) ?_
    (by simp only [Prim.cost, Nat.add_assoc, Nat.reduceAdd]; omega)
  exact hfold.1

theorem RunsWithin.orbitsProg {gs : GensData} {el : List PermData} (hdv : refDV n gs el)
    {w : WinData} (hw : w.Valid n) (hinv : IsInvariant (GensData.denote n gs) (w.denote n)) :
    RunsWithin X body (Enum.orbitsProg el w.1) (orbitsModel el w.1)
      (w.1.length * (el.length * (3 * n + 6) + 4 * n + 10) + 4) := by
  have hfold := RunsWithin.foldList_inv (X := X) (body := body) (a' := .nat)
    (b' := .prod (.list .nat) (.list (.list .nat))) (I := OrbitsInv n gs w)
    (c := el.length * (3 * n + 6) + 4 * n + 9)
    (f := fun (acc : List ℕ × List (List ℕ)) (u : ℕ) =>
      Prog.bind (.op1 (Prim.fst (a := .list .nat) (b := .list (.list .nat))) acc) fun cov =>
      .bind (anyList (a' := .nat) cov fun x => .op2 .natEq x u) fun b =>
      .ite b (.ret acc)
        (.bind (Enum.orbitPtsProg el u) fun o => .bind (.op2 .append o cov) fun cov' =>
         .bind (.op1 (Prim.snd (a := .list .nat) (b := .list (.list .nat))) acc) fun res =>
         .bind (.op2 .cons o res) fun res' => .op2 .pair cov' res'))
    (F := fun acc u => if acc.1.contains u then acc
      else (orbitPts el u ++ acc.1, orbitPts el u :: acc.2))
    w.1 ([], []) (fun acc hacc u hu => by
      have hun : u < n := hw.lt u hu
      have hcov : acc.1.length ≤ n :=
        length_le_of_nodup_lt hacc.nodup fun x hx => hw.lt x (hacc.sub x hx)
      have ho : (orbitPts el u).length ≤ n :=
        length_le_of_nodup_lt (orbitPts_spec hdv hun).1 fun x hx =>
          hw.lt x (SameOrbit.mem_of_invariant hinv (((orbitPts_spec hdv hun).2 x).1 hx) hu)
      refine ⟨?_, orbits_step hdv hw hinv hacc hu⟩
      refine RunsWithin.bind_le (c₂ := el.length * (3 * n + 6) + 4 * n + 8)
        (RunsWithin.prim _ _) ?_ (by simp [Prim.cost]; omega)
      have hany := RunsWithin.anyList_le (X := X) (body := body) (a' := .nat)
        (xs := acc.1) (c := 1) (P := fun x => x == u)
        (p := fun x => .op2 .natEq x u) fun x _ => RunsWithin.prim_le rfl le_rfl
      rw [List.any_beq'] at hany
      refine RunsWithin.bind_le (c₂ := el.length * (3 * n + 6) + n + 7) hany ?_ (by nlinarith)
      cases acc.1.contains u
      · simp only [Bool.false_eq_true, ↓reduceIte]
        refine (RunsWithin.ite_false (k := el.length * (3 * n + 6) + n + 6) ?_).mono (by omega)
        refine RunsWithin.bind_le (c₂ := n + 5) (RunsWithin.orbitPtsProg hdv.1 hun) ?_ (by omega)
        refine RunsWithin.bind_le (c₂ := 3) (RunsWithin.prim _ _) ?_
          (by simp [Prim.cost]; omega)
        refine RunsWithin.bind_le (c₂ := 2) (RunsWithin.prim _ _) ?_ (by simp [Prim.cost])
        refine RunsWithin.bind_le (c₂ := 1) (RunsWithin.prim _ _) ?_ (by simp [Prim.cost])
        exact RunsWithin.prim_le (by simp [Prim.eval]) le_rfl
      · simp only [↓reduceIte]
        exact (RunsWithin.ite_true (RunsWithin.ret _)).mono (by omega))
    ⟨rfl, List.nodup_nil, fun _ h => absurd h List.not_mem_nil,
      fun _ h => absurd h List.not_mem_nil⟩
  apply RunsWithin.mono
  case h =>
    run_step (RunsWithin.prim _ _)
    run_step (RunsWithin.prim _ _)
    run_step (RunsWithin.prim _ _)
    run_step hfold.1
    exact RunsWithin.prim _ _
  case hc =>
    simp only [Prim.cost, Nat.add_assoc, Nat.reduceAdd]
    omega

theorem RunsWithin.kerProg (el : List PermData) (pts : List ℕ) :
    RunsWithin X body (Enum.kerProg n el pts) (n, kerElems el pts, kerElems el pts)
      (el.length * (5 * pts.length + 5) + 5) := by
  have hfold := RunsWithin.foldList_of (X := X) (body := body) (a' := Ty.perm)
    (b' := Ty.gens) (cf := fun _ => 5 * pts.length + 3)
    (f := fun (acc : List PermData) (e : PermData) =>
      Prog.bind (allList (a' := .nat) pts fun u => .bind (permApply e u) fun eu =>
        .op2 .natEq eu u) fun b => .ite b (.op2 .cons e acc) (.ret acc))
    (F := fun acc e => if (pts.all fun u => get e.1 u == u) then e :: acc else acc) el []
    fun acc e _ => by
      refine RunsWithin.bind_le (c₂ := 2)
        (RunsWithin.allList_le (c := 3) (P := fun u => get e.1 u == u) fun u _ => ?_) ?_
        (by omega)
      · exact RunsWithin.bind_le (RunsWithin.permApply _ _) (RunsWithin.prim _ _)
          (by simp [Prim.cost])
      cases (pts.all fun u => get e.1 u == u)
      · exact (RunsWithin.ite_false (RunsWithin.ret _)).mono (by omega)
      · exact (RunsWithin.ite_true (RunsWithin.prim _ _)).mono (by simp [Prim.cost])
  rw [foldl_filter_rev, List.append_nil, sum_map_const] at hfold
  have hst : (el.filter fun e => pts.all fun u => get e.1 u == u) = kerElems el pts := rfl
  have hlen : (kerElems el pts).length ≤ el.length := List.length_filter_le _ _
  rw [hst] at hfold
  apply RunsWithin.mono
  case h =>
    run_step (RunsWithin.prim _ _)
    run_step hfold
    run_step (RunsWithin.prim _ _)
    run_step (RunsWithin.prim _ _)
    exact RunsWithin.prim_le (by simp [Prim.eval, kerElems]) le_rfl
  case hc =>
    simp only [Prim.cost, Args.head_cons, List.length_reverse]
    have : el.length * (5 * pts.length + 5) = el.length * (5 * pts.length + 3 + 1) + el.length := by
      ring
    omega

theorem RunsWithin.mapsProg (w : WinData) (g π' : PermData) :
    RunsWithin X body (Enum.mapsProg w.1.toArray w.1.length g π') (mapsB w g π')
      (8 * w.1.length + 4) := by
  apply RunsWithin.mono
  case h =>
    run_step (RunsWithin.prim _ _)
    run_step (RunsWithin.prim _ _)
    run_step (RunsWithin.prim _ _)
    refine RunsWithin.allList_le (c := 5) fun j _ => ?_
    refine RunsWithin.bind_le (c₂ := 4) (RunsWithin.prim _ _) ?_ (by simp [Prim.cost])
    refine RunsWithin.bind_le (c₂ := 3) (RunsWithin.prim _ _) ?_ (by simp [Prim.cost])
    refine RunsWithin.bind_le (c₂ := 2) (RunsWithin.prim _ _) ?_ (by simp [Prim.cost])
    refine RunsWithin.bind_le (c₂ := 1) (RunsWithin.prim _ _) ?_ (by simp [Prim.cost])
    exact RunsWithin.prim_le rfl le_rfl
  case hc =>
    simp only [Prim.cost, Prim.eval, Args.head_cons, List.length_range]
    omega

/-- The search for a lift, as a fold. -/
def findStep (w : WinData) (π' : PermData) (acc : Option PermData) (e : PermData) :
    Option PermData :=
  acc.elim (if mapsB w e π' then some e else none) fun _ => acc

theorem foldl_findStep (w : WinData) (π' : PermData) :
    ∀ el : List PermData, el.foldl (findStep w π') none = el.find? fun e => mapsB w e π'
  | [] => rfl
  | e :: el => by
    rw [List.foldl_cons, List.find?_cons]
    by_cases h : mapsB w e π' = true
    · simp only [findStep, h, ↓reduceIte, Option.elim]
      clear h
      induction el with
      | nil => rfl
      | cons f el ih => simpa [findStep] using ih
    · simp only [findStep, h, Bool.false_eq_true, ↓reduceIte, Option.elim]
      exact foldl_findStep w π' el

theorem RunsWithin.liftProg (el : List PermData) (w : WinData) (π' : PermData) :
    RunsWithin X body (Enum.liftProg n el w π') (liftModel n el w π')
      (el.length * (8 * w.1.length + 8) + 2 * w.1.length + 2 * n + 9) := by
  have hfold := RunsWithin.foldList_of (X := X) (body := body) (a' := Ty.perm)
    (b' := .option Ty.perm) (cf := fun _ => 8 * w.1.length + 7)
    (f := fun (acc : Option PermData) (e : PermData) =>
      Prog.caseOption (a := Ty.perm) acc
        (.bind (Enum.mapsProg w.1.toArray w.1.length e π') fun b =>
          .ite b (.op1 .some e) (.ret acc))
        fun _ => .ret acc)
    (F := findStep w π') el none fun acc e _ => by
      rcases acc with _ | x
      · apply RunsWithin.mono
        case h =>
          refine RunsWithin.caseOption_none (k := 8 * w.1.length + 6) ?_
          refine RunsWithin.bind_le (c₂ := 2) (RunsWithin.mapsProg w e π') ?_ (by omega)
          simp only [findStep, Option.elim]
          cases mapsB w e π'
          · exact (RunsWithin.ite_false (RunsWithin.ret _)).mono (by omega)
          · exact (RunsWithin.ite_true (RunsWithin.prim _ _)).mono (by simp [Prim.cost])
        case hc => omega
      · apply RunsWithin.mono
        case h => exact RunsWithin.caseOption_some (RunsWithin.ret _)
        case hc => omega
  rw [foldl_findStep, sum_map_const] at hfold
  apply RunsWithin.mono
  case h =>
    run_step (RunsWithin.prim _ _)
    run_step (RunsWithin.prim _ _)
    run_step (RunsWithin.prim _ _)
    run_step (RunsWithin.prim _ _)
    run_step hfold
    simp only [liftModel]
    rcases (el.find? fun e => mapsB w e π') with _ | f
    · exact (RunsWithin.caseOption_none (RunsWithin.permOne _)).mono (le_refl _)
    · exact (RunsWithin.caseOption_some (RunsWithin.ret _)).mono (by omega)
  case hc =>
    simp only [Prim.cost, Prim.eval, Args.head_cons, Nat.add_assoc, Nat.reduceAdd]
    omega

theorem RunsWithin.repsProg {gs ks : GensData} {el kl : List PermData} (h : refDV n gs el)
    (hkl : refDV n ks kl) :
    RunsWithin X body (Enum.repsProg el kl) (repsModel el kl)
      (el.length * (el.length * (kl.length * (6 * n + 12) + 12 * n + 19) + 4) + 1) := by
  have hfold := RunsWithin.foldList_inv (X := X) (body := body) (a' := Ty.perm) (b' := Ty.gens)
    (I := fun acc : List PermData => (∀ r ∈ acc, r ∈ el) ∧
      acc.Pairwise (RepsApart n (GensData.denote n ks)))
    (c := el.length * (kl.length * (6 * n + 12) + 12 * n + 19) + 3)
    (f := fun (acc : List PermData) (g : PermData) =>
      Prog.bind (anyList (a' := Ty.perm) acc fun r => .bind (Programs.permInv r) fun ri =>
        .bind (Programs.permMul ri g) fun d => Enum.memProg d kl) fun c =>
      .ite c (.ret acc) (.op2 .cons g acc))
    (F := repsStep kl) el [] (fun acc hI g hg => by
      have hlen : acc.length ≤ el.length :=
        length_le_of_subset_nodup (nodup_of_repsApart hI.2) hI.1
      refine ⟨?_, repsStep_inv h.1 hkl hI.1 hI.2 hg⟩
      have hany : RunsWithin X body (anyList (a' := Ty.perm) acc fun r =>
          .bind (Programs.permInv r) fun ri => .bind (Programs.permMul ri g) fun d =>
            Enum.memProg d kl) (coveredB kl acc g)
          (acc.length * (kl.length * (6 * n + 12) + 12 * n + 17 + 2) + 1) := by
        refine RunsWithin.anyList_le (a' := Ty.perm) (c := kl.length * (6 * n + 12) + 12 * n + 17)
          (P := fun r : PermData => memB (r.inv.mul g) kl) fun r hr => ?_
        have hrv : PermData.Valid n r := h.1 r (hI.1 r hr)
        refine RunsWithin.bind_le (RunsWithin.permInv r) ?_ (c₂ := 12 * n + 13 +
          (kl.length * (6 * n + 12) + 1)) (by omega)
        exact RunsWithin.bind_le (RunsWithin.permMul hrv.inv (h.1 g hg))
          (RunsWithin.memProg hkl.1) (by omega)
      have hmul : acc.length * (kl.length * (6 * n + 12) + 12 * n + 17 + 2) ≤
          el.length * (kl.length * (6 * n + 12) + 12 * n + 19) := Nat.mul_le_mul hlen le_rfl
      refine RunsWithin.bind_le hany ?_ (c₂ := 2) (by omega)
      unfold repsStep
      cases coveredB kl acc g
      · exact (RunsWithin.ite_false (RunsWithin.prim _ _)).mono (by simp [Prim.cost])
      · exact (RunsWithin.ite_true (RunsWithin.ret _)).mono (by omega))
      ⟨fun _ h => absurd h (by simp), List.Pairwise.nil⟩
  apply RunsWithin.mono
  case h =>
    run_step (RunsWithin.prim _ _)
    exact hfold.1
  case hc =>
    simp only [Prim.cost, Nat.add_assoc, Nat.reduceAdd]
    omega

end OpSpecs

