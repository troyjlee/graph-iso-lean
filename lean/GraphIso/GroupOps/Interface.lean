module

public import GraphIso.Cost.BackendRefinement
public import GraphIso.Representation.Encoding

/-!
# The group-operation interface

The operations a solver may request from a permutation-group backend, as a backend signature
`groupSig D` of the cost language, where `D` is the value type of the backend's own data.
A represented group is `GroupData`: its degree, its generators and backend data. It denotes
the subgroup generated by its generators; the backend data never changes the denotation and
is constrained only by the backend's invariant `DV`.

For each operation there is a precondition `GroupPre` and an exact semantic postcondition
`GroupPost`; together they are the contract (`MeetsContract`). Costs are charged per call by a
`CostSchedule (groupSig D)`, which sees the actual argument and result of the call;
`callParams` extracts the size parameters (degree, generator count, encoded backend data size,
window size, number of output items, and encoded size of the result in cells) used to state
concrete schedules.

| operation | argument | result | postcondition |
|---|---|---|---|
| `generate` | degree, generators | group | generates the same subgroup |
| `mem` | group, permutation | Boolean | `true` iff the permutation is in the group |
| `orbits` | group, invariant window | lists of points | exactly the orbits on the window |
| `stabilizer` | group, point | group | the point stabilizer |
| `orbitTransversal` | group, point | pairs | for each orbit point, an element reaching it |
| `cosetReps` | group `G`, subgroup `K` | elements | a left transversal of `K` in `G` |
| `kernel` | group, invariant window | group | the pointwise stabilizer of the window |
| `lift` | group, window, permutation of window indices | element | a preimage under restriction |

General string stabilizers, arbitrary setwise stabilizers and coset intersection are
deliberately absent: they would conceal the problem being solved.
-/

@[expose] public section

namespace GraphIso

open Equiv Cost

namespace Cost.Ty

/-- Represented permutations. -/
abbrev perm : Ty := .prod (.array .nat) (.array .nat)
/-- Represented strings. -/
abbrev str : Ty := .array .nat
/-- Represented windows. -/
abbrev win : Ty := .prod (.list .nat) (.array .bool)
/-- Represented generator lists. -/
abbrev gens : Ty := .list perm
/-- Represented groups: degree, generators and backend data of type `D`. -/
abbrev group (D : Ty) : Ty := .prod .nat (.prod gens D)

/-- The number of cells of a value; used for size parameters. -/
def size : (t : Ty) → t.denote → ℕ
  | .unit, _ => 1
  | .bool, _ => 1
  | .nat, _ => 1
  | .prod a b, v => size a v.1 + size b v.2
  | .list a, v => 1 + (v.map (size a)).sum
  | .array a, v => 1 + (v.toList.map (size a)).sum
  | .option a, v => 1 + v.elim 0 (size a)

end Cost.Ty

/-- A represented group: degree, generators, backend data. -/
abbrev GroupData (D : Type) := ℕ × GensData × D

namespace GroupData

variable {D : Type}

/-- The degree. -/
def degree (G : GroupData D) : ℕ := G.1
/-- The generators. -/
def gens (G : GroupData D) : GensData := G.2.1
/-- The backend data. -/
def data (G : GroupData D) : D := G.2.2

/-- The denoted subgroup of `Perm (Fin G.degree)`. -/
def toSubgroup (G : GroupData D) : Subgroup (Perm (Fin G.degree)) := G.gens.denote G.degree

/-- Valid group data for the backend invariant `DV`. -/
def Valid (DV : ℕ → GensData → D → Prop) (G : GroupData D) : Prop :=
  G.gens.AllValid G.degree ∧ DV G.degree G.gens G.data

end GroupData

/-! ### Semantic notions used by the contracts -/

/-- The point stabilizer `{g ∈ G | g u = u}`. -/
def pointStab {n : ℕ} (G : Subgroup (Perm (Fin n))) (u : Fin n) : Subgroup (Perm (Fin n)) :=
  G ⊓ MulAction.stabilizer (Perm (Fin n)) u

theorem mem_pointStab {n : ℕ} {G : Subgroup (Perm (Fin n))} {u : Fin n} {g : Perm (Fin n)} :
    g ∈ pointStab G u ↔ g ∈ G ∧ g u = u := by
  rw [pointStab, Subgroup.mem_inf, MulAction.mem_stabilizer_iff, Perm.smul_def]


/-- `i` and `j` are positions below `n` in the same `G`-orbit. -/
def SameOrbit {n : ℕ} (G : Subgroup (Perm (Fin n))) (i j : ℕ) : Prop :=
  ∃ (hi : i < n) (hj : j < n), ∃ g ∈ G, g ⟨i, hi⟩ = ⟨j, hj⟩

section SameOrbit

variable {n : ℕ} {G : Subgroup (Perm (Fin n))}

theorem sameOrbit_refl {i : ℕ} (hi : i < n) : SameOrbit G i i := ⟨hi, hi, 1, one_mem G, rfl⟩

theorem SameOrbit.symm {i j : ℕ} (h : SameOrbit G i j) : SameOrbit G j i := by
  obtain ⟨hi, hj, g, hg, e⟩ := h
  exact ⟨hj, hi, g⁻¹, inv_mem hg, by rw [← e]; simp⟩

theorem SameOrbit.trans {i j k : ℕ} (h₁ : SameOrbit G i j) (h₂ : SameOrbit G j k) :
    SameOrbit G i k := by
  obtain ⟨hi, hj, g, hg, e₁⟩ := h₁
  obtain ⟨_, hk, g', hg', e₂⟩ := h₂
  exact ⟨hi, hk, g' * g, mul_mem hg' hg, by rw [Perm.mul_apply, e₁, e₂]⟩

/-- Points in the same orbit as a point of an invariant window lie in the window. -/
theorem SameOrbit.mem_of_invariant {w : WinData} (hinv : IsInvariant G (w.denote n)) {i j : ℕ}
    (h : SameOrbit G i j) (hi : i ∈ w.1) : j ∈ w.1 := by
  obtain ⟨hi', hj, g, hg, e⟩ := h
  have := hinv g hg ⟨i, hi'⟩ hi
  rw [e] at this
  exact this

end SameOrbit

/-- `os` lists exactly the `G`-orbits on the window `w`: each list is nonempty and is the
orbit of each of its points, and together they list the window points exactly once. -/
def IsOrbitPartition {n : ℕ} (G : Subgroup (Perm (Fin n))) (w : WinData)
    (os : List (List ℕ)) : Prop :=
  os.flatten.Perm w.1 ∧ ∀ o ∈ os, o ≠ [] ∧ ∀ i ∈ o, ∀ j, j ∈ o ↔ SameOrbit G i j

/-- Restricting a permutation to a window, in the window's list order: `r` maps the `j`-th
listed point to the `π' j`-th listed point. -/
def MapsWindowBy (w : WinData) (r π' : PermData) : Prop :=
  ∀ j < w.1.length, get r.1 (w.1.getD j 0) = w.1.getD (get π'.1 j) 0

/-! ### The signature -/

/-- Operations of a group backend. -/
inductive GroupOp where
  | generate
  | mem
  | orbits
  | stabilizer
  | orbitTransversal
  | cosetReps
  | kernel
  | lift
  deriving DecidableEq, Repr

/-- The backend signature for groups whose backend data has type `D`. -/
def groupSig (D : Ty) : Signature where
  Op := GroupOp
  arg
    | .generate => .prod .nat Ty.gens
    | .mem => .prod (Ty.group D) Ty.perm
    | .orbits => .prod (Ty.group D) Ty.win
    | .stabilizer => .prod (Ty.group D) .nat
    | .orbitTransversal => .prod (Ty.group D) .nat
    | .cosetReps => .prod (Ty.group D) (Ty.group D)
    | .kernel => .prod (Ty.group D) Ty.win
    | .lift => .prod (Ty.group D) (.prod Ty.win Ty.perm)
  res
    | .generate => Ty.group D
    | .mem => .bool
    | .orbits => .list (.list .nat)
    | .stabilizer => Ty.group D
    | .orbitTransversal => .list (.prod .nat Ty.perm)
    | .cosetReps => .list Ty.perm
    | .kernel => Ty.group D
    | .lift => Ty.perm

/-! ### Contracts -/

section Contract

variable {D : Ty} (DV : ℕ → GensData → D.denote → Prop)

/-- Valid group data `(n, gs, d)`: valid generators of degree `n` and valid backend data. -/
def GroupValid (n : ℕ) (gs : GensData) (d : D.denote) : Prop := GensData.AllValid n gs ∧ DV n gs d

/-- Preconditions of the group operations. -/
def GroupPre : (op : GroupOp) → ((groupSig D).arg op).denote → Prop
  | .generate, (n, gs) => GensData.AllValid n gs
  | .mem, ((n, gs, d), π) => GroupValid DV n gs d ∧ PermData.Valid n π
  | .orbits, ((n, gs, d), w) => GroupValid DV n gs d ∧ WinData.Valid n w ∧
      IsInvariant (GensData.denote n gs) (WinData.denote n w)
  | .stabilizer, ((n, gs, d), u) => GroupValid DV n gs d ∧ u < n
  | .orbitTransversal, ((n, gs, d), u) => GroupValid DV n gs d ∧ u < n
  | .cosetReps, ((n, gs, d), (n', ks, e)) => GroupValid DV n gs d ∧ GroupValid DV n' ks e ∧
      n' = n ∧ GensData.denote n ks ≤ GensData.denote n gs
  | .kernel, ((n, gs, d), w) => GroupValid DV n gs d ∧ WinData.Valid n w ∧
      IsInvariant (GensData.denote n gs) (WinData.denote n w)
  | .lift, ((n, gs, d), w, π') => GroupValid DV n gs d ∧ WinData.Valid n w ∧
      IsInvariant (GensData.denote n gs) (WinData.denote n w) ∧ PermData.Valid w.1.length π' ∧
      ∃ r, PermData.Valid n r ∧ PermData.denote n r ∈ GensData.denote n gs ∧ MapsWindowBy w r π'

/-- Exact postconditions of the group operations. -/
def GroupPost : (op : GroupOp) → ((groupSig D).arg op).denote → ((groupSig D).res op).denote →
    Prop
  | .generate, (n, gs), (n', hs, e) => n' = n ∧ GroupValid DV n hs e ∧
      GensData.denote n hs = GensData.denote n gs
  | .mem, ((n, gs, _), π), b => (b = true ↔ PermData.denote n π ∈ GensData.denote n gs)
  | .orbits, ((n, gs, _), w), os => IsOrbitPartition (GensData.denote n gs) w os
  | .stabilizer, ((n, gs, _), u), (n', ks, e) => n' = n ∧ GroupValid DV n ks e ∧
      ∀ hu : u < n, GensData.denote n ks = pointStab (GensData.denote n gs) ⟨u, hu⟩
  | .orbitTransversal, ((n, gs, _), u), rs => (rs.map Prod.fst).Nodup ∧
      (∀ j, j ∈ rs.map Prod.fst ↔ SameOrbit (GensData.denote n gs) u j) ∧
      ∀ vr ∈ (show List (ℕ × PermData) from rs), PermData.Valid n vr.2 ∧
        PermData.denote n vr.2 ∈ GensData.denote n gs ∧ get vr.2.1 u = vr.1
  | .cosetReps, ((n, gs, _), (_, ks, _)), rs =>
      (∀ r ∈ (show List PermData from rs), PermData.Valid n r) ∧
      IsLeftTransversal (GensData.denote n gs) (GensData.denote n ks)
        (fun i : Fin rs.length => PermData.denote n (rs.get i))
  | .kernel, ((n, gs, _), w), (n', ks, e) => n' = n ∧ GroupValid DV n ks e ∧
      GensData.denote n ks = pointwiseStab (GensData.denote n gs) (WinData.denote n w)
  | .lift, ((n, gs, _), w, π'), r => PermData.Valid n r ∧
      PermData.denote n r ∈ GensData.denote n gs ∧ MapsWindowBy w r π'

/-- An oracle meets the contract when it satisfies every postcondition on every input
satisfying the precondition. -/
def MeetsContract (O : Oracle (groupSig D)) : Prop :=
  ∀ op x, GroupPre DV op x → GroupPost DV op x (O.run op x)

/-- An oracle meets the contract on the operations satisfying `ops`. -/
def MeetsContractOn (ops : GroupOp → Prop) (O : Oracle (groupSig D)) : Prop :=
  ∀ op x, ops op → GroupPre DV op x → GroupPost DV op x (O.run op x)

theorem MeetsContract.on {O : Oracle (groupSig D)} (h : MeetsContract DV O)
    (ops : GroupOp → Prop) : MeetsContractOn DV ops O :=
  fun op x _ hx => h op x hx

end Contract

/-! ### Size parameters -/

/-- The size parameters of a backend call, used to state cost schedules: degree `n`, number of
input generators `s`, encoded size of the input backend data, window size `m`, the number of
output items, and the encoded size of the result.

`outCount` counts items: generators of an output group, orbits, transversal pairs or coset
representatives (and `1` for `mem` and `lift`). `outSize` counts encoded cells (`Ty.size`) of
the whole result; for example an orbit transversal of `k` pairs at degree `n` has
`outSize = 1 + k * (2 * n + 3)` (`Ty.size_transversal`). -/
structure CallParams where
  degree : ℕ
  gens : ℕ
  dataSize : ℕ
  window : ℕ
  outCount : ℕ
  outSize : ℕ
  deriving DecidableEq, Repr

/-- The size parameters of an actual backend call. -/
def callParams {D : Ty} : (op : GroupOp) → ((groupSig D).arg op).denote →
    ((groupSig D).res op).denote → CallParams
  | .generate, (n, gs), (n', hs, e) =>
      ⟨n, gs.length, 0, 0, hs.length, Ty.size (Ty.group D) (n', hs, e)⟩
  | .mem, ((n, gs, d), _), _ => ⟨n, gs.length, Ty.size D d, 0, 1, 1⟩
  | .orbits, ((n, gs, d), w), os =>
      ⟨n, gs.length, Ty.size D d, w.1.length, os.length, Ty.size (.list (.list .nat)) os⟩
  | .stabilizer, ((n, gs, d), _), (n', ks, e) =>
      ⟨n, gs.length, Ty.size D d, 0, ks.length, Ty.size (Ty.group D) (n', ks, e)⟩
  | .orbitTransversal, ((n, gs, d), _), rs =>
      ⟨n, gs.length, Ty.size D d, 0, rs.length, Ty.size (.list (.prod .nat Ty.perm)) rs⟩
  | .cosetReps, ((n, gs, d), (_, ks, e)), rs =>
      ⟨n, gs.length + ks.length, Ty.size D d + Ty.size D e, 0, rs.length,
        Ty.size (.list Ty.perm) rs⟩
  | .kernel, ((n, gs, d), w), (n', ks, e) =>
      ⟨n, gs.length, Ty.size D d, w.1.length, ks.length, Ty.size (Ty.group D) (n', ks, e)⟩
  | .lift, ((n, gs, d), w, _), r => ⟨n, gs.length, Ty.size D d, w.1.length, 1, Ty.size Ty.perm r⟩

/-! Encoded sizes of represented values. -/

theorem Ty.size_array_nat (a : Array ℕ) : Ty.size (.array .nat) a = 1 + a.size := by
  show 1 + (a.toList.map fun _ => 1).sum = 1 + a.size
  rw [sum_map_const, Array.length_toList, Nat.mul_one]

theorem Ty.size_perm (g : PermData) : Ty.size Ty.perm g = 2 + g.1.size + g.2.size := by
  show Ty.size (.array .nat) g.1 + Ty.size (.array .nat) g.2 = _
  rw [Ty.size_array_nat, Ty.size_array_nat]
  omega

theorem Ty.size_perm_of_valid {n : ℕ} {g : PermData} (h : g.Valid n) :
    Ty.size Ty.perm g = 2 * n + 2 := by
  rw [Ty.size_perm, h.size_fwd, h.size_inv]
  omega

theorem Ty.size_gens {n : ℕ} {gs : GensData} (h : GensData.AllValid n gs) :
    Ty.size Ty.gens gs = 1 + gs.length * (2 * n + 2) := by
  show 1 + (gs.map (Ty.size Ty.perm)).sum = _
  rw [List.map_congr_left (g := fun _ => 2 * n + 2) fun g hg => Ty.size_perm_of_valid (h g hg),
    sum_map_const]

theorem Ty.size_group {D : Ty} {n : ℕ} {gs : GensData} (d : D.denote)
    (h : GensData.AllValid n gs) :
    Ty.size (Ty.group D) (n, gs, d) = 2 + gs.length * (2 * n + 2) + Ty.size D d := by
  show 1 + (Ty.size Ty.gens gs + Ty.size D d) = _
  rw [Ty.size_gens h]
  omega

/-- An orbit transversal of `k` pairs at degree `n` has `1 + k * (2 * n + 3)` cells. -/
theorem Ty.size_transversal {n : ℕ} {rs : List (ℕ × PermData)}
    (h : ∀ vr ∈ rs, vr.2.Valid n) :
    Ty.size (.list (.prod .nat Ty.perm)) rs = 1 + rs.length * (2 * n + 3) := by
  show 1 + (rs.map (Ty.size (.prod .nat Ty.perm))).sum = _
  rw [List.map_congr_left (g := fun _ => 2 * n + 3) fun vr hvr => ?_, sum_map_const]
  show 1 + Ty.size Ty.perm vr.2 = 2 * n + 3
  rw [Ty.size_perm_of_valid (h vr hvr)]
  omega

/-- A cost schedule that depends only on the size parameters of each call. -/
def CostSchedule.ofParams {D : Ty} (f : GroupOp → CallParams → ℕ) : CostSchedule (groupSig D) where
  call op x y := f op (callParams op x y)

end GraphIso
