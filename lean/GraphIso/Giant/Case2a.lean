module

public import GraphIso.Align.AlignProg
public import GraphIso.Align.SetOps
public import GraphIso.CertProg.CertIso
public import GraphIso.Reductions.SequentialProg
public import GraphIso.Recursion.Pullback
public import GraphIso.Certificates.Cases

/-!
# Case 2a: the pullback

Stage 14g, item 4 (`PLAN-14.md` §11, §2.3 step 4). The full group `F ≤ Aut(x)` has an orbit `Φ`
of more than half of the base on which it acts as a giant.

* **The pullback** (`pullbackProg`, `RunsWithin.pullbackProg`), on a coset `σ • H` with `H`
  leaving `Φ` (positions `pΦ`) and the window invariant and `F ≤ H`:
  - `K` is the pointwise stabilizer of `Φ` in `H` (`iterStabProg`);
  - the branches are the cosets `(σ * r) • K` for `r` the identity and the generators of `H`.
    This is **parity-free**: an element even on `Φ` lies in `K ⊔ F`, and if some element of `H`
    is odd on `Φ`, so is some generator (`c2_cover`). So these representatives cover `H` by
    cosets of `K ⊔ F`, without computing a sign. There are `|gens H| + 1` branches instead of
    the two of `iso_pullback`;
  - each branch is solved on `K`'s orbits on the window (`seqProg`, sub-calls on windows of at
    most half of the points, by the hypothesis `hhalf` that `card_orbit_le_half` supplies),
    then augmented by `F`'s generators: the solutions in `ρ • (K ⊔ F)` are those in `ρ • K`
    times `F` (`c2_iso_sup_smul`, `c2_aut_sup`, via `K ⊔ F = K F` since `F` normalizes `K`);
  - the branch answers are combined by `combineProg` (`AnsOK.combineModel`).
* **Case 2a** (`case2aProg`, `RunsWithin.case2aProg`): Align (`alignProg` with `setOps`) of the
  large orbit `Φx` of `F(x)` with that of `F(y)`, with the pullback as the sub-solver in each
  aligned coset. `c2_g1_spec` recovers the aligned group `G₁ = ψ⁻¹(Stab(Φx) ∩ P)`: degree,
  validity, denotation and generator bound.

Backend charges are explicit hypotheses or come from `BackendBounds`; the recursive calls go
through the sub-solver parameter `sub` (`SubSolves` for `PbSubP`).
-/

@[expose] public section

namespace GraphIso.Giant

open Equiv Cost GraphIso.Programs Pointwise GraphIso.Toolkit GraphIso.Align GraphIso.Solver

/-! ### Semantics -/

section Sem

variable {N : ℕ}

/-- The positions listed in `pΦ`, as a finset. -/
def phiSet (N : ℕ) (pΦ : List ℕ) : Finset (Fin N) := Finset.univ.filter fun v => v.val ∈ pΦ

theorem coe_phiSet (N : ℕ) (pΦ : List ℕ) :
    ((phiSet N pΦ : Finset (Fin N)) : Set (Fin N)) = {v : Fin N | v.val ∈ pΦ} := by
  ext v
  simp [phiSet]

/-- `F` normalizes the pointwise stabilizer of an `H`-invariant set. -/
theorem c2_le_normalizer {H F : Subgroup (Perm (Fin N))} {Φ : Set (Fin N)}
    (hΦ : IsInvariant H Φ) (hFH : F ≤ H) :
    F ≤ Subgroup.normalizer (pointwiseStab H Φ : Set (Perm (Fin N))) := by
  intro f hf
  rw [Subgroup.mem_normalizer_iff]
  intro k
  have hfH := hFH hf
  constructor
  · rintro ⟨hkH, hk⟩
    refine ⟨mul_mem (mul_mem hfH hkH) (inv_mem hfH), fun u hu => ?_⟩
    have hu' : f⁻¹ u ∈ Φ := hΦ.inv_apply_mem hfH hu
    rw [Perm.mul_apply, Perm.mul_apply, hk _ hu', perm_apply_inv_self]
  · rintro ⟨hkH, hk⟩
    have hkH' : k ∈ H := by
      have := mul_mem (mul_mem (inv_mem hfH) hkH) hfH
      simpa [mul_assoc] using this
    refine ⟨hkH', fun u hu => ?_⟩
    have hfu : f u ∈ Φ := hΦ.apply_mem hfH hu
    have := hk _ hfu
    rw [Perm.mul_apply, Perm.mul_apply, perm_inv_apply_self] at this
    exact f.injective this

/-- Elements of `K ⊔ F` are products `k f`. -/
theorem c2_mem_sup {H F : Subgroup (Perm (Fin N))} {Φ : Set (Fin N)} (hΦ : IsInvariant H Φ)
    (hFH : F ≤ H) {g : Perm (Fin N)} (hg : g ∈ pointwiseStab H Φ ⊔ F) :
    ∃ k ∈ pointwiseStab H Φ, ∃ f ∈ F, g = k * f := by
  have h := Subgroup.coe_mul_of_right_le_normalizer_left (pointwiseStab H Φ) F
    (c2_le_normalizer hΦ hFH)
  have hg' : g ∈ ((pointwiseStab H Φ ⊔ F : Subgroup (Perm (Fin N))) : Set (Perm (Fin N))) := hg
  rw [h] at hg'
  obtain ⟨k, hk, f, hf, rfl⟩ := Set.mem_mul.1 hg'
  exact ⟨k, hk, f, hf, rfl⟩

theorem c2_sup_le {H F : Subgroup (Perm (Fin N))} {Φ : Set (Fin N)} (hFH : F ≤ H) :
    pointwiseStab H Φ ⊔ F ≤ H :=
  sup_le (fun _ hk => hk.1) hFH

variable {W : Set (Fin N)} {x y : Fin N → ℕ}

/-- **The automorphisms in `K ⊔ F`** are generated by those in `K` and `F`. -/
theorem c2_aut_sup {H F : Subgroup (Perm (Fin N))} {Φ : Set (Fin N)} (hW : IsInvariant H W)
    (hΦ : IsInvariant H Φ) (hFH : F ≤ H) (hFx : ∀ f ∈ F, Matches W f x x) :
    aut (hW.mono (c2_sup_le (Φ := Φ) hFH)) x =
      Subgroup.closure ((aut (hW.mono (fun _ hk => hk.1 : pointwiseStab H Φ ≤ H)) x : Set _) ∪
        (F : Set (Perm (Fin N)))) := by
  apply le_antisymm
  · intro g hg
    obtain ⟨hgKF, hgm⟩ := (mem_aut _).1 hg
    obtain ⟨k, hk, f, hf, rfl⟩ := c2_mem_sup hΦ hFH hgKF
    have hfa : f ∈ aut (hW.mono (c2_sup_le (Φ := Φ) hFH)) x :=
      (mem_aut _).2 ⟨le_sup_right (a := pointwiseStab H Φ) hf, hFx f hf⟩
    have hka : k ∈ aut (hW.mono (c2_sup_le (Φ := Φ) hFH)) x := by
      have := mul_mem hg (inv_mem hfa)
      simpa using this
    have hk' : k ∈ aut (hW.mono (fun _ hk => hk.1 : pointwiseStab H Φ ≤ H)) x :=
      (mem_aut _).2 ⟨hk, ((mem_aut _).1 hka).2⟩
    exact mul_mem (Subgroup.subset_closure (Or.inl hk')) (Subgroup.subset_closure (Or.inr hf))
  · rw [Subgroup.closure_le]
    rintro g (hg | hg)
    · obtain ⟨hgK, hgm⟩ := (mem_aut _).1 hg
      exact (mem_aut _).2 ⟨le_sup_left (b := F) hgK, hgm⟩
    · exact (mem_aut _).2 ⟨le_sup_right (a := pointwiseStab H Φ) hg, hFx g hg⟩

/-- No solution in `ρ • K`, none in `ρ • (K ⊔ F)`. -/
theorem c2_iso_sup_empty {H F : Subgroup (Perm (Fin N))} {Φ : Set (Fin N)}
    (hW : IsInvariant H W) (hΦ : IsInvariant H Φ) (hFH : F ≤ H)
    (hFx : ∀ f ∈ F, Matches W f x x) {ρ : Perm (Fin N)}
    (h : iso W ρ (pointwiseStab H Φ) x y = ∅) : iso W ρ (pointwiseStab H Φ ⊔ F) x y = ∅ := by
  rw [Set.eq_empty_iff_forall_notMem] at h ⊢
  intro g hg
  rw [mem_iso] at hg
  obtain ⟨k, hk, f, hf, he⟩ := c2_mem_sup hΦ hFH hg.1
  apply h (g * f⁻¹)
  rw [mem_iso]
  refine ⟨?_, fun u hu => ?_⟩
  · rw [← mul_assoc, he, mul_inv_cancel_right]
    exact hk
  · have hfu : f⁻¹ u ∈ W := hW.inv_apply_mem (hFH hf) hu
    rw [Perm.mul_apply, ← hg.2 _ hfu]
    have := hFx f hf (f⁻¹ u) hfu
    rw [perm_apply_inv_self] at this
    exact this.symm

/-- A solution coset for `ρ • K` gives one for `ρ • (K ⊔ F)`. -/
theorem c2_iso_sup_smul {H F : Subgroup (Perm (Fin N))} {Φ : Set (Fin N)}
    (hW : IsInvariant H W) (hΦ : IsInvariant H Φ) (hFH : F ≤ H)
    (hFx : ∀ f ∈ F, Matches W f x x) {ρ τ : Perm (Fin N)} {A : Subgroup (Perm (Fin N))}
    (h : iso W ρ (pointwiseStab H Φ) x y = τ • (A : Set (Perm (Fin N)))) :
    iso W ρ (pointwiseStab H Φ ⊔ F) x y =
      τ • (Subgroup.closure ((A : Set (Perm (Fin N))) ∪ F) : Set (Perm (Fin N))) := by
  have hWK : IsInvariant (pointwiseStab H Φ) W := hW.mono fun _ hk => hk.1
  have hWKF : IsInvariant (pointwiseStab H Φ ⊔ F) W := hW.mono (c2_sup_le hFH)
  have hA : A = aut hWK x := eq_aut_of_iso_eq_smul hWK h
  have hτ : τ ∈ iso W ρ (pointwiseStab H Φ) x y := by
    rw [h]
    exact self_mem_leftCoset _ _
  have hτ' : τ ∈ iso W ρ (pointwiseStab H Φ ⊔ F) x y :=
    iso_mono_group (le_sup_left) (by simp) hτ
  rw [iso_eq_smul_aut hWKF hτ', c2_aut_sup hW hΦ hFH hFx, hA]

/-- The action of `H` on the positions of `Φ`. -/
def phiRes {H : Subgroup (Perm (Fin N))} {pΦ : List ℕ}
    (hΦ : IsInvariant H ((phiSet N pΦ : Finset (Fin N)) : Set (Fin N))) :
    H →* Perm (phiSet N pΦ) :=
  restrictHom hΦ (Equiv.refl _)

theorem phiRes_apply {H : Subgroup (Perm (Fin N))} {pΦ : List ℕ}
    (hΦ : IsInvariant H ((phiSet N pΦ : Finset (Fin N)) : Set (Fin N))) (g : H)
    (v : phiSet N pΦ) : ((phiRes hΦ g v : phiSet N pΦ) : Fin N) = (g : Perm (Fin N)) v :=
  restrictHom_apply hΦ (Equiv.refl _) g v

/-- An element of `H` even on `Φ` lies in `K ⊔ F`. -/
theorem c2_even_mem {H F : Subgroup (Perm (Fin N))} {pΦ : List ℕ}
    (hΦ : IsInvariant H ((phiSet N pΦ : Finset (Fin N)) : Set (Fin N))) (hFH : F ≤ H)
    (hFalt : ∀ π : Perm (phiSet N pΦ), Perm.sign π = 1 →
      ∃ f ∈ F, ∀ v : phiSet N pΦ, f v = π v) (g : H)
    (hg : Perm.sign (phiRes hΦ g) = 1) :
    (g : Perm (Fin N)) ∈
      pointwiseStab H ((phiSet N pΦ : Finset (Fin N)) : Set (Fin N)) ⊔ F := by
  obtain ⟨f, hf, hfr⟩ := hFalt _ hg
  have hfH := hFH hf
  have key : (g : Perm (Fin N)) * f⁻¹ ∈
      pointwiseStab H ((phiSet N pΦ : Finset (Fin N)) : Set (Fin N)) := by
    refine ⟨mul_mem g.2 (inv_mem hfH), fun u hu => ?_⟩
    have hv : f⁻¹ u ∈ ((phiSet N pΦ : Finset (Fin N)) : Set (Fin N)) :=
      hΦ.inv_apply_mem hfH hu
    have h1 := hfr ⟨f⁻¹ u, hv⟩
    have h2 := phiRes_apply hΦ g ⟨f⁻¹ u, hv⟩
    have h3 : (g : Perm (Fin N)) (f⁻¹ u) = f (f⁻¹ u) := h2.symm.trans h1.symm
    rw [Perm.mul_apply, h3, perm_apply_inv_self]
  have := mul_mem (le_sup_left (b := F) key) (le_sup_right (a := pointwiseStab H _) hf)
  simpa using this

/-- **The cover** of `H` by cosets of `K ⊔ F`, with representatives `1` and the generators of
`H`. An element even on `Φ` lies in `K ⊔ F`; if an element is odd on `Φ`, so is some generator,
and multiplying by it makes the element even. No sign is computed. -/
theorem c2_cover {H F : Subgroup (Perm (Fin N))} {pΦ : List ℕ}
    (hΦ : IsInvariant H ((phiSet N pΦ : Finset (Fin N)) : Set (Fin N))) (hFH : F ≤ H)
    (hFalt : ∀ π : Perm (phiSet N pΦ), Perm.sign π = 1 →
      ∃ f ∈ F, ∀ v : phiSet N pΦ, f v = π v)
    {R : List (Perm (Fin N))} (hR1 : (1 : Perm (Fin N)) ∈ R)
    (hRH : H = Subgroup.closure {ρ | ρ ∈ R}) :
    ∀ h ∈ H, ∃ ρ ∈ R, ρ⁻¹ * h ∈
      pointwiseStab H ((phiSet N pΦ : Finset (Fin N)) : Set (Fin N)) ⊔ F := by
  intro h hh
  have hRmem : ∀ ρ ∈ R, ρ ∈ H := fun ρ hρ => hRH ▸ Subgroup.subset_closure hρ
  rcases Int.units_eq_one_or (Perm.sign (phiRes hΦ ⟨h, hh⟩)) with he | ho
  · exact ⟨1, hR1, by simpa using c2_even_mem hΦ hFH hFalt ⟨h, hh⟩ he⟩
  · -- some generator is odd
    have hex : ∃ ρ ∈ R, ∃ hρ : ρ ∈ H,
        Perm.sign (phiRes hΦ ⟨ρ, hρ⟩) = -1 := by
      by_contra hno
      simp only [not_exists, not_and] at hno
      have hall : ∀ g (hg : g ∈ H), Perm.sign (phiRes hΦ ⟨g, hg⟩) = 1 := by
        intro g hg
        have hg' : g ∈ Subgroup.closure {ρ | ρ ∈ R} := hRH ▸ hg
        induction hg' using Subgroup.closure_induction with
        | mem ρ hρ =>
          rcases Int.units_eq_one_or (Perm.sign (phiRes hΦ ⟨ρ, hg⟩)) with
            h1 | h1
          · exact h1
          · exact absurd h1 (hno ρ hρ hg)
        | one =>
          show Perm.sign (phiRes hΦ 1) = 1
          simp
        | mul a b ha hb iha ihb =>
          have e : (⟨a * b, hg⟩ : H) = ⟨a, hRH ▸ ha⟩ * ⟨b, hRH ▸ hb⟩ := rfl
          rw [e, map_mul, map_mul, iha, ihb, one_mul]
        | inv a ha iha =>
          have e : (⟨a⁻¹, hg⟩ : H) = (⟨a, hRH ▸ ha⟩ : H)⁻¹ := rfl
          rw [e, map_inv, map_inv, iha, inv_one]
      rw [hall h hh] at ho
      exact absurd ho (by decide)
    obtain ⟨ρ, hρR, hρH, hρo⟩ := hex
    refine ⟨ρ, hρR, ?_⟩
    have he : Perm.sign (phiRes hΦ ((⟨ρ, hρH⟩ : H)⁻¹ * ⟨h, hh⟩)) = 1 := by
      rw [map_mul, map_inv, map_mul, map_inv, hρo, ho]
      decide
    have hm := c2_even_mem (H := H) (F := F) (pΦ := pΦ) hΦ hFH hFalt _ he
    rwa [Subgroup.coe_mul, Subgroup.coe_inv] at hm

end Sem

/-! ### Programs -/

section Programs

variable {D : Ty} {rec : Ty × Ty} {var : Ty → Type}

/-- Add `F`'s generators to the group of a successful answer. -/
def augProg (N : var .nat) (a : var (Ty.answer D)) (Fgs : var Ty.gens) :
    Prog (groupSig D) rec var (Ty.answer D) :=
  .caseOption a (.op0 .none) fun c =>
    .bind (.op1 .fst c) fun τ => .bind (.op1 .snd c) fun A =>
    .bind (.op1 .snd A) fun ad => .bind (.op1 .fst ad) fun ags =>
    .bind (.op2 .append ags Fgs) fun gs => .bind (.op2 .pair N gs) fun arg =>
    .bind (Prog.call (S := groupSig D) GroupOp.generate arg) fun A' =>
    .bind (.op2 .pair τ A') fun c' => .op1 .some c'

/-- One branch of the pullback: the coset `(σ * r) • K`, solved on the orbits `os` of `K`, then
augmented by `F`. -/
def pbBranch (sub : var (Ty.inst D) → Prog (groupSig D) rec var (Ty.answer D))
    (xy : var Ty.strs) (σ : var Ty.perm) (K : var (Ty.group D)) (os : var (.list (.list .nat)))
    (Fgs : var Ty.gens) (N : var .nat) (r : var Ty.perm) :
    Prog (groupSig D) rec var (Ty.answer D) :=
  .bind (permMul σ r) fun σr => .bind (.op2 .pair σr K) fun c =>
  .bind (seqProg sub xy c os) fun a => augProg N a Fgs

/-- **The pullback** (Case 2a) on the coset `c = σ • H`. `K` is the pointwise stabilizer of the
positions `pΦ` in `H`; the branches are the cosets `(σ * r) • K` for `r` the identity and the
generators of `H`, each solved on `K`'s orbits on the window and augmented by `F`'s generators
`Fgs`; the answers are combined. -/
def pullbackProg (sub : var (Ty.inst D) → Prog (groupSig D) rec var (Ty.answer D))
    (xy : var Ty.strs) (w : var Ty.win) (c : var (Ty.coset D)) (Fgs : var Ty.gens)
    (pΦ : var (.list .nat)) : Prog (groupSig D) rec var (Ty.answer D) :=
  .bind (.op1 .fst c) fun σ => .bind (.op1 .snd c) fun H =>
  .bind (.op1 .fst H) fun N =>
  .bind (iterStabProg H pΦ) fun K =>
  .bind (.op2 .pair K w) fun Kw =>
  .bind (Prog.call (S := groupSig D) GroupOp.orbits Kw) fun os =>
  .bind (.op1 .snd H) fun hd => .bind (.op1 .fst hd) fun hgs =>
  .bind (permOne N) fun one => .bind (.op2 .cons one hgs) fun rs =>
  .bind (mapList rs fun r => pbBranch sub xy σ K os Fgs N r) fun as =>
  combineProg N as

/-- The pullback as a sub-solver on represented instances. -/
def pbSub (sub : var (Ty.inst D) → Prog (groupSig D) rec var (Ty.answer D))
    (Fgs : var Ty.gens) (pΦ : var (.list .nat)) (I : var (Ty.inst D)) :
    Prog (groupSig D) rec var (Ty.answer D) :=
  .bind (.op1 .fst I) fun xy => .bind (.op1 .snd I) fun wc =>
  .bind (.op1 .fst wc) fun w => .bind (.op1 .snd wc) fun c =>
  pullbackProg sub xy w c Fgs pΦ

/-- The base positions `n + j` of a list of base indices. -/
def posProg (n : var .nat) (l : var (.list .nat)) : Prog (groupSig D) rec var (.list .nat) :=
  mapList l fun j => .op2 .add n j

/-- **Case 2a**: align the large orbit `Φx` of `F(x)` with the large orbit `Φy` of `F(y)`
(`alignProg` with `setOps`), and solve each aligned coset by the pullback. -/
def case2aProg (sub : var (Ty.inst D) → Prog (groupSig D) rec var (Ty.answer D))
    (n : var .nat) (xy : var Ty.strs) (w : var Ty.win) (G : var (Ty.group D))
    (Φx Φy : var (.list .nat)) (Fgs : var Ty.gens) : Prog (groupSig D) rec var (Ty.answer D) :=
  .bind (.op1 .fst G) fun N => .bind (.op2 .sub N n) fun m =>
  .bind (posProg n Φx) fun pΦ =>
  .bind (.op0 .nil) fun nil => .bind (.op2 .cons Φy nil) fun Ys =>
  alignProg (fun I => pbSub sub Fgs pΦ I) (fun l => setGensProg m l)
    (fun l l' => setIsoProg m l l') n xy w G Φx Ys

end Programs

/-! ### The augmentation -/

section Aug

variable {D : Ty}

/-- The augmented answer, as computed by the backend. -/
def augModel (O : Oracle (groupSig D)) (N : ℕ) (a : AnswerData D) (Fgs : GensData) :
    AnswerData D :=
  a.map fun c => (c.1, O.run GroupOp.generate (N, c.2.gens ++ Fgs))

variable {DV : ℕ → GensData → D.denote → Prop} {N : ℕ} {W : Set (Fin N)} {x y : Fin N → ℕ}

/-- **Augmenting a branch answer by `F`** solves the coset of `K ⊔ F`. -/
theorem c2_ansOK_aug {O : Oracle (groupSig D)} (hO : MeetsContractOn DV (· = .generate) O)
    {H F : Subgroup (Perm (Fin N))} {pΦ : List ℕ} (hW : IsInvariant H W)
    (hΦ : IsInvariant H ((phiSet N pΦ : Finset (Fin N)) : Set (Fin N))) (hFH : F ≤ H)
    (hFx : ∀ f ∈ F, Matches W f x x) {Fgs : GensData} (hFv : GensData.AllValid N Fgs)
    (hFd : GensData.denote N Fgs = F) {ρ : Perm (Fin N)} {a : AnswerData D}
    (ha : AnsOK DV N W ρ (pointwiseStab H ((phiSet N pΦ : Finset (Fin N)) : Set (Fin N))) x y a) :
    AnsOK DV N W ρ (pointwiseStab H ((phiSet N pΦ : Finset (Fin N)) : Set (Fin N)) ⊔ F) x y
      (augModel O N a Fgs) := by
  rcases a with _ | ⟨τ, A⟩
  · exact c2_iso_sup_empty hW hΦ hFH hFx ha
  · obtain ⟨hτ, hAN, hAv, hiso⟩ := ha
    have hval : GensData.AllValid N (A.gens ++ Fgs) := hAv.1.append hFv
    have hpost := hO .generate (N, A.gens ++ Fgs) rfl hval
    show AnsOK DV N W ρ _ x y (some (τ, O.run GroupOp.generate (N, A.gens ++ Fgs)))
    rcases hH : O.run GroupOp.generate (N, A.gens ++ Fgs) with ⟨N', hs, e⟩
    rw [hH] at hpost
    obtain ⟨hN', hGv, hden⟩ := hpost
    change N' = N at hN'
    subst N'
    refine ⟨hτ, rfl, hGv, ?_⟩
    change PermData.denote N τ • (GensData.denote N hs : Set (Perm (Fin N))) = _
    rw [c2_iso_sup_smul hW hΦ hFH hFx hiso.symm, hden, GensData.denote_append, hFd,
      Subgroup.closure_union, Subgroup.closure_eq, Subgroup.closure_eq]

end Aug

/-! ### Specifications -/

section Specs

variable {D : Ty} {a b : Ty} {X : Ctx (groupSig D)}
  {body : a.denote → Prog (groupSig D) (a, b) Ty.denote b} {DV : ℕ → GensData → D.denote → Prop}

theorem RunsWithin.augProg (hPre : ∀ x, GroupPre DV .generate x → X.Pre .generate x)
    {N L Bg : ℕ} {ans : AnswerData D} {Fgs : GensData}
    (hval : ∀ c, ans = some c → GensData.AllValid N (c.2.gens ++ Fgs))
    (hL : ∀ c, ans = some c → c.2.gens.length ≤ L)
    (hB : ∀ c, ans = some c → X.B.call GroupOp.generate (N, c.2.gens ++ Fgs)
      (X.O.run GroupOp.generate (N, c.2.gens ++ Fgs)) ≤ Bg) :
    RunsWithin X body (Giant.augProg N ans Fgs) (augModel X.O N ans Fgs) (L + Bg + 12) := by
  rcases ans with _ | ⟨τ, n', gs, d⟩
  · exact (RunsWithin.caseOption_none (RunsWithin.prim _ _)).mono (by simp [Prim.cost])
  · have hv : GensData.AllValid N (gs ++ Fgs) := hval _ rfl
    have hl : gs.length ≤ L := hL _ rfl
    have hb := hB _ rfl
    apply RunsWithin.mono
    case h =>
      run_with RunsWithin.caseOption_some _
      run_step (RunsWithin.prim _ _)
      run_step (RunsWithin.prim _ _)
      run_step (RunsWithin.prim _ _)
      run_step (RunsWithin.prim _ _)
      run_step (RunsWithin.prim _ _)
      run_step (RunsWithin.prim _ _)
      run_step (RunsWithin.call (hPre _ hv))
      run_step (RunsWithin.prim _ _)
      exact RunsWithin.prim _ _
    case hc =>
      simp only [Prim.cost, Prim.eval, Args.head]
      have hb' : X.B.call GroupOp.generate (N, gs ++ Fgs)
          (X.O.run GroupOp.generate (N, gs ++ Fgs)) ≤ Bg := hb
      omega

/-- The instances the pullback passes to the sub-solver: windows of at most half of the
window `w` (of `wlen` points), with at most `sIn` generators, inside `G₀`. -/
def PbSubP (DV : ℕ → GensData → D.denote → Prop) {N : ℕ} (G₀ : Subgroup (Perm (Fin N)))
    (xy : StrData × StrData) (wlen sIn : ℕ) (I : InstData D) : Prop :=
  I.1 = xy ∧ I.Valid DV ∧ I.degree = N ∧ 2 * I.2.1.1.length ≤ wlen ∧
    I.2.2.2.gens.length ≤ sIn ∧ GensData.denote N I.2.2.2.gens ≤ G₀

/-- The sequential cost over an orbit partition of `w`. -/
theorem c2_seq_sum_le {N : ℕ} {G : Subgroup (Perm (Fin N))} {w : WinData} {os : List (List ℕ)}
    (hos : IsOrbitPartition G w os) (Cb : ℕ) :
    (os.map (seqCost N fun _ => Cb)).sum ≤ w.1.length * (Cb + 2 * N + 18) := by
  have hne : ∀ o ∈ os, 1 ≤ o.length := fun o ho => by
    have := (hos.2 o ho).1
    exact List.length_pos_iff.2 this
  have hlen : (os.map List.length).sum = w.1.length := by
    rw [← List.length_flatten]
    exact hos.1.length_eq
  have key : ∀ l : List (List ℕ), (∀ o ∈ l, 1 ≤ o.length) →
      (l.map (seqCost N fun _ => Cb)).sum ≤ (l.map List.length).sum * (Cb + 2 * N + 18) := by
    intro l hl
    induction l with
    | nil => simp
    | cons o l ih =>
      simp only [List.map_cons, List.sum_cons]
      have h1 := hl o List.mem_cons_self
      have h2 := ih fun o' ho' => hl o' (List.mem_cons_of_mem _ ho')
      have h3 : seqCost N (fun _ => Cb) o ≤ o.length * (Cb + 2 * N + 18) := by
        unfold seqCost
        nlinarith
      nlinarith [h2, h3]
  rw [← hlen]
  exact key os hne

theorem c2_subSolves_mono {sub : InstData D → Prog (groupSig D) (a, b) Ty.denote (Ty.answer D)}
    {P P' : InstData D → Prop} {C : InstData D → ℕ} {s : ℕ}
    (h : SubSolves X body DV sub P C s) (hPP : ∀ I, P' I → P I) :
    SubSolves X body DV sub P' C s :=
  fun I hI => h I (hPP I hI)

/-- The cost of one branch of the pullback. -/
def pbBranchCost (N s Cb Bg wl : ℕ) : ℕ := 12 * N + 13 + 1 + (1 + wl * (Cb + 2 * N + 18)) +
  (s + Bg + 12)

/-- **One branch**: the answer solves the coset `(σ * r) • (K ⊔ F)`. -/
theorem RunsWithin.pbBranch (hO : MeetsContractOn DV (· = .generate) X.O)
    (hPre : ∀ x, GroupPre DV .generate x → X.Pre .generate x)
    {N s : ℕ} {G₀ : Subgroup (Perm (Fin N))} (B : BackendBounds X DV N s G₀)
    {xy : StrData × StrData} {w : WinData} (hw : w.Valid N)
    {H F : Subgroup (Perm (Fin N))} (hHG₀ : H ≤ G₀) (hWH : IsInvariant H (w.denote N))
    {pΦ : List ℕ} (hΦ : IsInvariant H ((phiSet N pΦ : Finset (Fin N)) : Set (Fin N)))
    (hFH : F ≤ H) (hFx : ∀ f ∈ F, Matches (w.denote N) f (xy.1.denote N) (xy.1.denote N))
    {Fgs : GensData} (hFv : GensData.AllValid N Fgs) (hFd : GensData.denote N Fgs = F)
    {ks : GensData} {ke : D.denote} (hKv : GroupValid DV N ks ke) (hKs : ks.length ≤ s)
    (hKd : GensData.denote N ks = pointwiseStab H {v : Fin N | v.val ∈ pΦ})
    {os : List (List ℕ)} (hos : IsOrbitPartition (GensData.denote N ks) w os)
    (hhalf : ∀ o ∈ os, 2 * o.length ≤ w.1.length)
    {σd r : PermData} (hσ : σd.Valid N) (hr : r.Valid N) {Cb Bg : ℕ}
    (hBg : ∀ gs', GensData.AllValid N gs' → gs'.length ≤ s + Fgs.length →
      GensData.denote N gs' ≤ G₀ →
      X.B.call GroupOp.generate (N, gs') (X.O.run GroupOp.generate (N, gs')) ≤ Bg)
    {sub : InstData D → Prog (groupSig D) (a, b) Ty.denote (Ty.answer D)}
    (hsub : SubSolves X body DV sub (PbSubP DV G₀ xy w.1.length s) (fun _ => Cb) s) :
    ∃ ans : AnswerData D,
      RunsWithin X body (Giant.pbBranch sub xy σd (N, ks, ke) os Fgs N r) ans
        (pbBranchCost N s Cb Bg w.1.length) ∧
      AnsOK DV N (w.denote N) (PermData.denote N (σd.mul r))
        (pointwiseStab H ((phiSet N pΦ : Finset (Fin N)) : Set (Fin N)) ⊔ F)
        (xy.1.denote N) (xy.2.denote N) ans ∧
      ∀ c : CosetData D, ans = some c → c.2.gens.length ≤ s := by
  have hKd' : GensData.denote N ks =
      pointwiseStab H ((phiSet N pΦ : Finset (Fin N)) : Set (Fin N)) := by
    rw [hKd, coe_phiSet]
  have hKH : GensData.denote N ks ≤ H := by rw [hKd]; exact fun _ hk => hk.1
  have hWK : IsInvariant (GensData.denote N ks) (w.denote N) := hWH.mono hKH
  obtain ⟨hosI, hosU⟩ := seqInputs_of_isOrbitPartition hw hos
  have hseq : SeqSub X body DV sub xy N os (fun _ => Cb) s (max s ks.length)
      (GensData.denote N ks) := by
    refine c2_subSolves_mono hsub fun I hI => ?_
    obtain ⟨h1, h2, h3, ⟨o, ho, hwo⟩, h5, h6⟩ := hI
    refine ⟨h1, h2, h3, ?_, h5.trans (by omega), ?_⟩
    · rw [hwo]
      exact hhalf o ho
    · exact h6.trans (hKH.trans hHG₀)
  obtain ⟨a₀, hrun, hok, hgen⟩ := RunsWithin.seqProg (n := N) (Gd := (N, ks, ke))
    (σd := σd.mul r) rfl
    (hσ.mul hr) hKv hosI hseq
  rw [hosU] at hok
  have hok' := c2_ansOK_aug (O := X.O) hO hWH hΦ hFH hFx hFv hFd (by rw [← hKd']; exact hok)
  have hgen' : ∀ c, a₀ = some c → c.2.gens.length ≤ s := fun c hc => (hgen c hc).trans
    (max_le le_rfl hKs)
  have hval : ∀ c, a₀ = some c → GensData.AllValid N (c.2.gens ++ Fgs) := by
    intro c hc
    subst hc
    exact hok.2.2.1.1.append hFv
  have hden : ∀ c, a₀ = some c → GensData.denote N (c.2.gens ++ Fgs) ≤ G₀ := by
    intro c hc
    subst hc
    rw [GensData.denote_append, hFd]
    refine sup_le ?_ (hFH.trans hHG₀)
    have := AnsOK.eq_aut hWK hok
    rw [this]
    exact (aut_le _ _).trans (hKH.trans hHG₀)
  have haug := RunsWithin.augProg (X := X) (body := body) (N := N) (L := s) (Bg := Bg) hPre hval
    hgen' fun c hc => hBg _ (hval c hc) (by rw [List.length_append]; have := hgen' c hc; omega)
      (hden c hc)
  refine ⟨augModel X.O N a₀ Fgs, ?_, hok', ?_⟩
  · unfold Giant.pbBranch
    apply RunsWithin.mono
    case h =>
      run_step (RunsWithin.permMul hσ hr)
      run_step (RunsWithin.prim _ _)
      run_step hrun
      exact haug
    case hc =>
      have := c2_seq_sum_le hos Cb
      simp only [Prim.cost, pbBranchCost]
      omega
  · intro c hc
    rcases a₀ with _ | ⟨τ, n', gs, d⟩
    · cases hc
    · have hv := hval (τ, n', gs, d) rfl
      have hd := hden (τ, n', gs, d) rfl
      have hc' : c = (τ, X.O.run GroupOp.generate (N, gs ++ Fgs)) := (Option.some.inj hc).symm
      subst hc'
      exact B.genOut _ hv hd

/-- The backend operations of the pullback. -/
def pbOps (op : GroupOp) : Prop :=
  op = .stabilizer ∨ op = .orbitTransversal ∨ op = .orbits ∨ op = .generate

/-- The cost of the pullback: `p` positions of `Φ`, `h` generators of `H`, a window of `wl`
points, sub-calls of cost `Cb`, the backend charges `Bstab`, `Borb`, `Bgen`. -/
def pbCost (N s Cb Bstab Borb Bgen p h wl : ℕ) : ℕ :=
  p * (Bstab + 2) + Borb + 2 * N + 20 + (h + 1) * (pbBranchCost N s Cb Bgen wl + 3) +
    ((h + 1) * (12 * N + s + 26) + Bgen + 16)

/-- **The pullback** (Case 2a). On the coset `σ • H`: if `H` leaves the positions `pΦ` and the
window invariant, `F = ⟨Fgs⟩ ≤ H` preserves `x` on the window and realizes every even
permutation of `Φ`, and the orbits of the pointwise stabilizer of `Φ` on the window have at most
half of its points, the answer is correct, given a sub-solver correct on windows of at most half
of the window. -/
theorem RunsWithin.pullbackProg (hO : MeetsContractOn DV pbOps X.O)
    (hPre : ∀ op x, pbOps op → GroupPre DV op x → X.Pre op x)
    {N s : ℕ} {G₀ : Subgroup (Perm (Fin N))} (B : BackendBounds X DV N s G₀)
    {xy : StrData × StrData} {w : WinData} (hw : w.Valid N)
    {σd : PermData} (hσ : σd.Valid N) {hgs : GensData} {hd : D.denote}
    (hHv : GroupValid DV N hgs hd) (hHs : hgs.length ≤ s)
    (hHG₀ : GensData.denote N hgs ≤ G₀)
    (hWH : IsInvariant (GensData.denote N hgs) (w.denote N))
    {pΦ : List ℕ} (hpΦ : ∀ u ∈ pΦ, u < N)
    (hΦ : IsInvariant (GensData.denote N hgs) ((phiSet N pΦ : Finset (Fin N)) : Set (Fin N)))
    {Fgs : GensData} (hFv : GensData.AllValid N Fgs)
    (hFH : GensData.denote N Fgs ≤ GensData.denote N hgs)
    (hFx : ∀ f ∈ GensData.denote N Fgs,
      Matches (w.denote N) f (xy.1.denote N) (xy.1.denote N))
    (hFalt : ∀ π : Perm (phiSet N pΦ), Perm.sign π = 1 →
      ∃ f ∈ GensData.denote N Fgs, ∀ v : phiSet N pΦ, f v = π v)
    (hhalf : ∀ os, IsOrbitPartition (pointwiseStab (GensData.denote N hgs)
      {v : Fin N | v.val ∈ pΦ}) w os → ∀ o ∈ os, 2 * o.length ≤ w.1.length)
    {Cb Bgen : ℕ}
    (hBg : ∀ gs', GensData.AllValid N gs' →
      gs'.length ≤ (hgs.length + 1) * (s + 1) + s + Fgs.length → GensData.denote N gs' ≤ G₀ →
      X.B.call GroupOp.generate (N, gs') (X.O.run GroupOp.generate (N, gs')) ≤ Bgen)
    {sub : InstData D → Prog (groupSig D) (a, b) Ty.denote (Ty.answer D)}
    (hsub : SubSolves X body DV sub (PbSubP DV G₀ xy w.1.length s) (fun _ => Cb) s) :
    ∃ ans : AnswerData D,
      RunsWithin X body (Giant.pullbackProg sub xy w (σd, (N, hgs, hd)) Fgs pΦ) ans
        (pbCost N s Cb B.Bstab B.Borb Bgen pΦ.length hgs.length w.1.length) ∧
      AnsOK DV N (w.denote N) (PermData.denote N σd) (GensData.denote N hgs)
        (xy.1.denote N) (xy.2.denote N) ans ∧
      ∀ c : CosetData D, ans = some c → c.2.gens.length ≤ s := by
  set Hd := GensData.denote N hgs with hHd
  set Fd := GensData.denote N Fgs with hFd
  have hstO : MeetsContractOn DV stabOps X.O := fun op x h hx => hO op x (by
    rcases h with h | h
    · exact Or.inl h
    · exact Or.inr (Or.inl h)) hx
  have hstP : ∀ op x, stabOps op → GroupPre DV op x → X.Pre op x := fun op x h hx =>
    hPre op x (by
      rcases h with h | h
      · exact Or.inl h
      · exact Or.inr (Or.inl h)) hx
  have hgO : MeetsContractOn DV (· = .generate) X.O := fun op x h hx =>
    hO op x (Or.inr (Or.inr (Or.inr h))) hx
  have hgP : ∀ x, GroupPre DV .generate x → X.Pre .generate x := fun x hx =>
    hPre _ x (Or.inr (Or.inr (Or.inr rfl))) hx
  -- `K`
  obtain ⟨hKrun, hKN, hKv, hKden⟩ :=
    RunsWithin.iterStabProg (body := body) hstO hstP hHv hpΦ B hHs hHG₀
  have hKs := CertProg.iterStab_gens_le hstO B pΦ (N, hgs, hd) hpΦ rfl hHv hHs hHG₀
  rcases hKm : iterStabModel X.O (N, hgs, hd) pΦ with ⟨N', ks, ke⟩
  rw [hKm] at hKrun hKN hKv hKden hKs
  change N' = N at hKN
  subst N'
  change GensData.denote N ks = pointwiseStab Hd {v : Fin N | v.val ∈ pΦ} at hKden
  change ks.length ≤ s at hKs
  have hKH : GensData.denote N ks ≤ Hd := by rw [hKden]; exact fun _ hk => hk.1
  have hWK : IsInvariant (GensData.denote N ks) (w.denote N) := hWH.mono hKH
  -- the orbits of `K`
  have hopre : GroupPre DV .orbits ((N, ks, ke), w) := ⟨hKv, hw, hWK⟩
  have hos : IsOrbitPartition (GensData.denote N ks) w (X.O.run GroupOp.orbits ((N, ks, ke), w)) :=
    hO .orbits _ (Or.inr (Or.inr (Or.inl rfl))) hopre
  have hBo := B.orbits ks ke w hKs (hKH.trans hHG₀) hopre
  set os : List (List ℕ) := X.O.run GroupOp.orbits ((N, ks, ke), w) with hosdef
  have hhalf' : ∀ o ∈ os, 2 * o.length ≤ w.1.length := hhalf os (by rw [← hKden]; exact hos)
  -- the branches
  set rs : List PermData := PermData.one N :: hgs with hrs
  have hrsv : ∀ r ∈ rs, r.Valid N := by
    intro r hr
    rcases List.mem_cons.1 hr with rfl | hr
    · exact PermData.valid_one N
    · exact hHv.1 r hr
  have hFH' : Fd ≤ Hd := hFH
  have hbr : ∀ r ∈ rs, ∃ v : AnswerData D,
      RunsWithin X body (Giant.pbBranch sub xy σd (N, ks, ke) os Fgs N r) v
        (pbBranchCost N s Cb Bgen w.1.length) ∧
      (AnsOK DV N (w.denote N) (PermData.denote N (σd.mul r))
        (pointwiseStab Hd ((phiSet N pΦ : Finset (Fin N)) : Set (Fin N)) ⊔ Fd)
        (xy.1.denote N) (xy.2.denote N) v ∧
        ∀ c : CosetData D, v = some c → c.2.gens.length ≤ s) := by
    intro r hr
    obtain ⟨v, hv, hok, hg⟩ := RunsWithin.pbBranch (X := X) (body := body) hgO hgP B hw hHG₀
      hWH hΦ hFH' hFx hFv rfl hKv hKs hKden hos hhalf' hσ (hrsv r hr)
      (fun gs' hv hl hle => hBg gs' hv (by nlinarith) hle) hsub
    exact ⟨v, hv, hok, hg⟩
  obtain ⟨as, has_run, has⟩ := RunsWithin.mapList_exists (X := X) (body := body)
    (a' := Ty.perm) (b' := Ty.answer D) hbr
  have hlen : as.length = rs.length := has.length_eq.symm
  -- the cover
  have hcov := c2_cover (H := Hd) (F := Fd) (pΦ := pΦ) hΦ hFH' hFalt
    (R := rs.map (PermData.denote N)) (by simp [hrs]) (by
      rw [hHd, GensData.denote]
      apply le_antisymm
      · apply Subgroup.closure_mono
        rintro g ⟨h, hh, rfl⟩
        exact List.mem_map.2 ⟨h, List.mem_cons_of_mem _ hh, rfl⟩
      · rw [Subgroup.closure_le]
        intro g hg
        obtain ⟨r, hr, rfl⟩ := List.mem_map.1 hg
        rcases List.mem_cons.1 hr with rfl | hr
        · simp only [PermData.denote_one, SetLike.mem_coe]
          exact one_mem _
        · exact Subgroup.subset_closure ⟨r, hr, rfl⟩)
  have hRmem : ∀ r ∈ rs, PermData.denote N r ∈ Hd := by
    intro r hr
    rcases List.mem_cons.1 hr with rfl | hr
    · simp only [PermData.denote_one]
      exact one_mem _
    · exact GensData.mem_denote_of_mem hr
  have hcover : IsLeftCover Hd
      (pointwiseStab Hd ((phiSet N pΦ : Finset (Fin N)) : Set (Fin N)) ⊔ Fd)
      fun i : Fin (rs.map (PermData.denote N)).length => (rs.map (PermData.denote N)).get i := by
    refine ⟨fun i => ?_, fun g hg => ?_⟩
    · obtain ⟨r, hr, e⟩ := List.mem_map.1 (List.get_mem (rs.map (PermData.denote N)) i)
      rw [← e]
      exact hRmem r hr
    · obtain ⟨ρ, hρ, hk⟩ := hcov g hg
      obtain ⟨i, rfl⟩ := List.get_of_mem hρ
      exact ⟨i, hk⟩
  have hKF : pointwiseStab Hd ((phiSet N pΦ : Finset (Fin N)) : Set (Fin N)) ⊔ Fd ≤ Hd :=
    c2_sup_le hFH'
  have hok := AnsOK.combineModel (O := X.O) hgO hWH hKF hσ hrsv hcover (has.imp fun _ _ h => h.1)
  have hmem : ∀ c ∈ branchSuccesses as, (c.1.Valid N ∧ GensData.AllValid N c.2.gens) ∧
      c.2.gens.length ≤ s := by
    intro c hc
    obtain ⟨r, -, hok', hg⟩ := exists_of_forall₂_mem has (mem_branchSuccesses.1 hc)
    exact ⟨⟨hok'.1, hok'.2.2.1.1⟩, hg c rfl⟩
  have hcg : ∀ c₀ rest, branchSuccesses as = c₀ :: rest →
      GensData.AllValid N (combineGens c₀.1 (c₀ :: rest)) ∧
      (combineGens c₀.1 (c₀ :: rest)).length ≤ rs.length * (s + 1) ∧
      GensData.denote N (combineGens c₀.1 (c₀ :: rest)) ≤ Hd := by
    intro c₀ rest hss
    have hv₀ := (hmem c₀ (by rw [hss]; exact List.mem_cons_self)).1
    have hgv : GensData.AllValid N (combineGens c₀.1 (c₀ :: rest)) := by
      rw [combineGens]
      refine allValid_branchGens hv₀.1.inv fun p hp => ?_
      obtain ⟨c, hc, rfl⟩ := List.mem_map.1 hp
      exact (hmem c (by rw [hss]; exact hc)).1
    refine ⟨hgv, ?_, ?_⟩
    · rw [length_combineGens]
      have hsum : ((c₀ :: rest).map fun c => c.2.gens.length).sum ≤ (c₀ :: rest).length * s :=
        sum_map_le _ _ _ fun c hc => (hmem c (by rw [hss]; exact hc)).2
      have hk : (c₀ :: rest).length ≤ rs.length := by
        rw [← hss, ← hlen]; exact List.length_filterMap_le _ _
      simp only [List.length_cons, Nat.add_sub_cancel] at hsum hk ⊢
      nlinarith
    · have hpost := hgO .generate (N, combineGens c₀.1 (c₀ :: rest)) rfl hgv
      have hok' := hok
      unfold combineModel at hok'
      rw [hss] at hok'
      dsimp only at hok'
      rcases hH : X.O.run GroupOp.generate (N, combineGens c₀.1 (c₀ :: rest)) with ⟨n', hs', e'⟩
      rw [hH] at hpost hok'
      obtain ⟨-, -, hden⟩ := hpost
      have haut := AnsOK.eq_aut hWH hok'
      change GensData.denote N hs' = _ at haut
      change GensData.denote N hs' = GensData.denote N (combineGens c₀.1 (c₀ :: rest)) at hden
      rw [← hden, haut]
      exact aut_le _ _
  have hrsl : rs.length = hgs.length + 1 := by simp [hrs]
  have hcomb := RunsWithin.combineProg (X := X) (body := body) (n := N) (Bgen := Bgen) hgP
    (fun c hc => (hmem c hc).1) (fun c hc => (hmem c hc).2) fun c₀ rest hss =>
      hBg _ (hcg c₀ rest hss).1 (by have := (hcg c₀ rest hss).2.1; rw [hrsl] at this; omega)
        ((hcg c₀ rest hss).2.2.trans hHG₀)
  have hcl := combineCost_le (n := N) (Bgen := Bgen) (as := as) (fun c hc => (hmem c hc).2)
  refine ⟨combineModel X.O N as, ?_, hok, ?_⟩
  · unfold Giant.pullbackProg
    apply RunsWithin.mono
    case h =>
      run_step (RunsWithin.prim _ _)
      run_step (RunsWithin.prim _ _)
      run_step (RunsWithin.prim _ _)
      run_step hKrun
      run_step (RunsWithin.prim _ _)
      run_step (RunsWithin.call (hPre _ _ (Or.inr (Or.inr (Or.inl rfl))) hopre))
      run_step (RunsWithin.prim _ _)
      run_step (RunsWithin.prim _ _)
      run_step (RunsWithin.permOne N)
      run_step (RunsWithin.prim _ _)
      run_step has_run
      exact hcomb
    case hc =>
      rw [hlen, hrsl] at hcl
      simp only [Prim.cost, pbCost, hrsl]
      have hBo' : X.B.call GroupOp.orbits
          (Prim.pair.eval (Args.cons (N, ks, ke) (Args.cons w Args.nil)))
          (X.O.run GroupOp.orbits (Prim.pair.eval (Args.cons (N, ks, ke) (Args.cons w Args.nil))))
          ≤ B.Borb := hBo
      linarith
  · intro sGen hc
    unfold combineModel at hc
    split at hc
    · cases hc
    · rename_i c₀ rest hss
      cases hc
      exact B.genOut _ (hcg c₀ rest hss).1 ((hcg c₀ rest hss).2.2.trans hHG₀)

end Specs

/-! ### The half-window bound from the labels -/

section Labels

/-- **The orbits of `K` have at most half of the window** (`card_orbit_le_half`): for a giant base
action, labels on the window that are equivariant `t`-subsets with `1 ≤ t ≤ m/2`, and `Φ` of
more than half of the base, the orbits on the window of any subgroup of `G` fixing `Φ`'s
positions pointwise have at most half of the window's points. -/
theorem c2_hhalf_of_labels {n N : ℕ} {G : Subgroup (Perm (Fin N))}
    (hG : IsInvariant G (baseSet n N))
    (hgiant : alternatingGroup (Fin (N - n)) ≤ (baseHom G n hG).range) (h3 : 3 ≤ N - n)
    {w : WinData} (hw : w.Valid N) (hWG : IsInvariant G (w.denote N))
    {lab : Fin N → Finset (Fin (N - n))}
    (he : Recursion.Equivar (baseHom G n hG) (winFinset N w) lab)
    {t : ℕ} (ht : ∀ u ∈ winFinset N w, (lab u).card = t) (ht1 : 1 ≤ t) (ht2 : 2 * t ≤ N - n)
    {Φl : List ℕ} (hΦl : Φl.Nodup ∧ ∀ i ∈ Φl, i < N - n) (hΦ : N - n < 2 * Φl.length)
    {H : Subgroup (Perm (Fin N))} (hHG : H ≤ G) :
    ∀ os, IsOrbitPartition (pointwiseStab H {v : Fin N | v.val ∈ Φl.map (n + ·)}) w os →
      ∀ o ∈ os, 2 * o.length ≤ w.1.length := by
  intro os hos o ho
  have hosI := (seqInputs_of_isOrbitPartition hw hos).1 o ho
  obtain ⟨hne, hsame⟩ := hos.2 o ho
  obtain ⟨i0, hi0⟩ := List.exists_mem_of_ne_nil o hne
  have hi0N : i0 < N := hosI.2.1 i0 hi0
  have how : ∀ i ∈ o, i ∈ w.1 := fun i hi =>
    hos.1.mem_iff.1 (List.mem_flatten.2 ⟨o, ho, hi⟩)
  have hWinv : Recursion.Invariant G (winFinset N w) := by
    intro g u hu
    rw [mem_winFinset] at hu ⊢
    exact hWG g.1 g.2 u hu
  set K' : Subgroup G :=
    (pointwiseStab H {v : Fin N | v.val ∈ Φl.map (n + ·)}).comap G.subtype with hK'
  have hK : ∀ k ∈ K', ∀ γ ∈ SoJProg.setOf (N - n) Φl, baseHom G n hG k γ = γ := by
    intro k hk γ hγ
    have hk' : (k : Perm (Fin N)) ∈ pointwiseStab H {v : Fin N | v.val ∈ Φl.map (n + ·)} := hk
    have hfix := hk'.2 (basePos γ)
      (show n + γ.val ∈ Φl.map (n + ·) from List.mem_map.2 ⟨γ.val, SoJProg.mem_setOf.1 hγ, rfl⟩)
    have h := baseHom_apply (hG := hG) k γ
    rw [hfix] at h
    apply Fin.ext
    have := congrArg Fin.val h
    simp only [basePos] at this
    omega
  have hO := Recursion.card_orbit_le_half (M := G) hgiant (by simpa using h3) hWinv he ht ht1
    (by simpa using ht2) (Φ := SoJProg.setOf (N - n) Φl)
    (by rw [Fintype.card_fin, SoJProg.card_setOf hΦl.1 hΦl.2]; exact hΦ) K' hK
    (u := ⟨i0, hi0N⟩) (by rw [mem_winFinset]; exact how i0 hi0) (O := SoJProg.setOf N o)
    (fun v hv => by
      rw [mem_winFinset]
      exact how _ (SoJProg.mem_setOf.1 hv))
    (fun v hv => by
      obtain ⟨hi, hj, g, hg, hgv⟩ := (hsame i0 hi0 v.val).1 (SoJProg.mem_setOf.1 hv)
      refine ⟨⟨g, hHG hg.1⟩, hg, ?_⟩
      rw [Subgroup.smul_def, Perm.smul_def]
      exact hgv.trans (Fin.ext rfl))
  rw [SoJProg.card_setOf hosI.1 hosI.2.1] at hO
  have hWc : (winFinset N w).card = w.1.length := SoJProg.card_setOf hw.nodup hw.lt
  rw [hWc] at hO
  exact hO

end Labels

/-! ### Canonicity of the large orbit -/

section Canonical

variable {N n : ℕ}

/-- Orbits of the base action: `c` is in the orbit of `b` exactly when some element of `F` maps
the position of `b` to that of `c`. -/
theorem c2_mem_orbit_range {F : Subgroup (Perm (Fin N))} (hF : IsInvariant F (baseSet n N))
    (b c : Fin (N - n)) :
    c ∈ MulAction.orbit (baseHom F n hF).range b ↔ ∃ f ∈ F, f (basePos b) = basePos c := by
  rw [MulAction.mem_orbit_iff]
  constructor
  · rintro ⟨⟨_, ⟨f, rfl⟩⟩, hc⟩
    refine ⟨f.1, f.2, ?_⟩
    rw [← baseHom_apply (hG := hF)]
    exact congrArg basePos hc
  · rintro ⟨f, hf, hc⟩
    refine ⟨⟨_, ⟨f, hf⟩, rfl⟩, ?_⟩
    apply Fin.ext
    have h := baseHom_apply (hG := hF) ⟨f, hf⟩ b
    rw [hc] at h
    have := congrArg Fin.val h
    simp only [basePos] at this
    show (baseHom F n hF ⟨f, hf⟩ b).val = c.val
    omega

/-- A list listing exactly an orbit has the orbit's size as its length. -/
theorem c2_card_orbit_eq {P : Subgroup (Perm (Fin (N - n)))} {Φ : List ℕ} (hΦn : Φ.Nodup)
    (hΦl : ∀ i ∈ Φ, i < N - n) {γ : Fin (N - n)}
    (hγ : ∀ δ : Fin (N - n), δ.val ∈ Φ ↔ δ ∈ MulAction.orbit P γ) :
    Nat.card (MulAction.orbit P γ) = Φ.length := by
  have hset : MulAction.orbit P γ = ((SoJProg.setOf (N - n) Φ : Finset (Fin (N - n))) : Set _) := by
    ext δ
    rw [Finset.mem_coe, SoJProg.mem_setOf, hγ]
  rw [hset, Nat.card_coe_set_eq, Set.ncard_coe_finset, SoJProg.card_setOf hΦn hΦl]

/-- **The unique large orbit is canonical.** If `F` is a canonical map of the strings into
subgroups of `G` (local on the window `W`, and `F (relabel g x) = g F(x) g⁻¹`), every
isomorphism `g` of `x` with `y` carries the orbit of more than half of the base of `ψ(F(x))`
onto that of `ψ(F(y))` (`large_orbit_unique`). -/
theorem largeOrbit_canonical {G : Subgroup (Perm (Fin N))} (hG : IsInvariant G (baseSet n N))
    {W : Set (Fin N)} (hW : IsInvariant G W) {Fmap : (Fin N → ℕ) → Subgroup (Perm (Fin N))}
    (hloc : ∀ x x', (∀ u ∈ W, x u = x' u) → Fmap x = Fmap x')
    (heq : ∀ g ∈ G, ∀ x, Fmap (relabel g x) = (Fmap x).map (MulAut.conj g).toMonoidHom)
    {x y : Fin N → ℕ} {Fx Fy : Subgroup (Perm (Fin N))} (hFxe : Fx = Fmap x)
    (hFye : Fy = Fmap y) (hFx : IsInvariant Fx (baseSet n N)) (hFy : IsInvariant Fy (baseSet n N))
    {g : Perm (Fin N)} (hg : g ∈ iso W 1 G x y) {Φx Φy : List ℕ}
    (hΦxn : Φx.Nodup) (hΦxl : ∀ i ∈ Φx, i < N - n) (hΦx2 : N - n < 2 * Φx.length)
    (hΦxo : ∃ γ : Fin (N - n), γ.val ∈ Φx ∧
      ∀ δ : Fin (N - n), δ.val ∈ Φx ↔ δ ∈ MulAction.orbit (baseHom Fx n hFx).range γ)
    (hΦyn : Φy.Nodup) (hΦyl : ∀ i ∈ Φy, i < N - n) (hΦy2 : N - n < 2 * Φy.length)
    (hΦyo : ∃ γ : Fin (N - n), γ.val ∈ Φy ∧
      ∀ δ : Fin (N - n), δ.val ∈ Φy ↔ δ ∈ MulAction.orbit (baseHom Fy n hFy).range γ) :
    baseHom G n hG ⟨g, (mem_iso_one.1 hg).1⟩ • SoJProg.setOf (N - n) Φx =
      SoJProg.setOf (N - n) Φy := by
  have hgG : g ∈ G := (mem_iso_one.1 hg).1
  have hy : Fy = Fx.map (MulAut.conj g).toMonoidHom := by
    rw [hFye, hFxe, ← heq g hgG x]
    exact (hloc _ _ (Recursion.relabel_eq_on_of_mem_iso hW hg)).symm
  set σ := baseHom G n hG ⟨g, hgG⟩ with hσ
  have hfwd : ∀ j, basePos (σ j) = g (basePos j) := fun j => baseHom_apply (hG := hG) ⟨g, hgG⟩ j
  have hinv : ∀ j, basePos (σ⁻¹ j) = g⁻¹ (basePos j) := fun j => by
    rw [hσ, ← map_inv]
    exact baseHom_apply (hG := hG) ⟨g, hgG⟩⁻¹ j
  -- the orbits of `ψ(F(y))` are the images of those of `ψ(F(x))`
  have hconj : ∀ γ δ : Fin (N - n), δ ∈ MulAction.orbit (baseHom Fy n hFy).range (σ γ) ↔
      σ⁻¹ δ ∈ MulAction.orbit (baseHom Fx n hFx).range γ := by
    intro γ δ
    rw [c2_mem_orbit_range hFy, c2_mem_orbit_range hFx, hfwd, hinv]
    constructor
    · rintro ⟨f', hf', he⟩
      rw [hy] at hf'
      obtain ⟨f, hf, rfl⟩ := Subgroup.mem_map.1 hf'
      refine ⟨f, hf, ?_⟩
      simp only [MulEquiv.coe_toMonoidHom, MulAut.conj_apply, Perm.mul_apply,
        perm_inv_apply_self] at he
      rw [← he, perm_inv_apply_self]
    · rintro ⟨f, hf, he⟩
      refine ⟨g * f * g⁻¹, ?_, ?_⟩
      · rw [hy]
        exact Subgroup.mem_map.2 ⟨f, hf, rfl⟩
      · rw [Perm.mul_apply, Perm.mul_apply, perm_inv_apply_self, he, perm_apply_inv_self]
  obtain ⟨γx, -, hx⟩ := hΦxo
  obtain ⟨γy, -, hyo⟩ := hΦyo
  have hcx := c2_card_orbit_eq hΦxn hΦxl hx
  have hcy := c2_card_orbit_eq hΦyn hΦyl hyo
  have hcσ : Nat.card (MulAction.orbit (baseHom Fy n hFy).range (σ γx)) =
      Nat.card (MulAction.orbit (baseHom Fx n hFx).range γx) := by
    refine Nat.card_congr
      { toFun := fun δ => ⟨σ⁻¹ δ.1, (hconj γx δ.1).1 δ.2⟩
        invFun := fun ε => ⟨σ ε.1, (hconj γx (σ ε.1)).2 (by simp [ε.2])⟩
        left_inv := fun δ => by ext; simp
        right_inv := fun ε => by ext; simp }
  have huniq := Certificates.large_orbit_unique (baseHom Fy n hFy).range (γ := σ γx) (δ := γy)
    (by rw [Fintype.card_fin, hcσ, hcx]; exact hΦx2) (by rw [Fintype.card_fin, hcy]; exact hΦy2)
  ext δ
  rw [← Finset.inv_smul_mem_iff, SoJProg.mem_setOf, SoJProg.mem_setOf, Perm.smul_def, hx,
    hyo, ← huniq, hconj]

/-- The large orbit of `ψ(F)` is invariant under `F`. -/
theorem c2_orbit_stable {G F : Subgroup (Perm (Fin N))} (hG : IsInvariant G (baseSet n N))
    (hF : IsInvariant F (baseSet n N)) (hFG : F ≤ G) {Φ : List ℕ} {γ : Fin (N - n)}
    (hγ : ∀ δ : Fin (N - n), δ.val ∈ Φ ↔ δ ∈ MulAction.orbit (baseHom F n hF).range γ)
    {f : Perm (Fin N)} (hf : f ∈ F) :
    baseHom G n hG ⟨f, hFG hf⟩ • SoJProg.setOf (N - n) Φ = SoJProg.setOf (N - n) Φ := by
  have key : ∀ f (hf : f ∈ F), ∀ δ, δ ∈ MulAction.orbit (baseHom F n hF).range γ →
      baseHom G n hG ⟨f, hFG hf⟩ δ ∈ MulAction.orbit (baseHom F n hF).range γ := by
    intro f hf δ hδ
    rw [c2_mem_orbit_range hF] at hδ ⊢
    obtain ⟨f₀, hf₀, he⟩ := hδ
    refine ⟨f * f₀, mul_mem hf hf₀, ?_⟩
    rw [Perm.mul_apply, he, baseHom_apply (hG := hG)]
  ext δ
  rw [← Finset.inv_smul_mem_iff, SoJProg.mem_setOf, SoJProg.mem_setOf, Perm.smul_def, hγ, hγ]
  constructor
  · intro h
    have := key f hf _ h
    simpa using this
  · intro h
    have := key f⁻¹ (inv_mem hf) δ h
    rwa [show (⟨f⁻¹, hFG (inv_mem hf)⟩ : G) = (⟨f, hFG hf⟩ : G)⁻¹ from rfl, map_inv] at this

end Canonical

/-! ### The aligned group `G₁` -/

section G1

variable {D : Ty} {a b : Ty} {X : Ctx (groupSig D)}
  {body : a.denote → Prog (groupSig D) (a, b) Ty.denote b} {DV : ℕ → GensData → D.denote → Prop}

/-- The group `G₁ = ψ⁻¹(Stab(X₀) ∩ P)` that Align passes to its sub-solver, as computed. -/
def g1Model {τ O : Type} {m : ℕ} [MulAction (Perm (Fin m)) O] (Ox : Oracle (groupSig D))
    (n : ℕ) (G : GroupData D.denote) (S : StructOps m τ O) (X₀ : τ) : GroupData D.denote :=
  preModel Ox n G (stabInPL (flagsModel Ox (pModel Ox n G) (S.gens X₀)))

/-- **The aligned group**: degree, validity, denotation (the preimage of the stabilizer) and the
generator bound. -/
theorem c2_g1_spec {τ O : Type} {n N : ℕ} [MulAction (Perm (Fin (N - n))) O]
    (hO : MeetsContractOn DV alignOps X.O)
    (hPre : ∀ op x, alignOps op → GroupPre DV op x → X.Pre op x)
    {s : ℕ} {G₀ : Subgroup (Perm (Fin N))} (B : BackendBounds X DV N s G₀)
    {gs : GensData} {d : D.denote} (hGv : GroupValid DV N gs d)
    (hGG₀ : GensData.denote N gs ≤ G₀)
    (hG : IsInvariant (GensData.denote N gs) (baseSet n N))
    (halt : alternatingGroup (Fin (N - n)) ≤ (baseHom _ n hG).range)
    {S : StructOps (N - n) τ O} {Valid : τ → Prop} (hS : S.Spec Valid) {X₀ : τ} (hX : Valid X₀)
    {Bl : ℕ} (hBl : ∀ π : PermData, X.B.call GroupOp.lift ((N, gs, d), (baseWin n N, π))
      (liftModel X.O n (N, gs, d) π) ≤ Bl) :
    (g1Model X.O n (N, gs, d) S X₀).1 = N ∧
      GroupValid DV N (g1Model X.O n (N, gs, d) S X₀).2.1 (g1Model X.O n (N, gs, d) S X₀).2.2 ∧
      GensData.denote N (g1Model X.O n (N, gs, d) S X₀).2.1 =
        ((MulAction.stabilizer (Perm (Fin (N - n))) (S.dec X₀)).comap
          (baseHom _ n hG)).map (GensData.denote N gs).subtype ∧
      (g1Model X.O n (N, gs, d) S X₀).2.1.length ≤ s := by
  have hgenO : MeetsContractOn DV (· = .generate) X.O := fun op x h hx => hO op x (Or.inl h) hx
  have hmemO : MeetsContractOn DV (· = .mem) X.O :=
    fun op x h hx => hO op x (Or.inr (Or.inl h)) hx
  have hliftO : MeetsContractOn DV liftOps X.O :=
    fun op x h hx => hO op x (Or.inr (Or.inr (Or.inr h))) hx
  have hliftP : ∀ op x, liftOps op → GroupPre DV op x → X.Pre op x :=
    fun op x h hx => hPre op x (Or.inr (Or.inr (Or.inr h))) hx
  -- `P`
  have hpv := allValid_baseGens hG hGv.1
  have hpost := hgenO .generate (N - n, gs.map (baseD n N)) rfl hpv
  have hPm : pModel X.O n (N, gs, d) = X.O.run GroupOp.generate (N - n, gs.map (baseD n N)) :=
    rfl
  rcases hPr : X.O.run GroupOp.generate (N - n, gs.map (baseD n N)) with ⟨m', ps, e⟩
  rw [hPr] at hpost hPm
  obtain ⟨hm', hPv, hPden⟩ := hpost
  change m' = N - n at hm'
  subst hm'
  change GensData.denote (N - n) ps = GensData.denote (N - n) (gs.map (baseD n N)) at hPden
  rw [denote_baseGens hG hGv.1] at hPden
  -- the flags
  have hgXv : GensData.AllValid (N - n) (S.gens X₀) := hS.gens_valid X₀ hX
  set gfs := flagsModel X.O (N - n, ps, e) (S.gens X₀) with hgfs_def
  have hf : FlagsOK (N - n) (GensData.denote (N - n) ps) gfs := flagsOK_flagsModel hmemO hPv hgXv
  have hgfs : gfs.map Prod.fst = S.gens X₀ := by
    simp [hgfs_def, flagsModel, Function.comp_def]
  have hP2 : OutMulIn (GensData.denote (N - n) ps) := by
    rw [hPden]
    exact outMulIn_of_alt_le halt
  set Ls := stabInPL gfs with hLs_def
  have hLcl : Subgroup.closure (denSet (N - n) Ls) =
      MulAction.stabilizer (Perm (Fin (N - n))) (S.dec X₀) ⊓ (baseHom _ n hG).range := by
    have hcl := hS.gens_closure X₀ hX
    change Subgroup.closure (denSet (N - n) (S.gens X₀)) = _ at hcl
    rw [hLs_def, closure_stabInPL hP2 hf, hgfs, hcl, hPden]
  have hLs : ∀ π ∈ Ls, π.Valid (N - n) ∧
      PermData.denote (N - n) π ∈ (baseHom (GensData.denote N gs) n hG).range := by
    intro π hπ
    refine ⟨stabInPL_valid hf π hπ, ?_⟩
    have : PermData.denote (N - n) π ∈ Subgroup.closure (denSet (N - n) Ls) :=
      Subgroup.subset_closure ⟨π, hπ, rfl⟩
    rw [hLcl] at this
    exact this.2
  have hg1 : g1Model X.O n (N, gs, d) S X₀ = preModel X.O n (N, gs, d) Ls := by
    rw [g1Model, hPm]
  -- the kernel and the lifts
  have hkpre : GroupPre DV .kernel ((N, gs, d), baseWin n N) :=
    ⟨hGv, baseWin_valid n N, by rw [baseWin_denote]; exact hG⟩
  have hkpost := hO .kernel _ (Or.inr (Or.inr (Or.inl rfl))) hkpre
  have hKm : kerModel X.O n (N, gs, d) = X.O.run GroupOp.kernel ((N, gs, d), baseWin n N) := rfl
  rcases hK : X.O.run GroupOp.kernel ((N, gs, d), baseWin n N) with ⟨N', ks, ek⟩
  rw [hK] at hkpost hKm
  obtain ⟨hN', hKv, hKden⟩ := hkpost
  change N' = N at hN'
  subst N'
  have hlift : ∀ π ∈ Ls, PermData.Valid N (liftModel X.O n (N, gs, d) π) ∧
      PermData.denote N (liftModel X.O n (N, gs, d) π) ∈ GensData.denote N gs := by
    intro π hπ
    obtain ⟨-, hv, hm, -⟩ := RunsWithin.liftProg (a := .unit) (b := .unit)
      (body := fun _ => .ret ()) hliftO hliftP hGv hG
      (hLs π hπ).1 (hLs π hπ).2 (hBl π)
    exact ⟨hv, hm⟩
  set all := Ls.map (liftModel X.O n (N, gs, d)) ++ ks with hall
  have hallv : GensData.AllValid N all := by
    intro g hg
    rcases List.mem_append.1 hg with hg | hg
    · obtain ⟨π, hπ, rfl⟩ := List.mem_map.1 hg
      exact (hlift π hπ).1
    · exact hKv.1 g hg
  have hallG : GensData.denote N all ≤ GensData.denote N gs := by
    rw [GensData.denote_le_iff]
    intro g hg
    rcases List.mem_append.1 hg with hg | hg
    · obtain ⟨π, hπ, rfl⟩ := List.mem_map.1 hg
      exact (hlift π hπ).2
    · have : PermData.denote N g ∈ GensData.denote N ks := GensData.mem_denote_of_mem hg
      change GensData.denote N ks = _ at hKden
      rw [hKden] at this
      exact this.1
  have hpm : preModel X.O n (N, gs, d) Ls = X.O.run GroupOp.generate (N, all) := by
    rw [preModel, hKm]
  have hlen := B.genOut all hallv (hallG.trans hGG₀)
  have hpreO : MeetsContractOn DV preOps X.O := fun op x h hx => hO op x (by
    rcases h with h | h | h
    · exact Or.inr (Or.inr (Or.inl h))
    · exact Or.inr (Or.inr (Or.inr h))
    · exact Or.inl h) hx
  have hpreP : ∀ op x, preOps op → GroupPre DV op x → X.Pre op x := fun op x h hx => hPre op x
    (by
      rcases h with h | h | h
      · exact Or.inr (Or.inr (Or.inl h))
      · exact Or.inr (Or.inr (Or.inr h))
      · exact Or.inl h) hx
  obtain ⟨-, hG1deg, hG1v, hG1den⟩ := RunsWithin.preProg (a := .unit) (b := .unit)
    (body := fun _ => .ret ()) hpreO hpreP hGv hG hLs le_rfl (fun π _ => hBl π) le_rfl
  rw [hg1]
  refine ⟨hG1deg, hG1v, by rw [hG1den, hLcl, al_comap_inf_range], ?_⟩
  rw [hpm]
  exact hlen

end G1

/-! ### Case 2a -/

section Case2a

variable {D : Ty} {a b : Ty} {X : Ctx (groupSig D)}
  {body : a.denote → Prog (groupSig D) (a, b) Ty.denote b} {DV : ℕ → GensData → D.denote → Prop}

/-- The backend operations of Case 2a. -/
def c2aOps (op : GroupOp) : Prop := alignOps op ∨ pbOps op

theorem c2_len_le {l : List ℕ} {m : ℕ} (hl : l.Nodup ∧ ∀ i ∈ l, i < m) : l.length ≤ m := by
  have h := List.toFinset_card_of_nodup hl.1
  have hsub : l.toFinset ⊆ Finset.range m := fun i hi =>
    Finset.mem_range.2 (hl.2 i (List.mem_toFinset.1 hi))
  have := Finset.card_le_card hsub
  rw [Finset.card_range, h] at this
  exact this

theorem RunsWithin.posProg (n : ℕ) (l : List ℕ) :
    RunsWithin X body (Giant.posProg n l) (l.map (n + ·)) (l.length * 4 + 2) := by
  refine (RunsWithin.mapList_le (c := 1) fun j _ => RunsWithin.prim_le rfl ?_).mono le_rfl
  simp [Prim.cost]

theorem pbCost_mono {N s Cb Bstab Borb Bgen p h h' wl : ℕ} (hh : h ≤ h') :
    pbCost N s Cb Bstab Borb Bgen p h wl ≤ pbCost N s Cb Bstab Borb Bgen p h' wl := by
  unfold pbCost
  have h1 := Nat.mul_le_mul_right (pbBranchCost N s Cb Bgen wl + 3) (Nat.add_le_add_right hh 1)
  have h2 := Nat.mul_le_mul_right (12 * N + s + 26) (Nat.add_le_add_right hh 1)
  omega

/-- The cost of Case 2a. -/
def c2aCost (n N g k Φl BgP Bmem Bk Bl Bg1 Bgen cP s : ℕ) : ℕ :=
  Φl * 4 + 2 + 4 + alignCost n N g k 1 (setGensCost (N - n) (N - n))
    (setIsoCost (N - n) (N - n) (N - n)) BgP Bmem Bk Bl Bg1 Bgen cP s

/-- **Case 2a.** The large orbit `Φx` of `F = ⟨Fgs⟩ ≤ Aut(x)` is aligned with the large orbit
`Φy` (every isomorphism carries one to the other, as canonicity provides), and each aligned coset
is solved by the pullback. The answer is correct for `G`. -/
theorem RunsWithin.case2aProg (hO : MeetsContractOn DV c2aOps X.O)
    (hPre : ∀ op x, c2aOps op → GroupPre DV op x → X.Pre op x)
    {n N s : ℕ} {G₀ : Subgroup (Perm (Fin N))} (B : BackendBounds X DV N s G₀)
    {gs : GensData} {d : D.denote} (hGv : GroupValid DV N gs d)
    (hGG₀ : GensData.denote N gs ≤ G₀)
    (hG : IsInvariant (GensData.denote N gs) (baseSet n N))
    (halt : alternatingGroup (Fin (N - n)) ≤ (baseHom _ n hG).range)
    {Φx Φy : List ℕ} (hΦx : Φx.Nodup ∧ ∀ i ∈ Φx, i < N - n)
    (hΦy : Φy.Nodup ∧ ∀ i ∈ Φy, i < N - n)
    {xy : StrData × StrData} {w : WinData} (hw : w.Valid N)
    (hWG : IsInvariant (GensData.denote N gs) (w.denote N))
    (halign : ∀ g ∈ iso (w.denote N) 1 (GensData.denote N gs) (xy.1.denote N) (xy.2.denote N),
      ∃ h : g ∈ GensData.denote N gs,
        baseHom _ n hG ⟨g, h⟩ • SoJProg.setOf (N - n) Φx = SoJProg.setOf (N - n) Φy)
    {Fgs : GensData} (hFv : GensData.AllValid N Fgs)
    (hFG : GensData.denote N Fgs ≤ GensData.denote N gs)
    (hFΦ : ∀ f (h : f ∈ GensData.denote N Fgs),
      baseHom _ n hG ⟨f, hFG h⟩ • SoJProg.setOf (N - n) Φx = SoJProg.setOf (N - n) Φx)
    (hFx : ∀ f ∈ GensData.denote N Fgs,
      Matches (w.denote N) f (xy.1.denote N) (xy.1.denote N))
    (hFalt : ∀ π : Perm (phiSet N (Φx.map (n + ·))), Perm.sign π = 1 →
      ∃ f ∈ GensData.denote N Fgs, ∀ v : phiSet N (Φx.map (n + ·)), f v = π v)
    (hhalf : ∀ H ≤ GensData.denote N gs, ∀ os, IsOrbitPartition
      (pointwiseStab H {v : Fin N | v.val ∈ Φx.map (n + ·)}) w os →
        ∀ o ∈ os, 2 * o.length ≤ w.1.length)
    {BgP Bmem Bk Bl Bg1 Bgen Bpb Cb : ℕ}
    (hBgP : X.B.call GroupOp.generate (N - n, gs.map (baseD n N))
      (X.O.run GroupOp.generate (N - n, gs.map (baseD n N))) ≤ BgP)
    (hBmem : ∀ g : PermData, g.Valid (N - n) → X.B.call GroupOp.mem (pModel X.O n (N, gs, d), g)
      (X.O.run GroupOp.mem (pModel X.O n (N, gs, d), g)) ≤ Bmem)
    (hBk : X.B.call GroupOp.kernel ((N, gs, d), baseWin n N) (kerModel X.O n (N, gs, d)) ≤ Bk)
    (hBl : ∀ π : PermData, X.B.call GroupOp.lift ((N, gs, d), (baseWin n N, π))
      (liftModel X.O n (N, gs, d) π) ≤ Bl)
    (hBg1 : X.B.call GroupOp.generate
      (N, (stabInPL (flagsModel X.O (pModel X.O n (N, gs, d)) ((setOps (N - n)).gens Φx))).map
        (liftModel X.O n (N, gs, d)) ++ (kerModel X.O n (N, gs, d)).2.1)
      (g1Model X.O n (N, gs, d) (setOps (N - n)) Φx) ≤ Bg1)
    (hBgen : ∀ gs' : GensData, GensData.AllValid N gs' → gs'.length ≤ s + 1 →
      GensData.denote N gs' ≤ GensData.denote N gs →
      X.B.call GroupOp.generate (N, gs') (X.O.run GroupOp.generate (N, gs')) ≤ Bgen)
    (hBpb : ∀ gs', GensData.AllValid N gs' →
      gs'.length ≤ (s + 1) * (s + 1) + s + Fgs.length → GensData.denote N gs' ≤ G₀ →
      X.B.call GroupOp.generate (N, gs') (X.O.run GroupOp.generate (N, gs')) ≤ Bpb)
    {sub : InstData D → Prog (groupSig D) (a, b) Ty.denote (Ty.answer D)}
    (hsub : SubSolves X body DV sub (PbSubP DV G₀ xy w.1.length s) (fun _ => Cb) s) :
    ∃ ans : AnswerData D,
      RunsWithin X body (Giant.case2aProg sub n xy w (N, gs, d) Φx Φy Fgs) ans
        (c2aCost n N gs.length ((setOps (N - n)).gens Φx).length Φx.length BgP Bmem Bk Bl Bg1
          Bgen (4 + pbCost N s Cb B.Bstab B.Borb Bpb Φx.length s w.1.length) s) ∧
      AnsOK DV N (w.denote N) 1 (GensData.denote N gs) (xy.1.denote N) (xy.2.denote N) ans ∧
      ∀ sGen, (∀ gs', GensData.AllValid N gs' → GensData.denote N gs' ≤ GensData.denote N gs →
          (X.O.run GroupOp.generate (N, gs')).2.1.length ≤ sGen) →
        ∀ c : CosetData D, ans = some c → c.2.gens.length ≤ sGen := by
  have hAO : MeetsContractOn DV alignOps X.O := fun op x h hx => hO op x (Or.inl h) hx
  have hAP : ∀ op x, alignOps op → GroupPre DV op x → X.Pre op x :=
    fun op x h hx => hPre op x (Or.inl h) hx
  have hPO : MeetsContractOn DV pbOps X.O := fun op x h hx => hO op x (Or.inr h) hx
  have hPP : ∀ op x, pbOps op → GroupPre DV op x → X.Pre op x :=
    fun op x h hx => hPre op x (Or.inr h) hx
  obtain ⟨hG1deg, hG1v, hG1den, hG1s⟩ :=
    c2_g1_spec hAO hAP B hGv hGG₀ hG halt (setOps_spec (N - n)) hΦx hBl
  have hBg1' := hBg1
  rcases hg1 : g1Model X.O n (N, gs, d) (setOps (N - n)) Φx with ⟨N₁, g1s, e1⟩
  rw [hg1] at hG1deg hG1v hG1den hG1s
  change N₁ = N at hG1deg
  subst N₁
  change GensData.denote N g1s = _ at hG1den
  change g1s.length ≤ s at hG1s
  have hG1G : GensData.denote N g1s ≤ GensData.denote N gs := by
    rw [hG1den]
    exact Subgroup.map_subtype_le _
  set pΦ := Φx.map (n + ·) with hpΦdef
  -- `Φ` is invariant under `G₁`
  have hΦinv : IsInvariant (GensData.denote N g1s)
      ((phiSet N pΦ : Finset (Fin N)) : Set (Fin N)) := by
    intro g hg u hu
    rw [hG1den] at hg
    obtain ⟨g', hg', rfl⟩ := Subgroup.mem_map.1 hg
    have hst : baseHom _ n hG g' • SoJProg.setOf (N - n) Φx = SoJProg.setOf (N - n) Φx :=
      MulAction.mem_stabilizer_iff.1 hg'
    simp only [Finset.coe_filter, phiSet, Finset.mem_univ, true_and, Set.mem_ofPred_eq,
      hpΦdef, List.mem_map] at hu ⊢
    obtain ⟨i, hi, hiu⟩ := hu
    have hiN : i < N - n := hΦx.2 i hi
    set j : Fin (N - n) := ⟨i, hiN⟩
    have hju : basePos j = u := Fin.ext (by simp [basePos, j, hiu])
    have hjΦ : j ∈ SoJProg.setOf (N - n) Φx := SoJProg.mem_setOf.2 hi
    have hψj : baseHom _ n hG g' j ∈ SoJProg.setOf (N - n) Φx := by
      rw [← hst]
      exact Finset.smul_mem_smul_finset hjΦ
    refine ⟨(baseHom _ n hG g' j).val, SoJProg.mem_setOf.1 hψj, ?_⟩
    rw [← hju]
    have h := congrArg Fin.val (baseHom_apply (hG := hG) g' j)
    simp only [basePos] at h
    exact h
  have hFH1 : GensData.denote N Fgs ≤ GensData.denote N g1s := by
    intro f hf
    rw [hG1den]
    exact Subgroup.mem_map.2 ⟨⟨f, hFG hf⟩, MulAction.mem_stabilizer_iff.2 (hFΦ f hf), rfl⟩
  have hpΦ : ∀ u ∈ pΦ, u < N := by
    intro u hu
    obtain ⟨i, hi, rfl⟩ := List.mem_map.1 hu
    have := hΦx.2 i hi
    omega
  set cP := 4 + pbCost N s Cb B.Bstab B.Borb Bpb Φx.length s w.1.length with hcP
  -- the sub-solver of Align
  have hsubA : SubSolves X body DV (fun I => Giant.pbSub sub Fgs pΦ I)
      (fun I => I.1 = xy ∧ I.2.1 = w ∧ I.2.2.2 = preModel X.O n (N, gs, d)
        (stabInPL (flagsModel X.O (pModel X.O n (N, gs, d)) ((setOps (N - n)).gens Φx))) ∧
        I.Valid DV) (fun _ => cP) s := by
    rintro ⟨xy', w', t, G'⟩ ⟨h1, h2, h3, hV⟩
    change xy' = xy at h1
    change w' = w at h2
    change G' = g1Model X.O n (N, gs, d) (setOps (N - n)) Φx at h3
    rw [hg1] at h3
    subst xy' w' G'
    have ht : t.Valid N := hV.rep
    obtain ⟨ans, hrun, hok, hgen⟩ := RunsWithin.pullbackProg (X := X) (body := body) hPO hPP B hw
      ht hG1v hG1s (hG1G.trans hGG₀) (hWG.mono hG1G) hpΦ hΦinv hFv hFH1 hFx hFalt
      (hhalf _ hG1G) (fun gs' hv hl hle => hBpb gs' hv (by nlinarith) hle) hsub
    refine ⟨ans, ?_, hok, hgen⟩
    unfold Giant.pbSub
    apply RunsWithin.mono
    case h =>
      run_step (RunsWithin.prim _ _)
      run_step (RunsWithin.prim _ _)
      run_step (RunsWithin.prim _ _)
      run_step (RunsWithin.prim _ _)
      exact hrun
    case hc =>
      have := pbCost_mono (N := N) (s := s) (Cb := Cb) (Bstab := B.Bstab) (Borb := B.Borb)
        (Bgen := Bpb) (p := pΦ.length) (wl := w.1.length) hG1s
      simp only [Prim.cost, hcP, hpΦdef, List.length_map] at this ⊢
      omega
  have hlenX := c2_len_le hΦx
  have hlenY := c2_len_le hΦy
  obtain ⟨ans, hrun, hok, hgen⟩ := RunsWithin.alignProg (X := X) (body := body) hAO hAP hGv hG
    halt (setOps_spec (N - n)) (gensP := fun l => Align.setGensProg (N - n) l)
    (cG := setGensCost (N - n) (N - n))
    (fun l hl => RunsWithin.setGensProg (N - n) l (c2_len_le hl))
    (isoP := fun l l' => Align.setIsoProg (N - n) l l')
    (cI := setIsoCost (N - n) (N - n) (N - n))
    (fun l l' hl hl' => RunsWithin.setIsoProg (N - n) l l' (c2_len_le hl) (c2_len_le hl'))
    (X₀ := Φx) (Ys := [Φy]) hΦx (fun Y hY => by rw [List.mem_singleton.1 hY]; exact hΦy)
    hw hWG (fun g hg => by
      obtain ⟨h, hh⟩ := halign g hg
      exact ⟨Φy, List.mem_singleton_self _, h, hh⟩)
    hBgP hBmem hBk hBl hBg1' (fun gs' hv hl hle => hBgen gs' hv (by simpa using hl) hle) hsubA
  refine ⟨ans, ?_, hok, hgen⟩
  unfold Giant.case2aProg
  apply RunsWithin.mono
  case h =>
    run_step (RunsWithin.prim _ _)
    run_step (RunsWithin.prim _ _)
    run_step (RunsWithin.posProg n Φx)
    run_step (RunsWithin.prim _ _)
    run_step (RunsWithin.prim _ _)
    exact hrun
  case hc =>
    simp only [Prim.cost, c2aCost, List.length_cons, List.length_nil, Nat.zero_add]
    omega

end Case2a

/-! ### The pullback and Case 2a with the half-window bound from the labels -/

section OfLabels

variable {D : Ty} {a b : Ty} {X : Ctx (groupSig D)}
  {body : a.denote → Prog (groupSig D) (a, b) Ty.denote b} {DV : ℕ → GensData → D.denote → Prop}

/-- **The pullback, with the half-window bound established**: `RunsWithin.pullbackProg` with
`hhalf` derived from equivariant `t`-subset labels on the window (`c2_hhalf_of_labels`, from
`card_orbit_le_half`). `H` lies in a group `G` acting on the base `[n, N)` as a giant, and
`Φ` (base indices `Φl`, positions `n + j`) has more than half of the base. -/
theorem RunsWithin.pullbackProg_of_labels (hO : MeetsContractOn DV pbOps X.O)
    (hPre : ∀ op x, pbOps op → GroupPre DV op x → X.Pre op x)
    {n N s : ℕ} {G₀ : Subgroup (Perm (Fin N))} (B : BackendBounds X DV N s G₀)
    {G : Subgroup (Perm (Fin N))} (hG : IsInvariant G (baseSet n N))
    (hgiant : alternatingGroup (Fin (N - n)) ≤ (baseHom G n hG).range) (h3 : 3 ≤ N - n)
    {xy : StrData × StrData} {w : WinData} (hw : w.Valid N) (hWG : IsInvariant G (w.denote N))
    {lab : Fin N → Finset (Fin (N - n))}
    (he : Recursion.Equivar (baseHom G n hG) (winFinset N w) lab)
    {t : ℕ} (ht : ∀ u ∈ winFinset N w, (lab u).card = t) (ht1 : 1 ≤ t) (ht2 : 2 * t ≤ N - n)
    {σd : PermData} (hσ : σd.Valid N) {hgs : GensData} {hd : D.denote}
    (hHv : GroupValid DV N hgs hd) (hHs : hgs.length ≤ s)
    (hHG₀ : GensData.denote N hgs ≤ G₀) (hHG : GensData.denote N hgs ≤ G)
    {Φl : List ℕ} (hΦl : Φl.Nodup ∧ ∀ i ∈ Φl, i < N - n) (hΦ : N - n < 2 * Φl.length)
    (hΦH : IsInvariant (GensData.denote N hgs)
      ((phiSet N (Φl.map (n + ·)) : Finset (Fin N)) : Set (Fin N)))
    {Fgs : GensData} (hFv : GensData.AllValid N Fgs)
    (hFH : GensData.denote N Fgs ≤ GensData.denote N hgs)
    (hFx : ∀ f ∈ GensData.denote N Fgs,
      Matches (w.denote N) f (xy.1.denote N) (xy.1.denote N))
    (hFalt : ∀ π : Perm (phiSet N (Φl.map (n + ·))), Perm.sign π = 1 →
      ∃ f ∈ GensData.denote N Fgs, ∀ v : phiSet N (Φl.map (n + ·)), f v = π v)
    {Cb Bgen : ℕ}
    (hBg : ∀ gs', GensData.AllValid N gs' →
      gs'.length ≤ (hgs.length + 1) * (s + 1) + s + Fgs.length → GensData.denote N gs' ≤ G₀ →
      X.B.call GroupOp.generate (N, gs') (X.O.run GroupOp.generate (N, gs')) ≤ Bgen)
    {sub : InstData D → Prog (groupSig D) (a, b) Ty.denote (Ty.answer D)}
    (hsub : SubSolves X body DV sub (PbSubP DV G₀ xy w.1.length s) (fun _ => Cb) s) :
    ∃ ans : AnswerData D,
      RunsWithin X body
          (Giant.pullbackProg sub xy w (σd, (N, hgs, hd)) Fgs (Φl.map (n + ·))) ans
        (pbCost N s Cb B.Bstab B.Borb Bgen Φl.length hgs.length w.1.length) ∧
      AnsOK DV N (w.denote N) (PermData.denote N σd) (GensData.denote N hgs)
        (xy.1.denote N) (xy.2.denote N) ans ∧
      ∀ c : CosetData D, ans = some c → c.2.gens.length ≤ s := by
  have hpΦ : ∀ u ∈ Φl.map (n + ·), u < N := by
    intro u hu
    obtain ⟨i, hi, rfl⟩ := List.mem_map.1 hu
    have := hΦl.2 i hi
    omega
  have h := RunsWithin.pullbackProg (X := X) (body := body) hO hPre B hw hσ hHv hHs hHG₀
    (hWG.mono hHG) hpΦ hΦH hFv hFH hFx hFalt
    (c2_hhalf_of_labels hG hgiant h3 hw hWG he ht ht1 ht2 hΦl hΦ hHG) hBg hsub
  simpa using h

/-- **Case 2a, with the half-window bound established**: `RunsWithin.case2aProg` with `hhalf`
derived from equivariant `t`-subset labels on the window (`c2_hhalf_of_labels`). -/
theorem RunsWithin.case2aProg_of_labels (hO : MeetsContractOn DV c2aOps X.O)
    (hPre : ∀ op x, c2aOps op → GroupPre DV op x → X.Pre op x)
    {n N s : ℕ} {G₀ : Subgroup (Perm (Fin N))} (B : BackendBounds X DV N s G₀)
    {gs : GensData} {d : D.denote} (hGv : GroupValid DV N gs d)
    (hGG₀ : GensData.denote N gs ≤ G₀)
    (hG : IsInvariant (GensData.denote N gs) (baseSet n N))
    (halt : alternatingGroup (Fin (N - n)) ≤ (baseHom _ n hG).range) (h3 : 3 ≤ N - n)
    {Φx Φy : List ℕ} (hΦx : Φx.Nodup ∧ ∀ i ∈ Φx, i < N - n)
    (hΦy : Φy.Nodup ∧ ∀ i ∈ Φy, i < N - n) (hΦ : N - n < 2 * Φx.length)
    {xy : StrData × StrData} {w : WinData} (hw : w.Valid N)
    (hWG : IsInvariant (GensData.denote N gs) (w.denote N))
    {lab : Fin N → Finset (Fin (N - n))}
    (he : Recursion.Equivar (baseHom _ n hG) (winFinset N w) lab)
    {t : ℕ} (ht : ∀ u ∈ winFinset N w, (lab u).card = t) (ht1 : 1 ≤ t) (ht2 : 2 * t ≤ N - n)
    (halign : ∀ g ∈ iso (w.denote N) 1 (GensData.denote N gs) (xy.1.denote N) (xy.2.denote N),
      ∃ h : g ∈ GensData.denote N gs,
        baseHom _ n hG ⟨g, h⟩ • SoJProg.setOf (N - n) Φx = SoJProg.setOf (N - n) Φy)
    {Fgs : GensData} (hFv : GensData.AllValid N Fgs)
    (hFG : GensData.denote N Fgs ≤ GensData.denote N gs)
    (hFΦ : ∀ f (h : f ∈ GensData.denote N Fgs),
      baseHom _ n hG ⟨f, hFG h⟩ • SoJProg.setOf (N - n) Φx = SoJProg.setOf (N - n) Φx)
    (hFx : ∀ f ∈ GensData.denote N Fgs,
      Matches (w.denote N) f (xy.1.denote N) (xy.1.denote N))
    (hFalt : ∀ π : Perm (phiSet N (Φx.map (n + ·))), Perm.sign π = 1 →
      ∃ f ∈ GensData.denote N Fgs, ∀ v : phiSet N (Φx.map (n + ·)), f v = π v)
    {BgP Bmem Bk Bl Bg1 Bgen Bpb Cb : ℕ}
    (hBgP : X.B.call GroupOp.generate (N - n, gs.map (baseD n N))
      (X.O.run GroupOp.generate (N - n, gs.map (baseD n N))) ≤ BgP)
    (hBmem : ∀ g : PermData, g.Valid (N - n) → X.B.call GroupOp.mem (pModel X.O n (N, gs, d), g)
      (X.O.run GroupOp.mem (pModel X.O n (N, gs, d), g)) ≤ Bmem)
    (hBk : X.B.call GroupOp.kernel ((N, gs, d), baseWin n N) (kerModel X.O n (N, gs, d)) ≤ Bk)
    (hBl : ∀ π : PermData, X.B.call GroupOp.lift ((N, gs, d), (baseWin n N, π))
      (liftModel X.O n (N, gs, d) π) ≤ Bl)
    (hBg1 : X.B.call GroupOp.generate
      (N, (stabInPL (flagsModel X.O (pModel X.O n (N, gs, d)) ((setOps (N - n)).gens Φx))).map
        (liftModel X.O n (N, gs, d)) ++ (kerModel X.O n (N, gs, d)).2.1)
      (g1Model X.O n (N, gs, d) (setOps (N - n)) Φx) ≤ Bg1)
    (hBgen : ∀ gs' : GensData, GensData.AllValid N gs' → gs'.length ≤ s + 1 →
      GensData.denote N gs' ≤ GensData.denote N gs →
      X.B.call GroupOp.generate (N, gs') (X.O.run GroupOp.generate (N, gs')) ≤ Bgen)
    (hBpb : ∀ gs', GensData.AllValid N gs' →
      gs'.length ≤ (s + 1) * (s + 1) + s + Fgs.length → GensData.denote N gs' ≤ G₀ →
      X.B.call GroupOp.generate (N, gs') (X.O.run GroupOp.generate (N, gs')) ≤ Bpb)
    {sub : InstData D → Prog (groupSig D) (a, b) Ty.denote (Ty.answer D)}
    (hsub : SubSolves X body DV sub (PbSubP DV G₀ xy w.1.length s) (fun _ => Cb) s) :
    ∃ ans : AnswerData D,
      RunsWithin X body (Giant.case2aProg sub n xy w (N, gs, d) Φx Φy Fgs) ans
        (c2aCost n N gs.length ((setOps (N - n)).gens Φx).length Φx.length BgP Bmem Bk Bl Bg1
          Bgen (4 + pbCost N s Cb B.Bstab B.Borb Bpb Φx.length s w.1.length) s) ∧
      AnsOK DV N (w.denote N) 1 (GensData.denote N gs) (xy.1.denote N) (xy.2.denote N) ans ∧
      ∀ sGen, (∀ gs', GensData.AllValid N gs' → GensData.denote N gs' ≤ GensData.denote N gs →
          (X.O.run GroupOp.generate (N, gs')).2.1.length ≤ sGen) →
        ∀ c : CosetData D, ans = some c → c.2.gens.length ≤ sGen :=
  RunsWithin.case2aProg hO hPre B hGv hGG₀ hG halt hΦx hΦy hw hWG halign hFv hFG hFΦ hFx hFalt
    (fun _ hH => c2_hhalf_of_labels hG halt h3 hw hWG he ht ht1 ht2 hΦx hΦ hH)
    hBgP hBmem hBk hBl hBg1 hBgen hBpb hsub

/-- **Case 2a for canonical full groups.** `RunsWithin.case2aProg_of_labels` with the alignment
hypothesis and the invariance of `Φx` derived: `F` is a canonical map of the strings into
subgroups of `G` (local on the window, `F (relabel g x) = g F(x) g⁻¹`), `Fgs` generates `F(x)`,
`Fy = F(y)`, and `Φx`, `Φy` list the orbits of more than half of the base of `ψ(F(x))` and
`ψ(F(y))` (as the case decision `caseD_spec` returns them). Every isomorphism then carries `Φx`
to `Φy` (`largeOrbit_canonical`), and `F(x)` leaves `Φx` invariant (`c2_orbit_stable`). -/
theorem RunsWithin.case2aProg_canonical (hO : MeetsContractOn DV c2aOps X.O)
    (hPre : ∀ op x, c2aOps op → GroupPre DV op x → X.Pre op x)
    {n N s : ℕ} {G₀ : Subgroup (Perm (Fin N))} (B : BackendBounds X DV N s G₀)
    {gs : GensData} {d : D.denote} (hGv : GroupValid DV N gs d)
    (hGG₀ : GensData.denote N gs ≤ G₀)
    (hG : IsInvariant (GensData.denote N gs) (baseSet n N))
    (halt : alternatingGroup (Fin (N - n)) ≤ (baseHom _ n hG).range) (h3 : 3 ≤ N - n)
    {xy : StrData × StrData} {w : WinData} (hw : w.Valid N)
    (hWG : IsInvariant (GensData.denote N gs) (w.denote N))
    {lab : Fin N → Finset (Fin (N - n))}
    (he : Recursion.Equivar (baseHom _ n hG) (winFinset N w) lab)
    {t : ℕ} (ht : ∀ u ∈ winFinset N w, (lab u).card = t) (ht1 : 1 ≤ t) (ht2 : 2 * t ≤ N - n)
    {Fmap : (Fin N → ℕ) → Subgroup (Perm (Fin N))} (hFGm : ∀ x, Fmap x ≤ GensData.denote N gs)
    (hloc : ∀ x x', (∀ u ∈ w.denote N, x u = x' u) → Fmap x = Fmap x')
    (heq : ∀ g ∈ GensData.denote N gs, ∀ x,
      Fmap (relabel g x) = (Fmap x).map (MulAut.conj g).toMonoidHom)
    {Fgs : GensData} (hFv : GensData.AllValid N Fgs)
    (hFxe : GensData.denote N Fgs = Fmap (xy.1.denote N))
    (hFaut : ∀ f ∈ GensData.denote N Fgs,
      Matches (w.denote N) f (xy.1.denote N) (xy.1.denote N))
    {Fy : Subgroup (Perm (Fin N))} (hFye : Fy = Fmap (xy.2.denote N))
    (hFxi : IsInvariant (GensData.denote N Fgs) (baseSet n N))
    (hFyi : IsInvariant Fy (baseSet n N))
    {Φx Φy : List ℕ} (hΦxn : Φx.Nodup) (hΦxl : ∀ i ∈ Φx, i < N - n)
    (hΦx2 : N - n < 2 * Φx.length)
    (hΦxo : ∃ γ : Fin (N - n), γ.val ∈ Φx ∧ ∀ δ : Fin (N - n),
      δ.val ∈ Φx ↔ δ ∈ MulAction.orbit (baseHom (GensData.denote N Fgs) n hFxi).range γ)
    (hΦyn : Φy.Nodup) (hΦyl : ∀ i ∈ Φy, i < N - n) (hΦy2 : N - n < 2 * Φy.length)
    (hΦyo : ∃ γ : Fin (N - n), γ.val ∈ Φy ∧ ∀ δ : Fin (N - n),
      δ.val ∈ Φy ↔ δ ∈ MulAction.orbit (baseHom Fy n hFyi).range γ)
    (hFalt : ∀ π : Perm (phiSet N (Φx.map (n + ·))), Perm.sign π = 1 →
      ∃ f ∈ GensData.denote N Fgs, ∀ v : phiSet N (Φx.map (n + ·)), f v = π v)
    {BgP Bmem Bk Bl Bg1 Bgen Bpb Cb : ℕ}
    (hBgP : X.B.call GroupOp.generate (N - n, gs.map (baseD n N))
      (X.O.run GroupOp.generate (N - n, gs.map (baseD n N))) ≤ BgP)
    (hBmem : ∀ g : PermData, g.Valid (N - n) → X.B.call GroupOp.mem (pModel X.O n (N, gs, d), g)
      (X.O.run GroupOp.mem (pModel X.O n (N, gs, d), g)) ≤ Bmem)
    (hBk : X.B.call GroupOp.kernel ((N, gs, d), baseWin n N) (kerModel X.O n (N, gs, d)) ≤ Bk)
    (hBl : ∀ π : PermData, X.B.call GroupOp.lift ((N, gs, d), (baseWin n N, π))
      (liftModel X.O n (N, gs, d) π) ≤ Bl)
    (hBg1 : X.B.call GroupOp.generate
      (N, (stabInPL (flagsModel X.O (pModel X.O n (N, gs, d)) ((setOps (N - n)).gens Φx))).map
        (liftModel X.O n (N, gs, d)) ++ (kerModel X.O n (N, gs, d)).2.1)
      (g1Model X.O n (N, gs, d) (setOps (N - n)) Φx) ≤ Bg1)
    (hBgen : ∀ gs' : GensData, GensData.AllValid N gs' → gs'.length ≤ s + 1 →
      GensData.denote N gs' ≤ GensData.denote N gs →
      X.B.call GroupOp.generate (N, gs') (X.O.run GroupOp.generate (N, gs')) ≤ Bgen)
    (hBpb : ∀ gs', GensData.AllValid N gs' →
      gs'.length ≤ (s + 1) * (s + 1) + s + Fgs.length → GensData.denote N gs' ≤ G₀ →
      X.B.call GroupOp.generate (N, gs') (X.O.run GroupOp.generate (N, gs')) ≤ Bpb)
    {sub : InstData D → Prog (groupSig D) (a, b) Ty.denote (Ty.answer D)}
    (hsub : SubSolves X body DV sub (PbSubP DV G₀ xy w.1.length s) (fun _ => Cb) s) :
    ∃ ans : AnswerData D,
      RunsWithin X body (Giant.case2aProg sub n xy w (N, gs, d) Φx Φy Fgs) ans
        (c2aCost n N gs.length ((setOps (N - n)).gens Φx).length Φx.length BgP Bmem Bk Bl Bg1
          Bgen (4 + pbCost N s Cb B.Bstab B.Borb Bpb Φx.length s w.1.length) s) ∧
      AnsOK DV N (w.denote N) 1 (GensData.denote N gs) (xy.1.denote N) (xy.2.denote N) ans ∧
      ∀ sGen, (∀ gs', GensData.AllValid N gs' → GensData.denote N gs' ≤ GensData.denote N gs →
          (X.O.run GroupOp.generate (N, gs')).2.1.length ≤ sGen) →
        ∀ c : CosetData D, ans = some c → c.2.gens.length ≤ sGen := by
  have hFG : GensData.denote N Fgs ≤ GensData.denote N gs := hFxe ▸ hFGm _
  obtain ⟨γx, hγxm, hγx⟩ := hΦxo
  have halign : ∀ g ∈ iso (w.denote N) 1 (GensData.denote N gs) (xy.1.denote N)
      (xy.2.denote N), ∃ h : g ∈ GensData.denote N gs,
        baseHom _ n hG ⟨g, h⟩ • SoJProg.setOf (N - n) Φx = SoJProg.setOf (N - n) Φy :=
    fun g hg => ⟨(mem_iso_one.1 hg).1, largeOrbit_canonical hG hWG hloc heq hFxe hFye hFxi hFyi
      hg hΦxn hΦxl hΦx2 ⟨γx, hγxm, hγx⟩ hΦyn hΦyl hΦy2 hΦyo⟩
  exact RunsWithin.case2aProg_of_labels hO hPre B hGv hGG₀ hG halt h3 ⟨hΦxn, hΦxl⟩
    ⟨hΦyn, hΦyl⟩ hΦx2 hw hWG he ht ht1 ht2 halign hFv hFG
    (fun f hf => c2_orbit_stable hG hFxi hFG hγx hf) hFaut hFalt hBgP hBmem hBk hBl hBg1 hBgen
    hBpb hsub

end OfLabels

/-! ### Well-formedness -/

section Wf

variable {D : Ty} {rec : Ty × Ty} {var₁ var₂ : Ty → Type} {r : Bool} {Γ : WfCtx var₁ var₂}

theorem wf_augProg {N₁ : var₁ .nat} {N₂ : var₂ .nat} {a₁ : var₁ (Ty.answer D)}
    {a₂ : var₂ (Ty.answer D)} {F₁ : var₁ Ty.gens} {F₂ : var₂ Ty.gens} (hN : ⟨.nat, N₁, N₂⟩ ∈ Γ)
    (ha : ⟨Ty.answer D, a₁, a₂⟩ ∈ Γ) (hF : ⟨Ty.gens, F₁, F₂⟩ ∈ Γ) :
    Prog.Wf (rec := rec) r Γ (augProg N₁ a₁ F₁) (augProg N₂ a₂ F₂) := by
  unfold augProg
  prog_wf

theorem wf_pbBranch {sub₁ : var₁ (Ty.inst D) → Prog (groupSig D) rec var₁ (Ty.answer D)}
    {sub₂ : var₂ (Ty.inst D) → Prog (groupSig D) rec var₂ (Ty.answer D)}
    (hsub : WfFun r Γ sub₁ sub₂) {xy₁ : var₁ Ty.strs} {xy₂ : var₂ Ty.strs}
    {σ₁ : var₁ Ty.perm} {σ₂ : var₂ Ty.perm} {K₁ : var₁ (Ty.group D)} {K₂ : var₂ (Ty.group D)}
    {os₁ : var₁ (.list (.list .nat))} {os₂ : var₂ (.list (.list .nat))}
    {F₁ : var₁ Ty.gens} {F₂ : var₂ Ty.gens} {N₁ : var₁ .nat} {N₂ : var₂ .nat}
    {r₁ : var₁ Ty.perm} {r₂ : var₂ Ty.perm} (hxy : ⟨Ty.strs, xy₁, xy₂⟩ ∈ Γ)
    (hσ : ⟨Ty.perm, σ₁, σ₂⟩ ∈ Γ) (hK : ⟨Ty.group D, K₁, K₂⟩ ∈ Γ)
    (hos : ⟨.list (.list .nat), os₁, os₂⟩ ∈ Γ) (hF : ⟨Ty.gens, F₁, F₂⟩ ∈ Γ)
    (hN : ⟨.nat, N₁, N₂⟩ ∈ Γ) (hr : ⟨Ty.perm, r₁, r₂⟩ ∈ Γ) :
    Prog.Wf r Γ (pbBranch sub₁ xy₁ σ₁ K₁ os₁ F₁ N₁ r₁) (pbBranch sub₂ xy₂ σ₂ K₂ os₂ F₂ N₂ r₂) := by
  unfold pbBranch
  refine .bind (wf_permMul hσ hr) fun _ _ => .bind (.prim _ (.cons (by simp) (.cons
    (by simp [hK]) .nil))) fun _ _ => .bind (wf_seqProg (hsub.mono fun y hy => by simp [hy])
    (by simp [hxy]) (by simp) (by simp [hos])) fun _ _ =>
      wf_augProg (by simp [hN]) (by simp) (by simp [hF])

theorem wf_pullbackProg {sub₁ : var₁ (Ty.inst D) → Prog (groupSig D) rec var₁ (Ty.answer D)}
    {sub₂ : var₂ (Ty.inst D) → Prog (groupSig D) rec var₂ (Ty.answer D)}
    (hsub : WfFun r Γ sub₁ sub₂) {xy₁ : var₁ Ty.strs} {xy₂ : var₂ Ty.strs}
    {w₁ : var₁ Ty.win} {w₂ : var₂ Ty.win} {c₁ : var₁ (Ty.coset D)} {c₂ : var₂ (Ty.coset D)}
    {F₁ : var₁ Ty.gens} {F₂ : var₂ Ty.gens} {p₁ : var₁ (.list .nat)} {p₂ : var₂ (.list .nat)}
    (hxy : ⟨Ty.strs, xy₁, xy₂⟩ ∈ Γ) (hw : ⟨Ty.win, w₁, w₂⟩ ∈ Γ)
    (hc : ⟨Ty.coset D, c₁, c₂⟩ ∈ Γ) (hF : ⟨Ty.gens, F₁, F₂⟩ ∈ Γ)
    (hp : ⟨.list .nat, p₁, p₂⟩ ∈ Γ) :
    Prog.Wf r Γ (pullbackProg sub₁ xy₁ w₁ c₁ F₁ p₁) (pullbackProg sub₂ xy₂ w₂ c₂ F₂ p₂) := by
  unfold pullbackProg
  refine .bind (.prim _ (.cons hc .nil)) fun σ₁ σ₂ => ?_
  refine .bind (.prim _ (.cons (by simp [hc]) .nil)) fun H₁ H₂ => ?_
  refine .bind (.prim _ (.cons (by simp) .nil)) fun N₁ N₂ => ?_
  refine .bind (wf_iterStabProg (by simp) (by simp [hp])) fun K₁ K₂ => ?_
  refine .bind (.prim _ (.cons (by simp) (.cons (by simp [hw]) .nil))) fun Kw₁ Kw₂ => ?_
  refine .bind (.call _ List.mem_cons_self) fun os₁ os₂ => ?_
  refine .bind (.prim _ (.cons (by simp) .nil)) fun hd₁ hd₂ => ?_
  refine .bind (.prim _ (.cons (by simp) .nil)) fun hg₁ hg₂ => ?_
  refine .bind (wf_permOne (by simp)) fun o₁ o₂ => ?_
  refine .bind (.prim _ (.cons (by simp) (.cons (by simp) .nil))) fun rs₁ rs₂ => ?_
  refine .bind (wf_mapList (by simp) fun Γ' hΓ' r₁ r₂ hr => ?_) fun as₁ as₂ =>
    wf_combineProg (by simp) (by simp)
  exact wf_pbBranch (hsub.mono fun y hy => hΓ' (by simp [hy])) (hΓ' (by simp [hxy]))
    (hΓ' (by simp)) (hΓ' (by simp))
    (hΓ' (by simp only [List.mem_cons]; exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inl
      (by rfl)))))))
    (hΓ' (by simp [hF])) (hΓ' (by simp)) hr

theorem wf_pbSub {sub₁ : var₁ (Ty.inst D) → Prog (groupSig D) rec var₁ (Ty.answer D)}
    {sub₂ : var₂ (Ty.inst D) → Prog (groupSig D) rec var₂ (Ty.answer D)}
    (hsub : WfFun r Γ sub₁ sub₂) {F₁ : var₁ Ty.gens} {F₂ : var₂ Ty.gens}
    {p₁ : var₁ (.list .nat)} {p₂ : var₂ (.list .nat)} (hF : ⟨Ty.gens, F₁, F₂⟩ ∈ Γ)
    (hp : ⟨.list .nat, p₁, p₂⟩ ∈ Γ) :
    WfFun r Γ (fun I => pbSub sub₁ F₁ p₁ I) (fun I => pbSub sub₂ F₂ p₂ I) := by
  intro Γ' hΓ' I₁ I₂ hI
  unfold pbSub
  refine .bind (.prim _ (.cons hI .nil)) fun xy₁ xy₂ => ?_
  refine .bind (.prim _ (.cons (by simp [hI]) .nil)) fun wc₁ wc₂ => ?_
  refine .bind (.prim _ (.cons (by simp) .nil)) fun w₁ w₂ => ?_
  refine .bind (.prim _ (.cons (by simp) .nil)) fun c₁ c₂ => ?_
  exact wf_pullbackProg (hsub.mono fun y hy => by simp [hΓ' hy]) (by simp) (by simp) (by simp)
    (by simp [hΓ' hF]) (by simp [hΓ' hp])

theorem wf_posProg {n₁ : var₁ .nat} {n₂ : var₂ .nat} {l₁ : var₁ (.list .nat)}
    {l₂ : var₂ (.list .nat)} (hn : ⟨.nat, n₁, n₂⟩ ∈ Γ) (hl : ⟨.list .nat, l₁, l₂⟩ ∈ Γ) :
    Prog.Wf (S := groupSig D) (rec := rec) r Γ (posProg n₁ l₁) (posProg n₂ l₂) := by
  unfold posProg mapList
  prog_wf

theorem wf_case2aProg {sub₁ : var₁ (Ty.inst D) → Prog (groupSig D) rec var₁ (Ty.answer D)}
    {sub₂ : var₂ (Ty.inst D) → Prog (groupSig D) rec var₂ (Ty.answer D)}
    (hsub : WfFun r Γ sub₁ sub₂) {n₁ : var₁ .nat} {n₂ : var₂ .nat}
    {xy₁ : var₁ Ty.strs} {xy₂ : var₂ Ty.strs} {w₁ : var₁ Ty.win} {w₂ : var₂ Ty.win}
    {G₁ : var₁ (Ty.group D)} {G₂ : var₂ (Ty.group D)} {Φx₁ Φy₁ : var₁ (.list .nat)}
    {Φx₂ Φy₂ : var₂ (.list .nat)} {F₁ : var₁ Ty.gens} {F₂ : var₂ Ty.gens}
    (hn : ⟨.nat, n₁, n₂⟩ ∈ Γ) (hxy : ⟨Ty.strs, xy₁, xy₂⟩ ∈ Γ) (hw : ⟨Ty.win, w₁, w₂⟩ ∈ Γ)
    (hG : ⟨Ty.group D, G₁, G₂⟩ ∈ Γ) (hΦx : ⟨.list .nat, Φx₁, Φx₂⟩ ∈ Γ)
    (hΦy : ⟨.list .nat, Φy₁, Φy₂⟩ ∈ Γ) (hF : ⟨Ty.gens, F₁, F₂⟩ ∈ Γ) :
    Prog.Wf r Γ (case2aProg sub₁ n₁ xy₁ w₁ G₁ Φx₁ Φy₁ F₁)
      (case2aProg sub₂ n₂ xy₂ w₂ G₂ Φx₂ Φy₂ F₂) := by
  unfold case2aProg
  refine .bind (.prim _ (.cons hG .nil)) fun N₁ N₂ => ?_
  refine .bind (.prim _ (.cons List.mem_cons_self (.cons (List.mem_cons_of_mem _ hn) .nil)))
    fun m₁ m₂ => ?_
  refine .bind (wf_posProg (by simp [hn]) (by simp [hΦx])) fun p₁ p₂ => ?_
  refine .bind (.prim _ .nil) fun nil₁ nil₂ => ?_
  refine .bind (.prim _ (.cons (by simp [hΦy]) (.cons (by simp) .nil))) fun Ys₁ Ys₂ => ?_
  refine wf_alignProg (wf_pbSub (hsub.mono fun y hy => by simp [hy]) (by simp [hF]) (by simp))
    (fun Γ' hΓ' l₁ l₂ hl => wf_setGensProg (hΓ' (by simp)) hl)
    (fun Γ' hΓ' l₁ l₂ l₁' l₂' hl hl' => wf_setIsoProg (hΓ' (by simp)) hl hl')
    (by simp [hn]) (by simp [hxy]) (by simp [hw]) (by simp [hG]) (by simp [hΦx]) (by simp)

end Wf

