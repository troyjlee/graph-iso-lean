module

public import GraphIso.Certificates.Aggregate

/-!
# The full group by the test on `K(A)`

Stage 14g, item 1 (`PLAN-14.md` §11). Milestone 13's `fullGroup` collects the certificates
`K(A)` of the test sets whose `ψ_A(H(A))` is a giant; that `F ≤ Aut(x)` then needs the
thresholds of the CFSG-free interface (`fullGroup_le_autG`). The programs of stage 14e decide
fullness by the test on `K(A)` itself, `Alt(A) ≤ ψ_A(K(A))`. The group generated by the
certificates passing that test is `fullGroupK`:

* `fullGroupK_le_autG`: `F ≤ Aut(x)` with no hypothesis, since every `K(A)` respects `x`
  (`certK_le_autW`);
* `fullGroupK_relabel`: `F` is canonical (its support then moves with `σ` by `supp_conj`);
* `fullGroupK_eq_fullGroup`: under the thresholds the two tests agree, so `F` is milestone 13's
  `fullGroup`;
* `fullGroupK_eq_closure`: `F` is generated by the union of the passing certificates.
-/

@[expose] public section

namespace GraphIso.Certificates

open Equiv MulAction Pointwise GraphIso.AltQuot

variable {Ω Γ : Type} [Fintype Ω] [DecidableEq Ω] [Fintype Γ] [DecidableEq Γ]
variable {G : Subgroup (Perm Ω)} (φ : G →* Perm Γ) {L : Type*}

/-- The subgroup generated by the certificates `K(A)` of the `k`-sets with
`Alt(A) ≤ ψ_A(K(A))`. -/
def fullGroupK (k : ℕ) (x : Ω → L) : Subgroup G :=
  ⨆ (A : Finset Γ) (_ : A.card = k ∧ IsGiantOn φ A (certK φ A x)),
    (certK φ A x).map (stabA φ A).subtype

/-! ### Certificates of fullness -/

omit [DecidableEq Ω] [Fintype Γ] in
/-- Every certificate `K(A)`, seen in `G`, consists of automorphisms of `x`. -/
theorem fg_certK_map_le_autG (A : Finset Γ) (x : Ω → L) :
    (certK φ A x).map (stabA φ A).subtype ≤ autG x := by
  rintro _ ⟨s, hs, rfl⟩
  obtain ⟨-, -, hx⟩ := Local.certK_le_autW φ x hs
  exact ⟨trivial, Set.smul_set_univ, fun i _ => hx i trivial⟩

omit [DecidableEq Ω] [Fintype Γ] in
/-- The certificate of fullness moves with `σ`, as a subgroup of `G_A`. -/
theorem fg_certK_conjStab (σ : G) (A : Finset Γ) (x : Ω → L) :
    certK φ (φ σ • A) (smulStr σ x) = (certK φ A x).map (conjStab φ σ A).toMonoidHom := by
  rw [certK, certK, beardH_conjStab, beardW_conjStab, ← Set.smul_set_compl,
    fixingSubgroup_conjStab, ← Subgroup.map_inf _ _ _ (conjStab φ σ A).injective]

omit [DecidableEq Ω] [Fintype Γ] in
/-- The test on `K(A)` is canonical. -/
theorem fg_isGiantOn_certK_relabel (σ : G) (A : Finset Γ) (x : Ω → L) :
    IsGiantOn φ (φ σ • A) (certK φ (φ σ • A) (smulStr σ x)) ↔ IsGiantOn φ A (certK φ A x) := by
  rw [fg_certK_conjStab, isGiantOn_conjStab]

omit [DecidableEq Ω] [Fintype Γ] in
/-- The certificate of fullness lies in the beard's final group. -/
theorem fg_certK_le_beardH (A : Finset Γ) (x : Ω → L) : certK φ A x ≤ beardH φ A x := by
  unfold certK
  exact inf_le_left

/-! ### The full group -/

omit [DecidableEq Ω] [Fintype Γ] in
/-- **The full group consists of automorphisms**, unconditionally. -/
theorem fullGroupK_le_autG (k : ℕ) (x : Ω → L) : fullGroupK φ k x ≤ autG x :=
  iSup₂_le fun A _ => fg_certK_map_le_autG φ A x

omit [DecidableEq Ω] [Fintype Γ] in
/-- One inclusion of `fullGroupK_relabel`. -/
theorem fg_map_fullGroupK_le (σ : G) (k : ℕ) (x : Ω → L) :
    (fullGroupK φ k x).map (MulAut.conj σ).toMonoidHom ≤ fullGroupK φ k (smulStr σ x) := by
  rw [fullGroupK, Subgroup.map_iSup]
  refine iSup_le fun A => ?_
  rw [Subgroup.map_iSup]
  refine iSup_le fun hA => ?_
  rw [← certK_relabel]
  exact le_iSup₂_of_le (f := fun (B : Finset Γ)
    (_ : B.card = k ∧ IsGiantOn φ B (certK φ B (smulStr σ x))) =>
      (certK φ B (smulStr σ x)).map (stabA φ B).subtype) (φ σ • A)
    ⟨(Finset.card_smul_finset _ _).trans hA.1, (fg_isGiantOn_certK_relabel φ σ A x).2 hA.2⟩
    le_rfl

omit [DecidableEq Ω] [Fintype Γ] in
/-- **The full group is canonical.** -/
theorem fullGroupK_relabel (σ : G) (k : ℕ) (x : Ω → L) :
    fullGroupK φ k (smulStr σ x) = (fullGroupK φ k x).map (MulAut.conj σ).toMonoidHom := by
  refine le_antisymm (fun y hy => ?_) (fg_map_fullGroupK_le φ σ k x)
  have h := fg_map_fullGroupK_le φ σ⁻¹ k (smulStr σ x) (Subgroup.mem_map_of_mem _ hy)
  rw [smulStr_inv_smulStr] at h
  refine ⟨_, h, ?_⟩
  simp [MulAut.conj_apply, mul_assoc]

omit [DecidableEq Ω] [Fintype Γ] in
/-- **Under the thresholds, the two tests agree.** -/
theorem fullGroupK_eq_fullGroup {K : ℕ → ℕ} {k : ℕ} (x : Ω → L)
    (hT : Thresholds K (Fintype.card Ω) k) : fullGroupK φ k x = fullGroup φ k x := by
  have key : ∀ A : Finset Γ, A.card = k →
      (IsGiantOn φ A (certK φ A x) ↔ IsGiantOn φ A (beardH φ A x)) := by
    intro A hA
    refine ⟨fun h => h.trans (Subgroup.map_mono (fg_certK_le_beardH φ A x)), fun h => ?_⟩
    subst hA
    exact (cert_full φ x hT h).2
  apply le_antisymm
  · refine iSup₂_le fun A hA => ?_
    exact le_iSup₂_of_le (f := fun (B : Finset Γ)
      (_ : B.card = k ∧ IsGiantOn φ B (beardH φ B x)) =>
        (certK φ B x).map (stabA φ B).subtype) A ⟨hA.1, (key A hA.1).1 hA.2⟩ le_rfl
  · refine iSup₂_le fun A hA => ?_
    exact le_iSup₂_of_le (f := fun (B : Finset Γ)
      (_ : B.card = k ∧ IsGiantOn φ B (certK φ B x)) =>
        (certK φ B x).map (stabA φ B).subtype) A ⟨hA.1, (key A hA.1).2 hA.2⟩ le_rfl

omit [DecidableEq Ω] [Fintype Γ] in
/-- **The full group as a closure**: generated by the union of the passing certificates. -/
theorem fullGroupK_eq_closure (k : ℕ) (x : Ω → L) :
    fullGroupK φ k x = Subgroup.closure
      (⋃ (A : Finset Γ) (_ : A.card = k ∧ IsGiantOn φ A (certK φ A x)),
        ((certK φ A x).map (stabA φ A).subtype : Set G)) := by
  apply le_antisymm
  · refine iSup₂_le fun A hA => ?_
    intro g hg
    exact Subgroup.subset_closure (Set.mem_iUnion₂.2 ⟨A, hA, hg⟩)
  · rw [Subgroup.closure_le]
    intro g hg
    obtain ⟨A, hA, hg⟩ := Set.mem_iUnion₂.1 hg
    exact (le_iSup₂_of_le (f := fun (B : Finset Γ)
      (_ : B.card = k ∧ IsGiantOn φ B (certK φ B x)) =>
        (certK φ B x).map (stabA φ B).subtype) A hA le_rfl) hg

end GraphIso.Certificates
