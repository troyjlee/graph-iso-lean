module

public import GraphIso.Toolkit.Base
public import GraphIso.Reductions.BlockKernelProg
public import GraphIso.Reductions.RestrictionProg

/-!
# Re-basing a hinted group

A hinted group of degree `N` acts on the string positions `[0, n)` and on the base positions
`[n, N)` (`Toolkit/Base.lean`). A coarsening of the hint (`PLAN-14.md` §2.2) replaces the base
by a derived set: the blocks of a block system of the base, or the cells of a Johnson
structure. Both are lists `bs` of disjoint lists of positions that the group permutes.
`rebaseProg n N gs bs` computes the re-based group of degree `n + |bs|`:

1. every generator is extended by the induced action on the `k = |bs|` blocks, at degree
   `N + k` (`extendProg`, as in `blockKernelProg`);
2. it is restricted to the kept positions `[0, n) ++ [N, N + k)`, renumbered so that the
   string positions stay and the blocks become the new base `[n, n + k)`
   (`restrictPermProg`);
3. the backend generates the group at degree `n + k`.

* `strSet`, `strHom`: the string positions and the restriction to them.
* `rebaseHom`: the old group acting on `[0, n)` as before and on the new base by the induced
  block action (`blockHom`), `rebaseHom_lt`, `rebaseHom_ge`.
* `RunsWithin.rebaseProg`: the program computes a valid group of degree `n + k` generated by
  the image of `rebaseHom`.
* `rebase_iso`: if the old group acts faithfully on the string positions (as hinted groups
  do), the new group is isomorphic to it, with the same action on `[0, n)` and the block
  action on the new base; the new base and the string positions are invariant and the new
  group is again faithful on `[0, n)` (`rebase_invariant`, `rebase_faithful`).
-/

@[expose] public section

namespace GraphIso.Toolkit

open Equiv Cost GraphIso GraphIso.Programs

/-! ### String positions -/

/-- The string positions `[0, n)`. -/
def strSet (n N : ℕ) : Set (Fin N) := {i | i.val < n}

/-- The string positions are invariant when the base positions are. -/
theorem isInvariant_strSet {N n : ℕ} {G : Subgroup (Perm (Fin N))}
    (hG : IsInvariant G (baseSet n N)) : IsInvariant G (strSet n N) := by
  intro g hg u hu
  by_contra hc
  have h1 : g u ∈ baseSet n N := Nat.le_of_not_lt hc
  have h2 := hG g⁻¹ (G.inv_mem hg) (g u) h1
  have e : g⁻¹ (g u) = u := g.symm_apply_apply u
  rw [e] at h2
  exact absurd hu (Nat.not_lt.2 h2)

/-- The restriction to the string positions. -/
def strHom {N : ℕ} (G : Subgroup (Perm (Fin N))) (n : ℕ) (hn : n ≤ N)
    (hG : IsInvariant G (strSet n N)) : ↥G →* Perm (Fin n) where
  toFun g :=
    { toFun := fun j => ⟨(g.1 ⟨j.val, by omega⟩).val, hG g.1 g.2 _ (show j.val < n from j.2)⟩
      invFun := fun j => ⟨(g.1⁻¹ ⟨j.val, by omega⟩).val,
        hG _ (G.inv_mem g.2) _ (show j.val < n from j.2)⟩
      left_inv := fun j => by
        apply Fin.ext
        simp only [Fin.eta]
        exact congrArg Fin.val (g.1.symm_apply_apply _)
      right_inv := fun j => by
        apply Fin.ext
        simp only [Fin.eta]
        exact congrArg Fin.val (g.1.apply_symm_apply _) }
  map_one' := by
    ext j
    rfl
  map_mul' g h := by
    ext j
    simp only [Subgroup.coe_mul, Perm.mul_apply, Equiv.coe_fn_mk, Fin.eta]

theorem strHom_apply_val {N : ℕ} {G : Subgroup (Perm (Fin N))} {n : ℕ} {hn : n ≤ N}
    {hG : IsInvariant G (strSet n N)} (g : G) (j : Fin n) :
    ((strHom G n hn hG g j : Fin n) : ℕ) = (g.1 ⟨j.val, by omega⟩).val := rfl

/-! ### The re-based action -/

section Hom

variable {N : ℕ} {w : WinData} {bs : List (List ℕ)} {G : Subgroup (Perm (Fin N))} {n : ℕ}
  (hn : n ≤ N) (hG : IsInvariant G (strSet n N)) (hw : w.Valid N) (hbs : IsBlockList w bs)
  (hGb : PermutesBlocks G bs)

/-- **The re-based action**: `g` on the string positions `[0, n)` and its action on block
indices on the new base `[n, n + k)`. -/
def rebaseHom : ↥G →* Perm (Fin (n + bs.length)) where
  toFun g := extendPerm (strHom G n hn hG g) (blockHom hw hbs hGb g)
  map_one' := by
    rw [map_one, map_one]
    exact extendPerm_one
  map_mul' g h := by
    rw [map_mul, map_mul]
    exact extendPerm_mul _ _ _ _

theorem rebaseHom_lt (g : G) {x : Fin (n + bs.length)} (h : x.val < n) :
    (rebaseHom hn hG hw hbs hGb g x).val = (g.1 ⟨x.val, by omega⟩).val :=
  extendFun_lt _ _ h

theorem rebaseHom_ge (g : G) {x : Fin (n + bs.length)} (h : n ≤ x.val) :
    (rebaseHom hn hG hw hbs hGb g x).val = n + blockMap N bs g (x.val - n) :=
  extendFun_ge _ _ h

/-- On the new base, `rebaseHom` is the block action. -/
theorem rebaseHom_base (g : G) (t : ℕ) (ht : t < bs.length) :
    (rebaseHom hn hG hw hbs hGb g ⟨n + t, by omega⟩).val =
      n + (blockHom hw hbs hGb g ⟨t, ht⟩).val := by
  rw [rebaseHom_ge hn hG hw hbs hGb g (by simp), blockHom_apply]
  simp

/-- `rebaseHom` is injective when the group acts faithfully on the string positions. -/
theorem rebaseHom_injective
    (hfaith : ∀ g ∈ G, (∀ j : Fin N, j.val < n → g j = j) → g = 1) :
    Function.Injective (rebaseHom hn hG hw hbs hGb) := by
  rw [injective_iff_map_eq_one]
  intro g hg
  have h1 : g.1 = 1 := by
    apply hfaith g.1 g.2
    intro j hj
    have := congrArg (fun π : Perm (Fin (n + bs.length)) => (π ⟨j.val, by omega⟩).val) hg
    simp only [Perm.one_apply] at this
    rw [rebaseHom_lt hn hG hw hbs hGb g (show j.val < n from hj)] at this
    exact Fin.ext this
  exact Subtype.ext h1

end Hom

/-! ### The kept positions -/

/-- The kept positions: the string positions `[0, n)` and the block points `[N, N + k)`. -/
def keepPts (n N k : ℕ) : List ℕ := List.range n ++ blockPts N k

theorem length_keepPts (n N k : ℕ) : (keepPts n N k).length = n + k := by
  simp [keepPts, blockPts]

theorem getD_keepPts_lt {n N k j : ℕ} (hj : j < n) : (keepPts n N k).getD j 0 = j := by
  rw [keepPts, List.getD_eq_getElem?_getD, List.getElem?_append_left (by simpa using hj)]
  simp [hj]

theorem getD_keepPts_ge {n N k j : ℕ} (hj : n ≤ j) (hj' : j < n + k) :
    (keepPts n N k).getD j 0 = N + (j - n) := by
  rw [keepPts, List.getD_eq_getElem?_getD, List.getElem?_append_right (by simpa using hj)]
  simp only [List.length_range, blockPts]
  rw [List.getElem?_map, List.getElem?_range (by omega)]
  rfl

theorem nodup_keepPts {n N k : ℕ} (hn : n ≤ N) : (keepPts n N k).Nodup := by
  rw [keepPts, List.nodup_append]
  refine ⟨List.nodup_range, ?_, ?_⟩
  · exact List.nodup_range.map fun a b h => by simpa using h
  · intro a ha b hb
    rw [List.mem_range] at ha
    rw [mem_blockPts] at hb
    omega

theorem lt_of_mem_keepPts {n N k i : ℕ} (hn : n ≤ N) (hi : i ∈ keepPts n N k) : i < N + k := by
  rw [keepPts, List.mem_append, List.mem_range, mem_blockPts] at hi
  omega

/-- The kept positions as a window of degree `N + k`. -/
def keepWin (n N k : ℕ) : WinData := WinData.ofPoints (N + k) (keepPts n N k)

theorem valid_keepWin {n N k : ℕ} (hn : n ≤ N) : (keepWin n N k).Valid (N + k) :=
  WinData.valid_ofPoints (nodup_keepPts hn) fun _ h => lt_of_mem_keepPts hn h


/-! ### The re-based generators -/

/-- The re-based generator: extended by the block action, then restricted to the kept
positions. -/
def rebaseGen (n N : ℕ) (bs : List (List ℕ)) (g : PermData) : PermData :=
  PermData.restrictTo (WinData.pos (N + bs.length) (keepWin n N bs.length))
    (keepPts n N bs.length) (PermData.extendTo N (blockIdx N bs) (blockReps bs) g)

/-- The re-based generators. -/
def rebaseGens (n N : ℕ) (bs : List (List ℕ)) (gs : GensData) : GensData :=
  gs.map (rebaseGen n N bs)

section Gens

variable {N n : ℕ} {w : WinData} {bs : List (List ℕ)} {gs : GensData}
  (hn : n ≤ N) (hbase : IsInvariant (GensData.denote N gs) (baseSet n N)) (hw : w.Valid N)
  (hbs : IsBlockList w bs) (hGb : PermutesBlocks (GensData.denote N gs) bs)

include hn hbase in
/-- The kept positions are invariant under the extended group. -/
theorem isInvariant_keepWin :
    IsInvariant (extendHom hw hbs hGb).range ((keepWin n N bs.length).denote (N + bs.length)) := by
  rintro _ ⟨h, rfl⟩ u hu
  change u.val ∈ keepPts n N bs.length at hu
  change ((extendHom hw hbs hGb h) u).val ∈ keepPts n N bs.length
  rw [keepPts, List.mem_append, List.mem_range, mem_blockPts] at hu ⊢
  rcases hu with hu | hu
  · left
    rw [extendHom_lt hw hbs hGb h (show u.val < N by omega)]
    exact isInvariant_strSet hbase h.1 h.2 ⟨u.val, by omega⟩ (show u.val < n from hu)
  · right
    rw [extendHom_ge hw hbs hGb h hu.1]
    have := (blockMap_spec hw hbs hGb h.2 (show u.val - N < bs.length by omega)).1
    omega

include hn hbase in
/-- **A re-based generator** is valid of degree `n + k` and denotes `rebaseHom`. -/
theorem rebaseGen_spec {g : PermData} (hg : g.Valid N)
    (hgG : PermData.denote N g ∈ GensData.denote N gs) :
    (rebaseGen n N bs g).Valid (n + bs.length) ∧
      PermData.denote (n + bs.length) (rebaseGen n N bs g) =
        rebaseHom hn (isInvariant_strSet hbase) hw hbs hGb ⟨_, hgG⟩ := by
  set E := extendHom hw hbs hGb ⟨PermData.denote N g, hgG⟩ with hE
  have he : PermData.extendTo N (blockIdx N bs) (blockReps bs) g = PermData.ofPerm E :=
    extendTo_eq hw hbs hGb hg hgG
  have hwk := valid_keepWin (k := bs.length) hn
  have hinv := isInvariant_keepWin hn hbase hw hbs hGb
  have hEmem : PermData.denote (N + bs.length) (PermData.ofPerm E) ∈ (extendHom hw hbs hGb).range :=
    by rw [PermData.denote_ofPerm]; exact ⟨_, rfl⟩
  have hmaps := PermData.mapsWindow_of_mem hinv hwk (PermData.valid_ofPerm E) hEmem
  have hlen : (keepWin n N bs.length).1.length = n + bs.length := length_keepPts n N bs.length
  have hv0 := PermData.valid_restrictTo hwk (PermData.valid_ofPerm E) hmaps
  have hv : (rebaseGen n N bs g).Valid (n + bs.length) := by
    rw [rebaseGen, he, ← hlen]
    exact hv0
  refine ⟨hv, ?_⟩
  ext x
  rw [PermData.val_denote_apply hv]
  have hx := x.2
  simp only [rebaseGen, he, PermData.restrictTo]
  rw [get_list_toArray _ _ _ (by rw [length_keepPts]; exact hx)]
  -- the position of a kept point in the list
  have hpos : ∀ j < n + bs.length, get (WinData.pos (N + bs.length) (keepWin n N bs.length))
      ((keepPts n N bs.length).getD j 0) = j := fun j hj =>
    WinData.get_pos hwk (by rw [hlen]; exact hj)
  by_cases hxn : x.val < n
  · rw [getD_keepPts_lt hxn, rebaseHom_lt _ _ _ _ _ _ hxn]
    have hlt : x.val < N + bs.length := by omega
    rw [show get (PermData.ofPerm E).1 x.val = (E ⟨x.val, hlt⟩).val from
      get_ofFn (fun y => (E y).val) ⟨x.val, hlt⟩]
    rw [hE, extendHom_lt hw hbs hGb _ (show x.val < N by omega)]
    have hv' := isInvariant_strSet hbase _ hgG ⟨x.val, by omega⟩ (show x.val < n from hxn)
    change (PermData.denote N g ⟨x.val, _⟩).val < n at hv'
    have := hpos _ (show (PermData.denote N g ⟨x.val, by omega⟩).val < n + bs.length by omega)
    rwa [getD_keepPts_lt hv'] at this
  · have hxn' : n ≤ x.val := Nat.le_of_not_lt hxn
    rw [getD_keepPts_ge hxn' hx, rebaseHom_ge _ _ _ _ _ _ hxn']
    have hlt : N + (x.val - n) < N + bs.length := by omega
    rw [show get (PermData.ofPerm E).1 (N + (x.val - n)) = (E ⟨N + (x.val - n), hlt⟩).val from
      get_ofFn (fun y => (E y).val) ⟨N + (x.val - n), hlt⟩]
    rw [hE, extendHom_ge hw hbs hGb _ (show N ≤ N + (x.val - n) by omega)]
    simp only [Nat.add_sub_cancel_left]
    have ht := (blockMap_spec hw hbs hGb hgG (show x.val - n < bs.length by omega)).1
    have := hpos (n + blockMap N bs (PermData.denote N g) (x.val - n)) (by omega)
    rw [getD_keepPts_ge (by omega) (by omega)] at this
    simpa using this

end Gens


section GensDenote

variable {N n : ℕ} {w : WinData} {bs : List (List ℕ)} {gs : GensData}
  (hn : n ≤ N) (hbase : IsInvariant (GensData.denote N gs) (baseSet n N)) (hw : w.Valid N)
  (hbs : IsBlockList w bs) (hGb : PermutesBlocks (GensData.denote N gs) bs)

include hn hbase hw hbs hGb in
/-- The re-based generators are valid of degree `n + k`. -/
theorem allValid_rebaseGens (hgs : GensData.AllValid N gs) :
    GensData.AllValid (n + bs.length) (rebaseGens n N bs gs) := by
  intro l hl
  obtain ⟨g, hg, rfl⟩ := List.mem_map.1 hl
  exact (rebaseGen_spec hn hbase hw hbs hGb (hgs g hg) (GensData.mem_denote_of_mem hg)).1

/-- **The re-based generators generate the image of `rebaseHom`.** -/
theorem denote_rebaseGens (hgs : GensData.AllValid N gs) :
    GensData.denote (n + bs.length) (rebaseGens n N bs gs) =
      (rebaseHom hn (isInvariant_strSet hbase) hw hbs hGb).range := by
  have htop : Subgroup.closure (((↑) : GensData.denote N gs → Perm (Fin N)) ⁻¹'
      GensData.denoteSet N gs) = ⊤ := Subgroup.closure_closure_coe_preimage
  rw [MonoidHom.range_eq_map, ← htop, MonoidHom.map_closure]
  unfold GensData.denote
  congr 1
  ext π
  simp only [GensData.denoteSet, rebaseGens, List.mem_map, Set.mem_ofPred_eq, Set.mem_image,
    Set.mem_preimage]
  constructor
  · rintro ⟨_, ⟨g, hg, rfl⟩, rfl⟩
    exact ⟨⟨PermData.denote N g, GensData.mem_denote_of_mem hg⟩, ⟨g, hg, rfl⟩,
      (rebaseGen_spec hn hbase hw hbs hGb (hgs g hg) (GensData.mem_denote_of_mem hg)).2.symm⟩
  · rintro ⟨⟨_, hmem⟩, ⟨g, hg, rfl⟩, rfl⟩
    exact ⟨_, ⟨g, hg, rfl⟩, (rebaseGen_spec hn hbase hw hbs hGb (hgs g hg) hmem).2⟩

end GensDenote


/-! ### The re-based group -/

section Iso

variable {N n : ℕ} {w : WinData} {bs : List (List ℕ)} {G : Subgroup (Perm (Fin N))}
  (hn : n ≤ N) (hG : IsInvariant G (strSet n N)) (hw : w.Valid N) (hbs : IsBlockList w bs)
  (hGb : PermutesBlocks G bs)

/-- **Invariance**: the new base `[n, n + k)` and the string positions are invariant under the
re-based group. -/
theorem rebase_invariant :
    IsInvariant (rebaseHom hn hG hw hbs hGb).range (baseSet n (n + bs.length)) ∧
      IsInvariant (rebaseHom hn hG hw hbs hGb).range (strSet n (n + bs.length)) := by
  constructor
  · rintro _ ⟨g, rfl⟩ x hx
    change n ≤ x.val at hx
    change n ≤ (rebaseHom hn hG hw hbs hGb g x).val
    rw [rebaseHom_ge hn hG hw hbs hGb g hx]
    omega
  · rintro _ ⟨g, rfl⟩ x hx
    change x.val < n at hx
    change (rebaseHom hn hG hw hbs hGb g x).val < n
    rw [rebaseHom_lt hn hG hw hbs hGb g hx]
    exact hG g.1 g.2 ⟨x.val, by omega⟩ (show x.val < n from hx)

/-- **Faithfulness** on the string positions passes to the re-based group. -/
theorem rebase_faithful (hfaith : ∀ g ∈ G, (∀ j : Fin N, j.val < n → g j = j) → g = 1) :
    ∀ π ∈ (rebaseHom hn hG hw hbs hGb).range,
      (∀ j : Fin (n + bs.length), j.val < n → π j = j) → π = 1 := by
  rintro _ ⟨g, rfl⟩ hfix
  have h1 : g.1 = 1 := by
    apply hfaith g.1 g.2
    intro j hj
    have := congrArg Fin.val (hfix ⟨j.val, by omega⟩ hj)
    rw [rebaseHom_lt hn hG hw hbs hGb g (show j.val < n from hj)] at this
    exact Fin.ext this
  rw [show g = 1 from Subtype.ext h1, map_one]

/-- **The re-based group is isomorphic to the old one** when the old group acts faithfully on
the string positions: the isomorphism keeps the action on `[0, n)`, and on the new base it is
the action on the blocks. `hden` identifies a generating list of the re-based group, such as
the backend's output in `RunsWithin.rebaseProg`. -/
theorem rebase_iso (hfaith : ∀ g ∈ G, (∀ j : Fin N, j.val < n → g j = j) → g = 1)
    {hs : GensData}
    (hden : GensData.denote (n + bs.length) hs = (rebaseHom hn hG hw hbs hGb).range) :
    ∃ θ : ↥G ≃* ↥(GensData.denote (n + bs.length) hs),
      (∀ (g : G) (j : ℕ) (hj : j < n),
        ((θ g : Perm (Fin (n + bs.length))) ⟨j, by omega⟩).val = (g.1 ⟨j, by omega⟩).val) ∧
      (∀ (g : G) (t : ℕ) (ht : t < bs.length),
        ((θ g : Perm (Fin (n + bs.length))) ⟨n + t, by omega⟩).val =
          n + (blockHom hw hbs hGb g ⟨t, ht⟩).val) ∧
      ∀ (hinv : IsInvariant (GensData.denote (n + bs.length) hs) (baseSet n (n + bs.length)))
        (g : G) (t : Fin (n + bs.length - n)),
        (baseHom _ n hinv (θ g) t).val = (blockHom hw hbs hGb g ⟨t.val, by omega⟩).val := by
  let θ : ↥G ≃* ↥(GensData.denote (n + bs.length) hs) :=
    (MonoidHom.ofInjective (rebaseHom_injective hn hG hw hbs hGb hfaith)).trans
      (MulEquiv.subgroupCongr hden.symm)
  have hθ : ∀ g : G, (θ g : Perm (Fin (n + bs.length))) = rebaseHom hn hG hw hbs hGb g :=
    fun _ => rfl
  refine ⟨θ, fun g j hj => ?_, fun g t ht => ?_, fun hinv g t => ?_⟩
  · rw [hθ, rebaseHom_lt hn hG hw hbs hGb g (show j < n from hj)]
  · rw [hθ, rebaseHom_base hn hG hw hbs hGb g t ht]
  · change ((θ g : Perm (Fin (n + bs.length))) (basePos t)).val - n = _
    rw [hθ, show basePos t = (⟨n + t.val, by omega⟩ : Fin (n + bs.length)) from rfl,
      rebaseHom_base hn hG hw hbs hGb g t.val (by omega)]
    omega

end Iso


/-! ### The program -/

section Program

variable {D : Ty} {rec : Ty × Ty} {var : Ty → Type}

/-- **Re-basing**: extend every generator by the action on the blocks `bs`, restrict it to the
string positions `[0, n)` and the block points, and generate the group at degree
`n + |bs|`. -/
def rebaseProg (n N : var .nat) (gs : var Ty.gens) (bs : var (.list (.list .nat))) :
    Prog (groupSig D) rec var (Ty.group D) :=
  .bind (blockIdxProg N bs) fun bidx => .bind (blockRepsProg bs) fun reps =>
  .bind (.op1 .length bs) fun k => .bind (.op2 .add N k) fun Nk =>
  .bind (.op1 .range n) fun ss => .bind (.op1 .range k) fun ts =>
  .bind (mapList ts fun t => .op2 .add N t) fun nbs =>
  .bind (.op2 .append ss nbs) fun pts =>
  .bind (posProg Nk pts) fun pos =>
  .bind (mapList gs fun g =>
      .bind (extendProg N bidx reps g) fun e => restrictPermProg pos pts e) fun gs' =>
  .bind (.op2 .add n k) fun nk => .bind (.op2 .pair nk gs') fun arg =>
  Prog.call (S := groupSig D) GroupOp.generate arg

end Program

section Wf

variable {D : Ty} {rec : Ty × Ty} {var₁ var₂ : Ty → Type} {r : Bool} {Γ : WfCtx var₁ var₂}

theorem wf_rebaseProg {n₁ : var₁ .nat} {n₂ : var₂ .nat} {N₁ : var₁ .nat} {N₂ : var₂ .nat}
    {g₁ : var₁ Ty.gens} {g₂ : var₂ Ty.gens} {bs₁ : var₁ (.list (.list .nat))}
    {bs₂ : var₂ (.list (.list .nat))} (hn : ⟨.nat, n₁, n₂⟩ ∈ Γ) (hN : ⟨.nat, N₁, N₂⟩ ∈ Γ)
    (hg : ⟨Ty.gens, g₁, g₂⟩ ∈ Γ) (hbs : ⟨.list (.list .nat), bs₁, bs₂⟩ ∈ Γ) :
    Prog.Wf (rec := rec) r Γ (rebaseProg (D := D) n₁ N₁ g₁ bs₁)
      (rebaseProg (D := D) n₂ N₂ g₂ bs₂) := by
  unfold rebaseProg blockIdxProg blockRepsProg extendProg posProg restrictPermProg mapList
  prog_wf

end Wf

section Spec

variable {D : Ty} {a b : Ty} {X : Ctx (groupSig D)}
  {body : a.denote → Prog (groupSig D) (a, b) Ty.denote b} {DV : ℕ → GensData → D.denote → Prop}

/-- The backend operation used by `rebaseProg`. -/
def rebaseOps (op : GroupOp) : Prop := op = .generate

/-- The re-based group, as generated by the backend. -/
def rebaseModel (O : Oracle (groupSig D)) (n N : ℕ) (bs : List (List ℕ)) (gs : GensData) :
    GroupData D.denote :=
  O.run GroupOp.generate (n + bs.length, rebaseGens n N bs gs)

/-- The cost of `rebaseProg`: degree `N`, `n` string positions, `m` points in `k` blocks, `s`
generators, and `Bgen` bounding the charge of `generate`. -/
def rebaseCost (n N m k s Bgen : ℕ) : ℕ :=
  4 * N + 6 * m + 31 * k + 11 * n + s * (6 * N + 12 * n + 26 * k + 25) + 30 + Bgen

/-- **Re-basing.** The program computes a valid group of degree `n + |bs|`, generated by the
image of `rebaseHom`. -/
theorem RunsWithin.rebaseProg (hO : MeetsContractOn DV rebaseOps X.O)
    (hPre : ∀ op x, rebaseOps op → GroupPre DV op x → X.Pre op x) {n N : ℕ} {w : WinData}
    {bs : List (List ℕ)} {gs : GensData} (hn : n ≤ N)
    (hbase : IsInvariant (GensData.denote N gs) (baseSet n N)) (hw : w.Valid N)
    (hbs : IsBlockList w bs) (hGb : PermutesBlocks (GensData.denote N gs) bs)
    (hgs : GensData.AllValid N gs) {Bgen : ℕ}
    (hB : X.B.call GroupOp.generate (n + bs.length, rebaseGens n N bs gs)
      (rebaseModel X.O n N bs gs) ≤ Bgen) :
    RunsWithin X body (Toolkit.rebaseProg n N gs bs) (rebaseModel X.O n N bs gs)
        (rebaseCost n N bs.flatten.length bs.length gs.length Bgen) ∧
      (rebaseModel X.O n N bs gs).1 = n + bs.length ∧
      GroupValid DV (n + bs.length) (rebaseModel X.O n N bs gs).2.1
        (rebaseModel X.O n N bs gs).2.2 ∧
      GensData.denote (n + bs.length) (rebaseModel X.O n N bs gs).2.1 =
        (rebaseHom hn (isInvariant_strSet hbase) hw hbs hGb).range := by
  have hval := allValid_rebaseGens hn hbase hw hbs hGb hgs
  have hden := denote_rebaseGens hn hbase hw hbs hGb hgs
  have hpost := hO .generate (n + bs.length, rebaseGens n N bs gs) rfl hval
  have hlr : (blockReps bs).length = bs.length := by simp [blockReps]
  have hrun : RunsWithin X body (Toolkit.rebaseProg n N gs bs) (rebaseModel X.O n N bs gs)
      (rebaseCost n N bs.flatten.length bs.length gs.length Bgen) := by
    have hmapG := RunsWithin.mapList_le (X := X) (body := body) (a' := Ty.perm) (b' := Ty.perm)
      (xs := gs) (c := 6 * N + 14 * bs.length + 13 + (12 * (n + bs.length) + 9))
      (F := rebaseGen n N bs)
      (f := fun g => Prog.bind (Programs.extendProg N (blockIdx N bs) (blockReps bs) g)
        fun e => Programs.restrictPermProg (WinData.pos (N + bs.length) (keepWin n N bs.length))
          (keepPts n N bs.length) e) fun g hg => by
        have h1 := RunsWithin.extendProg (X := X) (body := body) (blockIdx N bs) (blockReps bs)
          (hgs g hg).size_fwd (hgs g hg).size_inv
        rw [hlr] at h1
        have h2 := RunsWithin.restrictPermProg (X := X) (body := body)
          (WinData.pos (N + bs.length) (keepWin n N bs.length)) (keepPts n N bs.length)
          (PermData.extendTo N (blockIdx N bs) (blockReps bs) g)
        rw [length_keepPts] at h2
        exact h1.bind h2
    have hmapP := RunsWithin.mapList_le (X := X) (body := body) (a' := .nat) (b' := .nat)
      (xs := List.range bs.length) (c := 1) (F := (N + ·))
      (f := fun t => Prog.op2 Prim.add N t) fun t _ => RunsWithin.prim _ _
    have hpos := RunsWithin.posProg (X := X) (body := body) (N + bs.length)
      (keepWin n N bs.length)
    rw [show (keepWin n N bs.length).1.length = n + bs.length from length_keepPts _ _ _] at hpos
    apply RunsWithin.mono
    case h =>
      run_step (RunsWithin.blockIdxProg N bs)
      run_step (RunsWithin.blockRepsProg bs)
      run_step (RunsWithin.prim _ _)
      run_step (RunsWithin.prim _ _)
      run_step (RunsWithin.prim _ _)
      run_step (RunsWithin.prim _ _)
      run_step hmapP
      run_step (RunsWithin.prim _ _)
      run_step hpos
      run_step hmapG
      run_step (RunsWithin.prim _ _)
      run_step (RunsWithin.prim _ _)
      exact RunsWithin.call (hPre _ _ rfl hval)
    case hc =>
      simp only [Prim.cost, Prim.eval, Args.head_cons, List.length_range]
      rw [rebaseModel, rebaseGens] at hB
      generalize X.B.call GroupOp.generate (n + bs.length, gs.map (rebaseGen n N bs))
        (X.O.run GroupOp.generate (n + bs.length, gs.map (rebaseGen n N bs))) = B at hB ⊢
      have hprod : gs.length * (6 * N + 14 * bs.length + 13 + (12 * (n + bs.length) + 9) + 3) =
          gs.length * (6 * N + 12 * n + 26 * bs.length + 25) := by ring
      rw [hprod]
      simp only [rebaseCost]
      omega
  refine ⟨hrun, ?_, ?_, ?_⟩
  · rcases hm : rebaseModel X.O n N bs gs with ⟨n', hs, d⟩
    rw [rebaseModel] at hm
    rw [hm] at hpost
    exact hpost.1
  · rcases hm : rebaseModel X.O n N bs gs with ⟨n', hs, d⟩
    rw [rebaseModel] at hm
    rw [hm] at hpost
    exact hpost.2.1
  · rcases hm : rebaseModel X.O n N bs gs with ⟨n', hs, d⟩
    rw [rebaseModel] at hm
    rw [hm] at hpost
    rw [← hden]
    exact hpost.2.2

end Spec


end GraphIso.Toolkit
