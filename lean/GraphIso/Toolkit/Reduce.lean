/-!
# Reductions: kernels, stabilizers and lifts on the base

Costed programs over the backend contract for the group reductions of the macro-steps
(`PLAN-14.md` §6 item 6). The group `G = ⟨gs⟩` acts at degree `N`, the base positions
`[n, N)` are invariant, and `ψ = baseHom G n hG` is the base action. Every program is proved
for an arbitrary oracle meeting the contract on the operations it calls, with the backend
charges as hypotheses, and is well-formed (section `Wf`).

* `baseWinProg`: the base window `baseWin n N`, denoting `baseSet n N`.
* `kerProg`: generators of `ker ψ` (the pointwise stabilizer of the base) by `kernel`, and a
  left transversal by `cosetReps` with `|ψ(G)|` representatives (`RunsWithin.kerProg`).
* `liftProg`: for `π ∈ ψ(G)`, an element `r ∈ G` with `ψ(r) = π`, by `lift` on the base
  window (`RunsWithin.liftProg`).
* `iterStabProg`: the pointwise stabilizer of a list of points by iterated `stabilizer`
  (`RunsWithin.iterStabProg`).
* `pointStabsProg`: the pointwise stabilizer of a list of base points together with a left
  cover of `G` by its cosets, made of at most `(N - n)^r` products of `orbitTransversal`
  elements (`RunsWithin.pointStabsProg`).
* `giantSetStabProg`: for a giant base action and a list `A` of base points, the preimage of
  the setwise stabilizer of `A` (stage 14a's `blockStab ψ A`). It is generated by the pointwise
  stabilizer of the positions of `A` and lifts of `(a₀ x)(b₁ b₂)`, `x ∈ A ∖ {a₀}`, with
  `b₁ ≠ b₂` base points outside `A` (`RunsWithin.giantSetStabProg`). The group theory is
  `setStab_eq_closure` and `star_gen`.
-/

@[expose] public section

namespace GraphIso.Toolkit

open Equiv Cost GraphIso.Programs GraphIso.Solver

/-! ### The base window -/

/-- The base window. -/
def baseWin (n N : ℕ) : WinData := WinData.ofPoints N (basePts n N)

theorem getD_basePts {n N j : ℕ} (hj : j < N - n) : (basePts n N).getD j 0 = n + j := by
  simp [basePts, List.getD_eq_getElem?_getD, hj]

theorem baseWin_valid (n N : ℕ) : (baseWin n N).Valid N := by
  refine WinData.valid_ofPoints ?_ fun i hi => (mem_basePts.1 hi).2
  exact (List.nodup_range).map fun a b h => by simpa using h

theorem baseWin_denote (n N : ℕ) : (baseWin n N).denote N = baseSet n N := by
  ext u
  simp only [baseWin, WinData.denote_ofPoints, Set.mem_ofPred_eq, mem_basePts, baseSet]
  exact ⟨fun h => h.1, fun h => ⟨h, u.2⟩⟩

section Programs

variable {D : Ty} {S : Signature} {rec : Ty × Ty} {var : Ty → Type}

/-- The base window as a program. -/
def baseWinProg (n N : var .nat) : Prog S rec var Ty.win :=
  .bind (.op2 .sub N n) fun m => .bind (.op1 .range m) fun is =>
  .bind (mapList is fun i => .op2 .add n i) fun bp => mkWindow N bp

end Programs

/-- The cost of building the base window. -/
def baseWinCost (n N : ℕ) : ℕ := 2 * N + 10 * (N - n) + 11

section Specs

variable {S : Signature} {a b : Ty} {X : Ctx S} {body : a.denote → Prog S (a, b) Ty.denote b}

theorem RunsWithin.baseWinProg (n N : ℕ) :
    RunsWithin X body (Toolkit.baseWinProg n N) (baseWin n N) (baseWinCost n N) := by
  have hm := RunsWithin.mapList_le (X := X) (body := body) (a' := .nat) (b' := .nat)
    (xs := List.range (N - n)) (c := 1) (F := (n + ·)) (f := fun i => Prog.op2 Prim.add n i)
    fun i _ => RunsWithin.prim _ _
  apply RunsWithin.mono
  case h =>
    run_step (RunsWithin.prim _ _)
    run_step (RunsWithin.prim _ _)
    run_step hm
    exact RunsWithin.mkWindow _ _
  case hc =>
    simp only [Prim.cost, Prim.eval, Args.head_cons, List.length_range, List.length_map,
      baseWinCost]
    omega

end Specs

/-! ### The kernel of the base action -/

section KerProgram

variable {D : Ty} {rec : Ty × Ty} {var : Ty → Type}

/-- Generators of `ker ψ` (the pointwise stabilizer of the base) and a left transversal. -/
def kerProg (n : var .nat) (G : var (Ty.group D)) :
    Prog (groupSig D) rec var (.prod (Ty.group D) (.list Ty.perm)) :=
  .bind (.op1 .fst G) fun N =>
  .bind (baseWinProg n N) fun bw =>
  .bind (.op2 .pair G bw) fun a₁ =>
  .bind (Prog.call (S := groupSig D) GroupOp.kernel a₁) fun K =>
  .bind (.op2 .pair G K) fun a₂ =>
  .bind (Prog.call (S := groupSig D) GroupOp.cosetReps a₂) fun rs =>
  .op2 .pair K rs

end KerProgram

section Kernel

variable {D : Ty} {a b : Ty} {X : Ctx (groupSig D)}
  {body : a.denote → Prog (groupSig D) (a, b) Ty.denote b} {DV : ℕ → GensData → D.denote → Prop}

/-- The kernel of the base action, as computed by the backend. -/
def kerModel (O : Oracle (groupSig D)) (n : ℕ) (G : GroupData D.denote) : GroupData D.denote :=
  O.run GroupOp.kernel (G, baseWin n G.1)

/-- The transversal of the kernel, as computed by the backend. -/
def kerReps (O : Oracle (groupSig D)) (n : ℕ) (G : GroupData D.denote) : List PermData :=
  O.run GroupOp.cosetReps (G, kerModel O n G)

/-- The operations used by `kerProg`. -/
def kerOps (op : GroupOp) : Prop := op = .kernel ∨ op = .cosetReps

/-- The pointwise stabilizer of the base is the kernel of the base action. -/
theorem pointwiseStab_base_eq {N : ℕ} {G : Subgroup (Perm (Fin N))} {n : ℕ}
    (hG : IsInvariant G (baseSet n N)) :
    pointwiseStab G (baseSet n N) = (baseHom G n hG).ker.map G.subtype := by
  ext g
  constructor
  · rintro ⟨hg, hfix⟩
    refine ⟨⟨g, hg⟩, ?_, rfl⟩
    rw [SetLike.mem_coe, MonoidHom.mem_ker]
    ext j
    have h := baseHom_apply (hG := hG) ⟨g, hg⟩ j
    rw [hfix _ (basePos_mem j)] at h
    have := congrArg Fin.val h
    simp only [basePos] at this
    simp only [Perm.coe_one, id_eq]
    omega
  · rintro ⟨g', hg', rfl⟩
    refine ⟨g'.2, fun u hu => ?_⟩
    rw [SetLike.mem_coe, MonoidHom.mem_ker] at hg'
    have h := baseHom_apply (hG := hG) g' ⟨u.val - n, lt_of_mem_baseSet hu⟩
    rw [hg', Perm.coe_one, id_eq, basePos_sub hu] at h
    exact h.symm

/-- **The kernel of the base action** with a left transversal of `|ψ(G)|` representatives. -/
theorem RunsWithin.kerProg (hO : MeetsContractOn DV kerOps X.O)
    (hPre : ∀ op x, kerOps op → GroupPre DV op x → X.Pre op x)
    {n N : ℕ} {gs : GensData} {d : D.denote} (hGv : GroupValid DV N gs d)
    (hG : IsInvariant (GensData.denote N gs) (baseSet n N)) {Bk Bc : ℕ}
    (hBk : X.B.call GroupOp.kernel ((N, gs, d), baseWin n N) (kerModel X.O n (N, gs, d)) ≤ Bk)
    (hBc : X.B.call GroupOp.cosetReps ((N, gs, d), kerModel X.O n (N, gs, d))
      (kerReps X.O n (N, gs, d)) ≤ Bc) :
    RunsWithin X body (Toolkit.kerProg n (N, gs, d))
        (kerModel X.O n (N, gs, d), kerReps X.O n (N, gs, d)) (baseWinCost n N + Bk + Bc + 4) ∧
      (kerModel X.O n (N, gs, d)).1 = N ∧
      GroupValid DV N (kerModel X.O n (N, gs, d)).2.1 (kerModel X.O n (N, gs, d)).2.2 ∧
      GensData.denote N (kerModel X.O n (N, gs, d)).2.1 =
        pointwiseStab (GensData.denote N gs) (baseSet n N) ∧
      GensData.denote N (kerModel X.O n (N, gs, d)).2.1 =
        (baseHom (GensData.denote N gs) n hG).ker.map (GensData.denote N gs).subtype ∧
      (∀ r ∈ kerReps X.O n (N, gs, d), PermData.Valid N r) ∧
      IsLeftTransversal (GensData.denote N gs) (GensData.denote N (kerModel X.O n (N, gs, d)).2.1)
        (fun i : Fin (kerReps X.O n (N, gs, d)).length =>
          PermData.denote N ((kerReps X.O n (N, gs, d)).get i)) ∧
      (kerReps X.O n (N, gs, d)).length = Nat.card (baseHom (GensData.denote N gs) n hG).range := by
  have hbw := baseWin_valid n N
  have hbwd := baseWin_denote n N
  have hkpre : GroupPre DV .kernel ((N, gs, d), baseWin n N) := ⟨hGv, hbw, by rw [hbwd]; exact hG⟩
  have hkpost := hO .kernel _ (Or.inl rfl) hkpre
  have hKm : kerModel X.O n (N, gs, d) = X.O.run GroupOp.kernel ((N, gs, d), baseWin n N) := rfl
  rcases hK : X.O.run GroupOp.kernel ((N, gs, d), baseWin n N) with ⟨N', ks, e⟩
  rw [hK] at hkpost hKm
  obtain ⟨hN', hKv, hKden⟩ := hkpost
  change N' = N at hN'
  subst N'
  change GensData.denote N ks = pointwiseStab _ (WinData.denote N (baseWin n N)) at hKden
  rw [hbwd] at hKden
  have hcpre : GroupPre DV .cosetReps ((N, gs, d), (N, ks, e)) :=
    ⟨hGv, hKv, rfl, by rw [hKden]; exact pointwiseStab_le _ _⟩
  have hcpost := hO .cosetReps _ (Or.inr rfl) hcpre
  have hRm : kerReps X.O n (N, gs, d) = X.O.run GroupOp.cosetReps ((N, gs, d), (N, ks, e)) := by
    rw [kerReps, hKm]
  rw [hKm] at hBk hBc ⊢
  rw [hRm] at hBc ⊢
  obtain ⟨hrv, htr⟩ := hcpost
  refine ⟨?_, rfl, hKv, hKden, hKden.trans (pointwiseStab_base_eq hG), hrv, htr, ?_⟩
  · apply RunsWithin.mono
    case h =>
      run_step (RunsWithin.prim _ _)
      run_step (RunsWithin.baseWinProg n N)
      run_step (RunsWithin.prim _ _)
      run_step (RunsWithin.call (hPre _ _ (Or.inl rfl) hkpre))
      simp only [Prim.eval]
      rw [hK]
      run_step (RunsWithin.prim _ _)
      run_step (RunsWithin.call (hPre _ _ (Or.inr rfl) hcpre))
      exact RunsWithin.prim_le rfl le_rfl
    case hc =>
      have hp1 : Prim.eval (Prim.pair (a := Ty.group D) (b := Ty.win))
          (Args.cons (N, gs, d) (Args.cons (baseWin n N) Args.nil)) = ((N, gs, d), baseWin n N) :=
        rfl
      have hp2 : Prim.eval (Prim.pair (a := Ty.group D) (b := (groupSig D).res GroupOp.kernel))
          (Args.cons (N, gs, d) (Args.cons (N, ks, e) Args.nil)) = ((N, gs, d), (N, ks, e)) :=
        rfl
      simp only [Prim.cost]
      rw [hp1, hK, hp2]
      omega
  · have hcard := htr.card_eq (by rw [hKden]; exact pointwiseStab_le _ _)
    rw [hKden, pointwiseStab_base_eq hG] at hcard
    have hmul := Subgroup.card_mul_index (baseHom (GensData.denote N gs) n hG).ker
    rw [Subgroup.index_ker] at hmul
    have hmap : Nat.card ((baseHom (GensData.denote N gs) n hG).ker.map
        (GensData.denote N gs).subtype) = Nat.card (baseHom (GensData.denote N gs) n hG).ker :=
      Subgroup.card_map_of_injective (GensData.denote N gs).subtype_injective
    rw [hmap] at hcard
    have hpos : 0 < Nat.card (baseHom (GensData.denote N gs) n hG).ker := Nat.card_pos
    have : Nat.card (GensData.denote N gs) =
        Nat.card (baseHom (GensData.denote N gs) n hG).ker *
          Nat.card (baseHom (GensData.denote N gs) n hG).range := by
      rw [hmul]
    rw [this, Nat.mul_comm] at hcard
    exact (Nat.eq_of_mul_eq_mul_right hpos hcard).symm

end Kernel

/-! ### Lifting a permutation of the base -/

section LiftProgram

variable {D : Ty} {rec : Ty × Ty} {var : Ty → Type}

/-- Lift a permutation `π` of the base (degree `N - n`) to an element of `G`. -/
def liftProg (n : var .nat) (G : var (Ty.group D)) (π : var Ty.perm) :
    Prog (groupSig D) rec var Ty.perm :=
  .bind (.op1 .fst G) fun N => .bind (baseWinProg n N) fun bw =>
  .bind (.op2 .pair bw π) fun wp => .bind (.op2 .pair G wp) fun a₁ =>
  Prog.call (S := groupSig D) GroupOp.lift a₁

end LiftProgram

section Lift

variable {D : Ty} {a b : Ty} {X : Ctx (groupSig D)}
  {body : a.denote → Prog (groupSig D) (a, b) Ty.denote b} {DV : ℕ → GensData → D.denote → Prop}

/-- The lift, as computed by the backend. -/
def liftModel (O : Oracle (groupSig D)) (n : ℕ) (G : GroupData D.denote) (π : PermData) :
    PermData :=
  O.run GroupOp.lift (G, (baseWin n G.1, π))

/-- The operations used by `liftProg`. -/
def liftOps (op : GroupOp) : Prop := op = .lift

/-- Lifting through the base window: `r` maps base position `n + j` to `n + π j`. -/
theorem mapsWindowBy_base_iff {n N : ℕ} {G : Subgroup (Perm (Fin N))}
    (hG : IsInvariant G (baseSet n N)) {r π : PermData} (hr : r.Valid N)
    (hrG : PermData.denote N r ∈ G) (hπ : π.Valid (N - n)) :
    MapsWindowBy (baseWin n N) r π ↔ baseHom G n hG ⟨_, hrG⟩ = PermData.denote (N - n) π := by
  have key : ∀ j : Fin (N - n), n + (baseHom G n hG ⟨_, hrG⟩ j).val = get r.1 (n + j.val) := by
    intro j
    have h := congrArg Fin.val (baseHom_apply (hG := hG) ⟨_, hrG⟩ j)
    simp only [basePos] at h
    rw [h, PermData.val_denote_apply hr]
  simp only [MapsWindowBy, baseWin, WinData.ofPoints_fst, length_basePts]
  constructor
  · intro h
    ext j
    have hj := h j.val j.2
    rw [getD_basePts j.2, getD_basePts (hπ.fwd_lt j j.2), ← key j] at hj
    rw [PermData.val_denote_apply hπ]
    omega
  · intro h j hj
    have hk := key ⟨j, hj⟩
    rw [h, PermData.val_denote_apply hπ] at hk
    rw [getD_basePts hj, getD_basePts (hπ.fwd_lt j hj), ← hk]

/-- **Lifting**: for `π ∈ ψ(G)`, the backend returns `r ∈ G` with `ψ(r) = π`. -/
theorem RunsWithin.liftProg (hO : MeetsContractOn DV liftOps X.O)
    (hPre : ∀ op x, liftOps op → GroupPre DV op x → X.Pre op x)
    {n N : ℕ} {gs : GensData} {d : D.denote} (hGv : GroupValid DV N gs d)
    (hG : IsInvariant (GensData.denote N gs) (baseSet n N)) {π : PermData}
    (hπ : π.Valid (N - n))
    (hπG : PermData.denote (N - n) π ∈ (baseHom (GensData.denote N gs) n hG).range) {Bl : ℕ}
    (hBl : X.B.call GroupOp.lift ((N, gs, d), (baseWin n N, π)) (liftModel X.O n (N, gs, d) π)
      ≤ Bl) :
    RunsWithin X body (Toolkit.liftProg n (N, gs, d) π) (liftModel X.O n (N, gs, d) π)
        (baseWinCost n N + Bl + 3) ∧
      PermData.Valid N (liftModel X.O n (N, gs, d) π) ∧
      ∃ h : PermData.denote N (liftModel X.O n (N, gs, d) π) ∈ GensData.denote N gs,
        baseHom (GensData.denote N gs) n hG ⟨_, h⟩ = PermData.denote (N - n) π := by
  have hbw := baseWin_valid n N
  have hbwd := baseWin_denote n N
  obtain ⟨g, hg⟩ := hπG
  have hgr : PermData.denote N (PermData.ofPerm g.1) ∈ GensData.denote N gs := by
    rw [PermData.denote_ofPerm]
    exact g.2
  have hpre : GroupPre DV .lift ((N, gs, d), (baseWin n N, π)) := by
    refine ⟨hGv, hbw, by rw [hbwd]; exact hG, ?_, ⟨PermData.ofPerm g.1,
      PermData.valid_ofPerm _, hgr, ?_⟩⟩
    · rw [baseWin, WinData.ofPoints_fst, length_basePts]
      exact hπ
    · refine (mapsWindowBy_base_iff hG (PermData.valid_ofPerm _) hgr hπ).2 ?_
      rw [← hg]
      congr 1
      exact Subtype.ext (PermData.denote_ofPerm _)
  obtain ⟨hrv, hrG, hmaps⟩ := hO .lift _ rfl hpre
  refine ⟨?_, hrv, hrG, (mapsWindowBy_base_iff hG hrv hrG hπ).1 hmaps⟩
  apply RunsWithin.mono
  case h =>
    run_step (RunsWithin.prim _ _)
    run_step (RunsWithin.baseWinProg n N)
    run_step (RunsWithin.prim _ _)
    run_step (RunsWithin.prim _ _)
    exact RunsWithin.call (hPre _ _ rfl hpre)
  case hc =>
    have hp : Prim.eval (Prim.pair (a := Ty.group D) (b := .prod Ty.win Ty.perm))
        (Args.cons (N, gs, d) (Args.cons (Prim.eval (Prim.pair (a := Ty.win) (b := Ty.perm))
          (Args.cons (baseWin n N) (Args.cons π Args.nil))) Args.nil)) =
        ((N, gs, d), (baseWin n N, π)) := rfl
    have hBl' : X.B.call GroupOp.lift ((N, gs, d), (baseWin n N, π))
        (X.O.run GroupOp.lift ((N, gs, d), (baseWin n N, π))) ≤ Bl := hBl
    simp only [Prim.cost]
    rw [hp]
    omega

end Lift

/-! ### Pointwise stabilizers of lists of points -/

section StabPrograms

variable {D : Ty} {rec : Ty × Ty} {var : Ty → Type}

/-- The pointwise stabilizer of a list of points, by iterated `stabilizer`. -/
def iterStabProg (G : var (Ty.group D)) (ps : var (.list .nat)) :
    Prog (groupSig D) rec var (Ty.group D) :=
  .foldList ps G fun H b =>
    .bind (.op2 .pair H b) fun hb => Prog.call (S := groupSig D) GroupOp.stabilizer hb

end StabPrograms

section Stab

variable {D : Ty} {a b : Ty} {X : Ctx (groupSig D)}
  {body : a.denote → Prog (groupSig D) (a, b) Ty.denote b} {DV : ℕ → GensData → D.denote → Prop}

/-- The iterated stabilizer, as computed by the backend. -/
def iterStabModel (O : Oracle (groupSig D)) (G : GroupData D.denote) (ps : List ℕ) :
    GroupData D.denote :=
  ps.foldl (fun H b => O.run GroupOp.stabilizer (H, b)) G

/-- The operations used for stabilizers and transversals. -/
def stabOps (op : GroupOp) : Prop := op = .stabilizer ∨ op = .orbitTransversal

theorem pointwiseStab_pointStab {N : ℕ} (G : Subgroup (Perm (Fin N))) (u : Fin N)
    (ps : List ℕ) : pointwiseStab (pointStab G u) {v : Fin N | v.val ∈ ps} =
      pointwiseStab G {v : Fin N | v.val ∈ u.val :: ps} := by
  ext g
  simp only [pointwiseStab, Subgroup.mem_mk, Set.mem_ofPred_eq, mem_pointStab, List.mem_cons]
  constructor
  · rintro ⟨⟨hg, hu⟩, h⟩
    refine ⟨hg, fun v hv => ?_⟩
    rcases hv with hv | hv
    · rw [show v = u from Fin.ext hv, hu]
    · exact h v hv
  · rintro ⟨hg, h⟩
    exact ⟨⟨hg, h u (Or.inl rfl)⟩, fun v hv => h v (Or.inr hv)⟩

/-- **Iterated stabilizers**: the result is the pointwise stabilizer of the listed points. -/
theorem iterStab_spec (hO : MeetsContractOn DV stabOps X.O)
    (hPre : ∀ op x, stabOps op → GroupPre DV op x → X.Pre op x) {N s : ℕ}
    {G₀ : Subgroup (Perm (Fin N))} (B : BackendBounds X DV N s G₀) :
    ∀ (ps : List ℕ), (∀ u ∈ ps, u < N) → ∀ (ks : GensData) (e : D.denote),
      GroupValid DV N ks e → ks.length ≤ s → GensData.denote N ks ≤ G₀ →
      RunsWithin X body (Toolkit.iterStabProg (N, ks, e) ps) (iterStabModel X.O (N, ks, e) ps)
          (ps.length * (B.Bstab + 2)) ∧
        (iterStabModel X.O (N, ks, e) ps).1 = N ∧
        GroupValid DV N (iterStabModel X.O (N, ks, e) ps).2.1
          (iterStabModel X.O (N, ks, e) ps).2.2 ∧
        GensData.denote N (iterStabModel X.O (N, ks, e) ps).2.1 =
          pointwiseStab (GensData.denote N ks) {v : Fin N | v.val ∈ ps} := by
  intro ps
  induction ps with
  | nil =>
    intro _ ks e hv _ _
    refine ⟨?_, rfl, hv, ?_⟩
    · exact (RunsWithin.foldList_nil (X := X) (body := body)).mono (Nat.zero_le _)
    · show GensData.denote N ks = pointwiseStab _ {v : Fin N | v.val ∈ ([] : List ℕ)}
      ext g
      simp [pointwiseStab]
  | cons u ps ih =>
    intro hps ks e hv hlen hle
    have hu : u < N := hps u List.mem_cons_self
    have hpre : GroupPre DV .stabilizer ((N, ks, e), u) := ⟨hv, hu⟩
    have hpost := hO .stabilizer _ (Or.inl rfl) hpre
    have hBu := B.stabilizer ks e u hlen hle hpre
    have hout := B.stabOut ks e u hle hpre
    rcases hS : X.O.run GroupOp.stabilizer ((N, ks, e), u) with ⟨N', ks', e'⟩
    rw [hS] at hpost hBu hout
    obtain ⟨hN', hv', hden⟩ := hpost
    change N' = N at hN'
    subst N'
    have hden' : GensData.denote N ks' = pointStab (GensData.denote N ks) ⟨u, hu⟩ := hden hu
    have hle' : GensData.denote N ks' ≤ G₀ := by
      rw [hden']
      exact inf_le_left.trans hle
    obtain ⟨hrun, hN, hvv, hdd⟩ :=
      ih (fun v hv => hps v (List.mem_cons_of_mem _ hv)) ks' e' hv' hout hle'
    have hmodel : iterStabModel X.O (N, ks, e) (u :: ps) = iterStabModel X.O (N, ks', e') ps := by
      show List.foldl _ (X.O.run GroupOp.stabilizer ((N, ks, e), u)) ps = _
      rw [hS]
      rfl
    rw [hmodel]
    refine ⟨?_, hN, hvv, ?_⟩
    · have h1 : RunsWithin X body (.bind (.op2 .pair ((N, ks, e) : (Ty.group D).denote) u)
          fun hb => Prog.call (S := groupSig D) GroupOp.stabilizer hb) (N, ks', e')
          (1 + B.Bstab) := by
        refine RunsWithin.bind_le (RunsWithin.prim _ _)
          ((RunsWithin.call (hPre _ _ (Or.inl rfl) hpre)).of_eq hS) ?_
        simp only [Prim.cost]
        rw [hS]
        exact Nat.add_le_add_left hBu 1
      have := RunsWithin.foldList_cons h1 hrun
      refine this.mono ?_
      simp only [List.length_cons]
      ring_nf
      omega
    · rw [hdd, hden', pointwiseStab_pointStab]

/-- **The pointwise stabilizer of a list of points**, by iterated `stabilizer`. -/
theorem RunsWithin.iterStabProg (hO : MeetsContractOn DV stabOps X.O)
    (hPre : ∀ op x, stabOps op → GroupPre DV op x → X.Pre op x) {N : ℕ} {gs : GensData}
    {d : D.denote} (hGv : GroupValid DV N gs d) {ps : List ℕ} (hps : ∀ u ∈ ps, u < N) {s : ℕ}
    {G₀ : Subgroup (Perm (Fin N))} (B : BackendBounds X DV N s G₀) (hs : gs.length ≤ s)
    (hG₀ : GensData.denote N gs ≤ G₀) :
    RunsWithin X body (Toolkit.iterStabProg (N, gs, d) ps) (iterStabModel X.O (N, gs, d) ps)
        (ps.length * (B.Bstab + 2)) ∧
      (iterStabModel X.O (N, gs, d) ps).1 = N ∧
      GroupValid DV N (iterStabModel X.O (N, gs, d) ps).2.1
        (iterStabModel X.O (N, gs, d) ps).2.2 ∧
      GensData.denote N (iterStabModel X.O (N, gs, d) ps).2.1 =
        pointwiseStab (GensData.denote N gs) {v : Fin N | v.val ∈ ps} :=
  iterStab_spec hO hPre B ps hps gs d hGv hs hG₀

end Stab

/-! ### Coset representatives as products of transversals -/

section ProdPrograms

variable {S : Signature} {rec : Ty × Ty} {var : Ty → Type}

/-- The products `r * t` for `r` in a list and `(v, t)` in a transversal. -/
def prodRepsProg (reps : var (.list Ty.perm)) (tr : var (.list (.prod .nat Ty.perm))) :
    Prog S rec var (.list Ty.perm) :=
  .bind (.op0 .nil) fun nil =>
  .foldList reps nil fun acc r =>
    .bind (mapList tr fun vt => .bind (.op1 .snd vt) fun t => permMul r t) fun l =>
    .op2 .append l acc

end ProdPrograms

/-- The products `r * t`, as data. -/
def prodReps (reps : List PermData) (tr : List (ℕ × PermData)) : List PermData :=
  reps.foldl (fun acc r => (tr.map fun vt => PermData.mul r vt.2) ++ acc) []

theorem mem_prodReps {reps : List PermData} {tr : List (ℕ × PermData)} {x : PermData} :
    x ∈ prodReps reps tr ↔ ∃ r ∈ reps, ∃ vt ∈ tr, x = PermData.mul r vt.2 := by
  have key : ∀ (rs : List PermData) (acc : List PermData),
      x ∈ rs.foldl (fun acc r => (tr.map fun vt => PermData.mul r vt.2) ++ acc) acc ↔
        x ∈ acc ∨ ∃ r ∈ rs, ∃ vt ∈ tr, x = PermData.mul r vt.2 := by
    intro rs
    induction rs with
    | nil => intro acc; simp
    | cons r rs ih =>
      intro acc
      rw [List.foldl_cons, ih]
      simp only [List.mem_append, List.mem_map, List.mem_cons]
      constructor
      · rintro ((⟨vt, hvt, rfl⟩ | h) | ⟨r', hr', vt, hvt, rfl⟩)
        · exact Or.inr ⟨r, Or.inl rfl, vt, hvt, rfl⟩
        · exact Or.inl h
        · exact Or.inr ⟨r', Or.inr hr', vt, hvt, rfl⟩
      · rintro (h | ⟨r', (rfl | hr'), vt, hvt, rfl⟩)
        · exact Or.inl (Or.inr h)
        · exact Or.inl (Or.inl ⟨vt, hvt, rfl⟩)
        · exact Or.inr ⟨r', hr', vt, hvt, rfl⟩
  rw [prodReps, key]
  simp

theorem length_prodReps (reps : List PermData) (tr : List (ℕ × PermData)) :
    (prodReps reps tr).length = reps.length * tr.length := by
  have key : ∀ (rs : List PermData) (acc : List PermData),
      (rs.foldl (fun acc r => (tr.map fun vt => PermData.mul r vt.2) ++ acc) acc).length =
        acc.length + rs.length * tr.length := by
    intro rs
    induction rs with
    | nil => intro acc; simp
    | cons r rs ih =>
      intro acc
      rw [List.foldl_cons, ih]
      simp only [List.length_append, List.length_map, List.length_cons]
      ring
  rw [prodReps, key]
  simp

section ProdSpecs

variable {S : Signature} {a b : Ty} {X : Ctx S} {body : a.denote → Prog S (a, b) Ty.denote b}

theorem RunsWithin.prodRepsProg {N : ℕ} {reps : List PermData} {tr : List (ℕ × PermData)}
    (hr : ∀ r ∈ reps, PermData.Valid N r) (ht : ∀ vt ∈ tr, PermData.Valid N vt.2) :
    RunsWithin X body (Toolkit.prodRepsProg reps tr) (prodReps reps tr)
      (1 + reps.length * (tr.length * (12 * N + 18) + 4)) := by
  have hbody : ∀ (acc : List PermData), ∀ r ∈ reps, RunsWithin X body
      (.bind (mapList (a' := .prod .nat Ty.perm) (b' := Ty.perm) tr fun vt =>
        .bind (.op1 .snd vt) fun t => permMul r t) fun l => .op2 .append l acc)
      ((tr.map fun vt => PermData.mul r vt.2) ++ acc) (tr.length * (12 * N + 18) + 3) := by
    intro acc r hrm
    have hm := RunsWithin.mapList_le (X := X) (body := body) (a' := .prod .nat Ty.perm)
      (b' := Ty.perm) (xs := tr) (c := 12 * N + 14) (F := fun vt => PermData.mul r vt.2)
      (f := fun vt => .bind (.op1 .snd vt) fun t => permMul r t) fun vt hvt =>
        RunsWithin.bind_le (RunsWithin.prim _ _) (RunsWithin.permMul (hr r hrm) (ht vt hvt))
          (by simp [Prim.cost]; omega)
    refine RunsWithin.bind_le hm (RunsWithin.prim_le rfl le_rfl) ?_
    simp only [Prim.cost, Args.head_cons, List.length_map]
    ring_nf
    omega
  have hf := RunsWithin.foldList_of (X := X) (body := body) (a' := Ty.perm) (b' := .list Ty.perm)
    (cf := fun _ => tr.length * (12 * N + 18) + 3)
    (F := fun acc r => (tr.map fun vt => PermData.mul r vt.2) ++ acc) reps [] hbody
  refine RunsWithin.bind_le (RunsWithin.prim _ _) hf ?_
  simp only [Prim.cost, List.map_const', List.sum_replicate, smul_eq_mul]
  ring_nf
  omega

end ProdSpecs

/-! ### Pointwise stabilizers with coset representatives -/

section PSPrograms

variable {D : Ty} {rec : Ty × Ty} {var : Ty → Type}

/-- One step: a transversal of the current group on the orbit of `u`, the stabilizer of `u`,
and the products of the representatives with the transversal. -/
def psBody (acc : var (.prod (Ty.group D) (.list Ty.perm))) (u : var .nat) :
    Prog (groupSig D) rec var (.prod (Ty.group D) (.list Ty.perm)) :=
  .bind (.op1 .fst acc) fun H => .bind (.op1 .snd acc) fun reps =>
  .bind (.op2 .pair H u) fun hu =>
  .bind (Prog.call (S := groupSig D) GroupOp.orbitTransversal hu) fun tr =>
  .bind (Prog.call (S := groupSig D) GroupOp.stabilizer hu) fun H' =>
  .bind (prodRepsProg reps tr) fun reps' =>
  .op2 .pair H' reps'

/-- The pointwise stabilizer of a list of points, with a left cover of `G` by its cosets made
of products of orbit transversals. -/
def pointStabsProg (G : var (Ty.group D)) (ps : var (.list .nat)) :
    Prog (groupSig D) rec var (.prod (Ty.group D) (.list Ty.perm)) :=
  .bind (.op1 .fst G) fun N => .bind (permOne N) fun e =>
  .bind (.op0 .nil) fun nil => .bind (.op2 .cons e nil) fun reps₀ =>
  .bind (.op2 .pair G reps₀) fun acc₀ =>
  .foldList ps acc₀ psBody

end PSPrograms

section PS

variable {D : Ty} {a b : Ty} {X : Ctx (groupSig D)}
  {body : a.denote → Prog (groupSig D) (a, b) Ty.denote b} {DV : ℕ → GensData → D.denote → Prop}

/-- One step, as computed by the backend. -/
def psStep (O : Oracle (groupSig D)) (acc : GroupData D.denote × List PermData) (u : ℕ) :
    GroupData D.denote × List PermData :=
  (O.run GroupOp.stabilizer (acc.1, u),
    prodReps acc.2 (O.run GroupOp.orbitTransversal (acc.1, u)))

/-- The pointwise stabilizer and its representatives, as computed by the backend. -/
def pointStabsModel (O : Oracle (groupSig D)) (G : GroupData D.denote) (ps : List ℕ) :
    GroupData D.denote × List PermData :=
  ps.foldl (psStep O) (G, [PermData.one G.1])

/-- The cost of the step at level `j` (at most `m^j` representatives, transversals of at most
`m` points). -/
def psStepCost (N m Bt Bs j : ℕ) : ℕ := Bt + Bs + m ^ j * (m * (12 * N + 18) + 4) + 8

/-- The cost of the levels `k, …, k + len - 1`. -/
def psCostFrom (N m Bt Bs k len : ℕ) : ℕ :=
  ((List.range len).map fun i => psStepCost N m Bt Bs (k + i)).sum

theorem psCostFrom_succ (N m Bt Bs k len : ℕ) :
    psCostFrom N m Bt Bs k (len + 1) =
      psStepCost N m Bt Bs k + psCostFrom N m Bt Bs (k + 1) len := by
  simp only [psCostFrom, List.range_succ_eq_map, List.map_cons, List.sum_cons, List.map_map,
    Function.comp_def, Nat.add_zero]
  congr 2
  apply List.map_congr_left
  intro i _
  congr 1
  omega

/-- The cost of `pointStabsProg` on `r` points. -/
def pointStabsCost (N m Bt Bs r : ℕ) : ℕ := 2 * N + 7 + psCostFrom N m Bt Bs 0 r

/-- The invariant of the fold. -/
structure PSInv (DV : ℕ → GensData → D.denote → Prop) (N : ℕ) (gs : GensData)
    (acc : GroupData D.denote × List PermData) (R : ℕ) : Prop where
  deg : acc.1.1 = N
  valid : GroupValid DV N acc.1.2.1 acc.1.2.2
  le : GensData.denote N acc.1.2.1 ≤ GensData.denote N gs
  reps_valid : ∀ r ∈ acc.2, PermData.Valid N r
  reps_mem : ∀ r ∈ acc.2, PermData.denote N r ∈ GensData.denote N gs
  cover : IsLeftCover (GensData.denote N gs) (GensData.denote N acc.1.2.1)
    fun i : Fin acc.2.length => PermData.denote N (acc.2.get i)
  card : acc.2.length ≤ R

theorem pointStabs_spec (hO : MeetsContractOn DV stabOps X.O)
    (hPre : ∀ op x, stabOps op → GroupPre DV op x → X.Pre op x) {n N : ℕ} {gs : GensData}
    (hG : IsInvariant (GensData.denote N gs) (baseSet n N)) {s : ℕ}
    {G₀ : Subgroup (Perm (Fin N))} (B : BackendBounds X DV N s G₀)
    (hG₀ : GensData.denote N gs ≤ G₀) :
    ∀ (ps : List ℕ), (∀ u ∈ ps, n ≤ u ∧ u < N) → ∀ (acc : GroupData D.denote × List PermData)
      (k : ℕ), PSInv DV N gs acc ((N - n) ^ k) → acc.1.2.1.length ≤ s →
      RunsWithin X body (Prog.foldList (a := .nat) (b := .prod (Ty.group D) (.list Ty.perm)) ps acc
          psBody) (ps.foldl (psStep X.O) acc)
          (psCostFrom N (N - n) B.Btr B.Bstab k ps.length) ∧
        PSInv DV N gs (ps.foldl (psStep X.O) acc) ((N - n) ^ (k + ps.length)) ∧
        GensData.denote N (ps.foldl (psStep X.O) acc).1.2.1 =
          pointwiseStab (GensData.denote N acc.1.2.1) {v : Fin N | v.val ∈ ps} := by
  intro ps
  induction ps with
  | nil =>
    intro _ acc k hinv _
    refine ⟨(RunsWithin.foldList_nil (X := X) (body := body)).mono (Nat.zero_le _), ?_, ?_⟩
    · simpa using hinv
    · ext g
      simp only [List.foldl_nil, pointwiseStab, Subgroup.mem_mk, List.not_mem_nil,
        Set.mem_ofPred_eq, false_imp_iff, implies_true, and_true]
      rfl
  | cons u ps ih =>
    intro hps acc k hinv hlen
    obtain ⟨⟨N', ks, e⟩, reps⟩ := acc
    obtain ⟨hdeg, hv, hle, hrv, hrm, hcov, hcard⟩ := hinv
    change N' = N at hdeg
    subst N'
    change ks.length ≤ s at hlen
    have hu := hps u List.mem_cons_self
    have hpre : GroupPre DV .orbitTransversal ((N, ks, e), u) := ⟨hv, hu.2⟩
    have hpreS : GroupPre DV .stabilizer ((N, ks, e), u) := ⟨hv, hu.2⟩
    obtain ⟨hnd, hfst, htr⟩ := hO .orbitTransversal _ (Or.inr rfl) hpre
    have hSpost := hO .stabilizer _ (Or.inl rfl) hpreS
    have hBtu := B.transversal ks e u hlen (hle.trans hG₀) hpre
    have hBsu := B.stabilizer ks e u hlen (hle.trans hG₀) hpreS
    have hout := B.stabOut ks e u (hle.trans hG₀) hpreS
    obtain ⟨tr, htr_def⟩ : ∃ tr : List (ℕ × PermData),
        X.O.run GroupOp.orbitTransversal ((N, ks, e), u) = tr := ⟨_, rfl⟩
    rw [htr_def] at hnd hfst htr hBtu
    rcases hS : X.O.run GroupOp.stabilizer ((N, ks, e), u) with ⟨N'', ks', e'⟩
    rw [hS] at hSpost hBsu hout
    obtain ⟨hN'', hv', hden⟩ := hSpost
    change N'' = N at hN''
    subst N''
    have hden' : GensData.denote N ks' = pointStab (GensData.denote N ks) ⟨u, hu.2⟩ := hden hu.2
    -- the transversal has at most `N - n` points, all base positions
    have htrlen : tr.length ≤ N - n := by
      have hsub : (tr.map Prod.fst).toFinset ⊆ Finset.Ico n N := by
        intro j hj
        rw [List.mem_toFinset] at hj
        obtain ⟨hi', hj', g, hg, hgu⟩ := (hfst j).1 hj
        have hbase := hG g (hle hg) ⟨u, hi'⟩ hu.1
        rw [hgu] at hbase
        exact Finset.mem_Ico.2 ⟨hbase, hj'⟩
      have := Finset.card_le_card hsub
      rw [List.toFinset_card_of_nodup hnd, Nat.card_Ico, List.length_map] at this
      exact this
    have hacc' : psStep X.O ((N, ks, e), reps) u = ((N, ks', e'), prodReps reps tr) := by
      simp only [psStep]
      rw [hS, htr_def]
    -- the invariant after the step
    have hinv' : PSInv DV N gs ((N, ks', e'), prodReps reps tr) ((N - n) ^ (k + 1)) := by
      refine ⟨rfl, hv', ?_, ?_, ?_, ?_, ?_⟩
      · change GensData.denote N ks' ≤ _
        rw [hden']
        exact inf_le_left.trans hle
      · intro x hx
        obtain ⟨r, hr, vt, hvt, rfl⟩ := mem_prodReps.1 hx
        exact (hrv r hr).mul (htr vt hvt).1
      · intro x hx
        obtain ⟨r, hr, vt, hvt, rfl⟩ := mem_prodReps.1 hx
        rw [PermData.denote_mul (hrv r hr) (htr vt hvt).1]
        exact mul_mem (hrm r hr) (hle (htr vt hvt).2.1)
      · refine ⟨fun i => ?_, fun g hg => ?_⟩
        · have hx := List.get_mem (prodReps reps tr) i
          obtain ⟨r, hr, vt, hvt, hxe⟩ := mem_prodReps.1 hx
          rw [hxe, PermData.denote_mul (hrv r hr) (htr vt hvt).1]
          exact mul_mem (hrm r hr) (hle (htr vt hvt).2.1)
        · obtain ⟨i, hi⟩ := hcov.cover g hg
          set r := reps.get i with hr_def
          have hrmem : r ∈ reps := List.get_mem reps i
          set h := (PermData.denote N r)⁻¹ * g with hh_def
          have hj : SameOrbit (GensData.denote N ks) u (h ⟨u, hu.2⟩).val :=
            ⟨hu.2, (h ⟨u, hu.2⟩).2, h, hi, rfl⟩
          obtain ⟨vt, hvt, hvt1⟩ := List.mem_map.1 ((hfst _).2 hj)
          obtain ⟨hvtv, hvtH, hvtu⟩ := htr vt hvt
          have hx : PermData.mul r vt.2 ∈ prodReps reps tr :=
            mem_prodReps.2 ⟨r, hrmem, vt, hvt, rfl⟩
          obtain ⟨i', hi'⟩ := List.mem_iff_get.1 hx
          refine ⟨i', ?_⟩
          rw [hi', PermData.denote_mul (hrv r hrmem) hvtv, mul_inv_rev, mul_assoc]
          change (PermData.denote N vt.2)⁻¹ * h ∈ GensData.denote N ks'
          rw [hden', mem_pointStab]
          refine ⟨mul_mem (inv_mem hvtH) hi, ?_⟩
          rw [Perm.mul_apply, Perm.inv_eq_iff_eq, PermData.denote_apply hvtv]
          ext
          show (h ⟨u, hu.2⟩).val = get vt.2.1 u
          rw [hvtu, hvt1]
      · change (prodReps reps tr).length ≤ _
        rw [length_prodReps, pow_succ]
        exact Nat.mul_le_mul hcard htrlen
    obtain ⟨hrun, hinvF, hdenF⟩ :=
      ih (fun v hv => hps v (List.mem_cons_of_mem _ hv)) _ (k + 1) hinv' hout
    have hfold : (u :: ps).foldl (psStep X.O) ((N, ks, e), reps) =
        ps.foldl (psStep X.O) ((N, ks', e'), prodReps reps tr) := by
      rw [List.foldl_cons, hacc']
    rw [hfold]
    refine ⟨?_, ?_, ?_⟩
    · have hpr := RunsWithin.prodRepsProg (X := X) (body := body) (N := N) (reps := reps)
        (tr := tr) hrv fun vt hvt => (htr vt hvt).1
      have h1 : RunsWithin X body (psBody ((N, ks, e), reps) u) ((N, ks', e'), prodReps reps tr)
          (psStepCost N (N - n) B.Btr B.Bstab k - 1) := by
        apply RunsWithin.mono
        case h =>
          run_step (RunsWithin.prim _ _)
          run_step (RunsWithin.prim _ _)
          run_step (RunsWithin.prim _ _)
          run_step (RunsWithin.call (hPre _ _ (Or.inr rfl) hpre))
          run_step (RunsWithin.call (hPre _ _ (Or.inl rfl) hpreS))
          simp only [Prim.eval]
          rw [hS, htr_def]
          run_step hpr
          exact RunsWithin.prim_le rfl le_rfl
        case hc =>
          have hp : Prim.eval (Prim.pair (a := Ty.group D) (b := .nat))
              (Args.cons (Prim.eval (Prim.fst (a := Ty.group D) (b := .list Ty.perm))
                (Args.cons ((N, ks, e), reps) Args.nil)) (Args.cons u Args.nil)) =
              ((N, ks, e), u) := rfl
          simp only [Prim.cost]
          rw [hp, hS, htr_def]
          have hmul : reps.length * (tr.length * (12 * N + 18) + 4) ≤
              (N - n) ^ k * ((N - n) * (12 * N + 18) + 4) :=
            Nat.mul_le_mul hcard (Nat.add_le_add_right (Nat.mul_le_mul_right _ htrlen) _)
          simp only [psStepCost]
          omega
      have := RunsWithin.foldList_cons h1 hrun
      refine this.mono ?_
      rw [List.length_cons, psCostFrom_succ]
      simp only [psStepCost]
      omega
    · rw [show k + (u :: ps).length = k + 1 + ps.length by simp; omega]
      exact hinvF
    · rw [hdenF]
      change pointwiseStab (GensData.denote N ks') _ = _
      rw [hden', pointwiseStab_pointStab]

/-- **Pointwise stabilizers with representatives.** For base points `ps`, the result is the
pointwise stabilizer of `ps` in `G`, with a left cover of `G` by its cosets made of at most
`(N - n)^|ps|` products of orbit transversals. -/
theorem RunsWithin.pointStabsProg (hO : MeetsContractOn DV stabOps X.O)
    (hPre : ∀ op x, stabOps op → GroupPre DV op x → X.Pre op x) {n N : ℕ} {gs : GensData}
    {d : D.denote} (hGv : GroupValid DV N gs d)
    (hG : IsInvariant (GensData.denote N gs) (baseSet n N)) {ps : List ℕ}
    (hps : ∀ u ∈ ps, n ≤ u ∧ u < N) {s : ℕ} {G₀ : Subgroup (Perm (Fin N))}
    (B : BackendBounds X DV N s G₀) (hs : gs.length ≤ s) (hG₀ : GensData.denote N gs ≤ G₀) :
    RunsWithin X body (Toolkit.pointStabsProg (N, gs, d) ps) (pointStabsModel X.O (N, gs, d) ps)
        (pointStabsCost N (N - n) B.Btr B.Bstab ps.length) ∧
      (pointStabsModel X.O (N, gs, d) ps).1.1 = N ∧
      GroupValid DV N (pointStabsModel X.O (N, gs, d) ps).1.2.1
        (pointStabsModel X.O (N, gs, d) ps).1.2.2 ∧
      GensData.denote N (pointStabsModel X.O (N, gs, d) ps).1.2.1 =
        pointwiseStab (GensData.denote N gs) {v : Fin N | v.val ∈ ps} ∧
      (∀ r ∈ (pointStabsModel X.O (N, gs, d) ps).2, PermData.Valid N r) ∧
      IsLeftCover (GensData.denote N gs)
        (GensData.denote N (pointStabsModel X.O (N, gs, d) ps).1.2.1)
        (fun i : Fin (pointStabsModel X.O (N, gs, d) ps).2.length =>
          PermData.denote N ((pointStabsModel X.O (N, gs, d) ps).2.get i)) ∧
      (pointStabsModel X.O (N, gs, d) ps).2.length ≤ (N - n) ^ ps.length := by
  have hinv0 : PSInv DV N gs ((N, gs, d), [PermData.one N]) ((N - n) ^ 0) := by
    refine ⟨rfl, hGv, le_rfl, ?_, ?_, ⟨fun _ => ?_, fun g hg => ⟨⟨0, by simp⟩, ?_⟩⟩, by simp⟩
    · intro r hr
      rw [List.mem_singleton] at hr
      rw [hr]
      exact PermData.valid_one N
    · intro r hr
      rw [List.mem_singleton] at hr
      rw [hr, PermData.denote_one]
      exact one_mem _
    · simp only [List.get_eq_getElem, List.length_singleton, Fin.val_eq_zero,
        List.getElem_singleton, PermData.denote_one]
      exact one_mem _
    · simp only [List.get_eq_getElem, List.getElem_singleton, PermData.denote_one, inv_one,
        one_mul]
      exact hg
  obtain ⟨hrun, hinv, hden⟩ := pointStabs_spec hO hPre hG B hG₀ ps hps _ 0 hinv0 hs
  rw [Nat.zero_add] at hinv
  refine ⟨?_, hinv.deg, hinv.valid, hden, hinv.reps_valid, hinv.cover, hinv.card⟩
  apply RunsWithin.mono
  case h =>
    run_step (RunsWithin.prim _ _)
    run_step (RunsWithin.permOne N)
    run_step (RunsWithin.prim _ _)
    run_step (RunsWithin.prim _ _)
    run_step (RunsWithin.prim _ _)
    exact hrun
  case hc =>
    simp only [Prim.cost, pointStabsCost]
    omega

end PS

/-! ### Two disjoint transpositions as data -/

/-- The point map of `(i j)(k l)`. -/
def sp (i j k l x : ℕ) : ℕ :=
  cond (x == i) j (cond (x == j) i (cond (x == k) l (cond (x == l) k x)))

/-- The permutation `(i j)(k l)` of degree `m`, as data. -/
def swapPair (m i j k l : ℕ) : PermData :=
  (((List.range m).map (sp i j k l)).toArray, ((List.range m).map (sp i j k l)).toArray)

section SwapPrograms

variable {S : Signature} {rec : Ty × Ty} {var : Ty → Type}

/-- The point map of `(i j)(k l)` as a program. -/
def spProg (i j k l x : var .nat) : Prog S rec var .nat :=
  .bind (.op2 .natEq x i) fun e₁ => .ite e₁ (.ret j)
    (.bind (.op2 .natEq x j) fun e₂ => .ite e₂ (.ret i)
      (.bind (.op2 .natEq x k) fun e₃ => .ite e₃ (.ret l)
        (.bind (.op2 .natEq x l) fun e₄ => .ite e₄ (.ret k) (.ret x))))

/-- The data of `(i j)(k l)` of degree `m`. -/
def swapPairProg (m i j k l : var .nat) : Prog S rec var Ty.perm :=
  .bind (.op1 .range m) fun is =>
  .bind (mapList is fun x => spProg i j k l x) fun ys =>
  .bind (.op1 .arrayOfList ys) fun f => .op2 .pair f f

end SwapPrograms

/-- The cost of `swapPairProg`. -/
def swapPairCost (m : ℕ) : ℕ := 13 * m + 6

section SwapSpecs

variable {S : Signature} {a b : Ty} {X : Ctx S} {body : a.denote → Prog S (a, b) Ty.denote b}

private theorem runs_eqIte {x y r₁ r₂ k₁ k₂ : ℕ} {p q : Prog S (a, b) Ty.denote .nat}
    (hp : RunsWithin X body p r₁ k₁) (hq : RunsWithin X body q r₂ k₂) :
    RunsWithin X body (.bind (.op2 .natEq x y) fun e => .ite e p q) (cond (x == y) r₁ r₂)
      (2 + max k₁ k₂) := by
  cases h : (x == y)
  · refine RunsWithin.bind_le (c₂ := 1 + k₂) (RunsWithin.prim _ _) ?_ ?_
    · show RunsWithin X body (.ite (x == y) p q) r₂ _
      rw [h]
      exact RunsWithin.ite_false hq
    · simp only [Prim.cost]
      omega
  · refine RunsWithin.bind_le (c₂ := 1 + k₁) (RunsWithin.prim _ _) ?_ ?_
    · show RunsWithin X body (.ite (x == y) p q) r₁ _
      rw [h]
      exact RunsWithin.ite_true hp
    · simp only [Prim.cost]
      omega

theorem RunsWithin.spProg (i j k l x : ℕ) :
    RunsWithin X body (Toolkit.spProg i j k l x) (sp i j k l x) 8 :=
  runs_eqIte (RunsWithin.ret _) (runs_eqIte (RunsWithin.ret _) (runs_eqIte (RunsWithin.ret _)
    (runs_eqIte (RunsWithin.ret _) (RunsWithin.ret _))))

theorem RunsWithin.swapPairProg (m i j k l : ℕ) :
    RunsWithin X body (Toolkit.swapPairProg m i j k l) (swapPair m i j k l) (swapPairCost m) := by
  have hm := RunsWithin.mapList_le (X := X) (body := body) (a' := .nat) (b' := .nat)
    (xs := List.range m) (c := 8) (F := sp i j k l) (f := fun x => Toolkit.spProg i j k l x)
    fun x _ => RunsWithin.spProg i j k l x
  apply RunsWithin.mono
  case h =>
    run_step (RunsWithin.prim _ _)
    run_step hm
    run_step (RunsWithin.prim _ _)
    exact RunsWithin.prim_le rfl le_rfl
  case hc =>
    simp only [Prim.cost, Args.head_cons, List.length_range, List.length_map, swapPairCost]
    omega

end SwapSpecs

theorem get_swapPair_fst {m i j k l x : ℕ} (hx : x < m) :
    get (swapPair m i j k l).1 x = sp i j k l x := by
  simp [swapPair, get, hx]

theorem get_swapPair_snd {m i j k l x : ℕ} (hx : x < m) :
    get (swapPair m i j k l).2 x = sp i j k l x := by
  simp [swapPair, get, hx]

theorem sp_lt {m i j k l x : ℕ} (hi : i < m) (hj : j < m) (hk : k < m) (hl : l < m)
    (hx : x < m) : sp i j k l x < m := by
  unfold sp
  by_cases h₁ : x = i <;> by_cases h₂ : x = j <;> by_cases h₃ : x = k <;> by_cases h₄ : x = l <;>
    simp [h₁, h₂, h₃, h₄] <;> (try split_ifs) <;> omega

theorem sp_sp {i j k l x : ℕ} (hij : i ≠ j) (hkl : k ≠ l) (hik : i ≠ k) (hil : i ≠ l)
    (hjk : j ≠ k) (hjl : j ≠ l) : sp i j k l (sp i j k l x) = x := by
  unfold sp
  by_cases h₁ : x = i <;> by_cases h₂ : x = j <;> by_cases h₃ : x = k <;> by_cases h₄ : x = l <;>
    simp [h₁, h₂, h₃, h₄, hij, hkl, hik, hil, hjk, hjl, hij.symm, hkl.symm, hik.symm, hil.symm,
      hjk.symm, hjl.symm]

theorem swapPair_valid {m i j k l : ℕ} (hi : i < m) (hj : j < m) (hk : k < m) (hl : l < m)
    (hij : i ≠ j) (hkl : k ≠ l) (hik : i ≠ k) (hil : i ≠ l) (hjk : j ≠ k) (hjl : j ≠ l) :
    (swapPair m i j k l).Valid m := by
  refine ⟨by simp [swapPair], by simp [swapPair], fun x hx => ?_, fun x hx => ?_,
    fun x hx => ?_, fun x hx => ?_⟩
  · rw [get_swapPair_fst hx]
    exact sp_lt hi hj hk hl hx
  · rw [get_swapPair_snd hx]
    exact sp_lt hi hj hk hl hx
  · rw [get_swapPair_fst hx, get_swapPair_snd (sp_lt hi hj hk hl hx)]
    exact sp_sp hij hkl hik hil hjk hjl
  · rw [get_swapPair_snd hx, get_swapPair_fst (sp_lt hi hj hk hl hx)]
    exact sp_sp hij hkl hik hil hjk hjl

theorem denote_swapPair {m i j k l : ℕ} (hi : i < m) (hj : j < m) (hk : k < m) (hl : l < m)
    (hij : i ≠ j) (hkl : k ≠ l) (hik : i ≠ k) (hil : i ≠ l) (hjk : j ≠ k) (hjl : j ≠ l) :
    PermData.denote m (swapPair m i j k l) =
      swap (⟨i, hi⟩ : Fin m) ⟨j, hj⟩ * swap (⟨k, hk⟩ : Fin m) ⟨l, hl⟩ := by
  ext x
  rw [PermData.val_denote_apply (swapPair_valid hi hj hk hl hij hkl hik hil hjk hjl),
    get_swapPair_fst x.2, Perm.mul_apply]
  unfold sp
  simp only [swap_apply_def, Fin.ext_iff]
  by_cases h₁ : x.val = i <;> by_cases h₂ : x.val = j <;> by_cases h₃ : x.val = k <;>
    by_cases h₄ : x.val = l <;>
    simp [h₁, h₂, h₃, h₄, hij, hkl, hik, hil, hjk, hjl, hij.symm, hkl.symm, hik.symm, hil.symm,
      hjk.symm, hjl.symm]

/-! ### Setwise stabilizers of base sets in a giant -/

section SetStab

open Pointwise

/-- The base points listed in `A`, as a finite set. -/
def finsetOf (m : ℕ) (A : List ℕ) : Finset (Fin m) := Finset.univ.filter fun j => j.val ∈ A

theorem mem_finsetOf {m : ℕ} {A : List ℕ} {j : Fin m} : j ∈ finsetOf m A ↔ j.val ∈ A := by
  simp [finsetOf]

/-- **The setwise stabilizer from a lifted generating set.** If `S ⊆ G` stabilizes `A'` and every
permutation stabilizing `A'` agrees on `A'` with `ψ` of an element of `⟨S⟩`, then `⟨S⟩` together
with the pointwise stabilizer of the positions of `A'` is the preimage of the setwise stabilizer
of `A'`. -/
theorem setStab_eq_closure {N n : ℕ} {G : Subgroup (Perm (Fin N))}
    (hG : IsInvariant G (baseSet n N)) (A : List ℕ) (S : Set (Perm (Fin N))) (hSG : S ⊆ G)
    (hSstab : ∀ s ∈ S, ∀ hs : s ∈ G, baseHom G n hG ⟨s, hs⟩ • finsetOf (N - n) A =
      finsetOf (N - n) A)
    (hgen : ∀ σ : Perm (Fin (N - n)), σ • finsetOf (N - n) A = finsetOf (N - n) A →
      ∃ h ∈ Subgroup.closure S, ∃ hh : h ∈ G, ∀ a ∈ finsetOf (N - n) A,
        baseHom G n hG ⟨h, hh⟩ a = σ a) :
    Subgroup.closure (S ∪ pointwiseStab G {v : Fin N | v.val ∈ A.map (n + ·)}) =
      (Recursion.blockStab (baseHom G n hG) (finsetOf (N - n) A)).map G.subtype := by
  set A' := finsetOf (N - n) A
  -- the base point `a` sits at position `n + a`
  have hpos : ∀ (a : Fin (N - n)) (g : G), g.1 (basePos a) = basePos (baseHom G n hG g a) :=
    fun a g => (baseHom_apply g a).symm
  apply le_antisymm
  · rw [Subgroup.closure_le]
    rintro g (hg | ⟨hgG, hfix⟩)
    · exact ⟨⟨g, hSG hg⟩, MulAction.mem_stabilizer_iff.2 (hSstab g hg (hSG hg)), rfl⟩
    · refine ⟨⟨g, hgG⟩, MulAction.mem_stabilizer_iff.2 ?_, rfl⟩
      have hfa : ∀ a ∈ A', baseHom G n hG ⟨g, hgG⟩ a = a := by
        intro a ha
        have h1 := hpos a ⟨g, hgG⟩
        have h2 := hfix (basePos a) (by
          simp only [Set.mem_ofPred_eq, basePos, List.mem_map]
          exact ⟨a.val, mem_finsetOf.1 ha, rfl⟩)
        rw [h2] at h1
        ext
        have := congrArg Fin.val h1
        simp only [basePos] at this
        omega
      rw [Finset.smul_finset_def, Finset.image_congr (g := id) (fun a ha => by
        rw [Perm.smul_def]
        exact hfa a ha), Finset.image_id]
  · rintro g ⟨g', hg', rfl⟩
    have hσ : baseHom G n hG g' • A' = A' := MulAction.mem_stabilizer_iff.1 hg'
    obtain ⟨h, hhS, hhG, hagree⟩ := hgen _ hσ
    have hk : h⁻¹ * g'.1 ∈ pointwiseStab G {v : Fin N | v.val ∈ A.map (n + ·)} := by
      refine ⟨mul_mem (inv_mem hhG) g'.2, fun v hv => ?_⟩
      simp only [Set.mem_ofPred_eq, List.mem_map] at hv
      obtain ⟨a, ha, hva⟩ := hv
      have haN : a < N - n := by have := v.2; omega
      set a' : Fin (N - n) := ⟨a, haN⟩
      have ha' : a' ∈ A' := mem_finsetOf.2 ha
      have hv' : v = basePos a' := by
        ext
        show v.val = n + a
        omega
      rw [hv', Perm.mul_apply, hpos a' g']
      have hinv := hpos (baseHom G n hG g' a') ⟨h, hhG⟩⁻¹
      simp only [InvMemClass.coe_inv, map_inv] at hinv
      rw [hinv, ← hagree a' ha']
      congr 1
      exact Perm.inv_eq_iff_eq.2 rfl
    have : g'.1 = h * (h⁻¹ * g'.1) := by group
    change g'.1 ∈ _
    rw [this]
    exact mul_mem (Subgroup.closure_mono Set.subset_union_left hhS)
      (Subgroup.subset_closure (Set.mem_union_right _ hk))

/-- A permutation mapping a finite set into itself maps it onto itself. -/
theorem smul_finset_eq_of_mapsTo {m : ℕ} {σ : Perm (Fin m)} {A' : Finset (Fin m)}
    (h : ∀ a ∈ A', σ a ∈ A') : σ • A' = A' := by
  refine Finset.eq_of_subset_of_card_le ?_ (by rw [Finset.card_smul_finset])
  intro b hb
  obtain ⟨a, ha, rfl⟩ := Finset.mem_smul_finset.1 hb
  exact h a ha

/-- **Star transpositions generate.** If for every `x` in `rest` some `r ∈ ⟨S⟩` acts on `A'`
(`A = a₀ :: rest`) as the transposition `(a₀ x)`, then every permutation stabilizing `A'` agrees
on `A'` with `ψ` of an element of `⟨S⟩`. -/
theorem star_gen {N n : ℕ} {G : Subgroup (Perm (Fin N))} (hG : IsInvariant G (baseSet n N))
    {a₀ : ℕ} {rest : List ℕ} (S : Set (Perm (Fin N)))
    (hswap : ∀ x ∈ rest, ∃ r ∈ S, ∃ hr : r ∈ G, ∀ a ∈ finsetOf (N - n) (a₀ :: rest),
      (baseHom G n hG ⟨r, hr⟩ a).val =
        if a.val = a₀ then x else if a.val = x then a₀ else a.val) :
    ∀ σ : Perm (Fin (N - n)), σ • finsetOf (N - n) (a₀ :: rest) = finsetOf (N - n) (a₀ :: rest) →
      ∃ h ∈ Subgroup.closure S, ∃ hh : h ∈ G, ∀ a ∈ finsetOf (N - n) (a₀ :: rest),
        baseHom G n hG ⟨h, hh⟩ a = σ a := by
  intro σ hσ
  set A' := finsetOf (N - n) (a₀ :: rest)
  let P : Perm A' → Prop := fun τ => ∃ h ∈ Subgroup.closure S, ∃ hh : h ∈ G,
    ∀ a : A', baseHom G n hG ⟨h, hh⟩ a = (τ a : Fin (N - n))
  have hP1 : P 1 := ⟨1, one_mem _, one_mem _, fun a => by
    have : (⟨1, one_mem _⟩ : G) = 1 := rfl
    rw [this, map_one]
    rfl⟩
  have hPmul : ∀ τ₁ τ₂, P τ₁ → P τ₂ → P (τ₁ * τ₂) := by
    rintro τ₁ τ₂ ⟨h₁, hS₁, hG₁, e₁⟩ ⟨h₂, hS₂, hG₂, e₂⟩
    refine ⟨h₁ * h₂, mul_mem hS₁ hS₂, mul_mem hG₁ hG₂, fun a => ?_⟩
    have : (⟨h₁ * h₂, mul_mem hG₁ hG₂⟩ : G) = ⟨h₁, hG₁⟩ * ⟨h₂, hG₂⟩ := rfl
    rw [this, map_mul, Perm.mul_apply, e₂ a, e₁ (τ₂ a), Perm.mul_apply]
  have hPinv : ∀ τ, P τ → P τ⁻¹ := by
    rintro τ ⟨h, hS, hG', e⟩
    refine ⟨h⁻¹, inv_mem hS, inv_mem hG', fun a => ?_⟩
    have : (⟨h⁻¹, inv_mem hG'⟩ : G) = (⟨h, hG'⟩ : G)⁻¹ := rfl
    rw [this, map_inv, Perm.inv_eq_iff_eq, e (τ⁻¹ a)]
    simp
  -- star transpositions
  have hPstar : ∀ x : A', (x : Fin (N - n)).val ≠ a₀ →
      ∃ (ha : a₀ < N - n) (ha' : (⟨a₀, ha⟩ : Fin (N - n)) ∈ A'), P (swap ⟨⟨a₀, ha⟩, ha'⟩ x) := by
    intro x hx
    have hxr : (x : Fin (N - n)).val ∈ rest := by
      have := mem_finsetOf.1 x.2
      rcases List.mem_cons.1 this with h | h
      · exact absurd h hx
      · exact h
    obtain ⟨r, hrS, hrG, hform⟩ := hswap _ hxr
    have hrx := hform x x.2
    simp only [hx, ↓reduceIte] at hrx
    have ha : a₀ < N - n := hrx ▸ (baseHom G n hG ⟨r, hrG⟩ x).2
    have ha' : (⟨a₀, ha⟩ : Fin (N - n)) ∈ A' := mem_finsetOf.2 List.mem_cons_self
    refine ⟨ha, ha', r, Subgroup.subset_closure hrS, hrG, fun b => ?_⟩
    have hb := hform b b.2
    ext
    rw [hb, swap_apply_def]
    by_cases h₁ : (b : Fin (N - n)).val = a₀
    · have : b = ⟨⟨a₀, ha⟩, ha'⟩ := Subtype.ext (Fin.ext h₁)
      simp [this]
    · have h₄ : b ≠ ⟨⟨a₀, ha⟩, ha'⟩ := fun h => h₁ (by rw [h])
      by_cases h₂ : b = x
      · subst h₂
        simp [h₁, h₄]
      · have h₃ : (b : Fin (N - n)).val ≠ (x : Fin (N - n)).val := fun h =>
          h₂ (Subtype.ext (Fin.ext h))
        simp [h₁, h₂, h₃, h₄]
  have hPswap : ∀ τ : Perm A', τ.IsSwap → P τ := by
    rintro τ ⟨x, y, hxy, rfl⟩
    by_cases hx : (x : Fin (N - n)).val = a₀
    · have hy : (y : Fin (N - n)).val ≠ a₀ := fun h =>
        hxy (Subtype.ext (Fin.ext (hx.trans h.symm)))
      obtain ⟨ha, ha', hP⟩ := hPstar y hy
      have : (⟨⟨a₀, ha⟩, ha'⟩ : A') = x := Subtype.ext (Fin.ext hx.symm)
      rwa [this] at hP
    · by_cases hy : (y : Fin (N - n)).val = a₀
      · obtain ⟨ha, ha', hP⟩ := hPstar x hx
        have : (⟨⟨a₀, ha⟩, ha'⟩ : A') = y := Subtype.ext (Fin.ext hy.symm)
        rw [this] at hP
        rwa [swap_comm]
      · obtain ⟨ha, ha', hPx⟩ := hPstar x hx
        obtain ⟨ha2, ha2', hPy⟩ := hPstar y hy
        set z : A' := ⟨⟨a₀, ha⟩, ha'⟩
        have hzx : swap z x z = x := swap_apply_left z x
        have hzy : swap z x y = y := by
          refine swap_apply_of_ne_of_ne (fun h => hy ?_) (fun h => hxy h.symm)
          rw [h]
        have e : swap x y = swap z x * swap z y * swap z x := by
          have := swap_apply_apply (swap z x) z y
          rw [hzx, hzy, swap_inv] at this
          exact this
        rw [e]
        have hPy' : P (swap z y) := hPy
        exact hPmul _ _ (hPmul _ _ hPx hPy') hPx
  have hall : ∀ τ : Perm A', P τ := by
    intro τ
    have hτ : τ ∈ Subgroup.closure {τ : Perm A' | τ.IsSwap} := by
      rw [Perm.closure_isSwap]
      exact Subgroup.mem_top τ
    induction hτ using Subgroup.closure_induction with
    | mem x hx => exact hPswap x hx
    | one => exact hP1
    | mul x y _ _ hx hy => exact hPmul x y hx hy
    | inv x _ hx => exact hPinv x hx
  have hmem : ∀ a, σ a ∈ A' ↔ a ∈ A' := by
    intro a
    conv_lhs => rw [← hσ]
    exact Finset.smul_mem_smul_finset_iff σ
  obtain ⟨h, hhS, hhG, hh⟩ := hall (σ.subtypePerm hmem)
  exact ⟨h, hhS, hhG, fun a ha => hh ⟨a, ha⟩⟩

end SetStab

/-! ### The setwise stabilizer program -/

section GiantPrograms

variable {D : Ty} {rec : Ty × Ty} {var : Ty → Type}

/-- The setwise stabilizer of a list `A = a₀ :: rest` of base points, for a giant base action:
the pointwise stabilizer of the positions of `A` together with lifts of `(a₀ x)(b₁ b₂)` for
`x ∈ rest`, where `b₁ ≠ b₂` are base points outside `A`. -/
def giantSetStabProg (n : var .nat) (G : var (Ty.group D)) (A : var (.list .nat))
    (b₁ b₂ : var .nat) : Prog (groupSig D) rec var (Ty.group D) :=
  .bind (.op1 .fst G) fun N => .bind (.op2 .sub N n) fun m =>
  .bind (mapList A fun x => .op2 .add n x) fun Ap =>
  .bind (iterStabProg G Ap) fun KA =>
  .bind (.caseList A (.op0 .nil) fun a₀ rest =>
      mapList rest fun x => .bind (swapPairProg m a₀ x b₁ b₂) fun π => liftProg n G π)
    fun lifts =>
  .bind (.op1 .snd KA) fun kd => .bind (.op1 .fst kd) fun kgs =>
  .bind (.op2 .append lifts kgs) fun gens =>
  .bind (.op2 .pair N gens) fun arg => Prog.call (S := groupSig D) GroupOp.generate arg

end GiantPrograms

section Giant

open Pointwise

variable {D : Ty} {a b : Ty} {X : Ctx (groupSig D)}
  {body : a.denote → Prog (groupSig D) (a, b) Ty.denote b} {DV : ℕ → GensData → D.denote → Prop}

/-- The lifted generators. -/
def giantLifts (O : Oracle (groupSig D)) (n : ℕ) (G : GroupData D.denote) (b₁ b₂ : ℕ) :
    List ℕ → List PermData
  | [] => []
  | a₀ :: rest => rest.map fun x => liftModel O n G (swapPair (G.1 - n) a₀ x b₁ b₂)

/-- All generators of the setwise stabilizer. -/
def giantGens (O : Oracle (groupSig D)) (n : ℕ) (G : GroupData D.denote) (A : List ℕ)
    (b₁ b₂ : ℕ) : GensData :=
  giantLifts O n G b₁ b₂ A ++ (iterStabModel O G (A.map (n + ·))).2.1

/-- The setwise stabilizer, as computed by the backend. -/
def giantSetStabModel (O : Oracle (groupSig D)) (n : ℕ) (G : GroupData D.denote) (A : List ℕ)
    (b₁ b₂ : ℕ) : GroupData D.denote :=
  O.run GroupOp.generate (G.1, giantGens O n G A b₁ b₂)

/-- The operations used by `giantSetStabProg`. -/
def giantOps (op : GroupOp) : Prop :=
  op = .stabilizer ∨ op = .orbitTransversal ∨ op = .lift ∨ op = .generate

/-- The cost of `giantSetStabProg` for `k` points. -/
def giantSetStabCost (n N k Bs Bl Bg : ℕ) : ℕ :=
  k * (Bs + Bl + 13 * (N - n) + baseWinCost n N + 19) + Bg + 12

/-- `(i j)(k l)` lies in a giant base action. -/
theorem swapPair_mem_range {N n : ℕ} {G : Subgroup (Perm (Fin N))}
    {hG : IsInvariant G (baseSet n N)}
    (hgiant : alternatingGroup (Fin (N - n)) ≤ (baseHom G n hG).range) {i j k l : ℕ}
    (hi : i < N - n) (hj : j < N - n) (hk : k < N - n) (hl : l < N - n)
    (hij : i ≠ j) (hkl : k ≠ l) (hik : i ≠ k) (hil : i ≠ l) (hjk : j ≠ k) (hjl : j ≠ l) :
    PermData.denote (N - n) (swapPair (N - n) i j k l) ∈ (baseHom G n hG).range := by
  apply hgiant
  rw [denote_swapPair hi hj hk hl hij hkl hik hil hjk hjl, Perm.mem_alternatingGroup,
    Perm.sign_mul, Perm.sign_swap (fun h => hij (congrArg Fin.val h)),
    Perm.sign_swap (fun h => hkl (congrArg Fin.val h))]
  rfl

/-- The lifts of `(a₀ x)(b₁ b₂)`, `x ∈ rest`. -/
theorem lifts_spec (hO : MeetsContractOn DV liftOps X.O)
    (hPre : ∀ op x, liftOps op → GroupPre DV op x → X.Pre op x)
    {n N : ℕ} {gs : GensData} {d : D.denote} (hGv : GroupValid DV N gs d)
    (hG : IsInvariant (GensData.denote N gs) (baseSet n N))
    (hgiant : alternatingGroup (Fin (N - n)) ≤ (baseHom (GensData.denote N gs) n hG).range)
    {a₀ : ℕ} (ha₀ : a₀ < N - n) {rest : List ℕ} (hrest : ∀ x ∈ rest, x < N - n ∧ a₀ ≠ x)
    {b₁ b₂ : ℕ} (hb : b₁ ≠ b₂) (hb₁ : b₁ < N - n) (hb₂ : b₂ < N - n)
    (hbx : ∀ x ∈ a₀ :: rest, x ≠ b₁ ∧ x ≠ b₂) {Bl : ℕ}
    (hBl : ∀ π, X.B.call GroupOp.lift ((N, gs, d), (baseWin n N, π))
      (liftModel X.O n (N, gs, d) π) ≤ Bl) :
    RunsWithin X body (mapList (a' := .nat) (b' := Ty.perm) rest fun x =>
        .bind (Toolkit.swapPairProg (N - n) a₀ x b₁ b₂) fun π => Toolkit.liftProg n (N, gs, d) π)
      (rest.map fun x => liftModel X.O n (N, gs, d) (swapPair (N - n) a₀ x b₁ b₂))
      (rest.length * (swapPairCost (N - n) + baseWinCost n N + Bl + 6) + 2) ∧
    ∀ x ∈ rest, PermData.Valid N (liftModel X.O n (N, gs, d) (swapPair (N - n) a₀ x b₁ b₂)) ∧
      ∃ h : PermData.denote N (liftModel X.O n (N, gs, d) (swapPair (N - n) a₀ x b₁ b₂)) ∈
          GensData.denote N gs,
        baseHom (GensData.denote N gs) n hG ⟨_, h⟩ =
          PermData.denote (N - n) (swapPair (N - n) a₀ x b₁ b₂) := by
  have hb0 := hbx a₀ List.mem_cons_self
  have key : ∀ x ∈ rest,
      RunsWithin X body (Toolkit.liftProg n (N, gs, d) (swapPair (N - n) a₀ x b₁ b₂))
          (liftModel X.O n (N, gs, d) (swapPair (N - n) a₀ x b₁ b₂))
          (baseWinCost n N + Bl + 3) ∧
        PermData.Valid N (liftModel X.O n (N, gs, d) (swapPair (N - n) a₀ x b₁ b₂)) ∧
        ∃ h : PermData.denote N (liftModel X.O n (N, gs, d) (swapPair (N - n) a₀ x b₁ b₂)) ∈
            GensData.denote N gs,
          baseHom (GensData.denote N gs) n hG ⟨_, h⟩ =
            PermData.denote (N - n) (swapPair (N - n) a₀ x b₁ b₂) := by
    intro x hx
    obtain ⟨hxm, hax⟩ := hrest x hx
    obtain ⟨hx1, hx2⟩ := hbx x (List.mem_cons_of_mem _ hx)
    exact RunsWithin.liftProg hO hPre hGv hG
      (swapPair_valid ha₀ hxm hb₁ hb₂ hax hb hb0.1 hb0.2 hx1 hx2)
      (swapPair_mem_range hgiant ha₀ hxm hb₁ hb₂ hax hb hb0.1 hb0.2 hx1 hx2) (hBl _)
  refine ⟨?_, fun x hx => (key x hx).2⟩
  have hm := RunsWithin.mapList_le (X := X) (body := body) (a' := .nat) (b' := Ty.perm)
    (xs := rest) (c := swapPairCost (N - n) + baseWinCost n N + Bl + 3)
    (F := fun x => liftModel X.O n (N, gs, d) (swapPair (N - n) a₀ x b₁ b₂))
    (f := fun x => .bind (Toolkit.swapPairProg (N - n) a₀ x b₁ b₂) fun π =>
      Toolkit.liftProg n (N, gs, d) π) fun x hx =>
        RunsWithin.bind_le (RunsWithin.swapPairProg _ _ _ _ _) (key x hx).1 (by omega)
  refine hm.mono ?_
  ring_nf
  omega

/-- **The setwise stabilizer of a set of base points, for a giant base action.** -/
theorem RunsWithin.giantSetStabProg (hO : MeetsContractOn DV giantOps X.O)
    (hPre : ∀ op x, giantOps op → GroupPre DV op x → X.Pre op x)
    {n N : ℕ} {gs : GensData} {d : D.denote} (hGv : GroupValid DV N gs d)
    (hG : IsInvariant (GensData.denote N gs) (baseSet n N))
    (hgiant : alternatingGroup (Fin (N - n)) ≤ (baseHom (GensData.denote N gs) n hG).range)
    {A : List ℕ} (hA : A.Nodup) (hAm : ∀ x ∈ A, x < N - n) {b₁ b₂ : ℕ} (hb : b₁ ≠ b₂)
    (hb₁ : b₁ < N - n) (hb₂ : b₂ < N - n) (hbA₁ : b₁ ∉ A) (hbA₂ : b₂ ∉ A) {s : ℕ}
    {G₀ : Subgroup (Perm (Fin N))} (B : BackendBounds X DV N s G₀) (hs : gs.length ≤ s)
    (hG₀ : GensData.denote N gs ≤ G₀) {Bl Bg : ℕ}
    (hBl : ∀ π, X.B.call GroupOp.lift ((N, gs, d), (baseWin n N, π))
      (liftModel X.O n (N, gs, d) π) ≤ Bl)
    (hBg : X.B.call GroupOp.generate (N, giantGens X.O n (N, gs, d) A b₁ b₂)
      (giantSetStabModel X.O n (N, gs, d) A b₁ b₂) ≤ Bg) :
    RunsWithin X body (Toolkit.giantSetStabProg n (N, gs, d) A b₁ b₂)
        (giantSetStabModel X.O n (N, gs, d) A b₁ b₂)
        (giantSetStabCost n N A.length B.Bstab Bl Bg) ∧
      (giantSetStabModel X.O n (N, gs, d) A b₁ b₂).1 = N ∧
      GroupValid DV N (giantSetStabModel X.O n (N, gs, d) A b₁ b₂).2.1
        (giantSetStabModel X.O n (N, gs, d) A b₁ b₂).2.2 ∧
      GensData.denote N (giantSetStabModel X.O n (N, gs, d) A b₁ b₂).2.1 =
        (Recursion.blockStab (baseHom (GensData.denote N gs) n hG) (finsetOf (N - n) A)).map
          (GensData.denote N gs).subtype := by
  set G0 := GensData.denote N gs with hG0
  set A' := finsetOf (N - n) A with hA'
  have hOs : MeetsContractOn DV stabOps X.O := fun op x hop hx =>
    hO op x (by rcases hop with h | h <;> simp [giantOps, h]) hx
  have hPres : ∀ op x, stabOps op → GroupPre DV op x → X.Pre op x := fun op x hop hx =>
    hPre op x (by rcases hop with h | h <;> simp [giantOps, h]) hx
  have hOl : MeetsContractOn DV liftOps X.O := fun op x hop hx =>
    hO op x (by rw [liftOps] at hop; simp [giantOps, hop]) hx
  have hPrel : ∀ op x, liftOps op → GroupPre DV op x → X.Pre op x := fun op x hop hx =>
    hPre op x (by rw [liftOps] at hop; simp [giantOps, hop]) hx
  have hps : ∀ u ∈ A.map (n + ·), u < N := by
    intro u hu
    obtain ⟨x, hx, rfl⟩ := List.mem_map.1 hu
    have := hAm x hx
    omega
  have hbA : ∀ a ∈ A', a ≠ ⟨b₁, hb₁⟩ ∧ a ≠ ⟨b₂, hb₂⟩ := by
    intro a ha
    have := mem_finsetOf.1 ha
    exact ⟨fun h => hbA₁ (by rw [h] at this; exact this),
      fun h => hbA₂ (by rw [h] at this; exact this)⟩
  -- the lifted generators
  have hL : RunsWithin X body (Prog.caseList (a := .nat) A (.op0 .nil) fun a₀ rest =>
        mapList (a' := .nat) (b' := Ty.perm) rest fun x =>
          .bind (Toolkit.swapPairProg (N - n) a₀ x b₁ b₂) fun π => Toolkit.liftProg n (N, gs, d) π)
        (giantLifts X.O n (N, gs, d) b₁ b₂ A)
        (A.length * (swapPairCost (N - n) + baseWinCost n N + Bl + 6) + 3) ∧
      (∀ r ∈ giantLifts X.O n (N, gs, d) b₁ b₂ A, PermData.Valid N r ∧ PermData.denote N r ∈ G0) ∧
      (∀ s ∈ GensData.denoteSet N (giantLifts X.O n (N, gs, d) b₁ b₂ A), ∀ hs : s ∈ G0,
        baseHom G0 n hG ⟨s, hs⟩ • A' = A') ∧
      (∀ σ : Perm (Fin (N - n)), σ • A' = A' →
        ∃ h ∈ Subgroup.closure (GensData.denoteSet N (giantLifts X.O n (N, gs, d) b₁ b₂ A)),
          ∃ hh : h ∈ G0, ∀ a ∈ A', baseHom G0 n hG ⟨h, hh⟩ a = σ a) := by
    cases A with
    | nil =>
      refine ⟨?_, by simp [giantLifts], by simp [giantLifts, GensData.denoteSet], ?_⟩
      · exact (RunsWithin.caseList_nil (RunsWithin.prim _ _)).mono (by simp [Prim.cost])
      · intro σ _
        refine ⟨1, one_mem _, one_mem _, fun a ha => ?_⟩
        simp [hA', finsetOf] at ha
    | cons a₀ rest =>
      have ha₀ : a₀ < N - n := hAm a₀ List.mem_cons_self
      have hnd := List.nodup_cons.1 hA
      have hrest : ∀ x ∈ rest, x < N - n ∧ a₀ ≠ x := fun x hx =>
        ⟨hAm x (List.mem_cons_of_mem _ hx), fun h => hnd.1 (h ▸ hx)⟩
      have hbx : ∀ x ∈ a₀ :: rest, x ≠ b₁ ∧ x ≠ b₂ := fun x hx =>
        ⟨fun h => hbA₁ (h ▸ hx), fun h => hbA₂ (h ▸ hx)⟩
      obtain ⟨hrunL, hfacts⟩ := lifts_spec hOl hPrel hGv hG hgiant ha₀ hrest hb hb₁ hb₂ hbx hBl
      -- the action of each lift on `A'`
      have hact : ∀ x ∈ rest, ∀ hs : PermData.denote N (liftModel X.O n (N, gs, d)
          (swapPair (N - n) a₀ x b₁ b₂)) ∈ G0, ∀ a ∈ A',
          ((baseHom G0 n hG ⟨_, hs⟩ a : Fin (N - n)) : ℕ) =
            if a.val = a₀ then x else if a.val = x then a₀ else a.val := by
        intro x hx hs a ha
        obtain ⟨-, hs', he⟩ := hfacts x hx
        obtain ⟨hxm, hax⟩ := hrest x hx
        obtain ⟨hx1, hx2⟩ := hbx x (List.mem_cons_of_mem _ hx)
        have hb0 := hbx a₀ List.mem_cons_self
        have : baseHom G0 n hG ⟨_, hs⟩ = baseHom G0 n hG ⟨_, hs'⟩ := rfl
        rw [this, he, denote_swapPair ha₀ hxm hb₁ hb₂ hax hb hb0.1 hb0.2 hx1 hx2, Perm.mul_apply,
          swap_apply_of_ne_of_ne (hbA a ha).1 (hbA a ha).2, swap_apply_def]
        by_cases h₁ : a.val = a₀
        · have : a = ⟨a₀, ha₀⟩ := Fin.ext h₁
          simp [this]
        · by_cases h₂ : a.val = x
          · have : a = ⟨x, hxm⟩ := Fin.ext h₂
            simp [this, Ne.symm hax]
          · have h₃ : a ≠ ⟨a₀, ha₀⟩ := fun h => h₁ (by rw [h])
            have h₄ : a ≠ ⟨x, hxm⟩ := fun h => h₂ (by rw [h])
            simp [h₁, h₂, h₃, h₄]
      refine ⟨?_, ?_, ?_, ?_⟩
      · refine (RunsWithin.caseList_cons hrunL).mono ?_
        simp only [List.length_cons]
        ring_nf
        omega
      · intro r hr
        obtain ⟨x, hx, rfl⟩ := List.mem_map.1 hr
        obtain ⟨hv, hs, -⟩ := hfacts x hx
        exact ⟨hv, hs⟩
      · rintro s ⟨r, hr, rfl⟩ hs
        obtain ⟨x, hx, rfl⟩ := List.mem_map.1 hr
        refine smul_finset_eq_of_mapsTo fun a ha => ?_
        have hv := hact x hx hs a ha
        rw [mem_finsetOf]
        rw [mem_finsetOf] at ha
        rw [hv]
        split_ifs
        · exact List.mem_cons_of_mem _ hx
        · exact List.mem_cons_self
        · exact ha
      · refine star_gen hG _ fun x hx => ?_
        obtain ⟨-, hs, -⟩ := hfacts x hx
        exact ⟨_, ⟨_, List.mem_map.2 ⟨x, hx, rfl⟩, rfl⟩, hs, hact x hx hs⟩
  obtain ⟨hrunL, hLv, hLstab, hLgen⟩ := hL
  -- the pointwise stabilizer of the positions of `A`
  obtain ⟨hrunK, hKdeg, hKv, hKden⟩ := RunsWithin.iterStabProg hOs hPres hGv hps B hs hG₀
  rcases hKm : iterStabModel X.O (N, gs, d) (A.map (n + ·)) with ⟨N', kgs, ke⟩
  rw [hKm] at hrunK hKdeg hKv hKden
  change N' = N at hKdeg
  subst N'
  -- the generators and the generated group
  have hgens : giantGens X.O n (N, gs, d) A b₁ b₂ = giantLifts X.O n (N, gs, d) b₁ b₂ A ++ kgs := by
    rw [giantGens, hKm]
  have hgv : GensData.AllValid N (giantLifts X.O n (N, gs, d) b₁ b₂ A ++ kgs) :=
    GensData.AllValid.append (fun r hr => (hLv r hr).1) hKv.1
  have hgpost := hO .generate (N, giantLifts X.O n (N, gs, d) b₁ b₂ A ++ kgs) (by simp [giantOps])
    hgv
  have hmodel : giantSetStabModel X.O n (N, gs, d) A b₁ b₂ =
      X.O.run GroupOp.generate (N, giantLifts X.O n (N, gs, d) b₁ b₂ A ++ kgs) := by
    rw [giantSetStabModel, hgens]
  rw [hmodel] at hBg ⊢
  rw [hgens] at hBg
  rcases hR : X.O.run GroupOp.generate (N, giantLifts X.O n (N, gs, d) b₁ b₂ A ++ kgs) with
    ⟨N'', hs, e⟩
  rw [hR] at hgpost hBg
  obtain ⟨hN'', hv'', hden''⟩ := hgpost
  change N'' = N at hN''
  subst N''
  refine ⟨?_, rfl, hv'', ?_⟩
  · apply RunsWithin.mono
    case h =>
      run_step (RunsWithin.prim _ _)
      run_step (RunsWithin.prim _ _)
      run_step (RunsWithin.mapList_le (X := X) (body := body) (a' := .nat) (b' := .nat) (xs := A)
        (c := 1) (F := (n + ·)) (f := fun x => Prog.op2 Prim.add n x) fun x _ =>
          RunsWithin.prim _ _)
      run_step hrunK
      run_step hrunL
      run_step (RunsWithin.prim _ _)
      run_step (RunsWithin.prim _ _)
      run_step (RunsWithin.prim _ _)
      run_step (RunsWithin.prim _ _)
      have hcall := RunsWithin.call (X := X) (body := body) (op := GroupOp.generate)
        (hPre GroupOp.generate (N, giantLifts X.O n (N, gs, d) b₁ b₂ A ++ kgs)
          (by simp [giantOps]) hgv)
      rw [hR] at hcall
      exact hcall
    case hc =>
      have hlen : (giantLifts X.O n (N, gs, d) b₁ b₂ A).length ≤ A.length := by
        cases A with
        | nil => simp [giantLifts]
        | cons a₀ rest => simp [giantLifts]
      simp only [Prim.cost, Prim.eval, Args.head_cons, giantSetStabCost, List.length_map,
        swapPairCost]
      nlinarith [hBg, hlen]
  · rw [hden'', GensData.denote_append]
    have hK : GensData.denote N kgs =
        Subgroup.closure (pointwiseStab G0 {v : Fin N | v.val ∈ A.map (n + ·)} : Set _) := by
      rw [hKden, Subgroup.closure_eq]
    rw [hK, GensData.denote, ← Subgroup.closure_union]
    exact setStab_eq_closure hG A _ (fun r ⟨p, hp, hpr⟩ => hpr ▸ (hLv p hp).2) hLstab hLgen

end Giant

/-! ### Well-formedness -/

section Wf

variable {D : Ty} {S : Signature} {rec : Ty × Ty} {var₁ var₂ : Ty → Type} {r : Bool}
  {Γ : WfCtx var₁ var₂}

theorem wf_baseWinProg {n₁ N₁ : var₁ .nat} {n₂ N₂ : var₂ .nat} (hn : ⟨.nat, n₁, n₂⟩ ∈ Γ)
    (hN : ⟨.nat, N₁, N₂⟩ ∈ Γ) :
    Prog.Wf (S := S) (rec := rec) r Γ (baseWinProg n₁ N₁) (baseWinProg n₂ N₂) := by
  unfold baseWinProg mkWindow mapList
  prog_wf

theorem wf_kerProg {n₁ : var₁ .nat} {n₂ : var₂ .nat} {G₁ : var₁ (Ty.group D)}
    {G₂ : var₂ (Ty.group D)} (hn : ⟨.nat, n₁, n₂⟩ ∈ Γ) (hG : ⟨Ty.group D, G₁, G₂⟩ ∈ Γ) :
    Prog.Wf (rec := rec) r Γ (kerProg n₁ G₁) (kerProg n₂ G₂) := by
  unfold kerProg baseWinProg mkWindow mapList
  prog_wf

theorem wf_liftProg {n₁ : var₁ .nat} {n₂ : var₂ .nat} {G₁ : var₁ (Ty.group D)}
    {G₂ : var₂ (Ty.group D)} {π₁ : var₁ Ty.perm} {π₂ : var₂ Ty.perm}
    (hn : ⟨.nat, n₁, n₂⟩ ∈ Γ) (hG : ⟨Ty.group D, G₁, G₂⟩ ∈ Γ) (hπ : ⟨Ty.perm, π₁, π₂⟩ ∈ Γ) :
    Prog.Wf (rec := rec) r Γ (liftProg n₁ G₁ π₁) (liftProg n₂ G₂ π₂) := by
  unfold liftProg baseWinProg mkWindow mapList
  prog_wf

theorem wf_iterStabProg {G₁ : var₁ (Ty.group D)} {G₂ : var₂ (Ty.group D)}
    {ps₁ : var₁ (.list .nat)} {ps₂ : var₂ (.list .nat)} (hG : ⟨Ty.group D, G₁, G₂⟩ ∈ Γ)
    (hps : ⟨.list .nat, ps₁, ps₂⟩ ∈ Γ) :
    Prog.Wf (rec := rec) r Γ (iterStabProg G₁ ps₁) (iterStabProg G₂ ps₂) := by
  unfold iterStabProg
  prog_wf

theorem wf_prodRepsProg {reps₁ : var₁ (.list Ty.perm)} {reps₂ : var₂ (.list Ty.perm)}
    {tr₁ : var₁ (.list (.prod .nat Ty.perm))} {tr₂ : var₂ (.list (.prod .nat Ty.perm))}
    (hreps : ⟨.list Ty.perm, reps₁, reps₂⟩ ∈ Γ)
    (htr : ⟨.list (.prod .nat Ty.perm), tr₁, tr₂⟩ ∈ Γ) :
    Prog.Wf (S := S) (rec := rec) r Γ (prodRepsProg reps₁ tr₁) (prodRepsProg reps₂ tr₂) := by
  unfold prodRepsProg mapList permMul mapArray mapList
  prog_wf

theorem wf_pointStabsProg {G₁ : var₁ (Ty.group D)} {G₂ : var₂ (Ty.group D)}
    {ps₁ : var₁ (.list .nat)} {ps₂ : var₂ (.list .nat)} (hG : ⟨Ty.group D, G₁, G₂⟩ ∈ Γ)
    (hps : ⟨.list .nat, ps₁, ps₂⟩ ∈ Γ) :
    Prog.Wf (rec := rec) r Γ (pointStabsProg G₁ ps₁) (pointStabsProg G₂ ps₂) := by
  unfold pointStabsProg psBody prodRepsProg mapList permMul mapArray mapList permOne
  prog_wf

theorem wf_swapPairProg {m₁ i₁ j₁ k₁ l₁ : var₁ .nat} {m₂ i₂ j₂ k₂ l₂ : var₂ .nat}
    (hm : ⟨.nat, m₁, m₂⟩ ∈ Γ) (hi : ⟨.nat, i₁, i₂⟩ ∈ Γ) (hj : ⟨.nat, j₁, j₂⟩ ∈ Γ)
    (hk : ⟨.nat, k₁, k₂⟩ ∈ Γ) (hl : ⟨.nat, l₁, l₂⟩ ∈ Γ) :
    Prog.Wf (S := S) (rec := rec) r Γ (swapPairProg m₁ i₁ j₁ k₁ l₁)
      (swapPairProg m₂ i₂ j₂ k₂ l₂) := by
  unfold swapPairProg spProg mapList
  prog_wf

theorem wf_giantSetStabProg {n₁ b₁₁ b₂₁ : var₁ .nat} {n₂ b₁₂ b₂₂ : var₂ .nat}
    {G₁ : var₁ (Ty.group D)} {G₂ : var₂ (Ty.group D)} {A₁ : var₁ (.list .nat)}
    {A₂ : var₂ (.list .nat)} (hn : ⟨.nat, n₁, n₂⟩ ∈ Γ) (hG : ⟨Ty.group D, G₁, G₂⟩ ∈ Γ)
    (hA : ⟨.list .nat, A₁, A₂⟩ ∈ Γ) (hb₁ : ⟨.nat, b₁₁, b₁₂⟩ ∈ Γ) (hb₂ : ⟨.nat, b₂₁, b₂₂⟩ ∈ Γ) :
    Prog.Wf (rec := rec) r Γ (giantSetStabProg n₁ G₁ A₁ b₁₁ b₂₁)
      (giantSetStabProg n₂ G₂ A₂ b₁₂ b₂₂) := by
  unfold giantSetStabProg iterStabProg swapPairProg spProg liftProg baseWinProg mkWindow mapList
  prog_wf

end Wf

