module

public import GraphIso.Recursion.Hint
public import GraphIso.GroupOps.Interface

/-!
# Hints as data on extended degrees

The representation of hints for the programs of milestone 14 (`PLAN-14.md` §6 item 1). A
hinted instance has degree `N = n + m`: the string positions `[0, n)` hold the strings and the
windows, and the base positions `[n, N)` carry the base `Γ = Fin (N - n)`. The group acts on
both, so the base action `ψ` is the restriction of the extended permutations
(`baseHom`), and the backend's operations on base positions compute `ψ`'s orbits, the
preimages of its stabilizers, `ker ψ` and lifts.

* `baseSet n N`, `baseHom G n hG`: the base positions and the restriction to them.
* `LabelData`: one list of base indices per position; `labOf n N L u` its denotation.
* `HintValid n N gs w L`: the base is invariant, the window lies in the string positions, the
  labels of window points are duplicate-free lists of base indices, equivariant for the
  generators and not constant on the window. Duplicate-freeness is the representation
  invariant the label programs need (`Toolkit/Labels.lean` links `blockLabel` and `Equidist`
  to duplicate-free lists); the label programs produce duplicate-free lists.
* `HintValid.isHint`: valid data denotes stage 14a's `IsHint` for the generated group.
-/

@[expose] public section

namespace GraphIso.Toolkit

open Equiv Pointwise GraphIso GraphIso.Recursion

/-- The base positions `[n, N)`. -/
def baseSet (n N : ℕ) : Set (Fin N) := {i | n ≤ i.val}

/-- The base point `j` as a position. -/
def basePos {n N : ℕ} (j : Fin (N - n)) : Fin N := ⟨n + j.val, by omega⟩

/-- **The base action**: the restriction of a group preserving `[n, N)` to it, indexed by
`Fin (N - n)`. -/
theorem basePos_mem {n N : ℕ} (j : Fin (N - n)) : basePos j ∈ baseSet n N := by
  simp [basePos, baseSet]

/-- The base index of a base position. -/
theorem lt_of_mem_baseSet {n N : ℕ} {x : Fin N} (_hx : x ∈ baseSet n N) : x.val - n < N - n := by
  have := x.2
  have : n ≤ x.val := _hx
  omega

theorem basePos_sub {n N : ℕ} {x : Fin N} (hx : x ∈ baseSet n N) :
    basePos (n := n) ⟨x.val - n, lt_of_mem_baseSet hx⟩ = x := by
  have : n ≤ x.val := hx
  ext
  simp only [basePos]
  omega

theorem mem_baseSet_apply {N : ℕ} {G : Subgroup (Perm (Fin N))} {n : ℕ}
    (hG : IsInvariant G (baseSet n N)) {g : Perm (Fin N)} (hg : g ∈ G) (j : Fin (N - n)) :
    g (basePos j) ∈ baseSet n N :=
  hG g hg _ (basePos_mem j)

/-- **The base action**: the restriction of a group preserving `[n, N)` to it, indexed by
`Fin (N - n)`. -/
def baseHom {N : ℕ} (G : Subgroup (Perm (Fin N))) (n : ℕ) (hG : IsInvariant G (baseSet n N)) :
    ↥G →* Perm (Fin (N - n)) where
  toFun g :=
    { toFun := fun j => ⟨(g.1 (basePos j)).val - n,
        lt_of_mem_baseSet (mem_baseSet_apply hG g.2 j)⟩
      invFun := fun j => ⟨(g.1⁻¹ (basePos j)).val - n,
        lt_of_mem_baseSet (mem_baseSet_apply hG (G.inv_mem g.2) j)⟩
      left_inv := fun j => by
        apply Fin.ext
        simp only
        rw [basePos_sub (mem_baseSet_apply hG g.2 j)]
        simp [basePos]
      right_inv := fun j => by
        apply Fin.ext
        simp only
        rw [basePos_sub (mem_baseSet_apply hG (G.inv_mem g.2) j)]
        simp [basePos] }
  map_one' := by
    ext j
    simp [basePos]
  map_mul' g h := by
    ext j
    simp only [Subgroup.coe_mul, Perm.mul_apply, Equiv.coe_fn_mk]
    rw [basePos_sub (mem_baseSet_apply hG h.2 j)]

theorem baseHom_apply {N : ℕ} {G : Subgroup (Perm (Fin N))} {n : ℕ}
    {hG : IsInvariant G (baseSet n N)} (g : G) (j : Fin (N - n)) :
    basePos (baseHom G n hG g j) = g.1 (basePos j) :=
  basePos_sub (mem_baseSet_apply hG g.2 j)

/-- The positions `[b, N)`, as a list. -/
def basePts (b N : ℕ) : List ℕ := (List.range (N - b)).map (b + ·)

theorem mem_basePts {b N i : ℕ} : i ∈ basePts b N ↔ b ≤ i ∧ i < N := by
  simp only [basePts, List.mem_map, List.mem_range]
  constructor
  · rintro ⟨k, hk, rfl⟩
    omega
  · rintro ⟨h₁, h₂⟩
    exact ⟨i - b, by omega, by omega⟩

theorem basePts_nodup (b N : ℕ) : (basePts b N).Nodup :=
  (List.nodup_range).map fun _ _ h => by simpa using h

theorem length_basePts (b N : ℕ) : (basePts b N).length = N - b := by simp [basePts]

/-- Labels as data: a list of base indices for every position. -/
abbrev LabelData := Array (List ℕ)

/-- The label of a position as a set of base points (entries `≥ N - n` are ignored). -/
def labOf (n N : ℕ) (L : LabelData) (u : Fin N) : Finset (Fin (N - n)) :=
  ((L.getD u.val []).filterMap fun j => if h : j < N - n then some ⟨j, h⟩ else none).toFinset

/-- The window as a finite set. -/
def winFinset (N : ℕ) (w : WinData) : Finset (Fin N) :=
  Finset.univ.filter fun u => u.val ∈ w.1

/-- **Valid hint data** for the group generated by `gs` at degree `N`, the window `w`, string
positions `[0, n)`. Equivariance is checked on the generators. -/
structure HintValid (n N : ℕ) (gs : GensData) (w : WinData) (L : LabelData) : Prop where
  le : n ≤ N
  base_inv : IsInvariant (GensData.denote N gs) (baseSet n N)
  win_lt : ∀ i ∈ w.1, i < n
  lab_lt : ∀ i ∈ w.1, ∀ j ∈ L.getD i [], j < N - n
  lab_nodup : ∀ i ∈ w.1, (L.getD i []).Nodup
  equivar : ∀ g ∈ gs, ∀ i ∈ w.1,
    (L.getD (get g.1 i) []).toFinset = ((L.getD i []).map fun j => get g.1 (n + j) - n).toFinset
  nonconst : ∃ i ∈ w.1, ∃ j ∈ w.1, (L.getD i []).toFinset ≠ (L.getD j []).toFinset

theorem mem_labOf {n N : ℕ} {L : LabelData} {u : Fin N} {j : Fin (N - n)} :
    j ∈ labOf n N L u ↔ j.val ∈ L.getD u.val [] := by
  simp only [labOf, List.mem_toFinset, List.mem_filterMap]
  constructor
  · rintro ⟨a, ha, h⟩
    split_ifs at h with hlt
    cases h
    exact ha
  · intro h
    exact ⟨j.val, h, by simp [j.2]⟩

theorem mem_winFinset {N : ℕ} {w : WinData} {u : Fin N} : u ∈ winFinset N w ↔ u.val ∈ w.1 := by
  simp [winFinset]

/-- Equivariance of the labels for a single valid generator. -/
theorem labOf_generator {n N : ℕ} {gs : GensData} {w : WinData} {L : LabelData}
    (h : HintValid n N gs w L) {g : PermData} (hg : g ∈ gs) (hgv : PermData.Valid N g)
    (hπ : PermData.denote N g ∈ GensData.denote N gs) {u : Fin N} (hu : u.val ∈ w.1) :
    labOf n N L (PermData.denote N g u) =
      baseHom (GensData.denote N gs) n h.base_inv ⟨_, hπ⟩ • labOf n N L u := by
  ext j
  rw [mem_labOf, Finset.mem_smul_finset, PermData.val_denote_apply hgv]
  have hset := congrArg (fun s => j.val ∈ s) (h.equivar g hg u.val hu)
  simp only [List.mem_toFinset, List.mem_map] at hset
  rw [hset]
  constructor
  · rintro ⟨j', hj', hjj⟩
    have hlt := h.lab_lt u.val hu j' hj'
    refine ⟨⟨j', hlt⟩, mem_labOf.2 hj', ?_⟩
    apply Fin.ext
    change ((PermData.denote N g) (basePos ⟨j', hlt⟩)).val - n = j.val
    rw [PermData.val_denote_apply hgv]
    exact hjj
  · rintro ⟨x, hx, hxj⟩
    refine ⟨x.val, mem_labOf.1 hx, ?_⟩
    rw [← hxj]
    change get g.1 (n + x.val) - n = ((PermData.denote N g) (basePos x)).val - n
    rw [PermData.val_denote_apply hgv]
    rfl

/-- **Valid hint data denotes a hint** of stage 14a: the labels are equivariant for the whole
generated group (not only its generators) and not constant on the window. -/
theorem HintValid.isHint {n N : ℕ} {gs : GensData} {w : WinData} {L : LabelData}
    (h : HintValid n N gs w L) (hgs : GensData.AllValid N gs) (hw : w.Valid N)
    (hinv : IsInvariant (GensData.denote N gs) (w.denote N)) :
    IsHint (baseHom (GensData.denote N gs) n h.base_inv) (winFinset N w) (labOf n N L) := by
  refine ⟨?_, ?_⟩
  · -- equivariance, by induction over the generated subgroup
    rintro ⟨π, hπ⟩ u hu
    rw [mem_winFinset] at hu
    change labOf n N L (π u) = _
    induction hπ using Subgroup.closure_induction generalizing u with
    | mem x hx =>
      obtain ⟨g, hg, rfl⟩ := hx
      exact labOf_generator h hg (hgs g hg) _ hu
    | one =>
      show labOf n N L u = baseHom (GensData.denote N gs) n h.base_inv 1 • labOf n N L u
      rw [map_one, one_smul]
    | mul x y hx hy ihx ihy =>
      have hyu : (y u).val ∈ w.1 := hinv y hy u hu
      rw [Perm.mul_apply, ihx (y u) hyu, ihy u hu, ← mul_smul, ← map_mul]
      rfl
    | inv x hx ihx =>
      have hxu : (x⁻¹ u).val ∈ w.1 := hinv x⁻¹ (inv_mem hx) u hu
      have := ihx (x⁻¹ u) hxu
      rw [show x (x⁻¹ u) = u from x.apply_symm_apply u] at this
      have e : ∀ a b : ↥(GensData.denote N gs), a.1 * b.1 = 1 → a * b = 1 :=
        fun a b hab => Subtype.ext hab
      rw [this, ← mul_smul, ← map_mul, e _ _ (inv_mul_cancel x), map_one, one_smul]
  · obtain ⟨i, hi, j, hj, hne⟩ := h.nonconst
    refine ⟨⟨i, hw.lt i hi⟩, mem_winFinset.2 hi, ⟨j, hw.lt j hj⟩, mem_winFinset.2 hj, ?_⟩
    intro heq
    apply hne
    ext a
    simp only [List.mem_toFinset]
    constructor
    · intro ha
      have hlt := h.lab_lt i hi a ha
      have : (⟨a, hlt⟩ : Fin (N - n)) ∈ labOf n N L ⟨j, hw.lt j hj⟩ := by
        rw [← heq]
        exact mem_labOf.2 ha
      exact mem_labOf.1 this
    · intro ha
      have hlt := h.lab_lt j hj a ha
      have : (⟨a, hlt⟩ : Fin (N - n)) ∈ labOf n N L ⟨i, hw.lt i hi⟩ := by
        rw [heq]
        exact mem_labOf.2 ha
      exact mem_labOf.1 this

end GraphIso.Toolkit
