module

public import GraphIso.Sims.Basic
public import Mathlib.GroupTheory.OrderOfElement

/-!
# Sims tables: theory

For a base order `b` of degree `n` and a table `T` satisfying the slot conditions
(`TableWF n b G T`: entries are valid, lie in `G`, fix `b₀, …, b_{k−1}` in row `k` and map
`b_k` to their slot index, and slot `(k, b_k)` holds the identity):

* `InGamma n T k x`: `x` is a product `σ_k σ_{k+1} ⋯ σ_{n−1}` with `σ_i` in row `i` (the set
  `Γ_k`). Membership is decided by sifting (`sift_eq_iff`), without any group structure:
  the row-`k` factor of `x ∈ Γ_k` is the entry in slot `(k, x b_k)` (`inGamma_iff`).
* **The closure criterion** (`Closed`, `InGamma.mul`): if `τ σ ∈ Γ_k` for every entry `σ` in
  row `k` and `τ` in a row `l ≥ k`, then every `Γ_k` is closed under multiplication, and it is
  the subgroup generated by the entries in rows `≥ k` (`mem_closure_entries_iff`).
* **Completeness** (`complete_of_closed`): if moreover the generators of `G` lie in `Γ₀`, then
  `Γ_k` is the pointwise stabilizer of `b₀, …, b_{k−1}` in `G` (`Complete`), and slot `(k, p)`
  is filled exactly when `p` is in the orbit of `b_k` under that stabilizer
  (`Complete.slot_isSome_iff`).

Points are naturals; `act x p` is the action of `x : Perm (Fin n)` on `p < n`, extended by the
identity, so that base points need no bound proofs.
-/

@[expose] public section

namespace GraphIso.Sims

open Equiv

/-! ### The action on naturals -/

section Act

variable {n : ℕ}

/-- The action of `x` on naturals: on `Fin n` as `x`, the identity on `p ≥ n`. -/
def act (x : Perm (Fin n)) (p : ℕ) : ℕ := if h : p < n then (x ⟨p, h⟩).val else p

theorem act_of_lt (x : Perm (Fin n)) {p : ℕ} (h : p < n) : act x p = (x ⟨p, h⟩).val := by
  simp [act, h]

theorem act_of_ge (x : Perm (Fin n)) {p : ℕ} (h : n ≤ p) : act x p = p := by
  simp [act, show ¬ p < n by omega]

theorem act_lt (x : Perm (Fin n)) {p : ℕ} (h : p < n) : act x p < n := by
  rw [act_of_lt x h]
  exact (x _).2

@[simp] theorem act_one (p : ℕ) : act (1 : Perm (Fin n)) p = p := by
  unfold act
  split <;> rfl

theorem act_mul (x y : Perm (Fin n)) (p : ℕ) : act (x * y) p = act x (act y p) := by
  by_cases h : p < n
  · rw [act_of_lt _ h, act_of_lt x (act_lt y h), Perm.mul_apply]
    congr 2
    exact Fin.ext (act_of_lt y h).symm
  · rw [act_of_ge (x * y) (p := p) (by omega), act_of_ge y (p := p) (by omega),
      act_of_ge x (p := p) (by omega)]

@[simp] theorem act_inv_act (x : Perm (Fin n)) (p : ℕ) : act x⁻¹ (act x p) = p := by
  rw [← act_mul, inv_mul_cancel, act_one]

@[simp] theorem act_act_inv (x : Perm (Fin n)) (p : ℕ) : act x (act x⁻¹ p) = p := by
  rw [← act_mul, mul_inv_cancel, act_one]

theorem act_inv_eq_iff {x : Perm (Fin n)} {p q : ℕ} : act x⁻¹ p = q ↔ p = act x q := by
  constructor
  · rintro rfl
    rw [act_act_inv]
  · rintro rfl
    rw [act_inv_act]

theorem act_denote {σ : PermData} (hσ : σ.Valid n) {p : ℕ} (hp : p < n) :
    act (σ.denote n) p = get σ.1 p := by
  rw [act_of_lt _ hp, PermData.val_denote_apply hσ]

theorem eq_one_of_act {x : Perm (Fin n)} (h : ∀ p < n, act x p = p) : x = 1 := by
  ext i
  have := h i i.2
  rw [act_of_lt _ i.2] at this
  simpa using this

end Act

/-! ### Base orders -/

/-- A base order of degree `n`: all `n` points, without repetition. -/
structure BaseOrder (n : ℕ) (b : Array ℕ) : Prop where
  size : b.size = n
  nodup : b.toList.Nodup
  lt : ∀ k < n, get b k < n

section Base

variable {n : ℕ} {b : Array ℕ}

/-- Every point is a base point. -/
theorem BaseOrder.exists_eq (hb : BaseOrder n b) {p : ℕ} (hp : p < n) : ∃ k < n, get b k = p := by
  have hlen : b.toList.length = n := by rw [Array.length_toList, hb.size]
  have hsub : b.toList.toFinset ⊆ Finset.range n := by
    intro q hq
    obtain ⟨k, hk, rfl⟩ := List.getElem_of_mem (List.mem_toFinset.1 hq)
    rw [Finset.mem_range]
    have := hb.lt k (hlen ▸ hk)
    rwa [get_eq_getElem (by rw [hb.size]; exact hlen ▸ hk), ← Array.getElem_toList] at this
  have heq := Finset.eq_of_subset_of_card_le hsub
    (by rw [Finset.card_range, List.toFinset_card_of_nodup hb.nodup, hlen])
  have hmem : p ∈ b.toList := by
    rw [← List.mem_toFinset, heq, Finset.mem_range]
    exact hp
  obtain ⟨k, hk, hkp⟩ := List.getElem_of_mem hmem
  refine ⟨k, hlen ▸ hk, ?_⟩
  rw [get_eq_getElem (by rw [hb.size]; exact hlen ▸ hk), ← Array.getElem_toList, hkp]

/-- A permutation fixing every base point is the identity. -/
theorem BaseOrder.eq_one (hb : BaseOrder n b) {x : Perm (Fin n)}
    (h : ∀ k < n, act x (get b k) = get b k) : x = 1 :=
  eq_one_of_act fun p hp => by
    obtain ⟨k, hk, rfl⟩ := hb.exists_eq hp
    exact h k hk

end Base

/-! ### Tables -/

/-- The slot conditions, relative to the group `G`. -/
structure TableWF (n : ℕ) (b : Array ℕ) (G : Subgroup (Perm (Fin n))) (T : Table) : Prop where
  base : BaseOrder n b
  size : T.size = n
  rowSize : ∀ k < n, (T.getD k #[]).size = n
  valid : ∀ {k j : ℕ} {σ : PermData}, slot T k j = some σ → σ.Valid n
  mem : ∀ {k j : ℕ} {σ : PermData}, slot T k j = some σ → σ.denote n ∈ G
  fixes : ∀ {k j : ℕ} {σ : PermData}, slot T k j = some σ →
    ∀ i < k, act (σ.denote n) (get b i) = get b i
  image : ∀ {k j : ℕ} {σ : PermData}, slot T k j = some σ → act (σ.denote n) (get b k) = j
  ident : ∀ k < n, slot T k (get b k) = some (PermData.one n)

/-- `T'` keeps every filled slot of `T`. -/
def Extends (T T' : Table) : Prop :=
  ∀ {k j : ℕ} {σ : PermData}, slot T k j = some σ → slot T' k j = some σ

theorem Extends.refl (T : Table) : Extends T T := fun h => h

theorem Extends.trans {T T' T'' : Table} (h₁ : Extends T T') (h₂ : Extends T' T'') :
    Extends T T'' := fun h => h₂ (h₁ h)

section Gamma

variable {n : ℕ} {b : Array ℕ} {G : Subgroup (Perm (Fin n))} {T : Table}

theorem TableWF.row_lt (hT : TableWF n b G T) {k j : ℕ} {σ : PermData} (h : slot T k j = some σ) :
    k < n := by
  by_contra hk
  have : T.getD k #[] = #[] := by
    rw [Array.getD_eq_getD_getElem?, Array.getElem?_eq_none (by rw [hT.size]; omega)]
    rfl
  simp [slot, this] at h

/-- `Γ_k`: products `σ_k σ_{k+1} ⋯ σ_{n−1}` with one entry of each row `i ≥ k`. -/
inductive InGamma (n : ℕ) (T : Table) : ℕ → Perm (Fin n) → Prop
  | last {k : ℕ} : n ≤ k → InGamma n T k 1
  | cons {k j : ℕ} {σ : PermData} {γ : Perm (Fin n)} : k < n → slot T k j = some σ →
      InGamma n T (k + 1) γ → InGamma n T k (σ.denote n * γ)

theorem inGamma_of_ge {k : ℕ} (hk : n ≤ k) {x : Perm (Fin n)} : InGamma n T k x ↔ x = 1 := by
  constructor
  · rintro (_ | ⟨h, _, _⟩)
    · rfl
    · omega
  · rintro rfl
    exact .last hk

/-- Elements of `Γ_k` fix `b₀, …, b_{k−1}`. -/
theorem InGamma.fixes (hT : TableWF n b G T) {k : ℕ} {x : Perm (Fin n)} (h : InGamma n T k x) :
    ∀ i < k, act x (get b i) = get b i := by
  induction h with
  | last _ => simp
  | cons _ hs _ ih =>
    intro i hi
    rw [act_mul, ih i (by omega), hT.fixes hs i hi]

theorem InGamma.mem (hT : TableWF n b G T) {k : ℕ} {x : Perm (Fin n)} (h : InGamma n T k x) :
    x ∈ G := by
  induction h with
  | last _ => exact one_mem G
  | cons _ hs _ ih => exact mul_mem (hT.mem hs) ih

theorem InGamma.mono {T' : Table} (hTT : Extends T T') {k : ℕ} {x : Perm (Fin n)}
    (h : InGamma n T k x) : InGamma n T' k x := by
  induction h with
  | last hk => exact .last hk
  | cons hk hs _ ih => exact .cons hk (hTT hs) ih

/-- The row-`k` factor of an element of `Γ_k` is the entry in the slot of its image of `b_k`. -/
theorem inGamma_iff (hT : TableWF n b G T) {k : ℕ} (hk : k < n) {x : Perm (Fin n)} :
    InGamma n T k x ↔ ∃ σ, slot T k (act x (get b k)) = some σ ∧
      InGamma n T (k + 1) ((σ.denote n)⁻¹ * x) := by
  constructor
  · intro h
    cases h with
    | last h => omega
    | @cons _ j σ γ _ hs hγ =>
      refine ⟨σ, ?_, by rwa [inv_mul_cancel_left]⟩
      rw [act_mul, hγ.fixes hT k (Nat.lt_succ_self k), hT.image hs]
      exact hs
  · rintro ⟨σ, hs, hγ⟩
    have := InGamma.cons hk hs hγ
    rwa [mul_inv_cancel_left] at this

theorem inGamma_one (hT : TableWF n b G T) (k : ℕ) : InGamma n T k 1 := by
  induction h : n - k generalizing k with
  | zero => exact .last (by omega)
  | succ d ih =>
    have hk : k < n := by omega
    have := InGamma.cons hk (hT.ident k hk) (ih (k + 1) (by omega))
    rwa [PermData.denote_one, one_mul] at this

/-- A slot entry lies in `Γ_l` for every row `l` up to its own. -/
theorem inGamma_of_slot (hT : TableWF n b G T) {k j : ℕ} {σ : PermData} (hs : slot T k j = some σ)
    {l : ℕ} (hl : l ≤ k) : InGamma n T l (σ.denote n) := by
  have hk := hT.row_lt hs
  have h₀ : InGamma n T k (σ.denote n) := by
    have := InGamma.cons hk hs (inGamma_one hT (k + 1))
    rwa [mul_one] at this
  induction h : k - l generalizing l with
  | zero => exact (show l = k by omega) ▸ h₀
  | succ d ih =>
    have hl' : l < n := by omega
    have := InGamma.cons hl' (hT.ident l hl') (ih (l := l + 1) (by omega) (by omega))
    rwa [PermData.denote_one, one_mul] at this

end Gamma

/-! ### Sifting -/

section Sift

variable {n : ℕ} {b : Array ℕ} {G : Subgroup (Perm (Fin n))} {T : Table}

/-- Properties of the result `(k', x')` of sifting `x` from row `k`, for every amount of
fuel that reaches the last row. -/
structure SiftResult (n : ℕ) (b : Array ℕ) (G : Subgroup (Perm (Fin n))) (T : Table) (k : ℕ)
    (x : PermData) (r : ℕ × PermData) : Prop where
  valid : r.2.Valid n
  le : k ≤ r.1
  le_n : r.1 ≤ n
  /-- Sifting only moves along filled slots. -/
  of_gamma : InGamma n T k (x.denote n) → InGamma n T r.1 (r.2.denote n)
  /-- The path stays available in every extension of the table. -/
  to_gamma : ∀ {T' : Table}, Extends T T' →
    InGamma n T' r.1 (r.2.denote n) → InGamma n T' k (x.denote n)
  mem_iff : r.2.denote n ∈ G ↔ x.denote n ∈ G
  empty : r.1 < n → slot T r.1 (act (r.2.denote n) (get b r.1)) = none
  fixes : (∀ i < k, act (x.denote n) (get b i) = get b i) →
    ∀ i < r.1, act (r.2.denote n) (get b i) = get b i

theorem siftResult_iter (hT : TableWF n b G T) :
    ∀ (m k : ℕ) (x : PermData), x.Valid n → k ≤ n → n ≤ k + m →
      SiftResult n b G T k x (iter (siftStep n b T) m (k, x))
  | 0, k, x, hx, hk, hm => by
    have hkn : k = n := by omega
    subst hkn
    exact ⟨hx, le_rfl, le_rfl, id, fun _ h => h, Iff.rfl, fun h => absurd h (lt_irrefl _),
      fun h => h⟩
  | m + 1, k, x, hx, hk, hm => by
    by_cases hkn : k < n
    · have hbk := hT.base.lt k hkn
      have hj : get x.1 (get b k) = act (x.denote n) (get b k) := (act_denote hx hbk).symm
      rcases hs : slot T k (get x.1 (get b k)) with _ | σ
      · -- empty slot: stop here
        have hstep : siftStep n b T (k, x) = none := by
          simp [siftStep, hkn, hs]
        have hiter : iter (siftStep n b T) (m + 1) (k, x) = (k, x) := by
          simp [iter, hstep]
        rw [hiter]
        exact ⟨hx, le_rfl, hk, id, fun _ h => h, Iff.rfl, fun _ => hj ▸ hs, fun h => h⟩
      · -- continue from row `k + 1` with `σ⁻¹ x`
        have hstep : siftStep n b T (k, x) = some (k + 1, σ.inv.mul x) := by
          simp [siftStep, hkn, hs]
        have hiter : iter (siftStep n b T) (m + 1) (k, x) =
            iter (siftStep n b T) m (k + 1, σ.inv.mul x) := by
          simp [iter, hstep]
        rw [hiter]
        have hσ := hT.valid hs
        have hx₁ : (σ.inv.mul x).Valid n := hσ.inv.mul hx
        have hden : (σ.inv.mul x).denote n = (σ.denote n)⁻¹ * x.denote n := by
          rw [PermData.denote_mul hσ.inv hx, PermData.denote_inv hσ]
        have ih := siftResult_iter hT m (k + 1) (σ.inv.mul x) hx₁ hkn (by omega)
        have hs' : slot T k (act (x.denote n) (get b k)) = some σ := hj ▸ hs
        refine ⟨ih.valid, by have := ih.le; omega, ih.le_n, fun h => ih.of_gamma ?_,
          fun hTT h => ?_, ?_, ih.empty, fun hfix => ih.fixes ?_⟩
        · obtain ⟨σ', hσ', hγ⟩ := (inGamma_iff hT hkn).1 h
          rw [hs'] at hσ'
          cases hσ'
          rwa [hden]
        · have := InGamma.cons hkn (hTT hs') (ih.to_gamma hTT h)
          rwa [hden, mul_inv_cancel_left] at this
        · rw [ih.mem_iff, hden]
          exact ⟨fun h => by simpa using mul_mem (hT.mem hs) h,
            fun h => mul_mem (inv_mem (hT.mem hs)) h⟩
        · intro i hi
          rw [hden, act_mul]
          rcases Nat.lt_succ_iff_lt_or_eq.1 hi with hi | rfl
          · rw [hfix i hi, act_inv_eq_iff, hT.fixes hs i hi]
          · rw [act_inv_eq_iff, hT.image hs']
    · -- past the last row: stop
      have hkn' : k = n := by omega
      subst hkn'
      have hstep : siftStep k b T (k, x) = none := by simp [siftStep]
      have hiter : iter (siftStep k b T) (m + 1) (k, x) = (k, x) := by simp [iter, hstep]
      rw [hiter]
      exact ⟨hx, le_rfl, le_rfl, id, fun _ h => h, Iff.rfl, fun h => absurd h (lt_irrefl _),
        fun h => h⟩

theorem siftResult (hT : TableWF n b G T) {k : ℕ} {x : PermData} (hx : x.Valid n) (hk : k ≤ n) :
    SiftResult n b G T k x (sift n b T k x) :=
  siftResult_iter hT n k x hx hk (by omega)

/-- **Sifting decides `Γ_k`.** -/
theorem sift_eq_iff (hT : TableWF n b G T) {k : ℕ} {x : PermData} (hx : x.Valid n) (hk : k ≤ n)
    (hfix : ∀ i < k, act (x.denote n) (get b i) = get b i) :
    (sift n b T k x).1 = n ↔ InGamma n T k (x.denote n) := by
  have h := siftResult hT hx hk
  constructor
  · intro he
    refine h.to_gamma (Extends.refl T) ?_
    have h1 : (sift n b T k x).2.denote n = 1 :=
      hT.base.eq_one fun i hi => h.fixes hfix i (by omega)
    rw [he, h1]
    exact .last le_rfl
  · intro hg
    by_contra hne
    have hlt : (sift n b T k x).1 < n := lt_of_le_of_ne h.le_n hne
    obtain ⟨σ, hσ, -⟩ := (inGamma_iff hT hlt).1 (h.of_gamma hg)
    rw [h.empty hlt] at hσ
    cases hσ

end Sift

/-! ### The closure criterion -/

section Closure

variable {n : ℕ} {b : Array ℕ} {G : Subgroup (Perm (Fin n))} {T : Table}

/-- The closure criterion: `τ σ ∈ Γ_k` for every entry `σ` in row `k` and every entry `τ` in a
row `l ≥ k`. -/
def Closed (n : ℕ) (T : Table) : Prop :=
  ∀ {k j l j' : ℕ} {σ τ : PermData}, slot T k j = some σ → k ≤ l → slot T l j' = some τ →
    InGamma n T k (τ.denote n * σ.denote n)

/-- **Under the closure criterion, every `Γ_k` is closed under multiplication.** -/
theorem InGamma.mul (hC : Closed n T) :
    ∀ {k : ℕ} {x y : Perm (Fin n)}, InGamma n T k x → InGamma n T k y → InGamma n T k (x * y) := by
  -- downward induction on the row
  suffices h : ∀ d k, n ≤ k + d → ∀ {x y : Perm (Fin n)}, InGamma n T k x → InGamma n T k y →
      InGamma n T k (x * y) from fun {k} => h n k (by omega)
  intro d
  induction d with
  | zero =>
    intro k hk x y hx hy
    rw [(inGamma_of_ge hk).1 hx, (inGamma_of_ge hk).1 hy, mul_one]
    exact .last hk
  | succ d ih =>
    intro k hk x y hx hy
    by_cases hkn : n ≤ k
    · rw [(inGamma_of_ge hkn).1 hx, (inGamma_of_ge hkn).1 hy, mul_one]
      exact .last hkn
    have ihk : ∀ {x y : Perm (Fin n)}, InGamma n T (k + 1) x → InGamma n T (k + 1) y →
        InGamma n T (k + 1) (x * y) := fun hx hy => ih (k + 1) (by omega) hx hy
    -- left multiplication by an entry of a row `≥ k`
    have hτ : ∀ {l j' : ℕ} {τ : PermData}, k ≤ l → slot T l j' = some τ →
        ∀ {y : Perm (Fin n)}, InGamma n T k y → InGamma n T k (τ.denote n * y) := by
      intro l j' τ hl hτs y hy
      cases hy with
      | last h => omega
      | @cons _ j σ γ hk' hσ hγ =>
        have hc := hC hσ hl hτs
        generalize hz : τ.denote n * σ.denote n = z at hc
        cases hc with
        | last h => omega
        | @cons _ j'' σ' γ' _ hσ' hγ' =>
          have e : τ.denote n * (σ.denote n * γ) = σ'.denote n * (γ' * γ) := by
            rw [← mul_assoc, hz, mul_assoc]
          rw [e]
          exact .cons hk' hσ' (ihk hγ' hγ)
    -- left multiplication by an element of `Γ_m`, `m ≥ k`
    have hprod : ∀ {m : ℕ} {x₁ : Perm (Fin n)}, InGamma n T m x₁ → k ≤ m →
        ∀ {y : Perm (Fin n)}, InGamma n T k y → InGamma n T k (x₁ * y) := by
      intro m x₁ hx₁
      induction hx₁ with
      | last _ => intro _ y hy; rwa [one_mul]
      | cons hm hs _ ih' =>
        intro hkm y hy
        rw [mul_assoc]
        exact hτ hkm hs (ih' (by omega) hy)
    exact hprod hx le_rfl hy

/-- The entries in rows `≥ k`, as permutations. -/
def entries (n : ℕ) (T : Table) (k : ℕ) : Set (Perm (Fin n)) :=
  {x | ∃ l j σ, k ≤ l ∧ slot T l j = some σ ∧ σ.denote n = x}

/-- **Under the closure criterion, `Γ_k` is the subgroup generated by the entries in rows
`≥ k`.** -/
theorem mem_closure_entries_iff (hT : TableWF n b G T) (hC : Closed n T) (k : ℕ)
    (x : Perm (Fin n)) : x ∈ Subgroup.closure (entries n T k) ↔ InGamma n T k x := by
  let M : Submonoid (Perm (Fin n)) :=
    { carrier := {x | InGamma n T k x}
      one_mem' := inGamma_one hT k
      mul_mem' := InGamma.mul hC }
  rw [← Subgroup.mem_toSubmonoid, Subgroup.closure_toSubmonoid_of_finite]
  constructor
  · intro hx
    have hle : Submonoid.closure (entries n T k) ≤ M := by
      rw [Submonoid.closure_le]
      rintro _ ⟨l, j, σ, hl, hs, rfl⟩
      exact inGamma_of_slot hT hs hl
    exact hle hx
  · intro hx
    suffices ∀ {m : ℕ} {x : Perm (Fin n)}, InGamma n T m x → k ≤ m →
        x ∈ Submonoid.closure (entries n T k) from this hx le_rfl
    intro m x hx
    induction hx with
    | last _ => exact fun _ => one_mem _
    | cons _ hs _ ih =>
      intro hkm
      exact mul_mem (Submonoid.subset_closure ⟨_, _, _, hkm, hs, rfl⟩) (ih (by omega))

/-- A complete table for `G`: `Γ_k` is the pointwise stabilizer of `b₀, …, b_{k−1}` in `G`. -/
structure Complete (n : ℕ) (b : Array ℕ) (G : Subgroup (Perm (Fin n))) (T : Table) : Prop where
  wf : TableWF n b G T
  closed : Closed n T
  gamma_iff : ∀ k (x : Perm (Fin n)),
    InGamma n T k x ↔ x ∈ G ∧ ∀ i < k, act x (get b i) = get b i

/-- **Completeness.** A table satisfying the slot conditions and the closure criterion, in
whose `Γ₀` every generator of `G` lies, is complete for `G`. -/
theorem complete_of_closed {S : Set (Perm (Fin n))} (hT : TableWF n b (Subgroup.closure S) T)
    (hC : Closed n T) (hS : ∀ g ∈ S, InGamma n T 0 g) : Complete n b (Subgroup.closure S) T := by
  refine ⟨hT, hC, fun k x => ⟨fun h => ⟨h.mem hT, h.fixes hT⟩, ?_⟩⟩
  rintro ⟨hx, hfix⟩
  have h₀ : InGamma n T 0 x := by
    rw [← mem_closure_entries_iff hT hC]
    have : Subgroup.closure S ≤ Subgroup.closure (entries n T 0) := by
      rw [Subgroup.closure_le]
      intro g hg
      exact (mem_closure_entries_iff hT hC 0 g).2 (hS g hg)
    exact this hx
  induction k with
  | zero => exact h₀
  | succ k ih =>
    have hk := ih fun i hi => hfix i (by omega)
    by_cases hkn : k < n
    · obtain ⟨σ, hσ, hγ⟩ := (inGamma_iff hT hkn).1 hk
      rw [hfix k (Nat.lt_succ_self k), hT.ident k hkn] at hσ
      cases hσ
      rwa [PermData.denote_one, inv_one, one_mul] at hγ
    · rw [inGamma_of_ge (by omega)]
      exact hT.base.eq_one fun i hi => hfix i (by omega)

/-- In a complete table, slot `(k, p)` is filled exactly when some element of `G` fixing
`b₀, …, b_{k−1}` maps `b_k` to `p`. -/
theorem Complete.slot_isSome_iff (hT : Complete n b G T) {k : ℕ} (hk : k < n) (p : ℕ) :
    (slot T k p).isSome ↔ ∃ x ∈ G, (∀ i < k, act x (get b i) = get b i) ∧ act x (get b k) = p := by
  constructor
  · intro h
    obtain ⟨σ, hσ⟩ := Option.isSome_iff_exists.1 h
    exact ⟨σ.denote n, hT.wf.mem hσ, hT.wf.fixes hσ, hT.wf.image hσ⟩
  · rintro ⟨x, hx, hfix, rfl⟩
    obtain ⟨σ, hσ, -⟩ := (inGamma_iff hT.wf hk).1 ((hT.gamma_iff k x).2 ⟨hx, hfix⟩)
    rw [hσ]
    rfl

end Closure

