module

public import GraphIso.Reductions.RestrictionData
public import GraphIso.Reductions.Data
public import GraphIso.Programs.Perm
public import Mathlib.Tactic.Linarith

/-!
# The restriction reduction

`restrictProg sub I` solves the instance `I = (x, y, W, σ • G)` of degree `n`, with a window
listing `m` points, through the restricted instance of degree `m`:

1. the strings `x ∘ e` and `y ∘ σ ∘ e` (normalizing the target), with `e : Fin m ≃ W` the list
   order;
2. the restricted generators `ρ(g)`, from which the backend generates `ρ(G)` at degree `m`;
3. the whole domain of degree `m` as window, and the identity as representative;
4. the sub-solver `sub` on that instance;
5. on an answer `τ' • H'`: a lift `τ` of `τ'` and lifts of the generators of `H'` (`lift`),
   the kernel `K` of the restriction (`kernel`), and the group generated by `K` and the lifts
   at degree `n`. The answer is `(σ τ) • ⟨K, lifts⟩`.

`AnsOK.lift_restrict` and `AnsOK.restrict_none` prove the answer correct
(`iso_eq_of_restrict`). The kernel is part of the answer: without it, a non-faithful
restriction loses solutions (`pointwiseStab_le_aut`).
-/

@[expose] public section

namespace GraphIso

open Equiv Pointwise Cost

/-- The normalized target `y ∘ σ` restricted to the window, in list order. -/
def StrData.restrictComp (pts : List ℕ) (y : StrData) (σ : PermData) : StrData :=
  (pts.map fun u => get y (get σ.1 u)).toArray

section Lift

variable {D : Ty} {DV : ℕ → GensData → D.denote → Prop} {n : ℕ} {w : WinData} {gs : GensData}

theorem StrData.denote_restrictComp (hw : w.Valid n) {σd : PermData} (hσ : σd.Valid n)
    (y : StrData) :
    StrData.denote w.1.length (StrData.restrictComp w.1 y σd) =
      fun j => StrData.denote n y (PermData.denote n σd (WinData.reindex hw j)) := by
  funext j
  simp only [StrData.denote, StrData.restrictComp]
  rw [get_list_toArray _ _ _ j.2, PermData.val_denote_apply hσ, WinData.reindex_val]

/-- The restricted instance's answer `none` gives `none`. -/
theorem AnsOK.restrict_none (hw : w.Valid n) {σd : PermData}
    (hW : IsInvariant (GensData.denote n gs) (w.denote n)) {x y : StrData}
    (h' : AnsOK DV w.1.length Set.univ 1 (restrictHom hW (WinData.reindex hw)).range
      (fun j => StrData.denote n x (WinData.reindex hw j))
      (fun j => StrData.denote n y (PermData.denote n σd (WinData.reindex hw j)))
      (none : AnswerData D)) :
    AnsOK DV n (w.denote n) (PermData.denote n σd) (GensData.denote n gs) (x.denote n)
      (y.denote n) (none : AnswerData D) :=
  iso_eq_empty_of_restrict hW (WinData.reindex hw) _ h'

/-- **Lifting a represented restricted answer.** -/
theorem AnsOK.lift_restrict (hw : w.Valid n) {σd : PermData} (hσ : σd.Valid n)
    (hW : IsInvariant (GensData.denote n gs) (w.denote n)) {x y : StrData} {τ' : PermData}
    {Hd' : GroupData D.denote}
    (h' : AnsOK DV w.1.length Set.univ 1 (restrictHom hW (WinData.reindex hw)).range
      (fun j => StrData.denote n x (WinData.reindex hw j))
      (fun j => StrData.denote n y (PermData.denote n σd (WinData.reindex hw j)))
      (some (τ', Hd')))
    {τ : PermData} (hτ : τ.Valid n) (hτG : PermData.denote n τ ∈ GensData.denote n gs)
    (hττ : MapsWindowBy w τ τ') {lf : PermData → PermData}
    (hlf : ∀ h ∈ Hd'.gens, (lf h).Valid n ∧ PermData.denote n (lf h) ∈ GensData.denote n gs ∧
      MapsWindowBy w (lf h) h)
    {ks : GensData} (hks : GensData.denote n ks = pointwiseStab (GensData.denote n gs) (w.denote n))
    {Hd : GroupData D.denote} (hHd : Hd.degree = n) (hHv : GroupValid DV n Hd.gens Hd.data)
    (hHden : GensData.denote n Hd.gens = GensData.denote n (ks ++ Hd'.gens.map lf)) :
    AnsOK DV n (w.denote n) (PermData.denote n σd) (GensData.denote n gs) (x.denote n)
      (y.denote n) (some (σd.mul τ, Hd)) := by
  obtain ⟨hτ'v, -, hH'v, hiso⟩ := h'
  set e := WinData.reindex hw
  set ρ := restrictHom hW e
  have hρτ : ρ ⟨PermData.denote n τ, hτG⟩ = PermData.denote w.1.length τ' :=
    (mapsWindowBy_iff hW hw hτ hτG hτ'v).1 hττ
  have hL : Subgroup.closure {π | ∃ l, ∃ hl : l ∈ GensData.denote n gs,
      l ∈ GensData.denoteSet n (Hd'.gens.map lf) ∧ ρ ⟨l, hl⟩ = π} =
      GensData.denote w.1.length Hd'.gens := by
    unfold GensData.denote
    congr 1
    ext π
    simp only [GensData.denoteSet, List.mem_map, Set.mem_ofPred_eq]
    constructor
    · rintro ⟨_, hl, ⟨_, ⟨h, hh, rfl⟩, rfl⟩, rfl⟩
      exact ⟨h, hh, ((mapsWindowBy_iff hW hw (hlf h hh).1 hl (hH'v.1 h hh)).1
        (hlf h hh).2.2).symm⟩
    · rintro ⟨h, hh, rfl⟩
      exact ⟨_, (hlf h hh).2.1, ⟨lf h, ⟨h, hh, rfl⟩, rfl⟩,
        (mapsWindowBy_iff hW hw (hlf h hh).1 (hlf h hh).2.1 (hH'v.1 h hh)).1 (hlf h hh).2.2⟩
  have hLG : GensData.denoteSet n (Hd'.gens.map lf) ⊆ GensData.denote n gs := by
    rintro _ ⟨_, hl, rfl⟩
    obtain ⟨h, hh, rfl⟩ := List.mem_map.1 hl
    exact (hlf h hh).2.1
  have hmain := iso_eq_of_restrict hW e (x := x.denote n) (y := y.denote n)
    (PermData.denote n σd) hiso.symm hτG hρτ hLG hL
  refine ⟨hσ.mul hτ, hHd, hHv, ?_⟩
  rw [hmain, PermData.denote_mul hσ hτ, hHden, GensData.denote_append, hks, sup_comm]
  rfl

end Lift

end GraphIso

namespace GraphIso.Programs

open Equiv Pointwise Cost

section Programs

variable {D : Ty} {S : Signature} {rec : Ty × Ty} {var : Ty → Type}

/-- The positions of the listed points, in an array of size `n`. -/
def posProg (n : var .nat) (pts : var (.list .nat)) : Prog S rec var (.array .nat) :=
  .bind (.op1 .arrayOfList pts) fun wa => .bind (.op1 .length pts) fun m =>
  .bind (.op1 .range m) fun js =>
  .bind (mapList js fun j => .bind (.op2 .arrayGet wa j) fun u => .op2 .pair u j) fun ws =>
  .bind (.op0 (.natLit 0)) fun z => .bind (.op2 .arrayMk n z) fun blank =>
  .prim .arrayUpdate (.cons blank (.cons ws .nil))

/-- `g` restricted to the listed points, through their positions. -/
def restrictPermProg (pos : var (.array .nat)) (pts : var (.list .nat)) (g : var Ty.perm) :
    Prog S rec var Ty.perm :=
  .bind (.op1 .fst g) fun f => .bind (.op1 .snd g) fun fi =>
  .bind (mapList pts fun u => .bind (.op2 .arrayGet f u) fun v => .op2 .arrayGet pos v) fun l₁ =>
  .bind (mapList pts fun u => .bind (.op2 .arrayGet fi u) fun v => .op2 .arrayGet pos v)
    fun l₂ =>
  .bind (.op1 .arrayOfList l₁) fun a₁ => .bind (.op1 .arrayOfList l₂) fun a₂ => .op2 .pair a₁ a₂

/-- `x` restricted to the listed points. -/
def restrictStrProg (pts : var (.list .nat)) (x : var Ty.str) : Prog S rec var Ty.str :=
  .bind (mapList pts fun u => .op2 .arrayGet x u) fun l => .op1 .arrayOfList l

/-- `y ∘ σ` restricted to the listed points. -/
def restrictCompProg (pts : var (.list .nat)) (y : var Ty.str) (σ : var Ty.perm) :
    Prog S rec var Ty.str :=
  .bind (.op1 .fst σ) fun f =>
  .bind (mapList pts fun u => .bind (.op2 .arrayGet f u) fun v => .op2 .arrayGet y v) fun l =>
  .op1 .arrayOfList l

/-- Lift a restricted answer `(τ', H')`: lifts of `τ'` and of the generators of `H'`, the
kernel, and the group they generate at degree `n`; the representative is `σ τ`. -/
def liftAnswerProg (n : var .nat) (σ : var Ty.perm) (G : var (Ty.group D)) (w : var Ty.win)
    (c' : var (Ty.coset D)) : Prog (groupSig D) rec var (Ty.answer D) :=
  .bind (.op1 .fst c') fun τ' => .bind (.op1 .snd c') fun H' =>
  .bind (.op1 .snd H') fun hd => .bind (.op1 .fst hd) fun hgs =>
  .bind (.op2 .pair w τ') fun wτ => .bind (.op2 .pair G wτ) fun aτ =>
  .bind (Prog.call (S := groupSig D) GroupOp.lift aτ) fun τ =>
  .bind (mapList hgs fun h => .bind (.op2 .pair w h) fun wh => .bind (.op2 .pair G wh) fun ah =>
      Prog.call (S := groupSig D) GroupOp.lift ah) fun ls =>
  .bind (.op2 .pair G w) fun gw => .bind (Prog.call (S := groupSig D) GroupOp.kernel gw) fun K =>
  .bind (.op1 .snd K) fun kd => .bind (.op1 .fst kd) fun ks =>
  .bind (.op2 .append ks ls) fun hs => .bind (.op2 .pair n hs) fun arg =>
  .bind (Prog.call (S := groupSig D) GroupOp.generate arg) fun H =>
  .bind (permMul σ τ) fun στ => .bind (.op2 .pair στ H) fun c => .op1 .some c

/-- Solve an instance through its restriction to the window. -/
def restrictProg (sub : var (Ty.inst D) → Prog (groupSig D) rec var (Ty.answer D))
    (I : var (Ty.inst D)) : Prog (groupSig D) rec var (Ty.answer D) :=
  .bind (.op1 .fst I) fun xy => .bind (.op1 .snd I) fun wc =>
  .bind (.op1 .fst wc) fun w => .bind (.op1 .snd wc) fun c =>
  .bind (.op1 .fst c) fun σ => .bind (.op1 .snd c) fun G =>
  .bind (.op1 .fst G) fun n => .bind (.op1 .snd G) fun gd => .bind (.op1 .fst gd) fun gs =>
  .bind (.op1 .fst xy) fun x => .bind (.op1 .snd xy) fun y =>
  .bind (.op1 .fst w) fun pts => .bind (.op1 .length pts) fun m =>
  .bind (posProg n pts) fun pos =>
  .bind (restrictStrProg pts x) fun x' => .bind (restrictCompProg pts y σ) fun y' =>
  .bind (mapList gs fun g => restrictPermProg pos pts g) fun gs' =>
  .bind (.op2 .pair m gs') fun arg =>
  .bind (Prog.call (S := groupSig D) GroupOp.generate arg) fun G' =>
  .bind (.op1 .range m) fun js => .bind (mkWindow m js) fun u =>
  .bind (permOne m) fun one =>
  .bind (.op2 .pair one G') fun c' => .bind (.op2 .pair u c') fun wc' =>
  .bind (.op2 .pair x' y') fun xy' => .bind (.op2 .pair xy' wc') fun J =>
  .bind (sub J) fun a =>
  .caseOption a (.op0 .none) fun c'' => liftAnswerProg n σ G w c''

end Programs

section Specs

variable {S : Signature} {a b : Ty} {X : Ctx S} {body : a.denote → Prog S (a, b) Ty.denote b}

theorem RunsWithin.posProg (n : ℕ) (w : WinData) :
    RunsWithin X body (Programs.posProg n w.1) (WinData.pos n w)
      (2 * n + 9 * w.1.length + 8) := by
  apply RunsWithin.mono
  case h =>
    run_step (RunsWithin.prim _ _)
    run_step (RunsWithin.prim _ _)
    run_step (RunsWithin.prim _ _)
    run_step (RunsWithin.mapList_le (c := 2) fun j _ =>
      RunsWithin.bind_le (RunsWithin.prim _ _) (RunsWithin.prim _ _) (by simp [Prim.cost]))
    run_step (RunsWithin.prim _ _)
    run_step (RunsWithin.prim _ _)
    exact RunsWithin.prim_le rfl le_rfl
  case hc =>
    simp only [Prim.cost, Prim.eval, Args.head, Args.tail, List.length_range, List.length_map,
      Array.size_replicate]
    omega

theorem RunsWithin.restrictPermProg (pos : Array ℕ) (pts : List ℕ) (g : PermData) :
    RunsWithin X body (Programs.restrictPermProg pos pts g) (PermData.restrictTo pos pts g)
      (12 * pts.length + 9) := by
  apply RunsWithin.mono
  case h =>
    run_step (RunsWithin.prim _ _)
    run_step (RunsWithin.prim _ _)
    run_step (RunsWithin.mapList_le (c := 2) fun u _ =>
      RunsWithin.bind_le (RunsWithin.prim _ _) (RunsWithin.prim _ _) (by simp [Prim.cost]))
    run_step (RunsWithin.mapList_le (c := 2) fun u _ =>
      RunsWithin.bind_le (RunsWithin.prim _ _) (RunsWithin.prim _ _) (by simp [Prim.cost]))
    run_step (RunsWithin.prim _ _)
    run_step (RunsWithin.prim _ _)
    exact RunsWithin.prim_le rfl le_rfl
  case hc =>
    simp only [Prim.cost, Prim.eval, Args.head, List.length_map]
    omega

theorem RunsWithin.restrictStrProg (pts : List ℕ) (x : StrData) :
    RunsWithin X body (Programs.restrictStrProg pts x) (StrData.restrictTo pts x)
      (5 * pts.length + 3) := by
  apply RunsWithin.mono
  case h =>
    run_step (RunsWithin.mapList_le (c := 1) fun u _ => RunsWithin.prim _ _)
    exact RunsWithin.prim_le rfl le_rfl
  case hc =>
    simp only [Prim.cost, Args.head, List.length_map]
    omega

theorem RunsWithin.restrictCompProg (pts : List ℕ) (y : StrData) (σ : PermData) :
    RunsWithin X body (Programs.restrictCompProg pts y σ) (StrData.restrictComp pts y σ)
      (6 * pts.length + 4) := by
  apply RunsWithin.mono
  case h =>
    run_step (RunsWithin.prim _ _)
    run_step (RunsWithin.mapList_le (c := 2) fun u _ =>
      RunsWithin.bind_le (RunsWithin.prim _ _) (RunsWithin.prim _ _) (by simp [Prim.cost]))
    exact RunsWithin.prim_le rfl le_rfl
  case hc =>
    simp only [Prim.cost, Args.head, List.length_map]
    omega

end Specs

/-! ### The reduction -/

section Reduction

variable {D : Ty} {a b : Ty} {X : Ctx (groupSig D)}
  {body : a.denote → Prog (groupSig D) (a, b) Ty.denote b} {DV : ℕ → GensData → D.denote → Prop}

/-- The backend operations used by the restriction reduction. -/
def restrictOps (op : GroupOp) : Prop := op = .generate ∨ op = .lift ∨ op = .kernel

/-- The cost of lifting an answer with at most `s'` generators, with a kernel of at most `sK`
generators, `Blift`, `Bker` and `Bgn` bounding the charges of `lift`, `kernel` and `generate`. -/
def liftCost (n s' sK Blift Bker Bgn : ℕ) : ℕ :=
  12 * n + sK + s' * (Blift + 5) + Blift + Bker + Bgn + 30

/-- The lift computed by the backend. -/
def liftOf (O : Oracle (groupSig D)) (G : GroupData D.denote) (w : WinData) (h : PermData) :
    PermData :=
  O.run GroupOp.lift (G, (w, h))

/-- A permutation in the restricted group has a lift: the precondition of `lift`. -/
theorem exists_lift {n : ℕ} {w : WinData} {G : Subgroup (Perm (Fin n))}
    (hW : IsInvariant G (w.denote n)) (hw : w.Valid n) {π' : PermData}
    (hπ : π'.Valid w.1.length)
    (hmem : PermData.denote w.1.length π' ∈ (restrictHom hW (WinData.reindex hw)).range) :
    ∃ r, PermData.Valid n r ∧ PermData.denote n r ∈ G ∧ MapsWindowBy w r π' := by
  obtain ⟨g, hg⟩ := hmem
  have hgG : PermData.denote n (PermData.ofPerm (g : Perm (Fin n))) ∈ G := by
    rw [PermData.denote_ofPerm]
    exact g.2
  refine ⟨PermData.ofPerm (g : Perm (Fin n)), PermData.valid_ofPerm _, hgG,
    (mapsWindowBy_iff hW hw (PermData.valid_ofPerm _) hgG hπ).2 ?_⟩
  rw [← hg]
  congr 1
  exact Subtype.ext (PermData.denote_ofPerm _)

theorem RunsWithin.liftAnswerProg (hO : MeetsContractOn DV restrictOps X.O)
    (hPre : ∀ op x, restrictOps op → GroupPre DV op x → X.Pre op x)
    {xy : StrData × StrData} {w : WinData} {σd : PermData} {n : ℕ} {gs : GensData}
    {d : D.denote} (hw : w.Valid n) (hσ : σd.Valid n) (hgv : GroupValid DV n gs d)
    (hW : IsInvariant (GensData.denote n gs) (w.denote n)) {τ' : PermData}
    {Hd' : GroupData D.denote}
    (h' : AnsOK DV w.1.length Set.univ 1 (restrictHom hW (WinData.reindex hw)).range
      (fun j => StrData.denote n xy.1 (WinData.reindex hw j))
      (fun j => StrData.denote n xy.2 (PermData.denote n σd (WinData.reindex hw j)))
      (some (τ', Hd')))
    {s' sK Blift Bker Bgn : ℕ} (hs' : Hd'.gens.length ≤ s')
    (hBlift : ∀ π' : PermData, X.B.call GroupOp.lift ((n, gs, d), (w, π'))
      (X.O.run GroupOp.lift ((n, gs, d), (w, π'))) ≤ Blift)
    (hBker : X.B.call GroupOp.kernel ((n, gs, d), w) (X.O.run GroupOp.kernel ((n, gs, d), w)) ≤
      Bker)
    (hsK : (X.O.run GroupOp.kernel ((n, gs, d), w)).2.1.length ≤ sK)
    (hBgn : ∀ hs : GensData, GensData.AllValid n hs → hs.length ≤ sK + s' →
      GensData.denote n hs ≤ GensData.denote n gs →
      X.B.call GroupOp.generate (n, hs) (X.O.run GroupOp.generate (n, hs)) ≤ Bgn) :
    ∃ ans : AnswerData D,
      RunsWithin X body (Programs.liftAnswerProg n σd (n, gs, d) w (τ', Hd')) ans
        (liftCost n s' sK Blift Bker Bgn) ∧
      AnsOK DV n (w.denote n) (PermData.denote n σd) (GensData.denote n gs) (xy.1.denote n)
        (xy.2.denote n) ans ∧
      ∀ sGen, (∀ hs, GensData.AllValid n hs → GensData.denote n hs ≤ GensData.denote n gs →
          (X.O.run GroupOp.generate (n, hs)).2.1.length ≤ sGen) →
        ∀ c : CosetData D, ans = some c → c.2.gens.length ≤ sGen := by
  have hτ'v : τ'.Valid w.1.length := h'.1
  have hH'v : GensData.AllValid w.1.length Hd'.gens := h'.2.2.1.1
  -- the representative and the generators of `H'` lie in the restricted group
  have hτ'mem : PermData.denote w.1.length τ' ∈ (restrictHom hW (WinData.reindex hw)).range := by
    have h := h'.2.2.2
    have hself : PermData.denote w.1.length τ' ∈ PermData.denote w.1.length τ' •
        (GensData.denote w.1.length Hd'.gens : Set (Perm (Fin w.1.length))) :=
      self_mem_leftCoset _ _
    rw [h, mem_iso_one] at hself
    exact hself.1
  have hHmem : ∀ h ∈ Hd'.gens,
      PermData.denote w.1.length h ∈ (restrictHom hW (WinData.reindex hw)).range := by
    intro h hh
    have haut := AnsOK.eq_aut (isInvariant_univ _) h'
    exact aut_le _ _ (haut ▸ GensData.mem_denote_of_mem hh)
  have hpre : ∀ π' : PermData, π'.Valid w.1.length →
      PermData.denote w.1.length π' ∈ (restrictHom hW (WinData.reindex hw)).range →
      GroupPre DV .lift ((n, gs, d), (w, π')) := fun π' hπ hm =>
    ⟨hgv, hw, hW, hπ, exists_lift hW hw hπ hm⟩
  have hliftPost : ∀ π' : PermData, π'.Valid w.1.length →
      PermData.denote w.1.length π' ∈ (restrictHom hW (WinData.reindex hw)).range →
      GroupPost DV .lift ((n, gs, d), (w, π')) (X.O.run GroupOp.lift ((n, gs, d), (w, π'))) :=
    fun π' hπ hm => hO .lift _ (Or.inr (Or.inl rfl)) (hpre π' hπ hm)
  obtain ⟨hτv, hτG, hττ⟩ := hliftPost τ' hτ'v hτ'mem
  have hlf : ∀ h ∈ Hd'.gens, PermData.Valid n (liftOf X.O (n, gs, d) w h) ∧
      PermData.denote n (liftOf X.O (n, gs, d) w h) ∈ GensData.denote n gs ∧
      MapsWindowBy w (liftOf X.O (n, gs, d) w h) h :=
    fun h hh => hliftPost h (hH'v h hh) (hHmem h hh)
  -- the kernel
  have hkpre : GroupPre DV .kernel ((n, gs, d), w) := ⟨hgv, hw, hW⟩
  have hkpost := hO .kernel _ (Or.inr (Or.inr rfl)) hkpre
  rcases hK : X.O.run GroupOp.kernel ((n, gs, d), w) with ⟨n', ks, e'⟩
  rw [hK] at hkpost hBker hsK
  change ks.length ≤ sK at hsK
  obtain ⟨hn', hksv, hksden⟩ := hkpost
  subst n'
  -- the generated group
  have hhsv : GensData.AllValid n
      (ks ++ Hd'.gens.map (liftOf X.O (n, gs, d) w)) := by
    refine GensData.AllValid.append hksv.1 fun l hl => ?_
    obtain ⟨h, hh, rfl⟩ := List.mem_map.1 hl
    exact (hlf h hh).1
  have hhsle : GensData.denote n
      (ks ++ Hd'.gens.map (liftOf X.O (n, gs, d) w)) ≤
      GensData.denote n gs := by
    rw [GensData.denote_append, sup_le_iff]
    refine ⟨?_, GensData.denote_le_iff.2 fun l hl => ?_⟩
    · change GensData.denote n ks ≤ _
      rw [hksden]
      exact pointwiseStab_le _ _
    · obtain ⟨h, hh, rfl⟩ := List.mem_map.1 hl
      exact (hlf h hh).2.1
  have hhslen : (ks ++ Hd'.gens.map (liftOf X.O (n, gs, d) w)).length ≤ sK + s' := by
    simp only [List.length_append, List.length_map]
    omega
  have hgpost := hO .generate (n, ks ++ Hd'.gens.map (liftOf X.O (n, gs, d) w)) (Or.inl rfl)
    hhsv
  have hBg := hBgn _ hhsv hhslen hhsle
  rcases hH : X.O.run GroupOp.generate (n, ks ++ Hd'.gens.map (liftOf X.O (n, gs, d) w)) with
    ⟨n'', hs'', e''⟩
  rw [hH] at hgpost hBg
  obtain ⟨hn'', hHv, hHden⟩ := hgpost
  subst n''
  refine ⟨some (σd.mul (X.O.run GroupOp.lift ((n, gs, d), (w, τ'))), (n, hs'', e'')), ?_, ?_, ?_⟩
  · have hmap := RunsWithin.mapList_le (X := X) (body := body) (a' := Ty.perm) (b' := Ty.perm)
      (xs := Hd'.gens) (c := Blift + 2)
      (F := liftOf X.O (n, gs, d) w)
      (f := fun h => .bind (.op2 .pair w h) fun wh => .bind (.op2 .pair (n, gs, d) wh) fun ah =>
        Prog.call (S := groupSig D) GroupOp.lift ah) fun h hh => by
      apply RunsWithin.mono
      case h =>
        run_step (RunsWithin.prim _ _)
        run_step (RunsWithin.prim _ _)
        exact RunsWithin.call (hPre _ _ (Or.inr (Or.inl rfl)) (hpre h (hH'v h hh) (hHmem h hh)))
      case hc =>
        simp only [Prim.cost, Prim.eval]
        have := hBlift h
        omega
    have hmul : Hd'.gens.length * (Blift + 2 + 3) ≤ s' * (Blift + 5) :=
      Nat.mul_le_mul hs' le_rfl
    apply RunsWithin.mono
    case h =>
      run_step (RunsWithin.prim _ _)
      run_step (RunsWithin.prim _ _)
      run_step (RunsWithin.prim _ _)
      run_step (RunsWithin.prim _ _)
      run_step (RunsWithin.prim _ _)
      run_step (RunsWithin.prim _ _)
      run_step (RunsWithin.call (hPre _ _ (Or.inr (Or.inl rfl)) (hpre τ' hτ'v hτ'mem)))
      run_step hmap
      run_step (RunsWithin.prim _ _)
      run_step (RunsWithin.call (hPre _ _ (Or.inr (Or.inr rfl)) hkpre))
      simp only [Prim.eval]
      rw [hK]
      run_step (RunsWithin.prim _ _)
      run_step (RunsWithin.prim _ _)
      run_step (RunsWithin.prim _ _)
      run_step (RunsWithin.prim _ _)
      run_step (RunsWithin.call (hPre _ _ (Or.inl rfl) hhsv))
      simp only [Prim.eval]
      rw [hH]
      run_step (RunsWithin.permMul hσ hτv)
      run_step (RunsWithin.prim _ _)
      exact RunsWithin.prim _ _
    case hc =>
      simp only [Prim.cost, Prim.eval, Args.head_cons, liftCost]
      rw [hK, hH]
      have := hBlift τ'
      clear * - this hBker hBg hsK hmul
      omega
  · exact AnsOK.lift_restrict hw hσ hW h' hτv hτG hττ hlf hksden rfl hHv hHden
  · intro sGen hgen c hc
    cases hc
    have := hgen _ hhsv hhsle
    rw [hH] at this
    exact this

/-- The restricted instance of `I`: the restricted strings, the whole domain of degree `m`, the
identity, and the restricted group as generated by the backend. -/
def restrictInst (O : Oracle (groupSig D)) (I : InstData D) : InstData D :=
  ((StrData.restrictTo I.2.1.1 I.1.1, StrData.restrictComp I.2.1.1 I.1.2 I.2.2.1),
    WinData.ofPoints I.2.1.1.length (List.range I.2.1.1.length), PermData.one I.2.1.1.length,
    O.run GroupOp.generate
      (I.2.1.1.length, GensData.restrictTo (WinData.pos I.2.2.2.1 I.2.1) I.2.1.1 I.2.2.2.2.1))

/-- The cost of the restriction reduction, for degree `n`, window size `m`, `s` generators, a
sub-solver of cost `C` returning at most `s'` generators, a kernel of at most `sK` generators,
and charges bounded by `Bgm` (generating the restricted group), `Blift`, `Bker` and `Bgn`
(generating the lifted group). -/
def restrictCost (n m s C s' sK Bgm Blift Bker Bgn : ℕ) : ℕ :=
  2 * n + 31 * m + s * (12 * m + 12) + Bgm + C + liftCost n s' sK Blift Bker Bgn + 47

/-- **The restriction reduction.** The sub-solver is called once, on the restricted instance
of degree `m`; the answer is lifted back to degree `n` with the kernel. -/
theorem RunsWithin.restrictProg (hO : MeetsContractOn DV restrictOps X.O)
    (hPre : ∀ op x, restrictOps op → GroupPre DV op x → X.Pre op x)
    {sub : InstData D → Prog (groupSig D) (a, b) Ty.denote (Ty.answer D)}
    {xy : StrData × StrData} {w : WinData} {σd : PermData} {n : ℕ} {gs : GensData}
    {d : D.denote} (hv : InstData.Valid (D := D) (xy, w, σd, n, gs, d) DV)
    {C s' sK Bgm Blift Bker Bgn : ℕ}
    (hsub : SubSolves X body DV sub
      (fun J => J = restrictInst X.O (xy, w, σd, n, gs, d) ∧ J.Valid DV) (fun _ => C) s')
    (hBgm : X.B.call GroupOp.generate
      (w.1.length, GensData.restrictTo (WinData.pos n w) w.1 gs)
      (X.O.run GroupOp.generate (w.1.length, GensData.restrictTo (WinData.pos n w) w.1 gs)) ≤ Bgm)
    (hBlift : ∀ π' : PermData, X.B.call GroupOp.lift ((n, gs, d), (w, π'))
      (X.O.run GroupOp.lift ((n, gs, d), (w, π'))) ≤ Blift)
    (hBker : X.B.call GroupOp.kernel ((n, gs, d), w) (X.O.run GroupOp.kernel ((n, gs, d), w)) ≤
      Bker)
    (hsK : (X.O.run GroupOp.kernel ((n, gs, d), w)).2.1.length ≤ sK)
    (hBgn : ∀ hs : GensData, GensData.AllValid n hs → hs.length ≤ sK + s' →
      GensData.denote n hs ≤ GensData.denote n gs →
      X.B.call GroupOp.generate (n, hs) (X.O.run GroupOp.generate (n, hs)) ≤ Bgn) :
    ∃ ans : AnswerData D,
      RunsWithin X body (Programs.restrictProg sub (xy, w, σd, n, gs, d)) ans
        (restrictCost n w.1.length gs.length C s' sK Bgm Blift Bker Bgn) ∧
      AnsOK DV n (w.denote n) (PermData.denote n σd) (GensData.denote n gs) (xy.1.denote n)
        (xy.2.denote n) ans ∧
      ∀ sGen, (∀ hs, GensData.AllValid n hs → GensData.denote n hs ≤ GensData.denote n gs →
          (X.O.run GroupOp.generate (n, hs)).2.1.length ≤ sGen) →
        ∀ c : CosetData D, ans = some c → c.2.gens.length ≤ sGen := by
  obtain ⟨hw, hσ, hgv, hW⟩ := hv
  change WinData.Valid n w at hw
  change PermData.Valid n σd at hσ
  change GroupValid DV n gs d at hgv
  change IsInvariant (GensData.denote n gs) (WinData.denote n w) at hW
  have hg'v := GensData.allValid_restrictTo hW hw hgv.1
  have hg'den := GensData.denote_restrictTo hW hw hgv.1
  have hgenpost := hO .generate (w.1.length, GensData.restrictTo (WinData.pos n w) w.1 gs)
    (Or.inl rfl) hg'v
  rcases hG' : X.O.run GroupOp.generate
    (w.1.length, GensData.restrictTo (WinData.pos n w) w.1 gs) with ⟨m', gs'', d''⟩
  rw [hG'] at hgenpost hBgm
  obtain ⟨hm', hG'v, hG'den⟩ := hgenpost
  subst m'
  have hJ : restrictInst X.O (xy, w, σd, n, gs, d) =
      ((StrData.restrictTo w.1 xy.1, StrData.restrictComp w.1 xy.2 σd),
        WinData.ofPoints w.1.length (List.range w.1.length), PermData.one w.1.length,
        (w.1.length, gs'', d'')) := by
    simp only [restrictInst]
    rw [hG']
  have hJv : (restrictInst X.O (xy, w, σd, n, gs, d)).Valid DV := by
    rw [hJ]
    refine ⟨WinData.valid_univ _, PermData.valid_one _, hG'v, ?_⟩
    change IsInvariant _ (WinData.denote w.1.length _)
    rw [WinData.denote_univ]
    exact isInvariant_univ _
  obtain ⟨a', ha', hok', hg'⟩ := hsub _ ⟨rfl, hJv⟩
  have hok : AnsOK DV w.1.length Set.univ 1 (restrictHom hW (WinData.reindex hw)).range
      (fun j => StrData.denote n xy.1 (WinData.reindex hw j))
      (fun j => StrData.denote n xy.2 (PermData.denote n σd (WinData.reindex hw j))) a' := by
    have h := hok'
    rw [hJ] at h
    change AnsOK DV w.1.length
      (WinData.denote w.1.length (WinData.ofPoints w.1.length (List.range w.1.length)))
      (PermData.denote w.1.length (PermData.one w.1.length)) (GensData.denote w.1.length gs'')
      (StrData.denote w.1.length (StrData.restrictTo w.1 xy.1))
      (StrData.denote w.1.length (StrData.restrictComp w.1 xy.2 σd)) a' at h
    rwa [WinData.denote_univ, PermData.denote_one, hG'den, hg'den, StrData.denote_restrictTo hw,
      StrData.denote_restrictComp hw hσ] at h
  -- the run up to the sub-solver's answer
  have hprefix : ∀ (ans : AnswerData D) (c : ℕ),
      RunsWithin X body (.caseOption a' (.op0 .none) fun c'' =>
        Programs.liftAnswerProg n σd (n, gs, d) w c'') ans c →
      RunsWithin X body (Programs.restrictProg sub (xy, w, σd, n, gs, d)) ans
        (2 * n + 31 * w.1.length + gs.length * (12 * w.1.length + 12) + Bgm + C + c + 46) := by
    intro ans c h
    have hG2 : X.O.run GroupOp.generate
        (w.1.length, gs.map (PermData.restrictTo (WinData.pos n w) w.1)) =
        (w.1.length, gs'', d'') := hG'
    have hmap := RunsWithin.mapList_le (X := X) (body := body) (a' := Ty.perm) (b' := Ty.perm)
      (xs := gs) (c := 12 * w.1.length + 9)
      (F := PermData.restrictTo (WinData.pos n w) w.1)
      (f := fun g => Programs.restrictPermProg (WinData.pos n w) w.1 g) fun g _ =>
        RunsWithin.restrictPermProg _ _ _
    apply RunsWithin.mono
    case h =>
      run_step (RunsWithin.prim _ _)
      run_step (RunsWithin.prim _ _)
      run_step (RunsWithin.prim _ _)
      run_step (RunsWithin.prim _ _)
      run_step (RunsWithin.prim _ _)
      run_step (RunsWithin.prim _ _)
      run_step (RunsWithin.prim _ _)
      run_step (RunsWithin.prim _ _)
      run_step (RunsWithin.prim _ _)
      run_step (RunsWithin.prim _ _)
      run_step (RunsWithin.prim _ _)
      run_step (RunsWithin.prim _ _)
      run_step (RunsWithin.prim _ _)
      run_step (RunsWithin.posProg n w)
      run_step (RunsWithin.restrictStrProg w.1 xy.1)
      run_step (RunsWithin.restrictCompProg w.1 xy.2 σd)
      run_step hmap
      run_step (RunsWithin.prim _ _)
      run_step (RunsWithin.call (hPre _ _ (Or.inl rfl) hg'v))
      simp only [Prim.eval]
      rw [hG2]
      run_step (RunsWithin.prim _ _)
      run_step (RunsWithin.mkWindow _ _)
      run_step (RunsWithin.permOne _)
      run_step (RunsWithin.prim _ _)
      run_step (RunsWithin.prim _ _)
      run_step (RunsWithin.prim _ _)
      run_step (RunsWithin.prim _ _)
      run_step (hJ ▸ ha')
      exact h
    case hc =>
      simp only [Prim.cost, Prim.eval, Args.head_cons, List.length_range]
      rw [hG2]
      have hB2 : X.B.call GroupOp.generate
          (w.1.length, gs.map (PermData.restrictTo (WinData.pos n w) w.1)) (w.1.length, gs'', d'') ≤
          Bgm := hBgm
      generalize X.B.call GroupOp.generate
        (w.1.length, gs.map (PermData.restrictTo (WinData.pos n w) w.1)) (w.1.length, gs'', d'') =
        B at hB2 ⊢
      clear * - hB2
      simp only [Nat.add_assoc, Nat.reduceAdd] at *
      linarith
  rcases a' with _ | ⟨τ', Hd'⟩
  · refine ⟨none, (hprefix none 2 (RunsWithin.caseOption_none (RunsWithin.prim _ _))).mono ?_,
      AnsOK.restrict_none hw hW hok, fun _ _ c hc => absurd hc (by simp)⟩
    simp only [restrictCost, liftCost]
    omega
  · obtain ⟨ans, hl, hlok, hlgen⟩ := RunsWithin.liftAnswerProg (X := X) (body := body) hO hPre
      (xy := xy) hw hσ hgv hW hok (hg' _ rfl) hBlift hBker hsK hBgn
    refine ⟨ans, (hprefix ans _ (RunsWithin.caseOption_some hl)).mono ?_, hlok, hlgen⟩
    simp only [restrictCost]
    omega

end Reduction

section Wf

variable {D : Ty} {rec : Ty × Ty} {var₁ var₂ : Ty → Type} {r : Bool} {Γ : WfCtx var₁ var₂}

theorem wf_restrictProg {sub₁ : var₁ (Ty.inst D) → Prog (groupSig D) rec var₁ (Ty.answer D)}
    {sub₂ : var₂ (Ty.inst D) → Prog (groupSig D) rec var₂ (Ty.answer D)}
    (hsub : WfFun r Γ sub₁ sub₂) {I₁ : var₁ (Ty.inst D)} {I₂ : var₂ (Ty.inst D)}
    (hI : ⟨Ty.inst D, I₁, I₂⟩ ∈ Γ) :
    Prog.Wf r Γ (restrictProg sub₁ I₁) (restrictProg sub₂ I₂) := by
  unfold restrictProg liftAnswerProg posProg restrictStrProg restrictCompProg restrictPermProg
    mkWindow permOne permMul mapArray mapList
  prog_wf
  all_goals first
    | exact Or.inl ⟨rfl, HEq.rfl⟩
    | exact hsub _ (fun y hy => by simp [hy]) _ _ (List.Mem.head _)

end Wf

