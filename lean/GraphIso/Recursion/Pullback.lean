module

public import GraphIso.Recursion.Hint
public import GraphIso.Semantics.StringIso
public import Mathlib.GroupTheory.Perm.Sign
public import Mathlib.GroupTheory.SpecificGroups.Alternating
public import Mathlib.GroupTheory.GroupAction.SubMulAction.Combination
public import Mathlib.Tactic.Linarith

/-!
# The pullback (Case 2a)

Helfgott §6.2, Case 2a, made exact (`PLAN-14.md` §2.3 item 4, §5 item 6). Let `r : H → Sym(Φ)`
restrict a group `H` to a large orbit `Φ` of the base, with kernel `K`, and let `F ≤ Aut(x)`
satisfy `Alt(Φ) ≤ r(F)`.

* `cover_of_alt_le`: every `h ∈ H` is `k f` or `τ k f` (`k ∈ K`, `f ∈ F`) for any `τ` with odd
  restriction; if no element of `H` is odd on `Φ`, every `h` is `k f`.
* `iso_pullback`: hence `iso W 1 H x y = (iso W 1 K x y ∪ iso W τ K x y) * F`. The solutions
  for `H` come from two solutions for `K`, and the automorphisms of `x` in `H` are generated by
  those in `K`, those in `τ K`, and `F` (`aut_pullback`).
* `card_orbit_le_half`: in the giant macro-step the labels are all `t`-subsets of `Γ`. With
  `t ≤ |Γ|/2` and `2|Φ| > |Γ|`, every orbit of a subgroup fixing `Φ` pointwise has at most half
  of the window. The count behind it is `two_mul_choose_le`.
-/

@[expose] public section

namespace GraphIso.Recursion

open Equiv MulAction Pointwise

/-- An element with even restriction is `k f` with `k` in the kernel and `f ∈ F`. -/
theorem exists_ker_mul_of_sign {H Φ : Type*} [Group H] [Fintype Φ] [DecidableEq Φ]
    (r : H →* Perm Φ) (F : Subgroup H) (hF : alternatingGroup Φ ≤ F.map r) {h : H}
    (he : Perm.sign (r h) = 1) : ∃ k ∈ r.ker, ∃ f ∈ F, h = k * f := by
  obtain ⟨f, hf, hfr⟩ := Subgroup.mem_map.1 (hF (Equiv.Perm.mem_alternatingGroup.2 he))
  refine ⟨h * f⁻¹, ?_, f, hf, by rw [inv_mul_cancel_right]⟩
  rw [MonoidHom.mem_ker, map_mul, map_inv, hfr, mul_inv_cancel]

/-- **The cover.** -/
theorem cover_of_alt_le {H Φ : Type*} [Group H] [Fintype Φ] [DecidableEq Φ] (r : H →* Perm Φ)
    (F : Subgroup H) (hF : alternatingGroup Φ ≤ F.map r) (τ : H) (hτ : Perm.sign (r τ) = -1)
    (h : H) : ∃ k ∈ r.ker, ∃ f ∈ F, h = k * f ∨ h = τ * k * f := by
  by_cases he : Perm.sign (r h) = 1
  · obtain ⟨k, hk, f, hf, rfl⟩ := exists_ker_mul_of_sign r F hF he
    exact ⟨k, hk, f, hf, Or.inl rfl⟩
  · have hs : Perm.sign (r h) = -1 := (Int.units_eq_one_or _).resolve_left he
    have he' : Perm.sign (r (τ⁻¹ * h)) = 1 := by
      rw [map_mul, map_inv, Perm.sign_mul, Perm.sign_inv, hτ, hs]
      decide
    obtain ⟨k, hk, f, hf, hkf⟩ := exists_ker_mul_of_sign r F hF he'
    refine ⟨k, hk, f, hf, Or.inr ?_⟩
    rw [mul_assoc, ← hkf, mul_inv_cancel_left]

theorem cover_of_alt_le_even {H Φ : Type*} [Group H] [Fintype Φ] [DecidableEq Φ]
    (r : H →* Perm Φ) (F : Subgroup H) (hF : alternatingGroup Φ ≤ F.map r)
    (heven : ∀ h : H, Perm.sign (r h) = 1) (h : H) : ∃ k ∈ r.ker, ∃ f ∈ F, h = k * f :=
  exists_ker_mul_of_sign r F hF (heven h)

variable {Ω α : Type*} {W : Set Ω} {x y : Ω → α}

/-- **The solutions for `H` from two solutions for `K`.** `K ≤ H`, `F ≤ H` preserves `x` on
the `H`-invariant window, `τ ∈ H`, and every element of `H` is `k f` or `τ k f`. -/
theorem iso_pullback {Hs Ks Fs : Subgroup (Perm Ω)} (hW : IsInvariant Hs W) (hKH : Ks ≤ Hs)
    (hFH : Fs ≤ Hs) (hF : ∀ f ∈ Fs, Matches W f x x) {τ : Perm Ω} (hτ : τ ∈ Hs)
    (hcov : ∀ h ∈ Hs, ∃ k ∈ Ks, ∃ f ∈ Fs, h = k * f ∨ h = τ * k * f) :
    iso W 1 Hs x y = (iso W 1 Ks x y ∪ iso W τ Ks x y) * (Fs : Set (Perm Ω)) := by
  ext g
  constructor
  · intro hg
    rw [mem_iso_one] at hg
    obtain ⟨hgH, hgm⟩ := hg
    obtain ⟨k, hk, f, hf, hkf⟩ := hcov g hgH
    refine Set.mem_mul.2 ⟨g * f⁻¹, ?_, f, hf, by rw [inv_mul_cancel_right]⟩
    have hm : Matches W (g * f⁻¹) x y := by
      intro u hu
      have hfu : f⁻¹ u ∈ W := hW.inv_apply_mem (hFH hf) hu
      rw [Perm.mul_apply, ← hgm _ hfu]
      have := hF f hf (f⁻¹ u) hfu
      rw [perm_apply_inv_self] at this
      exact this.symm
    rcases hkf with rfl | rfl
    · left
      rw [mem_iso_one]
      exact ⟨by simpa using hk, hm⟩
    · right
      rw [mem_iso]
      exact ⟨by simpa [mul_assoc] using hk, hm⟩
  · intro hg
    obtain ⟨a, ha, f, hf, rfl⟩ := Set.mem_mul.1 hg
    have haH : a ∈ Hs ∧ Matches W a x y := by
      rcases ha with ha | ha
      · rw [mem_iso_one] at ha
        exact ⟨hKH ha.1, ha.2⟩
      · rw [mem_iso] at ha
        refine ⟨?_, ha.2⟩
        have := mul_mem hτ (hKH ha.1)
        rwa [mul_inv_cancel_left] at this
    rw [mem_iso_one]
    refine ⟨mul_mem haH.1 (hFH hf), fun u hu => ?_⟩
    rw [Perm.mul_apply, hF f hf u hu]
    exact haH.2 _ (hW.apply_mem (hFH hf) hu)

/-- **The automorphisms for `H`.** -/
theorem aut_pullback {Hs Ks Fs : Subgroup (Perm Ω)} (hW : IsInvariant Hs W) (hKH : Ks ≤ Hs)
    (hFH : Fs ≤ Hs) (hF : ∀ f ∈ Fs, Matches W f x x) {τ : Perm Ω} (hτ : τ ∈ Hs)
    (hcov : ∀ h ∈ Hs, ∃ k ∈ Ks, ∃ f ∈ Fs, h = k * f ∨ h = τ * k * f) :
    aut hW x = Subgroup.closure (iso W 1 Ks x x ∪ iso W τ Ks x x ∪ (Fs : Set (Perm Ω))) := by
  apply le_antisymm
  · intro h hh
    have hh' : h ∈ iso W 1 Hs x x := by
      rw [mem_iso_one]
      exact hh
    rw [iso_pullback hW hKH hFH hF hτ hcov] at hh'
    obtain ⟨a, ha, f, hf, rfl⟩ := Set.mem_mul.1 hh'
    exact mul_mem (Subgroup.subset_closure (Or.inl ha)) (Subgroup.subset_closure (Or.inr hf))
  · rw [Subgroup.closure_le]
    rintro g ((hg | hg) | hg)
    · rw [mem_iso_one] at hg
      exact ⟨hKH hg.1, hg.2⟩
    · rw [mem_iso] at hg
      refine ⟨?_, hg.2⟩
      have := mul_mem hτ (hKH hg.1)
      rwa [mul_inv_cancel_left] at this
    · exact ⟨hFH hg, hF g hg⟩

/-- `2^j C(a, j) ≤ C(m, j)` when `2a ≤ m`. -/
theorem two_pow_mul_choose_le {a m : ℕ} (ha : 2 * a ≤ m) (j : ℕ) :
    2 ^ j * a.choose j ≤ m.choose j := by
  have hd : ∀ j, 2 ^ j * a.descFactorial j ≤ m.descFactorial j := by
    intro j
    induction j with
    | zero => simp
    | succ j ih =>
      rw [Nat.descFactorial_succ, Nat.descFactorial_succ, pow_succ]
      calc 2 ^ j * 2 * ((a - j) * a.descFactorial j)
          = (2 * (a - j)) * (2 ^ j * a.descFactorial j) := by ring
        _ ≤ (m - j) * m.descFactorial j := Nat.mul_le_mul (by omega) ih
  have := hd j
  rw [Nat.descFactorial_eq_factorial_mul_choose, Nat.descFactorial_eq_factorial_mul_choose]
    at this
  have hf : 0 < j.factorial := Nat.factorial_pos j
  nlinarith

/-- Binomial coefficients increase up to the middle: `C(m, j) ≤ C(m, t)` for `j ≤ t ≤ m/2`. -/
theorem choose_mono_le_half {j t m : ℕ} (hj : j ≤ t) (ht : 2 * t ≤ m) :
    m.choose j ≤ m.choose t := by
  induction t with
  | zero => rw [Nat.le_zero.1 hj]
  | succ t ih =>
    rcases Nat.eq_or_lt_of_le hj with rfl | hlt
    · exact le_rfl
    · exact (ih (by omega) (by omega)).trans
        (Nat.choose_le_succ_of_lt_half_left (by omega))

/-- The count: `2 C(a, j) ≤ C(m, t)` for `2a ≤ m`, `j ≤ t`, `1 ≤ t`, `2t ≤ m`. -/
theorem two_mul_choose_le {a j t m : ℕ} (ha : 2 * a ≤ m) (hj : j ≤ t) (ht1 : 1 ≤ t)
    (ht : 2 * t ≤ m) : 2 * a.choose j ≤ m.choose t := by
  rcases Nat.eq_zero_or_pos j with rfl | hj0
  · rw [Nat.choose_zero_right, mul_one]
    calc 2 ≤ m := by omega
      _ = m.choose 1 := (Nat.choose_one_right m).symm
      _ ≤ m.choose t := choose_mono_le_half ht1 ht
  · calc 2 * a.choose j ≤ 2 ^ j * a.choose j := by
          gcongr
          calc 2 = 2 ^ 1 := rfl
            _ ≤ 2 ^ j := Nat.pow_le_pow_right (by norm_num) hj0
      _ ≤ m.choose j := two_pow_mul_choose_le ha j
      _ ≤ m.choose t := choose_mono_le_half hj ht

/-- A group containing `Alt(Γ)`, `|Γ| ≥ 3`, moves any subset to any subset of the same size
(through mathlib's transitivity of `Alt(Γ)` on combinations). -/
theorem exists_alt_smul_eq {Γ : Type*} [Fintype Γ] [DecidableEq Γ] (h3 : 3 ≤ Fintype.card Γ)
    {T T' : Finset Γ} (hT : T.card = T'.card) : ∃ σ ∈ alternatingGroup Γ, σ • T = T' := by
  have := Set.powersetCard.isPretransitive_alternatingGroup (α := Γ) (n := T'.card)
    (by rwa [Nat.card_eq_fintype_card])
  obtain ⟨g, hg⟩ := MulAction.exists_smul_eq (alternatingGroup Γ)
    (⟨T, hT⟩ : Set.powersetCard Γ T'.card) ⟨T', rfl⟩
  refine ⟨g, g.2, ?_⟩
  have := congrArg (fun s : Set.powersetCard Γ T'.card => (s : Finset Γ)) hg
  simpa [Set.powersetCard.coe_smul, Subgroup.smul_def] using this

/-- **Orbits fixing a large part of a giant base are small.** -/
theorem card_orbit_le_half {M Ω' Γ : Type*} [Group M] [MulAction M Ω'] [Fintype Γ]
    [DecidableEq Γ] {ψ : M →* Perm Γ} {W' : Finset Ω'} {lab : Ω' → Finset Γ}
    (hgiant : alternatingGroup Γ ≤ ψ.range) (h3 : 3 ≤ Fintype.card Γ) (hW : Invariant M W')
    (he : Equivar ψ W' lab) {t : ℕ} (ht : ∀ u ∈ W', (lab u).card = t)
    (ht1 : 1 ≤ t) (ht2 : 2 * t ≤ Fintype.card Γ) {Φ : Finset Γ}
    (hΦ : Fintype.card Γ < 2 * Φ.card) (K : Subgroup M) (hK : ∀ k ∈ K, ∀ γ ∈ Φ, ψ k γ = γ)
    {u : Ω'} (hu : u ∈ W') {O : Finset Ω'} (hO : O ⊆ W') (hOK : ∀ v ∈ O, ∃ k ∈ K, k • u = v) :
    2 * O.card ≤ W'.card := by
  classical
  set R := lab u ∩ Φ with hR
  set 𝒯 := (Finset.univ : Finset Γ).powersetCard t with h𝒯
  set F : Finset Γ → Finset Ω' := fun T => W'.filter fun v => lab v = T with hF
  -- every `t`-subset is the label of as many points as `lab u`
  have hfib : ∀ T ∈ 𝒯, (F T).card = (F (lab u)).card := by
    intro T hT
    rw [Finset.mem_powersetCard] at hT
    obtain ⟨σ, hσ, hσT⟩ := exists_alt_smul_eq h3 (show (lab u).card = T.card by
      rw [ht u hu, hT.2])
    obtain ⟨g, hg⟩ := hgiant hσ
    symm
    apply Finset.card_bij (fun v _ => g • v)
    · intro v hv
      simp only [hF, Finset.mem_filter] at hv ⊢
      refine ⟨hW g v hv.1, ?_⟩
      rw [he g v hv.1, hv.2, hg, hσT]
    · intro v₁ _ v₂ _ h
      exact (smul_left_cancel_iff g).1 h
    · intro w hw
      simp only [hF, Finset.mem_filter] at hw
      have hv : g⁻¹ • w ∈ W' := hW g⁻¹ w hw.1
      refine ⟨g⁻¹ • w, ?_, smul_inv_smul g w⟩
      simp only [hF, Finset.mem_filter]
      refine ⟨hv, ?_⟩
      have := he g (g⁻¹ • w) hv
      rw [smul_inv_smul, hw.2, hg, ← hσT] at this
      exact ((smul_left_cancel_iff σ).1 this).symm
  have hlab : ∀ v ∈ W', lab v ∈ 𝒯 := fun v hv =>
    Finset.mem_powersetCard.2 ⟨Finset.subset_univ _, ht v hv⟩
  have hWcard : W'.card = 𝒯.card * (F (lab u)).card := by
    rw [Finset.card_eq_sum_card_fiberwise hlab, Finset.sum_congr rfl hfib, Finset.sum_const,
      smul_eq_mul]
  -- the points whose label meets `Φ` in `R`
  set 𝒯' := 𝒯.filter fun T => T ∩ Φ = R with h𝒯'
  set S := W'.filter fun v => lab v ∩ Φ = R with hS
  have hScard : S.card = 𝒯'.card * (F (lab u)).card := by
    have hlab' : ∀ v ∈ S, lab v ∈ 𝒯' := by
      intro v hv
      rw [hS, Finset.mem_filter] at hv
      exact Finset.mem_filter.2 ⟨hlab v hv.1, hv.2⟩
    rw [Finset.card_eq_sum_card_fiberwise hlab']
    rw [Finset.sum_congr rfl (g := fun _ => (F (lab u)).card), Finset.sum_const, smul_eq_mul]
    intro T hT
    rw [h𝒯', Finset.mem_filter] at hT
    rw [← hfib T hT.1]
    congr 1
    ext v
    simp only [hS, hF, Finset.mem_filter]
    constructor
    · rintro ⟨⟨hv, _⟩, hvT⟩
      exact ⟨hv, hvT⟩
    · rintro ⟨hv, hvT⟩
      exact ⟨⟨hv, by rw [hvT, hT.2]⟩, hvT⟩
  -- there are few such labels
  have h𝒯' : 𝒯'.card ≤ (Φᶜ).card.choose (t - R.card) := by
    rw [← Finset.card_powersetCard]
    apply Finset.card_le_card_of_injOn (fun T => T \ Φ)
    · intro T hT
      rw [Finset.mem_coe, h𝒯', Finset.mem_filter, Finset.mem_powersetCard] at hT
      rw [Finset.mem_coe, Finset.mem_powersetCard]
      refine ⟨fun γ hγ => Finset.mem_compl.2 (Finset.mem_sdiff.1 hγ).2, ?_⟩
      show (T \ Φ).card = t - R.card
      have := Finset.card_sdiff_add_card_inter T Φ
      rw [hT.2, hT.1.2] at this
      omega
    · intro T₁ h₁ T₂ h₂ h
      rw [Finset.mem_coe, h𝒯', Finset.mem_filter] at h₁ h₂
      simp only at h
      rw [← Finset.sdiff_union_inter T₁ Φ, ← Finset.sdiff_union_inter T₂ Φ, h, h₁.2, h₂.2]
  -- the orbit lies in `S`
  have hOS : O ⊆ S := by
    intro v hv
    obtain ⟨k, hk, rfl⟩ := hOK v hv
    rw [hS, Finset.mem_filter]
    refine ⟨hO hv, ?_⟩
    rw [he k u hu]
    ext γ
    simp only [Finset.mem_inter, hR]
    constructor
    · rintro ⟨hγ, hγΦ⟩
      refine ⟨?_, hγΦ⟩
      obtain ⟨δ, hδ, rfl⟩ := Finset.mem_smul_finset.1 hγ
      have hkδ : (ψ k) δ = δ := by
        by_contra hne
        have h' : (ψ k) δ ∈ Φ := hγΦ
        have := hK k hk _ h'
        exact hne ((ψ k).injective this)
      rw [Perm.smul_def, hkδ]
      exact hδ
    · rintro ⟨hγ, hγΦ⟩
      refine ⟨?_, hγΦ⟩
      rw [← hK k hk γ hγΦ]
      exact Finset.smul_mem_smul_finset hγ
  have hΦcard : 2 * (Φᶜ).card ≤ Fintype.card Γ := by
    rw [Finset.card_compl]
    have := Finset.card_le_univ Φ
    omega
  have hmain := two_mul_choose_le hΦcard (Nat.sub_le t R.card) ht1 ht2
  have h𝒯card : 𝒯.card = (Fintype.card Γ).choose t := by
    rw [h𝒯, Finset.card_powersetCard, Finset.card_univ]
  calc 2 * O.card ≤ 2 * S.card := Nat.mul_le_mul_left 2 (Finset.card_le_card hOS)
    _ = 2 * 𝒯'.card * (F (lab u)).card := by rw [hScard, mul_assoc]
    _ ≤ 2 * (Φᶜ).card.choose (t - R.card) * (F (lab u)).card := by gcongr
    _ ≤ (Fintype.card Γ).choose t * (F (lab u)).card := by gcongr
    _ = W'.card := by rw [hWcard, h𝒯card]

end GraphIso.Recursion
