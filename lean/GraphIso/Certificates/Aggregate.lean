module

public import GraphIso.Certificates.Relabel
public import GraphIso.Certificates.Cases

/-!
# Aggregating the local certificates

Helfgott §6.2, for test sets of size `k`. `fullGroup φ k x` is the subgroup `F` of `G`
generated by the certificates of fullness `K(A)` (`A` with `|A| = k` and `ψ_A(H(A))` a giant),
and `supp φ F` the support `S` of `φ(F)` on `Γ`.

* `fullGroup_le_autG`: `F ≤ Aut_G(x)`; `fullGroup_relabel`, `supp_conj`: `F` and `S` are
  canonical.
* **Cases 1 and 2** are group theory about `φ(F)` and live in `Certificates/Cases.lean`.
* **Case 3** (`no_large_twins`): colour the ordered `k`-tuples of `Γ \ S` by the equivalence of
  certificates (`SameColour`: `g ∈ G` maps one tuple to the other through `φ` and the truncated
  string `x^{W(T)}` to `x^{W(T')}`). No `k` points of `Γ \ S` are pairwise twins: otherwise
  `H(T)` would induce every permutation of some `k`-set `T ⊆ Γ \ S`, so `T` would be full and
  `F` would move it.
-/

@[expose] public section

namespace GraphIso.Certificates

open Equiv MulAction Pointwise GraphIso.AltQuot GraphIso.SplitJohnson GraphIso.Coherent

variable {Ω Γ : Type} [Fintype Ω] [DecidableEq Ω] [Fintype Γ] [DecidableEq Γ]
variable {G : Subgroup (Perm Ω)} (φ : G →* Perm Γ) {L : Type*}

/-- The subgroup generated by the certificates of fullness of the `k`-sets. -/
def fullGroup (k : ℕ) (x : Ω → L) : Subgroup G :=
  ⨆ (A : Finset Γ) (_ : A.card = k ∧ IsGiantOn φ A (beardH φ A x)),
    (certK φ A x).map (stabA φ A).subtype

/-- The support of `φ(F)` on `Γ`. -/
def supp (F : Subgroup G) : Set Γ := {γ | ∃ g ∈ F, φ g γ ≠ γ}

omit [DecidableEq Ω] [Fintype Γ] in
/-- **The certificates of fullness are automorphisms**: `F ≤ Aut_G(x)`. -/
theorem fullGroup_le_autG {K : ℕ → ℕ} {k : ℕ} (x : Ω → L)
    (hT : Thresholds K (Fintype.card Ω) k) : fullGroup φ k x ≤ autG x := by
  refine iSup₂_le fun A hA => ?_
  obtain ⟨rfl, hg⟩ := hA
  exact (cert_full φ x hT hg).1

omit [Fintype Ω] [DecidableEq Ω] in
/-- Moving a string by `σ⁻¹` undoes moving it by `σ`. -/
theorem smulStr_inv_smulStr (σ : G) (x : Ω → L) : smulStr σ⁻¹ (smulStr σ x) = x := by
  funext i
  simp [smulStr]

omit [DecidableEq Ω] [Fintype Γ] in
/-- One inclusion of `fullGroup_relabel`. -/
theorem map_fullGroup_le (σ : G) (k : ℕ) (x : Ω → L) :
    (fullGroup φ k x).map (MulAut.conj σ).toMonoidHom ≤ fullGroup φ k (smulStr σ x) := by
  rw [fullGroup, Subgroup.map_iSup]
  refine iSup_le fun A => ?_
  rw [Subgroup.map_iSup]
  refine iSup_le fun hA => ?_
  rw [← certK_relabel]
  exact le_iSup₂_of_le (f := fun (B : Finset Γ)
    (_ : B.card = k ∧ IsGiantOn φ B (beardH φ B (smulStr σ x))) =>
      (certK φ B (smulStr σ x)).map (stabA φ B).subtype) (φ σ • A)
    ⟨(Finset.card_smul_finset _ _).trans hA.1, (isGiantOn_relabel φ σ A x).2 hA.2⟩ le_rfl

omit [DecidableEq Ω] [Fintype Γ] in
/-- **`F` is canonical.** -/
theorem fullGroup_relabel (σ : G) (k : ℕ) (x : Ω → L) :
    fullGroup φ k (smulStr σ x) = (fullGroup φ k x).map (MulAut.conj σ).toMonoidHom := by
  refine le_antisymm (fun y hy => ?_) (map_fullGroup_le φ σ k x)
  have h := map_fullGroup_le φ σ⁻¹ k (smulStr σ x) (Subgroup.mem_map_of_mem _ hy)
  rw [smulStr_inv_smulStr] at h
  refine ⟨_, h, ?_⟩
  simp [MulAut.conj_apply, mul_assoc]

omit [Fintype Ω] [DecidableEq Ω] [Fintype Γ] [DecidableEq Γ] in
/-- **The support moves with `σ`.** -/
theorem supp_conj (σ : G) (F : Subgroup G) :
    supp φ (F.map (MulAut.conj σ).toMonoidHom) = φ σ • supp φ F := by
  ext γ
  simp only [supp, Set.mem_smul_set_iff_inv_smul_mem, Set.mem_ofPred_eq, Subgroup.mem_map]
  constructor
  · rintro ⟨_, ⟨g, hg, rfl⟩, hγ⟩
    refine ⟨g, hg, fun h => hγ ?_⟩
    simp only [MulEquiv.coe_toMonoidHom, MulAut.conj_apply, map_mul, map_inv, Perm.mul_apply,
      Perm.smul_def] at h ⊢
    rw [h]
    simp
  · rintro ⟨g, hg, hγ⟩
    refine ⟨_, ⟨g, hg, rfl⟩, fun h => hγ ?_⟩
    simp only [MulEquiv.coe_toMonoidHom, MulAut.conj_apply, map_mul, map_inv, Perm.mul_apply,
      Perm.smul_def] at h ⊢
    rw [← Perm.eq_inv_iff_eq] at h
    exact h

/-! ### Case 3 -/

omit [Fintype Ω] [DecidableEq Ω] [Fintype Γ] in
/-- `ψ_A` acts on `A` as `φ`. -/
theorem psiA_apply_coe {A : Finset Γ} (g : stabA φ A) (a : A) :
    (psiA φ A g a : Γ) = φ g a := rfl

/-- The equivalence of certificates (Helfgott (12)): `g ∈ G` maps the tuple `T` to `T'` through
`φ`, and `x^{W(T)}` to `x'^{W(T')}`. -/
def CertIso (x x' : Ω → L) {k : ℕ} (T T' : Fin k → Γ) : Prop :=
  ∃ g : G, (∀ i, φ g (T i) = T' i) ∧
    g • beardW φ (Finset.univ.image T) x = beardW φ (Finset.univ.image T') x' ∧
      ∀ j ∈ beardW φ (Finset.univ.image T) x, x' (g • j) = x j

/-- The colouring of Case 3: tuples with repetitions are one colour (gray); tuples without
repetitions are coloured by the equivalence of certificates. -/
def SameColour (x : Ω → L) {k : ℕ} (T T' : Fin k → Γ) : Prop :=
  (¬ Function.Injective T ∧ ¬ Function.Injective T') ∨
    (Function.Injective T ∧ Function.Injective T' ∧ CertIso φ x x T T')

omit [DecidableEq Ω] in
/-- **Case 3: no `k` pairwise twins** in the colouring of the `k`-tuples of `Γ \ S`. -/
theorem no_large_twins {K : ℕ → ℕ} {k : ℕ} (x : Ω → L) (hT : Thresholds K (Fintype.card Ω) k)
    {U : Finset Γ} (hU : k ≤ U.card) (hUS : ∀ u ∈ U, u ∉ supp φ (fullGroup φ k x))
    (htw : ∀ u ∈ U, ∀ v ∈ U, ∀ T : Fin k → Γ, (∀ i, T i ∉ supp φ (fullGroup φ k x)) →
      SameColour φ x T (Equiv.swap u v ∘ T)) : False := by
  obtain ⟨A, hAU, hk⟩ := Finset.exists_subset_card_eq hU
  -- an enumeration `T` of the `k`-set `A ⊆ U`
  set T : Fin k → Γ := fun i => (A.equivFin.symm (Fin.cast hk.symm i) : Γ) with hTdef
  have hTinj : Function.Injective T :=
    Subtype.val_injective.comp (A.equivFin.symm.injective.comp (Fin.cast_injective _))
  have hTim : Finset.univ.image T = A := by
    ext a
    simp only [Finset.mem_image, Finset.mem_univ, true_and, hTdef]
    refine ⟨fun ⟨i, hi⟩ => hi ▸ (A.equivFin.symm _).2,
      fun ha => ⟨Fin.cast hk (A.equivFin ⟨a, ha⟩), ?_⟩⟩
    simp
  have hTA : ∀ i, T i ∈ A := fun i => (A.equivFin.symm _).2
  have hmemT : ∀ d, (∃ i, T i = d) ↔ d ∈ A := fun d => by
    simpa using Finset.ext_iff.1 hTim d
  -- the transposition of two points of `A` is induced by `H(A)`
  have hswap : ∀ a b : A, ∃ h ∈ beardH φ A x, psiA φ A h = Equiv.swap a b := by
    intro a b
    have hS : ∀ i, T i ∉ supp φ (fullGroup φ k x) := fun i => hUS _ (hAU (hTA i))
    rcases htw a (hAU a.2) b (hAU b.2) T hS with ⟨hn, -⟩ | ⟨-, -, g, hgT, hgW, hgx⟩
    · exact absurd hTinj hn
    have hsA : ∀ c, Equiv.swap (a : Γ) b c ∈ A ↔ c ∈ A := by
      intro c
      rcases eq_or_ne c a with rfl | hca
      · simp [a.2, b.2]
      rcases eq_or_ne c b with rfl | hcb
      · simp [a.2, b.2]
      rw [Equiv.swap_apply_of_ne_of_ne hca hcb]
    have hTim' : Finset.univ.image (Equiv.swap (a : Γ) b ∘ T) = A := by
      ext c
      simp only [Finset.mem_image, Finset.mem_univ, true_and, Function.comp_apply,
        Equiv.swap_apply_eq_iff]
      rw [hmemT, hsA]
    rw [hTim, hTim'] at hgW
    rw [hTim] at hgx
    have hgA : g ∈ stabA φ A := by
      rw [mem_stabA, Finset.smul_finset_def]
      calc A.image (fun y => φ g • y) = (Finset.univ.image T).image (fun y => φ g • y) := by
            rw [hTim]
        _ = Finset.univ.image (Equiv.swap (a : Γ) b ∘ T) := by
            rw [Finset.image_image]
            congr 1
            funext i
            exact hgT i
        _ = A := hTim'
    refine ⟨⟨g, hgA⟩, ?_, ?_⟩
    · rw [beardH_eq_autW]
      exact ⟨Subgroup.mem_top _, hgW, hgx⟩
    · ext c
      obtain ⟨i, -, hi⟩ := Finset.mem_image.1 (hTim.symm ▸ c.2 : (c : Γ) ∈ Finset.univ.image T)
      have hc : c = ⟨T i, hTA i⟩ := Subtype.ext hi.symm
      subst hc
      rw [psiA_apply_coe, hgT i, Function.comp_apply, ← Subtype.val_injective.swap_apply]
  -- so `ψ_A(H(A)) = Sym(A)` and `A` is a giant, hence full
  have hgiant : IsGiantOn φ A (beardH φ A x) := by
    refine le_trans le_top ?_
    rw [← Equiv.Perm.closure_isSwap, Subgroup.closure_le]
    rintro _ ⟨a, b, -, rfl⟩
    obtain ⟨h, hh, hψ⟩ := hswap a b
    exact ⟨h, hh, hψ⟩
  have hle : (certK φ A x).map (stabA φ A).subtype ≤ fullGroup φ k x :=
    le_iSup₂_of_le (f := fun (B : Finset Γ)
      (_ : B.card = k ∧ IsGiantOn φ B (beardH φ B x)) =>
        (certK φ B x).map (stabA φ B).subtype) A ⟨hk, hgiant⟩ le_rfl
  have hTA' : Thresholds K (Fintype.card Ω) A.card := hk ▸ hT
  -- a 3-cycle of `A` comes from `K(A) ≤ F` and moves a point of `A ⊆ U`
  have h3 : 2 < Fintype.card A := by
    rw [Fintype.card_coe, hk]
    have := hT.five
    omega
  obtain ⟨a, b, c, hab, hac, hbc⟩ := Fintype.two_lt_card_iff.1 h3
  have hmem : Equiv.swap a b * Equiv.swap b c ∈ alternatingGroup A := by
    rw [Equiv.Perm.mem_alternatingGroup, Equiv.Perm.sign_mul, Equiv.Perm.sign_swap hab,
      Equiv.Perm.sign_swap hbc]
    decide
  obtain ⟨h, hhK, hψ⟩ := (cert_full φ x hTA' hgiant).2 hmem
  refine hUS a (hAU a.2) ⟨_, hle (Subgroup.mem_map_of_mem _ hhK), fun hfix => ?_⟩
  have hmove : (Equiv.swap a b * Equiv.swap b c) a = b := by
    rw [Equiv.Perm.mul_apply, Equiv.swap_apply_of_ne_of_ne hab hac, Equiv.swap_apply_left]
  have : (psiA φ A h a : Γ) = a := by
    rw [psiA_apply_coe]
    exact hfix
  rw [hψ, hmove] at this
  exact hab (Subtype.ext this).symm

end GraphIso.Certificates
