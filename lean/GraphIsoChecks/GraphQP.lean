module

public import GraphIso.Main.GraphQP
meta import GraphIso.Main.GraphQP
public import GraphIsoChecks.GraphBrute
meta import GraphIsoChecks.GraphBrute
public import GraphIsoChecks.Exec
meta import GraphIsoChecks.Exec
import all Init.Data.Array.Basic
import all Init.Data.List.Sort.Basic
import all Init.Data.Nat.Bitwise.Basic
import all Mathlib.Data.List.Sort

/-!
# Checks of stage 14j-6c-3: the graph-isomorphism entry

`PLAN-14.md` §14.15 item 7, by kernel `decide`.

* **The encoding** of the path `P₃` (edges `0–1`, `1–2`) on `N = 12` points: the string has `1`
  exactly at the pairs `(0, 1)`, `(1, 0)`, `(1, 2)`, `(2, 1)`, i.e. the points `4, 6, 8, 10`; the
  generators are valid data of degree `12`, and the lifted `3`-cycle maps the pair `(0, 1)` (point
  `4`) to `(1, 2)` (point `8`) and the vertex `2` to `0`. The window is all of `Ω`.
* **Decoding** of the lifted `3`-cycle gives back the `3`-cycle.
* **The entry**, run with the verified Schreier–Sims oracle and the body `mainBody (thrQP 1 3)`,
  on pairs of graphs on `2` and `3` points: the decoded coset is compared with the brute-force
  set of isomorphisms over all permutations (`cosetOK`: the coset `τ · ⟨hs⟩`, enumerated, equals
  the brute-force list as a set, and `none` exactly when the list is empty). The runs have
  `3 000` to `87 000` trace events, too many for one kernel declaration (the triangle with itself
  would need about `75` GB), so each is proved in pieces of at most `5 000` events by
  `GraphIsoChecks.Exec.execRuns`: a theorem `∃ v s, RunsS ssOracle gBody noF p v s ∧
  cosetOK … v = true` about the actual run of the entry `p`, with every piece and the
  composition checked by the kernel. The pairs: `K₂` with itself and with the empty graph; on
  `3` points, `P₃` centred at `1` with `P₃` centred at `0` (isomorphic) and with the triangle (not
  isomorphic), and the triangle with itself (automorphism group `S₃`).
* **A negative control**: the same instance with only the lifted transposition of `0` and `1` as
  generator. Between `P₃` centred at `1` and `P₃` centred at `2` every isomorphism maps `1` to
  `2`, which `⟨(0 1)⟩` does not, so the procedure answers `none` although the graphs are
  isomorphic: the generators must generate `Sym(V)`.
-/

@[expose] public section

namespace GraphIsoChecks.GraphQP

open GraphIso GraphIso.Cost GraphIso.Main GraphIso.Graph GraphIso.Sims GraphIsoChecks.Graph
open GraphIsoChecks.Exec

/-! ### Fixtures -/

/-- The path `0–1–2`, centred at `1`. -/
def p3c1 : GraphData := #[[1], [0, 2], [1]]
/-- The path `1–0–2`, centred at `0`. -/
def p3c0 : GraphData := #[[1, 2], [0], [0]]
/-- The path `0–2–1`, centred at `2`. -/
def p3c2 : GraphData := #[[2], [2], [0, 1]]
/-- The triangle. -/
def k3 : GraphData := #[[1, 2], [0, 2], [0, 1]]
/-- One edge on two points. -/
def k2 : GraphData := #[[1], [0]]
/-- No edge on two points. -/
def e2 : GraphData := #[[], []]

/-! ### The encoding -/

example : gStr 3 p3c1 = #[0, 0, 0, 0, 1, 0, 1, 0, 1, 0, 1, 0] := by decide +kernel

example : GensData.allValidB 12 (gensData 3) = true ∧ (gensData 3).length = 2 := by
  decide +kernel

example : get (liftData 3 (rotF 3, rotI 3)).1 4 = 8 ∧ get (liftData 3 (rotF 3, rotI 3)).1 2 = 0 ∧
    get (liftData 3 (rotF 3, rotI 3)).2 8 = 4 := by
  decide +kernel

example : (WinData.ofPoints 12 (List.range 12)).1 = List.range 12 ∧
    WinData.validB 12 (WinData.ofPoints 12 (List.range 12)) = true := by
  decide +kernel

/-! ### Decoding -/

example : restrictData 3 (liftData 3 (rotF 3, rotI 3)) = (#[1, 2, 0], #[2, 0, 1]) := by
  decide +kernel

/-! ### The entry against brute force -/

/-- The product `g h` of forward lists: `i ↦ g (h i)`. -/
def mulL (g h : List ℕ) : List ℕ := h.map fun i => g.getD i 0

/-- One closure step. -/
def closeStep (hs : List (List ℕ)) (S : List (List ℕ)) : List (List ℕ) :=
  (S ++ S.flatMap fun s => hs.map fun h => mulL s h).dedup

/-- The group generated by `hs` on `n ≤ 3` points (`|Sym(3)| = 6`, so six steps suffice). -/
def closureL (n : ℕ) (hs : List (List ℕ)) : List (List ℕ) :=
  (closeStep hs)^[6] [List.range n]

/-- Insert `a` at every position of a list. -/
def insAll (a : ℕ) : List ℕ → List (List ℕ)
  | [] => [[a]]
  | x :: xs => (a :: x :: xs) :: (insAll a xs).map (x :: ·)

/-- All permutations of `[m]`, as image lists, by structural recursion (the kernel does not
reduce `List.permutations`, which is defined by well-founded recursion). -/
def perms : ℕ → List (List ℕ)
  | 0 => [[]]
  | m + 1 => (perms m).flatMap (insAll m)

/-- The brute-force isomorphisms. -/
def isosB (n : ℕ) (X Y : GraphData) : List (List ℕ) := (perms n).filter (isIsoB n X Y)

/-- **The decoded coset is the set of isomorphisms**: `none` exactly when there is none; otherwise
valid data whose coset, enumerated, equals the brute-force list as a set. -/
def cosetOK (n : ℕ) (X Y : GraphData) : Option (PermData × GensData) → Bool
  | none => (isosB n X Y).isEmpty
  | some (τ, hs) =>
    let C := (closureL n (hs.map (·.1.toList))).map (mulL τ.1.toList)
    PermData.validB n τ && GensData.allValidB n hs &&
      C.all (fun g => (isosB n X Y).contains g) && (isosB n X Y).all (fun g => C.contains g)

/-- The body of the runs: the full procedure at the thresholds `thrQP 1 3`. -/
abbrev gBody : (hinstTy Ty.unit).denote →
    Prog (groupSig Ty.unit) (hinstTy Ty.unit, Ty.answer Ty.unit) Ty.denote (Ty.answer Ty.unit) :=
  mainBody (thrQP 1 3) Ty.denote

/-- No trace summary: the checks are on the value. -/
def noF : Event (groupSig Ty.unit) → List ℕ := fun _ => []

/-- Pieces of at most `5000` trace events. -/
def cfgG : Exec.Config := { budget := 5000 }

/-- The entry on `(n, X, Y)`. -/
abbrev giP (n : ℕ) (X Y : GraphData) :
    Prog (groupSig Ty.unit) (hinstTy Ty.unit, Ty.answer Ty.unit) Ty.denote Ty.giCoset :=
  giEntry Ty.unit Ty.denote (n, X, Y)

run_cmd
  execRuns `gi_k2k2.run
    (← `(RunsS ssOracle gBody noF (giP 2 k2 k2)))
    ssOracle gBody noF (giP 2 k2 k2) cfgG
/-- `K₂` with itself: `Aut = S₂`. -/
theorem gi_k2k2 : ∃ v s, RunsS ssOracle gBody noF (giP 2 k2 k2) v s ∧ cosetOK 2 k2 k2 v = true :=
  ⟨_, _, gi_k2k2.run, by decide +kernel⟩

run_cmd
  execRuns `gi_k2e2.run
    (← `(RunsS ssOracle gBody noF (giP 2 k2 e2)))
    ssOracle gBody noF (giP 2 k2 e2) cfgG
/-- `K₂` with the empty graph: no isomorphism. -/
theorem gi_k2e2 : ∃ v s, RunsS ssOracle gBody noF (giP 2 k2 e2) v s ∧ cosetOK 2 k2 e2 v = true :=
  ⟨_, _, gi_k2e2.run, by decide +kernel⟩

run_cmd
  execRuns `gi_e2e2.run
    (← `(RunsS ssOracle gBody noF (giP 2 e2 e2)))
    ssOracle gBody noF (giP 2 e2 e2) cfgG
/-- The empty graph with itself. -/
theorem gi_e2e2 : ∃ v s, RunsS ssOracle gBody noF (giP 2 e2 e2) v s ∧ cosetOK 2 e2 e2 v = true :=
  ⟨_, _, gi_e2e2.run, by decide +kernel⟩

run_cmd
  execRuns `gi_p3p3.run
    (← `(RunsS ssOracle gBody noF (giP 3 p3c1 p3c0)))
    ssOracle gBody noF (giP 3 p3c1 p3c0) cfgG
/-- `P₃` centred at `1` with `P₃` centred at `0`: the isomorphisms map `1` to `0`. -/
theorem gi_p3p3 : ∃ v s, RunsS ssOracle gBody noF (giP 3 p3c1 p3c0) v s ∧
    cosetOK 3 p3c1 p3c0 v = true :=
  ⟨_, _, gi_p3p3.run, by decide +kernel⟩

run_cmd
  execRuns `gi_p3k3.run
    (← `(RunsS ssOracle gBody noF (giP 3 p3c1 k3)))
    ssOracle gBody noF (giP 3 p3c1 k3) cfgG
/-- `P₃` with the triangle: no isomorphism. -/
theorem gi_p3k3 : ∃ v s, RunsS ssOracle gBody noF (giP 3 p3c1 k3) v s ∧
    cosetOK 3 p3c1 k3 v = true :=
  ⟨_, _, gi_p3k3.run, by decide +kernel⟩

run_cmd
  execRuns `gi_k3k3.run
    (← `(RunsS ssOracle gBody noF (giP 3 k3 k3)))
    ssOracle gBody noF (giP 3 k3 k3) cfgG
/-- The triangle with itself: `Aut = S₃`. -/
theorem gi_k3k3 : ∃ v s, RunsS ssOracle gBody noF (giP 3 k3 k3) v s ∧ cosetOK 3 k3 k3 v = true :=
  ⟨_, _, gi_k3k3.run, by decide +kernel⟩

/-! ### The negative control -/

/-- The encoded instance with only the lifted transposition of `0` and `1`. -/
def swapInst (X Y : GraphData) : Solver.Ty.input.denote :=
  ((gStr 3 X, gStr 3 Y), WinData.ofPoints 12 (List.range 12), PermData.one 12, 12,
    [liftData 3 (swF 3, swF 3)])

/-- The main entry on `swapInst`. -/
abbrev swapP (X Y : GraphData) :
    Prog (groupSig Ty.unit) (hinstTy Ty.unit, Ty.answer Ty.unit) Ty.denote (Ty.answer Ty.unit) :=
  mainEntry Ty.unit Ty.denote (swapInst X Y)

run_cmd
  execRuns `gi_swap.run
    (← `(RunsS ssOracle gBody noF (swapP p3c1 p3c2)))
    ssOracle gBody noF (swapP p3c1 p3c2) cfgG
/-- **The negative control**: `P₃` centred at `1` and `P₃` centred at `2` are isomorphic, but with
only the lifted transposition of `0` and `1` the answer is `none`. -/
theorem gi_swap : ∃ v s, RunsS ssOracle gBody noF (swapP p3c1 p3c2) v s ∧
    ((isosB 3 p3c1 p3c2).isEmpty = false ∧ (decodeAns 3 v).isNone = true) :=
  ⟨_, _, gi_swap.run, by decide +kernel⟩

end GraphIsoChecks.GraphQP
