module

public import GraphIso.Pyber.Families
public import GraphIso.Pyber.Residual
public import GraphIso.Pyber.Generators
public import Mathlib.GroupTheory.SpecificGroups.Alternating.Simple
public import Mathlib.Data.Finite.Perm
public import Mathlib.Data.ZMod.Basic
import all Init.Data.Array.Basic
import all Init.Data.List.Sort.Basic
import all Init.Data.Nat.Bitwise.Basic
import all Mathlib.Data.List.Sort

/-!
# Checks of stage 15a: the group theory of `compA`

`PLAN-15.md` §3 item 8. The milestone is theory, as milestones 6, 8 and 12 were. The checks are
instantiations of the library, with kernel `decide` for the numbers.

* `compA (Perm (Fin 3)) = {2, 3}`, from the prime factors of `6`, the alternating group of
  index `2`, and the alternating group of order `3`.
* `compA` of the cyclic group of order `12` is `{2, 3}`.
* **A negative control:** `compA (alternatingGroup (Fin 5)) = ∅`, although the prime factors of
  its order `60` are `{2, 3, 5}`. So `compA` is not the set of prime divisors of the order.
* **Proposition 3** on `Alt(3) ≤ Sym(3)` (index `2`): `3` lies in `compA` of both, and only `2`
  can be lost.
* **Residuals** in `Sym(3)`: `resid {2, 3} ⊤ = ⊥`, while `resid {2} ⊤ ≠ ⊥` because
  `3 ∈ compA (Perm (Fin 3))`.
* **Short generating lists:** `Sym(3)` is generated by at most `⌊log₂ 6⌋ = 2` elements.
* **Numbers:** `|primeFactors m| ≤ ⌊log₂ m⌋` for `m < 65`, by kernel `decide`.
-/

@[expose] public section

namespace GraphIsoChecks.Pyber

open GraphIso.Pyber Subgroup Equiv Equiv.Perm

/-! ### Sizes -/

theorem card_perm3 : Nat.card (Perm (Fin 3)) = 6 := by
  rw [Nat.card_perm, Nat.card_eq_fintype_card, Fintype.card_fin]
  decide

theorem card_alt3 : Nat.card (alternatingGroup (Fin 3)) = 3 := by
  have h := two_mul_nat_card_alternatingGroup (α := Fin 3)
  rw [card_perm3] at h
  omega

theorem card_alt5 : Nat.card (alternatingGroup (Fin 5)) = 60 := by
  have h := two_mul_nat_card_alternatingGroup (α := Fin 5)
  rw [Nat.card_perm, show Nat.card (Fin 5) = 5 by simp] at h
  have : (5 : ℕ).factorial = 120 := by decide
  omega

/-- A group of prime order `p` has `p ∈ compA`. -/
theorem mem_compA_of_card {G : Type*} [Group G] {p : ℕ} (hp : p.Prime) (h : Nat.card G = p) :
    p ∈ compA G :=
  ⟨hp, ⊤, ⊥, IsSubnormal.top, bot_le, normal_subgroupOf, by
    rw [relIndex_bot_left, card_top, h]⟩

/-! ### `compA (Perm (Fin 3)) = {2, 3}` -/

theorem two_mem_compA_perm3 : 2 ∈ compA (Perm (Fin 3)) :=
  mem_compA_of_index (N := alternatingGroup (Fin 3)) Nat.prime_two alternatingGroup.index_eq_two

theorem three_mem_compA_alt3 : 3 ∈ compA (alternatingGroup (Fin 3)) :=
  mem_compA_of_card Nat.prime_three card_alt3

theorem three_mem_compA_perm3 : 3 ∈ compA (Perm (Fin 3)) :=
  compA_subset_of_isSubnormal (Normal.isSubnormal inferInstance) three_mem_compA_alt3

theorem compA_perm3 : compA (Perm (Fin 3)) = {2, 3} := by
  apply Set.Subset.antisymm
  · have h := compA_subset_primeFactors (G := Perm (Fin 3))
    rw [card_perm3, show (6 : ℕ).primeFactors = {2, 3} by decide +kernel] at h
    simpa using h
  · rintro p (rfl | rfl)
    · exact two_mem_compA_perm3
    · exact three_mem_compA_perm3

/-! ### The cyclic group of order 12 -/

example : compA (Multiplicative (ZMod 12)) = {2, 3} := by
  have hc : Nat.card (Multiplicative (ZMod 12)) = 12 := by
    rw [Nat.card_eq_fintype_card]
    rfl
  apply Set.Subset.antisymm
  · have h := compA_subset_primeFactors (G := Multiplicative (ZMod 12))
    rw [hc, show (12 : ℕ).primeFactors = {2, 3} by decide +kernel] at h
    simpa using h
  · rintro p (rfl | rfl)
    · exact mem_compA_of_comm mul_comm Nat.prime_two (by rw [hc]; decide)
    · exact mem_compA_of_comm mul_comm Nat.prime_three (by rw [hc]; decide)

/-! ### The negative control: `Alt(5)` -/

/-- Two noncommuting elements of `Alt(5)`: the 3-cycles `(0 2 1)` and `(0 3 1)`. -/
theorem alt5_noncomm : ∃ a b : alternatingGroup (Fin 5), a * b ≠ b * a := by
  refine ⟨⟨swap 0 1 * swap 0 2, ?_⟩, ⟨swap 0 1 * swap 0 3, ?_⟩, ?_⟩
  · rw [mem_alternatingGroup, sign_mul, sign_swap (by decide), sign_swap (by decide)]
    decide
  · rw [mem_alternatingGroup, sign_mul, sign_swap (by decide), sign_swap (by decide)]
    decide
  · intro h
    have h' := congrArg Subtype.val h
    simp only [MulMemClass.coe_mul] at h'
    revert h'
    decide

/-- **`compA (Alt 5) = ∅`**, although `60` has the prime factors `2, 3, 5`. -/
theorem compA_alt5 : compA (alternatingGroup (Fin 5)) = ∅ ∧
    (Nat.card (alternatingGroup (Fin 5))).primeFactors = {2, 3, 5} := by
  have := alternatingGroup.isSimpleGroup (α := Fin 5) (by simp)
  refine ⟨compA_eq_empty_of_isSimpleGroup alt5_noncomm, ?_⟩
  rw [card_alt5]
  decide +kernel

/-- `Alt(5)` is characteristically simple, so the characteristically simple theorem applies. -/
example : compA (alternatingGroup (Fin 5)) = ∅ := by
  have := alternatingGroup.isSimpleGroup (α := Fin 5) (by simp)
  have : Nontrivial (alternatingGroup (Fin 5)) := IsSimpleGroup.toNontrivial
  refine compA_eq_empty_of_charSimple (fun C _ => ?_) alt5_noncomm
  exact (inferInstance : C.Normal).eq_bot_or_eq_top

/-! ### Proposition 3 on `Alt(3) ≤ Sym(3)` -/

example : compA (Perm (Fin 3)) \ compA (alternatingGroup (Fin 3)) ⊆ {2} := by
  have h := compA_sdiff_subset (alternatingGroup (Fin 3))
  rw [alternatingGroup.index_eq_two, show (2 : ℕ).primeFactors = {2} by decide +kernel] at h
  simpa using h

/-! ### Residuals in `Sym(3)` -/

/-- Every section of `Sym(3)` has `compA ⊆ {2, 3}`. -/
theorem compA_section_perm3 (L L' : Subgroup (Perm (Fin 3))) [(L'.subgroupOf L).Normal] :
    compA (L ⧸ L'.subgroupOf L) ⊆ {2, 3} := by
  have h := compA_subset_primeFactors (G := L ⧸ L'.subgroupOf L)
  have hd : Nat.card (L ⧸ L'.subgroupOf L) ∣ 6 :=
    (card_quotient_dvd_card _).trans (card_perm3 ▸ card_subgroup_dvd_card L)
  have hs := Nat.primeFactors_mono hd (by decide)
  rw [show (6 : ℕ).primeFactors = {2, 3} by decide +kernel] at hs
  intro p hp
  simpa using hs (h hp)

example : resid {2, 3} (⊤ : Subgroup (Perm (Fin 3))) = ⊥ :=
  le_bot_iff.mp (resid_le_of_schain (.step .refl bot_le (compA_section_perm3 ⊤ ⊥)))

example : resid {2} (⊤ : Subgroup (Perm (Fin 3))) ≠ ⊥ := by
  intro h
  have h3 := compA_subset_of_resid_eq_bot h
  rw [compA_eq_of_mulEquiv topEquiv] at h3
  have := h3 three_mem_compA_perm3
  simp at this

/-! ### Short generating lists -/

example : ∃ l : List (Perm (Fin 3)), closure {x | x ∈ l} = ⊤ ∧ l.length ≤ 2 := by
  obtain ⟨l, hl, hlen⟩ := exists_list_closure_eq_top (G := Perm (Fin 3))
  rw [card_perm3, show Nat.log 2 6 = 2 by decide +kernel] at hlen
  exact ⟨l, hl, hlen⟩

/-! ### Numbers -/

example : ∀ m < 65, (Nat.primeFactors m).card ≤ Nat.log 2 m := by decide +kernel

end GraphIsoChecks.Pyber
