/-!
# Phase 6 checks: the reference solver

Concrete runs of `referenceSolver`, the recursive solver with the enumeration backend
substituted, evaluated by the kernel. Each run returns the stated answer at the stated
charged cost. Each answer is checked two ways:

* against `solve_reference` (through `runRef_spec`, whose hypotheses are decided): the run is
  the one the theorem describes, so the answer denotes the solution set and the cost is within
  `referenceCost`;
* against brute force, independently of the solver's proof: the coset the answer data
  denotes, enumerated by `enumerate`, is the set of matching permutations in `σ • G`,
  computed by checking every element of `Perm (Fin 3)`.

The bound `referenceCost` is loose on these instances: it charges every node of the
recursion tree for a group of the input's order.

The last section runs the validating entry `solveChecked`, through `solve_reference_checked`.
-/

@[expose] public section

namespace GraphIsoChecks.Reference

open Equiv GraphIso GraphIso.Cost GraphIso.Programs GraphIso.Solver GraphIso.Reference
  GraphIso.Enum GraphIsoChecks.Cost Pointwise

instance : DecidableEq (Ty.denote Ty.gens) := inferInstanceAs (DecidableEq GensData)
instance : DecidableEq (CosetData Ty.gens) := inferInstance
instance : DecidableEq (AnswerData Ty.gens) :=
  inferInstanceAs (DecidableEq (Option (CosetData Ty.gens)))
instance : DecidableEq (AnswerData Ty.gens × ℕ) := inferInstance
instance : DecidableEq (Option (AnswerData Ty.gens)) := inferInstance
instance : DecidableEq (Option (AnswerData Ty.gens) × ℕ) := inferInstance

/-- Run the reference solver on `(x, y, W, σ, n, gs)`: the answer and the charged cost. -/
def runRef (inp : Ty.input.denote) : Option (AnswerData Ty.gens × ℕ) :=
  (eval Ctx.empty.O (referenceSolver.proc Ty.denote) 100000
    ((solveEntry Ty.gens Ty.denote inp).subst refImpl)).map fun r => (r.1, Trace.localCost r.2)

/-- A run evaluated by the kernel is the run of `solve_reference`: its answer is correct and
its cost is within `referenceCost`. -/
theorem runRef_spec {n : ℕ} {xy : StrData × StrData} {w : WinData} {σd : PermData}
    {gs : GensData} {ans : AnswerData Ty.gens} {c : ℕ} (hw : WinData.validB n w = true)
    (hσ : PermData.validB n σd = true) (hgs : GensData.allValidB n gs = true)
    (hinv : GensData.invariantB gs w = true) (h : runRef (xy, w, σd, n, gs) = some (ans, c)) :
    Answer.IsCorrect (AnswerData.denote n ans) (w.denote n) (σd.denote n) (gs.denote n)
        (xy.1.denote n) (xy.2.denote n) ∧
      c ≤ referenceCost n (Nat.card (GensData.denote n gs)) gs.length w.1.length := by
  have hw' := WinData.validB_iff.1 hw
  have hgs' := GensData.allValidB_iff.1 hgs
  obtain ⟨ans', tr, hr, hc, hok⟩ := solve_reference hw' (PermData.validB_iff.1 hσ) hgs'
    ((GensData.invariantB_iff hgs' hw').1 hinv)
  unfold runRef at h
  rcases he : eval Ctx.empty.O (referenceSolver.proc Ty.denote) 100000
    ((solveEntry Ty.gens Ty.denote (xy, w, σd, n, gs)).subst refImpl) with _ | ⟨a, tr'⟩
  · rw [he] at h
    cases h
  · rw [he] at h
    obtain ⟨rfl, rfl⟩ := Prod.mk.inj (Option.some.inj h)
    obtain ⟨rfl, rfl⟩ := Runs.unique ⟨_, he⟩ hr
    exact ⟨hok.isCorrect, hc⟩

/-- Membership in the coset an answer denotes, by enumerating its group. -/
theorem mem_denote_some {n : ℕ} {τ : PermData} {H : GroupData (Ty.denote Ty.gens)}
    (hH : GensData.allValidB n H.gens = true) (g : Perm (Fin n)) :
    g ∈ Answer.denote (AnswerData.denote n (some (τ, H))) ↔
      ∃ e ∈ enumerate n H.gens, PermData.denote n τ * PermData.denote n e = g := by
  rw [AnswerData.denote, Option.map_some, Answer.denote_some, mem_leftCoset_iff',
    ((enumerate_spec (GensData.allValidB_iff.1 hH)).1.2.2 _)]
  exact exists_congr fun e => and_congr_right fun _ => by rw [eq_inv_mul_iff_mul_eq]

/-! ### Instances -/

def univ3 : WinData := ([0, 1, 2], #[true, true, true])
def empty3 : WinData := ([], #[false, false, false])
/-- `S₃`, generated by `(0 1)` and the 3-cycle. -/
def s3gens : GensData := [PermData.ofPerm t01, PermData.ofPerm c3]
/-- The cyclic group of order 3. -/
def c3gens : GensData := [PermData.ofPerm c3]
def t01gens : GensData := [PermData.ofPerm t01]

def idD : PermData := PermData.one 3
def c3D : PermData := PermData.ofPerm c3
def t01D : PermData := PermData.ofPerm t01
def t02D : PermData := PermData.ofPerm (swap (0 : Fin 3) 2)

/-- A successful answer of degree 3 whose group data is its generator list (the reference
backend's data is the group's element list, which for these answers is the generators). -/
def ans (τ : PermData) (gs : GensData) : AnswerData Ty.gens := some (τ, (3, gs, gs))

/-! The group orders, which enter the bound `referenceCost n |G| |gs| |W|`. -/

theorem card_s3 : Nat.card (GensData.denote 3 s3gens) = 6 := by
  rw [← (enumerate_spec (GensData.allValidB_iff.1 (by decide))).2]
  decide

theorem card_c3 : Nat.card (GensData.denote 3 c3gens) = 3 := by
  rw [← (enumerate_spec (GensData.allValidB_iff.1 (by decide))).2]
  decide

theorem card_t01 : Nat.card (GensData.denote 3 t01gens) = 2 := by
  rw [← (enumerate_spec (GensData.allValidB_iff.1 (by decide))).2]
  decide

/-- Brute force: the permutations of `Fin 3` in `σ • G` (membership by enumerating `G`)
matching `x` and `y` on `W`. -/
def BruteIso (w : WinData) (σd : PermData) (gs : GensData) (x y : StrData) (g : Perm (Fin 3)) :
    Prop :=
  (∃ e ∈ enumerate 3 gs, PermData.denote 3 σd * PermData.denote 3 e = g) ∧
    ∀ u : Fin 3, u.val ∈ w.1 → x.denote 3 u = y.denote 3 (g u)

instance (w : WinData) (σd : PermData) (gs : GensData) (x y : StrData) :
    DecidablePred (BruteIso w σd gs x y) := fun _ => by unfold BruteIso; infer_instance

/-! #### `S₃`, source `001`, target `100`: solutions `{c, (0 2)}` -/

theorem runA : runRef ((#[0, 0, 1], #[1, 0, 0]), univ3, idD, 3, s3gens) =
    some (ans c3D [t01D, idD], 8689) := by
  decide +kernel

example := runRef_spec (by decide) (by decide) (by decide) (by decide) runA

-- The bound of `solve_reference` for this instance and the next two.
example : referenceCost 3 (Nat.card (GensData.denote 3 s3gens)) s3gens.length univ3.1.length =
    2506915 := by
  rw [card_s3]
  decide

example : ∀ g, g ∈ Answer.denote (AnswerData.denote 3 (ans c3D [t01D, idD])) ↔
    BruteIso univ3 idD s3gens #[0, 0, 1] #[1, 0, 0] g := by
  intro g
  rw [ans, mem_denote_some (by decide)]
  revert g
  decide

example : ∀ g, BruteIso univ3 idD s3gens #[0, 0, 1] #[1, 0, 0] g ↔ g = c3 ∨ g = swap 0 2 := by
  decide

/-! #### `S₃`, source `001`, target `110`: no solution -/

theorem runB : runRef ((#[0, 0, 1], #[1, 1, 0]), univ3, idD, 3, s3gens) = some (none, 7384) := by
  decide +kernel

example := runRef_spec (by decide) (by decide) (by decide) (by decide) runB

example : ∀ g, ¬ BruteIso univ3 idD s3gens #[0, 0, 1] #[1, 1, 0] g := by decide

/-! #### `S₃`, three symbols: the unique solution `c` -/

theorem runC : runRef ((#[0, 1, 2], #[2, 0, 1]), univ3, idD, 3, s3gens) =
    some (ans c3D [idD], 7330) := by
  decide +kernel

example := runRef_spec (by decide) (by decide) (by decide) (by decide) runC

example : ∀ g, g ∈ Answer.denote (AnswerData.denote 3 (ans c3D [idD])) ↔
    BruteIso univ3 idD s3gens #[0, 1, 2] #[2, 0, 1] g := by
  intro g
  rw [ans, mem_denote_some (by decide)]
  revert g
  decide

/-! #### The coset `(0 1) • C₃`: of the two `S₃` solutions, only the odd `(0 2)` -/

theorem runD : runRef ((#[0, 0, 1], #[1, 0, 0]), univ3, t01D, 3, c3gens) =
    some (ans t02D [idD], 1585) := by
  decide +kernel

example := runRef_spec (by decide) (by decide) (by decide) (by decide) runD

example : referenceCost 3 (Nat.card (GensData.denote 3 c3gens)) c3gens.length univ3.1.length =
    257519 := by
  rw [card_c3]
  decide

example : ∀ g, g ∈ Answer.denote (AnswerData.denote 3 (ans t02D [idD])) ↔
    BruteIso univ3 t01D c3gens #[0, 0, 1] #[1, 0, 0] g := by
  intro g
  rw [ans, mem_denote_some (by decide)]
  revert g
  decide

/-! #### The window `{0, 1}` under `⟨(0 1)⟩`: the point `2` is not compared -/

theorem runE : runRef ((#[0, 1, 5], #[1, 0, 7]), w01, idD, 3, t01gens) =
    some (ans t01D [idD], 1023) := by
  decide +kernel

example := runRef_spec (by decide) (by decide) (by decide) (by decide) runE

example : referenceCost 3 (Nat.card (GensData.denote 3 t01gens)) t01gens.length w01.1.length =
    50306 := by
  rw [card_t01]
  decide

example : ∀ g, g ∈ Answer.denote (AnswerData.denote 3 (ans t01D [idD])) ↔
    BruteIso w01 idD t01gens #[0, 1, 5] #[1, 0, 7] g := by
  intro g
  rw [ans, mem_denote_some (by decide)]
  revert g
  decide

/-! #### The empty window: the whole input coset `(0 1) • S₃`

The answer's generators are the backend's generators for the input group, here its full
element list as returned by the reference `generate`. -/

theorem runF : runRef ((#[0, 0, 1], #[1, 1, 0]), empty3, t01D, 3, s3gens) =
    some (ans t01D (enumerate 3 s3gens), 4771) := by
  decide +kernel

example := runRef_spec (by decide) (by decide) (by decide) (by decide) runF

example : referenceCost 3 (Nat.card (GensData.denote 3 s3gens)) s3gens.length empty3.1.length =
    78227 := by
  rw [card_s3]
  decide

example : ∀ g, g ∈ Answer.denote (AnswerData.denote 3 (ans t01D (enumerate 3 s3gens))) := by
  intro g
  rw [ans, mem_denote_some (by decide)]
  revert g
  decide

/-! ### The validating entry

The unchecked entry reads strings by total decoding, so a source string shorter or longer than
the degree is accepted: `#[]` reads as the string `0` of degree 1, and `#[0, 1]` as `0`. The
validating entry rejects both, a symbol at the alphabet bound, and a window that is not
invariant. On a valid input it returns the unchecked answer, at the unchecked cost plus the
cost of the check. -/

/-- Run the validating entry with the reference backend: the result and the charged cost. -/
def runChecked (q : ℕ) (inp : Ty.input.denote) : Option (Option (AnswerData Ty.gens) × ℕ) :=
  (eval Ctx.empty.O (referenceSolver.proc Ty.denote) 100000
    ((solveChecked Ty.gens Ty.denote (q, inp)).subst refImpl)).map
      fun r => (r.1, Trace.localCost r.2)

/-- A run evaluated by the kernel is the run of `solve_reference_checked`. -/
theorem runChecked_spec {q n : ℕ} {xy : StrData × StrData} {w : WinData} {σd : PermData}
    {gs : GensData} {r : Option (AnswerData Ty.gens)} {c : ℕ}
    (h : runChecked q (xy, w, σd, n, gs) = some (r, c)) :
    (r = none ↔ ¬ InputValid q (xy, w, σd, n, gs)) ∧
      (∀ a, r = some a → Answer.IsCorrect (AnswerData.denote n a) (w.denote n) (σd.denote n)
        (gs.denote n) (xy.1.denote n) (xy.2.denote n)) ∧
      c ≤ validCost n w.1.length gs.length + 4 +
        referenceCost n (Nat.card (GensData.denote n gs)) gs.length w.1.length := by
  obtain ⟨r', tr, hr, hc, hnone, hsome⟩ := solve_reference_checked q n xy w σd gs
  unfold runChecked at h
  rcases he : eval Ctx.empty.O (referenceSolver.proc Ty.denote) 100000
    ((solveChecked Ty.gens Ty.denote (q, xy, w, σd, n, gs)).subst refImpl) with _ | ⟨a, tr'⟩
  · rw [he] at h
    cases h
  · rw [he] at h
    obtain ⟨rfl, rfl⟩ := Prod.mk.inj (Option.some.inj h)
    obtain ⟨rfl, rfl⟩ := Runs.unique ⟨_, he⟩ hr
    exact ⟨hnone, fun a ha => (hsome a ha).isCorrect, hc⟩

def univ1 : WinData := ([0], #[true])

example : (runRef ((#[], #[0]), univ1, PermData.one 1, 1, [])).map (·.1.isSome) = some true := by
  decide +kernel

theorem rejectShort : runChecked 2 ((#[], #[0]), univ1, PermData.one 1, 1, []) =
    some (none, 110) := by
  decide +kernel

-- The theorem's reading of the rejection, and the contract failure checked directly.
example : ¬ InputValid 2 ((#[], #[0]), univ1, PermData.one 1, 1, []) :=
  (runChecked_spec rejectShort).1.1 rfl
example : inputValidB 2 ((#[], #[0]), univ1, PermData.one 1, 1, []) = false := by decide

example : runChecked 2 ((#[0, 1], #[0]), univ1, PermData.one 1, 1, []) = some (none, 110) := by
  decide +kernel

example : runChecked 2 ((#[2], #[2]), univ1, PermData.one 1, 1, []) = some (none, 110) := by
  decide +kernel

-- `{0, 1}` is not invariant under the 3-cycle.
example : runChecked 8 ((#[0, 1, 5], #[1, 0, 7]), w01, idD, 3, c3gens) = some (none, 274) := by
  decide +kernel

-- The window instance above: answer of `runE`, cost `1023 + 274`.
theorem runE_checked : runChecked 8 ((#[0, 1, 5], #[1, 0, 7]), w01, idD, 3, t01gens) =
    some (some (ans t01D [idD]), 1297) := by
  decide +kernel

example := runChecked_spec runE_checked

example : validCost 3 w01.1.length t01gens.length + 4 = 297 := by decide

