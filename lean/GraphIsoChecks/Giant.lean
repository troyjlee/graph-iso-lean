meta import GraphIsoChecks.Sims
public import GraphIso.Giant.Aggregate
meta import GraphIso.Giant.Aggregate
public import GraphIso.Giant.Case1
meta import GraphIso.Giant.Case1
public import GraphIso.Giant.Case2a
